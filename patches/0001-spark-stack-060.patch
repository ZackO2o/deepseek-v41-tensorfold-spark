--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/exl3_mm.py
@@ -0,0 +1,318 @@
+"""GLM-5.3-Flash's routed experts in EXL3 on CUDA (``exl3.cu``): the grouped trellis GEMV and the rotations.
+
+A window's routed (row, slot) pairs go through, per layer:
+
+    rot_in           Xg, Xu = fp16((x * suh) @ H) for each pair's expert (gate and up have their own suh)
+    grouped          Zg, Zu = X @ W_q for every distinct expert's rows, per fixed K split (fp32)
+    gateup_epilogue  g, u = (sum of splits) @ H * svh; act = GLM's limited SwiGLU; Xd = fp16((act * suh_d) @ H)
+    grouped          Zd = Xd @ W_q(down), per fixed K split
+    down_epilogue    Y[row, slot] = (sum of splits) @ H * svh_d      (this rank's share, fp32)
+
+H is the 128-block Hadamard / sqrt(128) (``exl3.py``). The shared expert is BF16 and fills Y's last slot
+elsewhere; ``glue.combine`` then adds the slots in order as before. Splits of K and warps are fixed by the shape,
+so a pair's outputs never depend on the window's other rows.
+
+Windows where an expert can have more than 16 members (prefill chunks) run ``grouped_loop``: one program per
+(n block, expert, split) takes all of the expert's member tiles, so its weights come from memory once per window
+instead of once per 16 members, and no program is launched empty. It runs the same work item per member tile as
+``grouped`` (``member_tiles`` in exl3.cu: same K ranges per warp and split, same warp order), so Z has the same
+bits; GLM53_TF_EXPERT_LOOP=0 turns it off.
+
+patches/0080 (``fast=True``, fast-prefill chunks only): ``exl3_fast.cu`` replaces grouped + epilogues with two fused
+grouped GEMMs (full K a warp, a trellis tile decoded once into shared memory for every member tile of the expert, the
+Hadamard epilogues on the accumulators, no Z partials). New arithmetic: never used for decode or verify windows.
+patches/0590 (GLM53_TF_FAST_EXPERTS=fat2): ``exl3_fat2.cu`` runs the same arithmetic as one software-pipelined
+persistent kernel a projection (docs/EXPERT-PREFILL-V2.md).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import os
+
+import torch
+
+# (n tiles a block, warps a block, K splits) for the gate/up (K = model width) and down (K = the rank's expert
+# width) matrices; none changes a row's bits across row counts.
+GATEUP_CFG = (8, 4, 4)
+DOWN_CFG = (8, 4, 1)
+
+# grouped_loop: (n tiles a block, member tiles a pass) for windows past 16 rows; the warps and K splits are the
+# ones above (they define the sums), these two only place work. GLM53_TF_EXPERT_LOOP=0: upstream's grid everywhere;
+# GLM53_TF_EXPERT_LOOP_CFG="nt,mg" (4,2 | 8,1 | 4,1 | 2,4) to tune.
+LOOP = os.environ.get("GLM53_TF_EXPERT_LOOP", "1").strip() not in ("0", "", "false", "no", "off")
+LOOP_CFG = tuple(int(v) for v in os.environ.get("GLM53_TF_EXPERT_LOOP_CFG", "4,2").split(","))
+
+# patches/0170: GLM53_TF_FAST_EXPERTS=fat runs fast chunks' experts through exl3_fast.cu's ``fat`` kernels (fast2's
+# arithmetic with the MiaAI-Lab E2/E3 data movement: same bits); per request: tf_knobs.fat_experts. The others:
+# GLM53_TF_FAT_STAGES (3 | 4 cp.async stages), GLM53_TF_FAT_TICKET (1: dynamic item claiming), GLM53_TF_FAT_SHARED_X
+# (auto: gate and up read one rotated input when their sign vectors are equal, checked per layer; 0: never)
+def _env(name: str, default: str) -> str:
+    return os.environ.get(name, default).strip().lower()
+
+
+# patches/0260: GLM53_TF_FAST_EXPERTS=once is fat with two work items a CTA sharing their trellis decode (two passes of
+# an expert's members over the same weight tiles; same bits as fat / fast2). FAT stays the per-request switch
+# (tf_knobs.fat_experts: 1 = the configured fat-family kernels, 0 = fast2); ONCE picks once within it.
+# GLM53_TF_ONCE_PAIR=0: every unit is two column blocks of one pass (no shared decode; for A/B timing).
+FAT = _env("GLM53_TF_FAST_EXPERTS", "fast2") in ("fat", "once", "auto", "tc", "fat2")
+ONCE = _env("GLM53_TF_FAST_EXPERTS", "fast2") == "once"
+# patches/0270: GLM53_TF_FAST_EXPERTS=auto is a fat-family mode that picks the kernels per fast chunk by its row count:
+# fast2 for FAST2_ROWS lo <= R < hi (GLM53_TF_FAST2_ROWS="lo,hi"), fat (or once, see ONCE) otherwise. fast2 reads the
+# one rotated input (rot_in1) when gate and up share their sign vector, as fat does. Same bits either way
+# (fast2 == fat == once), so the switch keeps 0085's row independence and shares snapshots. The per-request knob
+# fat_experts: 0 = fast2, 1 = the fat family (fat / once), 2 = auto.
+AUTO = _env("GLM53_TF_FAST_EXPERTS", "fast2") == "auto"
+FAST2_ROWS = tuple(int(v) for v in _env("GLM53_TF_FAST2_ROWS", "0,4096").split(","))
+ONCE_PAIR = _env("GLM53_TF_ONCE_PAIR", "1") not in ("0", "false", "no", "off")
+# once only for windows of at least this many rows (fat below; the same bits either way, so the switch keeps 0085's
+# row independence): pairs of passes exist only when experts have > 64 members, i.e. from ~2048-4096-row chunks
+ONCE_MIN_ROWS = int(_env("GLM53_TF_ONCE_MIN_ROWS", "0"))
+# patches/0330: GLM53_TF_FAST_EXPERTS=tc is a fat-family mode: fast chunks' experts through exl3_tc.cu (a warp-specialized
+# persistent kernel: one producer warp feeds 16 consumer warps through mbarrier-guarded stages, items of 2-4 column
+# blocks or 128 members, the epilogue overlapped with the next item's loads; fat's arithmetic, the same bits). It needs
+# gate and up to share their sign vector (true for the GLM-5.3-Flash EXL3 checkpoints; fat runs otherwise).
+# GLM53_TF_TC_CFG="gu,dn": 0 = by the chunk's rows (the default), 1-3 = exl3_tc.cu's configurations (the same bits);
+# GLM53_TF_TC_TICKET (1: dynamic item claiming; 0: static stride); GLM53_TF_TC_CTAS (0: one CTA every SM; N: at most N
+# CTAs, leaving SMs to the overlapped streams of patches/0084).
+TC = _env("GLM53_TF_FAST_EXPERTS", "fast2") == "tc"
+TC_CFG = tuple(int(v) for v in _env("GLM53_TF_TC_CFG", "0,0").split(","))
+TC_TICKET = _env("GLM53_TF_TC_TICKET", "1") not in ("0", "false", "no", "off")
+TC_CTAS = int(_env("GLM53_TF_TC_CTAS", "0"))
+if len(TC_CFG) != 2 or not all(0 <= v <= 3 for v in TC_CFG) or TC_CTAS < 0:
+    raise ValueError(f"GLM53_TF_TC_CFG={os.environ.get('GLM53_TF_TC_CFG')!r} / GLM53_TF_TC_CTAS="
+                     f"{os.environ.get('GLM53_TF_TC_CTAS')!r}: expected gu,dn in 0-3 and a count >= 0")
+# patches/0590: GLM53_TF_FAST_EXPERTS=fat2 is a fat-family mode: fast chunks' experts through exl3_fat2.cu (one
+# persistent 256-thread CTA an SM, 128-member items of the expert-sorted member lists from a device plan, claimed by
+# ticket one item ahead, a 4-stage cp.async ring that runs across items, the epilogue in its own buffer; fat's
+# arithmetic, the same bits). It needs gate and up to share their sign vector (true for the GLM-5.3-Flash EXL3
+# checkpoints; fat runs otherwise). GLM53_TF_FAT2_CFG="gu,dn": 0 = 128 members / 4 stages (default), 1 = 64 / 4,
+# 2 = 128 / 3 (the same bits); GLM53_TF_FAT2_TICKET (1: dynamic claiming; 0: static stride); GLM53_TF_FAT2_CTAS
+# (0: one CTA every SM; N: at most N CTAs, leaving SMs to patches/0084's overlapped streams).
+FAT2 = _env("GLM53_TF_FAST_EXPERTS", "fast2") == "fat2"
+FAT2_CFG = tuple(int(v) for v in _env("GLM53_TF_FAT2_CFG", "0,0").split(","))
+FAT2_TICKET = _env("GLM53_TF_FAT2_TICKET", "1") not in ("0", "false", "no", "off")
+FAT2_CTAS = int(_env("GLM53_TF_FAT2_CTAS", "0"))
+if len(FAT2_CFG) != 2 or not all(0 <= v <= 2 for v in FAT2_CFG) or FAT2_CTAS < 0:
+    raise ValueError(f"GLM53_TF_FAT2_CFG={os.environ.get('GLM53_TF_FAT2_CFG')!r} / GLM53_TF_FAT2_CTAS="
+                     f"{os.environ.get('GLM53_TF_FAT2_CTAS')!r}: expected gu,dn in 0-2 and a count >= 0")
+FAT_STAGES = int(_env("GLM53_TF_FAT_STAGES", "3"))
+FAT_TICKET = _env("GLM53_TF_FAT_TICKET", "1") not in ("0", "false", "no", "off")
+FAT_SHARED_X = _env("GLM53_TF_FAT_SHARED_X", "auto") not in ("0", "false", "no", "off")
+if FAT_STAGES not in (3, 4):
+    raise ValueError(f"GLM53_TF_FAT_STAGES={FAT_STAGES}: expected 3 or 4")
+if _env("GLM53_TF_FAST_EXPERTS", "fast2") not in ("fast2", "v1", "fat", "once", "auto", "tc", "fat2"):
+    raise ValueError(f"GLM53_TF_FAST_EXPERTS={os.environ.get('GLM53_TF_FAST_EXPERTS')!r}: expected fast2, v1, fat, once, "
+                     "auto, tc or fat2")
+if len(FAST2_ROWS) != 2 or not 0 <= FAST2_ROWS[0] <= FAST2_ROWS[1]:
+    raise ValueError(f"GLM53_TF_FAST2_ROWS={os.environ.get('GLM53_TF_FAST2_ROWS')!r}: expected lo,hi with 0 <= lo <= hi")
+
+
+def family() -> int:
+    """patches/0270: the fast chunks' expert kernels as the per-request knob fat_experts says them: 0 fast2, 1 the fat
+    family (fat / once), 2 auto (fast2 or the fat family by the chunk's rows)."""
+
+    return 2 if FAT and AUTO else int(bool(FAT))
+
+
+def set_family(v: int) -> None:
+    """patches/0270: the inverse of ``family`` (the same bits every way)."""
+
+    global FAT, AUTO
+    v = int(v)
+    if v not in (0, 1, 2):
+        raise ValueError(f"fat_experts={v}: expected 0, 1 or 2")
+    FAT, AUTO = v >= 1, v == 2
+
+
+def auto_fast2(R: int) -> bool:
+    """patches/0270: an auto chunk of R rows runs fast2 (else the fat family)."""
+
+    return AUTO and FAST2_ROWS[0] <= R < FAST2_ROWS[1]
+
+
+def shared_suh(ex: "Exl3Experts") -> bool:
+    """patches/0170: gate and up of every expert of this layer have the same input sign vector, so one rotated input
+    serves both (true for the GLM-5.3-Flash EXL3 checkpoints; checked once per layer, on the device)."""
+
+    v = ex.__dict__.get("_shared_suh")
+    if v is None:
+        v = ex.suh_g.data_ptr() == ex.suh_u.data_ptr() or bool(torch.equal(ex.suh_g, ex.suh_u))
+        ex.__dict__["_shared_suh"] = v
+    return v
+
+
+# patches/0440: ``decode_stream`` while GLM53_TF_DEC_EXPERTS=1 (windows with <= 64 member columns through
+# exl3_stream.cu's persistent kernels, the same bits); None otherwise
+STREAM = None
+
+# patches/0580: ``expert_loads`` while GLM53_TF_DEC_EXPERT_LOADS=1 (the two grouped launches of windows of <= 16 rows
+# through exl3_ld.cu's ld_kernel: grouped_kernel's work items with a deeper load path, the same bits); None otherwise
+LOADS = None
+
+# patches/0130: ``decode_v2`` while GLM53_TF_DECODE_KERNELS=v2 has ``exl3`` (windows of <= 16 rows through exl3_dec.cu:
+# three kernels, the same bits); None otherwise
+V2 = None
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_exl3_v2", sources=[str(here / "exl3.cpp"), str(here / "exl3.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@lru_cache(maxsize=1)
+def _fast_ext():
+    """patches/0080: the fast-prefill expert kernels (their own extension: the decode kernels' build is untouched)."""
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_exl3_fast_v1", sources=[str(here / "exl3_fast.cpp"), str(here / "exl3_fast.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@lru_cache(maxsize=1)
+def _tc_ext():
+    """patches/0330: the warp-specialized fast-prefill expert kernels (their own extension, built only when used).
+    Built for this GPU's architecture only (``tensorfold.cuda.build``): mbarrier / cp.async.bulk need sm_90+."""
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_exl3_tc_v1", sources=[str(here / "exl3_tc.cpp"), str(here / "exl3_tc.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@lru_cache(maxsize=1)
+def _fat2_ext():
+    """patches/0590: the pipelined fast-prefill expert kernels (their own extension, built only when used, for this
+    GPU's architecture only, as every extension: a shorter build, and the production build is untouched)."""
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_exl3_fat2_v1", sources=[str(here / "exl3_fat2.cpp"), str(here / "exl3_fat2.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@dataclass
+class Exl3Experts:
+    """One layer's routed experts on this rank: trellis words [E, K/16, N/16, 32] int32 and scales per expert."""
+
+    gt: torch.Tensor          # gate trellis [E, D/16, NI/16, 32]
+    ut: torch.Tensor          # up trellis
+    dt: torch.Tensor          # down trellis [E, NI/16, D/16, 32]
+    suh_g: torch.Tensor       # [E, D] fp16
+    suh_u: torch.Tensor
+    svh_g: torch.Tensor       # [E, NI] fp16 (this rank's columns)
+    svh_u: torch.Tensor
+    suh_d: torch.Tensor       # [E, NI] fp16 (this rank's rows of down)
+    svh_d: torch.Tensor       # [E, D]
+    count: int
+    width: int                # NI: this rank's share of the expert width
+    dims: int                 # D
+
+    def nbytes(self) -> int:
+        return sum(t.numel() * t.element_size() for t in (self.gt, self.ut, self.dt, self.suh_g, self.suh_u,
+                                                         self.svh_g, self.svh_u, self.suh_d, self.svh_d))
+
+
+def words(trellis: torch.Tensor) -> torch.Tensor:
+    """A trellis (int16 [..., 64], 4 bits) as the kernels read it: int32 [..., 32], the same bytes."""
+
+    if trellis.dtype != torch.int16 or trellis.shape[-1] != 64:
+        raise ValueError("only 4-bit EXL3 trellises (int16 [..., 64]) are supported")
+    return trellis.contiguous().view(torch.int32)
+
+
+class Scratch:
+    """Per-window buffers for up to ``rows`` rows of ``slots`` slots (the last slot is the shared expert's)."""
+
+    def __init__(self, rows: int, slots: int, dims: int, width: int, device) -> None:
+        P = rows * slots
+        sk = max(GATEUP_CFG[2], DOWN_CFG[2])
+        self.xg = torch.zeros((P, dims), dtype=torch.float16, device=device)
+        self.xu = torch.zeros((P, dims), dtype=torch.float16, device=device)
+        self.xd = torch.zeros((P, width), dtype=torch.float16, device=device)
+        self.z = torch.zeros((2 * sk * P * max(width, dims),), dtype=torch.float32, device=device)
+        self.rows, self.slots = rows, slots
+
+
+def routed(x: torch.Tensor, pick: torch.Tensor, group, ex: Exl3Experts, s: Scratch, y: torch.Tensor, R: int,
+           limit: float, fast: bool = False) -> None:
+    """Y[row * slots + slot] for every routed slot of rows 0..R-1 (fp32, [.., D]); x: the normed rows (bf16).
+    ``fast`` (patches/0080, fast-prefill chunks): the fused kernels of exl3_fast.cu after the same input rotation."""
+
+    if STREAM is not None and not fast and STREAM.routed(x, pick, group, ex, s, y, R, limit):     # patches/0440
+        return
+    if V2 is not None and not fast and V2.routed(x, pick, group, ex, s, y, R, limit):     # patches/0130
+        return
+    ext = _ext()
+    slots, P = s.slots, s.rows * s.slots
+    D, NI = ex.dims, ex.width
+    if fast and FAT:                     # patches/0170: the same bits as the branch below
+        fx = _fast_ext()
+        shx = FAT_SHARED_X and shared_suh(ex)
+        if shx:
+            fx.rot_in1(x, x.stride(0), pick, ex.suh_g, s.xg, R, D, slots)
+        else:
+            ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, D, slots)
+        if auto_fast2(R):                    # patches/0270: fast2 on the fat family's rotated input, the same bits
+            fx.gateup(s.xg, s.xg if shx else s.xu, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g,
+                      ex.svh_u, ex.suh_d, s.xd, D, NI, slots, float(limit))
+            fx.down(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots)
+            return
+        if FAT2 and shx and min(D, NI) >= 128:   # patches/0590: the same bits (fat's arithmetic, pipelined; K: 4 stages)
+            f2 = _fat2_ext()
+            f2.gateup_fat2(s.xg, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g, ex.svh_u, ex.suh_d,
+                           s.xd, D, NI, slots, float(limit), FAT2_CFG[0], FAT2_TICKET, FAT2_CTAS)
+            f2.down_fat2(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots, FAT2_CFG[1],
+                         FAT2_TICKET, FAT2_CTAS)
+            return
+        if TC and shx:                       # patches/0330: the same bits (fat's arithmetic, new data movement)
+            tx = _tc_ext()
+            tx.gateup_tc(s.xg, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g, ex.svh_u, ex.suh_d, s.xd,
+                         D, NI, slots, float(limit), TC_CFG[0], TC_TICKET, TC_CTAS)
+            tx.down_tc(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots, TC_CFG[1],
+                       TC_TICKET, TC_CTAS)
+            return
+        if ONCE and group.members.shape[1] >= ONCE_MIN_ROWS:     # patches/0260: the same bits (3 stages)
+            fx.gateup_once(s.xg, s.xg if shx else s.xu, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g,
+                           ex.svh_u, ex.suh_d, s.xd, D, NI, slots, float(limit), shx, FAT_TICKET, ONCE_PAIR)
+            fx.down_once(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots, FAT_TICKET,
+                         ONCE_PAIR)
+            return
+        fx.gateup_fat(s.xg, s.xg if shx else s.xu, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g,
+                      ex.svh_u, ex.suh_d, s.xd, D, NI, slots, float(limit), shx, FAT_STAGES, FAT_TICKET)
+        fx.down_fat(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots, FAT_STAGES,
+                    FAT_TICKET)
+        return
+    if fast:
+        fx = _fast_ext()
+        ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, D, slots)
+        fx.gateup(s.xg, s.xu, ex.gt, ex.ut, group.ids, group.count, group.members, ex.svh_g, ex.svh_u, ex.suh_d, s.xd,
+                  D, NI, slots, float(limit))
+        fx.down(s.xd, ex.dt, group.ids, group.count, group.members, ex.svh_d, y, NI, D, slots)
+        return
+    loop = LOOP and group.members.shape[1] > 16          # an expert may have more than one member tile
+
+    def grouped(x0, x1, t0, t1, mats, K, N, cfg):
+        nt, w, sk = cfg
+        if loop:
+            ext.grouped_loop(x0, x1, t0, t1, group.ids, group.count, group.members, s.z, mats, K, N, P, sk, slots,
+                             LOOP_CFG[0], w, LOOP_CFG[1])
+        elif LOADS is None or not LOADS.grouped(x0, x1, t0, t1, group, s.z, mats, K, N, P, sk, slots, w):  # patches/0580
+            ext.grouped(x0, x1, t0, t1, group.ids, group.count, group.members, s.z, mats, K, N, P, sk, slots, nt, w)
+
+    ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, D, slots)
+    grouped(s.xg, s.xu, ex.gt, ex.ut, 2, D, NI, GATEUP_CFG)
+    ext.gateup_epilogue(s.z, pick, ex.svh_g, ex.svh_u, ex.suh_d, s.xd, R, P, NI, GATEUP_CFG[2], slots, float(limit))
+    grouped(s.xd, s.xd, ex.dt, ex.dt, 1, NI, D, DOWN_CFG)
+    ext.down_epilogue(s.z, pick, ex.svh_d, y, R, P, D, DOWN_CFG[2], slots)
