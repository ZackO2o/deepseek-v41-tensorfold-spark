+def fast_gather(comm: Comm, send: torch.Tensor, recv: torch.Tensor) -> None:
+    """A model exchange: the communicator's faster ``all_gather_fast`` if it has one, else ``all_gather``."""
+
+    fast = getattr(comm, "all_gather_fast", None)
