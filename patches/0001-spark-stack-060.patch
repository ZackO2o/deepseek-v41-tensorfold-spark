+"""TF_GLM_ENGINE picks GLM's CUDA engine, app and HTTP side; the Spark engine's prepared folders keep their names."""
+
+import pytest
+
+pytest.importorskip("torch")
+
+import tensorfold.families.glm5_next as glm5_next
+
+
+def test_the_default_engine_is_the_cuda_one(monkeypatch):
+    monkeypatch.delenv("TF_GLM_ENGINE", raising=False)
+    from tensorfold.families.glm5_next.cuda.app import GlmApp
+
+    assert glm5_next.cuda_engine_name() == "cuda"
+    assert glm5_next.CUDA_APP is GlmApp
+    assert getattr(glm5_next, "CUDA_SERVE", None) is None      # the shared server serves it
+
+
+def test_spark_selects_the_spark_app_and_its_server(monkeypatch):
+    monkeypatch.setenv("TF_GLM_ENGINE", "spark")
+    from tensorfold.families.glm5_next.spark import server
+    from tensorfold.families.glm5_next.spark.app import GlmApp
+
+    assert glm5_next.CUDA_APP is GlmApp
+    assert glm5_next.CUDA_SERVE is server.serve
+
+
+def test_an_unknown_engine_is_refused(monkeypatch):
+    monkeypatch.setenv("TF_GLM_ENGINE", "lanes")
+    with pytest.raises(ValueError, match="TF_GLM_ENGINE"):
+        glm5_next.cuda_engine("/nonexistent", tp=2, master="192.0.2.1")
+
+
+@pytest.mark.parametrize("given, explicit, expected", [(1048576, True, 1048576), (202752, False, 0), (None, True, 0)])
+def test_spark_takes_the_context_only_when_it_was_asked(monkeypatch, tmp_path, given, explicit, expected):
+    from tensorfold.families.glm5_next.spark import engine
+
+    made = []
+    monkeypatch.setenv("TF_GLM_ENGINE", "spark")
+    monkeypatch.setattr(engine, "GlmEngine", lambda *a, **k: made.append(k) or k)
+    glm5_next.cuda_engine(tmp_path, tp=2, master="192.0.2.1", context=given, context_explicit=explicit)
+    assert made[0]["context"] == expected and made[0]["policy"] == engine.DEFAULT_POLICY
+
+
+def test_prepared_folders_record_and_resolve_the_0_3_4_package_name():
+    from tensorfold.families.glm5_next.spark import fastboot, qmm
+
+    assert fastboot.stored_name(f"{fastboot.PKG}.qmm:Q4") == "tensorfold.families.glm5_next.cuda.qmm:Q4"
+    assert fastboot.loaded_name("tensorfold.families.glm5_next.cuda.qmm") == f"{fastboot.PKG}.qmm"
+    assert fastboot.stored_name("tensorfold.engine.exact_sampling") == "tensorfold.engine.exact_sampling"
+    assert fastboot._find_class("tensorfold.families.glm5_next.cuda.qmm:Q4") is qmm.Q4
+
+
+def test_the_spark_app_takes_the_cli_aliases_argument_and_refuses_a_name(tmp_path):
+    from tensorfold.families.glm5_next.spark import server
+
+    engine = type("Engine", (), {"generate": lambda self, *a, **k: None})()
+    with pytest.raises(ValueError, match="--alias"):
+        server.App(engine, tmp_path, "glm", aliases=["other"])
+    with pytest.raises(Exception, match="No such file"):          # past the alias check: no tokenizer in tmp_path
+        server.App(engine, tmp_path, "glm", aliases=["", " "])
