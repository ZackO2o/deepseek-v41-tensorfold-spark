+++ b/src/tensorfold/families/glm5_next/spark/batchplan.py
@@ -0,0 +1,414 @@
+"""Host-side scheduling for GLM53_TF_BATCH rounds (patches/0120, ``batch.py``). Pure Python, no torch: the unit
+tests run anywhere.
+
+Rank 0 decides everything that depends on the outside world (clients, clocks, free memory) and ships it to rank 1
+as one int list before every round (``encode_plan`` / ``parse_plan``):
+
+    [n_cancel, slot..., n_admit, (slot, resume length, header length, header...)..., n_piece, slot...]
+
+- cancels: slots whose request ends now (the client went away, or a background request steps aside);
+- admits: queued requests placed in free slots, each with its request header (``encode_header``: sampling, stop,
+  max tokens, rank 0's cost-depth flag, its ``tf_knobs`` block and policy code, all resolved on rank 0);
+- pieces: slots that prefill their next piece of prompt this round (at most one long one, ``Fairness``; with
+  patches/0200's GLM53_TF_BATCH_SHORT also every short prompt, ``pick_pieces``).
+
+Everything else in a round (piece bounds, drafts, windows, sampling, keeps, when a request ends, the round's model
+cost for batch-aware depths) is a function of shared inputs, computed alike on both ranks.
+"""
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+from typing import Sequence
+
+from . import knobs as knobs_mod
+
+HEADER_FIXED = 12            # ints before the knob block: see ``encode_header``
+
+
+# -- request headers ---------------------------------------------------------------------------------------------
+def f64_ints(x: float) -> list[int]:
+    return list(struct.unpack("<2i", struct.pack("<d", float(x))))
+
+
+def ints_f64(lo: int, hi: int) -> float:
+    return struct.unpack("<d", struct.pack("<2i", int(lo), int(hi)))[0]
+
+
+@dataclass
+class Header:
+    """What rank 1 needs of a request (besides its prompt)."""
+
+    max_tokens: int
+    stop_eos: bool
+    draft: bool
+    seed: int                  # 0 with temperature 0
+    temperature: float
+    top_k: int
+    top_p: float
+    cost: int                  # patches/0071: rank 0's cost-depth flag
+    values: dict               # patches/0090: every knob in ``knobs.HEADER``
+    code: list                 # the policy code (lookup settings included)
+
+
+def encode_header(h: Header) -> list[int]:
+    seed = int(h.seed) & 0xFFFFFFFFFFFFFFFF
+    out = [int(h.max_tokens), int(bool(h.stop_eos)), int(bool(h.draft)), seed & 0x7FFFFFFF, (seed >> 31) & 0x7FFFFFFF,
+           seed >> 62, *f64_ints(h.temperature), int(h.top_k), *f64_ints(h.top_p), int(h.cost)]
+    assert len(out) == HEADER_FIXED
+    return out + knobs_mod.encode(h.values) + [int(c) for c in h.code]
+
+
+def decode_header(ints: Sequence[int]) -> Header:
+    ints = [int(v) for v in ints]
+    max_tokens, stop_eos, draft, s_lo, s_hi, s_top, t_lo, t_hi, top_k, p_lo, p_hi, cost = ints[:HEADER_FIXED]
+    values, code = knobs_mod.decode(ints[HEADER_FIXED:])
+    seed = (s_top << 62) | (s_hi << 31) | s_lo
+    return Header(max_tokens, bool(stop_eos), bool(draft), seed, ints_f64(t_lo, t_hi), top_k, ints_f64(p_lo, p_hi),
+                  cost, values, code)
+
+
+# -- round plans -------------------------------------------------------------------------------------------------
+def encode_plan(cancels: Sequence[int], admits: Sequence[tuple[int, int, Sequence[int]]],
+                pieces: Sequence[int]) -> list[int]:
+    plan = [len(cancels), *cancels, len(admits)]
+    for slot, cached, header in admits:
+        plan += [int(slot), int(cached), len(header), *header]
+    return plan + [len(pieces), *pieces]
+
+
+def parse_plan(plan: Sequence[int]) -> tuple[list[int], list[tuple[int, int, list[int]]], list[int]]:
+    plan = [int(v) for v in plan]
+    nc = plan[0]
+    cancels = plan[1:1 + nc]
+    at = 1 + nc
+    na = plan[at]
+    at += 1
+    admits = []
+    for _ in range(na):
+        slot, cached, n = plan[at:at + 3]
+        admits.append((slot, cached, plan[at + 3:at + 3 + n]))
+        at += 3 + n
+    npieces = plan[at]
+    pieces = plan[at + 1:at + 1 + npieces]
+    if at + 1 + npieces != len(plan):
+        raise RuntimeError(f"a round plan of {len(plan)} ints parsed to {at + 1 + npieces}: both ranks must run the "
+                           "same patched TensorFold")
+    return cancels, admits, pieces
+
+
+# -- prefill pieces ---------------------------------------------------------------------------------------------
+def piece_rows(piece: int, grid: int) -> int:
+    """A piece's tokens: ``piece`` (GLM53_TF_BATCH_PIECE), for a fast prefill (grid C > 0) rounded down to a multiple
+    of C and at least C (a fast piece must end on the chunk grid to leave a resumable snapshot)."""
+
+    piece = max(1, int(piece))
+    if grid:
+        return max(grid, piece // grid * grid)
+    return piece
+
+
+ALIGN = 64                   # ``pfgrid.ALIGN``: fast snapshots (and so fast resume points) sit on multiples of it
+
+
+def piece_end(done: int, n: int, piece: int, grid: int) -> int:
+    """Where the piece starting at ``done`` of an ``n``-token prompt ends: the prompt's end, or the next piece bound.
+    Fast pieces start on the grid (a grid snapshot or 0), so they end on it too. patches/0180: a fast resume point
+    may sit on the 64-token snapshot grid between two bounds of ``grid`` (a stored session's snapshot or mark,
+    patches/0085); that piece ends on the next bound at least a piece away, and the rest are on the grid."""
+
+    if grid and done % ALIGN:
+        raise ValueError(f"a fast prefill piece starts at {done}, off the chunk grid {grid}")
+    step = piece_rows(piece, grid)
+    if grid and done % grid:
+        end = (done + step) // grid * grid
+        return n if end >= n else end
+    return n if n - done <= step else done + step
+
+
+def solo_piece(solo: int, piece: int, grid: int, others: Sequence[int]) -> int:
+    """patches/0335 (GLM53_TF_SOLO_PIECE): the piece size for a prompt's next piece: ``solo`` when it is set, the
+    prefill is fast (``grid`` > 0) and no other slot holds a request (``others``: those slots), else ``piece``
+    (GLM53_TF_BATCH_PIECE). Decided when the piece is cut, from the slots both ranks hold alike, so a request admitted
+    in this round's plan makes its neighbours' next pieces normal ones. Any cut gives the same bits (pieces end on the
+    snapshot grid; resumed == fresh)."""
+
+    return solo if solo and grid and not others else piece
+
+
+def piece_grid(chunk: int, snap_grid: int) -> int:
+    """patches/0180: the bound fast pieces end on: a multiple of the chunk grid C and of the snapshot grid G (a piece
+    must end where its prefill takes the snapshot the next piece resumes from). G = 64 (default): C itself."""
+
+    import math
+
+    if not chunk:
+        return 0
+    return chunk * snap_grid // math.gcd(chunk, snap_grid) if snap_grid else chunk
+
+
+class Fairness:
+    """Rank 0: when a prefill piece may run while other sequences decode. ``share`` is the part of the time prefill
+    pieces may take (GLM53_TF_BATCH_PREFILL_SHARE, 0 < share <= 1): a piece of t seconds is followed by at least
+    t (1 - share) / share seconds of decode rounds (and at least one round) before the next piece. With nothing
+    decoding, pieces run back to back (one a round, so new arrivals are admitted between them)."""
+
+    def __init__(self, share: float = 0.5) -> None:
+        if not 0.0 < share <= 1.0:
+            raise ValueError(f"GLM53_TF_BATCH_PREFILL_SHARE={share}: expected 0 < share <= 1")
+        self.share = float(share)
+        self.debt = 0.0          # decode seconds owed before the next piece
+        self.rounds = 1          # decode rounds since the last piece
+
+    def allow(self, decoding: bool) -> bool:
+        if not decoding:
+            return True
+        return self.rounds >= 1 and self.debt <= 0.0
+
+    def after(self, piece_s: float, round_s: float, prefilling: bool) -> None:
+        """After a round: its piece's seconds (0 without one) and its decode seconds."""
+
+        if piece_s > 0.0:
+            self.debt = max(self.debt, 0.0) + piece_s * (1.0 - self.share) / self.share
+            self.rounds = 0
+        if round_s > 0.0:
+            self.debt -= round_s
+            self.rounds += 1
+        if not prefilling:
+            self.debt, self.rounds = 0.0, 1
+
+
+def pick_piece(prefilling: Sequence[tuple[int, int, int]]) -> int | None:
+    """The slot whose prompt prefills next, from (slot, tokens left, admission order): the fewest tokens left (a
+    short request behind a long prompt gets its first token soon), ties to the earliest admitted."""
+
+    if not prefilling:
+        return None
+    return min(prefilling, key=lambda p: (p[1], p[2], p[0]))[0]
+
+
+def pick_pieces(prefilling: Sequence[tuple[int, int, int]], allow: bool, short: int = 0) -> list[int]:
+    """patches/0200 (GLM53_TF_BATCH_SHORT=N > 0): this round's pieces, from (slot, tokens left, admission order).
+    Every prompt with at most ``short`` tokens left prefills now, fewest left first, whether or not the fair share
+    allows a piece (its piece ends it: a few hundred ms of expert reads, where waiting a share for each of several
+    new prompts staggers their first tokens by seconds); then, when ``allow``, the next piece of the others
+    (``pick_piece``). short = 0: ``pick_piece`` alone (patches/0120)."""
+
+    if short <= 0:
+        one = pick_piece(prefilling) if allow else None
+        return [] if one is None else [one]
+    small = sorted((p for p in prefilling if p[1] <= short), key=lambda p: (p[1], p[2], p[0]))
+    out = [p[0] for p in small]
+    rest = [p for p in prefilling if p[1] > short]
+    if allow and rest:
+        out.append(pick_piece(rest))
+    return out
+
+
+# -- patches/0200: graph keys ---------------------------------------------------------------------------------------
+def pad_mask(spec: str, most: int) -> int:
+    """GLM53_TF_BATCH_PAD ("2,4,8" or "" / "0": off) as a bit mask of window sizes (bit r-1 for r rows, r <= most):
+    the int both ranks compare at load."""
+
+    mask = 0
+    for part in str(spec or "").replace(";", ",").split(","):
+        part = part.strip()
+        if not part or part == "0":
+            continue
+        r = int(part)
+        if not 1 <= r <= most:
+            raise ValueError(f"GLM53_TF_BATCH_PAD={spec!r}: window sizes are 1..{most}")
+        mask |= 1 << (r - 1)
+    return mask
+
+
+def bucket_mask(spec: str, most: int) -> int:
+    """patches/0280: GLM53_TF_BATCH_BUCKETS ("4,8"; "" / "0": off) as a bit mask of window sizes, as ``pad_mask``."""
+
+    try:
+        return pad_mask(spec, most)
+    except ValueError:
+        raise ValueError(f"GLM53_TF_BATCH_BUCKETS={spec!r}: window sizes are 1..{most}") from None
+
+
+def bucket_rows(Rs: Sequence[int], mask: int) -> int:
+    """patches/0280: the rows every window of a round is padded to: the smallest listed size >= the round's longest
+    window (that window's length when none is)."""
+
+    return padded(max(Rs), mask) if Rs else 0
+
+
+def route_sources(real: Sequence[int], ran: Sequence[int]) -> list[int]:
+    """patches/0280: for a round whose window i has real[i] rows and ran[i] >= real[i] rows in the forward (back to
+    back), the row each forward row takes its router logits from: itself for a real row, its window's last real row
+    for a padded one."""
+
+    src, off = [], 0
+    for R, n in zip(real, ran):
+        if not 1 <= R <= n:
+            raise ValueError(f"route_sources: a window of {R} real rows ran {n}")
+        src.extend(range(off, off + R))
+        src.extend([off + R - 1] * (n - R))
+        off += n
+    return src
+
+
+def padded(R: int, mask: int) -> int:
+    """A window of R rows padded up to the next size in ``mask`` (R itself when none is >= R or the mask is 0).
+    Padded rows repeat the window's last token; they are verified like drafts that can never be accepted (the accept
+    rule only reads the real drafts), so the committed rows and every kept bit are those of the unpadded window
+    (rows never depend on their window-mates). The point: fewer distinct (slots, rows) graph keys."""
+
+    r = int(R)
+    while mask and r <= mask.bit_length():
+        if mask >> (r - 1) & 1:
+            return r
+        r += 1
+    return int(R)
+
+
+class Sightings:
+    """patches/0200 (GLM53_TF_BATCH_CAPTURE_AFTER=N): a multi-sequence graph key is captured the N-th time it is met;
+    before that its rounds run eagerly through the same capturable code (the same bits). A capture costs a warm-up
+    forward, the capture itself and the graph's instantiation (tens of ms against a ~90 ms round), so keys met once
+    (most of them, with 2-4 slots of 1-8 rows each) no longer pay it. N = 1: every key on first sight (patches/0120).
+    Both ranks count the same keys in the same order (the rounds are the same)."""
+
+    def __init__(self, after: int = 1) -> None:
+        if int(after) < 1:
+            raise ValueError(f"GLM53_TF_BATCH_CAPTURE_AFTER={after}: expected >= 1")
+        self.after = int(after)
+        self.seen: dict = {}
+
+    def capture(self, key) -> bool:
+        n = self.seen.get(key, 0) + 1
+        self.seen[key] = n
+        return n >= self.after
+
+
+# -- queue and placement -------------------------------------------------------------------------------------------
+def admission_order(background: Sequence[bool]) -> list[int]:
+    """Queue indices in admission order: every foreground request in arrival order, then background ones."""
+
+    return [i for i, b in enumerate(background) if not b] + [i for i, b in enumerate(background) if b]
+
+
+def victim(slots: Sequence[tuple[int, bool, int]], foreground_waiting: bool, free: int) -> int | None:
+    """A running background request that steps aside (its caller receives the same tokens when it runs again from
+    the start), from (slot, background, admitted round): only when a foreground request waits and no slot is free;
+    the most recently admitted one (it has done the least)."""
+
+    if not foreground_waiting or free:
+        return None
+    bg = [(adm, slot) for slot, b, adm in slots if b]
+    return max(bg)[1] if bg else None
+
+
+def place_entry(free: Sequence[int], overlap: dict[int, int], used: dict[int, int]) -> int:
+    """patches/0180: the free slot a stored session is restored into: the one whose caches already hold most of its
+    pages (fewest bytes copied), then the least recently admitted (its kept states are the likeliest stale)."""
+
+    return min(free, key=lambda s: (-overlap.get(s, 0), used.get(s, 0), s))
+
+
+def pool_spills(need: int, avail: int, idle: Sequence[tuple[int, int, int]],
+                prefer: int | None = None) -> list[int] | None:
+    """patches/0290 (GLM53_TF_KV_POOL_TOKENS): the idle slots whose pages a new request's ``need`` pages take when
+    only ``avail`` are free and unreserved. ``idle``: (slot, pages it holds, round of its last admission). The least
+    recently admitted go first, ``prefer`` (the slot the request would resume in) last; [] when ``avail`` covers it,
+    None when even every idle slot's pages do not (the request waits for a running one to end)."""
+
+    if need <= avail:
+        return []
+    out: list[int] = []
+    for slot, held, _ in sorted([x for x in idle if x[1] > 0], key=lambda x: (x[0] == prefer, x[2], x[0])):
+        out.append(slot)
+        avail += held
+        if need <= avail:
+            return out
+    return None
+
+
+def admit_free(free: int, store_headroom: int) -> int:
+    """patches/0180: device memory a new request may count on: what is free less what the session store may still
+    take within its budget (the store is budgeted at load alongside the slots, so admission leaves it that room)."""
+
+    return int(free) - max(0, int(store_headroom))
+
+
+def is_title_request(messages, tools) -> bool:
+    """A client's session-title request (``tensorfold.server.app.is_title_request``): a short system prompt about a
+    title, no tools, short messages. Runs as a background request."""
+
+    if tools or not messages or not isinstance(messages, list) or not isinstance(messages[0], dict) \
+            or messages[0].get("role") != "system":
+        return False
+    size = sum(len(m.get("content")) if isinstance(m, dict) and isinstance(m.get("content"), str) else 4096
+               for m in messages)
+    text = messages[0].get("content")
+    return size < 4096 and isinstance(text, str) and "title" in text.lower()
+
+
+# -- the round's model cost (batch-aware draft depths) -------------------------------------------------------------
+def verify_ms(table: Sequence[float], rows: int, slope_min: float = 0.0) -> float:
+    """Model ms of a forward of ``rows`` rows from the calibrated window costs (1..len(table) rows), extended past
+    the table along the slope of its upper half (rows of other sequences add experts as extra draft rows do), or
+    ``slope_min`` ms a row when that is more (patches/0200, GLM53_TF_BATCH_ROW_MS: rows of other sequences share
+    fewer experts than a sequence's own draft rows, so past the table a row costs about the curve's mean slope,
+    6-10 ms on two Sparks, not its flattening top)."""
+
+    table = list(table)
+    n = len(table)
+    if rows <= n:
+        return float(table[max(rows, 1) - 1])
+    half = n // 2
+    slope = (table[-1] - table[half - 1]) / max(n - half, 1) if n >= 2 else 0.0
+    return float(table[-1] + max(slope, float(slope_min), 0.0) * (rows - n))
+
+
+class RoundCosts:
+    """Committed tokens and model ms of the recent rounds of all sequences (the same on both ranks: the costs are
+    the load-time table and the tokens are committed ones). ``rate()`` is the aggregate rate a round's rows must beat
+    when more than one sequence shares the rounds (a row of one sequence slows every other one), else None (a
+    request alone keeps its own running rate)."""
+
+    WINDOW = 16
+
+    def __init__(self, costs: dict, row_ms: float = 0.0) -> None:
+        self.costs = costs
+        self.verify = list(costs["verify"])
+        self.row_ms = float(row_ms)             # patches/0200: the slope floor past the table (0: 0120's model)
+        self.rounds: list[tuple[int, float]] = []
+        self.shared = False
+
+    def round_ms(self, parts: Sequence[tuple[str, int, int, int]]) -> float:
+        """parts: per sequence (arm, rows, MTP steps, backlog); "s" serial, "l" lookup, "m" MTP, "f" DFlash2."""
+
+        from .lookup import round_ms
+
+        total = sum(r for _, r, _, _ in parts)
+        ms = verify_ms(self.verify, total, self.row_ms)
+        for arm, rows, steps, backlog in parts:
+            if arm in ("m", "f"):
+                ms += round_ms(self.costs, arm, rows, steps, backlog) - round_ms(self.costs, "l", rows, 0, 0)
+        return ms
+
+    def record(self, parts: Sequence[tuple[str, int, int, int]], tokens: int) -> None:
+        self.rounds.append((int(tokens), self.round_ms(parts)))
+        del self.rounds[:-self.WINDOW]
+        self.shared = len(parts) > 1
+
+    def rate(self) -> float | None:
+        if not self.shared or not self.rounds:
+            return None
+        ms = sum(m for _, m in self.rounds)
+        return sum(k for k, _ in self.rounds) / ms if ms > 0 else None
+
+    def table(self, others: int) -> list[float]:
+        """A sequence's window costs when ``others`` rows of other sequences share its forward: row k's marginal ms is
+        the slope of the curve at others + k (only the differences matter to ``depth.best_k``)."""
+
+        if others <= 0:
+            return list(self.verify)
+        return [verify_ms(self.verify, others + k + 1, self.row_ms) for k in range(len(self.verify))]
diff --git a/src/tensorfold/families/glm5_next/spark/calib.py b/src/tensorfold/families/glm5_next/spark/calib.py
new file mode 100644
index 0000000..ee20317
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/calib.py
@@ -0,0 +1,219 @@
+"""Draft cost calibration on real text, and its optional online refinement (patches/0070).
+
+Why. ``GlmEngine._calibrate`` prices a verify window of R rows for ``decode.DrafterChoice`` and the prompt-lookup
+gate (``lookup.py``). Upstream times those windows on uniformly random token ids. On a MoE model an extra row
+costs mostly the experts it adds to the window, and random ids route to nearly independent experts, while the
+consecutive tokens of real text share many of theirs; so random windows overprice every row past the first (the
+real model calibrated 30.0, 40.0, 44.7, ... ms for 1, 2, 3, ... rows: +10 ms for the second row), and every choice
+that weighs a deeper window against its cost drafts too little.
+
+Load time (``GLM53_TF_CALIB``):
+
+- ``real`` (the default): rank 0 tokenizes ``TEXT`` (prose and code) with the checkpoint's ``tokenizer.json`` and
+  shares the ids with rank 1 (``GlmEngine._share``), so both ranks prefill the same prompt; without a tokenizer
+  (the synthetic test checkpoints) the prompt is ``fallback_ids``. The model then decodes ``SPANS x MAX_ROWS``
+  tokens greedily from it, and every window is timed on the model's own consecutive continuation tokens at their
+  own positions: span s prefills the prompt and the first s x MAX_ROWS continuation tokens, then times windows of
+  1 to MAX_ROWS of the next ones (exactly the window a fully accepted round verifies there). A window's cost is
+  the mean over the spans of its fastest run.
+- ``random``: upstream (uniform random ids, the same seed), for A/B.
+- ``cached`` (patches/0140): the table a ``real`` calibration stored for the same image, knobs, engine shape, GPUs
+  and clock caps (``fastboot`` calibration cache; rank 0 reads it and shares it); measured as ``real`` (and
+  stored) when there is none. ``real`` always measures, so it is the forced re-measure, and refreshes the table.
+
+Either way each piece's time is the slower rank's (an all-gather, then the maximum), so both ranks hold the same
+table: the maximum over the same gathered numbers is the same float on both.
+
+Online (``GLM53_TF_CALIB_ONLINE=1``, off by default): rank 0 keeps an exponential moving average of the verify
+windows it actually runs in ``decode.auto_decode``, per window size (``OnlineCosts``). Before each request rank 0
+freezes its current table into integer microseconds and sends it in the request header (``GlmEngine._share``);
+both ranks decode the same integers into the same floats and use that table, unchanged, for the whole request.
+Rank 1's own timings never enter any decision. Not used with GLM53_TF_BATCH > 1 (batched rounds keep the
+load-time table).
+
+No torch here: the unit tests run anywhere.
+"""
+
+from __future__ import annotations
+
+import os
+import statistics
+from pathlib import Path
+from typing import Sequence
+
+MODES = ("random", "real", "cached")
+SPANS = 3                 # continuation spans a window size is timed on (real mode)
+DEEP_FROM = 8             # patches/0380: windows past this many rows are fitted on their own line
+PROMPT_MAX = 256          # tokens of TEXT kept
+
+# A short fixed text of the kinds this server decodes: prose, a numbered explanation, and code with a docstring.
+TEXT = """The committee met on Tuesday to review the quarterly results. Revenue grew by eleven percent, driven mostly
+by the new subscription plans, while operating costs stayed flat. Two questions remained open: whether to expand
+the support team before the summer, and how to price the enterprise tier for customers with more than fifty seats.
+
+Here is a short function that answers the second question from the usage data:
+
+```python
+def enterprise_price(seats: int, base: float = 12.0, discount: float = 0.15) -> float:
+    \"\"\"Monthly price for a team: the first fifty seats at the base rate, the rest discounted.\"\"\"
+    if seats <= 50:
+        return seats * base
+    return 50 * base + (seats - 50) * base * (1.0 - discount)
+
+
+for team in (10, 50, 120):
+    print(f"{team} seats: ${enterprise_price(team):,.2f} a month")
+```
+
+In summary, the pricing keeps small teams unchanged and rewards larger ones, and the"""
+
+
+def mode() -> str:
+    """GLM53_TF_CALIB: ``real`` (default), ``random`` (upstream) or ``cached`` (patches/0140)."""
+
+    m = os.environ.get("GLM53_TF_CALIB", "real").strip().lower() or "real"
+    if m not in MODES:
+        raise ValueError(f"GLM53_TF_CALIB={m!r}: expected one of {', '.join(MODES)}")
+    return m
+
+
+def online() -> bool:
+    """GLM53_TF_CALIB_ONLINE (default 0): refine the verify windows' costs from the windows rounds run."""
+
+    return os.environ.get("GLM53_TF_CALIB_ONLINE", "0").strip().lower() not in ("0", "false", "off", "no", "")
+
+
+def fallback_ids(vocab: int, n: int = 64) -> list[int]:
+    """A fixed prompt without a tokenizer: ids spread over the vocabulary by a fixed rule (no rng state)."""
+
+    return [(7919 * (i + 1) + 104729) % max(vocab - 2, 1) + 1 for i in range(n)]
+
+
+def prompt_ids(model_dir: Path | None, vocab: int) -> list[int]:
+    """``TEXT`` in the checkpoint's own tokens (``tokenizer.json``), or ``fallback_ids`` when there is none.
+    Called on rank 0 only; the engine shares the result."""
+
+    ids: list[int] = []
+    path = Path(model_dir) / "tokenizer.json" if model_dir is not None else None
+    if path is not None and path.is_file():
+        try:
+            from tokenizers import Tokenizer
+
+            ids = list(Tokenizer.from_file(str(path)).encode(TEXT, add_special_tokens=False).ids)
+        except Exception:            # noqa: BLE001 - any tokenizer trouble: the fixed ids below
+            ids = []
+    ids = [int(t) for t in ids if 0 <= int(t) < vocab][:PROMPT_MAX]
+    return ids if len(ids) >= 16 else fallback_ids(vocab)
+
+
+def slower(names: Sequence[str], gathered: Sequence[float]) -> dict[str, float]:
+    """Each piece's time as the slower rank's, from the all-gathered [rank 0's times..., rank 1's times...]. A
+    function of the gathered list only, which is the same on both ranks."""
+
+    n = len(names)
+    return {k: max(float(gathered[i]), float(gathered[n + i])) for i, k in enumerate(names)}
+
+
+def fit_line(rows: Sequence[int], ys: Sequence[float]) -> tuple[float, float]:
+    """(base, slope) of the line through (rows, ys): median of pairwise slopes, then the median intercept (as
+    upstream fits the windows of 2 rows and more)."""
+
+    slope = statistics.median((ys[j] - ys[i]) / (rows[j] - rows[i]) for i in range(len(rows))
+                              for j in range(i + 1, len(rows)))
+    base = statistics.median(y - slope * r for r, y in zip(rows, ys))
+    return base, slope
+
+
+def window_costs(both: dict[str, float], most: int, spans: int) -> list[float]:
+    """Verify windows of 1 to ``most`` rows from the reconciled pieces: ``v{r}`` (random mode) or ``v{r}_{s}``
+    per span s (real mode, averaged over the spans); the windows of 2 rows and more on their fitted line."""
+
+    if spans:
+        v = {r: statistics.fmean(both[f"v{r}_{s}"] for s in range(spans)) for r in range(1, most + 1)}
+    else:
+        v = {r: both[f"v{r}"] for r in range(1, most + 1)}
+    # patches/0380: windows past 8 rows (GLM53_TF_MAX_DRAFT_ROWS) on a line of their own, through the 8-row window's
+    # fitted cost, so the 1..8 table is the one an 8-row calibration fits from the same times
+    first = min(most, DEEP_FROM)
+    rows = list(range(2, first + 1))
+    base, slope = fit_line(rows, [v[r] for r in rows])
+    table = [v[1]] + [base + slope * r for r in rows]
+    if most > first:
+        deep = list(range(first, most + 1))
+        _, slope2 = fit_line(deep, [v[r] for r in deep])
+        table += [table[-1] + max(slope2, 0.0) * (r - first) for r in range(first + 1, most + 1)]
+    return table
+
+
+# -- online refinement (rank 0) ------------------------------------------------------------------------------------
+US = 1000.0               # the header carries milliseconds as integer microseconds
+
+
+def encode_table(verify: Sequence[float]) -> list[int]:
+    return [max(1, min(int(round(float(v) * US)), 10**9)) for v in verify]
+
+
+def decode_table(ints: Sequence[int]) -> list[float]:
+    return [int(v) / US for v in ints]
+
+
+def with_table(costs: dict, ints: Sequence[int]) -> dict:
+    """``costs`` with its verify windows replaced by a table from the header (unchanged for an empty table)."""
+
+    if not ints:
+        return costs
+    out = dict(costs)
+    out["verify"] = decode_table(ints)
+    return out
+
+
+class OnlineCosts:
+    """Rank 0's running verify-window costs: an EMA per window size seeded with the load-time table (which counts
+    as one sample). ``observe`` after each verify window; ``table`` freezes the current estimate for a request."""
+
+    def __init__(self, verify: Sequence[float], *, alpha: float | None = None, least: int | None = None) -> None:
+        self.base = [float(v) for v in verify]
+        self.ema = list(self.base)
+        self.n = [0] * len(self.base)
+        self.alpha = float(os.environ.get("GLM53_TF_CALIB_EMA", "0.05")) if alpha is None else float(alpha)
+        self.least = int(os.environ.get("GLM53_TF_CALIB_MIN", "8")) if least is None else int(least)
+        if not 0.0 < self.alpha <= 1.0 or self.least < 1:
+            raise ValueError(f"GLM53_TF_CALIB_EMA={self.alpha} (0 to 1) / GLM53_TF_CALIB_MIN={self.least} (>= 1)")
+
+    def observe(self, rows: int, ms: float) -> None:
+        """A verify window of ``rows`` rows took ``ms``. A sample counts as at most 1.5 times (at least half) the
+        current estimate, so a slow moment (page migration) moves the estimate by at most alpha / 2 of itself."""
+
+        i = int(rows) - 1
+        if not 0 <= i < len(self.ema) or not ms > 0.0:
+            return
+        est = self.ema[i]
+        x = min(max(float(ms), 0.5 * est), 1.5 * est)
+        a = max(self.alpha, 1.0 / (self.n[i] + 2))
+        self.ema[i] = est + a * (x - est)
+        self.n[i] += 1
+
+    def current(self) -> list[float]:
+        """Measured sizes (at least ``least`` windows) at their EMA; the others from the line through the
+        measured sizes of 2 rows and more (or the load-time value shifted by the one measured size's change),
+        then made non-decreasing in the row count."""
+
+        seen = [self.n[i] >= self.least for i in range(len(self.ema))]
+        out = [self.ema[i] if seen[i] else self.base[i] for i in range(len(self.ema))]
+        rows = [i + 1 for i in range(1, len(self.ema)) if seen[i]]
+        if len(rows) >= 2:
+            base, slope = fit_line(rows, [self.ema[r - 1] for r in rows])
+            for i in range(1, len(out)):
+                if not seen[i]:
+                    out[i] = base + slope * (i + 1)
+        elif len(rows) == 1:
+            shift = self.ema[rows[0] - 1] - self.base[rows[0] - 1]
+            for i in range(1, len(out)):
+                if not seen[i]:
+                    out[i] = self.base[i] + shift
+        for i in range(1, len(out)):
+            out[i] = max(out[i], out[i - 1])
+        return out
+
+    def table(self) -> list[int]:
+        return encode_table(self.current())
