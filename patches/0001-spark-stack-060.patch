+def _poll_s() -> float:
+    """patches/0600: GLM53_TF_DISCONNECT_POLL_MS (default 250, 10..10000): how often an HTTP thread waiting on its
+    request checks whether the client is still there."""
+
+    ms = _env_int("GLM53_TF_DISCONNECT_POLL_MS", 250)
+    if not 10 <= ms <= 10000:
+        raise ValueError(f"GLM53_TF_DISCONNECT_POLL_MS={ms}: expected 10..10000")
+    return ms / 1000.0
