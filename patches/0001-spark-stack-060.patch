+"""The OpenAI routes for GLM-5.3-Flash (``CUDA_APP``): ``server.App`` (the Spark server) plus two request fields.
+
+- A request picks its draft policy with ``"model": "<served name>@<spec>"`` or ``"tf_policy": "<spec>"`` (specs in
+  ``engine.py``); without one the engine's default applies.
+- ``"ignore_eos": true`` decodes ``max_tokens`` tokens past an end-of-sequence token (the benchmarks use it).
+- ``"tf_knobs": {...}`` (patches/0090, ``knobs.py``) overrides engine knobs (prefill chunk rows, lookup, expert
+  kernel, ...) for this request only; the response's ``tensorfold.tf_knobs`` echoes the values it ran with.
+- ``"priority": "background"`` (patches/0120, with GLM53_TF_BATCH): the request yields to every other one.
+
+A request whose prompt plus ``max_tokens`` needs more context than the engine was started for gets an HTTP 400
+before anything streams, naming the ``--context`` to restart both ranks with. Without ``max_tokens`` the reply
+stops where the context ends.
+
+patches/0150: GLM53_TF_EFFORT_FIELD=1 honours OpenAI's top-level ``reasoning_effort`` (``none`` / ``minimal``: thinking
+off; ``low``: the template's Low effort; ``medium`` / ``high``: High; ``max`` / ``xhigh``: the template default, Max) by
+filling ``chat_template_kwargs`` where the request left them unset, and GLM53_TF_DEFAULT_EFFORT (``low`` | ``high`` |
+``max``) is the effort of a thinking request that names none. For structured output (long tables, JSON with many
+numbers), thinking on at ``low`` effort is the reliable setting: the MiaAI-Lab kit measured 0/6 garbled and 791/792
+numbers right against 5-6/6 garbled with thinking off (their PR #279).
+
+With thinking off, a chat renders the way GLM-5.3's thinking-off template does: the checkpoint's template always
+opens a think block, so it gets an empty ``<think></think>`` and no reasoning-effort line.
+
+patches/0210: a request's prompt is encoded once (``check`` hands its ids to ``run``), and with GLM53_TF_TOKCACHE (on
+unless ``0``; ``verify`` checks every reuse against a full encode) only the text after the longest special-token
+prefix a recent prompt shares is encoded (``prompt_tokens.py``). Only rank 0 tokenizes; rank 1 receives the ids.
+
+patches/0300: GLM53_TF_REQUEST_LOG=<file> appends one JSON line per request (sizes, cache source, timings, finish,
+hashes of token ids; never text) on this, the serving rank (``reqlog.py``).
+
+patches/0500: GLM53_TF_VISION=1 takes images in chat messages (``image_url`` parts: ``data:`` URLs and, unless
+GLM53_TF_VISION_FETCH=0, http(s) URLs; ``vision_prep.py``): each renders as ``<|begin_of_image|><|image|>
+<|end_of_image|>`` (``VisionTemplate``), the image's rows replace its ``<|image|>`` as virtual ids (so every
+token-keyed cache tells images apart), and the engine gets the preprocessed images through ``request.vision``. An
+image problem (fetch, size, decode, count) is an HTTP 400 before anything streams. ``usage.prompt_tokens`` counts the
+image rows, as vLLM does; ``/tokenize`` returns them as ``<|image|>`` ids.
+
+patches/0610: GLM53_TF_GRAMMAR=1 enforces ``response_format`` (json_object / json_schema), vLLM's ``guided_*`` /
+``structured_outputs`` and strict / required tool calls (``grammar.py``); off, those fields are ignored as before.
+
+patches/0620: GLM53_TF_TOOL_FIXES (a comma list, ``all``; off by default) fixes tool-calling chains: history rendering
+(``content: null``, ``reasoning`` as ``reasoning_content``, empty arguments), the reasoning of earlier tool-call steps
+kept for clients that drop it, ``tool_choice`` none / named and ``parallel_tool_calls: false``, schema-typed
+arguments, calls left inside an unclosed think block, and (``grammar``) schema-held calls for every tools request
+(``toolfix.py``, docs/TOOL-CALLING.md).
+
+patches/0490: a request past the context gets HTTP 400 with OpenAI's ``context_length_exceeded`` code and wording
+("This model's maximum context length is N tokens. However, you requested ..."), which agent clients recognise and
+answer by compacting; ``/v1/models`` reports the limit as ``max_model_len`` / ``context_length``; the load prints one
+``[tensorfold] context:`` line (the limit, the KV cache, the slots, the pool). ``/v1/completions`` also takes one list
+of token ids as ``prompt`` (``/tokenize`` makes them), as vLLM does.
+
+patches/0600 (upstream TensorFold ports, docs/UPSTREAM-050-AUDIT.md): a request whose client has gone is stopped
+while it waits, prefills or decodes, streamed or not (GLM53_TF_DISCONNECT, ``batch.Batcher._collect``), and logged
+``cancelled``; malformed requests are 400s before a stream's headers (sampling fields, ``chat_template_kwargs``, a
+template refusal, any other ``check`` failure) and too many image preparations at once a 503; image URLs are HTTPS
+on 443 to public addresses only (``image_fetch.py``).
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any, Callable
+
+from .server import App, context_problem
+from tensorfold.server.cancellation import RequestCancelled                 # patches/0600
+
+from .prompt_tokens import Memo, PromptTokens
+from . import reqlog as reqlog_mod
+from . import vision_prep
+
+# patches/0150: OpenAI ``reasoning_effort`` -> (enable_thinking, the template's reasoning_effort or None: its default)
+EFFORTS: dict[str, tuple[bool, str | None]] = {
+    "none": (False, None), "minimal": (False, None), "low": (True, "low"), "medium": (True, "high"),
+    "high": (True, "high"), "xhigh": (True, None), "max": (True, None)}
+
+
+def effort_env() -> tuple[bool, str | None]:
+    """(GLM53_TF_EFFORT_FIELD on, GLM53_TF_DEFAULT_EFFORT or None), validated."""
+
+    field = os.environ.get("GLM53_TF_EFFORT_FIELD", "0").strip() or "0"
+    if field not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_EFFORT_FIELD={field!r}: expected 0 or 1")
+    default = os.environ.get("GLM53_TF_DEFAULT_EFFORT", "").strip().lower() or None
+    if default not in (None, "low", "high", "max"):
+        raise ValueError(f"GLM53_TF_DEFAULT_EFFORT={default!r}: expected low, high or max")
+    return field == "1", (None if default == "max" else default)
+
+
+def apply_effort(body: dict[str, Any], *, field: bool, default: str | None, default_thinking: bool) -> str | None:
+    """Fill ``body["chat_template_kwargs"]`` from ``reasoning_effort`` (with ``field``) and ``default``; keys the
+    request set itself win. Idempotent (``check`` and ``run`` both call it). Returns an error message, or None."""
+
+    kwargs = body.get("chat_template_kwargs")
+    if kwargs is not None and not isinstance(kwargs, dict):
+        return None                                     # left for the template to reject as before
+    kwargs = dict(kwargs or {})
+    asked = body.get("reasoning_effort") if field else None
+    if asked is not None:
+        key = str(asked).strip().lower()
+        if key not in EFFORTS:
+            return f"reasoning_effort must be one of {', '.join(EFFORTS)} (got {asked!r})"
+        thinking, effort = EFFORTS[key]
+        kwargs.setdefault("enable_thinking", thinking)
+        if thinking and effort is not None:
+            kwargs.setdefault("reasoning_effort", effort)
+    elif default is not None and bool(kwargs.get("enable_thinking", default_thinking)):
+        kwargs.setdefault("reasoning_effort", default)
+    if kwargs or "chat_template_kwargs" in body:
+        body["chat_template_kwargs"] = kwargs
+    return None
+
+
+class ThinkingOffTemplate:
+    """The checkpoint's chat template, rendered as GLM-5.3's thinking-off template renders it when thinking is off."""
+
+    def __init__(self, inner) -> None:
+        self.inner = inner
+
+    def render(self, messages, *, tools, enable_thinking, extra=None) -> str:
+        text = self.inner.render(messages, tools=tools, enable_thinking=enable_thinking, extra=extra)
+        if not enable_thinking:
+            text = text.replace("<|system|>Reasoning Effort: Max", "", 1)
+            if text.endswith("<|assistant|><think>"):
+                text += "</think>"
+        return text
+
+
+class VisionTemplate:
+    """patches/0500: the chat template with image parts rendered as the vision template renders them
+    (``<|begin_of_image|><|image|><|end_of_image|>``); the images it kept, in prompt order, are left for the calling
+    thread (``local.rendered``: (text, refs))."""
+
+    def __init__(self, inner, host: "vision_prep.Host", local) -> None:
+        self.inner = inner
+        self.host = host
+        self.local = local
+
+    def render(self, messages, *, tools, enable_thinking, extra=None) -> str:
+        if not vision_prep.count_images(messages):
+            self.local.rendered = None
+            return self.inner.render(messages, tools=tools, enable_thinking=enable_thinking, extra=extra)
+        text, refs = self.host.render(self.inner, messages, tools=tools, enable_thinking=enable_thinking,
+                                      extra=extra)
+        self.local.rendered = (text, refs)
+        return text
+
+
+def context_summary(engine) -> str:
+    """patches/0490: one line with what decides how long a request can be: the context limit (CONTEXT, the limit
+    ``/v1/models`` reports as ``max_model_len``), the KV cache format, the batch slots and the shared KV pool."""
+
+    limit = getattr(engine, "limit", None)
+    latent = os.environ.get("GLM53_TF_LATENT_KV", "0").strip() == "1"
+    kv = (f"latent {os.environ.get('GLM53_TF_KV_DTYPE', 'bf16').strip() or 'bf16'}" if latent
+          else "per-head K/V (GLM53_TF_LATENT_KV=0, ~390 KB a token a rank)")
+    batch = getattr(engine, "batch", None)
+    slots = int(getattr(batch, "n", 1) or 1) if batch is not None else 1
+    pool = getattr(batch, "kvp", None) if batch is not None else None
+    line = (f"context: {limit} tokens a request (max_model_len; set by CONTEXT / --context); KV cache: {kv}; "
+            f"{slots} request slot(s)")
+    if pool is not None:
+        line += f"; KV pool: {pool.npages * pool.page} tokens shared by the slots"
+    if isinstance(limit, int) and limit <= 65536:
+        line += (f". Requests past {limit} tokens (prompt + max_tokens) get HTTP 400 context_length_exceeded; for "
+                 "long context start with a long-context config (config/prod.env.example: CONTEXT=1048576)")
+    return line
+
+
+class GlmApp(App):
+    vision = None                                   # patches/0500: ``vision_prep.Host`` with GLM53_TF_VISION=1
+
+    @property
+    def _vis(self):
+        """patches/0500: this request thread's image state (``ready``: check's work for run; ``rendered``)."""
+
+        local = self.__dict__.get("_vis_local")
+        if local is None:
+            import threading as _threading
+
+            local = self.__dict__.setdefault("_vis_local", _threading.local())
+        return local
+
+    def __init__(self, engine, model_dir, served: str, **kwargs: Any) -> None:
+        super().__init__(engine, model_dir, served, **kwargs)
+        self.template = ThinkingOffTemplate(self.template)
+        self.vision = vision_prep.Host(model_dir) if vision_prep.enabled() else None      # patches/0500
+        if self.vision is not None:
+            self.template = VisionTemplate(self.template, self.vision, self._vis)
+            s = self.vision.s
+            print(f"[tensorfold] vision (patches/0500): image_url parts on; {s.min_tokens}-{s.budget(None)} tokens an "
+                  f"image, at most {s.max_images} a request; URL fetch {'on' if s.fetch else 'off'}", flush=True)
+        self.effort_field, self.default_effort = effort_env()       # patches/0150
+        from .toolfix import ToolFixes      # patches/0620: GLM53_TF_TOOL_FIXES (off: every request as before)
+
+        self.toolfix = ToolFixes(self.tok.token_to_id("<|observation|>"))
+        if self.toolfix:
+            print(f"[tensorfold] tool calling (patches/0620): {self.toolfix.describe()}", flush=True)
+        self.prompt_tokens = PromptTokens(self.tok, model_dir / "tokenizer.json")   # patches/0210
+        self.prompt_memo = Memo()
+        # patches/0300: the request log (GLM53_TF_REQUEST_LOG; None: off); the App serves on rank 0 only
+        import threading
+
+        self.reqlog = reqlog_mod.RequestLog.from_env(self.tok)
+        self._rl = threading.local()
+        if self.reqlog is not None:
+            print(f"[tensorfold] request log (patches/0300): one JSON line a request to {self.reqlog.path}",
+                  flush=True)
+        print(f"[tensorfold] {context_summary(engine)}", flush=True)          # patches/0490
+        if getattr(engine, "batch", None) is not None:
+            # GLM53_TF_BATCH (patches/0030): the engine queues concurrent requests itself, so ``App.run`` must not
+            # serialize them
+            import contextlib
+
+            self.lock = contextlib.nullcontext()
+
+    def check(self, body: dict[str, Any]) -> str | None:
+        """``App.check``, then the context: the prompt as ``run`` renders it plus ``max_tokens`` must fit the
+        engine's limit (2,051 tokens unless the server was started with a larger ``--context``)."""
+
+        problem = apply_effort(body, field=self.effort_field, default=self.default_effort,
+                               default_thinking=self.default_thinking) or self._toolfix(body) \
+            or super().check(body)   # patches/0150, 0620
+        if not problem and getattr(self.engine, "grammar_on", False):
+            from . import grammar as grammar_mod    # patches/0610: a malformed / non-compiling grammar is a 400
+
+            problem = grammar_mod.check(self.engine, body)
+        limit = getattr(self.engine, "limit", None)
+        self._vis.ready = None
+        if problem:
+            return problem
+        chat = "messages" in body
+        if self.vision is not None and chat and vision_prep.count_images(body.get("messages")):
+            try:                                    # patches/0500: fetch, decode and preprocess now: errors are 400s
+                text, req = self._vision_request(body)
+            except (vision_prep.VisionError, ValueError) as exc:
+                from .server import Problem
+
+                # patches/0600: too many image preparations at once is a 503 (retry shortly), as upstream
+                status = 503 if isinstance(exc, vision_prep.VisionBusy) else 400
+                return Problem(str(exc), param="messages", status=status)
+            ids = self._vis.ready[3]
+            self.prompt_memo.put(text, ids)             # patches/0210: ``run`` reuses them
+            if limit is None:
+                return None
+            asked = body.get("max_tokens") or body.get("max_completion_tokens")
+            return context_problem(len(ids) + req.extra, int(asked) if asked else None, limit, chat=True)
+        if limit is None:
+            return problem
+        kwargs = dict(body.get("chat_template_kwargs") or {})
+        thinking = bool(kwargs.pop("enable_thinking", self.default_thinking))
+        if chat:
+            text = self.template.render(body["messages"], tools=body.get("tools") or [], enable_thinking=thinking,
+                                        extra=kwargs)
+        elif isinstance(body.get("prompt"), list):              # patches/0490: token ids (checked by App.check)
+            text = None
+        else:
+            text = body.get("prompt") or ""
+        if text is None:
+            prompt = len(body["prompt"])
+        else:
+            ids = self.prompt_tokens.encode(text)                   # patches/0210: ``run`` reuses these
+            self.prompt_memo.put(text, ids)
+            prompt = len(ids)
+        asked = body.get("max_tokens") or body.get("max_completion_tokens")
+        # patches/0490: OpenAI's context_length_exceeded (code, wording) instead of a message only people could read
+        return context_problem(prompt, int(asked) if asked else None, limit, chat=chat)
+
+    def _toolfix(self, body: dict[str, Any]) -> str | None:
+        """patches/0620: the request's messages / tools fixed in place (idempotent), or why it cannot run."""
+
+        fixes = getattr(self, "toolfix", None)
+        return fixes.prepare(body) if fixes else None
+
+    def reply_hook(self, body: dict[str, Any], *, content: str, calls, reasoning: str, last, thinking: bool,
+                   stopped: bool):
+        """patches/0620: a finished reply with tools, fixed (``toolfix.ToolFixes.reply``)."""
+
+        fixes = getattr(self, "toolfix", None)
+        if not fixes:
+            return content, calls, reasoning
+        return fixes.reply(body, content=content, calls=calls, reasoning=reasoning, last=last, thinking=thinking,
+                           stopped=stopped)
+
+    def _vision_request(self, body: dict[str, Any]) -> tuple[str, "vision_prep.Request"]:
+        """patches/0500: (the rendered text, its images preprocessed) for a chat request with images, made once a
+        request thread (``check`` makes it, ``run`` reuses it)."""
+
+        ready = getattr(self._vis, "ready", None)
+        if ready is not None and ready[0] is body:
+            return ready[1], ready[2]
+        kwargs = dict(body.get("chat_template_kwargs") or {})
+        thinking = bool(kwargs.pop("enable_thinking", self.default_thinking))
+        text = self.template.render(body["messages"], tools=body.get("tools") or [], enable_thinking=thinking,
+                                    extra=kwargs)
+        rendered = getattr(self._vis, "rendered", None)
+        refs = rendered[1] if rendered is not None and rendered[0] == text else []
+        req = self.vision.request(refs)
+        ids = self.prompt_tokens.encode(text)
+        vision_prep.expand(ids, req.images, self.vision.s)          # the placeholders check out (raises otherwise)
+        self._vis.ready = (body, text, req, ids)
+        return text, req
+
+    def _with_images(self, text: str, ids: list[int]) -> list[int]:
+        """patches/0500: a rendered prompt's ids with its images' rows (virtual ids); the engine gets the images."""
+
+        req = None
+        rendered = getattr(self._vis, "rendered", None) if self.vision is not None else None
+        if rendered is not None and rendered[0] == text:
+            ready = getattr(self._vis, "ready", None)
+            req = ready[2] if ready is not None and ready[1] == text else self.vision.request(rendered[1])
+            ids = vision_prep.expand(ids, req.images, self.vision.s)
+        self._set_vision(req)
+        return ids
+
+    def _set_vision(self, req) -> None:
+        """patches/0500: the images the engine encodes for this thread's request (None: none)."""
+
+        local = getattr(self.engine, "request", None)
+        if local is not None:
+            local.vision = req
+
+    def prompt_ids(self, text: str) -> list[int]:
+        """patches/0210: the ids ``check`` encoded for this text on this request thread, else from the cache."""
+
+        ids = self.prompt_memo.take(text)
+        ids = ids if ids is not None else self.prompt_tokens.encode(text)
+        ids = self._with_images(text, list(ids))                    # patches/0500
+        if self.reqlog is not None:                     # patches/0300: the request's prompt, before it runs
+            self._rl.ticket = self.reqlog.begin(ids)
+        return ids
+
+    def given_ids(self, ids: list[int]) -> list[int]:
+        """patches/0490: a token-ID prompt, logged as ``prompt_ids`` logs a rendered one (0300)."""
+
+        ids = super().given_ids(ids)
+        self._set_vision(None)                                      # patches/0500: token prompts carry no images
+        if self.reqlog is not None:
+            self._rl.ticket = self.reqlog.begin(ids)
+        return ids
+
+    def tokenize(self, body: dict[str, Any]) -> list[int]:
+        """patches/0490: ``App.tokenize`` with the request's reasoning effort applied first (0150), so ``messages``
+        render as a chat request with the same body renders them."""
+
+        apply_effort(body, field=self.effort_field, default=self.default_effort, default_thinking=self.default_thinking)
+        problem = self._toolfix(body)                               # patches/0620
+        if problem:
+            raise ValueError(problem)
+        self._vis.rendered = None
+        ids = super().tokenize(body)
+        rendered = getattr(self._vis, "rendered", None)
+        if self.vision is not None and rendered is not None and isinstance(body.get("messages"), list):
+            req = self.vision.request(rendered[1])                  # patches/0500: each image as its rows
+            ids = vision_prep.expand(ids, req.images, self.vision.s, virtual=False)
+        return ids
+
+    def run(self, body: dict[str, Any], chat: bool, emit: Callable[[dict[str, Any]], bool], *,
+            cancelled: Callable[[], bool] | None = None) -> dict[str, Any]:
+        from . import cpupin
+
+        cpupin.http_thread()                    # patches/0370 (GLM53_TF_CPU_PIN): a name for ps, ``nice`` when set
+        apply_effort(body, field=self.effort_field, default=self.default_effort,
+                     default_thinking=self.default_thinking)           # patches/0150 (validated by ``check``)
+        self._toolfix(body)                                         # patches/0620 (validated by ``check``)
+        self._set_vision(None)                                      # patches/0500: set by ``prompt_ids``
+        self._vis.rendered = None
+        if self.vision is not None and chat and vision_prep.count_images(body.get("messages")):
+            self._vision_request(body)                              # made by ``check`` on this thread already
+        model = str(body.get("model") or "")
+        self.engine.request.policy = body.get("tf_policy") or (model.split("@", 1)[1] if "@" in model else None)
+        self.engine.request.stop_eos = not bool(body.get("ignore_eos", False))
+        self.engine.request.knobs = body.get("tf_knobs")     # patches/0090: validated by ``check``
+        if getattr(self.engine, "grammar_on", False):
+            from . import grammar as grammar_mod    # patches/0610: the request's compiled grammar (None: plain)
+
+            self.engine.request.grammar = grammar_mod.for_request(self.engine, body)
+        # patches/0120: with GLM53_TF_BATCH, a background request (``"priority": "background"``, or a client's
+        # session-title request) is admitted after every waiting request and steps aside for one when every slot is
+        # busy; it then runs again from the start and its caller receives the same tokens
+        from .batchplan import is_title_request
+
+        self.engine.request.background = body.get("priority") == "background" or (
+            chat and is_title_request(body.get("messages"), body.get("tools")))
+        extra = {} if cancelled is None else {"cancelled": cancelled}      # patches/0600
+        log = self.reqlog
+        if log is None:
+            return super().run(body, chat, emit, **extra)
+        # patches/0300: one line for this request once it ends (host only, on this HTTP thread)
+        self._rl.ticket = None
+
+        def logged_emit(delta: dict[str, Any]) -> bool:
+            log.first(getattr(self._rl, "ticket", None))
+            return emit(delta)
+
+        result, error = None, None
+        try:
+            result = super().run(body, chat, logged_emit, **extra)
+            return result
+        except RequestCancelled as exc:     # patches/0600: logged as ``cancelled`` with what it did, not an error
+            result = exc.result
+            raise
+        except BaseException as exc:
+            error = exc
+            raise
+        finally:
+            kwargs = body.get("chat_template_kwargs") or {}
+            thinking = bool(kwargs.get("enable_thinking", self.default_thinking)) if chat else None
+            eff = body.get("max_tokens") or body.get("max_completion_tokens") or self.max_tokens
+            log.end(getattr(self._rl, "ticket", None), body=body, chat=chat, result=result, error=error,
+                    thinking=thinking, max_tokens_eff=int(eff) if eff else None)
+            self._rl.ticket = None
diff --git a/src/tensorfold/families/glm5_next/spark/attention.py b/src/tensorfold/families/glm5_next/spark/attention.py
new file mode 100644
index 0000000..f81ef7a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/attention.py
@@ -0,0 +1,148 @@
+"""Exact causal attention for GLM's MLA layers on chains of rows (keys and values expanded per head, head dim
+256, no RoPE), with the committed length read on the device so a forward can be captured in a CUDA graph.
+
+The window's keys and values are written into the cache (slots P .. P + R - 1) before attention, so row r
+(absolute position P + r) attends to cache keys 0 .. P + r. A program handles up to 16 rows of one head and
+one 512-key chunk (eight 64-key tensor-core tiles, the 27B engine's tile step); chunk partials merge in
+absolute key order. A row's arithmetic is the same whatever the other rows of its tile, and chunks are
+fixed by absolute key position, so a window row gets the bits of the serial step at that position.
+Chunks past the last key are empty and skipped by the merge, so the chunk count (exact, or a capacity
+bound for a captured graph) never changes a result.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+import triton
+import triton.language as tl
+
+TILE = 64
+CHUNK = 512
+BR = 16
+
+
+@triton.jit
+def _tile(q, k, v, m, l, o, valid, SCALE: tl.constexpr):
+    scores = tl.dot(q, tl.trans(k)).to(tl.float32) * SCALE
+    scores = tl.where(valid, scores, float("-inf"))
+    tile_m = tl.max(scores, 1)
+    active = tile_m != float("-inf")
+    next_m = tl.where(active, tl.maximum(m, tile_m), m)
+    alpha = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+    p = tl.where(valid & active[:, None], tl.exp(scores - next_m[:, None]), 0.0)
+    o = o * alpha[:, None] + tl.dot(p.to(tl.bfloat16), v)
+    l = l * alpha + tl.sum(p, 1)
+    return next_m, l, o
+
+
+@triton.jit
+def _chunks(Q, KC, VC, POS, PO, PM, PL, R, H: tl.constexpr, D: tl.constexpr, CH: tl.constexpr,
+            SCALE: tl.constexpr, BRT: tl.constexpr):
+    rb = tl.program_id(0)
+    h = tl.program_id(1)
+    c = tl.program_id(2)
+    P = tl.load(POS)
+    rr = rb * BRT + tl.arange(0, BRT)
+    rok = rr < R
+    d = tl.arange(0, D)
+    m = tl.full((BRT,), float("-inf"), tl.float32)
+    l = tl.zeros((BRT,), tl.float32)
+    o = tl.zeros((BRT, D), tl.float32)
+    start = c * CH
+    if start < P + R:
+        q = tl.load(Q + (rr[:, None] * H + h) * D + d[None, :], mask=rok[:, None], other=0).to(tl.bfloat16)
+        limit = P + rr
+        for t in range(CH // 64):
+            ki = start + t * 64 + tl.arange(0, 64)
+            inside = ki < P + R
+            kk = tl.load(KC + (ki[:, None] * H + h) * D + d[None, :], mask=inside[:, None], other=0).to(tl.bfloat16)
+            vv = tl.load(VC + (ki[:, None] * H + h) * D + d[None, :], mask=inside[:, None], other=0).to(tl.bfloat16)
+            valid = (ki[None, :] <= limit[:, None]) & rok[:, None]
+            m, l, o = _tile(q, kk, vv, m, l, o, valid, SCALE)
+    base = (c * R + rr) * H + h
+    tl.store(PO + base[:, None] * D + d[None, :], o, mask=rok[:, None])
+    tl.store(PM + base, m, mask=rok)
+    tl.store(PL + base, l, mask=rok)
+
+
+@triton.jit
+def _merge(PO, PM, PL, OUT, R, H: tl.constexpr, D: tl.constexpr, NCH: tl.constexpr):
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    d = tl.arange(0, D)
+    m = float("-inf")
+    l = 0.0
+    o = tl.zeros((D,), tl.float32)
+    for c in range(NCH):
+        base = (c * R + r) * H + h
+        cm = tl.load(PM + base)
+        cl = tl.load(PL + base)
+        co = tl.load(PO + base * D + d)
+        active = cl > 0.0
+        next_m = tl.where(active, tl.maximum(m, cm), m)
+        a = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+        b = tl.where(active, tl.exp(cm - next_m), 0.0)
+        o = o * a + co * b
+        l = l * a + cl * b
+        m = next_m
+    tl.store(OUT + (r * H + h) * D + d, (o / l).to(tl.bfloat16))
+
+
+class AttnScratch:
+    """Chunk partials for up to ``rows`` rows, ``heads`` heads and a cache of ``capacity`` keys."""
+
+    def __init__(self, rows: int, heads: int, dim: int, capacity: int, device) -> None:
+        self.nch = triton.cdiv(capacity + rows, CHUNK)
+        self.po = torch.empty((self.nch * rows * heads * dim,), dtype=torch.float32, device=device)
+        self.pm = torch.empty((self.nch * rows * heads,), dtype=torch.float32, device=device)
+        self.pl = torch.empty((self.nch * rows * heads,), dtype=torch.float32, device=device)
+        self.out = torch.empty((rows, heads, dim), dtype=torch.bfloat16, device=device)
+
+
+def attention(q: torch.Tensor, k_cache: torch.Tensor, v_cache: torch.Tensor, pos: torch.Tensor, scratch: AttnScratch,
+              *, scale: float, nch: int | None = None, out: torch.Tensor | None = None) -> torch.Tensor:
+    """q [R, H, D] (rows at positions pos .. pos + R - 1), caches [capacity, H, D] holding keys through pos + R - 1,
+    pos an int32 [1] device tensor. ``nch``: chunks to visit (default: all the scratch holds). ``out``: where the
+    rows go (contiguous [R, H, D]; default scratch.out[:R]; batched rounds give each sequence its rows of the
+    window). -> [R, H, D] bf16."""
+
+    R, H, D = q.shape
+    nch = scratch.nch if nch is None else min(nch, scratch.nch)
+    # any row count: the grid tiles rows by BR and each tile's rows are independent (longer prefill chunks,
+    # GLM53_TF_PREFILL_ROWS); the scratch is sized for the engine's largest window
+    if D not in (128, 256) or scratch.out.shape[0] < R:
+        raise ValueError("unsupported attention shape")
+    po = scratch.po[:nch * R * H * D]
+    pm = scratch.pm[:nch * R * H]
+    pl = scratch.pl[:nch * R * H]
+    _chunks[(triton.cdiv(R, BR), H, nch)](q, k_cache, v_cache, pos, po, pm, pl, R, H=H, D=D, CH=CHUNK, SCALE=scale,
+                                          BRT=BR, num_warps=4, num_stages=1)
+    if out is None:
+        out = scratch.out[:R]
+    elif out.shape != (R, H, D) or not out.is_contiguous():
+        raise ValueError("attention: out must be contiguous [R, H, D]")
+    _merge[(R, H)](po, pm, pl, out, R, H=H, D=D, NCH=nch, num_warps=4)
+    return out
+
+
+@triton.jit
+def _kv_write(KN, VN, KC, VC, POS, W: tl.constexpr, BLOCK: tl.constexpr):
+    r = tl.program_id(0)
+    c = tl.program_id(1)
+    P = tl.load(POS).to(tl.int64)
+    offs = c * BLOCK + tl.arange(0, BLOCK)
+    tl.store(KC + (P + r) * W + offs, tl.load(KN + r * W + offs))
+    tl.store(VC + (P + r) * W + offs, tl.load(VN + r * W + offs))
+
+
+def kv_write(kn: torch.Tensor, vn: torch.Tensor, k_cache: torch.Tensor, v_cache: torch.Tensor, pos: torch.Tensor) -> None:
+    """Rows [R, H, D] into cache slots pos .. pos + R - 1 (pos read on the device)."""
+
+    R = kn.shape[0]
+    W = kn.shape[1] * kn.shape[2]
+    if vn.shape[1] * vn.shape[2] != W:
+        raise ValueError("kv_write: key and value rows must have the same width")
+    block = math.gcd(1024, W)            # 1024 for the model; narrower rows (tests) get every column written
+    _kv_write[(R, W // block)](kn, vn, k_cache, v_cache, pos, W=W, BLOCK=block, num_warps=4)
diff --git a/src/tensorfold/families/glm5_next/spark/b12x_attn.py b/src/tensorfold/families/glm5_next/spark/b12x_attn.py
new file mode 100644
index 0000000..abde7b8
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/b12x_attn.py
@@ -0,0 +1,167 @@
+"""One-pass sparse latent attention for fast-prefill chunks (patches/0240, ``tf_knobs.b12x`` bit 4).
+
+The structure follows b12x's sparse MLA prefill (https://github.com/local-inference-lab/b12x,
+``b12x/attention/sparse_mla``, Apache License 2.0, Copyright Luke Alonso and the b12x contributors): one program per
+query row holding all of the row's local heads, one online softmax over the row's whole selected-token list in list
+order, the normalized latent written directly -- no split of the ~2,051 selected tokens into 512-token chunks, so no
+fp32 chunk partials ([5, R, H, 512], ~335 MB written and read back a 1,024-row call) and no merge kernel. Re-implemented
+in Triton on this engine's latent tiles (``latent._lrows`` / ``latent._ltile``: bf16 or FP8 rows dequantized exactly,
+bf16 tensor-core scores and weighted sums, fp32 online softmax); b12x's FP8 query quantization and FP8 P.V are NOT
+taken (they change the arithmetic much more).
+
+Arithmetic: ``latent.sparse_latent``'s tile steps in the same list order, the same scale and masks, the running
+(m, l, o) carried across what were chunk boundaries instead of being merged at the end: the result differs from the
+chunked kernel's in the last fp32 bits of u (the merge's exp(m_c - m) rescaling is gone). Deterministic, one program
+per (row, head tile) whatever the call's rows (row-independent); fast chunks only (decode, verify, the MTP head and
+exact prefill keep the chunked kernels); new arithmetic, so its fast snapshots carry their own tag (``b12xpf``).
+
+patches/0360 (the FP8 latent cache production uses, patches/0220)
+-----------------------------------------------------------------
+FP8 == bf16 on the dequantized rows, by construction. Triton gives a ``tl.dot`` operand that was upcast from 8-bit
+data another register layout (``kWidth`` 4 instead of 2 on sm_121, Triton 3.7.1 and 3.8), which places the K
+elements differently inside each m16n8k16 MMA; with 0240's kernel the FP8 one-pass rows were not the bits of the same
+kernel on ``dequantize_rows`` (W3: that check failed; the row-subset and permutation checks passed). The dequantized
+tile now passes an impure identity (``_opaque``: one ``mov.b32`` per two values) that the upcast analysis does not look
+through, so both caches feed the dots in the same layout and the FP8 kernel is the bf16 kernel after the tile
+(``tests/b12x_onepass_ptx.py`` checks the layouts offline). The chunked kernels (decode, verify, exact and FP8
+production prefill today) are untouched.
+
+Row independence (0085): the grid is (R, ceil(H / BMQ)) with BMQ fixed by H (the weights); a program reads only its
+row's query, count and token list and walks the list in order in KT-token tiles, one fixed chain of mma and online-
+softmax steps whatever R, the other rows, the chunk or the lean / pipelined schedule. Nothing is split by R.
+
+Why it need not equal the chunked kernel's bits, and where it may run. It is not bit-identical to
+``latent.sparse_latent`` (the chunk merge's rescaling is gone). A kernel with other bits may serve only rows that
+are never recomputed by another kernel in the same configuration. Fast chunks are exactly such rows under patches/
+0080 / 0085: a fast-prefilled row is reused only through a snapshot of its own tag (fast G + 4 x the b12x bits) at a
+multiple of 64, a resumed request re-prefills every later row with fast chunks (so with this kernel), a reply's rows
+(decoded by the chunked kernel) are never kept in a fast snapshot, and exact requests never resume fast snapshots.
+Hence with bit 4 on: resumed == fresh (both prefill every row past the snapshot with fast chunks), drafted == serial
+(the same deterministic prefill, then the unchanged decode / verify kernels), batched == alone (batch pieces run
+``decode.prefill`` per slot; decode rounds never set ``b.fast``). Using it for decode / verify too is therefore not
+needed; it would also be slow there (one program a row and head tile: 1-2 programs for a 1-row step).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from .latent import CHUNK, KT, SCALE_AT, _lrows, _ltile, _paging, _views
+
+BM = 32           # (row, head) queries a program: all 32 local heads of a row (one gather of its latent rows)
+STAGES = 1        # software pipelining of the key loop (no effect on bits); 2 needs ~64 KB more shared memory
+WARPS = 8
+
+
+@triton.jit
+def _opaque(x):
+    """patches/0360: the identity, as an impure inline-asm op (one ``mov.b32`` per two bf16 values). Triton's choice of
+    a dot operand's register layout looks back through pure element-wise ops to the narrowest type loaded (e4m3 ->
+    ``kWidth`` 4); it stops here, so a dequantized FP8 tile feeds the dots exactly like a bf16 tile."""
+
+    return tl.inline_asm_elementwise("mov.b32 $0, $1;", "=r,r", [x], dtype=tl.bfloat16, is_pure=False, pack=2)
+
+
+@triton.jit
+def _lsparse_one(QA, LC, LCS, TOK, CNT, OUT, W: tl.constexpr, H: tl.constexpr, L: tl.constexpr, KTS: tl.constexpr,
+                 SCALE: tl.constexpr, BMQ: tl.constexpr, FP8: tl.constexpr = False, RB: tl.constexpr = 0,
+                 SB: tl.constexpr = 0, SA: tl.constexpr = 0, PT=None, PSH: tl.constexpr = 0, OPQ: tl.constexpr = False):
+    """Program (row r, head tile): the row's n selected tokens in list order, one online softmax, OUT = o / l.
+    ``OPQ`` (patches/0360, FP8 compiled kernels): the dequantized tile through ``_opaque`` (the interpreter has no
+    inline asm; there it is the same values anyway)."""
+
+    r = tl.program_id(0)
+    hb = tl.program_id(1)
+    n = tl.load(CNT + r)
+    if n > 0:
+        h = hb * BMQ + tl.arange(0, BMQ)
+        hok = h < H
+        d = tl.arange(0, L)
+        m = tl.full((BMQ,), float("-inf"), tl.float32)
+        l = tl.zeros((BMQ,), tl.float32)
+        o = tl.zeros((BMQ, L), tl.float32)
+        q = tl.load(QA + (r * H + h[:, None]) * L + d[None, :], mask=hok[:, None], other=0).to(tl.bfloat16)
+        for t in range(0, tl.cdiv(n, KTS)):
+            idx = t * KTS + tl.arange(0, KTS)
+            ok = idx < n
+            tok = tl.load(TOK + r * W + idx, mask=ok, other=0).to(tl.int64)
+            kv = _lrows(LC, LCS, tok, ok, d, FP8, RB, SB, SA, PT, PSH)          # patches/0290: paged rows too
+            if OPQ:
+                kv = _opaque(kv)                                                  # patches/0360
+            valid = ok[None, :] & hok[:, None]
+            m, l, o = _ltile(q, kv, m, l, o, valid, SCALE)
+        tl.store(OUT + (r * H + h[:, None]).to(tl.int64) * L + d[None, :], o / l[:, None], mask=hok[:, None])
+
+
+# patches/0410 (GLM53_TF_SPARSE_V2=1, load-time; default 0): ``sparse_latent_one`` runs ``sparse_v2._lsparse_v2``, a
+# Gluon kernel with THIS kernel's bits (the same tile order, the same mma chains, the reductions on the same #mma
+# layout) and pipelined cp.async gathers, no redundant QK work. Same bits, so the same snapshots (bit 4's tag) and no
+# rank check. ``V2`` is the sparse_v2 module when on (``enable_v2``; the engine calls it at load).
+V2 = None
+
+
+def enable_v2() -> bool:
+    """Read GLM53_TF_SPARSE_V2 (and its CFG) now, so a bad value or a Triton without Gluon fails at load."""
+
+    global V2
+    import importlib
+
+    sv = importlib.import_module(f"{__package__}.sparse_v2")
+    if not sv.mode():
+        V2 = None
+        return False
+    sv.config(True)
+    sv.config(False)
+    V2 = sv
+    return True
+
+
+def sparse_latent_one(qa: torch.Tensor, lc: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor,
+                      out: torch.Tensor, scale: float, *, bm: int | None = None, stages: int | None = None,
+                      v2: bool | None = None) -> None:
+    """``latent.sparse_latent``'s contract (rows with counts > 0 written into ``out`` [R, H, L] fp32, other rows
+    untouched), in one pass a row. patches/0410: ``v2`` None follows GLM53_TF_SPARSE_V2 (``V2``), True / False force
+    it (benches, tests); v2 serves the production shape (32 local heads, 512-wide latent, default tile) only."""
+
+    R, H, L = qa.shape
+    if R == 0:
+        return
+    use = (V2 is not None) if v2 is None else bool(v2)
+    if use and bm is None and stages is None and not _INTERPRETED:
+        from . import sparse_v2
+
+        if H == sparse_v2.HEADS and L == SCALE_AT:
+            sparse_v2.sparse_latent_v2(qa, lc, tokens, counts, out, scale)
+            return
+    W = tokens.shape[1]
+    if not qa.is_contiguous() or not tokens.is_contiguous() or out.shape != (R, H, L) or not out.is_contiguous():
+        raise ValueError("sparse_latent_one: contiguous qa [R, H, L], tokens [R, W] and out [R, H, L] expected")
+    bm = (BM if H >= BM else 16) if bm is None else int(bm)             # a function of H only: never of R
+    lcv, lcs, f8, rb, sb = _views(lc, L)
+    _lsparse_one[(R, triton.cdiv(H, bm))](qa, lcv, lcs, tokens, counts, out, W=W, H=H, L=L, KTS=KT, SCALE=scale,
+                                          BMQ=bm, FP8=f8, RB=rb, SB=sb, SA=SCALE_AT // 4, num_warps=WARPS,
+                                          num_stages=STAGES if stages is None else int(stages), **_paging(lc),
+                                          OPQ=bool(f8) and not _INTERPRETED)                     # patches/0360
+
+
+_INTERPRETED = type(_lsparse_one).__name__ == "InterpretedFunction"      # TRITON_INTERPRET=1 (no inline asm)
+
+
+def reference(qa: torch.Tensor, lat: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor, scale: float):
+    """float64 softmax attention of every (row, head) over its selected latent rows (tests): [R, H, L]."""
+
+    R, H, L = qa.shape
+    out = torch.zeros((R, H, L), dtype=torch.float64, device=qa.device)
+    for r in range(R):
+        n = int(counts[r])
+        if n == 0:
+            continue
+        kv = lat[tokens[r, :n].long()].double()
+        s = qa[r].double() @ kv.T * scale
+        out[r] = torch.softmax(s, dim=-1) @ kv
+    return out
+
+
+assert CHUNK % KT == 0
diff --git a/src/tensorfold/families/glm5_next/spark/b12x_kda.py b/src/tensorfold/families/glm5_next/spark/b12x_kda.py
new file mode 100644
index 0000000..048dcde
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/b12x_kda.py
@@ -0,0 +1,261 @@
+"""KDA prefill in 16-row tiles, one fused program per (head, block of value rows) (patches/0240, ``tf_knobs.b12x`` bit 2).
+
+Derived from the chunked lower-bounded KDA prefill of b12x (https://github.com/local-inference-lab/b12x,
+``b12x/sequence/kda_prefill`` and ``b12x/sequence/_shared/delta_prefill``, Apache License 2.0, Copyright Luke Alonso
+and the b12x contributors): its 16-token chunk, its per-tile operands (q~ = q e^G, k~ = k e^G, k_inv = k e^-G,
+k_r = k e^(G_C - G), lambda_C = e^G_C, the strictly lower L = beta k~ k_inv^T, the Neumann-product inverse (I + L)^-1
+and the causal q~ k_inv^T) and its recurrence with the fp32 state held on chip while a program walks its tiles.
+Re-implemented in Triton for this engine (no b12x code is used): the prologue (conv + SiLU, L2 norms, decay, beta) is
+this engine's (``fast_kda``), the tile preparation runs inside the recurrence program (no workspace, no second
+kernel, no window pipeline), the operands of the large products are fp32 at tf32 precision by default (b12x rounds
+them and a shadow of the state to bf16; ``PREC`` = "bf16" does that), and tiles sit at ABSOLUTE multiples of 16.
+
+Per tile of 16 rows at absolute positions T .. T + 15 (rows past the call's end are identity steps: k = q = v = 0,
+beta = 0, decay 1), per head, with G the in-tile cumulative log decay (per key channel; G_t <= 0, > 16 lower):
+
+    L    = strict_lower(beta_t k~_t . k_inv_s)                    [16, 16]   (fp32 FMA dots, "ieee")
+    Minv = (I - L)(I + L^2)(I + L^4)(I + L^8) = (I + L)^-1        (L is nilpotent of index <= 16)
+    Mqk  = lower_incl(q~_t . k_inv_s)                             [16, 16]
+    V'   = beta (V - k~ S^T)                                      [16, BV]   (S: [BV value rows, 128 keys], fp32)
+    U    = Minv V'                                                [16, BV]
+    O    = q~ S^T + Mqk U  -> bf16 (then the gated RMSNorm, ``fast_kda._kda_norm``)
+    S   <- S diag(lambda_C) + U^T k_r
+
+which is the delta rule S'_t = S_{t-1} diag(e^{gl_t}), e_t = beta_t (v_t - S'_t k_t), S_t = S'_t + e_t k_t^T,
+o_t = S_t q_t unrolled over the tile (``fast_kda``'s derivation with a 16-row chunk; U is its E).
+
+Magnitudes: k_inv carries e^{-G} <= e^{16 |lower|}, so the tile is safe in fp32 / tf32 / bf16 exponents for
+|lower| <= ``MAX_ABS_LOWER`` (GLM-5.3: 5.0, e^80 ~ 5.5e34 and every product of the dots stays below e^75); other
+models fall back to ``fast_kda``.
+
+Exactness rules (patches/0085): deterministic (fixed shapes, fixed reduction orders, no atomics); a row's bits depend
+only on its 16-row tile's rows and the fp32 state entering the tile (the triangular structure: a valid row t reads
+rows <= t of its tile, and padded rows contribute exact zeros), and every fast call starts at a multiple of 64, so
+the only partial tile is a prompt's last one, the same in every schedule; the state handed between calls is the
+fp32 value the program keeps. NOT bit-identical to ``fast_kda`` (64-row blocks, other factorization) nor to the
+serial chain: new arithmetic, so its fast snapshots carry their own tag (``b12xpf``).
+
+Cost model (per 1024 rows x 32 heads, estimated, not measured): no workspace (``fast_kda`` writes and re-reads ~94 MB
+of fp32 scratch a call, which is what bounds it at ~1.8 ms); the inputs (~48 KB a row) are read once from DRAM and
+re-read from L2 by the 128 / BV value blocks of a head; 64 sequential tile steps a program.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from .fast_kda import _conv_act, _kda_norm
+
+DK = DV = 128
+TILE = 16
+MAX_ABS_LOWER = 5.3                   # e^{16 |lower|} stays < 2^127 with the 128-term dot sums (see the docstring)
+PREC = os.environ.get("GLM53_TF_B12X_KDA_PREC", "tf32").strip().lower() or "tf32"   # "tf32" | "tf32x3" | "ieee" | "bf16"
+BV = int(os.environ.get("GLM53_TF_B12X_KDA_BV", "64") or 64)      # value rows of the state a program holds
+WARPS = int(os.environ.get("GLM53_TF_B12X_KDA_WARPS", "4") or 4)    # 255 registers: 2 programs an SM at 4 warps
+STAGES = int(os.environ.get("GLM53_TF_B12X_KDA_STAGES", "1") or 1)
+
+
+def settings() -> list[int]:
+    """What decides this kernel's bits, for the load-time check that both ranks agree (``b12xpf.load_settings``): the
+    precision, the value block and the warps (Triton's layouts, hence the order of the norms' and the scan's sums,
+    follow the shapes and the warp count)."""
+
+    return [("tf32", "tf32x3", "ieee", "bf16").index(PREC) if PREC in ("tf32", "tf32x3", "ieee", "bf16") else -1, BV,
+            WARPS]
+
+
+@triton.jit
+def _k16(P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, S_IN, S_OUT, OUT, lower, R, off, NT,
+         H: tl.constexpr, BV: tl.constexpr, PREC: tl.constexpr, B16: tl.constexpr):
+    """Program (head h, value block jb): the call's 16-row tiles in order, state rows j = jb BV .. + BV - 1 on chip."""
+
+    h = tl.program_id(0)
+    jb = tl.program_id(1)
+    C: tl.constexpr = 3 * H * 128
+    l = tl.arange(0, 16)
+    i = tl.arange(0, 128)
+    j = jb * BV + tl.arange(0, BV)
+    decay_rate = tl.exp(tl.load(A_LOG + h))
+    dtb = tl.load(DT_BIAS + h * 128 + i)
+    sptr = h.to(tl.int64) * (128 * 128) + j[:, None] * 128 + i[None, :]
+    s = tl.load(S_IN + sptr)                                             # [BV, 128] fp32: s[h, value j, key i]
+    strict = l[None, :] < l[:, None]                                     # [t, s]: s < t
+    incl = l[None, :] <= l[:, None]
+    eye = tl.where(l[:, None] == l[None, :], 1.0, 0.0)
+    last = l == 15
+    for t in range(NT):
+        row = t * 16 - off + l
+        valid = (row >= 0) & (row < R)
+        rowc = tl.where(valid, row, 0).to(tl.int64)
+        # -- the rows' inputs (``fast_kda._kda_prep``'s prologue: the chain kernel's arithmetic) -------------------
+        qa = _conv_act(P, p_stride, CS, CW, row, valid, h * 128 + i, C)
+        ka = _conv_act(P, p_stride, CS, CW, row, valid, H * 128 + h * 128 + i, C)
+        va = _conv_act(P, p_stride, CS, CW, row, valid, 2 * H * 128 + h * 128 + j, C)     # this block's values only
+        qinv = 1.0 / tl.sqrt(tl.sum(qa * qa, axis=1) + 1e-6)
+        kinv = 1.0 / tl.sqrt(tl.sum(ka * ka, axis=1) + 1e-6)
+        q = tl.where(valid[:, None], (qa * qinv[:, None]) * (1.0 / tl.sqrt(128.0)), 0.0)
+        k = tl.where(valid[:, None], ka * kinv[:, None], 0.0)
+        v = tl.where(valid[:, None], va, 0.0)
+        araw = tl.load(A + rowc[:, None] * a_stride + h * 128 + i[None, :], mask=valid[:, None], other=0.0)
+        z = decay_rate * (araw.to(tl.float32) + dtb[None, :])
+        gl = tl.where(valid[:, None], lower * (1.0 / (1.0 + tl.exp(-z))), 0.0)
+        braw = tl.load(P + rowc * p_stride + b_off + h, mask=valid, other=0.0).to(tl.float32)
+        beta = tl.where(valid, (1.0 / (1.0 + tl.exp(-braw))).to(tl.bfloat16).to(tl.float32), 0.0)
+        # -- the tile's operands (b12x's preparation) ----------------------------------------------------------------
+        g = tl.cumsum(gl, axis=0)                                        # [16, 128], G_t (<= 0)
+        gc = tl.sum(tl.where(last[:, None], g, 0.0), axis=0)             # G_C (the tile's last row; padding adds 0)
+        kt = k * tl.exp(g)                                               # k~
+        kv = k * tl.exp(-g)                                              # k_inv
+        qt = q * tl.exp(g)                                               # q~ (the 128^-0.5 is in q)
+        kr = k * tl.exp(gc[None, :] - g)                                 # k_r
+        lam = tl.exp(gc)                                                 # lambda_C
+        lm = tl.dot(kt, tl.trans(kv), input_precision="ieee")
+        lm = tl.where(strict, lm * beta[:, None], 0.0)
+        mqk = tl.dot(qt, tl.trans(kv), input_precision="ieee")
+        mqk = tl.where(incl, mqk, 0.0)
+        minv = eye - lm
+        pw = tl.dot(lm, lm, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        pw = tl.dot(pw, pw, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        pw = tl.dot(pw, pw, input_precision="ieee")
+        minv = minv + tl.dot(minv, pw, input_precision="ieee")
+        # -- the recurrence ------------------------------------------------------------------------------------------
+        if B16:                                                          # b12x's policy: bf16 operands, fp32 master
+            sb = s.to(tl.bfloat16)
+            ks = tl.dot(kt.to(tl.bfloat16), tl.trans(sb))
+            vp = (v - ks) * beta[:, None]
+            u = tl.dot(minv.to(tl.bfloat16), vp.to(tl.bfloat16))
+            ub = u.to(tl.bfloat16)
+            o = tl.dot(qt.to(tl.bfloat16), tl.trans(sb)) + tl.dot(mqk.to(tl.bfloat16), ub)
+            upd = tl.dot(tl.trans(ub), kr.to(tl.bfloat16))
+        else:
+            ks = tl.dot(kt, tl.trans(s), input_precision=PREC)
+            vp = (v - ks) * beta[:, None]
+            u = tl.dot(minv, vp, input_precision="ieee")
+            o = tl.dot(qt, tl.trans(s), input_precision=PREC) + tl.dot(mqk, u, input_precision="ieee")
+            upd = tl.dot(tl.trans(u), kr, input_precision=PREC)
+        tl.store(OUT + rowc[:, None] * (H * 128) + h * 128 + j[None, :], o.to(tl.bfloat16), mask=valid[:, None])
+        s = s * lam[None, :] + upd
+    tl.store(S_OUT + sptr, s)
+
+
+def supported(lower: float, heads: int | None = None) -> bool:
+    """The 16-row tile is safe in fp32 for this lower bound (GLM-5.3: -5.0) and the value blocks divide 128."""
+
+    return math.isfinite(lower) and abs(lower) <= MAX_ABS_LOWER and DV % BV == 0 and BV >= 16
+
+
+def kda_prefill16(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_state: torch.Tensor,
+                  conv_w: torch.Tensor, state_in: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor,
+                  norm_w: torch.Tensor, eps: float, lower: float, rows: int, scratch=None,
+                  state_out: torch.Tensor | None = None, *, pos: int, out: torch.Tensor | None = None,
+                  bv: int | None = None, prec: str | None = None, num_warps: int | None = None,
+                  num_stages: int | None = None) -> torch.Tensor:
+    """``kda.chain``'s contract (``fast_kda.kda_prefill_chunked``'s arguments), 16-row tiles at absolute multiples of 16
+    of ``pos``. Writes the gated-RMSNorm rows (``scratch.out[:rows]``, ``out`` or a new [rows, H*128] bf16 tensor) and
+    the fp32 state after the last row into ``state_out`` (required; may be ``state_in``). The conv state is not
+    advanced (``forward.commit`` does it, as for ``kda.chain``); no replay inputs are written (a fast prefill keeps
+    every row). ``bv`` / ``prec`` / warps / stages: tests and the micro-benchmark (the defaults decide the bits)."""
+
+    H = int(a_log.numel())
+    bv = BV if bv is None else int(bv)
+    prec = PREC if prec is None else prec
+    if state_out is None:
+        raise ValueError("kda_prefill16: state_out is required")
+    if not (math.isfinite(lower) and abs(lower) <= MAX_ABS_LOWER):
+        raise ValueError(f"kda_prefill16: |lower| = {abs(lower)} > {MAX_ABS_LOWER} (use fast_kda)")
+    if bv not in (16, 32, 64, 128):
+        raise ValueError("kda_prefill16: bv must be 16, 32, 64 or 128")
+    if prec not in ("tf32", "tf32x3", "ieee", "bf16"):
+        raise ValueError(f"kda_prefill16: precision {prec!r}")
+    if rows < 1 or p.shape[0] < rows or a.shape[0] < rows or g.shape[0] < rows:
+        raise ValueError("kda_prefill16: rows")
+    if p.stride(1) != 1 or a.stride(1) != 1 or g.stride(1) != 1:
+        raise ValueError("kda_prefill16: unit column strides expected")
+    if p.dtype != torch.bfloat16 or a.dtype != torch.bfloat16 or g.dtype != torch.bfloat16:
+        raise ValueError("kda_prefill16: bf16 projection/gate rows expected")
+    if not (conv_state.is_contiguous() and conv_w.is_contiguous() and state_in.is_contiguous()
+            and state_out.is_contiguous()):
+        raise ValueError("kda_prefill16: conv state, conv weight and states must be contiguous")
+    if state_in.numel() != H * DK * DV or state_out.numel() != H * DK * DV or state_in.dtype != torch.float32:
+        raise ValueError("kda_prefill16: states must be fp32 [H, 128, 128]")
+    if conv_w.shape[0] != 3 * H * DK or conv_w.shape[1] != 4:
+        raise ValueError("kda_prefill16: conv weight [3*H*128, 4] expected")
+    if scratch is not None:
+        o = scratch.out[:rows]
+    elif out is not None:
+        o = out[:rows]
+    else:
+        o = torch.empty((rows, H * DV), dtype=torch.bfloat16, device=p.device)
+    if o.shape != (rows, H * DV) or not o.is_contiguous():
+        raise ValueError("kda_prefill16: out must be a contiguous [rows, H*128] bf16")
+    off = int(pos) % TILE
+    nt = -(-(off + rows) // TILE)
+    b16 = prec == "bf16"
+    _k16[(H, DV // bv)](p, p.stride(0), int(b_off), a, a.stride(0), conv_state, conv_w, a_log, dt_bias, state_in,
+                        state_out, o, float(lower), int(rows), off, nt, H=H, BV=bv,
+                        PREC="tf32" if b16 else prec, B16=b16,
+                        num_warps=WARPS if num_warps is None else num_warps,
+                        num_stages=STAGES if num_stages is None else num_stages)
+    _kda_norm[(triton.cdiv(rows, 32), H)](o, g, g.stride(0), norm_w, float(eps), int(rows), H=H, BR=32, num_warps=4)
+    return o
+
+
+# -- reference (tests): the tile algorithm in torch fp64 / fp32 -----------------------------------------------------
+def tile_reference(p, b_off, a, g, conv_state, conv_w, state_in, a_log, dt_bias, norm_w, eps, lower, rows, pos,
+                   dtype=torch.float64):
+    """The same 16-row tile algorithm in torch (``dtype`` math, the kernel's bf16 roundings of conv activations, beta
+    and the raw outputs kept): returns (out [rows, H*128] bf16, state [H, 128, 128] fp32). A host-side model of
+    ``_k16`` for the tests (the float64 variant bounds the kernel's rounding)."""
+
+    H = int(a_log.numel())
+    C = 3 * H * DK
+    f = dtype
+    dev = p.device
+    x = torch.cat([conv_state.to(torch.float32), p[:rows, :C].to(torch.float32)], 0)
+    w = conv_w.to(torch.float32)
+    acc = sum(w[:, tap] * x[tap:tap + rows] for tap in range(4))
+    act = (acc / (1.0 + torch.exp(-acc))).to(torch.bfloat16).to(f)
+    qa = act[:, :H * DK].view(rows, H, DK)
+    ka = act[:, H * DK:2 * H * DK].view(rows, H, DK)
+    va = act[:, 2 * H * DK:].view(rows, H, DV)
+    q = qa / torch.sqrt((qa * qa).sum(-1, keepdim=True) + 1e-6) * (1.0 / math.sqrt(DK))
+    k = ka / torch.sqrt((ka * ka).sum(-1, keepdim=True) + 1e-6)
+    rate = torch.exp(a_log.to(f))[None, :, None]
+    z = rate * (a[:rows, :H * DK].to(f).view(rows, H, DK) + dt_bias.to(f).view(1, H, DK))
+    gl = lower * torch.sigmoid(z)
+    beta = torch.sigmoid(p[:rows, b_off:b_off + H].to(torch.float32)).to(torch.bfloat16).to(f)
+    s = state_in.to(f).clone().view(H, DV, DK)
+    raw = torch.empty((rows, H, DV), dtype=torch.bfloat16, device=dev)
+    off = pos % TILE
+    starts = [0] + list(range(TILE - off if off else TILE, rows, TILE))
+    for t0 in starts:
+        t1 = min(rows, t0 + (TILE - off if t0 == 0 and off else TILE))
+        n = t1 - t0
+        G = torch.cumsum(gl[t0:t1], 0)                                   # [n, H, K]
+        GC = G[-1]
+        kt = k[t0:t1] * torch.exp(G)
+        kv = k[t0:t1] * torch.exp(-G)
+        qt = q[t0:t1] * torch.exp(G)
+        kr = k[t0:t1] * torch.exp(GC[None] - G)
+        bt = beta[t0:t1]                                                 # [n, H]
+        for h in range(H):
+            L = torch.tril((kt[:, h] @ kv[:, h].T) * bt[:, h, None], -1)
+            Minv = torch.linalg.inv(torch.eye(n, dtype=f, device=dev) + L)
+            Mqk = torch.tril(qt[:, h] @ kv[:, h].T)
+            Vp = (va[t0:t1, h] - kt[:, h] @ s[h].T) * bt[:, h, None]
+            U = Minv @ Vp
+            O = qt[:, h] @ s[h].T + Mqk @ U
+            raw[t0:t1, h] = O.to(torch.bfloat16)
+            s[h] = s[h] * torch.exp(GC[h])[None, :] + U.T @ kr[:, h]
+    o = raw.to(torch.float32)
+    rinv = 1.0 / torch.sqrt((o * o).mean(-1, keepdim=True) + eps)
+    gate = g[:rows, :H * DV].to(torch.float32).view(rows, H, DV)
+    out = ((norm_w.to(torch.float32) * (o * rinv)) * torch.sigmoid(gate)).reshape(rows, -1).to(torch.bfloat16)
+    return out, s.to(torch.float32)
