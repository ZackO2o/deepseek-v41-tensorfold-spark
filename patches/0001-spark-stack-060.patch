+class State:
+    """Committed caches of one sequence (and of the MTP head's attention layer)."""
+
+    def __init__(self, w: Weights, capacity: int, rows: int) -> None:
+        c = w.cfg
+        dev = w.device
+        HL = c.heads // w.world
+        LL = c.lin_heads // w.world
+        self.capacity = capacity
+        self.pos = 0
+        self.pos_dev = torch.zeros((1,), dtype=torch.int32, device=dev)
+        self.mtp_pos_dev = torch.zeros((1,), dtype=torch.int32, device=dev)
+        kda_layers = [l for l in w.layers if l.kind == "kda"]
+        dsa_layers = [l for l in w.layers if l.kind == "dsa"]
+        self.kda_index = {l.index: i for i, l in enumerate(kda_layers)}
+        self.dsa_index = {l.index: i for i, l in enumerate(dsa_layers)}
+        n = len(kda_layers)
+        width = kda_layers[0].kda.proj.n if kda_layers else 0
+        self.conv = torch.zeros((n, c.conv - 1, 3 * LL * 128), dtype=torch.bfloat16, device=dev)
+        self.rec = torch.zeros((2, n, LL, 128, 128), dtype=torch.float32, device=dev)
+        self.cur = [0] * n
+        self.proj = torch.zeros((n, rows, width), dtype=torch.bfloat16, device=dev)
+        self.scratch_set = kda_mod.KDAScratchSet(n, rows, LL, dev) if n else None
+        self.scratch = self.scratch_set.views if n else []
+        # patches/0290 (GLM53_TF_KV_POOL_TOKENS): the capacity-sized caches as views of the engine's shared page pool
+        self.pages = None
+        pool = w.meta.get("kv_pool")
+        if pool is not None:
+            self._paged(w, pool, capacity, rows, dsa_layers)
+            return
+        if latent.on(w):
+            # GLM53_TF_LATENT_KV=1 (patches/0060): one kv_lora-wide latent row a token, keys = values (the same tensor)
+            self.kc = latent.caches(w, capacity, len(dsa_layers))
+            self.vc = self.kc
+        else:
+            self.kc = [torch.zeros((capacity, HL, c.qk_dim), dtype=torch.bfloat16, device=dev) for _ in dsa_layers]
+            self.vc = [torch.zeros((capacity, HL, c.v_dim), dtype=torch.bfloat16, device=dev) for _ in dsa_layers]
+        self.mtp_len = 0
+        self.mtp_drafted = 0
+        if w.mtp is not None and latent.on(w):
+            self.mtp_kc = self.mtp_vc = latent.caches(w, capacity, 1)[0]
+        elif w.mtp is not None:
+            self.mtp_kc = torch.zeros((capacity, HL, c.qk_dim), dtype=torch.bfloat16, device=dev)
+            self.mtp_vc = torch.zeros((capacity, HL, c.v_dim), dtype=torch.bfloat16, device=dev)
+        # DSA indexer caches (long contexts only): per layer (and the MTP layer, last) keys, gates, pool keys
+        self.index = None
+        self.index_ring = 0
+        if w.meta.get("long_context"):
+            n_idx = len(dsa_layers) + (1 if w.mtp is not None else 0)
+            mk = lambda n: torch.zeros((n, c.index_dim), dtype=torch.bfloat16, device=dev)   # noqa: E731
+            self.index = [(mk(capacity), mk(capacity), mk(capacity // 4 + 2)) for _ in range(n_idx)]
+            self._index_ring(w, capacity, rows, len(dsa_layers))
+
+    def _paged(self, w: Weights, pool, capacity: int, rows: int, dsa_layers) -> None:
+        """patches/0290: this slot's latent caches, MTP latent cache and capacity-sized indexer caches on the pool's
+        pages (``kvpool.Paged``; nothing capacity-sized is allocated here), its own page table, rows mapped as
+        positions are written (``check_room``). The index rings (patches/0065) are decided first, so a ring layer's
+        full keys / gates are never allocated."""
+
+        if not latent.on(w):
+            raise ValueError("GLM53_TF_KV_POOL_TOKENS pages the latent KV cache: it needs GLM53_TF_LATENT_KV=1")
+        c = w.cfg
+        dev = w.device
+        self.pages = sp = pool.new_slot(capacity)
+        self.kc = pool.latent(sp, len(dsa_layers))
+        self.vc = self.kc
+        self.mtp_len = 0
+        self.mtp_drafted = 0
+        if w.mtp is not None:
+            self.mtp_kc = self.mtp_vc = pool.mtp_latent(sp)
+        self.index = None
+        self.index_ring = 0
+        if not w.meta.get("long_context"):
+            return
+        n = len(dsa_layers)
+        n_idx = n + (1 if w.mtp is not None else 0)
+        ring = sparse.INDEX_RING and n > 0 and sparse.index_ring_rows(rows) < capacity
+        empty = lambda: torch.zeros((0, c.index_dim), dtype=torch.bfloat16, device=dev)   # noqa: E731
+        self.index = []
+        for i in range(n_idx):
+            if ring and i < n:                   # replaced by the ring's views in ``_index_ring``
+                ik, ig = empty(), empty()
+            else:
+                ik, ig = pool.index_rows(sp, i, "k"), pool.index_rows(sp, i, "g")
+            self.index.append((ik, ig, pool.pool_keys(sp, i)))
+        if ring:
+            self._index_ring(w, capacity, rows, n)
+
+    def _index_ring(self, w: Weights, capacity: int, rows: int, n: int) -> None:
+        """patches/0065 (GLM53_TF_INDEX_RING, default 1): the model layers' index keys and gates in a ring of
+        ``sparse.index_ring_rows(rows)`` rows instead of ``capacity`` (1 KB a token for 11 layers: 1 GB per 1M
+        tokens -> ~2 MB). A row of them is read only when the window that completes its pool runs, so a ring
+        holding a window and the 3 rows before it serves every step with the same bits; the pool keys (every
+        complete pool, what scoring reads) stay full. The MTP layer's caches stay full (its positions follow the
+        head's own length). A snapshot must still bring back the last 3 committed rows (the incomplete pool) when
+        it rewinds past rows the ring overwrote: ``commit`` keeps them in a trailing slot of ``conv``, which every
+        snapshot already copies and restores, and ``set_pos`` writes them back on a rewind."""
+
+        ring = sparse.index_ring_rows(rows)
+        if not sparse.INDEX_RING or ring >= capacity or n == 0:
+            return
+        c = w.cfg
+        self.index_ring = ring
+        self.iring = torch.zeros((2, n, ring, c.index_dim), dtype=torch.bfloat16, device=w.device)
+        self.index[:n] = [(self.iring[0, i], self.iring[1, i], self.index[i][2]) for i in range(n)]
+        # the tail slot: rows pos - 3 .. pos - 1 of every ring, [2, n, 3, index_dim], after the KDA conv windows
+        tail = 2 * n * (sparse.POOL - 1) * c.index_dim
+        per = self.conv[0].numel() if self.conv.shape[0] else 0
+        if per == 0:
+            raise ValueError("index ring: no conv windows to keep the committed tail in")
+        extra = -(-tail // per)
+        conv = torch.zeros((self.conv.shape[0] + extra, *self.conv.shape[1:]), dtype=self.conv.dtype,
+                           device=self.conv.device)
+        self.conv_layers = self.conv.shape[0]
+        self.conv = conv
+        self._tail_n = n
+
+    def _tail(self) -> torch.Tensor:
+        n = self._tail_n
+        return self.conv[self.conv_layers:].view(-1)[:2 * n * (sparse.POOL - 1) * self.iring.shape[3]].view(
+            2, n, sparse.POOL - 1, self.iring.shape[3])
+
+    def _ring_rows(self, pos: int) -> list[tuple[int, int]]:
+        """(tail row, ring slot) of positions pos - 3 .. pos - 1 that exist."""
+
+        return [(j, (pos - (sparse.POOL - 1) + j) % self.index_ring) for j in range(sparse.POOL - 1)
+                if pos - (sparse.POOL - 1) + j >= 0]
+
+    def save_index_tail(self) -> None:
+        """patches/0065: the committed tail (rows pos - 3 .. pos - 1 of every ring) into conv's trailing slot."""
+
+        rows = self._ring_rows(self.pos)
+        if not rows:
+            return
+        t = self._tail()
+        j0, s0 = rows[0]
+        if s0 + len(rows) <= self.index_ring and [s for _, s in rows] == list(range(s0, s0 + len(rows))):
+            t[:, :, j0:j0 + len(rows)].copy_(self.iring[:, :, s0:s0 + len(rows)])
+        else:
+            for j, slot in rows:
+                t[:, :, j].copy_(self.iring[:, :, slot])
+
+    def _load_index_tail(self, pos: int) -> None:
+        t = self._tail()
+        for j, slot in self._ring_rows(pos):
+            self.iring[:, :, slot].copy_(t[:, :, j])
+
+    def reset(self) -> None:
+        self.conv.zero_()
+        self.rec.zero_()
+        self.cur = [0] * len(self.cur)
+        self.set_pos(0)
+        self.set_mtp_len(0)
+        self.mtp_drafted = 0
+
+    def set_pos(self, pos: int, *, committed: bool = False) -> None:
+        """``committed``: ``commit`` advancing over the rows it keeps; any other move (a reset, a snapshot restore,
+        which copied that position's ``conv`` first) takes the index rings' tail from ``conv`` (patches/0065)."""
+
+        if self.index_ring and not committed:
+            self._load_index_tail(pos)
+        self.pos = pos
+        self.pos_dev.fill_(pos)
+
+    def set_mtp_len(self, n: int) -> None:
+        self.mtp_len = n
+        self.mtp_pos_dev.fill_(n)
+
+    @property
+    def parity(self) -> int:
+        return self.cur[0] if self.cur else 0
+
+    def clone(self) -> "State":
+        import copy
+
+        if self.pages is not None:
+            raise TypeError("a State on the KV pool cannot be cloned (patches/0290: its rows are the pool's pages)")
+        other = copy.copy(self)
+        other.conv = self.conv.clone()
+        other.rec = self.rec.clone()
+        other.cur = list(self.cur)
+        other.pos_dev = self.pos_dev.clone()
+        other.mtp_pos_dev = self.mtp_pos_dev.clone()
+        other.kc = [x.clone() for x in self.kc]
+        other.vc = other.kc if self.vc is self.kc else [x.clone() for x in self.vc]       # latent: keys = values
+        if self.index is not None:
+            other.index = [tuple(x.clone() for x in trio) for trio in self.index]
+        if self.index_ring:                   # patches/0065: the clone's rings are views of its own ring tensor
+            other.iring = self.iring.clone()
+            other.index[:self._tail_n] = [(other.iring[0, i], other.iring[1, i], other.index[i][2])
+                                          for i in range(self._tail_n)]
+        if hasattr(self, "mtp_kc"):
+            other.mtp_kc = self.mtp_kc.clone()
+            other.mtp_vc = other.mtp_kc if self.mtp_vc is self.mtp_kc else self.mtp_vc.clone()
+        return other
+
+
+# -- blocks ---------------------------------------------------------------------------------------------------
+def gather(w: Weights, b: Buffers, R: int) -> torch.Tensor:
+    """Every rank's fp32 partial b.part[:R] in rank order: [world, R, D] (summed rank 0 first by the consumer)."""
+
+    if b.defer is not None:              # patches/0084: queued on the pipelined chunk's comm stream, returns a handle
+        return b.defer.issue(w, b, R)
+    d = b.part.shape[1]
+    site, b.site = b.site, None
+    if w.comm is None:
+        return b.part[:R].view(1, R, d)
+    pf = w.meta.get("prefetch")
+    if pf is not None and site is not None:
+        pf.launch(site, R)               # the next kernels' weights into L2 while the exchange waits on the link
+    out = b.gath[:b.world * R * d]
+    if b.fast and w.meta.get("fast_gather16"):
+        # patches/0080: a fast chunk gathers its partials as bf16 (half the bytes); both ranks then add the same
+        # rounded partials, rank 0 first, as fp32 (``glue.hc_post``)
+        if b.part16 is None:
+            b.part16 = torch.empty(b.part.shape, dtype=torch.bfloat16, device=b.part.device)
+            b.gath16 = torch.empty(b.gath.shape, dtype=torch.bfloat16, device=b.gath.device)
+        p16, g16 = b.part16[:R], b.gath16[:b.world * R * d]
+        p16.copy_(b.part[:R])
+        fast_gather(w.comm, p16.reshape(-1), g16)      # patches/0230: RoCE when GLM53_TF_COMM_BACKEND=roce
+        out.copy_(g16)
+    else:
+        fast_gather(w.comm, b.part[:R].reshape(-1), out)
+    if profile.ON:
+        profile.lap("allgather")
+    return out.view(b.world, R, d)
+
+
+def out_proj(w: Weights, b: Buffers, x: torch.Tensor, q: qmm.Q4, xs: torch.Tensor, R: int,
+             name: str = "o_proj") -> torch.Tensor:
+    # patches/0084: a pipelined lean chunk writes the partial straight into its exchange slot (bf16 for bf16 gathers:
+    # the fp32 sums rounded once to nearest even in the matmul's store, the bits of ``gather``'s copy)
+    dst = b.part[:R] if b.defer is None else b.defer.slot(R)
+    qmm.matmul(x, q, xs, out=dst, f32=dst.dtype == torch.float32, part=b.sk)
+    if profile.ON:
+        profile.lap(name)
+    return gather(w, b, R)
+
+
+def kda_block(layer: LayerW, w: Weights, st: State, b: Buffers, R: int) -> torch.Tensor:
+    c = w.cfg
+    k = layer.kda
+    li = st.kda_index[layer.index]
+    p = st.proj[li, :R]
+    qmm.matmul(b.normed[:R], fastpf.kda_proj(k), b.xs[:R], out=p, part=b.sk)     # patches/0170
+    fa = p[:, k.fa_off:k.fa_off + 128]
+    ga = p[:, k.ga_off:k.ga_off + 128]
+    if b.fast or not dv2.kda_gates(p, k, b, R):          # patches/0130: v2 sums and matmuls both gates at once
+        qmm.matmul(fa, k.fb, qmm.group_sums(fa, b.xs_fa[:R]), out=b.ka[:R], part=b.sk)
+        qmm.matmul(ga, k.gb, qmm.group_sums(ga, b.xs_ga[:R]), out=b.kg[:R], part=b.sk)
+    if profile.ON:
+        profile.lap("kda.proj")
+    l2pf.mark(w, layer, "o", R)         # patches/0460: o_proj into L2 during the chain (off: a lookup)
+    cur = st.cur[li]
+    chain = kda_mod.chain
+    if b.fast:                           # patches/0080: a fast prefill chunk from absolute position st.pos
+        chain = lambda *args: fastpf.kda_chain(*args, pos=st.pos)       # noqa: E731
+    out = chain(p, k.b_off, b.ka[:R], b.kg[:R], st.conv[li], k.conv, st.rec[cur, li], k.a_log, k.dt_bias, k.norm,
+                c.eps, c.lower, R, st.scratch[li], st.rec[1 - cur, li])
+    if profile.ON:
+        profile.lap("kda.chain")
+    return out_proj(w, b, out, k.o, qmm.group_sums(out, b.kxs[:R]), R, "kda.o_proj")
+
+
+def dsa_block(layer: LayerW, w: Weights, kc: torch.Tensor, vc: torch.Tensor, pos_dev: torch.Tensor, b: Buffers,
+              R: int, nch: int | None, index=None, host_pos: int | None = None,
+              npb: int | None = None) -> torch.Tensor:
+    """``pos_dev``: the committed length on the device; ``nch``: attention chunks to visit (None: the capacity's).
+    ``index``: this layer's indexer caches (long contexts): the window's index keys and pools are always written;
+    rows past 2050 then attend to their top-512 pools (``host_pos`` given, eager only). ``npb`` (patches/0050):
+    every row is past 2050 and has at most ``npb`` complete pools; the selection runs on the device over ``npb``
+    pools into ``b.lc`` (capturable, no host position)."""
+
+    if latent.on(w):                     # GLM53_TF_LATENT_KV=1 (patches/0060): kc is the latent cache (vc the same)
+        return latent.dsa_block_latent(layer, w, kc, pos_dev, b, R, nch, index, host_pos, npb)
+    c = w.cfg
+    a = layer.dsa
+    qmm.matmul(b.normed[:R], a.proj, b.xs[:R], out=b.dp[:R], part=b.sk)
+    glue.rmsnorm(b.dp[:R, :c.q_lora], a.q_norm, c.eps, b.qr[:R], b.xs_qr[:R])
+    glue.rmsnorm(b.dp[:R, c.q_lora:], a.kv_norm, c.eps, b.lat[:R], b.xs_lat[:R])
+    HL = a.heads
+    qmm.matmul(b.qr[:R], a.q_b, b.xs_qr[:R], out=b.q[:R].view(R, HL * c.qk_dim), part=b.sk)
+    kn, vn = b.kn[:R].view(R, HL * c.qk_dim), b.vn[:R].view(R, HL * c.v_dim)
+    if b.fast or not dv2.kv_pair(b.lat[:R], b.xs_lat[:R], a.kv_k, a.kv_v, kn, vn, b.sk):     # patches/0130
+        qmm.matmul(b.lat[:R], a.kv_k, b.xs_lat[:R], out=kn, part=b.sk)
+        qmm.matmul(b.lat[:R], a.kv_v, b.xs_lat[:R], out=vn, part=b.sk)
+    kv_write(b.kn[:R], b.vn[:R], kc, vc, pos_dev)
+    if profile.ON:
+        profile.lap("dsa.proj")
+    l2pf.mark(w, layer, "o", R)         # patches/0460: o_proj into L2 during the attention core
+    sparse_rows = index is not None and host_pos is not None and host_pos + R - 1 >= c.dense_limit
+    if npb is not None and index is None:
+        raise ValueError("dsa_block: a long-context step needs the indexer caches")
+    every_sparse = npb is not None or (sparse_rows and host_pos >= c.dense_limit)
+    sparse_rows = sparse_rows or npb is not None
+    if index is not None:
+        ik, ig, pk = index
+        ix = a.index
+        qmm.matmul(b.normed[:R], ix.kw, b.xs[:R], out=b.ikr[:R], part=b.sk)
+        glue.router(b.normed[:R], ix.gate, b.igr[:R])
+        sparse.index_update(b.ikr[:R, :c.index_dim], b.igr[:R], ix.ln_w, ix.ln_b, ix.ape, ik, ig, pk, pos_dev)
+        if profile.ON:
+            profile.lap("dsa.indexer")
+    if every_sparse:
+        o = b.attn.out[:R]                     # every row sparse: the dense pass is skipped
+    else:
+        o = attention(b.q[:R], kc, vc, pos_dev, b.attn, scale=c.qk_dim ** -0.5, nch=nch)
+        if profile.ON:
+            profile.lap("dsa.attn")
+    if sparse_rows:
+        qmm.matmul(b.qr[:R], ix.qb, b.xs_qr[:R], out=b.qi[:R], part=b.sk)
+        if npb is not None:
+            tokens, counts = sparse.select_tokens_dev(b.qi[:R], b.ikr[:R, c.index_dim:], pk, pos_dev, R, npb, b.lc)
+        else:
+            # patches/0050 (GLM53_TF_LONGCTX_GRAPHS=1): score only the pools that exist (same selection)
+            np_max = pk.shape[0] - 2
+            if w.meta.get("longctx_bound"):
+                np_max = sparse.pool_bucket(host_pos + R, np_max)
+            tokens, counts = sparse.select_tokens(b.qi[:R], b.ikr[:R, c.index_dim:], pk, host_pos, R, np_max,
+                                                  pos_dev)
+        if profile.ON:
+            profile.lap("dsa.indexer")
+        # patches/0090: a request with longctx_graphs=0 runs upstream's eager path (partials allocated per call)
+        lc = b.lc if npb is not None or w.meta.get("longctx_bound") else None
+        sparse.sparse_attention(b.q[:R], kc, vc, tokens, counts, o, c.qk_dim ** -0.5, lc)
+        if profile.ON:
+            profile.lap("dsa.sparse_attn")
+    o = o.view(R, HL * c.v_dim)
+    return out_proj(w, b, o, a.o, qmm.group_sums(o, b.xs_ao[:R]), R, "dsa.o_proj")
+
+
+def mlp_block(layer: LayerW, w: Weights, b: Buffers, R: int) -> torch.Tensor:
+    m = layer.mlp
+    qmm.matmul(b.normed[:R], m.gu, b.xs[:R], out=b.gu[:R], part=b.sk)
+    glue.swiglu(b.gu[:R], b.act[:R], b.xs_act[:R], w.cfg.limit)
+    return out_proj(w, b, b.act[:R], m.down, b.xs_act[:R], R, "mlp.dense")
+
+
+def moe_block(layer: LayerW, w: Weights, b: Buffers, R: int) -> torch.Tensor:
+    c = w.cfg
+    m = layer.moe
+    grp = b.group(R)
+    src = b.route_src                    # patches/0280: padded rows route as their source rows (None: off)
+    if b.fast or src is not None or not dv2.route(b.normed[:R], m.router, m.bias, b.mlog[:R], b.pick[:R], b.wts[:R],
+                                                  grp, c.top_k, c.experts, c.routed_scale, c.norm_topk):   # patches/0130
+        glue.router(b.normed[:R], m.router, b.mlog[:R])
+        if src is not None:              # identity on real rows: their logits (and bits) are untouched
+            b.mlog[:R].copy_(b.mlog[:R].index_select(0, src[:R]))
+        glue.select(b.mlog[:R], m.bias, b.pick[:R], b.wts[:R], grp.ids, grp.count, grp.members, c.top_k, c.experts,
+                    c.routed_scale, c.norm_topk)
+    if profile.ON:
+        profile.lap("moe.router")
+    l2pf.experts(w, layer, grp, R)      # patches/0460: the picked experts' first tiles into L2 (device-indexed)
+    if m.shared is not None:
+        # EXL3: the routed slots through the trellis kernels, the shared expert (last slot) through BF16 matmuls
+        from . import exl3_mm
+
+        s = m.shared
+        # GLM53_TF_COMM=prefetch: the shared expert first (its gate/up was prefetched into L2 during the attention
+        # all-gather); it shares no buffer with the routed slots, so the order changes no bits
+        shared_first = w.meta.get("prefetch") is not None
+        # patches/0130 (v2 ``sharedout``): the shared down projection writes its slot of ey directly (no copy)
+        sy = None if b.fast else dv2.shared_out(b, s.down, R, c.top_k)
+        sy_out = b.sy[:R] if sy is None else sy
+        if shared_first:
+            qmm.matmul(b.normed[:R], s.gu, b.xs[:R], out=b.sgu[:R], part=b.sk)
+            glue.swiglu(b.sgu[:R], b.sact[:R], b.sxs[:R], c.limit)
+            qmm.matmul(b.sact[:R], s.down, b.sxs[:R], out=sy_out, f32=True, part=b.sk)
+            if profile.ON:
+                profile.lap("moe.shared")
+        exl3_mm.routed(b.normed[:R], b.pick, grp, m.experts, b.exl3, b.ey.view(-1, c.hidden), R, c.limit,
+                       fast=b.fast)          # patches/0080: the fused fast-prefill kernels in a fast chunk
+        if profile.ON:
+            profile.lap("moe.routed")
+        if not shared_first:
+            qmm.matmul(b.normed[:R], s.gu, b.xs[:R], out=b.sgu[:R], part=b.sk)
+            glue.swiglu(b.sgu[:R], b.sact[:R], b.sxs[:R], c.limit)
+            qmm.matmul(b.sact[:R], s.down, b.sxs[:R], out=sy_out, f32=True, part=b.sk)
+        if sy is None:
+            b.ey[:R, c.top_k].copy_(b.sy[:R])
+        if profile.ON and not shared_first:
+            profile.lap("moe.shared")
+        glue.combine(b.ey[:R], b.wts[:R], b.part[:R])
+        if profile.ON:
+            profile.lap("moe.combine")
+        return gather(w, b, R)
+    qmm.moe_gateup(b.normed[:R], b.xs[:R], m.experts, grp, b.eact, b.eaxs, c.limit)
+    qmm.moe_down(b.eact, b.eaxs, m.experts, grp, b.ey)
+    if profile.ON:
+        profile.lap("moe.routed")
+    glue.combine(b.ey[:R], b.wts[:R], b.part[:R])
+    if profile.ON:
+        profile.lap("moe.combine")
+    return gather(w, b, R)
+
+
+def layer_forward(layer: LayerW, w: Weights, st: State, b: Buffers, R: int, nch: int | None = None,
+                  host_pos: int | None = None, npb: int | None = None) -> None:
+    c = w.cfg
+    x = b.x[:R]
+    h = layer.attn_hc
+    glue.hc_pre(x, h.fn, h.base, h.scale, layer.in_norm, b.normed[:R], b.xs[:R], b.post[:R], b.comb[:R],
+                b.hcpart[:R], c.eps, c.hc_eps, c.hc_iters)
+    if profile.ON:
+        profile.lap("hc")
+    b.site = (layer.index, "a")
+    if layer.kind == "kda":
+        g = kda_block(layer, w, st, b, R)
+    else:
+        di = st.dsa_index[layer.index]
+        g = dsa_block(layer, w, st.kc[di], st.vc[di], st.pos_dev, b, R, nch,
+                      st.index[di] if st.index is not None else None, host_pos, npb)
+    glue.hc_post(x, x, g, b.post[:R], b.comb[:R])
+    h = layer.ffn_hc
+    glue.hc_pre(x, h.fn, h.base, h.scale, layer.post_norm, b.normed[:R], b.xs[:R], b.post[:R], b.comb[:R],
+                b.hcpart[:R], c.eps, c.hc_eps, c.hc_iters)
+    if profile.ON:
+        profile.lap("hc")
+    b.site = (layer.index, "f")
+    g = mlp_block(layer, w, b, R) if layer.mlp is not None else moe_block(layer, w, b, R)
+    glue.hc_post(x, x, g, b.post[:R], b.comb[:R])
+    if profile.ON:
+        profile.lap("hc")
+
+
+def check_room(w: Weights, st: State, R: int, pos: int | None = None) -> None:
+    pos = st.pos if pos is None else pos
+    if pos + R > w.cfg.dense_limit and st.index is None:
+        raise ValueError(f"context {pos + R} past {w.cfg.dense_limit} tokens: this engine was started without long "
+                         "contexts (DSA's sparse top-k)")
+    if pos + R > st.capacity:
+        raise ValueError("context past the cache capacity")
+    if getattr(st, "pages", None) is not None:      # patches/0290: map the pages the window writes (a no-op mostly)
+        st.pages.ensure(pos + R)
+
+
+def stage(w: Weights, st: State, b: Buffers, tokens: Sequence[int]) -> int:
+    """Host work before a forward: the token ids into the static device buffer (pinned copy)."""
+
+    R = len(tokens)
+    if R > b.rows:
+        raise ValueError(f"window of {R} rows, buffers hold {b.rows}")
+    check_room(w, st, R)
+    b.staged.synchronize()
+    b.ids_host[:R].numpy()[:] = list(tokens)
+    b.ids[:R].copy_(b.ids_host[:R], non_blocking=True)
+    b.staged.record()
+    return R
+
+
+def compute(w: Weights, st: State, b: Buffers, R: int, *, logits: bool = True, nch: int | None = None,
+            host_pos: int | None = None, npb: int | None = None, fast: bool = False, head: bool = True):
+    """The GPU work of a forward on staged rows (capturable: static buffers, device-side positions). ``host_pos``
+    (eager calls): the committed length, which long contexts need to switch rows to sparse attention. ``npb``
+    (patches/0050, capturable): every row is past 2050 with at most ``npb`` complete pools (``dsa_block``).
+
+    ``fast`` (patches/0080, eager prefill chunks of the main model only): the chunk runs the fast-prefill kernels
+    (``fastpf``); the final-normed rows are computed for every row (the MTP head reads them) but the head only for
+    the last row, and only with ``head`` (the returned logits' other rows are stale)."""
+
+    if not fast:
+        return _compute(w, st, b, R, logits=logits, nch=nch, host_pos=host_pos, npb=npb)
+    with fastpf.chunk(b, w.head):           # patches/0085: the head keeps qmm below 64 rows
+        return _compute(w, st, b, R, logits=logits, nch=nch, host_pos=host_pos, npb=npb, head_rows=1 if head else 0)
+
+
+def _compute(w: Weights, st: State, b: Buffers, R: int, *, logits: bool = True, nch: int | None = None,
+             host_pos: int | None = None, npb: int | None = None, head_rows: int | None = None):
+    """``compute``; ``head_rows`` (patches/0080): the head runs on the last ``head_rows`` rows only (None: all)."""
+
+    c = w.cfg
+    glue.embed(b.ids[:R], w.embed, c.hidden, c.streams, b.x[:R])
+    if profile.ON:
+        profile.lap("embed")
+    for layer in w.layers:
+        layer_forward(layer, w, st, b, R, nch, host_pos, npb)
+        for slot in b.tap_at.get(layer.index, ()):
+            glue.stream_mean(b.x[:R], b.taps[slot][:R])
+    glue.stream_mean(b.x[:R], b.hidden[:R])
+    if profile.ON:
+        profile.lap("hc")
+    if not logits:
+        _join(w)
+        return None
+    glue.rmsnorm(b.hidden[:R], w.norm, c.eps, b.fnormed[:R], b.fxs[:R])
+    if head_rows is None:
+        out = qmm.matmul(b.fnormed[:R], w.head, b.fxs[:R], out=b.logits[:R], part=b.sk)
+    else:                                # patches/0080: a fast chunk's head, on its last row(s) or none
+        out = b.logits[:R]
+        if head_rows:
+            qmm.matmul(b.fnormed[R - head_rows:R], w.head, b.fxs[R - head_rows:R], out=b.logits[R - head_rows:R],
+                       part=b.sk)
+    if profile.ON:
+        profile.lap("head")
+    _join(w)
+    return out
+
+
+def _join(w: Weights) -> None:
+    """GLM53_TF_COMM=prefetch: the current stream waits for the prefetch side stream (a forward, eager or
+    captured, ends with no open fork)."""
+
+    pf = w.meta.get("prefetch")
+    if pf is not None:
+        pf.join()
+
+
+def chunks_for(st: State, R: int) -> int:
+    from .attention import CHUNK
+
+    return -(-(st.pos + R) // CHUNK)
+
+
+@torch.no_grad()
+def forward(w: Weights, st: State, b: Buffers, tokens: Sequence[int], *, logits: bool = True) -> torch.Tensor | None:
+    """Rows for ``tokens`` at positions st.pos .. st.pos + R - 1: logits [R, V/world] bf16 (a view of b.logits)
+    and the hidden rows b.hidden[:R] (the mean of the streams before the final norm: the MTP head's input).
+    The committed state is unchanged until ``commit``."""
+
+    R = stage(w, st, b, tokens)
+    return compute(w, st, b, R, logits=logits, nch=chunks_for(st, R), host_pos=st.pos)
+
+
+@triton.jit
+def _row(CONV, PROJ, l, src, c, conv_layer, proj_layer, proj_row, C: tl.constexpr, TAPS: tl.constexpr):
+    old = tl.load(CONV + l * conv_layer + src * C + c, mask=(src < TAPS) & (c < C), other=0.0)
+    new = tl.load(PROJ + l * proj_layer + (src - TAPS) * proj_row + c, mask=(src >= TAPS) & (c < C), other=0.0)
+    return tl.where(src < TAPS, old, new)
+
+
+@triton.jit
+def _conv_shift(CONV, PROJ, keep, conv_layer, proj_layer, proj_row, C: tl.constexpr, TAPS: tl.constexpr,
+                BLOCK: tl.constexpr):
+    """Program (layer, channel block): the 3 window rows become rows keep .. keep + 2 of [old window; new rows]."""
+
+    l = tl.program_id(0).to(tl.int64)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    v0 = _row(CONV, PROJ, l, keep, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    v1 = _row(CONV, PROJ, l, keep + 1, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    v2 = _row(CONV, PROJ, l, keep + 2, c, conv_layer, proj_layer, proj_row, C, TAPS)
+    tl.store(CONV + l * conv_layer + c, v0, mask=c < C)
+    tl.store(CONV + l * conv_layer + C + c, v1, mask=c < C)
+    tl.store(CONV + l * conv_layer + 2 * C + c, v2, mask=c < C)
+
+
+@torch.no_grad()
+def commit(w: Weights, st: State, b: Buffers, R: int, keep: int) -> None:
+    """Keep the first ``keep`` rows of the last forward's R rows (every KDA layer at once)."""
+
+    if not 1 <= keep <= R:
+        raise ValueError("keep must be in 1..R")
+    n = len(st.cur)
+    if n:
+        cur = st.cur[0]
+        if keep < R:
+            kda_mod.replay_layers(st.rec[cur], st.scratch_set, keep, st.rec[1 - cur])
+        st.cur = [1 - cur] * n
+        C = st.conv.shape[2]
+        taps = st.conv.shape[1]
+        if taps != 3:
+            raise ValueError("the conv shift kernel is written for 4-tap convolutions")
+        _conv_shift[(n, triton.cdiv(C, 1024))](st.conv, st.proj, keep, st.conv.stride(0), st.proj.stride(0),
+                                               st.proj.stride(1), C=C, TAPS=taps, BLOCK=1024, num_warps=4)
+    st.set_pos(st.pos + keep, committed=True)
+    if st.index_ring:
+        st.save_index_tail()             # patches/0065: what a snapshot at this position needs of the rings
