+// patches/0590: bindings of exl3_fat2.cu (GLM53_TF_FAST_EXPERTS=fat2: the pipelined fast-prefill expert kernels).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void exl3_fat2_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, double, int64_t, bool, int64_t,
+                           int64_t);
+void exl3_fat2_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, bool,
+                         int64_t, int64_t);
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+// exl3_fast's ``gateup_fat`` contract with the shared input only (XG feeds gate and up); cfg 0-2 (the same bits);
+// ticket: dynamic item claiming; ctas: at most this many CTAs (0 = every SM); probe (timing only): 1 no decode, 2 no mma
+void gateup_fat2(const at::Tensor& XG, const at::Tensor& TG, const at::Tensor& TU, const at::Tensor& uids,
+                 const at::Tensor& ucount, const at::Tensor& members, const at::Tensor& svh_g, const at::Tensor& svh_u,
+                 const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t slots, double limit,
+                 int64_t cfg, bool ticket, int64_t ctas, int64_t probe) {
+    check(XG, at::kHalf, "XG");
+    check(TG, at::kInt, "TG");
+    check(TU, at::kInt, "TU");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(XG.size(-1) == K && xd.size(-1) == N, "gateup_fat2: X [P, K], Xd [P, N]");
+    TORCH_CHECK(TG.size(1) * 16 == K && TG.size(2) * 16 == N && TG.sizes() == TU.sizes(), "gateup_fat2: trellis shapes");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup_fat2: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XG.device());
+    exl3_fat2_gateup_cuda(XG, TG, TU, uids, ucount, members, svh_g, svh_u, suh_d, xd, K, N, slots, limit, cfg, ticket,
+                          ctas, probe);
+}
+
+void down_fat2(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+               const at::Tensor& members, const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t slots,
+               int64_t cfg, bool ticket, int64_t ctas, int64_t probe) {
+    check(XD, at::kHalf, "XD");
+    check(TD, at::kInt, "TD");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(XD.size(-1) == K && y.size(-1) == N, "down_fat2: Xd [P, K], Y [P, N]");
+    TORCH_CHECK(TD.size(1) * 16 == K && TD.size(2) * 16 == N, "down_fat2: trellis shape");
+    TORCH_CHECK(svh_d.size(-1) == N, "down_fat2: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XD.device());
+    exl3_fat2_down_cuda(XD, TD, uids, ucount, members, svh_d, y, K, N, slots, cfg, ticket, ctas, probe);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("gateup_fat2", &gateup_fat2, py::arg("XG"), py::arg("TG"), py::arg("TU"), py::arg("uids"),
+          py::arg("ucount"), py::arg("members"), py::arg("svh_g"), py::arg("svh_u"), py::arg("suh_d"), py::arg("xd"),
+          py::arg("K"), py::arg("N"), py::arg("slots"), py::arg("limit"), py::arg("cfg") = 0, py::arg("ticket") = true,
+          py::arg("ctas") = 0, py::arg("probe") = 0);
+    m.def("down_fat2", &down_fat2, py::arg("XD"), py::arg("TD"), py::arg("uids"), py::arg("ucount"),
+          py::arg("members"), py::arg("svh_d"), py::arg("y"), py::arg("K"), py::arg("N"), py::arg("slots"),
+          py::arg("cfg") = 0, py::arg("ticket") = true, py::arg("ctas") = 0, py::arg("probe") = 0);
+}
