@@ -0,0 +1,205 @@
+"""Hyper-connection mixing dots for fast-prefill chunks, fused with hc_post (patches/0240, ``tf_knobs.b12x`` bit 1).
+
+The idea comes from b12x's fused mHC (https://github.com/local-inference-lab/b12x, ``b12x/norm/mhc``, Apache License
+2.0, Copyright Luke Alonso and the b12x contributors): hc_post's new streams X' feed the next hc_pre's 24 mixing dots
+and square sums from registers, one launch per site instead of two, and the K split of those dots is laid out over
+column blocks of ALL FOUR streams (a program owns columns [c CB, (c + 1) CB) of every stream, which is exactly the
+data hc_post needs for them), so the fused kernel has as many programs as the unfused one. Re-implemented in Triton
+for this engine; the model math is GLM-5.3's (``glue``'s docstring), not b12x's variant of it (b12x rounds the collapse
+once and takes its square sum from a Gram matrix; here nothing but the K split changes):
+
+- X'_s = bf16(post_s * branch + (((c0s X0 + c1s X1) + c2s X2) + c3s X3)), ``glue._hc_post``'s expression, element for
+  element (the same bits as ``glue.hc_post``);
+- partial block c (c = 0 .. NB - 1): for the column steps t of the block, for s = 0 .. 3: the 24 dots of X'_s's
+  bf16 tile with fn's tile of stream s and the square sums, both on tensor cores into fp32 accumulators (the square
+  sums as the diagonal of X'_s X'_s^T, so their bits do not depend on how Triton lays a row over threads: every
+  number here is an mma chain fixed by the column order, hence the same for any row tile, warp count or step width);
+- the finish (mixes = the NB partials summed in order, Sinkhorn, collapse, RMSNorm) is ``glue._hc_finish_u``
+  unchanged.
+
+Against the current fast path (``fast_qmm.hc_partial``: 16 blocks of 1,024 contiguous flattened columns, i.e. a
+quarter of ONE stream a block, and square sums reduced in a Triton layout) only the summation order of the 24 mixes
+and the square sum changes: mixes differ in the last fp32 bits, so pre / post / comb and everything after them do too.
+New arithmetic for fast chunks (own snapshot tag, ``b12xpf``); deterministic; row-independent (each row is one row of
+the mma tiles; masked rows are zeros). ``partial`` (a site whose streams are already written: the first hc_pre after
+the embedding, and the unpipelined lean / non-lean chunks, which run ``glue.hc_post`` first) and ``post_partial`` (the
+pipelined slabs of patches/0084) give the same bits, by the construction above (tested on the GPU).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+BM = 32          # rows a program (no effect on bits)
+BK = 64          # columns a dot step (no effect on bits: the mma chains run in column order whatever the step)
+BKP = 16         # columns a step of the fused kernel's hc_post phase (no effect on bits: elementwise)
+WARPS = 4
+STAGES = 2
+_BROKEN = ""     # set when the fused kernel cannot launch here: ``post_partial`` then runs the two kernels (same bits)
+
+
+@triton.jit
+def _mhc_step(vb, FN, fcol, m, acc, sq, WIDE: tl.constexpr):
+    """One stream tile's contribution: acc += vb fn_tile^T (the 24 mixes), sq += vb vb^T (its diagonal: the squares)."""
+
+    w = tl.load(FN + m[:, None] * WIDE + fcol[None, :], mask=m[:, None] < 24, other=0.0)
+    acc = tl.dot(vb, tl.trans(w), acc)
+    sq = tl.dot(vb, tl.trans(vb), sq)
+    return acc, sq
+
+
+@triton.jit
+def _mhc_part(X, XOUT, G, POST, COMB, FN, PART, RS, R, D: tl.constexpr, WORLD: tl.constexpr, NB: tl.constexpr,
+              BM: tl.constexpr, BK: tl.constexpr, BKP: tl.constexpr, POST_ON: tl.constexpr):
+    """Program (row tile, column block c): columns [c CB, (c + 1) CB) of the four streams (CB = D / NB). POST_ON: first
+    the new streams from X and the gathered partials G (``glue._hc_post``'s expression, BKP columns a step), stored to
+    XOUT; then (both variants, the same code) the block's 24 mixes and square sum from XOUT's bf16 values, stream by
+    stream, BK columns a step, every product an mma into fp32 accumulators in column order (so neither BM, BK nor BKP
+    changes a bit). PART[r, c, 0:24] the mixes, PART[r, c, 24] the square sum."""
+
+    pid = tl.program_id(0)
+    c = tl.program_id(1)
+    WIDE: tl.constexpr = 4 * D
+    CB: tl.constexpr = D // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    off = rr[:, None] * WIDE
+    if POST_ON:
+        kp = tl.arange(0, BKP)
+        cb = COMB + rr * 16
+        c00 = tl.load(cb + 0, mask=ok, other=0.0)
+        c10 = tl.load(cb + 4, mask=ok, other=0.0)
+        c20 = tl.load(cb + 8, mask=ok, other=0.0)
+        c30 = tl.load(cb + 12, mask=ok, other=0.0)
+        c01 = tl.load(cb + 1, mask=ok, other=0.0)
+        c11 = tl.load(cb + 5, mask=ok, other=0.0)
+        c21 = tl.load(cb + 9, mask=ok, other=0.0)
+        c31 = tl.load(cb + 13, mask=ok, other=0.0)
+        c02 = tl.load(cb + 2, mask=ok, other=0.0)
+        c12 = tl.load(cb + 6, mask=ok, other=0.0)
+        c22 = tl.load(cb + 10, mask=ok, other=0.0)
+        c32 = tl.load(cb + 14, mask=ok, other=0.0)
+        c03 = tl.load(cb + 3, mask=ok, other=0.0)
+        c13 = tl.load(cb + 7, mask=ok, other=0.0)
+        c23 = tl.load(cb + 11, mask=ok, other=0.0)
+        c33 = tl.load(cb + 15, mask=ok, other=0.0)
+        p0 = tl.load(POST + rr * 4 + 0, mask=ok, other=0.0)
+        p1 = tl.load(POST + rr * 4 + 1, mask=ok, other=0.0)
+        p2 = tl.load(POST + rr * 4 + 2, mask=ok, other=0.0)
+        p3 = tl.load(POST + rr * 4 + 3, mask=ok, other=0.0)
+        for t in range(CB // BKP):
+            d = c * CB + t * BKP + kp
+            gv = tl.load(G + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            for kk in tl.static_range(1, WORLD):
+                gv = gv + tl.load(G + kk * RS + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            branch = gv.to(tl.bfloat16).to(tl.float32)
+            x0 = tl.load(X + off + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x1 = tl.load(X + off + D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x2 = tl.load(X + off + 2 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            x3 = tl.load(X + off + 3 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+            # glue._hc_post's expression, operand for operand
+            v0 = p0[:, None] * branch + (((c00[:, None] * x0 + c10[:, None] * x1) + c20[:, None] * x2) + c30[:, None] * x3)
+            v1 = p1[:, None] * branch + (((c01[:, None] * x0 + c11[:, None] * x1) + c21[:, None] * x2) + c31[:, None] * x3)
+            v2 = p2[:, None] * branch + (((c02[:, None] * x0 + c12[:, None] * x1) + c22[:, None] * x2) + c32[:, None] * x3)
+            v3 = p3[:, None] * branch + (((c03[:, None] * x0 + c13[:, None] * x1) + c23[:, None] * x2) + c33[:, None] * x3)
+            tl.store(XOUT + off + d[None, :], v0.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + D + d[None, :], v1.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + 2 * D + d[None, :], v2.to(tl.bfloat16), mask=ok[:, None])
+            tl.store(XOUT + off + 3 * D + d[None, :], v3.to(tl.bfloat16), mask=ok[:, None])
+        # the dots read the block back (this CTA's own stores, L1 / L2, visible after the barrier) rather than taking it
+        # from registers: the unfused kernel's code from here on (hence its bits), and Triton does not re-materialize the
+        # post in each consumer's layout (that took 255 registers and spilled)
+        tl.debug_barrier()
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BM, 32), dtype=tl.float32)
+    sq = tl.zeros((BM, BM), dtype=tl.float32)
+    for s in tl.static_range(4):
+        for t in range(CB // BK):
+            d = c * CB + t * BK + k
+            u = tl.load(XOUT + off + s * D + d[None, :], mask=ok[:, None], other=0.0)
+            acc, sq = _mhc_step(u, FN, s * D + d, m, acc, sq, WIDE)
+    i = tl.arange(0, BM)
+    ss = tl.sum(tl.where(i[:, None] == i[None, :], sq, 0.0), axis=1)       # the diagonal (one term a row: exact)
+    pm = ok[:, None] & (m[None, :] < 24)
+    tl.store(PART + (rr[:, None] * NB + c) * 32 + m[None, :], acc, mask=pm)
+    tl.store(PART + (rr * NB + c) * 32 + 24, ss, mask=ok)
+
+
+def step(d: int, nb: int, bk: int | None = None) -> int:
+    """Columns a step: ``BK`` (or ``bk``), or the whole block when it is narrower (any width gives the same bits)."""
+
+    return min(BK if bk is None else bk, d // nb)
+
+
+def fits(d: int, nb: int) -> bool:
+    """The kernel's shape rule: D splits into NB column blocks of a multiple of 16 columns."""
+
+    cb = d // nb
+    return d % nb == 0 and cb % 16 == 0 and cb % step(d, nb) == 0 and cb % step(d, nb, BKP) == 0
+
+
+def _check(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> tuple[int, int]:
+    rows, wide = x.shape
+    d = wide // 4
+    if wide != 4 * d or x.stride(1) != 1 or x.stride(0) != wide or not fn.is_contiguous() or fn.shape[1] != wide:
+        raise ValueError("b12x_mhc: contiguous [R, 4 D] streams and fn [24, 4 D] expected")
+    if not fits(d, nb) or part.shape[0] < rows or part.shape[1] != nb or part.shape[2] < 25:
+        raise ValueError("b12x_mhc: D / NB must be a multiple of 16 columns, part [R, NB, 32]")
+    return rows, d
+
+
+def partial(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> None:
+    """The mixes' partials of streams already in ``x`` [R, 4 D] bf16 (``fast_qmm.hc_partial``'s contract, this
+    module's K split)."""
+
+    rows, d = _check(x, fn, part, nb)
+    if rows == 0:
+        return
+    _mhc_part[(triton.cdiv(rows, BM), nb)](x, x, x, x, x, fn, part, 0, rows, D=d, WORLD=1, NB=nb, BM=BM,
+                                            BK=step(d, nb), BKP=step(d, nb, BKP), POST_ON=False, num_warps=WARPS, num_stages=STAGES)
+
+
+def post_partial(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, post: torch.Tensor, comb: torch.Tensor,
+                 fn: torch.Tensor, part: torch.Tensor, nb: int) -> bool:
+    """``glue.hc_post(x, xout, gathered, post, comb)`` then ``partial(xout, fn, part, nb)`` in one pass. False
+    (nothing written) when the kernel cannot launch here; the caller then runs the two (same bits)."""
+
+    global _BROKEN
+    rows, d = _check(xout, fn, part, nb)
+    world = gathered.shape[0]
+    if gathered.stride(2) != 1 or gathered.stride(1) != d or gathered.shape[1] < rows:
+        raise ValueError("b12x_mhc: the gathered partials' rows must be contiguous")
+    if _BROKEN:
+        return False
+    if rows == 0:
+        return True
+    try:
+        _mhc_part[(triton.cdiv(rows, BM), nb)](x, xout, gathered, post, comb, fn, part, gathered.stride(0), rows, D=d,
+                                                WORLD=world, NB=nb, BM=BM, BK=step(d, nb), BKP=step(d, nb, BKP), POST_ON=True, num_warps=WARPS,
+                                                num_stages=STAGES)
+        return True
+    except Exception as exc:                            # noqa: BLE001 - triton.runtime.errors.OutOfResources et al.
+        if type(exc).__name__ not in ("OutOfResources", "CompilationError"):
+            raise
+        _BROKEN = f"{type(exc).__name__}: {exc}"
+        print(f"[tensorfold] b12x mhc: the fused kernel cannot run here ({_BROKEN}); post + partial kernels",
+              flush=True)
+        return False
+
+
+# -- reference (tests) ------------------------------------------------------------------------------------------------
+def partial_reference(x: torch.Tensor, fn: torch.Tensor, nb: int) -> torch.Tensor:
+    """float64 partials of this module's K split: [R, nb, 25] (24 mixes, the square sum)."""
+
+    rows, wide = x.shape
+    d = wide // 4
+    cb = d // nb
+    xs = x.double().view(rows, 4, nb, cb)
+    f = fn.double().view(24, 4, nb, cb)
+    mix = torch.einsum("rsbk,msbk->rbm", xs, f)
+    sq = (xs * xs).sum(dim=(1, 3))
+    return torch.cat([mix, sq[:, :, None]], 2)
diff --git a/src/tensorfold/families/glm5_next/spark/b12xpf.py b/src/tensorfold/families/glm5_next/spark/b12xpf.py
new file mode 100644
index 0000000..11421e4
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/b12xpf.py
@@ -0,0 +1,110 @@
+"""b12x-derived fast-prefill kernels for GLM-5.3-Flash (patches/0240): the switch, its snapshot tag bits, its load checks.
+
+Three kernels ported from the ideas of b12x (https://github.com/local-inference-lab/b12x, Apache License 2.0,
+Copyright Luke Alonso and the b12x contributors; see NOTICE), each re-implemented in Triton for this engine and each
+behind one bit of ``tf_knobs.b12x`` (default: GLM53_TF_B12X, 0 = off):
+
+    bit 1  ``b12x_mhc``   hyper-connections: the next hc_pre's 24 mixing dots and square sums split by column blocks
+                          of all four streams, on tensor cores, and in patches/0084's slabs fused with hc_post (one
+                          launch and one read of the new streams less a site)
+    bit 2  ``b12x_kda``   KDA: 16-row tiles, the tile preparation and the recurrence in one program per (head, block
+                          of value rows), fp32 state on chip, no workspace (``fast_kda`` writes and re-reads ~94 MB of
+                          fp32 scratch a 1,024-row call)
+    bit 4  ``b12x_attn``  sparse latent attention: one online softmax over a row's whole token list (no 512-token
+                          chunk partials, no merge); latent KV engines only
+
+Every bit is NEW ARITHMETIC for fast chunks only (decode, verify, the MTP head, DFlash2 and exact prefill never run
+them), deterministic and row-independent (patches/0085's rules: fixed shapes and reduction orders, no atomics, the KDA
+tiles at absolute multiples of 16 inside the 64-aligned fast calls), so drafted == serial and resumed == fresh hold
+within each setting. A fast prefill's snapshot tag gets 4 x (the effective bits) (``pfgrid.tag``), so a request only
+resumes snapshots made with the same kernels; fast requests with other bits, exact requests, FP8 and
+GLM53_TF_LATENT_TC snapshots never mix with them.
+
+Per request through patches/0090's header (``tf_knobs.b12x``, both ranks set it from rank 0's header). What decides the
+kernels' bits beyond the bits themselves (``b12x_kda.PREC`` / ``BV`` / ``WARPS``: GLM53_TF_B12X_KDA_PREC, _BV, _WARPS) is
+load-time and checked equal on both ranks (``load_settings``). Nothing here imports torch.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+ENV = "GLM53_TF_B12X"
+MHC, KDA, ATTN = 1, 2, 4
+ALL = MHC | KDA | ATTN
+
+# what the next prefill runs (engine._set_knobs switches it per request)
+BITS = 0
+
+
+def default() -> int:
+    raw = os.environ.get(ENV, "").strip()
+    if not raw:
+        return 0
+    try:
+        v = int(raw)
+    except ValueError:
+        raise ValueError(f"{ENV}={raw!r}: expected 0 to {ALL}") from None
+    if not 0 <= v <= ALL:
+        raise ValueError(f"{ENV}={raw!r}: expected 0 to {ALL} (1 hyper-connections, 2 KDA, 4 sparse attention)")
+    return v
+
+
+def _mod(name: str):
+    return sys.modules.get(f"{__package__}.{name}") if __package__ else None
+
+
+def set_bits(v: int) -> None:
+    """Switch the kernels for the next prefills (both ranks do it from the header's value)."""
+
+    global BITS
+    v = int(v)
+    if not 0 <= v <= ALL:
+        raise ValueError(f"tf_knobs.b12x={v}: expected 0 to {ALL}")
+    BITS = v
+    for name, attr, bit in (("glue", "MHC", MHC), ("latent", "SPARSE_ONE", ATTN)):
+        mod = _mod(name)
+        if mod is None and v & bit:
+            try:
+                import importlib
+
+                mod = importlib.import_module(f"{__package__}.{name}")
+            except Exception:            # noqa: BLE001 - host fakes without torch / triton: nothing to switch
+                mod = None
+        if mod is not None:
+            setattr(mod, attr, bool(v & bit))
+
+
+def kda_on() -> bool:
+    return bool(BITS & KDA)
+
+
+def effective(bits: int, w=None) -> int:
+    """The bits that change a fast prefill on this engine: the sparse kernel only runs on the latent cache (host
+    fakes without ``w.meta`` keep every bit)."""
+
+    meta = getattr(w, "meta", None)
+    if isinstance(meta, dict) and not meta.get("latent_kv"):
+        bits &= ~ATTN
+    return bits & ALL
+
+
+def tag_bits(w=None, bits: int | None = None) -> int:
+    return effective(BITS if bits is None else int(bits), w)
+
+
+def load_settings() -> list[int]:
+    """What both ranks must agree on at load (the KDA kernel's precision and value block decide its bits)."""
+
+    try:
+        from . import b12x_kda
+    except Exception:                    # noqa: BLE001 - host fakes without torch / triton
+        return [-1, -1, -1]
+    return b12x_kda.settings()
+
+
+def describe(v: int | None = None) -> str:
+    v = BITS if v is None else v
+    parts = [n for b, n in ((MHC, "hc"), (KDA, "kda"), (ATTN, "sparse")) if v & b]
+    return ",".join(parts) or "off"
diff --git a/src/tensorfold/families/glm5_next/spark/batch.py b/src/tensorfold/families/glm5_next/spark/batch.py
new file mode 100644
index 0000000..8f67778
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/batch.py
@@ -0,0 +1,2507 @@
+"""Continuous batching for GLM-5.3-Flash's CUDA engine (``GLM53_TF_BATCH=N``, N >= 2; patches/0030, rebuilt on the
+current engine by patches/0120): up to N requests decode together, and each round is ONE forward over every
+decoding request's verify window.
+
+Why it pays: decode reads the weights once a forward (about 5 GB a rank), and a row from a second sequence costs
+what an extra draft row of one sequence costs (mostly the experts it adds). Rows never depend on their
+window-mates (``forward.py``), so a round's rows can come from different sequences as long as the work that reads
+per-sequence state is done per sequence.
+
+Slots. One ``forward.State`` per slot (slot 0 is the engine's own ``e.st``), the engine's ``Buffers`` shared. Every
+slot has the engine's context (latent KV with patches/0060, index rings with patches/0065), its own KDA states, its
+own MTP-head cache and CUDA graphs, and its own DFlash2 context (``_drafter_view``: the drafter's weights and
+buffers shared, its context caches, positions and graphs per slot). Slots other than 0 keep window-sized KDA
+projection / replay rows (``engine.MAX_ROWS``: 8, or patches/0380's GLM53_TF_MAX_DRAFT_ROWS up to 16); a prefill on
+such a slot borrows slot 0's (``_borrow``), which only hold the rows of one forward between that forward and its
+commit.
+
+A round (``_execute``, both ranks, from rank 0's plan: ``batchplan``):
+
+1. cancels (a client went away; a background request steps aside for a waiting one and runs again later);
+2. admissions: a queued request takes a free slot (the one whose kept snapshots resume the longest prefix of its
+   prompt, else the least recently used);
+3. at most one prefill piece: the next ``GLM53_TF_BATCH_PIECE`` tokens of one admitted prompt (fast prefill:
+   rounded to its chunk grid), through ``decode.prefill`` itself (exact, fast, lean, FP8, pipelined: whatever the
+   request's knobs say), resumed from the snapshot the previous piece left. Resumed == fresh holds for every
+   prefill mode, so a prompt prefilled in pieces has the bits of one prefill. Pieces take at most
+   ``GLM53_TF_BATCH_PREFILL_SHARE`` of the time while other requests decode (``batchplan.Fairness``), so a long
+   prompt never stalls the others for more than one piece;
+4. one verify forward over every decoding request's window (pending token + drafts), then per request, from its own
+   rows: keyed sampling (all requests' candidates in ONE all-gather), the accept rule, ``forward.commit`` on its
+   state, and its drafter's next drafts (``Stepper``: ``decode.auto_decode``'s round cut at the forward, so MTP,
+   DFlash2, lookup, ``auto``'s choice and cost-derived depths run per request exactly as alone).
+
+Exactness. A request's tokens are the keyed samples of its own logits at its own positions. Its logit rows are the
+bits of its lone forward (row-local kernels; per-slot kernels see only the slot's state and rows), its state
+advances by ``commit`` exactly as alone, its prefill is ``decode.prefill`` (in pieces: resumed == fresh), and the
+accept rule only decides how many of its rows to keep; drafts only propose. So each batched reply is
+byte-identical to the same request served alone, and to serial decoding, whatever shares its rounds.
+
+Draft depths. ``auto`` / ``o`` requests with cost-derived depths (patches/0071) price a row at the slope of the
+verify curve past the other requests' rows, against the aggregate rate of the shared rounds
+(``batchplan.RoundCosts``): a draft row that slows every request must buy more than one that slows only its own.
+
+CUDA graphs. Slot 0 alone replays the engine's own graphs. Other rounds replay graphs captured lazily per (slots,
+window rows, per-slot context mode: dense or patches/0050's pool bucket), up to ``GLM53_TF_BATCH_MAX_GRAPHS``; the
+KDA states of a graphed round are kept in buffer 0 (``_parity0``: a copy of the state when a commit left it in
+buffer 1, 71 MB a slot) so parities do not multiply the keys. A key's first round runs eagerly through the
+capturable code (its result) and is captured after (as 0050 does). Windows crossing 2,051 tokens run eager.
+
+Tensor parallelism. Rank 0 alone decides each round's cancels, admissions (slot, resume length, request header)
+and pieces and shares them before the round; rank 1 runs the same rounds in ``follow``.
+
+Sessions (patches/0180, GLM53_TF_SESSION_GIB > 0 with GLM53_TF_BATCH_SESSIONS=1): patches/0110's store behind every
+slot. At admission rank 0 looks the prompt up in the store (``SessionStore.plan``: the longest stored prefix of the
+request's prefill mode, and the marks its prefill takes); when that resumes more than the free slots' own snapshots,
+the request goes to the free slot already holding most of the entry's pages, and ``_admit`` copies the entry into
+that slot's caches (restore = copy-in: the slot owns its copy, so later evictions never touch it) and resumes its
+first piece from the entry's snapshot. Saves follow the lone engine's rules on the slot's live caches: marks (and a
+piece end that is one) right after the piece that took them, the prompt snapshot after the last piece (exact: at the
+prompt's end; fast: its last grid point; patches/0540, both: its last grid point strictly before the end), the reply
+snapshot when a drafted exact request ends. Rank 0 ships each
+admission's session plan (entry, marks, its store digest) right after the admission's prompt, and each save's
+decision (stored / skipped / duplicate, evictions) when it happens, both inside the round both ranks run; rank 1
+checks the digest and applies the decisions. The store's budget is set aside at load (slots are added while the
+reserve AND the budget stay free) and at admission (``batchplan.admit_free``). A fork point is also a prefix shared
+with a prompt in flight (running or admitted in the same round): sessions admitted together see no stored entry of
+each other. Which side of a save decision a batcher is on is its role (``follow`` = rank 1), never ``g.rank``, as
+for every other message of a round. patches/0250 (GLM53_TF_SESSION_DISK): an admission may resume from an entry on
+disk instead; it is read into the chosen slot from the moment the plan is known (rank 0 in ``_plan``, rank 1 in
+``follow``, when the slot is idle) and finished in ``_admit``, where both ranks agree on the outcome (a failed read on
+either: both prefill the prompt from scratch).
+
+Batched parallelism (patches/0200; each knob off by default, the ranks must agree):
+``GLM53_TF_BATCH_CAPTURE_AFTER=N`` captures a multi-sequence graph key on its N-th sighting (``batchplan.Sightings``;
+keys met once run eagerly through the same capturable code instead of paying a capture); ``GLM53_TF_BATCH_PAD=2,4,8``
+pads each slot's window to the next listed size with its last token (``_pad``: fewer keys; padded rows are verified
+like drafts that can never be accepted and ``commit`` gets the padded row count, so the kept bits are the unpadded
+window's); ``GLM53_TF_BATCH_SHORT=N`` gives every prompt with at most N tokens left its piece in the round it is
+admitted, several a round, outside the fair share (``batchplan.pick_pieces``); ``GLM53_TF_BATCH_PARITY_KEY=1`` puts
+each slot's KDA parity in the graph key instead of copying a state left in buffer 1 back to buffer 0 before every
+graphed round (71 MB a slot and round; every slot flips each round, so the keys only double: the graph bakes in
+``rec[cur]`` / ``rec[1 - cur]`` as the engine's own (rows, parity) graphs do). Each request's stats carry
+``round_kinds`` (alone / graph / eager / capture rounds, padded rows, and the wall ms of its verify rounds, of its
+own drafting, and of other requests' prefill pieces it waited through). ``GLM53_TF_BATCH_MTP=1`` drafts the MTP
+chains of all slots together (``MtpChains``: one head pass absorbs every slot's backlog, one pass per chained step
+over the slots still drafting; the head's weights read once a pass instead of once a slot).
+``GLM53_TF_BATCH_ROW_MS=F`` prices a row past the calibrated verify table at no less than F ms in the batch-aware
+cost-derived depths (``batchplan.verify_ms``; the table's flattening top alone, ~4.5 ms, drafts too deep at 3-4
+sequences where a row costs 6-10 ms).
+
+Round buckets (patches/0280, off by default): ``GLM53_TF_BATCH_BUCKETS=4,8`` pads EVERY window of a multi-slot round
+(graph path only) to the smallest listed size >= the round's longest window (``_bucket``; the same padding rules as
+``GLM53_TF_BATCH_PAD``), so a round's key is (slots, bucket, modes, parities) instead of one row count a slot: with
+every slot flipping its KDA parity each round, 4 decoding slots meet ~2 keys a bucket and nearly every round replays a
+graph. ``GLM53_TF_BATCH_PAD_TIE`` (auto: on with buckets) makes a padded row route as its window's last real row
+(``Buffers.route_src``: the row's router logits replaced by that row's before top-k), so padded rows add no expert
+reads (the ~6 ms a row of a real row); padded rows are never kept, and every real row's bits are unchanged (its own
+logits; row-independent kernels). The depth model keeps pricing the real rows only.
+
+Per-slot drafter choice in shared rounds (patches/0340, off by default): ``GLM53_TF_BATCH_ADAPT=1`` makes each slot of
+a request with cost-derived depths pick its round's drafter (MTP, DFlash2, or none: a one-row serial round with
+``GLM53_TF_BATCH_ADAPT_SERIAL=1``) by the drafts' surplus at the SHARED rounds' rate and marginal row costs
+(``adapt.SlotChoice``) instead of ``decode.DrafterChoice``'s tokens per lone-model ms; ``BatchDepth`` still picks the
+depth. Alone, a slot's own choice decides as before. Drafts only: replies unchanged.
+
+Multi-slot prefill (patches/0560, ``mpf.py``, GLM53_TF_MULTI_PREFILL=1, off by default): the round's pieces of fast
+lean prefills with the same knobs go through ONE forward (``mpf.run``: each member's rows contiguous, its own
+sub-blocks, KDA / DSA / carries / commit / snapshots / head per member, the routed experts once over every row), up to
+GLM53_TF_MULTI_PREFILL_ROWS rows; each member's piece then ends in ``_piece`` as alone (``mpf.take``: the group's first
+token instead of ``decode.prefill``). Same bits a member as alone (0085's row-independent fast kernels). Rank 0 also
+takes more pieces a round when the fair share allows one (``mpf.more_pieces``) and, idle, waits a few ms for more
+arrivals (``mpf.coalesce``).
+
+Kept in step with ``forward.py``: ``compute_multi``'s layer loop, ``_kda`` and ``_dsa`` mirror ``forward.compute``,
+``kda_block`` and ``dsa_block`` (and ``latent``'s pieces); a change there must be made here too (the tests compare
+batched rows with lone ones bit for bit).
+"""
+
+from __future__ import annotations
+
+import collections
+import copy
+import hashlib
+import json
+import os
+import queue
+import sys
