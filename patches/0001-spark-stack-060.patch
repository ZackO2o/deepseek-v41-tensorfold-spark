+++ b/src/tensorfold/families/glm5_next/spark/fast_qmm.py
@@ -0,0 +1,648 @@
+"""Prefill-shaped 4-bit / BF16 matmuls for GLM-5.3-Flash (patches/0081), for M in 256..2048 rows.
+
+``matmul_prefill`` has the signature and semantics of ``qmm.matmul`` (``qmm.Q4``: MLX affine 4-bit in groups of 64
+along K; ``qmm.B16``: plain BF16) and is meant for the fast-prefill path (patches/0080, ``GLM53_TF_FAST_PREFILL``).
+
+What changes against ``qmm._qmm`` / ``qmm._bmm`` (tuned for 1-16 row decode steps):
+
+- One program owns a BM x BN output tile (BM 128, 64 under 512 rows; BN 128, or 64 when the shape has several
+  K slices, see ``CONFIG``) over the WHOLE K range: no split-K partial buffer, no
+  second reduce kernel. At M = 1024 on the KDA projection (12576 x 4096, 4 K slices) ``qmm`` writes and re-reads
+  4 x 1024 x 12576 fp32 partials = 206 MB each way; here nothing leaves the registers but the output.
+- A 64 x BN weight group is unpacked once per program and feeds a BM-row tensor-core dot, and the M tiles of one
+  column block are consecutive program ids (M fastest), so the concurrently running programs share each weight
+  tile in L2 and the weights stream from DRAM about once per call.
+- The arithmetic is qmm's, operation for operation. For weight group g (64 inputs):
+
+      P[m, n, g] = x[m, g-block] . q[n, g-block]          tl.dot, bf16 x integer-valued bf16 -> fp32
+      acc[m, n] += P[m, n, g] * s[n, g] + xs[m, g] * b[n, g]
+
+  and qmm's K split (``qmm.split_k`` / ``qmm.b16_split_k``, fixed by the weight's shape) is kept as an ORDER of
+  summation: the program walks the SK slices in turn, sums each slice from zero exactly as qmm's slice program
+  does, and adds the slice sums in slice order exactly as ``qmm._reduce`` does. A row's value therefore does not
+  depend on the row tile, the column tile or the other rows, and is meant to equal ``qmm.matmul`` bit for bit
+  (``tests/cuda/test_fastk_patches.py::test_fast_qmm_bitwise`` checks it on hardware). ``exact=False`` drops the
+  slice order (one accumulator, lower register pressure); still deterministic and row-invariant, not qmm's bits.
+
+``matmul_fast`` (what fast-prefill chunks run): ``exact=False``, one accumulator over K and a 128 x 64 tile at 4
+warps (``LOOSE``), 1.1-1.7x faster than the exact tiles; deterministic and row-independent, not qmm's bits.
+
+``matmul_fp8`` (patches/0083, what fast chunks run when an FP8 prefill is on, ``fp8pf``): x rounded to e4m3 per row
+(power-of-two scales), the exact 4-bit weights as e4m3, fp8 tensor-core dots per 64-input group, fp32 group sums;
+deterministic and row-independent.
+
+``hc_partial``: ``glue.hc_pre``'s 24 mixing dots for fast chunks, 64 rows a program sharing each fn tile (bf16
+tensor-core dots, fp32 sums; not ``glue``'s bits, row-independent).
+
+Deterministic: no atomics, fixed reduction order, no autotuning (``CONFIG`` below is a fixed table by (N, K) and
+the row bucket; no entry changes bits).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from . import fp8pf, qmm
+from .qmm import B16, GS, Q4, Q8
+
+# Per rank of GLM-5.3-Flash at TP=2 (N x K):
+#   KDA  [q|k|v|f_a|g_a|b] 12576x4096, f_b/g_b 4096x128, o_proj 4096x4096
+#   DSA  q_a|kv_a 2048x4096, q_b 8192x1536, kv_b (k, v) 8192x512 each, o_proj 4096x8192
+#   dense MLP gate|up 12288x4096, down 4096x6144; EXL3 shared expert gate|up 2048x4096, down 4096x1024
+#   indexer k|w 160x4096, q_b 4096x1536; MTP eh_proj 4096x8192; head 77440x4096
+# Value: (BM for M >= 512, BM for M < 512, warps, stages, groups per unrolled step). Columns per program: 128 when
+# the shape has one K slice, 64 when it has several: the exact variant then keeps two BM x BN fp32 accumulators
+# (slice sum and total) plus the dot result live, 3 x 128 x 64 / 256 threads = 96 registers at 8 warps, where
+# 128 x 128 would need 192 and spill. K slices per shape (qmm.split_k): 12576x4096 4, 4096x4096 2, 2048x4096 4,
+# 8192x1536 4, 8192x512 4, 4096x8192 8, 4096x6144 4, 4096x1024 2, 4096x1536 2, 160x4096 8; one slice: 12288x4096,
+# 4096x128, the head. No entry changes bits. Used for row counts and shapes ``TUNED`` does not cover.
+CONFIG: dict[str, tuple[int, int, int, int, int]] = {
+    "4096x128": (128, 64, 8, 2, 2),
+    "160x4096": (64, 64, 4, 3, 1),
+}
+DEFAULT = (128, 64, 8, 3, 1)
+BN_ONE, BN_SPLIT = 128, 64          # columns per program with one K slice / with several (exact variant)
+BN_STORED = qmm.BN                  # columns of one stored weight tile (64)
+MIN_ROWS = 64                       # fewer rows go to qmm.matmul (tuned for 1-128 rows)
+# patches/0085: in a fast-prefill chunk only this matrix (the head, set by ``fastpf.chunk``: one row in every chunk
+# schedule) keeps the qmm fallback below MIN_ROWS; every other call there runs the fast kernels whatever its rows, so
+# a row never gets other bits in a short call (a prompt's last chunk, a lean tail) than in a long one
+FAST_HEAD = None
+
+# Measured on GB10 (tests/cuda/test_fastk_patches.py::test_fast_qmm_timing; every tile config gives qmm's bits, so
+# the choice is free): per (N x K) and row bucket, (BM, BN, warps, stages) of the fastest config, or None where qmm's
+# split-K kernels were faster (they then run, with the caller's ``part`` buffer). Buckets: 512 for 512..1535 rows
+# (measured at 1024), 1536 for 1536+ rows (measured at 2048). ms at 1024 rows qmm -> this entry: 12576x4096
+# 3.29 -> 2.54, 4096x4096 0.80 -> 0.80, 2048x4096 0.51 -> 0.42, 8192x1536 1.52 -> 0.67, 8192x512 1.36 -> 0.23,
+# 4096x6144 1.35 -> 1.30, 4096x1024 0.39 -> 0.21, 4096x1536 0.45 -> 0.31; qmm kept: 4096x8192 2.04 (tiles 2.30),
+# 12288x4096 1.82 (1.83), 4096x128 0.028 (0.033), 160x4096 0.045 (0.060).
+TUNED: dict[str, dict[int, tuple[int, int, int, int] | None]] = {
+    "12576x4096": {512: (64, 64, 4, 3), 1536: (64, 64, 4, 3)},
+    "4096x4096": {512: (128, 64, 4, 3), 1536: (128, 64, 4, 3)},
+    "2048x4096": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 3)},
+    "8192x1536": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 2)},
+    "8192x512": {512: (64, 64, 4, 2), 1536: (64, 64, 4, 3)},
+    "4096x8192": {512: None, 1536: None},
+    "12288x4096": {512: None, 1536: (128, 64, 4, 3)},
+    "4096x6144": {512: (64, 64, 4, 2), 1536: None},
+    "4096x1024": {512: (128, 64, 4, 2), 1536: (128, 64, 4, 2)},
+    "4096x128": {512: None, 1536: (64, 64, 4, 2)},
+    "160x4096": {512: None, 1536: None},
+    "4096x1536": {512: (64, 64, 4, 2), 1536: (128, 64, 4, 3)},
+}
+USE_QMM = "qmm"
+
+# ``exact=False`` (what fast-prefill chunks run, ``matmul_fast``): one accumulator over all of K, so the tile is free
+# of qmm's slice order and a 128 x 64 tile at 4 warps wins everywhere it was measured (M 400 / 1024 / 2048 on GB10):
+# ms at 1024 rows, exact tiles -> one accumulator: 12576x4096 2.64 -> 1.82, 4096x4096 0.80 -> 0.61, 2048x4096
+# 0.42 -> 0.34, 8192x1536 0.67 -> 0.46, 8192x512 0.24 -> 0.17, 4096x8192 2.12 (qmm) -> 1.24, 12288x4096 1.86 -> 1.81,
+# 4096x6144 1.31 -> 0.94, 4096x1024 0.21 -> 0.16, 4096x1536 0.31 -> 0.23. The two tiny shapes keep their own tile
+# (qmm is up to 0.01 ms faster on them below 1536 rows, but a shape that switched kernels by row count would give a
+# row other bits in a short call than in a long one).
+LOOSE = (128, 64, 4, 3)
+LOOSE_TUNED: dict[str, tuple[int, int, int, int]] = {"4096x128": (64, 64, 4, 2), "160x4096": (128, 64, 8, 3)}
+
+
+def config(n: int, k: int, m: int, sk: int, *, tuned: bool = True, loose: bool = False):
+    """(BM, BN, warps, stages, gpi) for an (n, k) weight at m rows summed in ``sk`` K slices, or ``USE_QMM`` where
+    ``qmm.matmul`` is faster (``TUNED``, measured for 4-bit weights; ``tuned=False``: the fixed table only;
+    ``loose``: the one-accumulator variant, ``LOOSE``)."""
+
+    if tuned and sk == 1 and loose:
+        bm, bn, warps, stages = LOOSE_TUNED.get(f"{n}x{k}", LOOSE)
+        return bm, bn, warps, stages, 1
+    row = TUNED.get(f"{n}x{k}") if tuned else None
+    if row is not None and m >= 512:
+        entry = row[1536 if m >= 1536 else 512]
+        if entry is None:
+            return USE_QMM
+        bm, bn, warps, stages = entry
+        return bm, bn, warps, stages, 1
+    bm_big, bm_small, warps, stages, gpi = CONFIG.get(f"{n}x{k}", DEFAULT)
+    bm = bm_big if m >= 512 else bm_small
+    return bm, (BN_ONE if sk == 1 else BN_SPLIT), warps, stages, gpi
+
+
+# Program order (``_tile``): M tiles fastest within groups of GROUP_M row tiles, the groups one after another, so a
+# group's rows (GROUP_M * BM x K bf16, 16 MB at 2048 x 4096) stay in L2 while every column block streams past them
+# once. Up to GROUP_M row tiles this is the plain M-fastest order; past it (lean 4096-8192-row chunks) the plain
+# order re-read the whole x from DRAM for every column block (12576x4096 at 8192 rows: 43 ms, 20 TF/s). The order
+# changes no bits (each tile's arithmetic is its own).
+GROUP_M = tl.constexpr(16)
+
+
+@triton.jit
+def _tile(pid, M, N, BM: tl.constexpr, BN: tl.constexpr, GM: tl.constexpr):
+    num_m = tl.cdiv(M, BM)
+    per_group = GM * tl.cdiv(N, BN)
+    first = (pid // per_group) * GM
+    size = tl.minimum(num_m - first, GM)
+    return first + (pid % per_group) % size, (pid % per_group) // size
+
+
+@triton.jit
+def _fq4(X, XS, W, S, B, OUT, M, x_stride,
+         N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+         TN: tl.constexpr, GPI: tl.constexpr, F32: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] over all K, qmm's per-group arithmetic, qmm's K slices
+    summed in slice order."""
+
+    KG: tl.constexpr = K // 64
+    PER: tl.constexpr = KG // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    rw = tl.arange(0, 8)
+    shifts = tl.arange(0, 8) * 4
+    m_ok = rm < M
+    n_ok = rn < N
+    # stored tiles: words [N/64][K/64][64][8]; column n lives in tile n // 64 at local row n % 64
+    wrow = (rn // TN).to(tl.int64) * (KG * TN * 8) + (rn % TN) * 8
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    for sl in tl.static_range(SK):
+        acc = tl.zeros((BM, BN), dtype=tl.float32)
+        for i in range(PER // GPI):
+            for j in tl.static_range(GPI):
+                g = sl * PER + i * GPI + j
+                words = tl.load(W + wrow[:, None] + g * (TN * 8) + rw[None, :], mask=n_ok[:, None], other=0)
+                x = tl.load(X + rm[:, None] * x_stride + (g * 64 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+                q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+                q = tl.reshape(q, (BN, 64)).to(tl.bfloat16)
+                p = tl.dot(x, tl.trans(q))
+                s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+                b = tl.load(B + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+                xs = tl.load(XS + rm * KG + g, mask=m_ok, other=0.0)
+                acc = acc + p * s[None, :] + xs[:, None] * b[None, :]
+        if sl == 0:
+            total = acc
+        else:
+            total = total + acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+@triton.jit
+def _fb16(X, W, OUT, M, x_stride, N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr,
+          BN: tl.constexpr, BK: tl.constexpr, F32: tl.constexpr):
+    """BF16 weights: qmm._bmm's arithmetic (K in BK steps, fp32 sums), its K slices summed in slice order."""
+
+    PER: tl.constexpr = K // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    n_ok = rn < N
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    for sl in tl.static_range(SK):
+        acc = tl.zeros((BM, BN), dtype=tl.float32)
+        for k0 in range(sl * PER, sl * PER + PER, BK):
+            x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+            w = tl.load(W + rn[:, None].to(tl.int64) * K + (k0 + rk)[None, :], mask=n_ok[:, None], other=0.0)
+            acc = acc + tl.dot(x, tl.trans(w))
+        if sl == 0:
+            total = acc
+        else:
+            total = total + acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+# -- patches/0470: 8-bit weights (``qmm.Q8``) --------------------------------------------------------------------------
+# ``qmm._q8mm``'s arithmetic per output element (per group of G inputs: one tensor-core dot from zero, times the
+# group's scale, added in group order; ``qmm.q8_split_k``'s slices summed in slice order when ``exact``), over the
+# whole K in one program: ``exact`` gives qmm's bits, ``exact=False`` (fast chunks) one accumulator. Tiles (BM, BN,
+# warps, stages): chosen offline as the largest that compile for sm_121 without spills at every per-rank shape
+# (tests/test_q8_compile.py: a group's dot result and the running sum are two BM x BN fp32 accumulators, the exact
+# variant's slice total a third; 128 x 64 spilled 140 B, 64 x 64 12 B); not yet timed on GB10 (docs/QUALITY-PLAN.md).
+# GLM53_TF_Q8_TILE=bm,bn,warps,stages overrides both (no tile changes bits).
+Q8_TILE_EXACT = (64, 32, 8, 3)
+Q8_TILE_LOOSE = (128, 32, 8, 2)
+
+
+def q8_tile(exact: bool) -> tuple[int, int, int, int]:
+    import os
+
+    v = os.environ.get("GLM53_TF_Q8_TILE", "").strip()
+    if not v:
+        return Q8_TILE_EXACT if exact else Q8_TILE_LOOSE
+    t = tuple(int(p) for p in v.split(","))
+    if len(t) != 4 or t[0] not in (16, 32, 64, 128, 256) or t[1] not in (32, 64, 128, 256):
+        raise ValueError(f"GLM53_TF_Q8_TILE={v!r}: expected bm,bn,warps,stages (bm 16-256, bn 32-256, powers of 2)")
+    return t
+
+
+@triton.jit
+def _fq8(X, W, S, OUT, M, x_stride, N: tl.constexpr, K: tl.constexpr, SK: tl.constexpr, BM: tl.constexpr,
+         BN: tl.constexpr, G: tl.constexpr, F32: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] over all K with ``qmm._q8mm``'s per-group arithmetic, its K
+    slices summed in slice order (SK = 1: one accumulator)."""
+
+    KG: tl.constexpr = K // G
+    PER: tl.constexpr = KG // SK
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    m_ok = rm < M
+    n_ok = rn < N
+    wrow = W + rn[:, None].to(tl.int64) * (K // 4) + tl.arange(0, 16)[None, :]      # int32 words (qmm._q8_unpack)
+    xrow = X + rm[:, None].to(tl.int64) * x_stride + rk[None, :]
+    # qmm's K slices as an order of summation in ONE loop (a static loop a slice unrolled SK copies of the pipelined
+    # body and spilled): the slice sum restarts at each slice's first group and is added to the total at its last
+    total = tl.zeros((BM, BN), dtype=tl.float32)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for g in range(KG):
+        p = tl.zeros((BM, BN), dtype=tl.float32)
+        for h in tl.static_range(G // 64):              # qmm._q8mm's 64-input halves: the same k16 mma chain
+            k0 = g * G + h * 64
+            words = tl.load(wrow + k0 // 4, mask=n_ok[:, None], other=0)
+            x = tl.load(xrow + k0, mask=m_ok[:, None], other=0.0)
+            p = tl.dot(x, tl.trans(qmm._q8_unpack(words, BN, 64)), p)
+        s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        if SK == 1:
+            acc = acc + p * s[None, :]
+        else:
+            acc = tl.where(g % PER == 0, 0.0, acc) + p * s[None, :]
+            last = g % PER == PER - 1
+            total = tl.where(last, tl.where(g < PER, acc, total + acc), total)
+    if SK == 1:
+        total = acc
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+def _out(x: torch.Tensor, n: int, out: torch.Tensor | None, f32: bool) -> torch.Tensor:
+    m = x.shape[0]
+    if out is None:
+        return torch.empty((m, n), dtype=torch.float32 if f32 else torch.bfloat16, device=x.device)
+    if out.shape != (m, n) or not out.is_contiguous():
+        raise ValueError(f"matmul_prefill: out {tuple(out.shape)} must be a contiguous ({m}, {n})")
+    if out.dtype != (torch.float32 if f32 else torch.bfloat16):
+        raise ValueError(f"matmul_prefill: out dtype {out.dtype} does not match f32={f32}")
+    return out
+
+
+def matmul_prefill(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+                   f32: bool = False, part: torch.Tensor | None = None, exact: bool = True,
+                   min_rows: int | None = None) -> torch.Tensor:
+    """``qmm.matmul`` for prefill-sized M: x (M, K) bf16 (rows may be strided, unit column stride) @ q.T ->
+    (M, N) bf16, or the unrounded fp32 sums with ``f32``. ``xs``: x's fp32 64-input group sums (Q4 only; computed
+    when None). ``part`` is only used below ``MIN_ROWS`` rows, where ``qmm.matmul`` runs (no split-K partials
+    here). ``exact``: keep qmm's K-slice summation order (qmm's bits); False sums all of K in one accumulator.
+    ``min_rows`` (patches/0085): the qmm threshold, ``MIN_ROWS`` by default (fast chunks pass 1)."""
+
+    m, k = x.shape
+    if m < (MIN_ROWS if min_rows is None else min_rows):     # decode-sized: qmm's kernels
+        return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+    if k != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_prefill: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    out = _out(x, q.n, out, f32)
+    if m == 0:
+        return out
+    if isinstance(q, Q8):                     # patches/0470
+        sk = qmm.q8_split_k(q.n, q.k) if exact else 1
+        bm, bn, warps, stages = q8_tile(exact)
+        grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+        _fq8[grid](x, q.weight.view(torch.int32), q.scales, out, m, x.stride(0), N=q.n, K=k, SK=sk, BM=bm, BN=bn,
+                   G=q.gs, F32=f32, num_warps=warps, num_stages=stages)
+        return out
+    if isinstance(q, B16):
+        if k % qmm.B16_BK:
+            raise ValueError(f"matmul_prefill: K={k} is not a multiple of {qmm.B16_BK}")
+        sk = qmm.b16_split_k(q.n, q.k) if exact else 1
+        # patches/0085: one-accumulator tiles by shape only (the row bucket never changed a bit; now it is not read)
+        bm, bn, warps, stages, _ = config(q.n, q.k, m if exact else 512, sk, tuned=False)
+        tile = getattr(q, "tile", None)          # patches/0170: GLM53_TF_KDA_BF16_TILE on the KDA copies (same bits)
+        if tile is not None and not exact:
+            bm, bn, warps, stages = tile
+        grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+        _fb16[grid](x, q.weight, out, m, x.stride(0), N=q.n, K=k, SK=sk, BM=bm, BN=bn, BK=qmm.B16_BK, F32=f32,
+                    num_warps=warps, num_stages=stages)
+        return out
+    sk = qmm.split_k(q.n, q.k) if exact else 1
+    cfg = config(q.n, q.k, m, sk, loose=not exact)
+    if cfg == USE_QMM:                   # exact, and qmm's split-K kernels are faster on this shape: the same bits
+        return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+    if xs is None:
+        xs = qmm.group_sums(x)
+    bm, bn, warps, stages, gpi = cfg
+    per = (k // GS) // sk
+    grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+    _fq4[grid](x, xs, q.weight, q.scales, q.biases, out, m, x.stride(0), N=q.n, K=k, SK=sk, BM=bm, BN=bn,
+               TN=BN_STORED, GPI=qmm.gpi_for(per, gpi), F32=f32, num_warps=warps, num_stages=stages)
+    return out
+
+
+def matmul_fast(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+                f32: bool = False, part: torch.Tensor | None = None) -> torch.Tensor:
+    """What fast-prefill chunks run behind ``qmm.matmul`` (``fastpf.chunk``): ``matmul_prefill(exact=False)``, one
+    accumulator over K (not qmm's bits; deterministic and row-independent). patches/0083: ``matmul_fp8`` while an
+    FP8 prefill runs (``fp8pf.ON``). patches/0085: any row count but the head's (``FAST_HEAD``) stays on these
+    kernels, so a row's bits never depend on the call's size."""
+
+    lo = MIN_ROWS if q is FAST_HEAD else 1
+    if fp8pf.ON:
+        return matmul_fp8(x, q, xs, out=out, f32=f32, part=part, min_rows=lo)
+    return matmul_prefill(x, q, xs, out=out, f32=f32, part=part, exact=False, min_rows=lo)
+
+
+# -- patches/0083: FP8 (e4m3) tensor-core prefill matmuls -----------------------------------------------------------
+# A row of x is scaled by its own power of two s_x, the smallest with amax / s_x <= 448 (e4m3's largest finite value),
+# and rounded to e4m3 (RTNE) by ``_fp8_rows``, which also writes the fp32 sums of each 64-input group of the ROUNDED
+# row. A power of two makes x / s_x exact (no division, no double rounding: the host model ``fp8_reference`` gets
+# the same bits) and costs nothing in precision: e4m3's relative step is the same anywhere in its normal range, the
+# row only uses at most one binade less of it (its largest value lands in (224, 448]). A 4-bit
+# weight value q in 0..15 is an exact e4m3 number (``FP8_WENC = "cvt"``: 1..15 are normal numbers), or, with
+# ``"bits"``, the nibble itself read as an e4m3 bit pattern, which is exactly q * 2^-9 (0..7 subnormal, 8..15 in the
+# first normal binade; the 2^9 goes into the scale): no conversion instruction, but it relies on the tensor cores
+# keeping e4m3 subnormals. Per 64-input group g, ``_f8q4`` computes P = x8 . q8 on the fp8 tensor cores from zero
+# (fp32 result: the group's products are exact and at most 64 are summed, so the tensor cores' accumulator width does
+# not matter), then acc += P * s[n, g] + X8[m, g] * b[n, g] in fp32, in group order, and finally y = s_x[m] * acc.
+# That is "x rounded to e4m3 per row, times the exact 4-bit weights", the bias term taken on the rounded sums so the
+# rounding error is sum((x8 - x) * w), not sum((x8 - x) * (w - b)).
+#
+# Row-independent and deterministic: a row's scale, its groups' sums and its dots never see another row; the tile
+# (FP8_TILE) is fixed for every shape and row count; no atomics. So lean sub-blocks (patches/0082) and any row
+# grouping give a row the same bits.
+FP8_MAX = 448.0
+FP8_MIN_NK = 4 * 1024 * 1024     # smaller weights (4096x128, 160x4096) stay on the bf16 kernel: the prologue dominates
+FP8_WENC = "cvt"                 # "cvt" | "bits" (see above); both exact, same bits
+# (BM, BN, warps, stages) for every Q4 / B16 shape: 128 rows share each unpacked weight group, 64 columns share each
+# e4m3 row tile. Swept on GB10 over the real shapes at 2048 and 8192 rows: 128,64,4,2 is the fastest or within 2% at
+# every shape (1.0-1.27x the bf16 fast kernel; 128,128,8,3 was 0.8-0.9x). GLM53_TF_FP8_TILE=bm,bn,warps,stages
+# overrides it (the tile never changes which fp32 operations a row sees, only which program runs them: same bits).
+FP8_TILE = (128, 64, 4, 2)
+
+
+def fp8_tile() -> tuple[int, int, int, int]:
+    import os
+
+    v = os.environ.get("GLM53_TF_FP8_TILE", "").strip()
+    if not v:
+        return FP8_TILE
+    t = tuple(int(p) for p in v.split(","))
+    if len(t) != 4 or t[0] not in (16, 32, 64, 128, 256) or t[1] not in (32, 64, 128, 256):
+        raise ValueError(f"GLM53_TF_FP8_TILE={v!r}: expected bm,bn,warps,stages (bm 16-256, bn 32-256, powers of 2)")
+    return t
+
+
+@triton.jit
+def _fp8_rows(X, x_stride, X8, SX, XS8, K: tl.constexpr, KP: tl.constexpr, KG: tl.constexpr):
+    """Program r: row r of x (bf16) -> X8[r] e4m3 (x / s_x), SX[r] = s_x (a power of two: amax / s_x in (224, 448]),
+    XS8[r, g] = fp32 sum of group g of the e4m3 values (unscaled)."""
+
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, KP)
+    ok = k < K
+    x = tl.load(X + r * x_stride + k, mask=ok, other=0.0).to(tl.float32)
+    amax = tl.max(tl.abs(x), 0)
+    # amax = 1.m * 2^E; 448 = 1.75 * 2^8: s = E - 8, or E - 7 when 1.m > 1.75 (clamped for rows of ~0 or inf)
+    bits = amax.to(tl.int32, bitcast=True)
+    e = ((bits >> 23) & 0xFF) - 127
+    sh = e - 8 + ((bits & 0x7FFFFF) > 0x600000).to(tl.int32)
+    sh = tl.minimum(tl.maximum(sh, -100), 100)
+    inv = ((127 - sh) << 23).to(tl.float32, bitcast=True)
+    sx = ((127 + sh) << 23).to(tl.float32, bitcast=True)
+    y = tl.minimum(tl.maximum(x * inv, -448.0), 448.0)
+    y8 = y.to(tl.float8e4nv)
+    tl.store(X8 + r * K + k, y8, mask=ok)
+    gs = tl.sum(tl.reshape(y8.to(tl.float32), (KP // 64, 64)), 1)
+    g = tl.arange(0, KP // 64)
+    tl.store(XS8 + r * KG + g, gs, mask=g < KG)
+    tl.store(SX + r, sx)
+
+
+def fp8_rows(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """x (M, K) bf16, unit column stride -> (x8 (M, K) e4m3, s_x (M,) fp32, group sums of x8 (M, K/64) fp32)."""
+
+    m, k = x.shape
+    if x.stride(1) != 1 or k % GS:
+        raise ValueError("fp8_rows: rows of unit column stride and a multiple of 64 wide expected")
+    x8 = torch.empty((m, k), dtype=torch.float8_e4m3fn, device=x.device)
+    sx = torch.empty((m,), dtype=torch.float32, device=x.device)
+    xs8 = torch.empty((m, k // GS), dtype=torch.float32, device=x.device)
+    if m:
+        kp = triton.next_power_of_2(k)
+        _fp8_rows[(m,)](x, x.stride(0), x8, sx, xs8, K=k, KP=kp, KG=k // GS, num_warps=8 if kp >= 4096 else 4)
+    return x8, sx, xs8
+
+
+@triton.jit
+def _f8q4(X8, SX, XS8, W, S, B, OUT, M, N: tl.constexpr, K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+          TN: tl.constexpr, F32: tl.constexpr, BITS: tl.constexpr):
+    """Program (M tile fastest, column tile): out[BM, BN] = s_x * sum over groups in order of (P s + X8 b), P the
+    group's fp8 tensor-core dot."""
+
+    KG: tl.constexpr = K // 64
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)      # grouped order (0081's ``_tile``)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    rw = tl.arange(0, 8)
+    shifts = tl.arange(0, 8) * 4
+    m_ok = rm < M
+    n_ok = rn < N
+    wrow = (rn // TN).to(tl.int64) * (KG * TN * 8) + (rn % TN) * 8
+    xrow = rm.to(tl.int64) * K
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for g in range(KG):
+        words = tl.load(W + wrow[:, None] + g * (TN * 8) + rw[None, :], mask=n_ok[:, None], other=0)
+        q = tl.reshape((words[:, :, None] >> shifts[None, None, :]) & 0xF, (BN, 64))
+        if BITS:
+            q8 = q.to(tl.int8).to(tl.float8e4nv, bitcast=True)          # q * 2^-9, exactly
+        else:
+            q8 = q.to(tl.float16).to(tl.float8e4nv)                     # q, exactly
+        x8 = tl.load(X8 + xrow[:, None] + (g * 64 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        p = tl.dot(x8, tl.trans(q8))
+        s = tl.load(S + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        if BITS:
+            s = s * 512.0
+        b = tl.load(B + g * N + rn, mask=n_ok, other=0.0).to(tl.float32)
+        xs = tl.load(XS8 + rm * KG + g, mask=m_ok, other=0.0)
+        acc = acc + p * s[None, :] + xs[:, None] * b[None, :]
+    sx = tl.load(SX + rm, mask=m_ok, other=0.0)
+    total = acc * sx[:, None]
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+@triton.jit
+def _f8b16(X8, SX, W, WINV, WS, OUT, M, N: tl.constexpr, K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+           F32: tl.constexpr):
+    """BF16 weights: each 64-input step rounds the weight tile to e4m3 with its row's scale (WINV = 448 / amax),
+    one fp8 dot from zero, added in fp32 in K order; out = s_x * s_w * acc."""
+
+    pid_m, pid_n = _tile(tl.program_id(0), M, N, BM, BN, GROUP_M)      # grouped order (0081's ``_tile``)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, 64)
+    m_ok = rm < M
+    n_ok = rn < N
+    winv = tl.load(WINV + rn, mask=n_ok, other=0.0)
+    xrow = rm.to(tl.int64) * K
+    wrow = rn.to(tl.int64) * K
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for k0 in range(0, K, 64):
+        x8 = tl.load(X8 + xrow[:, None] + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        w = tl.load(W + wrow[:, None] + (k0 + rk)[None, :], mask=n_ok[:, None], other=0.0).to(tl.float32)
+        w8 = tl.minimum(tl.maximum(w * winv[:, None], -448.0), 448.0).to(tl.float8e4nv)
+        acc = acc + tl.dot(x8, tl.trans(w8))
+    sx = tl.load(SX + rm, mask=m_ok, other=0.0)
+    ws = tl.load(WS + rn, mask=n_ok, other=0.0)
+    total = acc * sx[:, None] * ws[None, :]
+    out_mask = m_ok[:, None] & n_ok[None, :]
+    optr = OUT + rm[:, None].to(tl.int64) * N + rn[None, :]
+    if F32:
+        tl.store(optr, total, mask=out_mask)
+    else:
+        tl.store(optr, total.to(tl.bfloat16), mask=out_mask)
+
+
+def b16_fp8_scales(q: B16) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-output-channel e4m3 scales of a BF16 weight (s_w = amax / 448, and 448 / amax; 0 for an all-zero row),
+    computed once and kept on the matrix (the same weights always give the same scales)."""
+
+    got = q.__dict__.get("_fp8_scales")
+    if got is None:
+        amax = q.weight.float().abs().amax(dim=1)
+        ws = (amax / FP8_MAX).contiguous()
+        winv = torch.where(amax > 0, FP8_MAX / amax, torch.zeros_like(amax)).contiguous()
+        got = (winv, ws)
+        q.__dict__["_fp8_scales"] = got
+    return got
+
+
+def fp8_eligible(m: int, q: Q4 | B16, min_rows: int | None = None) -> bool:
+    """The shapes and row counts ``matmul_fp8`` runs in fp8 (the rest go to ``matmul_prefill(exact=False)``)."""
+
+    return m >= max(1, MIN_ROWS if min_rows is None else min_rows) and q.n * q.k >= FP8_MIN_NK and q.k % GS == 0
+
+
+def matmul_fp8(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+               f32: bool = False, part: torch.Tensor | None = None, min_rows: int | None = None) -> torch.Tensor:
+    """``qmm.matmul``'s contract on FP8 tensor cores (patches/0083): x (M, K) bf16 (rows may be strided) @ q.T with
+    x rounded to e4m3 per row. ``xs`` is not used (the kernel needs the sums of the rounded rows). Shapes below
+    ``FP8_MIN_NK`` weights and calls below ``MIN_ROWS`` rows run ``matmul_prefill(exact=False)`` (the bf16 fast
+    kernel; qmm below 64 rows) instead. Deterministic and row-independent; not the bf16 kernels' bits."""
+
+    m, k = x.shape
+    # patches/0470: 8-bit weights are not e4m3 numbers; an FP8 prefill runs them on the bf16 fast kernel
+    if isinstance(q, Q8) or not fp8_eligible(m, q, min_rows):     # patches/0085: ``min_rows`` as matmul_prefill
+        return matmul_prefill(x, q, xs, out=out, f32=f32, part=part, exact=False, min_rows=min_rows)
+    if k != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_fp8: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    out = _out(x, q.n, out, f32)
+    x8, sx, xs8 = fp8_rows(x)
+    bm, bn, warps, stages = fp8_tile()
+    grid = (triton.cdiv(m, bm) * triton.cdiv(q.n, bn),)
+    if isinstance(q, B16):
+        winv, ws = b16_fp8_scales(q)
+        _f8b16[grid](x8, sx, q.weight, winv, ws, out, m, N=q.n, K=k, BM=bm, BN=bn, F32=f32, num_warps=warps,
+                     num_stages=stages)
+        return out
+    _f8q4[grid](x8, sx, xs8, q.weight, q.scales, q.biases, out, m, N=q.n, K=k, BM=bm, BN=bn, TN=BN_STORED, F32=f32,
+                BITS=FP8_WENC == "bits", num_warps=warps, num_stages=stages)
+    return out
+
+
+def fp8_row_values(xf: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Host model of ``_fp8_rows``: (the e4m3 values of x / s_x as fp32, s_x [M, 1])."""
+
+    bits = xf.abs().amax(dim=1, keepdim=True).view(torch.int32)
+    sh = ((bits >> 23) & 0xFF) - 127 - 8 + ((bits & 0x7FFFFF) > 0x600000).to(torch.int32)
+    sh = sh.clamp(-100, 100)
+    inv = ((127 - sh) << 23).view(torch.float32)
+    sx = ((127 + sh) << 23).view(torch.float32)
+    return (xf * inv).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn).float(), sx
+
+
+def fp8_reference(x: torch.Tensor, q: Q4 | B16) -> torch.Tensor:
+    """Host-side model of ``matmul_fp8`` for tests (torch, fp32; RTNE e4m3 rounding as on the GPU): x rounded to e4m3
+    per row with ``_fp8_rows``' power-of-two scale (the same e4m3 values), times the exact 4-bit weights (BF16: the
+    weights rounded to e4m3 per output channel)."""
+
+    xf = x.float()
+    x8, sx = fp8_row_values(xf)
+    x8 = x8 * sx
+    if isinstance(q, Q8):                     # patches/0470: ``matmul_fp8`` runs them in bf16 (not a model of that)
+        raise TypeError("fp8_reference: 8-bit weights never run on the FP8 kernel")
+    if isinstance(q, B16):
+        winv, ws = b16_fp8_scales(q)
+        w8 = (q.weight.float() * winv[:, None]).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn).float() * ws[:, None]
+        return x8 @ w8.T
+    return x8 @ qmm.dequantize_q4(q).T
+
+
+def matmul(x: torch.Tensor, q: Q4 | B16, xs: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+           f32: bool = False, part: torch.Tensor | None = None, min_rows: int = 256) -> torch.Tensor:
+    """Dispatch helper for callers: ``matmul_prefill`` from ``min_rows`` rows up, ``qmm.matmul`` below (the decode
+    kernels are tuned for 1-16 rows)."""
+
+    if x.shape[0] >= min_rows:
+        return matmul_prefill(x, q, xs, out=out, f32=f32, part=part)
+    return qmm.matmul(x, q, xs, out=out, f32=f32, part=part)
+
+
+# -- hyper-connection mixing dots for fast chunks ------------------------------------------------------------------
+@triton.jit
+def _hc_partial_mm(X, FN, PART, R, WIDE: tl.constexpr, NB: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr):
+    """Program (row tile, K block b): ``glue._hc_partial``'s outputs for BM rows -- PART[r, b, 0:24] the dots of
+    the flattened streams with fn over K block b, PART[r, b, 24] the sum of squares -- with fn read once per BM
+    rows (bf16 tensor-core dots, fp32 sums; the per-row kernel re-reads fn's 786 KB from L2 for every row)."""
+
+    pid = tl.program_id(0)
+    b = tl.program_id(1)
+    KB: tl.constexpr = WIDE // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BM, 32), dtype=tl.float32)
+    ss = tl.zeros((BM,), dtype=tl.float32)
+    for t in range(KB // BK):
+        base = b * KB + t * BK
+        x = tl.load(X + rr[:, None] * WIDE + base + k[None, :], mask=ok[:, None], other=0.0)
+        w = tl.load(FN + m[:, None] * WIDE + base + k[None, :], mask=m[:, None] < 24, other=0.0)
+        acc = tl.dot(x, tl.trans(w), acc)
+        xf = x.to(tl.float32)
+        ss += tl.sum(xf * xf, axis=1)
+    pp = PART + (rr[:, None] * NB + b) * 32 + m[None, :]
+    tl.store(pp, acc, mask=ok[:, None] & (m[None, :] < 24))
+    tl.store(PART + (rr * NB + b) * 32 + 24, ss, mask=ok)
+
+
+def hc_partial(x: torch.Tensor, fn: torch.Tensor, part: torch.Tensor, nb: int) -> None:
+    """``glue._hc_partial`` for a fast-prefill chunk: x [R, S*D] bf16 streams, fn [24, S*D] bf16 -> part [R, nb, 32]
+    fp32 (24 dots, then the sum of squares). Row-independent and deterministic (fixed K order), not its bits."""
+
+    rows, wide = x.shape
+    if x.stride(1) != 1 or x.stride(0) != wide or not fn.is_contiguous() or wide % (nb * 64):
+        raise ValueError("hc_partial: contiguous [R, S*D] streams and fn, S*D a multiple of 64 * nb expected")
+    bm = 64
+    _hc_partial_mm[(triton.cdiv(rows, bm), nb)](x, fn, part, rows, WIDE=wide, NB=nb, BM=bm, BK=64, num_warps=4,
+                                                 num_stages=3)
+
+
+def flops(m: int, n: int, k: int) -> float:
+    return 2.0 * m * n * k
