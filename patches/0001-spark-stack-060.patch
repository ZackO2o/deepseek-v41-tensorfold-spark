--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/sparse.py
@@ -0,0 +1,704 @@
+"""DSA's sparse top-k attention for GLM-5.3-Flash contexts past 2051 tokens (the Hugging Face definition).
+
+Each DSA layer's indexer keeps, per token, a key k = LayerNorm(wk x) and a pool gate g = x . compress_gate (both
+bf16, 128 wide). Every 4 tokens form a pool with key bf16(sum_j bf16(bf16(softmax_j(g_j + ape_j)) * k_j)).
+A query row at position q with index query qi = wq_b(q_resid) (32 heads of 128) and head weights
+w = weights_proj(x) / sqrt(32) scores each complete pool ending at or before q:
+
+    s_p = sum_h w_h * relu(qi_h . pool_p / sqrt(128))        (bf16 inputs, fp32 products and sums)
+
+keeps the 512 best pools (ties to the lower pool), adds the visible tokens of the incomplete last pool, and
+attends to those tokens only. While a row has at most 512 complete pools (q < 2051) it keeps them all, which is
+dense causal attention (``attention.attention``). A row's selection and its attention depend only on that row,
+so a window row gets the bits of the serial step at its position. Attention visits the selected tokens in
+ascending position, 512 at a time, and merges the chunks in order.
+
+patches/0290 (GLM53_TF_KV_POOL_TOKENS, ``kvpool``): the index keys / gates of a full-capacity index cache (the MTP
+head's) and every pool-key cache may be ``kvpool.Paged`` views of the shared pool; the kernels below map a logical
+row (a position, or a pool index) to its physical row through the slot's page table (``_prow``: PT / PSH, pruned when
+PSH = 0) under the same masks. Same values, other addresses: the same bits.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import kvpool
+
+POOL = 4
+TOPK_POOLS = 512
+BR = 16
+
+# patches/0065, GLM53_TF_INDEX_RING (default 1): the model layers' index keys and gates live in a ring of
+# ``index_ring_rows(rows)`` rows once the capacity exceeds it (``forward.State._index_ring``); 0 keeps them full
+INDEX_RING = os.environ.get("GLM53_TF_INDEX_RING", "1").strip() != "0"
+
+
+@triton.jit
+def _prow(rows, PT, PSH: tl.constexpr, ok):
+    """patches/0290: ``latent._prow`` (logical rows -> physical rows through a page table; PSH 0: unchanged)."""
+
+    if PSH > 0:
+        if ok is None:                                    # a scalar row (writers): always mapped
+            pg = tl.load(PT + (rows >> PSH)).to(tl.int64)
+        else:
+            pg = tl.load(PT + (rows >> PSH), mask=ok, other=0).to(tl.int64)
+        rows = (pg << PSH) + (rows & ((1 << PSH) - 1))
+    return rows
+
+
+def index_ring_rows(rows: int) -> int:
+    """Ring rows for windows of up to ``rows`` rows: a power of two >= rows + 64 (a window and the 3 rows of its
+    first incomplete pool fit with room to spare)."""
+
+    return max(256, triton.next_power_of_2(rows + 64))
+
+
+@triton.jit
+def _index_write(KR, k_stride, GR, LNW, LNB, IK, IG, POS, NR, eps, D: tl.constexpr, PT=None, PSH: tl.constexpr = 0):
+    """Row r: LayerNorm(k_raw) -> bf16 into IK[pos + r]; the gate row (fp32) -> bf16 into IG[pos + r].
+    patches/0065: rows live at (position mod NR), NR the caches' rows (the capacity, or a ring)."""
+
+    r = tl.program_id(0)
+    P = tl.load(POS).to(tl.int64)
+    d = tl.arange(0, D)
+    x = tl.load(KR + r * k_stride + d).to(tl.float32)
+    mean = tl.sum(x, axis=0) / D
+    xc = x - mean
+    var = tl.sum(xc * xc, axis=0) / D
+    y = xc / tl.sqrt(var + eps) * tl.load(LNW + d).to(tl.float32) + tl.load(LNB + d).to(tl.float32)
+    slot = _prow((P + r) % NR, PT, PSH, None)                 # patches/0290: a paged (full) cache's physical row
+    tl.store(IK + slot * D + d, y.to(tl.bfloat16))
+    tl.store(IG + slot * D + d, tl.load(GR + r * D + d).to(tl.bfloat16))
+
+
+@triton.jit
+def _pool_keys(IK, IG, APE, PK, POS, R, NR, D: tl.constexpr, PTI=None, PSHI: tl.constexpr = 0, PTP=None,
+               PSHP: tl.constexpr = 0):
+    """Program i: pool p = pos // 4 + i if it is complete within the window (ends at or before pos + R - 1).
+    patches/0065: the pool's rows at (position mod NR). patches/0290: keys / gates and the pool key through their page
+    tables (PTI / PSHI for a paged key cache, PTP / PSHP for the paged pool keys; 0: contiguous)."""
+
+    i = tl.program_id(0)
+    P = tl.load(POS).to(tl.int64)
+    p = P // 4 + i
+    if 4 * p + 3 > P + R - 1:
+        return
+    d = tl.arange(0, D)
+    s0 = _prow((4 * p + 0) % NR, PTI, PSHI, None)
+    s1 = _prow((4 * p + 1) % NR, PTI, PSHI, None)
+    s2 = _prow((4 * p + 2) % NR, PTI, PSHI, None)
+    s3 = _prow((4 * p + 3) % NR, PTI, PSHI, None)
+    l0 = tl.load(IG + s0 * D + d).to(tl.float32) + tl.load(APE + 0 * D + d).to(tl.float32)
+    l1 = tl.load(IG + s1 * D + d).to(tl.float32) + tl.load(APE + 1 * D + d).to(tl.float32)
+    l2 = tl.load(IG + s2 * D + d).to(tl.float32) + tl.load(APE + 2 * D + d).to(tl.float32)
+    l3 = tl.load(IG + s3 * D + d).to(tl.float32) + tl.load(APE + 3 * D + d).to(tl.float32)
+    m = tl.maximum(tl.maximum(l0, l1), tl.maximum(l2, l3))
+    e0 = tl.exp(l0 - m)
+    e1 = tl.exp(l1 - m)
+    e2 = tl.exp(l2 - m)
+    e3 = tl.exp(l3 - m)
+    s = ((e0 + e1) + e2) + e3
+    k0 = tl.load(IK + s0 * D + d).to(tl.float32)
+    k1 = tl.load(IK + s1 * D + d).to(tl.float32)
+    k2 = tl.load(IK + s2 * D + d).to(tl.float32)
+    k3 = tl.load(IK + s3 * D + d).to(tl.float32)
+    t0 = ((e0 / s).to(tl.bfloat16).to(tl.float32) * k0).to(tl.bfloat16).to(tl.float32)
+    t1 = ((e1 / s).to(tl.bfloat16).to(tl.float32) * k1).to(tl.bfloat16).to(tl.float32)
+    t2 = ((e2 / s).to(tl.bfloat16).to(tl.float32) * k2).to(tl.bfloat16).to(tl.float32)
+    t3 = ((e3 / s).to(tl.bfloat16).to(tl.float32) * k3).to(tl.bfloat16).to(tl.float32)
+    tl.store(PK + _prow(p, PTP, PSHP, None) * D + d, (((t0 + t1) + t2) + t3).to(tl.bfloat16))
+
+
+def index_update(k_raw: torch.Tensor, gate: torch.Tensor, ln_w: torch.Tensor, ln_b: torch.Tensor, ape: torch.Tensor,
+                 ik: torch.Tensor, ig: torch.Tensor, pk: torch.Tensor, pos: torch.Tensor) -> None:
+    """Window rows' index keys and gates into the caches at pos.., then every pool the window completes.
+    patches/0065: ``ik``/``ig`` may be rings (``State.index_ring``): rows at position mod their row count. A pool
+    reads its rows only when the window completes it, so a ring keeps the window's rows and the 3 before it."""
+
+    R = k_raw.shape[0]
+    NR = ik.shape[0]
+    if ig.shape[0] != NR or R + POOL - 1 > NR:
+        raise ValueError(f"index_update: a {R}-row window in index caches of {NR} / {ig.shape[0]} rows")
+    if kvpool.is_paged(ik) != kvpool.is_paged(ig):
+        raise ValueError("index_update: keys and gates must both be paged or both contiguous")
+    ikt, pti, pshi = kvpool.kernel_args(ik)                   # patches/0290 (keys and gates share the slot's table)
+    igt, _, _ = kvpool.kernel_args(ig)
+    pkt, ptp, pshp = kvpool.kernel_args(pk)
+    _index_write[(R,)](k_raw, k_raw.stride(0), gate, ln_w, ln_b, ikt, igt, pos, NR, 1e-6, D=128, num_warps=1,
+                       PT=pti, PSH=pshi)
+    _pool_keys[(R // 4 + 2,)](ikt, igt, ape, pkt, pos, R, NR, D=128, num_warps=1, PTI=pti, PSHI=pshi, PTP=ptp,
+                              PSHP=pshp)
+
+
+@triton.jit
+def _scores(QI, W, w_stride, PK, OUT, POS, R, NP, scale, H: tl.constexpr, D: tl.constexpr, BP: tl.constexpr,
+            NH: tl.constexpr = 32, WS: tl.constexpr = 1.0 / 5.656854249492381, PT=None, PSH: tl.constexpr = 0):
+    """Program (r, pool block): s_p = sum_h w_h relu(scale * qi_h . pool_p) for pools p ending at or before
+    pos + r (-inf after). patches/0050: ``NH`` the indexer's heads (rows of NH x D), ``H`` >= NH the tile's
+    (padded to 16 for tl.dot; the padded heads load 0 and weigh 0), ``WS`` = NH ** -0.5. GLM-5.3 (NH = H = 32)
+    runs upstream's code, the same bits. Upstream hard-coded 32 heads, so a checkpoint with fewer (the synthetic
+    test one) read past each row: other rows' and stale buffer values, which made a row's selection depend on
+    its window and on earlier steps, and out of bounds on long prefill chunks."""
+
+    r = tl.program_id(0)
+    pb = tl.program_id(1)
+    P = tl.load(POS)
+    npool = (P + r + 1) // 4
+    p = pb * BP + tl.arange(0, BP)
+    d = tl.arange(0, D)
+    hh = tl.arange(0, H)
+    if NH == 32:                                                                      # GLM-5.3: upstream's code
+        q = tl.load(QI + (r * H + hh[:, None]) * D + d[None, :]).to(tl.bfloat16)       # [H, D]
+        w = tl.load(W + r * w_stride + hh).to(tl.float32) * (1.0 / 5.656854249492381)  # 32 ** -0.5
+    else:
+        hm = hh < NH
+        q = tl.load(QI + (r * NH + hh[:, None]) * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.bfloat16)
+        w = tl.load(W + r * w_stride + hh, mask=hm, other=0.0).to(tl.float32) * WS
+    pr = _prow(p, PT, PSH, p < npool)                               # patches/0290 (PSH 0: pr is p)
+    k = tl.load(PK + pr[:, None] * D + d[None, :], mask=(p < npool)[:, None], other=0.0).to(tl.bfloat16)  # [BP, D]
+    dots = tl.dot(q, tl.trans(k))                                                     # [H, BP] fp32
+    s = tl.sum(w[:, None] * tl.maximum(dots * scale, 0.0), axis=0)
+    s = tl.where(p < npool, s, float("-inf"))
+    tl.store(OUT + r * NP + p, s, mask=p < NP)
+
+
+_SCORES = _scores
+
+
+def _pk_paging(pt, psh: int) -> dict:
+    """patches/0290: the page-table kwargs of a scoring kernel; none for a contiguous pool-key cache (so a test's
+    stand-in for ``_scores`` with upstream's signature still runs)."""
+
+    return dict(PT=pt, PSH=psh) if pt is not None else {}
+
+
+def _heads(qi: torch.Tensor, wts: torch.Tensor) -> dict:
+    """patches/0050: ``_scores``' head arguments from the tensors (qi [R, NH x D], wts [R, NH])."""
+
+    nh = wts.shape[1]
+    d = qi.shape[1] // nh
+    if nh * d != qi.shape[1] or d != 128:
+        raise ValueError(f"select_tokens: index queries of {qi.shape[1]} for {nh} heads (128 wide expected)")
+    return dict(H=max(16, triton.next_power_of_2(nh)), D=d, NH=nh, WS=1.0 / math.sqrt(nh))
+
+
+def select_tokens(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, pos: int, R: int, np_max: int,
+                  pos_dev: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Each row's attended tokens: [R, 2051] int32 ascending (-1 padded) and how many, for rows past 2050.
+
+    patches/0065: windows of more than ``SMALL_ROWS`` rows (prefill chunks) select through ``select_pools_blocked``
+    (the same set, bounded scratch, no full sort); decode/verify/MTP windows keep the path below."""
+
+    if qi.stride(0) != qi.shape[1] or wts.stride(1) != 1:
+        raise ValueError("select_tokens: index queries must be contiguous rows, weights unit-stride columns")
+    # (a test's stand-in for ``_scores`` keeps the path it stands in for)
+    if R > SMALL_ROWS and SELECT == "blocked" and _scores is _SCORES and blocked_ok(qi.device, wts.shape[1]):
+        pools = select_pools_blocked(qi, wts, pk, pos, R, np_max, pos_dev)
+        return _tokens(pools, pos, R, qi.device)
+    scores = torch.empty((R, np_max), dtype=torch.float32, device=qi.device)
+    pkt, pt, psh = kvpool.kernel_args(pk)                                              # patches/0290
+    _scores[(R, triton.cdiv(np_max, 64))](qi, wts, wts.stride(0), pkt, scores, pos_dev, R, np_max, 128 ** -0.5,
+                                         BP=64, num_warps=4, **_heads(qi, wts), **_pk_paging(pt, psh))
+    order = torch.sort(scores, dim=1, descending=True, stable=True).indices[:, :TOPK_POOLS]
+    pools = torch.sort(order, dim=1).values                                            # ascending pool index
+    return _tokens(pools, pos, R, qi.device)
+
+
+def _tokens(pools: torch.Tensor, pos: int, R: int, dev) -> tuple[torch.Tensor, torch.Tensor]:
+    """Rows' ascending selected pools [R, 512] -> (tokens [R, 2051] int32, counts [R] int32)."""
+
+    # every row at once (the same lists a per-row loop builds): the selected pools' tokens in ascending order, then
+    # the visible tokens of the incomplete last pool; a dense row (at most TOPK_POOLS complete pools) gets count 0
+    q = pos + torch.arange(R, device=dev, dtype=torch.int64)                         # [R] absolute positions
+    npool = (q + 1) // POOL
+    sparse_row = npool > TOPK_POOLS
+    body = (pools.to(torch.int64)[:, :, None] * POOL + torch.arange(POOL, device=dev)).reshape(R, -1)
+    lane = torch.arange(POOL - 1, device=dev)
+    tail = npool[:, None] * POOL + lane                                              # [R, POOL - 1]
+    tail_len = q + 1 - npool * POOL                                                  # 0 .. POOL - 1
+    tail = torch.where(lane[None, :] < tail_len[:, None], tail, torch.full_like(tail, -1))
+    tokens = torch.cat([body, tail], dim=1).to(torch.int32)
+    tokens = torch.where(sparse_row[:, None], tokens, torch.full_like(tokens, -1))
+    counts = torch.where(sparse_row, TOPK_POOLS * POOL + tail_len, torch.zeros_like(tail_len)).to(torch.int32)
+    return tokens.contiguous(), counts
+
+
+# -- patches/0050: long-context decode (bounded scoring, a capturable selection) --------------------------------
+#
+# Scoring only the pools that can exist changes nothing: a row at position q sees npool = (q + 1) // 4 complete
+# pools and ``_scores`` gives every later pool -inf, so the pools past ``np`` >= max npool are -inf entries with
+# higher indices than every kept one. They rank after every kept pool in the stable descending order (score, then
+# lower index), and a row with more than 512 pools never reaches them: its top 512 (and so its tokens) are the
+# same. ``pool_bucket`` rounds that bound up to a power of two (at least 1024 pools, at most the capacity's), so a
+# CUDA graph captured for a bucket serves every position in it.
+
+MIN_BUCKET = 1024
+
+
+def pool_bucket(end: int, cap_pools: int) -> int:
+    """Pools to score for rows ending at position ``end - 1`` (max npool = end // 4): a power of two >= 1024,
+    capped at the cache's ``cap_pools``."""
+
+    need = end // POOL
+    if need > cap_pools:
+        raise ValueError(f"pool_bucket: {need} pools past the cache's {cap_pools}")
+    b = MIN_BUCKET
+    while b < need:
+        b *= 2
+    return min(b, cap_pools)
+
+
+@triton.jit
+def _keys(S, K, NP, BLOCK: tl.constexpr):
+    """Program (r, block): a unique int64 key per score, ordered as the stable descending sort orders them:
+    (score, then the lower pool) -> larger key. -0.0 ranks as +0.0 (they compare equal) and NaN above +inf."""
+
+    r = tl.program_id(0).to(tl.int64)
+    p = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    ok = p < NP
+    s = tl.load(S + r * NP + p, mask=ok, other=float("-inf"))
+    b = s.to(tl.int32, bitcast=True)
+    b = tl.where(s == 0.0, 0, b)
+    b = tl.where(s != s, 0x7FC00000, b)
+    b = tl.where(b < 0, b ^ 0x7FFFFFFF, b)            # sign-magnitude -> two's-complement order
+    key = (b.to(tl.int64) << 32) + (0x7FFFFFFF - p).to(tl.int64)
+    tl.store(K + r * NP + p, key, mask=ok)
+
+
+@triton.jit
+def _expand(POOLS, TOK, CNT, POS, W: tl.constexpr, K: tl.constexpr, PL: tl.constexpr):
+    """Program r: the row's tokens from its ascending pools and its position (read on the device), as
+    ``select_tokens`` lists them: 4 tokens a pool, then the visible tokens of the incomplete last pool, -1 after;
+    a dense row (at most K complete pools) gets count 0 and no tokens."""
+
+    r = tl.program_id(0)
+    q = tl.load(POS) + r
+    npool = (q + 1) // PL
+    sp = npool > K
+    j = tl.arange(0, K * PL)
+    pool = tl.load(POOLS + r * K + j // PL).to(tl.int32)
+    tok = tl.where(sp, pool * PL + j % PL, -1)
+    tl.store(TOK + r * W + j, tok)
+    lane = tl.arange(0, PL)
+    tail_len = q + 1 - npool * PL
+    tail = tl.where(sp & (lane < tail_len), npool * PL + lane, -1)
+    tl.store(TOK + r * W + K * PL + lane, tail, mask=lane < PL - 1)
+    tl.store(CNT + r, tl.where(sp, K * PL + tail_len, 0))
+
+
+class LongScratch:
+    """Preallocated buffers of the capturable selection and sparse attention for windows of up to ``rows`` rows
+    and a cache of ``capacity`` tokens (scores and keys for every pool the cache holds)."""
+
+    def __init__(self, rows: int, capacity: int, heads: int, dim: int, device) -> None:
+        self.rows = rows
+        self.cap_pools = capacity // POOL
+        n = rows * self.cap_pools
+        width = TOPK_POOLS * POOL + POOL - 1
+        self.scores = torch.empty((n,), dtype=torch.float32, device=device)
+        self.keys = torch.empty((n,), dtype=torch.int64, device=device)
+        self.top_v = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.top_i = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.pools = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.perm = torch.empty((rows, TOPK_POOLS), dtype=torch.int64, device=device)
+        self.tokens = torch.empty((rows, width), dtype=torch.int32, device=device)
+        self.counts = torch.empty((rows,), dtype=torch.int32, device=device)
+        nch = triton.cdiv(width, 512)
+        self.po = torch.empty((nch * rows * heads * dim,), dtype=torch.float32, device=device)
+        self.pm = torch.empty((nch * rows * heads,), dtype=torch.float32, device=device)
+        self.pl = torch.empty((nch * rows * heads,), dtype=torch.float32, device=device)
+
+    def part(self, R: int, H: int, D: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        nch = triton.cdiv(self.tokens.shape[1], 512)
+        return self.po[:nch * R * H * D], self.pm[:nch * R * H], self.pl[:nch * R * H]
+
+
+def select_tokens_dev(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, pos_dev: torch.Tensor, R: int,
+                      np_: int, sc: LongScratch) -> tuple[torch.Tensor, torch.Tensor]:
+    """``select_tokens`` with the position read on the device, scoring ``np_`` pools (>= every row's npool and
+    >= 512), into ``sc``'s buffers: no host value, allocation or sync, so a CUDA graph can hold it. The same
+    scores (the same kernel), and the same top 512: keys are unique and ordered as the stable descending sort
+    orders the scores, so ``torch.topk`` over them returns exactly that set, whatever its algorithm and order;
+    the set is then sorted ascending, as ``select_tokens`` lists it."""
+
+    if R > sc.rows or not TOPK_POOLS <= np_ <= sc.cap_pools:
+        raise ValueError(f"select_tokens_dev: {R} rows / {np_} pools outside the scratch ({sc.rows} / {sc.cap_pools})")
+    if qi.stride(0) != qi.shape[1] or wts.stride(1) != 1:
+        raise ValueError("select_tokens: index queries must be contiguous rows, weights unit-stride columns")
+    scores = sc.scores[:R * np_].view(R, np_)
+    pkt, pt, psh = kvpool.kernel_args(pk)                                              # patches/0290
+    _scores[(R, triton.cdiv(np_, 64))](qi, wts, wts.stride(0), pkt, scores, pos_dev, R, np_, 128 ** -0.5, BP=64,
+                                      num_warps=4, **_heads(qi, wts), **_pk_paging(pt, psh))
+    keys = sc.keys[:R * np_].view(R, np_)
+    _keys[(R, triton.cdiv(np_, 1024))](scores, keys, np_, BLOCK=1024, num_warps=4)
+    torch.topk(keys, TOPK_POOLS, dim=1, largest=True, sorted=False, out=(sc.top_v[:R], sc.top_i[:R]))
+    torch.sort(sc.top_i[:R], dim=1, out=(sc.pools[:R], sc.perm[:R]))
+    tokens, counts = sc.tokens[:R], sc.counts[:R]
+    _expand[(R,)](sc.pools, tokens, counts, pos_dev, W=tokens.shape[1], K=TOPK_POOLS, PL=POOL, num_warps=4)
+    return tokens, counts
+
+
+# -- patches/0065: prefill selection in row blocks (bounded scratch, tile-shared scoring, no full sort) ------------
+#
+# Upstream scores every row against ``np_max`` pools into an [R, np_max] fp32 buffer and stable-sorts all of it
+# (values, int64 indices and the sort's own buffers: ~36 bytes an entry, 9.7 GB at R = 1024 rows and a 1M-token
+# cache, kept by the caching allocator afterwards). ``select_pools_blocked`` gives every row the same 512 pools:
+#
+# - rows go in blocks of at most ``SELECT_MB`` of scratch, and each block scores only up to its last row's complete
+#   pools (rounded up to 64, at least 512): the pools cut off are -inf with higher indices than every kept pool,
+#   so they rank after all of them (the argument of ``pool_bucket`` above, per block);
+# - ``_scores_rows`` runs ``_scores``' per-row arithmetic unchanged (the same [heads, 128] x [128, 64] tensor-core
+#   dot, the same epilogue and head sum, on the same shapes and warps) for ``BRB`` rows a program, loading each
+#   64-pool tile once for all of them instead of once a row. Each dot output depends only on its own query row
+#   and pool, and the head sum only on its own column, so every score has ``_scores``' bits; ``blocked_ok`` checks
+#   that on the device once (bit for bit, else the sort path is used). The score leaves as the 0050 key's upper
+#   half: an int32 ordered as the stable descending sort orders floats (-0.0 == +0.0, NaN above +inf);
+# - the 512th largest key t of a row (``torch.topk`` over the int32 keys: its value is exact whatever its
+#   algorithm), then ``_gather_sel`` lists, in pool order, every pool with key > t and the lowest-index pools with
+#   key == t until 512: exactly the first 512 of the stable descending sort, already ascending.
+
+SMALL_ROWS = 8           # windows up to this many rows (decode, verify, MTP) keep the sorted path
+BRB = 16                 # rows a scoring program serves with one pool tile
+SELECT = os.environ.get("GLM53_TF_SELECT", "blocked").strip() or "blocked"
+if SELECT not in ("blocked", "sort"):
+    raise ValueError(f"GLM53_TF_SELECT must be blocked or sort, not {SELECT!r}")
+SELECT_MB = int(os.environ.get("GLM53_TF_SELECT_MB", "256") or 256)
+_KEY_NONE = -2147483648  # below every score's key (-inf maps to -2139095041)
+
+
+@triton.jit
+def _score_key(s):
+    """fp32 score -> int32 ordered as the stable descending sort orders scores (``_keys``' upper half)."""
+
+    b = s.to(tl.int32, bitcast=True)
+    b = tl.where(s == 0.0, 0, b)
+    b = tl.where(s != s, 0x7FC00000, b)
+    return tl.where(b < 0, b ^ 0x7FFFFFFF, b)
+
+
+@triton.jit
+def _scores_rows(QI, W, w_stride, PK, OUT, POS, R, NP, row0, scale, H: tl.constexpr, D: tl.constexpr,
+                 BP: tl.constexpr, BRB: tl.constexpr, NH: tl.constexpr = 32,
+                 WS: tl.constexpr = 1.0 / 5.656854249492381, KEYS: tl.constexpr = True, PT=None,
+                 PSH: tl.constexpr = 0):
+    """Program (row block, pool block): rows row0 + rb BRB .. (< R) of the window, each exactly as ``_scores``
+    program (r, pb) computes it, against one pool tile loaded for all of them; row r's result goes to row
+    r - row0 of OUT [*, NP] (int32 keys, or with KEYS=False the fp32 scores, for the check)."""
+
+    rb = tl.program_id(0)
+    pb = tl.program_id(1)
+    P = tl.load(POS)
+    p = pb * BP + tl.arange(0, BP)
+    d = tl.arange(0, D)
+    hh = tl.arange(0, H)
+    r_first = row0 + rb * BRB
+    r_last = tl.minimum(r_first + BRB, R) - 1
+    nmax = (P + r_last + 1) // 4
+    # pools past a row's own count score -inf below, so loading up to the block's last row changes no kept score
+    pr = _prow(p, PT, PSH, p < nmax)                                # patches/0290 (PSH 0: pr is p)
+    k = tl.load(PK + pr[:, None] * D + d[None, :], mask=(p < nmax)[:, None], other=0.0).to(tl.bfloat16)  # [BP, D]
+    for i in range(BRB):
+        r = r_first + i
+        if r < R:
+            npool = (P + r + 1) // 4
+            if NH == 32:                                                              # GLM-5.3: _scores' code
+                q = tl.load(QI + (r * H + hh[:, None]) * D + d[None, :]).to(tl.bfloat16)
+                w = tl.load(W + r * w_stride + hh).to(tl.float32) * (1.0 / 5.656854249492381)
+            else:
+                hm = hh < NH
+                q = tl.load(QI + (r * NH + hh[:, None]) * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.bfloat16)
+                w = tl.load(W + r * w_stride + hh, mask=hm, other=0.0).to(tl.float32) * WS
+            dots = tl.dot(q, tl.trans(k))                                             # [H, BP] fp32
+            s = tl.sum(w[:, None] * tl.maximum(dots * scale, 0.0), axis=0)
+            s = tl.where(p < npool, s, float("-inf"))
+            dst = OUT + (r - row0).to(tl.int64) * NP + p
+            if KEYS:
+                tl.store(dst, _score_key(s), mask=p < NP)
+            else:
+                tl.store(dst, s, mask=p < NP)
+
+
+@triton.jit
+def _gather_sel(KEYS, T, NEED, OUT, NP, K: tl.constexpr, BLOCK: tl.constexpr):
+    """Program r: the pools with key > T[r], then the first NEED[r] (lowest index) with key == T[r], listed in
+    pool order into OUT[r, :K] (exactly K of them)."""
+
+    r = tl.program_id(0).to(tl.int64)
+    t = tl.load(T + r)
+    need = tl.load(NEED + r)
+    n_eq = 0
+    n_sel = 0
+    for start in range(0, NP, BLOCK):
+        p = start + tl.arange(0, BLOCK)
+        k = tl.load(KEYS + r * NP + p, mask=p < NP, other=-2147483648)
+        gt = k > t
+        eq = k == t
+        eqc = tl.cumsum(eq.to(tl.int32), axis=0) + n_eq
+        sel = gt | (eq & (eqc <= need))
+        selc = tl.cumsum(sel.to(tl.int32), axis=0) + n_sel
+        tl.store(OUT + r * K + selc - 1, p, mask=sel)
+        n_eq += tl.sum(eq.to(tl.int32), axis=0)
+        n_sel += tl.sum(sel.to(tl.int32), axis=0)
+
+
+def _launch_rows(qi, wts, pk, out, pos_dev, R, NP, row0, n, keys: bool = True) -> None:
+    pkt, pt, psh = kvpool.kernel_args(pk)                                              # patches/0290
+    _scores_rows[(triton.cdiv(n, BRB), triton.cdiv(NP, 64))](qi, wts, wts.stride(0), pkt, out, pos_dev, row0 + n, NP,
+                                                            row0, 128 ** -0.5, BP=64, BRB=BRB, KEYS=keys,
+                                                            num_warps=4, **_heads(qi, wts), **_pk_paging(pt, psh))
+
+
+def block_rows(R: int, np_max: int) -> int:
+    """Rows a selection block holds: its int32 keys within GLM53_TF_SELECT_MB (a multiple of BRB, at least BRB)."""
+
+    rows = (SELECT_MB << 20) // (4 * max(np_max, 1))
+    return max(BRB, min(R, rows) // BRB * BRB)
+
+
+# -- patches/0550: the key blocks in one scratch buffer (GLM53_TF_SELECT_SCRATCH) -----------------------------------
+#
+# A key block is [n, npc] int32 with npc the block's complete pools: ~512 B a position of the prompt at 512-row
+# sub-blocks, up to GLM53_TF_SELECT_MB. Allocated per call (0065), its size grows a little every sub-block, so every
+# ~4,096 tokens the caching allocator can no longer place it in the previous block's freed segment, takes a new one
+# and keeps the old one cached: the reserved memory grows quadratically with the prompt (~4-6 GiB at 300k, ~16 GiB
+# bound at 1M: ``memsafe.keys_growth``) until something empties the cache (every CUDA graph capture does). Here the
+# blocks are views of one buffer per (device, stream): ``reserve_scratch`` grows it BEFORE a prefill (the prompt's
+# largest block, ``memsafe.select_peak``, rounded up to 16 MiB) and empties the cache when it replaces a smaller one,
+# so nothing is left behind; a block is ``scratch[:n * npc].view(n, npc)``: the same shape, strides and 512-byte-
+# aligned base as ``torch.empty`` gives, and every element is written by ``_scores_rows`` before ``torch.topk`` /
+# ``_gather_sel`` read it (the grid covers rows row0 .. row0 + n - 1 and pools < npc), so the values, the top-k
+# threshold and the selection are the same bits. While a stream captures a CUDA graph, or when the scratch is too
+# small (a caller that did not reserve), the block is allocated as before (``grow`` also grows it then, without
+# emptying the cache: the trim before the next piece does). Modes: ``grow`` (default), ``max`` (GLM53_TF_SELECT_MB at the
+# first reservation), ``off`` (0065's allocation per block).
+SCRATCH = os.environ.get("GLM53_TF_SELECT_SCRATCH", "grow").strip().lower() or "grow"
+if SCRATCH not in ("grow", "max", "off"):
+    raise ValueError(f"GLM53_TF_SELECT_SCRATCH must be grow, max or off, not {SCRATCH!r}")
+_SCRATCH: dict = {}
+SCRATCH_STATS = {"grown": 0, "fallback": 0}
+
+
+def _scratch_key(device) -> tuple:
+    dev = torch.device(device)
+    if dev.type == "cuda":
+        return (str(dev), torch.cuda.current_stream(dev).cuda_stream)
+    return (str(dev), 0)
+
+
+def _capturing(device) -> bool:
+    return torch.device(device).type == "cuda" and torch.cuda.is_current_stream_capturing()
+
+
+def scratch_bytes(device=None) -> int:
+    """Bytes the selection scratch of ``device``'s current stream holds (all of them when ``device`` is None)."""
+
+    if device is None:
+        return sum(t.numel() * 4 for t in _SCRATCH.values())
+    t = _SCRATCH.get(_scratch_key(device))
+    return 0 if t is None else t.numel() * 4
+
+
+def reserve_scratch(nbytes: int, device, *, empty: bool = True) -> int:
+    """Grow the current stream's selection scratch to hold key blocks of ``nbytes`` (``memsafe.scratch_grow_to``;
+    ``max``: GLM53_TF_SELECT_MB at once). Host side, before a forward: when it replaces a smaller buffer the cache is
+    emptied (``empty``), so the old buffer goes back to the device. -> bytes it holds (0: off / capturing)."""
+
+    from . import memsafe
+
+    if SCRATCH == "off" or nbytes <= 0 or _capturing(device):
+        return 0
+    key = _scratch_key(device)
+    cur = _SCRATCH.get(key)
+    have = 0 if cur is None else cur.numel() * 4
+    most = SELECT_MB << 20
+    new = memsafe.scratch_grow_to(max(nbytes, most) if SCRATCH == "max" else nbytes, have, most)
+    if new <= have:
+        return have
+    if cur is not None:
+        del _SCRATCH[key]
+        del cur
+        if empty and torch.device(device).type == "cuda":
+            torch.cuda.synchronize(device)
+            torch.cuda.empty_cache()
+    _SCRATCH[key] = torch.empty((new // 4,), dtype=torch.int32, device=device)
+    SCRATCH_STATS["grown"] += 1
+    return new
+
+
+def reserve_for_prefill(p0: int, p1: int, R: int, pk, device) -> int:
+    """``reserve_scratch`` for the key blocks of a prefill of positions p0 .. p1 - 1 in calls of up to ``R`` rows
+    against the pool-key cache ``pk`` (patches/0050's bound as ``latent._attend`` applies it)."""
+
+    from . import memsafe
+
+    if SCRATCH == "off" or p1 <= p0:
+        return 0
+    cap_pools = pk.shape[0] - 2
+    need = memsafe.select_peak(p1, R, cap_pools, SELECT_MB, p0)
+    return reserve_scratch(need, device) if need else 0
+
+
+def _keys_block(n: int, npc: int, dev) -> torch.Tensor:
+    """patches/0550: an [n, npc] int32 key block, a view of the scratch when it can be one."""
+
+    if SCRATCH != "off" and not _capturing(dev):
+        key = _scratch_key(dev)
+        cur = _SCRATCH.get(key)
+        if cur is None or cur.numel() < n * npc:
+            SCRATCH_STATS["fallback"] += 1
+            reserve_scratch(n * npc * 4, dev, empty=False)
+            cur = _SCRATCH.get(key)
+        if cur is not None and cur.numel() >= n * npc:
+            return cur[:n * npc].view(n, npc)
+    return torch.empty((n, npc), dtype=torch.int32, device=dev)
+
+
+def select_pools_blocked(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, pos: int, R: int, np_max: int,
+                         pos_dev: torch.Tensor, rows: int | None = None) -> torch.Tensor:
+    """Every row's 512 pools, ascending ([R, 512] int32): the first 512 of the stable descending sort of
+    ``select_tokens``' scores over ``np_max`` pools (np_max >= every row's complete pools), in row blocks.
+    patches/0550: the key blocks are views of the selection scratch (``_keys_block``: same bits)."""
+
+    dev = qi.device
+    pools = torch.empty((R, TOPK_POOLS), dtype=torch.int32, device=dev)
+    step = rows or block_rows(R, np_max)
+    for r0 in range(0, R, step):
+        n = min(step, R - r0)
+        need_np = (pos + r0 + n) // POOL                     # the block's last row's complete pools
+        npc = min(np_max, max(TOPK_POOLS, triton.cdiv(need_np, 64) * 64))
+        if npc < TOPK_POOLS:
+            raise ValueError(f"select_pools_blocked: {np_max} pools to score, fewer than {TOPK_POOLS}")
+        keys = _keys_block(n, npc, dev)
+        _launch_rows(qi, wts, pk, keys, pos_dev, R, npc, r0, n)
+        top = torch.topk(keys, TOPK_POOLS, dim=1, largest=True, sorted=False).values
+        t = top.min(dim=1).values.contiguous()
+        need = (TOPK_POOLS - (top > t[:, None]).sum(dim=1)).to(torch.int32)
+        _gather_sel[(n,)](keys, t, need, pools[r0:r0 + n], npc, K=TOPK_POOLS, BLOCK=1024, num_warps=4)
+        del keys, top                    # before the next block's: one block's scratch at a time
+    return pools
+
+
+_BLOCKED_OK: dict = {}
+
+
+def blocked_ok(device, nh: int = 32) -> bool:
+    """Once per device: ``_scores_rows`` gives ``_scores``' fp32 bits on random rows (bit for bit), else the
+    selection keeps upstream's sorted path (and says so)."""
+
+    key = (str(device), nh)
+    if key not in _BLOCKED_OK:
+        g = torch.Generator(device="cpu").manual_seed(65)
+        R, NP, pos = 40, 1024, 3900
+        qi = torch.randn((R, nh * 128), generator=g).to(device=device, dtype=torch.bfloat16)
+        wts = torch.randn((R, nh), generator=g).to(device=device, dtype=torch.bfloat16)
+        pk = torch.randn((NP + 2, 128), generator=g).to(device=device, dtype=torch.bfloat16)
+        pos_dev = torch.tensor([pos], dtype=torch.int32, device=device)
+        ref = torch.empty((R, NP), dtype=torch.float32, device=device)
+        _scores[(R, triton.cdiv(NP, 64))](qi, wts, wts.stride(0), pk, ref, pos_dev, R, NP, 128 ** -0.5, BP=64,
+                                          num_warps=4, **_heads(qi, wts))
+        got = torch.empty((R, NP), dtype=torch.float32, device=device)
+        _launch_rows(qi, wts, pk, got, pos_dev, R, NP, 0, R, keys=False)
+        ok = bool(torch.equal(ref.view(torch.int32), got.view(torch.int32)))
+        if not ok:
+            print("[tensorfold] patches/0065: row-block index scores differ from _scores' bits on this device; "
+                  "prefill selection keeps the sorted path", flush=True)
+        _BLOCKED_OK[key] = ok
+    return _BLOCKED_OK[key]
+
+
+@triton.jit
+def _gtile(q, k, v, m, l, o, valid, SCALE: tl.constexpr):
+    scores = tl.dot(q, tl.trans(k)).to(tl.float32) * SCALE
+    scores = tl.where(valid[None, :], scores, float("-inf"))
+    tile_m = tl.max(scores, 1)
+    active = tile_m != float("-inf")
+    next_m = tl.where(active, tl.maximum(m, tile_m), m)
+    alpha = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+    p = tl.where(valid[None, :] & active[:, None], tl.exp(scores - next_m[:, None]), 0.0)
+    o = o * alpha[:, None] + tl.dot(p.to(tl.bfloat16), v)
+    l = l * alpha + tl.sum(p, 1)
+    return next_m, l, o
+
+
+@triton.jit
+def _sparse_chunks(Q, KC, VC, TOK, CNT, PO, PM, PL, RS, W: tl.constexpr, H: tl.constexpr, D: tl.constexpr,
+                   CH: tl.constexpr, SCALE: tl.constexpr):
+    """Program (row, head, chunk): the row's selected tokens [c CH, (c + 1) CH) in list order; the query sits in
+    tile row 0 of a 16-row tile (rows 1-15 idle), the 27B kernel's arithmetic per row."""
+
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    c = tl.program_id(2)
+    n = tl.load(CNT + r)
+    d = tl.arange(0, D)
+    g = tl.arange(0, 16)
+    q = tl.load(Q + (r * H + h) * D + d[None, :] + g[:, None] * 0, mask=(g == 0)[:, None], other=0).to(tl.bfloat16)
+    m = tl.full((16,), float("-inf"), tl.float32)
+    l = tl.zeros((16,), tl.float32)
+    o = tl.zeros((16, D), tl.float32)
+    for t in range(CH // 64):
+        idx = c * CH + t * 64 + tl.arange(0, 64)
+        ok = idx < n
+        tok = tl.load(TOK + r * W + idx, mask=ok, other=0).to(tl.int64)
+        kk = tl.load(KC + (tok[:, None] * H + h) * D + d[None, :], mask=ok[:, None], other=0).to(tl.bfloat16)
+        vv = tl.load(VC + (tok[:, None] * H + h) * D + d[None, :], mask=ok[:, None], other=0).to(tl.bfloat16)
+        m, l, o = _gtile(q, kk, vv, m, l, o, ok, SCALE)
+    base = (c * RS + r) * H + h
+    tl.store(PO + base * D + d[None, :] + g[:, None] * 0, o, mask=(g == 0)[:, None])
+    tl.store(PM + base + g * 0, m, mask=g == 0)
+    tl.store(PL + base + g * 0, l, mask=g == 0)
+
+
+@triton.jit
+def _sparse_merge(PO, PM, PL, OUT, CNT, RS, H: tl.constexpr, D: tl.constexpr, NCH: tl.constexpr, CH: tl.constexpr):
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    n = tl.load(CNT + r)
+    if n == 0:
+        return
+    d = tl.arange(0, D)
+    m = float("-inf")
+    l = 0.0
+    o = tl.zeros((D,), tl.float32)
+    for c in range(NCH):
+        if c * CH < n:
+            base = (c * RS + r) * H + h
+            cm = tl.load(PM + base)
+            cl = tl.load(PL + base)
+            co = tl.load(PO + base * D + d)
+            active = cl > 0.0
+            next_m = tl.where(active, tl.maximum(m, cm), m)
+            a = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+            b = tl.where(active, tl.exp(cm - next_m), 0.0)
+            o = o * a + co * b
+            l = l * a + cl * b
+            m = next_m
+    tl.store(OUT + (r * H + h) * D + d, (o / l).to(tl.bfloat16))
+
+
+def sparse_attention(q: torch.Tensor, kc: torch.Tensor, vc: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor,
+                     out: torch.Tensor, scale: float, part: LongScratch | None = None) -> None:
+    """Rows with counts > 0: attention over their selected tokens, written into ``out`` [R, H, D] (other rows
+    untouched). ``part`` (patches/0050): preallocated chunk partials (a captured step allocates nothing)."""
+
+    R, H, D = q.shape
+    W = tokens.shape[1]
+    CH = 512
+    nch = triton.cdiv(W, CH)
+    # chunk partials for every row of the window (upstream sized them for 128 rows, the verify windows; longer
+    # prefill chunks, GLM53_TF_PREFILL_ROWS, need R); the row stride only places partials, not their bits
+    if part is not None and R <= part.rows:
+        po, pm, pl = part.part(R, H, D)
+    else:
+        po = torch.empty((nch * R * H * D,), dtype=torch.float32, device=q.device)
+        pm = torch.empty((nch * R * H,), dtype=torch.float32, device=q.device)
+        pl = torch.empty((nch * R * H,), dtype=torch.float32, device=q.device)
+    _sparse_chunks[(R, H, nch)](q, kc, vc, tokens, counts, po, pm, pl, R, W=W, H=H, D=D, CH=CH, SCALE=scale,
+                                num_warps=4, num_stages=1)
+    _sparse_merge[(R, H)](po, pm, pl, out, counts, R, H=H, D=D, NCH=nch, CH=CH, num_warps=4)
