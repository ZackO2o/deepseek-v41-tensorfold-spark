@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G10 offline checks (no GPU) of the PDL plumbing (``pdl.py``, TF_DSV41_PDL) and the L2 prefetch (``l2pf.py``,
+TF_DSV41_L2PF); the GPU half is ``tests/cuda/test_dsv41_pdl_gpu.py``.
+
+- the knobs: parts, refusals, ``triton_kw`` (both keys on or both off; never under the interpreter);
+- every PDL-aware Triton kernel starts with ``if PDL: gdc_wait(); gdc_launch_dependents()`` (wait first, nothing
+  before it) and every launch of it passes ``**P.triton_kw()`` (a kernel launched with the attribute always waits);
+- the kernels compiled for sm_121 by Triton's own ptxas: PDL on has the wait before any global store and the trigger
+  after the wait; PDL off has neither and is otherwise the same PTX (register names aside);
+- x3seg.cu: seg_rot_in waits before anything and triggers after; seg_linear reads only weight words before its wait,
+  stores nothing before it, and triggers after it; both launchers go through cudaLaunchKernelEx with the attribute;
+- x3ld takes TF_DSV41_PDL's ``experts`` part; ``linear.Exl3`` routes to ``fused_proj.single`` only with ``single``;
+- l2pf: settings, spans (16-byte aligned, whole tensors in order, the budget), the sites' tensors, the hooks' no-op.
+"""
+
+from __future__ import annotations
+
+import ast
+import inspect
+import re
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import l2pf as L2
+from tensorfold.families.deepseek_v41.cuda import pdl as P
+
+CUDA = Path(P.__file__).parent
+PDL_MODULES = ["rmsnorm.py", "rope_fused.py", "csa2/attn.py", "csa2/compress.py", "engram.py", "plain_fp64.py"]
+
+
+# -- knobs ------------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("raw,want", [(None, set()), ("", set()), ("0", set()), ("off", set()), ("1", set(P.PARTS)),
+                                      ("all", set(P.PARTS)), ("seg", {"seg"}), (" triton , seg ", {"seg", "triton"})])
+def test_parse(raw, want):
+    assert P.parse(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["2", "seg,bogus", ",", "dense"])
+def test_parse_refuses(raw):
+    with pytest.raises(ValueError):
+        P.parse(raw)
+
+
+def test_triton_kw(monkeypatch):
+    monkeypatch.delenv("TRITON_INTERPRET", raising=False)
+    monkeypatch.setattr(P, "capable", lambda device=0: True)
+    monkeypatch.setattr(torch.cuda, "current_device", lambda: 0)
+    monkeypatch.setenv(P.ENV, "seg")
+    assert P.triton_kw() == {"PDL": False}
+    monkeypatch.setenv(P.ENV, "triton")
+    assert P.triton_kw() == ({"PDL": True, "launch_pdl": True} if P.triton_ok() else {"PDL": False})
+    monkeypatch.setenv("TRITON_INTERPRET", "1")
+    assert P.triton_kw() == {"PDL": False}
+    monkeypatch.delenv(P.ENV)
+    monkeypatch.delenv("TRITON_INTERPRET")
+    assert P.triton_kw() == {"PDL": False} and not P.on("seg")
+
+
+# -- the Triton kernels' structure ---------------------------------------------------------------------------------
+def _jit_kernels(tree):
+    for node in tree.body:
+        if isinstance(node, ast.FunctionDef) and any("jit" in ast.unparse(d) for d in node.decorator_list):
+            yield node
+
+
+@pytest.mark.parametrize("mod", PDL_MODULES)
+def test_triton_kernels_wait_first_and_launch_with_kw(mod):
+    src = (CUDA / mod).read_text()
+    tree = ast.parse(src)
+    pdl_kernels = []
+    for fn in _jit_kernels(tree):
+        if "PDL" not in [a.arg for a in fn.args.args]:
+            continue
+        pdl_kernels.append(fn.name)
+        body = [s for s in fn.body if not (isinstance(s, ast.Expr) and isinstance(s.value, ast.Constant))]
+        first = body[0]
+        assert isinstance(first, ast.If) and ast.unparse(first.test) == "PDL", (mod, fn.name)
+        calls = [ast.unparse(s) for s in first.body]
+        assert calls == ["gdc_wait()", "gdc_launch_dependents()"], (mod, fn.name, calls)
+        assert not first.orelse
+    assert pdl_kernels, mod
+    for call in ast.walk(tree):
+        if isinstance(call, ast.Call) and isinstance(call.func, ast.Subscript) and \
+                isinstance(call.func.value, ast.Name) and call.func.value.id in pdl_kernels:
+            kws = [ast.unparse(k.value) for k in call.keywords if k.arg is None]
+            assert "P.triton_kw()" in kws, (mod, call.func.value.id, ast.unparse(call)[:120])
+            assert not any(k.arg in ("PDL", "launch_pdl") for k in call.keywords), (mod, call.func.value.id)
+
+
+# -- the Triton kernels compiled for sm_121 (Triton's own ptxas; skipped if this Triton cannot target it) ------------
+def _compile(fn, sig, consts, pdl):
+    import triton
+    from triton.backends.compiler import GPUTarget
+    from triton.compiler import ASTSource
+
+    src = ASTSource(fn, dict(sig, PDL="constexpr"), constexprs=dict(consts, PDL=pdl))
+    try:
+        k = triton.compile(src, target=GPUTarget("cuda", 121, 32), options={"num_warps": 4, "launch_pdl": pdl})
+    except Exception as e:  # noqa: BLE001 - no ptxas / backend for sm_121 here
+        pytest.skip(f"Triton cannot compile for sm_121 here: {type(e).__name__}: {str(e)[:200]}")
+    return k.asm["ptx"]
+
+
+def _kernels():
+    from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF
+    from tensorfold.families.deepseek_v41.cuda import rmsnorm as RN
+
+    rms = {"X": "*bf16", "x_rs": "i32", "W": "*bf16", "OUT": "*bf16", "o_rs": "i32", "K": "i32", "inv_k": "fp64",
+           "eps": "fp64", "BK": "constexpr", "HAS_W": "constexpr", "NARROW": "constexpr"}
+    pair = {"XA": "*bf16", "xa_rs": "i32", "WA": "*bf16", "OA": "*bf16", "oa_rs": "i32", "KA": "i32",
+            "inv_ka": "fp64", "XB": "*bf16", "xb_rs": "i32", "WB": "*bf16", "OB": "*bf16", "ob_rs": "i32", "KB": "i32",
+            "inv_kb": "fp64", "eps": "fp64", "BK": "constexpr", "NARROW": "constexpr"}
+    plain = {"X": "*bf16", "x_rs": "i32", "W": "*bf16", "w_rs": "i32", "OUT": "*fp64", "K": "i32", "N": "i32",
+             "BK": "constexpr"}
+    return {"_rms": (RN._rms, rms, {"BK": 512, "HAS_W": True, "NARROW": True}),
+            "_rms2": (RN._rms2, pair, {"BK": 512, "NARROW": True}),
+            "_plain": (PF._plain, plain, {"BK": getattr(PF, "BK", 256)})}
+
+
+@pytest.mark.parametrize("name", ["_rms", "_rms2", "_plain"])
+def test_ptx_wait_before_stores_trigger_after(name):
+    fn, sig, consts = _kernels()[name]
+    on, off = _compile(fn, sig, consts, True), _compile(fn, sig, consts, False)
+    assert "griddepcontrol" not in off
+    lines = [ln.strip() for ln in on.splitlines()]
+    w = [i for i, ln in enumerate(lines) if ln.startswith("griddepcontrol.wait")]
+    t = [i for i, ln in enumerate(lines) if ln.startswith("griddepcontrol.launch_dependents")]
+    st = [i for i, ln in enumerate(lines) if re.match(r"(@%p\d+\s+)?st\.global", ln)]
+    assert len(w) == 1 and len(t) == 1 and w[0] < t[0], (w, t)
+    assert st and min(st) > w[0]
+    assert _norm(on) == _norm(off)                       # the same instructions besides the two (register names aside)
+
+
+def _norm(ptx: str) -> list[str]:
+    out = []
+    for ln in ptx.splitlines():
+        ln = ln.strip()
+        if ln and not ln.startswith((".loc", "//", "$L__tmp", "$L__func", ".reg", ".file", "griddepcontrol")):
+            out.append(re.sub(r"%(r|rd|rs|p|f|fd)\d+", r"%\1", ln))
+    return out
+
+
+# -- x3seg.cu -------------------------------------------------------------------------------------------------------
+def _fn(src: str, sig: str) -> str:
+    a = src.index(sig)
+    b = src.index("{", a)
+    depth, i = 0, b
+    while True:
+        depth += src[i] == "{"
+        depth -= src[i] == "}"
+        i += 1
+        if depth == 0:
+            return src[b:i]
+
+
+def test_x3seg_wait_and_trigger_placement():
+    src = (CUDA / "x3seg.cu").read_text()
+    rot = _fn(src, "seg_rot_in_kernel(const RotTable tab)")
+    stmts = [s.strip() for s in rot.strip("{}").split(";") if s.strip()]
+    assert stmts[0].startswith("pdl_wait()") and stmts[1].split("\n")[-1].strip() == "pdl_trigger()", stmts[:2]
+    lin = _fn(src, "seg_linear_kernel(const LinTable tab, int y_dtype, int M)")
+    w = lin.index("pdl_wait()")
+    t = lin.index("pdl_trigger()")
+    pre = lin[:w]
+    assert w < t
+    assert "load_step<K2>(tile, lane, cur)" in pre                    # the first weight step before the wait
+    for bad in ("x0 + kt", "x1 + kt", "store4(", "atomicAdd", "counters[", "Z +", "*reinterpret_cast<float"):
+        assert bad not in pre, bad
+    assert "if (pass == 0) pdl_wait();" in lin and "if (m0 + 16 >= M) pdl_trigger();" in lin
+    host = src[src.index("void dsv41_x3seg_rot_in_cuda"):]
+    assert "<<<" not in host and host.count("launch_ex(") >= 2
+    assert "cudaLaunchAttributeProgrammaticStreamSerialization" in src
+    cpp = (CUDA / "x3seg.cpp").read_text()
+    assert cpp.count('pybind11::arg("pdl") = false') == 2
+
+
+# -- x3ld / linear routing -------------------------------------------------------------------------------------------
+def test_x3ld_takes_the_experts_part(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import expert_loads as EL
+
+    seen = []
+    monkeypatch.setattr(EL, "_ext", lambda: types.SimpleNamespace(grouped=lambda *a: seen.append(a[-1])))
+    monkeypatch.setattr(EL, "_pdl_ok", lambda d: True)
+    monkeypatch.setitem(EL.CFG, "pdl", False)
+    x0 = torch.zeros(1)
+    args = (x0, x0, x0, x0, x0, x0, x0, x0, x0, x0, 2, 4096, 2048, 4, 1, 7, 2, 4, 2, 10)
+    for env, want in (("0", False), ("seg,triton", False), ("experts", True), ("1", True)):
+        monkeypatch.setenv(P.ENV, env)
+        assert EL.grouped(*args, cfg=(8, 1))
+        assert seen[-1] is want, env
+
+
+def test_prebuild_walks_blocks_and_head(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+    built = []
+    monkeypatch.setattr(FP, "single", lambda lin: built.append(lin) or object())
+    lins = [types.SimpleNamespace(words=i) for i in range(5)]
+    ex = [types.SimpleNamespace(lin=x) for x in lins]
+    attn = types.SimpleNamespace(wq_a=ex[0], wo_a=[ex[1], ex[2]], wo_b=ex[3], q_norm=torch.zeros(2))
+    blk = types.SimpleNamespace(attn=attn, index=3, fused=None)
+    monkeypatch.setenv(P.ENV, "seg")
+    assert P.prebuild([ex[4], blk]) == 0 and not built
+    monkeypatch.setenv(P.ENV, "1")
+    assert P.prebuild([ex[4], blk, blk]) == 5 and sorted(x.words for x in built) == [0, 1, 2, 3, 4]
+
+
+def test_linear_routes_single_only_with_its_part():
+    from tensorfold.families.deepseek_v41.cuda import linear as LN
+
+    src = inspect.getsource(LN.Exl3.__call__)
+    assert 'P.on("single", x.device.index)' in src and "FP.single(self.lin)" in src
+    assert src.index("D.wanted(self.lin)") < src.index('P.on("single"')        # x3dn keeps precedence
+
+
+# -- l2pf -----------------------------------------------------------------------------------------------------------
+def test_l2pf_settings():
+    assert not L2.settings({}).on
+    s = L2.settings({L2.ENV: "1", L2.ENV + "_SITES": "o,x", L2.ENV + "_MB": "4"})
+    assert s.mode == "bulk" and s.sites == ("o", "x") and s.mb == 4.0
+    for bad in ({L2.ENV: "touch"}, {L2.ENV: "1", L2.ENV + "_SITES": "e"}, {L2.ENV: "1", L2.ENV + "_MB": "20"}):
+        with pytest.raises(ValueError):
+            L2.settings(bad)
+
+
+def test_l2pf_take_spans():
+    a, b = torch.zeros(1000, dtype=torch.int32), torch.zeros(4096, dtype=torch.float16)
+    spans = L2.take([a, None, b], 4000 + 3000)
+    assert spans[0] == (a.data_ptr(), 4000) and spans[1][0] == b.data_ptr() and spans[1][1] == 3000 // 16 * 16
+    assert all(addr % 16 == 0 and n % 16 == 0 and n > 0 for addr, n in spans)
+    assert sum(n for _, n in L2.take([a, b], 100)) == 96 and L2.take([a], 8) == []
+
+
+def test_l2pf_site_tensors_and_noop_hooks():
+    def lin(tag):
+        return types.SimpleNamespace(suh=f"{tag}.suh", svh=f"{tag}.svh", words=f"{tag}.w")
+
+    grp = lambda *tags: types.SimpleNamespace(lins=[lin(t) for t in tags])
+    nxt = types.SimpleNamespace(fused=types.SimpleNamespace(x4=None, x2=grp("wq_a", "wkv"), q=grp("wq_b", "ix"),
+                                                            o=None))
+    assert L2.site_tensors(None, nxt, "x") == ["wq_a.suh", "wq_a.svh", "wkv.suh", "wkv.svh", "wq_a.w", "wkv.w",
+                                               "wq_b.suh", "wq_b.svh", "ix.suh", "ix.svh", "wq_b.w", "ix.w"]
+    ex = types.SimpleNamespace(count=3, keep=list("gggUUUddd"))
+    blk = types.SimpleNamespace(moe=types.SimpleNamespace(gate="gate", block=types.SimpleNamespace(ex=ex)))
+    assert L2.site_tensors(blk, None, "f") == ["gate", "g", "U"]
+    L2.mark(types.SimpleNamespace(), "o", 1)                              # no prefetcher: nothing happens
+    L2.join([types.SimpleNamespace()])
+    L2.join([])
+
+
+def test_forward_hooks_in_place():
+    from tensorfold.families.deepseek_v41.cuda import blocks as B
+    from tensorfold.families.deepseek_v41.cuda import forward as F
+
+    lay = inspect.getsource(F.Forward._layers)
+    assert lay.count("L2.mark(") == 2 and lay.count("L2.join(self.blocks)") == 2
+    assert 'L2.mark(blk, "f", n)' in lay and 'L2.mark(blk, "x", n)' in lay
+    init = inspect.getsource(F.Forward.__init__)
+    assert "L2.install(self.blocks, self.device)" in init and "PD.prebuild([self.head, *self.blocks])" in init
+    att = inspect.getsource(B.attention)
+    assert att.index("fz.qproj(qr)") < att.index('l2pf.mark(blk, "o", n)') < att.index("rope_inplace()")
