+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9: ``engram._fuse`` with its loads in flight (the same arithmetic, bit for bit).
+
+G9 nsys (1-row verify window): ``_fuse`` takes ~100 us a launch (2 a window, 0.2 ms): one program a row walks the
+5,120 columns in 80 steps of 64 for its three FMA chains (x qk key, x^2, key^2 of the 4 streams), each step waiting
+a load latency, then walks them again for the update, another 80 waits. Here:
+
+- the chains: the loads of step t + 4 issue before step t's dots (4 steps in flight, rotated in registers); the
+  dots, the products and their order are ``_fuse``'s, so the sums are the same bits;
+- the update: [4, 1,024] tiles (5 steps, not 80): ``bf16(x + gate * value)``, elementwise, the same expression.
+
+``TF_DSV41_ENGRAM_FUSE_DEC`` (1, the default; 0 = ``engram.fuse``) through ``seams.engram_fuse``.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+BK = 64            # ``engram.BK``: the chain step (the same dots)
+UB = 1024          # update columns a step
+WARPS = 4
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_ENGRAM_FUSE_DEC", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _ld(X, KV, QK, rx, rk, hh, hm, kk, t, NT, D: tl.constexpr, BK: tl.constexpr):
+    """Step t's tiles [16, BK] (rows 0-3: the streams; nothing past the last step)."""
+
+    d = t * BK + kk
+    m = hm[:, None] & (t < NT)
+    x = tl.load(X + rx + hh[:, None] * D + d[None, :], mask=m, other=0.0)
+    k = tl.load(KV + rk + hh[:, None] * D + d[None, :], mask=m, other=0.0)
+    q = tl.load(QK + hh[:, None] * D + d[None, :], mask=m, other=0.0)
+    return x, k, q
+
+
+@triton.jit
+def _fuse_dec(X, x_stride, KV, kv_stride, QK, KEEP, GATE, eps, clamp, sqrt_d, D: tl.constexpr, BK: tl.constexpr,
+              UB: tl.constexpr, HAS_KEEP: tl.constexpr, HAS_GATE: tl.constexpr):
+    r = tl.program_id(0).to(tl.int64)
+    rx = r * x_stride
+    rk = r * kv_stride
+    hh = tl.arange(0, 16)
+    hm = hh < 4
+    kk = tl.arange(0, BK)
+    NT: tl.constexpr = D // BK
+    ones = tl.full((BK, 16), 1.0, tl.float32)
+    sp = tl.zeros((16, 16), tl.float32)
+    sx = tl.zeros((16, 16), tl.float32)
+    sk = tl.zeros((16, 16), tl.float32)
+    xa, ka, qa = _ld(X, KV, QK, rx, rk, hh, hm, kk, 0, NT, D, BK)
+    xb, kb, qb = _ld(X, KV, QK, rx, rk, hh, hm, kk, 1, NT, D, BK)
+    xc, kc, qc = _ld(X, KV, QK, rx, rk, hh, hm, kk, 2, NT, D, BK)
+    xd, kd, qd = _ld(X, KV, QK, rx, rk, hh, hm, kk, 3, NT, D, BK)
+    for t in range(NT):
+        xn, kn, qn = _ld(X, KV, QK, rx, rk, hh, hm, kk, t + 4, NT, D, BK)
+        x = xa.to(tl.float32)
+        k = ka.to(tl.float32)
+        p = (x * qa) * k
+        sp = tl.dot(p, ones, sp, input_precision="ieee")
+        sx = tl.dot(x * x, ones, sx, input_precision="ieee")
+        sk = tl.dot(k * k, ones, sk, input_precision="ieee")
+        xa, ka, qa = xb, kb, qb
+        xb, kb, qb = xc, kc, qc
+        xc, kc, qc = xd, kd, qd
+        xd, kd, qd = xn, kn, qn
+    c0 = tl.arange(0, 16)[None, :] == 0
+    dp = tl.sum(tl.where(c0, sp, 0.0), 1)
+    rxn = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(tl.sum(tl.where(c0, sx, 0.0), 1), 1.0 * D) + eps))
+    rkn = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(tl.sum(tl.where(c0, sk, 0.0), 1), 1.0 * D) + eps))
+    dot = tl.div_rn((dp * rxn) * rkn, sqrt_d)
+    g = tl.sqrt_rn(tl.maximum(tl.abs(dot), clamp))
+    gate = 1.0 / (1.0 + tl.exp(-tl.where(dot < 0, -g, g)))
+    if HAS_KEEP:
+        gate = gate * tl.load(KEEP + r)
+    gate = tl.where(hm, gate, 0.0)
+    if HAS_GATE:
+        tl.store(GATE + r * 4 + hh, gate, mask=hm)
+    h4 = tl.arange(0, 4)
+    g4 = tl.sum(tl.where(hh[None, :] == h4[:, None], gate[None, :], 0.0), 1)     # gate[0:4] (one term a sum: exact)
+    uu = tl.arange(0, UB)
+    for t in range(D // UB):
+        d = t * UB + uu
+        x = tl.load(X + rx + h4[:, None] * D + d[None, :]).to(tl.float32)
+        v = tl.load(KV + rk + 4 * D + d).to(tl.float32)
+        tl.store(X + rx + h4[:, None] * D + d[None, :], (x + g4[:, None] * v[None, :]).to(tl.bfloat16))
+
+
+LAUNCH = {"enable_fp_fusion": False}
+
+
+def fuse(x: torch.Tensor, kv: torch.Tensor, qk: torch.Tensor, keep: torch.Tensor | None = None,
+         gate: torch.Tensor | None = None, *, eps: float, clamp: float) -> torch.Tensor:
+    """``engram.fuse`` (same arguments, same bits); D a multiple of ``UB``."""
+
+    R, d = x.shape[0], qk.shape[1]
+    if x.dtype != torch.bfloat16 or x.shape[1] != 4 * d or x.stride(1) != 1 or d % UB or d % BK:
+        raise ValueError("engram_dec.fuse: x bf16 [R, 4 D] unit-stride, D a multiple of 1,024")
+    if kv.dtype != torch.bfloat16 or kv.shape[1] < 5 * d or kv.stride(1) != 1 or qk.dtype != torch.float32 or \
+            not qk.is_contiguous():
+        raise ValueError("engram_dec.fuse: kv bf16 [R, 5 D], qk fp32 [4, D] contiguous")
+    if keep is not None and keep.dtype != torch.float32:
+        keep = keep.to(torch.float32)
+    if R:
+        _fuse_dec[(R,)](x, x.stride(0), kv, kv.stride(0), qk, keep if keep is not None else qk,
+                        gate if gate is not None else qk, eps, clamp, float(math.sqrt(d)), D=d, BK=BK, UB=UB,
+                        HAS_KEEP=keep is not None, HAS_GATE=gate is not None, num_warps=WARPS, **LAUNCH)
+    return x
+
+
+def supports(x: torch.Tensor, qk: torch.Tensor) -> bool:
+    d = qk.shape[1]
+    return enabled() and d % UB == 0 and d % BK == 0 and qk.is_contiguous()
+
+
+__all__ = ["enabled", "fuse", "supports"]
