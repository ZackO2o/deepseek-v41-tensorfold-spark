--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pctree.py
@@ -0,0 +1,303 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Parent-conditioned draft trees for DSpark (``TF_DSV41_TREE_PC=1`` with ``TF_DSV41_TREE`` >= 2): branches at draft
+positions 1 .. ``TF_DSV41_TREE_DEPTHS``, each child scored by DSpark's Markov head given its own parent (PCTree,
+arXiv 2608.02123; no retraining). ``tree.py`` verifies the result: every leaf's path is a chain window on the slot
+(the main chain) or on a shadow slot, and the round presents the chain with the longest accepted prefix.
+
+**Children.** A pass gives, per draft row i, the base logits of its candidates (``Drafter.last_tree``; the noise
+rows', independent of the drafted tokens) and the Markov head biases them by the previous token only:
+z_i(c | t) = base_i[c] + w2[c] . w1[t]. So the children of any node (token t at depth i) are the keyed order of
+z_i(. | t) (``tree.ranked``: greedy (z desc, id asc), sampled ``choose``'s filters and the keyed Gumbel at the
+child's absolute position), with draft probabilities softmax(z) (T = 1 greedy, the request's T sampled). The main
+chain (the pass's drafts) is the keyed first child of the main path, taken from the kernel's drafts, not recomputed.
+
+**Node values.** A node's value is its path probability (the chance its whole path is the serial continuation):
+the parent's value times the child's conditional chance q:
+
+- a keyed first child: the confidence head given this parent. The head is sigmoid(cw_h . h_i + cw_m . w1[t]) and
+  only the second term depends on the parent, so h-part_i = logit(conf_i) - cw_m . w1[prev_i] from the main chain's
+  confidences and the head's value for any parent t is sigmoid(h-part_i + cw_m . w1[t]); then the depth's
+  calibration of position i (``depth.Calibration`` or ``confcal``);
+- a later child (rank r >= 1): its draft probability times a decayed (kept / summed p) factor per (depth, rank)
+  (``Cal``), learned on both ranks from the serial tokens of every verified tree.
+
+**Selection.** Best-first: a node joins in order of value (a child is never likelier than its parent, so every
+prefix of the order is a tree), the main chain's first draft first; each prefix is priced and the best surplus
+E - rate x ms is kept (``depth.best_k``'s objective; E = 1 + the sum of the nodes' values). Chains: a node whose
+parent already has a child starts a new chain (a shadow slot), at most ``branches`` chains a slot.
+
+**Cost (the expert-union term).** A unique row (a new token at its position) brings new routed experts: its cost is
+the cost table's marginal row (``Costs.rows_ms`` of the unique rows: the measured ~6 ms second row and ~4 ms later
+ones are mostly expert bytes, G9). A new chain re-runs its shared prefix (the pending row and its parent's path) on
+the shadow: the same tokens, positions and context, so the same routing: no new experts, only the dense /
+attention work of a row (``dup_ms``). Each further chain is a further segment of the window (``Costs.slot``). Rows
+off the main chain may share more experts with their siblings than a chain's next row does with its parent: their
+marginal row cost is scaled by ``TF_DSV41_TREE_SIB_EXPERT`` (default 1: priced like chain rows until measured).
+
+Exactness: unchanged from ``tree.py``: every chain is an ordinary chain window, the presented one is decided from
+the window's own keyed choices on both ranks, and every token is the serial token (``dspark.accept``).
+
+Knobs: TF_DSV41_TREE_PC (0 | 1, default 0: ``tree.py``'s first-position siblings), TF_DSV41_TREE_DEPTHS (1-4,
+default 3: the deepest draft position a branch may start at), TF_DSV41_TREE_WIDTH (2-4, default 2: children a node
+may offer), TF_DSV41_TREE_SIB_EXPERT (0-2, default 1).
+"""
+
+from __future__ import annotations
+
+import heapq
+import math
+import os
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+
+import numpy as np
+
+PRIOR, F_MIN, F_MAX, Q_MAX, DECAY = 2.0, 0.05, 4.0, 0.95, 0.97
+
+
+def settings(env=None) -> dict:
+    env = os.environ if env is None else env
+    pc = (env.get("TF_DSV41_TREE_PC", "") or "0").strip() not in ("0", "off", "false")
+    depths = int((env.get("TF_DSV41_TREE_DEPTHS", "") or "3").strip())
+    width = int((env.get("TF_DSV41_TREE_WIDTH", "") or "2").strip())
+    sib = float((env.get("TF_DSV41_TREE_SIB_EXPERT", "") or "1").strip())
+    if not 1 <= depths <= 4 or not 2 <= width <= 4 or not 0.0 <= sib <= 2.0:
+        raise ValueError("TF_DSV41_TREE_DEPTHS 1-4, TF_DSV41_TREE_WIDTH 2-4, TF_DSV41_TREE_SIB_EXPERT 0-2")
+    return {"pc": pc, "depths": depths, "width": width, "sib_expert": sib}
+
+
+def _logit(p: float) -> float:
+    p = min(max(float(p), 1e-6), 1.0 - 1e-6)
+    return math.log(p / (1.0 - p))
+
+
+def _sigmoid(x: float) -> float:
+    return 1.0 / (1.0 + math.exp(-x)) if x >= 0 else math.exp(x) / (1.0 + math.exp(x))
+
+
+class Cal:
+    """Per (depth, rank >= 1): decayed kept and summed draft probabilities (``tree.SibCal`` by depth)."""
+
+    def __init__(self, depths: int, width: int) -> None:
+        self.kept = [[0.0] * width for _ in range(depths)]
+        self.prob = [[0.0] * width for _ in range(depths)]
+
+    def factor(self, d: int, r: int) -> float:
+        d, r = min(d, len(self.kept) - 1), min(r, len(self.kept[0]) - 1)
+        return min(max((self.kept[d][r] + PRIOR) / (self.prob[d][r] + PRIOR), F_MIN), F_MAX)
+
+    def q(self, d: int, r: int, p: float) -> float:
+        return min(max(float(p), 0.0) * self.factor(d, r), Q_MAX)
+
+    def record(self, d: int, r: int, p: float, kept: bool) -> None:
+        d, r = min(d, len(self.kept) - 1), min(r, len(self.kept[0]) - 1)
+        self.kept[d][r] = self.kept[d][r] * DECAY + float(kept)
+        self.prob[d][r] = self.prob[d][r] * DECAY + max(float(p), 0.0)
+
+
+class Expander:
+    """The draft distribution after any parent at any row of a pass (host, numpy / torch on the CPU)."""
+
+    def __init__(self, w1, w2, cw=None) -> None:
+        self.w1, self.w2 = w1, w2
+        self.mc = None
+        if cw is not None:                          # cw_m . w1[t] for every t: the confidence's parent term
+            r = w1.shape[1]
+            self.mc = (w1.float() @ cw[-r:].float().reshape(-1)).numpy().astype(np.float64)
+
+    def children(self, cand: np.ndarray, base: np.ndarray, i: int, prev: int, position: int, sampling, m: int,
+                 exclude=()) -> list[tuple[int, float]]:
+        from .tree import markov_z, ranked
+
+        z = markov_z(base[i], cand[i], prev, self.w1, self.w2)
+        return ranked(z, cand[i], position, sampling, m, exclude=exclude)
+
+    def hparts(self, conf: Sequence[float], pending: int, main: Sequence[int]) -> list[float] | None:
+        if self.mc is None:
+            return None
+        prev = [int(pending)] + [int(t) for t in main]
+        return [_logit(c) - float(self.mc[prev[i]]) for i, c in enumerate(conf[:len(prev)])]
+
+    def conf(self, hpart: float, parent: int) -> float:
+        return _sigmoid(hpart + float(self.mc[int(parent)]))
+
+
+@dataclass
+class Node:
+    tok: int
+    depth: int                  # 1 = the first draft position
+    parent: int                 # index in the order, -1 = the pending token
+    rank: int                   # 0 = the keyed first child of its parent
+    p: float                    # draft probability (softmax of z)
+    v: float                    # path value
+    main: bool = False          # on the main chain (the pass's drafts)
+    kids: int = 0
+
+
+@dataclass
+class Plan:
+    k: int                                          # main chain drafts
+    chains: list = field(default_factory=list)      # extra chains: (tokens after the pending one, node indices)
+    nodes: list = field(default_factory=list)       # the selected nodes (order)
+    ms: float = 0.0
+    expected: float = 1.0
+
+
+def grow(exp: Expander, cand, base, pending: int, start: int, sampling, main: Sequence[int], conf: Sequence[float],
+         qmain: Callable[[int, float], float], qsib: Callable[[int, int, float], float], *, depths: int, width: int,
+         rows: int, chains: int) -> list[Node]:
+    """The candidate nodes in best-first order (the main chain's first draft first), at most ``rows`` nodes and
+    ``chains`` chains (the main one included)."""
+
+    N = min(cand.shape[0], len(main))
+    hp = exp.hparts(conf, pending, main)
+    order: list[Node] = []
+    heap: list = []
+    seq = 0
+
+    def push(node: Node) -> None:
+        nonlocal seq
+        heapq.heappush(heap, (-node.v, seq, node))
+        seq += 1
+
+    def expand(ix: int) -> None:
+        par = order[ix] if ix >= 0 else None
+        i = 0 if par is None else par.depth          # the row giving the children
+        if i >= N:
+            return
+        tok = int(pending) if par is None else par.tok
+        pv = 1.0 if par is None else par.v
+        on_main = par is None or par.main
+        m = width if i < depths else 1
+        if on_main:
+            first = int(main[i])
+            kids = [(first, None)] + [(t, p) for t, p in exp.children(cand, base, i, tok, start + 1 + i, sampling,
+                                                                      m - 1, exclude=(first,))]
+        else:
+            kids = [(t, p) for t, p in exp.children(cand, base, i, tok, start + 1 + i, sampling, m)]
+        for r, (t, p) in enumerate(kids):
+            if r == 0:
+                c = conf[i] if on_main else (exp.conf(hp[i], tok) if hp is not None else p)
+                q = qmain(i, c)
+            else:
+                q = qsib(i, r, p)
+            if q > 0.0 or (par is None and r == 0):   # the main chain's first draft is always a candidate
+                push(Node(int(t), i + 1, ix, r, 1.0 if p is None else float(p), pv * q, on_main and r == 0))
+
+    expand(-1)
+    n_chains = 0
+    while heap and len(order) < rows:
+        _, _, node = heapq.heappop(heap)
+        if not order and not node.main:             # the main chain's first draft comes first
+            first = next(h for h in heap if h[2].main)
+            heap.remove(first)
+            heapq.heapify(heap)
+            push(node)
+            node = first[2]
+        par = order[node.parent] if node.parent >= 0 else None
+        new = new_chain(node, par, par.kids if par is not None else 0)
+        if new and n_chains + 1 >= chains:
+            continue                                # no shadow left: neither it nor its subtree
+        n_chains += int(new)
+        if par is not None:
+            par.kids += 1
+        order.append(node)
+        expand(len(order) - 1)
+    for o in order:
+        o.kids = 0
+    return order
+
+
+def new_chain(node: Node, par: Node | None, kids: int) -> bool:
+    """A node starts a chain (a shadow window) unless it continues one: the main chain's next draft, or the first
+    child of a node off the main chain."""
+
+    return not node.main and (par is None or par.main or kids > 0)
+
+
+def select(order: Sequence[Node], rows_ms: Callable[[int], float], rate: float, *, least: int = 1,
+           dup_ms: float = 0.4, slot_ms: float = 0.0, sib_expert: float = 1.0, max_rows: int = 16) -> Plan:
+    """The best prefix of ``order`` by E - rate x ms (module docstring); -> ``Plan``."""
+
+    kids = [0] * len(order)
+    e, n_main, n_other, extra, dups = 1.0, 0, 0, 0, 0
+    best: tuple | None = None
+    for n in range(len(order) + 1):
+        if n:
+            nd = order[n - 1]
+            par = order[nd.parent] if nd.parent >= 0 else None
+            if new_chain(nd, par, kids[nd.parent] if par is not None else 0):
+                extra += 1                          # the pending row and the parent's path again, on a shadow
+                dups += 1 + (0 if par is None else par.depth)
+            if par is not None:
+                kids[nd.parent] += 1
+            e += nd.v
+            n_main += int(nd.main)
+            n_other += int(not nd.main)
+        if 1 + n + dups > max_rows:
+            break
+        if n < least:
+            continue
+        a = rows_ms(1 + n_main)
+        ms = a + sib_expert * (rows_ms(1 + n) - a) + dup_ms * dups + slot_ms * extra
+        s = e - rate * ms
+        if best is None or s > best[0] + 1e-12:
+            best = (s, n, ms, e)
+    if best is None:
+        return Plan(0)
+    _, n, ms, e = best
+    sel = list(order[:n])
+    return Plan(sum(1 for o in sel if o.main), chains_of(sel), sel, ms, e)
+
+
+def chains_of(nodes: Sequence[Node]) -> list[tuple[list[int], list[int]]]:
+    """The extra chains of a selected tree: every leaf off the main chain's path, as (tokens from depth 1, node
+    indices), in order of the leaves."""
+
+    has_kid = [False] * len(nodes)
+    for nd in nodes:
+        if nd.parent >= 0:
+            has_kid[nd.parent] = True
+    out = []
+    for ix, nd in enumerate(nodes):
+        if has_kid[ix] or nd.main:
+            continue
+        path, j = [], ix
+        while j >= 0:
+            path.append(j)
+            j = nodes[j].parent
+        path.reverse()
+        out.append(([nodes[j].tok for j in path], path))
+    return out
+
+
+def accepted_len(tokens: Sequence[int], chosen: Sequence[int]) -> int:
+    """Drafts kept of a chain window [pending, d_1 ..] whose rows chose ``chosen``."""
+
+    a = 0
+    for d, c in zip(tokens[1:], chosen):
+        if int(d) != int(c):
+            break
+        a += 1
+    return a
+
+
+def learn(cal: Cal, nodes: Sequence[Node], serial: Sequence[int]) -> None:
+    """Every selected later child (rank >= 1) whose parent's path is the serial prefix: kept iff its token is the
+    serial token at its depth. ``serial``: the round's committed tokens after the pending one."""
+
+    for ix, nd in enumerate(nodes):
+        if nd.rank < 1 or nd.depth > len(serial):
+            continue
+        path, j = [], nd.parent
+        while j >= 0:
+            path.append(nodes[j].tok)
+            j = nodes[j].parent
+        path.reverse()
+        if path == [int(t) for t in serial[:nd.depth - 1]]:
+            cal.record(nd.depth - 1, nd.rank, nd.p, int(serial[nd.depth - 1]) == nd.tok)
+
+
+__all__ = ["Cal", "Expander", "Node", "Plan", "accepted_len", "chains_of", "grow", "learn", "new_chain", "select",
+           "settings"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pdl.py b/src/tensorfold/families/deepseek_v41/cuda/pdl.py
new file mode 100644
index 0000000..a042fb5
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pdl.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Programmatic dependent launch in the decode path (G10, ``TF_DSV41_PDL``; default off until measured).
+
+Why. A 1-row verify window replays ~1,600 kernels (G9 nsys, rank 0). Each pays a launch / ramp / drain whatever its
+work: the floor of a 1-CTA kernel is ~0.8 us, ~0.13 us more between kernels, and a weight streamer's first bytes
+arrive a DRAM round trip after its CTAs start (the dense EXL3 launches fit ``~10 us + bytes / ~220 GB/s``).
+With PDL (sm_90+; GB10 is sm_121) a kernel launched with ``cudaLaunchAttributeProgrammaticStreamSerialization``
+may start while its predecessor runs: its CTAs run up to ``griddepcontrol.wait`` (which returns once every
+prerequisite grid has completed and flushed its memory), so its prologue -- for a weight streamer its first weight
+tiles -- overlaps the predecessor's tail. A primary's ``griddepcontrol.launch_dependents`` lets the dependent launch
+before the primary's CTAs exit (the dependent launches once every primary CTA triggered or exited, so it can never
+take the SM slots of a primary CTA that has not started).
+
+Exactness: PDL only moves time. Every kernel computes the same values from the same inputs: before its wait a
+dependent reads only weights (constant for the life of the engine) and kernel parameters, and writes nothing; after
+the wait it sees every earlier kernel's writes. The rules every PDL kernel here keeps:
+
+1. **Wait before any dependent access**, in every CTA (or at least one CTA, so the grid cannot complete before its
+   predecessor: the chain stays transitive). Nothing is stored before the wait.
+2. **Trigger only after the wait**: so a dependent's pre-wait reads (weights) never overlap a kernel two back that has
+   not completed, and a dependent never starts before its grand-predecessor completed.
+3. Off (``TF_DSV41_PDL=0``) the launches carry no attribute and the Triton kernels compile without the wait (a
+   ``PDL`` constexpr): today's binaries and graphs. ``griddepcontrol.wait`` without the attribute is a no-op anyway.
+4. x3ld (``expert_loads``) reads the grouping (written by upstream's ``group`` kernel) before its wait: safe because
+   the launch right before each grouped launch is upstream's plain ``rot_in`` / ``gateup_epilogue`` (which completes
+   only after ``group``). Those two must stay plain launches.
+
+All of it is graph-capturable (CUDA 12.3+ records programmatic edges); a memcpy / event node between two kernels
+simply makes the edge a full one.
+
+Knob ``TF_DSV41_PDL``: ``0`` (default) | ``1`` / ``all`` | a comma list of parts:
+
+``seg``      x3seg's ``seg_rot_in`` / ``seg_linear`` (the fused x / q / o groups): the first k step of weight words
+             before the wait, the trigger after the k loop (the reduction / epilogue overlaps the next launch's ramp)
+``single``   the unfused EXL3 linears (wo_b, wq_b of non-index layers, the head, Engram's wkv, the indexer's wk, the
+             drafter) as 1-segment x3seg launches (upstream's programs, upstream's bits) so they get ``seg``'s PDL
+``experts``  x3ld's grouped launches (= ``TF_DSV41_EXPERT_LOADS_PDL=1``: its prologue before the wait)
+``triton``   the Triton glue on our side of the window (norms, RoPE, attention, compressor stores, Engram fuse, the
+             indexer's float64 projection): wait + trigger at the top of every program
+
+``TF_DSV41_PDL`` is read at each launch (graphs capture what was on at capture time), so tests can capture an on and
+an off graph in one process.
+"""
+
+from __future__ import annotations
+
+import os
+from functools import cache, lru_cache
+
+ENV = "TF_DSV41_PDL"
+PARTS = ("seg", "single", "experts", "triton")
+OFF = ("", "0", "off", "false", "no", "none")
+
+
+@lru_cache(maxsize=16)
+def parse(raw: str | None) -> frozenset:
+    """The parts a ``TF_DSV41_PDL`` value turns on; a bad value refuses to start rather than running something else."""
+
+    v = (raw or "").strip().lower()
+    if v in OFF:
+        return frozenset()
+    if v in ("1", "all", "on", "true", "yes"):
+        return frozenset(PARTS)
+    parts = [p.strip() for p in v.split(",") if p.strip()]
+    bad = [p for p in parts if p not in PARTS]
+    if bad or not parts:
+        raise ValueError(f"{ENV}={raw!r}: expected 0, 1 / all or a comma list of {', '.join(PARTS)}")
+    return frozenset(parts)
+
+
+def parts(env: dict | None = None) -> frozenset:
+    return parse((os.environ if env is None else env).get(ENV))
+
+
+@cache
+def capable(device: int = 0) -> bool:
+    """sm_90+ (programmatic dependent launch and ``griddepcontrol``)."""
+
+    import torch
+
+    return torch.cuda.is_available() and torch.cuda.get_device_capability(device)[0] >= 9
+
+
+def on(part: str, device: int | None = None, env: dict | None = None) -> bool:
+    """Whether ``part`` launches as programmatic dependents now (knob and device)."""
+
+    if part not in PARTS:
+        raise ValueError(f"pdl.on: unknown part {part!r}")
+    if part not in parts(env):
+        return False
+    import torch
+
+    return capable(torch.cuda.current_device() if device is None else int(device))
+
+
+@lru_cache(maxsize=1)
+def triton_ok() -> bool:
+    """This Triton has ``launch_pdl`` (a CUDA launch option) and ``gdc_wait`` / ``gdc_launch_dependents``."""
+
+    try:
+        from triton.backends.nvidia.compiler import CUDAOptions
+        from triton.language.extra.cuda import gdc_launch_dependents, gdc_wait  # noqa: F401
+    except ImportError:
+        return False
+    return "launch_pdl" in getattr(CUDAOptions, "__dataclass_fields__", {})
+
+
+def triton_kw(device: int | None = None) -> dict:
+    """Launch keywords of a PDL-aware Triton kernel: ``PDL`` (its constexpr: wait + trigger compiled in) and
+    ``launch_pdl`` (the attribute), both on or both off. Off: ``{"PDL": False}``, the kernel's off binary."""
+
+    if os.environ.get("TRITON_INTERPRET") == "1" or not triton_ok() or not on("triton", device):
+        return {"PDL": False}
+    return {"PDL": True, "launch_pdl": True}
+
+
+def prebuild(roots: list, depth: int = 4) -> int:
+    """With the part ``single`` on: build ``fused_proj.single`` for every EXL3 linear reachable from ``roots`` (blocks,
+    the head) now, eagerly, so no 1-segment launch is first built inside a graph capture (``single`` refuses to build
+    there and the matrix keeps upstream's launch in that graph). Returns how many were built."""
+
+    if "single" not in parts():
+        return 0
+    from . import fused_proj as FP
+
+    seen, built = set(), 0
+
+    def walk(o, d):
+        nonlocal built
+        if o is None or id(o) in seen or d < 0 or isinstance(o, (str, bytes, int, float)):
+            return
+        seen.add(id(o))
+        lin = getattr(o, "lin", None)
+        if lin is not None and hasattr(lin, "words"):
+            built += FP.single(lin) is not None
+            return
+        if isinstance(o, (list, tuple)):
+            for x in o:
+                walk(x, d - 1)
+        elif hasattr(o, "__dict__") and not hasattr(o, "data_ptr"):
+            for x in vars(o).values():
+                walk(x, d - 1)
+
+    for r in roots:
+        walk(r, depth)
+    return built
+
+
+try:                                    # the Triton device functions (no-ops when the kernel is not a PDL launch)
+    from triton.language.extra.cuda import gdc_launch_dependents, gdc_wait
+except ImportError:                     # pragma: no cover - an older Triton: PDL never on (triton_ok() is False)
+    gdc_wait = gdc_launch_dependents = None
+
+
+__all__ = ["ENV", "PARTS", "capable", "gdc_launch_dependents", "gdc_wait", "on", "parse", "parts", "prebuild",
+           "triton_kw", "triton_ok"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/phases.py b/src/tensorfold/families/deepseek_v41/cuda/phases.py
new file mode 100644
index 0000000..6587224
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/phases.py
@@ -0,0 +1,140 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Per-phase step timers for the V4.1 serving path: where every millisecond of a round goes.
+
+``TF_DSV41_PHASES``:
+
+- ``0`` (default): off; ``PH("name")`` is a shared no-op context (one attribute read and a call a phase);
+- ``1``: host wall time of each phase (``time.perf_counter``): what the round thread spends, including waits for
+  the GPU at the phases that synchronize (the candidates' D2H copy, the drafts' ``.cpu()``);
+- ``sync``: ``torch.cuda.synchronize()`` at both ends of every phase, so each phase's time is its own GPU work plus
+  its host work, and the phases add up to the round (the A/B of graphs, Engram overlap and exchanges). It removes
+  the overlap it measures: use it to attribute, ``1`` to measure throughput;
+- ``nvtx``: ``1`` plus an NVTX range a phase (nsys timelines: G4's profile step).
+
+Phases nest (``round`` > ``execute`` > ``window`` > ``forward``); a report gives each name's total ms, count and mean,
+and the sum of the top-level phases next to the wall time between ``reset`` and ``report``.
+
+Names used (``batch`` / ``rounds`` / ``decode`` / ``graphs``): round, plan, share, execute, commit, prefill, draft,
+draft.pass, draft.depth, grammar, prefetch, window, engram.wait, forward, graph.stage, graph.replay, graph.capture,
+candidates, nucleus, sample.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from contextlib import nullcontext
+
+ENV = "TF_DSV41_PHASES"
+_NULL = nullcontext()
+
+
+class _Timer:
+    __slots__ = ("ph", "name", "t0")
+
+    def __init__(self, ph: "Phases", name: str) -> None:
+        self.ph, self.name, self.t0 = ph, name, 0.0
+
+    def __enter__(self):
+        if self.ph.sync:
+            self.ph._sync()
+        if self.ph.nvtx:
+            self.ph._nvtx(self.name)
+        self.t0 = time.perf_counter()
+        return self
+
+    def __exit__(self, *exc) -> bool:
+        if self.ph.sync:
+            self.ph._sync()
+        if self.ph.nvtx:
+            self.ph._nvtx(None)
+        self.ph.add(self.name, time.perf_counter() - self.t0)
+        return False
+
+
+class Phases:
+    """The timers (one per process: both ranks keep their own)."""
+
+    def __init__(self, mode: str = "0") -> None:
+        mode = (mode or "0").strip().lower()
+        if mode not in ("0", "1", "sync", "nvtx"):
+            raise ValueError(f"{ENV}={mode!r}: expected 0, 1, sync or nvtx")
+        self.on = mode != "0"
+        self.sync = mode == "sync"
+        self.nvtx = mode == "nvtx"
+        self.total: dict[str, float] = {}
+        self.count: dict[str, int] = {}
+        self.t0 = time.perf_counter()
+
+    @classmethod
+    def from_env(cls) -> "Phases":
+        return cls(os.environ.get(ENV, "0"))
+
+    def __call__(self, name: str):
+        return _Timer(self, name) if self.on else _NULL
+
+    def add(self, name: str, seconds: float) -> None:
+        self.total[name] = self.total.get(name, 0.0) + seconds
+        self.count[name] = self.count.get(name, 0) + 1
+
+    def _nvtx(self, name: str | None) -> None:
+        try:
+            import torch
+
+            if name is None:
+                torch.cuda.nvtx.range_pop()
+            else:
+                torch.cuda.nvtx.range_push(name)
+        except Exception:                               # noqa: BLE001
+            pass
+
+    def _sync(self) -> None:
+        try:
+            import torch
+
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+        except Exception:                               # noqa: BLE001 - a timer must never stop serving
+            pass
+
+    def reset(self) -> None:
+        self.total.clear()
+        self.count.clear()
+        self.t0 = time.perf_counter()
+
+    def report(self) -> dict:
+        """{name: {ms, n, ms_avg}} plus ``wall_ms`` since the reset and ``mode``."""
+
+        out: dict = {"mode": "sync" if self.sync else ("nvtx" if self.nvtx else ("1" if self.on else "0")),
+                     "wall_ms": round((time.perf_counter() - self.t0) * 1e3, 2)}
+        for name in sorted(self.total):
+            n = self.count[name]
+            ms = self.total[name] * 1e3
+            out[name] = {"ms": round(ms, 2), "n": n, "ms_avg": round(ms / max(n, 1), 3)}
+        return out
+
+    def describe(self) -> str:
+        if not self.on:
+            return "phases off"
+        r = self.report()
+        rounds = r.get("round", {}).get("n", 0)
+        keys = [k for k in r if isinstance(r[k], dict)]
+        per = ", ".join(f"{k} {r[k]['ms'] / max(rounds, 1):.2f}" for k in keys)
+        return f"phases ({r['mode']}, ms a round over {rounds} rounds): {per}"
+
+
+PH = Phases.from_env()
+
+
+def reload() -> Phases:
+    """Re-read TF_DSV41_PHASES (tests, benches that set it after import)."""
+
+    global PH
+    new = Phases.from_env()
+    PH.on, PH.sync, PH.nvtx = new.on, new.sync, new.nvtx
+    PH.reset()
+    return PH
+
+
+__all__ = ["ENV", "PH", "Phases", "reload"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pick.py b/src/tensorfold/families/deepseek_v41/cuda/pick.py
new file mode 100644
index 0000000..10cd142
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pick.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Logits as the kit sees them, and a top-k whose ties go to the lower token id.
+
+The kit's head (an EXL3 linear) returns bf16 logits, and vLLM's greedy sampler takes their ``argmax``: the first
+(lowest) id among equal values. Its ``prompt_logprobs`` show it: every top-1 / top-2 margin is a multiple of 1/16
+(G2: 0, 0.125, 0.25, ... 1.5625), and at all 8 exact ties among G2's first-copy misses the kit took the lower id while
+our fp32 logits took the higher one. So the forward rounds the head's output to bf16 (``numerics.LOGITS``) and every
+choice uses ``top``: value descending, then id ascending, whatever the kernel's own tie order.
+
+``keys`` maps bf16-valued fp32 logits to int32 keys that sort the same way: the float's order-preserving integer image
+with its low 16 bits (zero for bf16 values) replaced by ``65535 - column``. A rank's vocabulary half (64,640 columns)
+fits; wider rows (one-rank tests with a large vocabulary, or float64 logits of the exact twins) take a stable sort.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from . import numerics as N
+
+COLS = 1 << 16
+
+
+def kit_logits(x: torch.Tensor) -> torch.Tensor:
+    """The head's fp32 output rounded through ``numerics.LOGITS`` (bf16; float64 = unchanged in ``exact()``)."""
+
+    if N.LOGITS == x.dtype or N.LOGITS == N.ACC:
+        return x
+    return x.to(N.LOGITS).to(x.dtype)
+
+
+def keys(lg: torch.Tensor) -> torch.Tensor:
+    """int32 [R, C] keys of bf16-valued fp32 logits [R, C]: larger key = larger value, then lower column."""
+
+    bits = (lg + 0.0).contiguous().view(torch.int32)          # -0.0 + 0.0 = +0.0: equal values, equal keys
+    mono = torch.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+    col = torch.arange(lg.shape[-1], device=lg.device, dtype=torch.int32)
+    return (mono & -COLS) | (COLS - 1 - col)
+
+
+def _bf16_valued(lg: torch.Tensor) -> bool:
+    """fp32 logits the forward rounded (``kit_logits`` with LOGITS = bf16), on 16-bit columns (no device sync)."""
+
+    return lg.dtype == torch.float32 and N.LOGITS == torch.bfloat16 and lg.shape[-1] <= COLS
+
+
+def top(lg: torch.Tensor, k: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """(values, columns) of each row's best ``k``: value descending, ties by the lower column. ``lg`` must come from
+    ``kit_logits`` (or be any float tensor when LOGITS is not bf16: a stable sort then)."""
+
+    k = min(int(k), lg.shape[-1])
+    if _bf16_valued(lg):
+        _, cols = torch.topk(keys(lg), k, dim=-1)
+    else:
+        _, cols = torch.sort(lg, dim=-1, descending=True, stable=True)
+        cols = cols[..., :k]
+    return torch.gather(lg, -1, cols), cols
+
+
+def argmax(lg: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """(value, column) of each row's maximum, the lowest column among equal values."""
+
+    v, c = top(lg, 1)
+    return v[..., 0], c[..., 0]
+
+
+def kit_partial(x: torch.Tensor) -> torch.Tensor:
+    """A rank's fp32 partial (attention ``wo_b``, the MoE) as the kit exchanges it: bf16 (vLLM's row-parallel output
+    before its bf16 all-reduce; the mHC boundary then rounds the sum to bf16 as the all-reduce does). Unchanged when
+    ``numerics.KIT_ROUNDING`` is off (and in ``exact()``)."""
+
+    if not N.KIT_ROUNDING or x.dtype != torch.float32:
+        return x
+    return x.to(torch.bfloat16).to(torch.float32)
+
+
+def kit_weights(w: torch.Tensor) -> torch.Tensor:
+    """Routed expert weights (renormalized x 1.5) as the kit's EXL3 expert kernels take them: fp16."""
+
+    if not N.KIT_ROUNDING or w.dtype not in (torch.float32, torch.float64):
+        return w
+    return w.to(torch.float16).to(w.dtype)
+
+
+__all__ = ["argmax", "keys", "kit_logits", "kit_partial", "kit_weights", "top"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
new file mode 100644
index 0000000..53d1f75
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``linear.Plain`` (the indexer's ``weights_proj``, [32, 5,120] bf16) in float64 sums as one Triton launch (G4).
+
+The torch form ``x.double() @ w.double().t()`` runs cuBLAS's DGEMM: at decode widths (1-16 rows) it launches a
+split-K kernel with 5 thread blocks, ~275 us a call on sm_121 (the GPU's float64 rate is low), plus a 320-block
+conversion of the weight: G4's nsys put ~2.2 ms of every verify window there (8 calls). Here one program a (row,
+output) loads the row and the weight row, multiplies in float64 (bf16 / fp32 values widen exactly, so every product
+is exact) and adds them in a fixed order: ``BK`` lanes accumulate k ascending in steps of ``BK``, then the lanes are
+summed by ``tl.sum``'s fixed tree. That order depends on K alone, never on the number of rows, so a row's value is
+the same alone, in a verify window or in a prefill chunk (cuBLAS's split-K choice depends on M).
+
+The sums are float64 like the torch form's; they may differ from cuBLAS's in the last float64 bits (another
+order), which the caller's rounding to fp32 / bf16 hides except at a rounding tie of probability ~2^-29 a value.
+``TF_DSV41_PLAIN_TRITON`` (1 = on) selects it on CUDA; the CPU twin and every other device keep the torch form.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+BK = 256
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_PLAIN_TRITON", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _plain(X, x_rs, W, w_rs, OUT, K, N, BK: tl.constexpr, PDL: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    n = tl.program_id(1)
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    xr = X + r.to(tl.int64) * x_rs
+    wr = W + n.to(tl.int64) * w_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        xv = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        wv = tl.load(wr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += xv * wv
+    tl.store(OUT + r.to(tl.int64) * N + n, tl.sum(acc, axis=0))
+
+
+def matmul_t(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """x [M, K] (any float dtype), w [N, K] -> float64 [M, N] = x @ w.T in float64 sums, row-invariant."""
+
+    if x.stride(-1) != 1:
+        x = x.contiguous()
+    if w.stride(-1) != 1:
+        w = w.contiguous()
+    M, K = x.shape
+    N = w.shape[0]
+    out = torch.empty((M, N), dtype=torch.float64, device=x.device)
+    if M:
+        _plain[(M, N)](x, x.stride(0), w, w.stride(0), out, K, N, BK=BK, num_warps=2, **P.triton_kw())
+    return out
+
+
+def eligible(x: torch.Tensor, w: torch.Tensor) -> bool:
+    return (x.is_cuda and x.dim() == 2 and w.dim() == 2 and w.device == x.device and x.shape[1] == w.shape[1]
+            and enabled())
+
+
+__all__ = ["BK", "eligible", "enabled", "matmul_t"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/plan.py b/src/tensorfold/families/deepseek_v41/cuda/plan.py
new file mode 100644
index 0000000..7354f73
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/plan.py
@@ -0,0 +1,127 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A round plan of the V4.1 batcher: what rank 0 decided for one round and both ranks execute in the same order
+(GLM ``batchplan``'s protocol: rank 0 plans, shares, both execute; the plan is the only thing rank 1 learns).
+
+Execution order (``rounds.Executor.run``), every step on both ranks:
+
+1. ``commits``  the previous round's windows: (slot, accepted, bonus) -> ``Forward.commit``; the slot's history
+                grows by the kept rows; rank 1's grammar follows the chosen tokens;
+2. ``finishes`` (slot, save, cancelled): a turn-end snapshot into the session store when ``save``, then the slot's
+                pages are released;
+3. ``spills``   session entries let go of (parked to NVMe or dropped) so admissions find their pages;
+4. ``admits``   a request in a slot: page reservation, ``Forward.reset``, a session restore (RAM or NVMe) when
+                ``tier`` is set (``cached`` prompt tokens skipped), the request's grammar;
+5. ``pieces``   prefill pieces (slot, start, end) of several slots in one ``Forward.prefill`` (GLM 0560);
+6. ``saves``    prompt snapshots at the replay point (the slot sits at it after its piece);
+7. ``finals``   ``Forward.finish_prompt`` for slots whose prompt is done (CED replay);
+8. ``windows``  (slot, start, pending, depth, drafts, noise, nucleus): drafts from ``Forward.draft`` when depth > 0
+                (DSpark, both ranks, keyed by ``noise``) or the plan's own (host lookup drafts), cut by the slot's
+                grammar, masks filled, the Engram reads issued (``Forward.prefetch``), one ``Forward.window`` (top-p
+                rows' specs in ``nucleus``).
+
+Encoding: a list of ints for the communicator (GLM ``_share``): [MAGIC, json bytes, *json words (3 bytes an int),
+prompt count, (slot, n, *ids) ...]. Prompts travel once, at admission, as raw ids.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import asdict, dataclass, field
+
+from .protocol import pack_bytes, unpack_bytes
+
+MAGIC = 0x0D541
+VERSION = 1
+
+
+@dataclass
+class Admit:
+    slot: int
+    prompt: list[int]
+    max_tokens: int
+    tier: str = ""                  # "" | ram | disk
+    key: str = ""
+    cached: int = 0
+    quota: int = 0                  # pool pages reserved for the request
+    grammar: list[int] | None = None   # GLM ``grammar.pack(bound)`` (rank 1 compiles it)
+    job: int = 0
+
+
+@dataclass
+class WindowSpec:
+    slot: int
+    start: int
+    pending: int
+    depth: int = 0                  # DSpark depth (Forward.draft on both ranks)
+    drafts: list[int] = field(default_factory=list)    # host drafts (lookup), used when depth == 0
+    noise: list = field(default_factory=list)          # keyed draft noise (lookup.noise_of): [] = greedy drafts
+    nucleus: list = field(default_factory=list)        # [T, top_p, min_p]: top-p rows from candidates (nucleus.py)
+
+
+@dataclass
+class Plan:
+    round: int = 0
+    mode: str = "full"
+    count: int = 1                  # candidates a verify row
+    commits: list[tuple[int, int, int]] = field(default_factory=list)
+    finishes: list[tuple[int, bool, bool]] = field(default_factory=list)
+    spills: list[str] = field(default_factory=list)
+    admits: list[Admit] = field(default_factory=list)
+    pieces: list[tuple[int, int, int]] = field(default_factory=list)
+    saves: list[int] = field(default_factory=list)
+    finals: list[int] = field(default_factory=list)
+    windows: list[WindowSpec] = field(default_factory=list)
+    stop: bool = False
+
+    def empty(self) -> bool:
+        return not (self.commits or self.finishes or self.spills or self.admits or self.pieces or self.saves
+                    or self.finals or self.windows or self.stop)
+
+    def encode(self) -> list[int]:
+        d = asdict(self)
+        prompts = [(a["slot"], a.pop("prompt")) for a in d["admits"]]
+        data = json.dumps(d, separators=(",", ":")).encode()
+        words = pack_bytes(data)
+        out = [MAGIC, VERSION, len(data), len(words), *words, len(prompts)]
+        for slot, ids in prompts:
+            out += [int(slot), len(ids), *(int(t) for t in ids)]
+        return out
+
+    @classmethod
+    def decode(cls, ints: list[int]) -> Plan:
+        ints = [int(v) for v in ints]
+        if len(ints) < 5 or ints[0] != MAGIC or ints[1] != VERSION:
+            raise ValueError("not a V4.1 round plan (or another version)")
+        n, nw = ints[2], ints[3]
+        d = json.loads(unpack_bytes(ints[4:4 + nw], n))
+        i = 4 + nw
+        count = ints[i]
+        i += 1
+        prompts = {}
+        for _ in range(count):
+            slot, k = ints[i], ints[i + 1]
+            prompts[slot] = ints[i + 2:i + 2 + k]
+            i += 2 + k
+        if i != len(ints):
+            raise ValueError("round plan: trailing ints")
+        admits = [Admit(prompt=prompts[a["slot"]], **a) for a in d.pop("admits")]
+        windows = [WindowSpec(**w) for w in d.pop("windows")]
+        p = cls(**d)
+        p.admits, p.windows = admits, windows
+        p.commits = [tuple(c) for c in p.commits]
+        p.finishes = [tuple(f) for f in p.finishes]
+        p.pieces = [tuple(x) for x in p.pieces]
+        return p
+
+
+def piece_end(done: int, target: int, budget: int, grid: int) -> int:
+    """The end of a slot's next prefill piece from ``done`` toward ``target`` with ``budget`` rows: ``target`` when
+    it fits, else the last grid point within the budget (at least one grid step: a piece is never empty)."""
+
+    if target - done <= budget:
+        return target
+    end = (done + budget) // grid * grid
+    if end <= done:
+        end = min(target, (done // grid + 1) * grid)
+    return end
diff --git a/src/tensorfold/families/deepseek_v41/cuda/planlink.py b/src/tensorfold/families/deepseek_v41/cuda/planlink.py
new file mode 100644
index 0000000..de5dd10
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/planlink.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The round plan from rank 0 to rank 1 over a TCP socket instead of the communicator (``TF_DSV41_PLAN_LINK=tcp``).
+
+Why: ``engine._Link`` shares each plan with two all-gathers on the GPU stream (its length, then its ints), each
+followed by a ``.tolist()``: ~0.74 ms of rank 0's host a round (G7 C1), and because the gathers queue behind
+whatever the stream holds, a plan could never be sent while the GPU still works (the speculative DSpark pass,
+``spec.py``). Rank 1's host waits ~12 ms a round inside that gather kernel for rank 0's host work.
+
+How: one TCP connection between the ranks (rank 0 listens on ``TF_DSV41_PLAN_PORT``, default the rendezvous port +
+7, rank 1 connects to the master address), ``TCP_NODELAY``, one frame a plan: a 4-byte length, then the plan's ints
+as little-endian int64 (``array('q')``: no Python loop). Host only: nothing waits on the GPU, the plan arrives
+while both GPUs still run. The plan is the same list of ints as before (``plan.Plan.encode``), so the protocol, its
+order and rank 1's decisions are unchanged; a closed connection raises on both sides (rank 1 stops instead of
+hanging in a collective).
+
+Knobs: TF_DSV41_PLAN_LINK (nccl: the communicator, default; tcp), TF_DSV41_PLAN_PORT, TF_DSV41_PLAN_TIMEOUT
+(connect / accept seconds, 300).
+"""
+
+from __future__ import annotations
+
+import os
+import socket
+import struct
+import time
+from array import array
+
+ENV = "TF_DSV41_PLAN_LINK"
+_LEN = struct.Struct("<I")
+
+
+def mode() -> str:
+    v = (os.environ.get(ENV, "nccl").strip().lower() or "nccl")
+    if v not in ("nccl", "tcp"):
+        raise ValueError(f"{ENV}={v!r}: expected nccl or tcp")
+    return v
+
+
+def port_for(master_port: int) -> int:
+    raw = os.environ.get("TF_DSV41_PLAN_PORT", "").strip()
+    return int(raw) if raw else int(master_port) + 7
+
+
+class TcpLink:
+    """``protocol.Link`` over one TCP connection: rank 0 ``send``s, rank 1 ``recv``s."""
+
+    def __init__(self, rank: int, host: str, port: int, *, timeout_s: float | None = None) -> None:
+        self.rank = int(rank)
+        timeout_s = float(os.environ.get("TF_DSV41_PLAN_TIMEOUT", "") or 300) if timeout_s is None else timeout_s
+        self.sent = self.received = 0
+        if self.rank == 0:
+            srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            srv.bind(("", int(port)))
+            srv.listen(1)
+            srv.settimeout(timeout_s)
+            try:
+                conn, _ = srv.accept()
+            finally:
+                srv.close()
+        else:
+            end = time.monotonic() + timeout_s
+            while True:
+                try:
+                    conn = socket.create_connection((host, int(port)), timeout=5.0)
+                    break
+                except OSError:
+                    if time.monotonic() > end:
+                        raise
+                    time.sleep(0.05)
+        conn.settimeout(None)
+        conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+        self.conn = conn
+
+    def send(self, plan) -> None:
+        body = array("q", plan).tobytes()
+        self.conn.sendall(_LEN.pack(len(body)) + body)
+        self.sent += 1
+
+    def _exact(self, n: int) -> bytes:
+        buf = bytearray(n)
+        view, got = memoryview(buf), 0
+        while got < n:
+            k = self.conn.recv_into(view[got:], n - got)
+            if not k:
+                raise ConnectionError("plan link: rank 0 closed the connection")
+            got += k
+        return bytes(buf)
+
+    def recv(self) -> list[int]:
+        (n,) = _LEN.unpack(self._exact(_LEN.size))
+        out = array("q")
+        out.frombytes(self._exact(n))
+        self.received += 1
+        return out.tolist()
+
+    def close(self) -> None:
+        try:
+            self.conn.close()
+        except OSError:
+            pass
+
+
+def make(engine_link, rank: int, master: str, master_port: int):
+    """The batcher's link: ``engine_link`` (the communicator's) unless TF_DSV41_PLAN_LINK=tcp."""
+
+    if mode() != "tcp":
+        return engine_link
+    return TcpLink(rank, master, port_for(master_port))
+
+
+__all__ = ["ENV", "TcpLink", "make", "mode", "port_for"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pool.py b/src/tensorfold/families/deepseek_v41/cuda/pool.py
new file mode 100644
index 0000000..8d355c0
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pool.py
@@ -0,0 +1,263 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The KV pool's cache families for DeepSeek-V4.1-Flash, on our GLM pool (patch 0290: ``glm5_next/spark/kvpool.py``,
+``PoolBook`` / ``SlotPages`` / ``Paged``; upstream PR 3's ``PagedPool``).
+
+What is paged (it grows with the context; shared by the request slots, admitted by pages):
+
+| family          | layers          | rows a token | row bytes                         |
+| --- | --- | --- | --- |
+| ``comp``        | kv sources 2/8/14 (ratio 2), 20 (ratio 1) | 1 / ratio | 576 values + 8 scales (``csa2.rows``) |
+| ``index_k``     | the same four   | 1 / ratio    | 256 (bf16 x 128) or 132 (``TF_DSV41_INDEX_KV=fp8``, later) |
+
+A page holds ``page`` tokens of every family (rows per page = page / ratio), so one page table a slot serves every
+kernel (``rows.prow``: PT / PSH per family, PSH = log2 rows a page). Pages are aligned to 16 tokens: the snapshot
+grid (ratio 2 x candidate block 8), so a page boundary never splits a compressed group or a candidate block.
+
+What is not paged (bounded, per slot, ``state.SlotState``): the 40 + 3 SWA rings, the compressor carries, the Engram
+lookback, the DSpark tap window.
+
+**Shared pages** (the session store's RAM tier, GLM 0310's prefix share without copies): a session entry keeps the
+pages below its length mapped; a request resuming it adopts the entry's *full* pages (read only: a slot writes only
+positions >= its resume point, which lie past them) and gets a copy of the partial last page (copy on write). A page
+returns to the free list when its last holder (slot or entry) lets go. Parking an entry to NVMe (``sessdisk``)
+writes its pages and lets go of them: that is how the pool makes room (``batch.Batcher``'s spills).
+
+Allocation is deterministic (lowest free page first, GLM ``PageAlloc``): both ranks make the same calls in the same
+order (the round plan), so their pools stay identical.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any
+
+from tensorfold.families.glm5_next.spark import kvpool
+
+from . import protocol as RW  # the FP8 row record's sizes (csa2.rows: 584 = 576 + 8)
+from .topology import Topology
+
+PAGE = 256                 # tokens a page (GLM's default): 128 rows of a ratio-2 family
+GRID = 16                  # snapshot / page alignment in tokens
+INDEX_ROW = {"bf16": 256, "fp8": 132}
+SLACK = kvpool.DEFAULT_SLACK            # tokens past prompt + max_tokens a request may write (verify windows)
+POOL_ENV = "TF_DSV41_POOL_TOKENS"
+
+
+@dataclass(frozen=True)
+class Family:
+    name: str              # "comp.2", "index_k.20", ...
+    layer: int
+    ratio: int
+    row_bytes: int
+
+    def rows(self, tokens: int) -> int:
+        return tokens // self.ratio
+
+    def page_rows(self, page: int = PAGE) -> int:
+        return page // self.ratio
+
+    def bytes_per_token(self) -> float:
+        return self.row_bytes / self.ratio
+
+
+def families(topo: Topology, index_kv: str = "bf16") -> list[Family]:
+    out = []
+    for ly in topo.layers:
+        if ly.role != "full":
+            continue
+        out.append(Family(f"comp.{ly.index}", ly.index, ly.ratio, RW.ROW_BYTES))
+        out.append(Family(f"index_k.{ly.index}", ly.index, ly.ratio, INDEX_ROW[index_kv]))
+    return out
+
+
+def bytes_per_token(topo: Topology, index_kv: str = "bf16") -> float:
+    """Pool bytes one context token costs on each rank (the single KV head: every rank holds whole rows)."""
+
+    return sum(f.bytes_per_token() for f in families(topo, index_kv))
+
+
+def pool_tokens(streams: int, context: int, slack: int = SLACK, page: int = PAGE) -> int:
+    """Tokens the pool must hold for ``streams`` active streams at ``context`` each (+ verify / draft slack),
+    rounded up to whole pages a stream."""
+
+    per = -(-(context + slack) // page) * page
+    return streams * per
+
+
+def pool_bytes(topo: Topology, streams: int, context: int, index_kv: str = "bf16", page: int = PAGE) -> int:
+    toks = pool_tokens(streams, context, page=page)
+    return int(sum(f.row_bytes * (toks // f.ratio) for f in families(topo, index_kv)))
+
+
+def settings(streams: int, context: int) -> int:
+    """TF_DSV41_POOL_TOKENS (default: ``streams`` x ``context`` + slack, whole pages a stream), a page multiple."""
+
+    raw = os.environ.get(POOL_ENV, "").strip()
+    tokens = int(raw) if raw else pool_tokens(streams, context)
+    if tokens <= 0:
+        raise ValueError(f"{POOL_ENV}={raw!r}: expected a positive token count")
+    return -(-tokens // PAGE) * PAGE
+
+
+# -- slots with shared pages ------------------------------------------------------------------------------------------
+class Slot(kvpool.SlotPages):
+    """A slot's page table (GLM ``SlotPages``) whose leading pages may be shared with session entries."""
+
+    pool: Pool
+
+    def adopt(self, pages: list[int]) -> None:
+        """Map shared ``pages`` as the slot's first pages (an empty slot; the store's resume)."""
+
+        if self.pages:
+            raise ValueError("adopt: the slot already maps pages")
+        if len(pages) > self.max_pages:
+            raise ValueError("adopt: past the slot's capacity")
+        self.pool.share(pages)
+        self.pages.extend(int(p) for p in pages)
+        self._write(0, list(self.pages))
+
+    def truncate(self, keep: int) -> int:
+        k = kvpool.pages_for(keep, self.page)
+        if k >= len(self.pages):
+            return 0
+        drop = self.pages[k:]
+        del self.pages[k:]
+        self.pool.drop(drop)
+        self._write(k, [self.pool.null] * len(drop))
+        return len(drop)
+
+    def release(self) -> int:
+        self.quota = None
+        self.over = 0
+        return self.truncate(0)
+
+
+class Pool(kvpool.PoolBook):
+    """The V4.1 pool: one physical tensor a family ([(npages + 1) x page rows, row bytes]; the last page is GLM's null
+    page), shared pages with holder counts, the slots' tables. ``device="meta"`` sizes it without memory (tests,
+    the load-time budget)."""
+
+    def __init__(self, topo: Topology, tokens: int, page: int = PAGE, *, index_kv: str = "bf16",
+                 device: Any = "cpu", slack: int = SLACK) -> None:
+        import torch
+
+        if tokens % page:
+            raise ValueError(f"pool of {tokens} tokens: not a multiple of the {page}-token page")
+        super().__init__(tokens // page, page)
+        self.topo = topo
+        self.slack = int(slack)
+        self.device = torch.device(device)
+        self.fams = families(topo, index_kv)
+        self.extra: dict[int, int] = {}           # page -> holders past the first
+        self.phys: dict[str, Any] = {}
+        for f in self.fams:
+            rows = (self.npages + 1) * f.page_rows(page)
+            if f.name.startswith("index_k") and index_kv == "bf16":
+                self.phys[f.name] = torch.zeros((rows, f.row_bytes // 2), dtype=torch.bfloat16, device=self.device)
+            else:
+                self.phys[f.name] = torch.zeros((rows, f.row_bytes), dtype=torch.uint8, device=self.device)
+        self._torch = torch
+
+    # holders
+    def share(self, pages) -> None:
+        for p in pages:
+            self.extra[int(p)] = self.extra.get(int(p), 0) + 1
+
+    def drop(self, pages) -> None:
+        back = []
+        for p in pages:
+            p = int(p)
+            n = self.extra.get(p, 0)
+            if n:
+                if n == 1:
+                    del self.extra[p]
+                else:
+                    self.extra[p] = n - 1
+            else:
+                back.append(p)
+        if back:
+            self.alloc.give(back)
+
+    def holders(self, page: int) -> int:
+        return 1 + self.extra.get(int(page), 0)
+
+    # slots and views
+    def new_slot(self, capacity: int) -> Slot:
+        table = None
+        if self.device.type != "meta":
+            mp = kvpool.pages_for(capacity, self.page)
+            table = self._torch.full((mp,), self.null, dtype=self._torch.int32, device=self.device)
+        sp = Slot(self, capacity, table)
+        self.slots.append(sp)
+        return sp
+
+    def family(self, name: str) -> Family:
+        for f in self.fams:
+            if f.name == name:
+                return f
+        raise KeyError(name)
+
+    def view(self, slot: Slot, name: str) -> kvpool.Paged:
+        """A family's rows as the slot sees them (GLM ``Paged``: logical row r -> its page's physical row)."""
+
+        f = self.family(name)
+        return kvpool.Paged(self.phys[name], slot, f.page_rows(self.page), slot.capacity // f.ratio)
+
+    def take(self, k: int) -> list[int]:
+        return self.alloc.take(k)
+
+    def copy_page(self, src: int, dst: int) -> None:
+        for f in self.fams:
+            per = f.page_rows(self.page)
+            t = self.phys[f.name]
+            t[dst * per:(dst + 1) * per].copy_(t[src * per:(src + 1) * per])
+
+    def read_pages(self, pages: list[int]) -> dict[str, Any]:
+        """{family: host uint8 [len(pages) x page rows, row bytes]} (the NVMe tier's park)."""
+
+        out = {}
+        for f in self.fams:
+            per = f.page_rows(self.page)
+            t = self.phys[f.name]
+            idx = self._torch.tensor([p * per + r for p in pages for r in range(per)], dtype=self._torch.long,
+                                     device=self.device)
+            rows = t.index_select(0, idx).contiguous().cpu()
+            out[f.name] = rows.view(self._torch.uint8).numpy().reshape(len(idx), f.row_bytes)
+        return out
+
+    def write_pages(self, pages: list[int], data: dict[str, Any]) -> None:
+        """``read_pages``' output back into ``pages`` (the NVMe tier's resume)."""
+
+        torch = self._torch
+        for f in self.fams:
+            per = f.page_rows(self.page)
+            t = self.phys[f.name]
+            src = torch.from_numpy(data[f.name].reshape(len(pages) * per, f.row_bytes).copy()).to(self.device)
+            src = src.view(t.dtype).reshape(len(pages) * per, *t.shape[1:])
+            idx = torch.tensor([p * per + r for p in pages for r in range(per)], dtype=torch.long, device=self.device)
+            t.index_copy_(0, idx, src)
+
+    # accounting
+    def nbytes(self) -> int:
+        return int(sum(t.numel() * t.element_size() for t in self.phys.values()))
+
+    def page_bytes(self) -> int:
+        return int(sum(f.row_bytes * f.page_rows(self.page) for f in self.fams))
+
+    def need_pages(self, prompt: int, max_tokens: int, capacity: int) -> int:
+        return kvpool.pages_for(kvpool.need_tokens(prompt, max_tokens, capacity, self.slack), self.page)
+
+    def entry_pages(self) -> int:
+        """Pages held by nothing but session entries (what parking can free)."""
+
+        mapped = {p for s in self.slots for p in s.pages}
+        return self.npages - self.alloc.n_free - len(mapped)
+
+    def null_clean(self) -> bool:
+        for f in self.fams:
+            per = f.page_rows(self.page)
+            if bool(self.phys[f.name][self.null * per:(self.null + 1) * per].ne(0).any()):
+                return False
+        return True
