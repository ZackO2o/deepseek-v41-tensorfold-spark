+def _dsv41_interp_selected(config: pytest.Config) -> bool:
+    """Whether the session runs DeepSeek-V4.1's Triton-interpreter tests (``test_dsv41_*_interp.py``). Triton reads
+    TRITON_INTERPRET when a function is decorated, triton.language's own ``@jit`` library (``tl.sum``, ``tl.max`` ...)
+    included, so the interpreter must be on before the first ``import triton``: a module's own ``interpret()`` is
