index 0000000..da684c3
--- /dev/null
+++ b/tests/test_dsv41_engram_interp.py
@@ -0,0 +1,181 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram kernels (families/deepseek_v41/cuda/engram.py) in Triton's CPU interpreter with the ``gpu_like`` model:
+
+- dequant == the reference's ``bf16(fp8_e4m3_dequant(...))`` bit for bit over every e4m3 byte and hard scales
+  (0, subnormal results, 2^127), a rank's 12 heads at their column offset;
+- fusion: the update == ``bf16(x + gate * value)`` bit for bit given the kernel's gates, the gates within 1e-6 of the
+  torch formula on the kernel's FMA-chain sums; image tokens (keep 0) leave the row's bits unchanged;
+- row invariance (a row alone == the row in a window, bit for bit);
+- the whole path (host hash -> records -> dequant -> wkv -> fusion) against the forward's float64 fallback
+  (seams.engram_fuse_torch over engram_host's rows); ``Tables.rows`` == ``engram_host.NgramHasher`` (chunks with the
+  carried lookback == whole); ``Prefetch`` over packed shards lands the files' bytes.
+
+Run: python -m pytest -q tests/test_dsv41_engram_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+import dsv41_kref as KR
+
+from tensorfold.families.deepseek_v41.cuda import engram
+
+K = engram
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(K._fuse).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+NAN_BYTES = (0x7F, 0xFF)
+
+
+def _bits(t):
+    return t.contiguous().view(-1).view(torch.uint8)
+
+
+def _records(R: int, H: int, seed: int, hard: bool = False) -> torch.Tensor:
+    g = np.random.default_rng(seed)
+    v = g.integers(0, 256, size=(R, H, 256), dtype=np.uint8)
+    v[np.isin(v, NAN_BYTES)] = 0x38
+    s = g.integers(118, 136, size=(R, H, 8), dtype=np.uint8)
+    if hard:
+        v[0, 0] = np.array([b for b in range(256) if b not in NAN_BYTES] + [0, 0], dtype=np.uint8)
+        s[0, 1] = [0, 1, 2, 127, 200, 250, 254, 3]       # zero scale, fp32 subnormal products, huge
+        s[0, 2] = 1
+        v[0, 2, :8] = [1, 2, 7, 8, 0x80, 0x81, 0x87, 0x88]  # e4m3 subnormals and signed zeros
+    return torch.from_numpy(np.concatenate([v, s], axis=2)).contiguous()
+
+
+def test_dequant_bits():
+    raw = _records(5, 12, 1, hard=True)
+    out = torch.zeros((5, 24 * 256), dtype=torch.bfloat16)
+    engram.dequant(raw, out, col0=12)
+    want = KR.engram_dequant(raw)
+    assert torch.equal(_bits(out[:, 12 * 256:]), _bits(want))
+    assert bool((out[:, :12 * 256] == 0).all())
+    nan = raw.clone()
+    nan[1, 3, 5] = 0x7F
+    engram.dequant(nan, out, col0=12)
+    assert bool(torch.isnan(out[1, (12 + 3) * 256 + 5]))
+
+
+def _fuse_case(R: int, d: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    kv = (torch.randn((R, 5 * d), generator=g) * 0.5).to(torch.bfloat16)
+    kv[0, :d] = x[0, :d]                                 # a large positive dot on (row 0, stream 0)
+    kv[1, d:2 * d] = -x[1, d:2 * d]                      # a negative one
+    q = torch.rand((4, d), generator=g) + 0.5
+    k = torch.rand((4, d), generator=g) + 0.5
+    return x, kv, engram.qk_weights(q, k)
+
+
+def test_fuse_against_emulation():
+    d = 5120
+    x, kv, qk = _fuse_case(3, d, 2)
+    keep = torch.tensor([1.0, 1.0, 0.0])
+    xo = x.clone()
+    gate = torch.zeros((3, 4))
+    engram.fuse(xo, kv, qk, keep, gate)
+    torch.testing.assert_close(gate, KR.engram_gates(x, kv, qk, keep), rtol=1e-6, atol=1e-6)
+    assert torch.equal(_bits(xo), _bits(KR.engram_apply(x, kv, gate)))
+    assert torch.equal(_bits(xo[2]), _bits(x[2]))         # an image token: unchanged
+    assert float(gate[0, 0]) > 0.5 and float(gate[1, 1]) < 0.5
+
+
+def test_fuse_row_invariance():
+    d = 1024
+    x, kv, qk = _fuse_case(7, d, 3)
+    xo = x.clone()
+    engram.fuse(xo, kv, qk)
+    for r in (0, 4, 6):
+        one = x[r:r + 1].clone()
+        engram.fuse(one, kv[r:r + 1].clone(), qk)
+        assert torch.equal(_bits(one), _bits(xo[r:r + 1])), r
+
+
+def test_path_against_torch_fallback():
+    from tensorfold.families.deepseek_v41.cuda import seams
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+    from tensorfold.families.deepseek_v41.cuda.engram_host import NgramHasher
+
+    d = 1024
+    cfg = Config()
+    tm = np.random.default_rng(4).integers(0, cfg.engram_compressed_vocab_size, size=cfg.vocab_size)
+    t = engram.Tables.from_config(cfg, tm)
+    bank = _records(1, 4099, 5)[0]                      # 4,099 records stand in for the 384M-row table
+    g = torch.Generator().manual_seed(6)
+    w = torch.randn((5 * d, 24 * 256), generator=g) * 0.02
+    q = torch.rand((4, d), generator=g) + 0.5
+    k = torch.rand((4, d), generator=g) + 0.5
+    ids = torch.randint(0, cfg.vocab_size, (6,), generator=g)
+    dead = torch.tensor([False, False, True, False, False, False])
+    hashes = torch.from_numpy(t.rows(ids.numpy(), dead.numpy()))
+    assert torch.equal(hashes, NgramHasher(cfg, tm)(ids, dead))
+    raw = bank[hashes[:, 0].reshape(-1) % 4099].view(6, 24, 264).contiguous()
+    e = torch.zeros((6, 24 * 256), dtype=torch.bfloat16)
+    engram.dequant(raw, e)
+    assert torch.equal(_bits(e), _bits(KR.engram_dequant(raw)))
+    kv = (e.float() @ w.T).to(torch.bfloat16)
+    x = torch.randn((6, 4 * d), generator=g).to(torch.bfloat16)
+    qk = engram.qk_weights(q, k)
+    want = seams.engram_fuse_torch(x.clone(), kv, qk, (~dead).float())
+    got = engram.fuse(x.clone(), kv, qk, ~dead)                            # a bool mask is taken as 1 / 0
+    assert torch.equal(got[2], x[2])
+    torch.testing.assert_close(got.float(), want.float(), rtol=2 ** -7, atol=1e-6)
+
+
+def test_tables_chunks_and_prefetch(tmp_path):
+    from tensorfold.families.deepseek_v41.cuda.config import Config, tiny_config
+    from tensorfold.families.deepseek_v41.cuda.engram_host import NgramHasher, open_shards, write_shard
+
+    cfg = Config()
+    tm = np.random.default_rng(2).integers(0, cfg.engram_compressed_vocab_size, size=cfg.vocab_size)
+    t = engram.Tables.from_config(cfg, tm)
+    g = np.random.default_rng(2)
+    ids = g.integers(0, cfg.vocab_size, size=257)
+    dead = g.random(257) < 0.05
+    whole = t.rows(ids, dead)
+    assert np.array_equal(whole, NgramHasher(cfg, tm)(torch.from_numpy(ids), torch.from_numpy(dead)).numpy())
+    lb, got = None, []
+    for a, b in ((0, 1), (1, 3), (3, 64), (64, 65), (65, 257)):
+        got.append(t.rows(ids[a:b], dead[a:b], lb))
+        lb = t.next_lookback(lb, ids[a:b], dead[a:b])
+    assert np.array_equal(np.concatenate(got), whole)
+    # the prefetch over a packed shard (tiny config: small primes)
+    tc = tiny_config()
+    tmap = np.arange(tc.vocab_size) % tc.engram_compressed_vocab_size
+    tt = engram.Tables.from_config(tc, tmap)
+    lo, hi, c0, nc = tt.shard(0, 1, 2)
+    total = int(tt.primes[0].sum())
+    table = np.random.default_rng(3).integers(0, 256, size=(total, 264), dtype=np.uint8)
+    write_shard(tmp_path / "engram-l1-r1of2.bin", tc.engram_layer_ids[0], lo, table[lo:hi], total)
+    shards = open_shards(tmp_path, 1, 2, (1,))
+    pf = engram.Prefetch(tt, shards, 1, 2, max_rows=8, pin=False)
+    try:
+        lookback = tt.next_lookback(None, [5, 9])
+        window = [11, 30, 30, 7]
+        tk = pf.issue(lookback, window)
+        pf.land(tk, 0)
+        dst = torch.zeros((8, nc, 264), dtype=torch.uint8)
+        pf.upload(0, dst, tk.n)
+        rows = tt.rows(window, None, lookback)[:, 0, c0:c0 + nc]
+        for i in range(len(window)):
+            for c in range(nc):
+                assert np.array_equal(dst[i, c].numpy(), table[rows[i, c]])
+    finally:
+        pf.close()
+        for f in shards.values():
+            f.close()
