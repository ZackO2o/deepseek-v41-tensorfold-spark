+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G4: the indexer ``weights_proj`` float64 kernel (cuda/plain_fp64.py) on the GPU: the fp32 values equal cuBLAS's
+float64 GEMM's at the real shape ([32, 5,120], bf16), a row alone == the row in a window (1-128 rows), and the launch
+is faster than the DGEMM it replaces at decode widths."""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA")
+
+
+def _ms(fn, n=50):
+    fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return 1e3 * (time.perf_counter() - t0) / n
+
+
+def test_plain_fp64_gpu():
+    from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF
+
+    g = torch.Generator(device="cuda").manual_seed(5)
+    w = (torch.randn(32, 5120, device="cuda", generator=g) * 0.02).to(torch.bfloat16)
+    x = (torch.randn(128, 5120, device="cuda", generator=g) * 3).to(torch.bfloat16)
+    whole = PF.matmul_t(x, w)
+    want = x.double() @ w.double().t()
+    assert torch.allclose(whole, want, rtol=1e-12, atol=1e-12)
+    assert torch.equal(whole.float(), want.float())
+    for a, b in ((0, 1), (7, 8), (3, 9), (64, 128)):
+        assert torch.equal(PF.matmul_t(x[a:b], w), whole[a:b])
+    t_new = _ms(lambda: PF.matmul_t(x[:2], w))
+    t_old = _ms(lambda: x[:2].double() @ w.double().t())
+    print(f"[G4] plain_fp64 2 rows: {t_new:.3f} ms vs cuBLAS DGEMM {t_old:.3f} ms")
+    assert t_new < t_old
