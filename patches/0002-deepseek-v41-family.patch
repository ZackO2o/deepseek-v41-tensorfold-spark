@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused router (families/deepseek_v41/cuda/router.py, ``mode="fused"``: split-K partials + the row block's
+last-arriving program's fixed-order sum and selection) in Triton's CPU interpreter: its logits are exactly the
+documented arithmetic, at least as accurate vs float64 as G4's 5,120-long chains, a row's bits are the same alone and
+in any window of any R at any tile position, chunked == unchunked, and the counters are back to 0 after a call."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import fma32, gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import router  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(router._fused).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+SMALL_D = 1024    # the invariance sweeps: 2 k steps a slice (D % (SLICES x FBK) == 0)
+
+
+def _inputs(R: int, E: int, seed: int, D: int = router.DIMS):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * 0.02).to(torch.float16).contiguous()
+    b = (torch.randn(E, generator=g) * 0.1).to(torch.float16)
+    return x, w, b
+
+
+def _bits(p, w):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def test_logits_are_the_documented_sum():
+    """Each slice an fp32 FMA chain from 0 over its k ascending, then ((p0 + p1) + p2) + ... in fp32."""
+
+    import numpy as np
+
+    x, w, _ = _inputs(5, 128, 4, D=SMALL_D)
+    got = router.logits(x, w, "fused").numpy()
+    xa, wa = x.float().numpy(), w.float().numpy().T
+    ds = SMALL_D // router.SLICES
+    tot = None
+    for s in range(router.SLICES):
+        acc = np.zeros((5, 128), np.float32)
+        for k in range(s * ds, (s + 1) * ds):
+            acc = fma32(xa[:, k:k + 1], wa[k:k + 1, :], acc)
+        tot = acc if tot is None else (tot + acc).astype(np.float32)
+    assert np.array_equal(got.view(np.int32), tot.view(np.int32))
+
+
+@pytest.mark.parametrize("seed", [0, 1])
+def test_logits_at_least_as_accurate_as_split(seed):
+    x, w, _ = _inputs(16, 384, 10 + seed)
+    exact = x.double() @ w.double().T
+    new = (router.logits(x, w, "fused").double() - exact).abs()
+    old = (router.logits(x, w, "split").double() - exact).abs()
+    assert float(new.max()) <= float(old.max())
+    assert float(new.mean()) < float(old.mean())
+
+
+@pytest.mark.parametrize("E,topk,N,Rs", [(128, 3, 33, (1, 2, 3, 5, 16, 17, 33)), (384, 6, 18, (2, 17))])
+def test_row_invariance_sweep(E, topk, N, Rs):
+    """A row alone == the row in windows of R = 1, 2, 3, 5, 16, 17, 33 starting at row 0, 7 and N - R (tile positions
+    0 .. 15 of 1 .. 3 row blocks), bit for bit (E = 384: fewer rows, the interpreter's time)."""
+
+    x, w, b = _inputs(N, E, 20 + E, D=SMALL_D)
+    alone = [_bits(*router.route(x[r:r + 1].contiguous(), w, b, topk=topk, mode="fused")) for r in range(N)]
+    for R in Rs:
+        for off in sorted({0, N - R, min(7, N - R)}):
+            p, wt = router.route(x[off:off + R].contiguous(), w, b, topk=topk, mode="fused")
+            for i in range(R):
+                ap, aw = alone[off + i]
+                assert torch.equal(p[i], ap[0]) and torch.equal(wt[i].view(torch.int32), aw[0]), (R, off, i)
+
+
+def test_counters_self_clean_and_repeat():
+    x, w, b = _inputs(33, 384, 5, D=SMALL_D)
+    first = _bits(*router.route(x, w, b, mode="fused"))
+    cnt = router._counters(x.device)
+    assert int(cnt.abs().sum()) == 0 and cnt.numel() == router.CHUNK // 16
+    again = _bits(*router.route(x, w, b, mode="fused"))
+    assert torch.equal(first[0], again[0]) and torch.equal(first[1], again[1])
+    assert int(cnt.abs().sum()) == 0
+
+
+def test_chunked_equals_one_launch(monkeypatch):
+    x, w, b = _inputs(37, 128, 6, D=SMALL_D)
+    whole = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    monkeypatch.setattr(router, "CHUNK", 16)
+    parts = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    assert torch.equal(whole[0], parts[0]) and torch.equal(whole[1], parts[1])
+
+
+def test_fused_agrees_with_split_and_float64():
+    x, w, b = _inputs(16, 384, 9)
+    pf, wf = router.route(x, w, b, mode="fused")
+    ps, ws = router.route(x, w, b, mode="split")
+    rp, rw = router.reference(x, w, b)
+    assert torch.equal(pf, ps) and torch.equal(pf[:, :6], rp)
+    torch.testing.assert_close(wf, ws, rtol=1e-5, atol=1e-6)
+
+
+def test_d_must_split_evenly():
+    """route(): widths the slices do not divide take the split path (G6: the synthetic GPU checkpoints, D = 128);
+    the fused logits refuse them."""
+
+    x, w, b = _inputs(2, 128, 1, D=1000)
+    got = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    want = _bits(*router.route(x, w, b, topk=3, mode="split"))
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+    with pytest.raises(ValueError, match="fused needs D"):
+        router.logits(x, w, "fused")
