index 0000000..d248673
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G6's routed-expert prefill bench on one GPU: a real layer's routed experts (this rank's half, from the
+checkpoint) at prefill block widths, the three fast-prefill kernels side by side:
+
+- grouped: upstream's grouped kernels (the decode path's), 1,024-row blocks, the shared slot masked (``prefill_moe``);
+- tc: ``x3tc`` (Triton); gm: ``x3gm`` (CUDA, every configuration at the widest width);
+- per kernel: ms a call, TFLOP/s, trellis GB/s, the DRAM floor (``x3gm.floor_bytes`` at 235 GB/s) and its ratio;
+- gm's correctness on the real weights: vs grouped (rel max, the gate < 3e-3), a row subset == the same rows in the
+  block (row independence), repeats and every configuration bit for bit.
+
+    python -m tensorfold.families.deepseek_v41.cuda.gmbench --model DIR [--layers 3,20] [--rank 0]
+        [--rows 512,1024,2048,4096] [--iters 10] [--out gmbench.json]
+
+Rows come from the real router on random activations.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+GBPS = 235.0
+REL_GATE = 3e-3
+
+
+def _time(fn, iters: int) -> float:
+    import torch
+
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench_layer(model: str, layer: int, rank: int, rows, iters: int) -> dict:
+    import torch
+
+    from . import blocks as B
+    from . import experts as X
+    from . import router, x3gm, x3tc
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    s = X.scratch(block, 1024)                     # the forward's shared scratch (1,024-row blocks, 7 slots)
+    _, topk = cfg.experts_of(layer)
+    E, lim = block.ex.count - block.geom.shared, cfg.swiglu_limit
+    shx = bool(torch.equal(m.w1.suh, m.w3.suh))
+    tbytes = sum(t.trellis.numel() * 2 for t in (m.w1, m.w3, m.w2))
+    gen = torch.Generator(device="cuda").manual_seed(200 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": x3gm.k2_of(m.w1.trellis), "k2_d": x3gm.k2_of(m.w2.trellis),
+                 "shx": shx, "trellis_gb": round(tbytes / 1e9, 3), "supported": x3gm.supported(m.w1, m.w3, m.w2),
+                 "rows": {}}
+    print(f"layer {layer} rank {rank}: K2 gu {out['k2_gu']} dn {out['k2_d']}, gate/up share suh: {shx}, "
+          f"routed trellis {out['trellis_gb']} GB", flush=True)
+    for R in rows:
+        x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+        pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+        pr, wr = pick[:, :topk].contiguous(), wts[:, :topk].float().contiguous()
+        pg, wg = pick.clone(), wts.clone()
+        pg[:, topk:] = block.ex.count
+        wg[:, topk:] = 0.0
+        cnt = torch.bincount(pr.reshape(-1).long(), minlength=E)
+
+        def grouped(x=x, pg=pg, wg=wg, R=R):
+            o = torch.empty((R, cfg.hidden_size), dtype=torch.float32, device="cuda")
+            for a in range(0, R, 1024):
+                b = min(R, a + 1024)
+                X.routed(x[a:b], pg[a:b], wg[a:b], block, s, o[a:b], b - a, limit=lim)
+            return o
+
+        def tc(x=x, pr=pr, wr=wr):
+            return x3tc.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s)
+
+        def gm(c=None, x=x, pr=pr, wr=wr):
+            return x3gm.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s, shx=shx, cfg=c)
+
+        floor = x3gm.floor_bytes(R, tbytes, topk, cfg.hidden_size, m.w1.trellis.shape[2] * 16, 1 if shx else 2)
+        row = {"members_mean": round(float(cnt.float().mean()), 1), "members_max": int(cnt.max()),
+               "floor_ms": round(floor / GBPS / 1e6, 3)}
+        ref = grouped()
+        got = gm()
+        row["gm_rel_vs_grouped"] = float((got - ref).abs().max() / ref.abs().max())
+        sub = torch.arange(0, R, 7, device="cuda")
+        row["gm_rows_independent"] = bool(torch.equal(
+            x3gm.run(x[sub], pr[sub], wr[sub], m.w1, m.w3, m.w2, lim, scratch=s, shx=shx), got[sub]))
+        row["gm_repeat"] = bool(torch.equal(gm(), got))
+        for name, fn in (("grouped", grouped), ("tc", tc), ("gm", gm)):
+            ms = _time(fn, iters if name != "tc" else max(2, iters // 4))
+            row[name] = {"ms": round(ms, 3), "tflops": round(x3gm.flops(R, topk) / ms / 1e9, 1),
+                         "trellis_gbps": round(tbytes / ms / 1e6, 1), "x_floor": round(ms / row["floor_ms"], 2)}
+        if R == max(rows):
+            row["gm_cfgs"] = {}
+            for gu in (0, 1):
+                for dn in (0, 1):
+                    for ticket in (True, False):
+                        c = dict(x3gm.config(), gu=gu, dn=dn, ticket=ticket)
+                        same = bool(torch.equal(gm(c), got))
+                        row["gm_cfgs"][f"{gu},{dn},{int(ticket)}"] = {"ms": round(_time(lambda c=c: gm(c), iters), 3),
+                                                                     "bitwise": same}
+        row["pass"] = (row["gm_rel_vs_grouped"] < REL_GATE and row["gm_rows_independent"] and row["gm_repeat"]
+                       and all(v["bitwise"] for v in row.get("gm_cfgs", {}).values()))
+        out["rows"][R] = row
+        print(f"[gmbench] L{layer} R={R}: members mean {row['members_mean']} max {row['members_max']}; floor "
+              f"{row['floor_ms']} ms; grouped {row['grouped']['ms']} ms, tc {row['tc']['ms']} ms, "
+              f"gm {row['gm']['ms']} ms "
+              f"({row['gm']['tflops']} TFLOP/s, {row['gm']['x_floor']}x floor); gm vs grouped rel "
+              f"{row['gm_rel_vs_grouped']:.2e}, rows {'==' if row['gm_rows_independent'] else 'DIFFER'}"
+              + (f"; cfgs {row['gm_cfgs']}" if "gm_cfgs" in row else ""), flush=True)
+    out["pass"] = all(r["pass"] for r in out["rows"].values())
+    return out
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--layers", default="3,20")
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--rows", default="512,1024,2048,4096")
+    ap.add_argument("--iters", type=int, default=10)
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    rows = [int(v) for v in a.rows.split(",") if v]
+    rep = {"layers": [bench_layer(a.model, int(L), a.rank, rows, a.iters) for L in a.layers.split(",") if L]}
+    rep["pass"] = all(r["pass"] for r in rep["layers"])
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({"pass": rep["pass"]}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
