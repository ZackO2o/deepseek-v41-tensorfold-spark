+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash on the GPU (window G1; collected only where PyTorch sees an NVIDIA GPU):
+
+- the 0580 load path (x3ld) == upstream's grouped EXL3 kernel, bit for bit, on random mul1 experts of the real
+  geometry (5,120 <-> 1,152 a rank) at every width the pack uses and verify widths 1-16;
+- the router kernel against float64 routing, and a row alone == the row in a window (bit for bit);
+- the CSA2 kernels' rows alone == in windows (bit for bit) and against the float64 references;
+- the whole forward on the GPU (upstream's EXL3 linears and experts, CSA2 + router kernels) on a synthetic checkpoint
+  with the kernels' shapes: == the CPU twin to rounding, and its rows bit for bit the same in a prefill window, in
+  windows of 8 and one at a time (M1 gate 3 on synthetic weights);
+- a prepared folder read to the GPU == the tree it stored.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_gpu.py (one GPU; ~2-5 min with the first extension builds).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+
+DEV = "cuda"
+
+
+# -- experts: x3ld == upstream ----------------------------------------------------------------------------------
+def _random_layer(k2_routed: int, k2_shared: int, experts: int = 32, seed: int = 0):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    geom = X.Geometry(experts=experts)
+    D, I = geom.dims, geom.width
+
+    def mat(k, n, k2):
+        t = torch.randint(-2 ** 15, 2 ** 15, (k // 16, n // 16, 8 * k2), generator=g, device=DEV,
+                          dtype=torch.int32).to(torch.int16)
+        su = ((torch.rand(k, generator=g, device=DEV) + 0.5) * 0.02).to(torch.float16)
+        sv = (torch.rand(n, generator=g, device=DEV) + 0.5).to(torch.float16)
+        return t, su, sv
+
+    gate, up, down = [], [], []
+    for e in range(experts + 1):
+        k2 = k2_routed if e < experts else k2_shared
+        gate.append(mat(D, I, k2))
+        up.append(mat(D, I, k2))
+        down.append(mat(I, D, k2))
+    return X.Experts(x3.prepare(gate, up, down, "mul1", device=DEV), geom, keep=[gate, up, down])
+
+
+@pytest.mark.parametrize("k2", [(6, 10), (4, 8), (8, 8)], ids=["3-bit + 5-bit shared", "2-bit + 4", "dspark 4-bit"])
+def test_x3ld_equals_upstream_bitwise(k2):
+    layer = _random_layer(*k2)
+    s = X.scratch(layer, 16)
+    g = torch.Generator(device=DEV).manual_seed(1)
+    saved = dict(loads.CFG)
+    try:
+        for R in (1, 2, 4, 6, 8, 16):
+            x = torch.randn((R, 5120), generator=g, device=DEV).to(torch.bfloat16)
+            pick = torch.stack([torch.randperm(32, generator=g, device=DEV)[:6] for _ in range(R)]).to(torch.int32)
+            wts = torch.rand((R, 6), generator=g, device=DEV)
+            pick, wts = X.with_shared(pick, wts, layer.geom)
+            loads.CFG.update(on=False)
+            want = X.routed(x, pick, wts, layer, s, None, R).clone()
+            for cfg in loads.CFGS:
+                loads.CFG.update(on=True, gu=cfg, dn=cfg)
+                got = X.routed(x, pick, wts, layer, s, None, R)
+                assert torch.equal(got, want), (R, cfg)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+
+
+# -- router ----------------------------------------------------------------------------------------------------
+def test_router_gpu():
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    g = torch.Generator(device=DEV).manual_seed(2)
+    x = torch.randn((21, 5120), generator=g, device=DEV).to(torch.bfloat16)
+    w = (torch.randn((384, 5120), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    b = (torch.randn(384, generator=g, device=DEV) * 0.1).float()
+    pick, wts = router.route(x, w, b)
+    rp, rw = router.reference(x.cpu(), w.cpu(), b.cpu())
+    assert torch.equal(pick[:, :6].cpu(), rp)
+    torch.testing.assert_close(wts[:, :6].cpu().double(), rw, rtol=1e-5, atol=1e-6)
+    for r in (0, 15, 16, 20):
+        p1, w1 = router.route(x[r:r + 1].contiguous(), w, b)
+        assert torch.equal(p1[0], pick[r]) and torch.equal(w1[0], wts[r])
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)], ids=["target", "dspark"])
+def test_router_split_equals_one_program(E, topk):
+    """The split router (logits over expert blocks, then the selection) == the one-program router, bit for bit."""
+
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    g = torch.Generator(device=DEV).manual_seed(E)
+    w = (torch.randn((E, 5120), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    b = (torch.randn(E, generator=g, device=DEV) * 0.1).float()
+    for R in (1, 2, 7, 16, 21, 128):
+        x = torch.randn((R, 5120), generator=g, device=DEV).to(torch.bfloat16)
+        p0, w0 = router.route(x, w, b, topk=topk, split=False)
+        p1, w1 = router.route(x, w, b, topk=topk, mode="split")      # the default is fused since 8f24eac (other bits)
+        assert torch.equal(p0, p1) and torch.equal(w0.view(torch.int32), w1.view(torch.int32)), R
+
+
+# -- CSA2 rows ---------------------------------------------------------------------------------------------------
+def test_csa2_rows_and_attention_row_invariance():
+    from tensorfold.families.deepseek_v41.cuda.csa2 import attn, compress, ref
+    from tensorfold.families.deepseek_v41.cuda.csa2 import rows as RW
+
+    g = torch.Generator(device=DEV).manual_seed(3)
+    x = (torch.randn((300, 512), generator=g, device=DEV) * 3).to(torch.bfloat16)
+    cs = torch.cat([torch.cos(torch.arange(512, device=DEV)[:, None] * 1e-3 * torch.arange(32, device=DEV)),
+                    torch.sin(torch.arange(512, device=DEV)[:, None] * 1e-3 * torch.arange(32, device=DEV))],
+                   1).float().contiguous()
+    v = torch.zeros((300, RW.VB), dtype=torch.uint8, device=DEV)
+    sc = torch.zeros((300, RW.SB), dtype=torch.uint8, device=DEV)
+    compress.kv_store(x, cs, v, sc, torch.tensor([0], dtype=torch.int32, device=DEV), 300, 1)
+    want_v, want_s = ref.quantize_rows(ref.rope(x.float().cpu(), cs.cpu(), torch.arange(300)).float())
+    assert torch.equal(v[:, :RW.NOPE].cpu(), want_v[:, :RW.NOPE]) and torch.equal(sc.cpu(), want_s)
+    got_rope = ref.dequantize_rows(v.cpu(), sc.cpu()).float()[:, RW.NOPE:]       # the rotated dims: bf16 of fp32
+    want_rope = ref.dequantize_rows(want_v, want_s).float()[:, RW.NOPE:]
+    torch.testing.assert_close(got_rope, want_rope, rtol=1e-2, atol=1e-2)
+    ring = 256
+    q = (torch.randn((8, 32, 512), generator=g, device=DEV) * 0.5).to(torch.bfloat16)
+    swa = (torch.zeros((ring, RW.VB), dtype=torch.uint8, device=DEV),
+           torch.zeros((ring, RW.SB), dtype=torch.uint8, device=DEV))
+    P = 200
+    compress.kv_store(x[:P + 8], cs, swa[0], swa[1], torch.tensor([0], dtype=torch.int32, device=DEV), P + 8, 0,
+                      ring)
+    tok = torch.stack([torch.sort(torch.randperm(P, generator=g, device=DEV)[:40]).values for _ in range(8)]).to(
+        torch.int32)
+    cnt = torch.full((8,), 40, dtype=torch.int32, device=DEV)
+    lo = torch.zeros((8,), dtype=torch.int32, device=DEV)
+    sink = torch.randn(32, generator=g, device=DEV)
+    s = attn.Scratch(8, DEV)
+    out = torch.empty_like(q)
+    pos = torch.tensor([P], dtype=torch.int32, device=DEV)
+    attn.attention(q, (v, sc), tok, cnt, swa, lo, pos, sink, cs, out, s, ring=ring)
+    for r in (0, 5, 7):
+        one = torch.empty_like(q[:1])
+        attn.attention(q[r:r + 1].contiguous(), (v, sc), tok[r:r + 1].contiguous(), cnt[:1], swa, lo[:1],
+                       torch.tensor([P + r], dtype=torch.int32, device=DEV), sink, cs, one, s, ring=ring)
+        assert torch.equal(one[0], out[r]), r
+    assert math.isfinite(float(out.float().abs().max()))
+
+
+# -- the forward on a synthetic checkpoint with the kernels' shapes -----------------------------------------------
+SHAPES = dict(num_attention_heads=32, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+IDS = torch.randint(0, 256, (45,), generator=torch.Generator().manual_seed(4)).tolist()
+
+
+@pytest.fixture(scope="module")
+def kshape(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41g"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def _forward(kshape, device, windows, monkeypatch=None):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin
+
+    root, cfg, table = kshape
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1, device).load(token_map=tmap)
+    chunk = max(windows)
+    cs = Triton(chunk, cfg.num_attention_heads, device) if device == DEV else Twin(cfg.qk_rope_head_dim,
+                                                                                    cfg.sliding_window)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = FW.Forward(cfg, tree, csa2=cs, device=device, limit=128, chunk=chunk, engram_rows=rows,
+                    hasher=EH.NgramHasher(cfg, tmap))
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(IDS[a:a + n]).float().cpu())
+        a += n
+    return torch.cat(out)
+
+
+def test_forward_gpu_equals_cpu_twin(kshape, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are checked at D = 5,120 elsewhere
+    gpu = _forward(kshape, DEV, [45])
+    cpu = _forward(kshape, "cpu", [45])
+    assert (gpu.argmax(-1) == cpu.argmax(-1)).float().mean() >= 0.9
+    row = (gpu.double() - cpu.double()).abs().amax(-1) / cpu.double().abs().amax(-1)
+    assert float(row.median()) < 0.03
+
+
+def test_forward_gpu_rows_are_invariant(kshape, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")
+    want = _forward(kshape, DEV, [45])
+    assert torch.equal(_forward(kshape, DEV, [8] * 5 + [5]), want)
+    assert torch.equal(_forward(kshape, DEV, [1] * 45), want)
+
+
+def test_prepared_folder_to_gpu(kshape, tmp_path):
+    from tensorfold.families.deepseek_v41.cuda import fastboot as FB
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+
+    root, cfg, _ = kshape
+    tree = W.Loader(cfg, W.Shards(root), 0, 2, DEV).load(4)
+    key = FB.weights_key(root, 0, 2)
+    d = FB.folder(tmp_path, key)
+    FB.save(tree, d, key)
+    back, st = FB.read(d, DEV)
+    assert st["chunks"] >= 1 and back.layers[2].moe.w1.trellis.is_cuda
+    assert torch.equal(back.layers[2].moe.w1.trellis, tree.layers[2].moe.w1.trellis)
+    assert torch.equal(back.embed, tree.embed) and back.nbytes() == tree.nbytes()
