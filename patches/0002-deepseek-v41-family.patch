--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/graphs.py
@@ -0,0 +1,400 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CUDA graphs for DeepSeek-V4.1-Flash verify windows (M2; GLM ``spark/graphs.py`` + patches/0050's lazy keys).
+
+A verify forward is replayed from a graph keyed by its **mix** (the (slot, rows) of each window in plan order: a
+slot's rings and page table are fixed addresses, so the slot is part of the key) and its **context bucket** (the
+indexer scores ``nvis_max`` keys, a host value fixed at capture: a graph serves every window whose longest context
+ends inside its bucket of ``TF_DSV41_GRAPH_BUCKET`` tokens, scoring up to the bucket's end; the keys past a row's
+own end score -inf and never reach its attention, whose rows are its own: the replay's bits are the eager run's).
+
+- **Warm-up** at boot (both ranks, the same keys in the same order): ``TF_DSV41_GRAPH_WARM`` = ``decode`` (default:
+  one slot at widths 1-6, DSpark's windows), ``all`` (also widths 8, 12, 16 and, with ``TF_DSV41_GRAPH_SLOTS`` > 1,
+  the mixes of equal widths) or ``none``, within ``TF_DSV41_GRAPH_BUDGET_S`` (15) seconds: the ranks agree after
+  each capture whether either is past the budget.
+- **Memory**: before a capture the ranks agree that MemAvailable is at least ``TF_DSV41_GRAPH_FLOOR_GIB`` (5.0: the
+  4 GiB hard floor + a capture's own growth); below it no more graphs are captured (the held ones stay). All graphs
+  share one memory pool (outputs are read before the next replay: the logits at once, the pending rows at the next
+  commit). Multi-slot mixes are eager by default (``TF_DSV41_GRAPH_SLOTS`` 1): their keys are combinatorial and a
+  4-slot round is GPU-bound (~200 ms against ~10 ms of launches).
+- **Persistent buffers**: a graph holds the addresses it captured. Every buffer a window reads or writes outside its
+  own allocations is allocated once (the slots' rings, page tables and ratio-2 carries are written in place; the
+  MoE scratch is one per geometry, sized for the forward's largest run: ``decode.DecodeForward``). If one is ever
+  reallocated (a run wider than the scratch), the fingerprint check before each replay drops every graph (G3's
+  illegal memory accesses and garbage draft ids: per-layer MoE scratch grown after capture, carries replaced by a
+  clone at every commit).
+- **First use**: a key met without a graph runs eagerly (its result is the round's), then is captured for the next
+  time (at most ``TF_DSV41_GRAPHS_MAX``, 256); widths past 16 rows or more slots than captured mixes stay eager.
+- **Fallback**: a capture that fails on either rank (agreed through one int exchange) turns graphs off for the
+  rest of the run, both ranks alike; the step's result is the eager run's, so no reply changes.
+
+Inputs a replay reads from static buffers, staged on the host side before each replay (``Static``): the ids, the
+windows' positions (``Win.t`` / ``positions``), and the Engram rows: hashing and reads stay on the host, outside the
+graphs (``prefetch.py``), and land in the static rows with one copy a layer. The forward builds those through its
+hooks ``win_of`` / ``ids_of`` / ``_engram_inputs`` (``decode.DecodeForward`` points them at a ``Static``).
+
+``GraphCache`` (keys, budget, lazy capture, fallback) runs no CUDA: tests run it on the CPU with a fake capture.
+Knobs: TF_DSV41_GRAPHS (1; 0 = eager), TF_DSV41_GRAPH_BUDGET_S (15), TF_DSV41_GRAPHS_MAX (256),
+TF_DSV41_GRAPH_BUCKET (2048), TF_DSV41_GRAPH_SLOTS (1: the widest mix captured), TF_DSV41_GRAPH_WARM (decode),
+TF_DSV41_GRAPH_FLOOR_GIB (5.0).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+from .csa2.backend import Win
+from .phases import PH
+
+WIDTHS = (1, 2, 3, 4, 5, 6, 8, 12, 16)
+DECODE_WIDTHS = (1, 2, 3, 4, 5, 6)
+MIX_WIDTHS = (6, 1, 4, 2, 3, 5)
+WARM = ("decode", "all", "none")
+MAX_ROWS = 16
+
+Key = tuple            # (((slot, rows), ...), bucket)
+
+
+def env_settings() -> dict:
+    g = lambda k, d: os.environ.get(k, "").strip() or d
+    warm = g("TF_DSV41_GRAPH_WARM", "decode").lower()
+    if warm not in WARM:
+        raise ValueError(f"TF_DSV41_GRAPH_WARM={warm!r}: expected one of {', '.join(WARM)}")
+    return {"on": g("TF_DSV41_GRAPHS", "1") != "0", "budget_s": float(g("TF_DSV41_GRAPH_BUDGET_S", "15")),
+            "max_graphs": int(g("TF_DSV41_GRAPHS_MAX", "256")), "bucket": int(g("TF_DSV41_GRAPH_BUCKET", "2048")),
+            "slots": int(g("TF_DSV41_GRAPH_SLOTS", "1")), "warm": warm,
+            "floor_gib": float(g("TF_DSV41_GRAPH_FLOOR_GIB", "5.0"))}
+
+
+def room_for(floor_gib: float, meminfo=None) -> Callable[[], bool]:
+    """``GraphCache.room``: MemAvailable >= ``floor_gib`` (True where /proc/meminfo is missing)."""
+
+    def room() -> bool:
+        from tensorfold.families.glm5_next.spark import memsafe
+
+        mi = meminfo() if meminfo is not None else memsafe.read_meminfo()
+        avail = mi.get("MemAvailable")
+        return avail is None or avail >= floor_gib * 2 ** 30
+
+    return room
+
+
+def make_key(mix: Sequence[tuple[int, int, int]], bucket: int, limit: int, slots: int = 4) -> Key | None:
+    """``mix``: (slot, start, rows) of each window -> the key, or None (not graphable: a window past 16 rows, more
+    windows than ``slots``, a slot twice, a context past ``limit``)."""
+
+    if not mix or len(mix) > slots or len({m[0] for m in mix}) != len(mix):
+        return None
+    if any(not 1 <= r <= MAX_ROWS for _, _, r in mix):
+        return None
+    last = max(s + r - 1 for _, s, r in mix)
+    if last >= limit:
+        return None
+    return tuple((int(sl), int(r)) for sl, _, r in mix), last // bucket
+
+
+def bucket_end(bucket: int, size: int, limit: int) -> int:
+    """The last position a bucket's graphs score keys for."""
+
+    return min((bucket + 1) * size - 1, limit - 1)
+
+
+def warmup_keys(slots: int, max_slots: int = 4, warm: str = "all") -> list[Key]:
+    """The boot captures in priority order (bucket 0): slot 0 alone at the decode widths (``warm`` "decode") or at
+    every graph width then equal-width mixes of the first ``min(slots, max_slots)`` slots ("all"); "none": none."""
+
+    if warm == "none":
+        return []
+    keys: list[Key] = [(((0, w),), 0) for w in (DECODE_WIDTHS if warm == "decode" else WIDTHS)]
+    n = min(slots, max_slots)
+    if n > 1 and warm == "all":
+        keys += [(tuple((s, w) for s in range(n)), 0) for w in MIX_WIDTHS]
+    return keys
+
+
+@dataclass
+class GraphCache:
+    """The keys' graphs and the rules for making them. ``capture(key) -> entry | None`` (None: failed) is given
+    by the CUDA side; ``agree(ok) -> bool`` is every rank's verdict (all ok / any past the budget)."""
+
+    capture: Callable[[Key], Any]
+    budget_s: float = 15.0
+    max_graphs: int = 256
+    bucket: int = 2048
+    slots: int = 4
+    on: bool = True
+    agree_all: Callable[[bool], bool] = lambda ok: ok
+    agree_any: Callable[[bool], bool] = lambda flag: flag
+    clock: Callable[[], float] = time.monotonic
+    room: Callable[[], bool] = lambda: True         # memory for one more capture (``room_for``)
+    graphs: dict = field(default_factory=dict)
+    full: bool = False                              # a capture was refused for memory: no more captures
+    stats: dict = field(default_factory=lambda: {"warm": 0, "lazy": 0, "replays": 0, "eager": 0, "failed": 0,
+                                                 "warm_s": 0.0, "full": 0, "dropped": 0})
+
+    def key(self, mix, limit: int) -> Key | None:
+        return make_key(mix, self.bucket, limit, self.slots) if self.on else None
+
+    def get(self, key: Key | None):
+        e = self.graphs.get(key) if key is not None else None
+        if e is not None:
+            self.stats["replays"] += 1
+        else:
+            self.stats["eager"] += 1
+        return e
+
+    def wants(self, key: Key | None) -> bool:
+        return (self.on and not self.full and key is not None and key not in self.graphs
+                and len(self.graphs) < self.max_graphs)
+
+    def drop(self) -> None:
+        """Every graph forgotten (a persistent buffer moved; both ranks see the same event)."""
+
+        if self.graphs:
+            self.stats["dropped"] += len(self.graphs)
+            self.graphs.clear()
+
+    def _take(self, key: Key) -> bool:
+        if self.agree_any(not self.room()):           # either rank under the floor: neither captures
+            self.full = True
+            self.stats["full"] += 1
+            print(f"[tensorfold] dsv41 CUDA graphs: memory under the capture floor; {len(self.graphs)} held, no "
+                  "more captured", file=sys.stderr, flush=True)
+            return False
+        try:
+            entry = self.capture(key)
+        except Exception as exc:        # noqa: BLE001 - any capture failure: eager from here on
+            print(f"[tensorfold] dsv41 CUDA graph capture of {key} failed ({type(exc).__name__}: {exc})",
+                  file=sys.stderr, flush=True)
+            entry = None
+        if not self.agree_all(entry is not None):
+            self.on = False
+            self.graphs.clear()
+            self.stats["failed"] += 1
+            print("[tensorfold] dsv41 CUDA graphs off (a capture failed on a rank): windows run eagerly",
+                  file=sys.stderr, flush=True)
+            return False
+        self.graphs[key] = entry
+        return True
+
+    def lazy(self, key: Key | None) -> None:
+        """After an eager window: capture its key for the next time (both ranks meet the same keys in order)."""
+
+        if self.wants(key) and self._take(key):
+            self.stats["lazy"] += 1
+
+    def warmup(self, keys: Sequence[Key]) -> int:
+        """Capture ``keys`` in order within the budget; the number captured."""
+
+        t0 = self.clock()
+        n = 0
+        for key in keys:
+            if not self.wants(key):
+                continue
+            if self.agree_any(self.clock() - t0 > self.budget_s):
+                break
+            if not self._take(key):
+                break
+            n += 1
+        self.stats["warm"] += n
+        self.stats["warm_s"] = round(self.clock() - t0, 2)
+        return n
+
+    def describe(self) -> str:
+        s = self.stats
+        return (f"graphs {'on' if self.on else 'off'}: {len(self.graphs)} held ({s['warm']} at boot in "
+                f"{s['warm_s']} s, {s['lazy']} on first use), {s['replays']} replays, {s['eager']} eager windows"
+                + (f", {s['dropped']} dropped" if s["dropped"] else "") + (", memory full" if self.full else ""))
+
+
+# -- the CUDA side ---------------------------------------------------------------------------------------------------
+@dataclass
+class Static:
+    """One key's static inputs and the forward's outputs captured with it."""
+
+    key: Key
+    ids: Any                    # int64 [R]
+    t: list                     # int32 [1] a window (its start)
+    pos: list                   # int64 [n] a window
+    cap: int                    # the bucket's last position (the indexer's key range)
+    engram: dict = field(default_factory=dict)      # layer -> static rows [R, cols]
+    wins: list = field(default_factory=list)
+    graph: Any = None
+    out: Any = None
+    pend: dict = field(default_factory=dict)        # slot -> (proj, taps) of the captured run
+
+
+class CudaGraphs:
+    """Graphs of ``fw`` (``decode.DecodeForward``) windows: ``run(segs)`` replays, or runs eagerly and captures."""
+
+    def __init__(self, fw, *, agree_all=None, agree_any=None, settings: dict | None = None) -> None:
+        import torch
+
+        self.torch, self.fw = torch, fw
+        st = settings or env_settings()
+        self.pool = torch.cuda.graph_pool_handle()
+        self._pending_segs = None
+        self.warm = st.get("warm", "all")            # env_settings: "decode" unless TF_DSV41_GRAPH_WARM
+        self.cache = GraphCache(self._capture, st["budget_s"], st["max_graphs"], st["bucket"], st["slots"],
+                                st["on"], agree_all or (lambda ok: ok), agree_any or (lambda f: f),
+                                room=room_for(float(st.get("floor_gib", 5.0))))
+        self._fp = self.fingerprint()
+
+    def fingerprint(self) -> tuple:
+        """The persistent buffers a captured window reads or writes (object identities / addresses): the MoE
+        scratch of every block, every slot's ratio-2 carries. Any change drops the graphs (``run``)."""
+
+        fw = self.fw
+        parts = [id(getattr(b.moe, "scratch", None)) for b in fw.blocks]
+        for s in fw.slots:
+            parts += [c.data_ptr() for c in s.carry.values()]
+        return tuple(parts)
+
+    def _mix(self, segs):
+        return [(sg.slot, sg.start, len(sg.ids)) for sg in segs]
+
+    def _static(self, key: Key, segs) -> Static:
+        torch, fw = self.torch, self.fw
+        dev = fw.device
+        R = sum(n for _, n in key[0])
+        cap = bucket_end(key[1], self.cache.bucket, fw.limit)
+        st = Static(key, torch.zeros((R,), dtype=torch.long, device=dev),
+                    [torch.zeros((1,), dtype=torch.int32, device=dev) for _ in key[0]],
+                    [torch.zeros((n,), dtype=torch.long, device=dev) for _, n in key[0]], cap)
+        st.wins = [StaticWin(0, n, t, p, cap) for (_, n), t, p in zip(key[0], st.t, st.pos)]
+        rows = fw.engram_inputs_eager(segs)
+        st.engram = {L: torch.empty_like(v) for L, v in rows.items()}
+        self._stage(st, segs, rows)
+        return st
+
+    def _stage(self, st: Static, segs, rows=None) -> None:
+        torch, fw = self.torch, self.fw
+        st.ids.copy_(torch.tensor([t for sg in segs for t in sg.ids], dtype=torch.long), non_blocking=False)
+        for sg, t, p, w in zip(segs, st.t, st.pos, st.wins):
+            t.fill_(int(sg.start))
+            p.copy_(torch.arange(sg.start, sg.start + len(sg.ids), dtype=torch.long))
+            w.p0 = int(sg.start)
+        rows = fw.engram_inputs_eager(segs) if rows is None else rows
+        for L, v in rows.items():
+            st.engram[L].copy_(v)
+
+    def _capture(self, key: Key) -> Static | None:
+        torch, fw = self.torch, self.fw
+        segs = self._pending_segs
+        saved = {sg.slot: fw.slots[sg.slot].pending for sg in segs}
+        hidden = getattr(fw, "hidden", None)
+        st = self._static(key, segs)
+        g = torch.cuda.CUDAGraph()
+        fw.static = st
+        try:
+            # the static path once eagerly (the same rows at the same positions: the same writes), so every Triton
+            # specialisation of the bucket's key range is compiled and loaded before the capture
+            fw.run(segs)
+            torch.cuda.synchronize()
+            with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
+                out = fw.run(segs)
+        finally:
+            fw.static = None
+        st.graph, st.out = g, out
+        for sg in segs:
+            p = fw.slots[sg.slot].pending
+            st.pend[sg.slot] = (p.proj, p.taps)
+            fw.slots[sg.slot].pending = saved[sg.slot]
+        fw.hidden = hidden
+        return st
+
+    def run(self, segs):
+        """This rank's logits of the windows ``segs`` (``forward.Seg``), replayed or eager (+ captured)."""
+
+        from .forward import Pending
+
+        fw = self.fw
+        fp = self.fingerprint()
+        if fp != self._fp:
+            if self.cache.graphs:
+                print(f"[tensorfold] dsv41 CUDA graphs: a persistent buffer moved; {len(self.cache.graphs)} graphs "
+                      "dropped (captured again on use)", file=sys.stderr, flush=True)
+            self.cache.drop()
+            self._fp = fp
+        key = self.cache.key(self._mix(segs), fw.limit)
+        st = self.cache.get(key)
+        if st is not None:
+            with PH("graph.stage"):
+                self._stage(st, segs)
+            with PH("graph.replay"):
+                st.graph.replay()
+            for sg in segs:
+                proj, taps = st.pend[sg.slot]
+                fw.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), proj, taps)
+            return st.out
+        out = fw.run(segs)
+        if self.cache.wants(key):
+            self._pending_segs = segs
+            try:
+                with PH("graph.capture"):
+                    self.cache.lazy(key)
+            finally:
+                self._pending_segs = None
+        return out
+
+    def warmup(self, slots: int, ensure: Callable[[int, int], None], bos: int = 0) -> int:
+        """Boot captures: slots at position 0 (``ensure(slot, rows)`` maps their pages), each key eagerly once
+        (Triton compiles) then captured; the slots are reset afterwards (the caller releases their pages)."""
+
+        from .forward import Seg
+
+        fw = self.fw
+        keys = warmup_keys(slots, self.cache.slots, self.warm)
+
+        def capture_key(key, inner=self.cache.capture):
+            segs = []
+            for sl, n in key[0]:
+                fw.reset(sl)
+                ensure(sl, n + 1)
+                segs.append(Seg(sl, 0, tuple([int(bos)] * n)))
+            fw.run(segs)
+            self._pending_segs = segs
+            try:
+                return inner(key)
+            finally:
+                self._pending_segs = None
+
+        real = self.cache.capture
+        self.cache.capture = capture_key
+        try:
+            n = self.cache.warmup(keys)
+        finally:
+            self.cache.capture = real
+            for s in range(slots):
+                fw.reset(s)
+        return n
+
+
+@dataclass
+class StaticWin(Win):
+    """A static window: ``t`` / ``positions`` are the key's buffers; ``last`` reaches the bucket's end (the
+    indexer's key range at capture)."""
+
+    cap: int = 0
+
+    @property
+    def last(self) -> int:
+        return max(self.p0 + self.n - 1, self.cap)
+
+
+__all__ = [
+    "WIDTHS",
+    "CudaGraphs",
+    "GraphCache",
+    "Static",
+    "StaticWin",
+    "bucket_end",
+    "env_settings",
+    "make_key",
+    "warmup_keys",
+]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/joint.py b/src/tensorfold/families/deepseek_v41/cuda/joint.py
new file mode 100644
index 0000000..cda93c8
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/joint.py
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Joint DSpark depth for a round of several decoding slots (``depth.Depth.choose_joint``, TF_DSV41_DEPTH_JOINT).
+
+A round verifies every slot's rows in ONE window (``rounds.Executor._windows``), so the round costs
+C(R) = verify ms of R total rows (``depth.Costs.rows_ms``: the calibration's table by total rows, ``calib.py``) plus
+fixed terms (the DSpark pass, the per-slot overhead) that no depth changes. Slot s verifying k_s drafts commits
+E_s(k_s) = 1 + q_1 + q_1 q_2 + ... tokens on average (``depth.py``). The joint depth maximizes
+
+    sum_s E_s(k_s) - lambda C(shared + sum_s (k_s + 1))
+
+with lambda the round's aggregate rate (all slots' committed tokens per modelled round-ms, ``Depth.joint_rate``): the
+renewal argument of ``glm5_next.spark.depth`` applied to the whole round, whose time all its slots share.
+
+The allocation is exact, not a stopping rule. Every candidate row costs the same C(R + 1) - C(R) whichever slot it
+joins (the cost depends on the total only), so the best ``m`` extra rows are the ``m`` largest marginal gains
+g_{s,j} = q_{s,1} ... q_{s,j+1} (the expected token draft j + 1 adds; non-increasing in j, so the top ``m`` are a
+prefix of every slot's chain: the greedy marginal allocation by dE / dC). Then ``m`` is chosen by scanning every
+total (C is a measured table with steps at the row-graph buckets, not necessarily convex, so the first row that does
+not pay is not where the scan stops). Ties go to fewer rows; the order (gain desc, slot index asc, position asc) is
+total, so both ranks pick the same rows from the same floats. No clocks, no randomness.
+
+Bounds: each slot's ``least`` (1: in a shared window the pass already ran and the first draft is verified; 0 is only
+for a lone window, ``Depth.choose``) and ``top`` (the plan's depth, the DSpark block, the cap, the 16-row slot
+window), and ``max_rows`` for the whole window (the largest row-graph bucket, TF_DSV41_GRAPH_ROWS_MAX, 64).
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Callable, Sequence
+
+EPS = 1e-12
+ROWS_CAP = 64
+
+
+def env_on() -> bool:
+    """TF_DSV41_DEPTH_JOINT: 1 (default) = the joint depth for shared windows; 0 = each slot alone (G8's policy)."""
+
+    v = os.environ.get("TF_DSV41_DEPTH_JOINT", "1").strip().lower() or "1"
+    if v not in ("0", "1", "on", "off", "true", "false"):
+        raise ValueError(f"TF_DSV41_DEPTH_JOINT={v!r}: expected 0 or 1")
+    return v in ("1", "on", "true")
+
+
+def rows_cap() -> int:
+    """The widest window a round may verify: TF_DSV41_GRAPH_ROWS_MAX (64, the largest row-graph bucket)."""
+
+    raw = os.environ.get("TF_DSV41_GRAPH_ROWS_MAX", "").strip()
+    return max(1, min(int(raw), ROWS_CAP)) if raw else ROWS_CAP
+
+
+def gains(qs: Sequence[float], least: int, top: int) -> list[float]:
+    """Marginal expected tokens of drafts least+1 .. top: g_j = q_1 ... q_{j+1} for j = least .. top - 1."""
+
+    out, run = [], 1.0
+    for j in range(top):
+        run *= float(qs[j])
+        if j >= least:
+            out.append(run)
+    return out
+
+
+def allocate(qs: Sequence[Sequence[float]], least: Sequence[int], top: Sequence[int], *, shared: int,
+             rows_ms: Callable[[int], float], rate: float, max_rows: int = ROWS_CAP) -> tuple[list[int], float]:
+    """(each slot's k, the objective sum E - rate x C(R) without the constant terms). ``qs[s]``: slot s's calibrated
+    chances (at least ``top[s]`` of them); ``shared``: rows of the round's other windows (lookup / plain)."""
+
+    n = len(qs)
+    lo = [max(0, min(int(least[s]), int(top[s]))) for s in range(n)]
+    base = int(shared) + sum(1 + lo[s] for s in range(n))
+    cands = []
+    for s in range(n):
+        for i, g in enumerate(gains(qs[s], lo[s], max(lo[s], int(top[s])))):
+            cands.append((-g, s, lo[s] + i))
+    cands.sort()
+    room = max(0, int(max_rows) - base)
+    best_m, best, acc = 0, -rate * rows_ms(base), 0.0
+    for m in range(1, min(room, len(cands)) + 1):
+        acc += -cands[m - 1][0]
+        v = acc - rate * rows_ms(base + m)
+        if v > best + EPS:
+            best_m, best = m, v
+    ks = list(lo)
+    for _, s, _ in cands[:best_m]:
+        ks[s] += 1
+    return ks, best
+
+
+def objective(qs: Sequence[Sequence[float]], ks: Sequence[int], least: Sequence[int], *, shared: int,
+              rows_ms: Callable[[int], float], rate: float) -> float:
+    """``allocate``'s objective of a given allocation (tests: brute force)."""
+
+    tot, rows = 0.0, int(shared)
+    for s, k in enumerate(ks):
+        lo = int(least[s])
+        tot += sum(gains(qs[s], lo, int(k)))
+        rows += 1 + int(k)
+    return tot - rate * rows_ms(rows)
+
+
+__all__ = ["ROWS_CAP", "allocate", "env_on", "gains", "objective", "rows_cap"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/kbench.py b/src/tensorfold/families/deepseek_v41/cuda/kbench.py
new file mode 100644
index 0000000..6e55b00
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/kbench.py
@@ -0,0 +1,256 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G1's expert bench on one GPU: a real layer's routed + shared experts (this rank's half, from the
+checkpoint), upstream's grouped EXL3 kernel against our 0580 load path (``x3ld``) at verify widths R = 1-16:
+
+- bitwise: the layer's output with ``TF_DSV41_EXPERT_LOADS`` on == off, every R and every load setting;
+- speed: ms and GB/s of trellis bytes read (the distinct experts the router picked + the shared entry);
+- the load path alone (probe 3: no decode, no mma) on the gate/up launch: the 0580 gate is >= 220 GB/s.
+
+    python -m tensorfold.families.deepseek_v41.cuda.kbench --model DIR [--layer 3] [--rank 0] [--out kbench.json]
+    ... kbench --model DIR --chunk 2048       a 2,048-row window through GpuMoE (row blocks) == 128-row windows
+
+Rows come from the real router on random activations (the bench's U(R) is the router's, not uniform picks).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+ROWS = (1, 2, 4, 6, 8, 12, 16)
+PF_ROWS = (16, 64, 128, 256, 512, 768, 1024)      # upstream's group_kernel cannot launch at 2,048 x 7 picks (G1)
+PROBE_GATE = 220.0
+
+
+def _time(fn, iters: int) -> float:
+    import torch
+
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench(model: str, layer: int, rank: int, iters: int, rows=ROWS) -> dict:
+    import torch
+
+    from . import blocks as B
+    from . import expert_loads as loads
+    from . import experts as X
+    from . import router
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    ld = W.Loader(cfg, W.Shards(model), rank, 2, "cuda")
+    m = ld.moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    ex = block.ex
+    plan_k2 = {w: [int(v) for v in getattr(ex, f"{n}_k2").tolist()] for w, n in (("w1", "gate"), ("w3", "up"),
+                                                                                 ("w2", "down"))}
+    plan = X.LayerPlan(block.geom, plan_k2)
+    s = X.scratch(block, max(rows))
+    _, topk = cfg.experts_of(layer)
+    gen = torch.Generator(device="cuda").manual_seed(layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": list(ex.k2_gu), "k2_d": list(ex.k2_d), "rows": {}}
+    saved = dict(loads.CFG)
+    try:
+        for R in rows:
+            x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+            pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+            distinct = sorted(set(pick[:, :topk].reshape(-1).tolist()))
+            nbytes = sum(plan.entry_bytes(e) for e in distinct) + sum(
+                plan.entry_bytes(e) for e in range(block.geom.experts, block.geom.table))
+
+            def call():
+                return X.routed(x, pick, wts, block, s, None, R, limit=cfg.swiglu_limit)
+
+            loads.CFG.update(on=False)
+            ref = call().clone()
+            ms_up = _time(call, iters)
+            row = {"distinct": len(distinct), "bytes": nbytes, "upstream_ms": round(ms_up, 4),
+                   "upstream_gbps": round(nbytes / ms_up / 1e6, 1), "x3ld": {}}
+            for cfg_ld in loads.CFGS:
+                loads.CFG.update(on=True, gu=cfg_ld, dn=cfg_ld)
+                got = call().clone()
+                ms = _time(call, iters)
+                row["x3ld"][f"{cfg_ld[0]},{cfg_ld[1]}"] = {"bitwise": bool(torch.equal(got, ref)), "ms": round(ms, 4),
+                                                         "gbps": round(nbytes / ms / 1e6, 1)}
+            row["probe3_gu_gbps"] = probe3(block, s, x, pick, R, plan, distinct, iters)
+            out["rows"][R] = row
+            print(f"R={R}: {len(distinct)} experts, upstream {row['upstream_gbps']} GB/s, x3ld "
+                  + ", ".join(f"{k} {v['gbps']} GB/s {'==' if v['bitwise'] else 'DIFFERS'}"
+                              for k, v in row["x3ld"].items()) + f", probe 3 {row['probe3_gu_gbps']} GB/s",
+                  flush=True)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+    out["bitwise"] = all(v["bitwise"] for r in out["rows"].values() for v in r["x3ld"].values())
+    best = max((r["probe3_gu_gbps"] or 0) for r in out["rows"].values())
+    out["probe3_best_gbps"] = best
+    out["pass"] = out["bitwise"] and best >= PROBE_GATE
+    return out
+
+
+def bench_prefill(model: str, layer: int, rank: int, iters: int, rows=PF_ROWS) -> dict:
+    """x3pf (``expert_prefill``) against upstream's grouped kernel on the real layer: the layer's output bit for bit
+    and ms a call at prefill widths (router picks on random activations)."""
+
+    import torch
+
+    from . import blocks as B
+    from . import expert_loads as loads
+    from . import expert_prefill as PF
+    from . import experts as X
+    from . import router
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    _, topk = cfg.experts_of(layer)
+    gen = torch.Generator(device="cuda").manual_seed(100 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": list(block.ex.k2_gu), "k2_d": list(block.ex.k2_d), "rows": {}}
+    saved_l, saved_p = dict(loads.CFG), dict(PF.CFG)
+    try:
+        loads.CFG.update(on=False)
+        for R in rows:
+            x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+            pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+            s = X.scratch(block, R)         # a scratch a width (G1: 1,024 rows failed to group in a 2,048-row one)
+
+            def call():
+                return X.routed(x, pick, wts, block, s, None, R, limit=cfg.swiglu_limit)
+
+            PF.CFG.update(on=False)
+            ref = call().clone()
+            ms_up = _time(call, iters)
+            row = {"upstream_ms": round(ms_up, 4), "x3pf": {}}
+            for c in PF.CFGS:
+                PF.CFG.update(on=True, gu=c, dn=c, rows=1)
+                got = call().clone()
+                ms = _time(call, iters)
+                row["x3pf"][f"{c[0]},{c[1]}"] = {"bitwise": bool(torch.equal(got, ref)), "ms": round(ms, 4),
+                                                 "speedup": round(ms_up / ms, 3)}
+            out["rows"][R] = row
+            print(f"x3pf R={R}: upstream {ms_up:.3f} ms, " + ", ".join(
+                f"{k} {v['ms']:.3f} ms x{v['speedup']} {'==' if v['bitwise'] else 'DIFFERS'}"
+                for k, v in row["x3pf"].items()), flush=True)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved_l)
+        PF.CFG.clear()
+        PF.CFG.update(saved_p)
+    out["bitwise"] = all(v["bitwise"] for r in out["rows"].values() for v in r["x3pf"].values())
+    return out
+
+
+def bench_chunk(model: str, layer: int, rank: int, rows: int = 2048, window: int = 128) -> dict:
+    """A ``rows``-row prefill window through ``moe.GpuMoE`` (expert passes of ``moe.expert_block`` rows: upstream's
+    ``group`` takes 1,750 at 7 picks) == the same rows in ``window``-row windows, bit for bit, on the real layer."""
+
+    import time
+
+    import torch
+
+    from . import blocks as B
+    from . import moe as M
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    _, topk = cfg.experts_of(layer)
+    moe = M.GpuMoE(m.gate, m.bias, B.gpu_experts(cfg, m, layer, 2, "cuda"), topk, cfg.routed_scaling_factor,
+                   cfg.swiglu_limit)
+    gen = torch.Generator(device="cuda").manual_seed(200 + layer)
+    x = (torch.randn((rows, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    whole = moe(x).clone()
+    torch.cuda.synchronize()
+    ms = (time.perf_counter() - t) * 1e3
+    parts = torch.cat([moe(x[a:a + window]).clone() for a in range(0, rows, window)])
+    out = {"layer": layer, "rank": rank, "rows": rows, "block": M.expert_block(moe.block.geom.slots),
+           "scratch_rows": moe.scratch.rows, "ms": round(ms, 2), "bitwise": bool(torch.equal(whole, parts)),
+           "peak_alloc_gib": round(torch.cuda.max_memory_allocated() / 2 ** 30, 2)}
+    print(f"chunk {rows} rows (expert passes of {out['block']}): {ms:.1f} ms, "
+          f"{'==' if out['bitwise'] else 'DIFFERS FROM'} {window}-row windows", flush=True)
+    return out
+
+
+def probe3(block, s, x, pick, R: int, plan, distinct, iters: int) -> float | None:
+    """The gate/up launch through x3ld's load path alone (probe 3), GB/s of gate + up trellis bytes."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    from . import expert_loads as loads
+
+    ex = block.ex
+    ext = x3._ext()
+    ids, members = s.window(R)
+    ext.group(pick, ids, s.count, members, R, s.slots, ex.count)
+    ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, ex.dims, s.slots, ex.count)
+    nt, w, sk, pf = s.cfg_gu
+    cfg = loads.PROBE_CFGS[0]
+    if not loads.fits(ex.dims, ex.width, sk, w, cfg):
+        return None
+    gu_bytes = sum(ex.dims * ex.width // 256 * 16 * (plan.k2["w1"][e] + plan.k2["w3"][e])
+                   for e in [*distinct, *range(block.geom.experts, block.geom.table)])
+
+    def call():
+        loads.grouped(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2,
+                      ex.dims, ex.width, R * s.slots, sk, s.slots, ex.cb, w, ex.k2_gu[0], ex.k2_gu[1], probe=3,
+                      cfg=cfg)
+
+    ms = _time(call, iters)
+    return round(gu_bytes / ms / 1e6, 1)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--layer", type=int, default=3)
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--iters", type=int, default=50)
+    ap.add_argument("--out", default="")
+    ap.add_argument("--prefill", action="store_true", help="x3pf vs upstream at prefill widths (16-2,048 rows)")
+    ap.add_argument("--chunk", type=int, default=0, help="a CHUNK-row window through GpuMoE == 128-row windows")
+    a = ap.parse_args(argv)
+    if a.chunk:
+        rep = bench_chunk(a.model, a.layer, a.rank, a.chunk)
+        if a.out:
+            Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(json.dumps(rep), flush=True)
+        return 0 if rep["bitwise"] else 1
+    if a.prefill:
+        rep = bench_prefill(a.model, a.layer, a.rank, max(3, a.iters // 5))
+        if a.out:
+            Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(json.dumps({k: v for k, v in rep.items() if k != "rows"}), flush=True)
+        return 0 if rep["bitwise"] else 1
+    rep = bench(a.model, a.layer, a.rank, a.iters)
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({k: v for k, v in rep.items() if k != "rows"}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/l2pf.py b/src/tensorfold/families/deepseek_v41/cuda/l2pf.py
new file mode 100644
index 0000000..321e57e
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/l2pf.py
@@ -0,0 +1,258 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Cross-op L2 prefetch of the next weight streamer's first bytes during a decode window's latency-bound stretches
+(G10, ``TF_DSV41_L2PF``; default off until measured). GLM's patch 0460 (``glm5_next/spark/l2pf.py``), its kernels
+reused as they are (``l2pf.cu``: ``cp.async.bulk.prefetch.L2`` a 32 KiB piece, a 1-4 CTA launch that holds no SM
+for the transfer).
+
+Why. A 1-row window (G9 nsys, rank 0) spends ~9 ms in kernels that leave DRAM idle (mHC site / finish, the RoCE
+gathers and their wait, attention, norms, the router's glue) and ~11.5 ms in dense EXL3 launches that read their
+weights cold at 157-201 GB/s against ~230 for a long stream (G9: the x group 5.7 MB in 36 us, o 10.5 MB in 57 us).
+Here the next dense group's first bytes stream into the 24 MB L2 while the glue runs, on a side stream forked at the
+site (it runs beside the main stream's next kernels, never in front of them; every window joins it before it
+returns, so captured graphs hold no open fork):
+
+``x``  after a block's MoE launches, before its exchange: the NEXT block's attention input group (x4 = wq_a + wkv +
+       compressor, else x2), then the head of its q group (wq_b [+ the indexer's]). Window: the gather (+ the peer's
+       wait) + the next block's mHC boundary, ~45-60 us.
+``o``  after a block's q projections, before its attention core (RoPE, KV store, the indexer, ``_chunks`` /
+       ``_merge``): wo_a's groups, then the head of wo_b. Window ~30 us (index layers ~120 us).
+``f``  after a block's attention launches, before its exchange: the router's gate, then the shared expert's gate and
+       up trellis (the routed experts are unknown until the router). Window ~45-60 us.
+
+A site takes whole tensors in the order the next launch's programs read them, up to ``TF_DSV41_L2PF_MB`` (capped at
+half the L2), the last one's first bytes.
+
+Exactness: the prefetch kernels only read weights into L2 and write nothing; every model kernel runs with the same
+arguments in the same stream order. L2 residency changes timing, never values (tests/cuda/test_dsv41_pdl_gpu.py:
+replies with the knob on == off).
+
+Knobs: ``TF_DSV41_L2PF`` 0 (default) | 1 / bulk | lines; ``TF_DSV41_L2PF_MB`` (8; <= 12); ``TF_DSV41_L2PF_SITES``
+(x,o,f); ``TF_DSV41_L2PF_ROWS`` (16: wider windows skip every site); ``TF_DSV41_L2PF_CHUNK_KB`` (32).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+ENV = "TF_DSV41_L2PF"
+MODES = ("bulk", "lines")
+SITES = ("x", "o", "f")
+ALIGN = 16
+L2_FALLBACK = 24 * 2**20                  # GB10
+
+
+@dataclass(frozen=True)
+class Settings:
+    mode: str | None = None
+    mb: float = 8.0
+    sites: tuple = SITES
+    rows: int = 16
+    chunk_kb: int = 32
+
+    @property
+    def on(self) -> bool:
+        return self.mode is not None
+
+
+def _num(env, name, default, lo, hi, kind=float):
+    raw = str(env.get(name, "")).strip()
+    if not raw:
+        return default
+    try:
+        v = kind(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def settings(env: dict | None = None) -> Settings:
+    env = os.environ if env is None else env
+    raw = str(env.get(ENV, "")).strip().lower()
+    if raw in ("", "0", "off", "none", "false"):
+        return Settings()
+    mode = "bulk" if raw in ("1", "on", "true") else raw
+    if mode not in MODES:
+        raise ValueError(f"{ENV}={raw!r}: expected 0, 1, bulk or lines")
+    sites_raw = str(env.get(ENV + "_SITES", "")).strip().lower()
+    sites = SITES
+    if sites_raw:
+        sites = tuple(dict.fromkeys(s.strip() for s in sites_raw.split(",") if s.strip()))
+        if not sites or any(s not in SITES for s in sites):
+            raise ValueError(f"{ENV}_SITES={sites_raw!r}: expected a comma list of {', '.join(SITES)}")
+    return Settings(mode, float(_num(env, ENV + "_MB", 8.0, 0.0625, 12.0)), sites,
+                    int(_num(env, ENV + "_ROWS", 16, 1, 4096, int)),
+                    int(_num(env, ENV + "_CHUNK_KB", 32, 1, 1024, int)))
+
+
+# -- plans ------------------------------------------------------------------------------------------------------------
+def _span(t, left: int):
+    """(address, bytes) of the first ``left`` bytes of tensor t, 16-byte aligned start, a multiple of 16; or None."""
+
+    if not isinstance(t, torch.Tensor) or not t.is_contiguous() or t.numel() == 0:
+        return None
+    start = t.data_ptr()
+    end = start + t.numel() * t.element_size()
+    a = -(-start // ALIGN) * ALIGN
+    n = min(left, end - a) // ALIGN * ALIGN
+    return (a, n) if n > 0 else None
+
+
+def take(tensors: list, budget: int) -> list[tuple[int, int]]:
+    """Spans of ``tensors`` in order (each whole, the last one's head), ``budget`` bytes in all."""
+
+    out, left = [], int(budget)
+    for t in tensors:
+        if left < ALIGN:
+            break
+        s = _span(t, left)
+        if s is not None:
+            out.append(s)
+            left -= s[1]
+    return out
+
+
+def _lin_tensors(lins) -> list:
+    """An x3seg group's reads in its programs' order: every segment's small vectors first (read by every program),
+    then the trellis words segment by segment."""
+
+    lins = [x for x in lins if x is not None]
+    return [v for x in lins for v in (x.suh, x.svh)] + [x.words for x in lins]
+
+
+def site_tensors(blk, nxt, site: str) -> list:
+    """What the launches after ``site`` of block ``blk`` read first (``nxt``: the block after it, for ``x``)."""
+
+    from . import fused_proj as FP
+
+    if site == "x":
+        g = getattr(nxt, "fused", None) if nxt is not None else None
+        if g is None:
+            return []
+        x = g.x4 if g.x4 is not None else g.x2
+        q = g.q.lins if g.q is not None else [FP.lin_of(nxt.attn.wq_b)]
+        return _lin_tensors(x.lins) + _lin_tensors(q)
+    if site == "o":
+        g = getattr(blk, "fused", None)
+        o = g.o.lins if g is not None and g.o is not None else [FP.lin_of(w) for w in blk.attn.wo_a]
+        return _lin_tensors(o) + _lin_tensors([FP.lin_of(blk.attn.wo_b)])
+    if site == "f":
+        m = getattr(blk, "moe", None)
+        out = [getattr(m, "gate", None)]
+        ex = getattr(getattr(m, "block", None), "ex", None)
+        keep = getattr(ex, "keep", None)
+        if ex is not None and keep and len(keep) == 3 * ex.count:      # prepare(): gate E, up E, down E trellises
+            out += [keep[ex.count - 1], keep[2 * ex.count - 1]]      # the shared expert: the last entry
+        return out
+    raise ValueError(site)
+
+
+# -- the prefetcher ---------------------------------------------------------------------------------------------------
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    glm = Path(__file__).resolve().parents[2] / "glm5_next" / "spark"
+    return load(name="tf_dsv41_l2pf_v1", sources=[str(glm / "l2pf.cpp"), str(glm / "l2pf.cu")],
+                extra_cflags=["-O2"], extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@dataclass
+class Stats:
+    launches: int = 0
+    skipped_rows: int = 0
+    by_site: dict = field(default_factory=dict)      # planned bytes a site kind, all blocks
+
+
+class Prefetcher:
+    THREADS = 128
+
+    def __init__(self, blocks: list, device, s: Settings) -> None:
+        props = torch.cuda.get_device_properties(device)
+        l2 = int(getattr(props, "L2_cache_size", 0) or 0) or L2_FALLBACK
+        self.s, self.sms, self.chunk = s, int(props.multi_processor_count), s.chunk_kb * 1024
+        self.budget = min(int(s.mb * 2**20), l2 // 2)
+        self.stats = Stats()
+        self.tables: dict = {}
+        self.bytes: dict = {}
+        for i, blk in enumerate(blocks):
+            nxt = blocks[i + 1] if i + 1 < len(blocks) else None
+            for site in s.sites:
+                spans = take(site_tensors(blk, nxt, site), self.budget)
+                if spans:
+                    self.tables[(id(blk), site)] = torch.tensor(spans, dtype=torch.int64, device=device).view(-1, 2)
+                    nb = sum(b for _, b in spans)
+                    self.bytes[(id(blk), site)] = nb
+                    self.stats.by_site[site] = self.stats.by_site.get(site, 0) + nb
+        self.ext = _ext()
+        self.side = torch.cuda.Stream(device=device)
+        self.pending = False
+        self._cap = False
+
+    def mark(self, blk, site: str, rows: int) -> None:
+        """Site ``site`` of ``blk`` reached with ``rows`` rows: fork the side stream here and prefetch its plan."""
+
+        table = self.tables.get((id(blk), site))
+        if table is None:
+            return
+        if rows > self.s.rows:
+            self.stats.skipped_rows += 1
+            return
+        cur = torch.cuda.current_stream()
+        cap = torch.cuda.is_current_stream_capturing()
+        if self.pending and cap != self._cap:
+            self.pending = False                          # an eager fork never joins a capture (and vice versa)
+        self.side.wait_stream(cur)
+        self._cap, self.pending = cap, True
+        pieces = -(-self.bytes[(id(blk), site)] // (self.chunk if self.s.mode == "bulk" else 128))
+        grid = max(1, min(self.sms, -(-pieces // self.THREADS)))
+        with torch.cuda.stream(self.side):
+            self.ext.segments(table, grid, self.THREADS, self.chunk, self.s.mode == "bulk")
+        self.stats.launches += 1
+
+    def join(self) -> None:
+        if self.pending:
+            if torch.cuda.is_current_stream_capturing() == self._cap:
+                torch.cuda.current_stream().wait_stream(self.side)
+            self.pending = False
+
+
+def install(blocks: list, device) -> Prefetcher | None:
+    """At forward build (before any capture): a prefetcher on every block (``blk.l2pf``) when ``TF_DSV41_L2PF`` is on
+    and the device is CUDA; else None and nothing changes."""
+
+    s = settings()
+    dev = torch.device(device)
+    if not s.on or dev.type != "cuda" or not torch.cuda.is_available():
+        return None
+    pf = Prefetcher(blocks, dev, s)
+    for blk in blocks:
+        blk.l2pf = pf
+    kinds = ", ".join(f"{k} {v / 2**20:.1f} MiB" for k, v in sorted(pf.stats.by_site.items()))
+    print(f"[dsv41] l2pf: {s.mode}, {pf.budget / 2**20:g} MiB a site, sites {','.join(s.sites)} ({kinds}); windows "
+          f"<= {s.rows} rows", flush=True)
+    return pf
+
+
+def mark(blk, site: str, rows: int) -> None:
+    """The forward's hook (off: one attribute lookup)."""
+
+    pf = getattr(blk, "l2pf", None)
+    if pf is not None:
+        pf.mark(blk, site, rows)
+
+
+def join(blocks: list) -> None:
+    pf = getattr(blocks[0], "l2pf", None) if blocks else None
+    if pf is not None:
+        pf.join()
+
+
+__all__ = ["ENV", "SITES", "Prefetcher", "Settings", "install", "join", "mark", "settings", "site_tensors", "take"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/l2probe.py b/src/tensorfold/families/deepseek_v41/cuda/l2probe.py
new file mode 100644
index 0000000..6720fed
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/l2probe.py
@@ -0,0 +1,186 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G10's L2 probe (one GPU, ~1 min): how much a weight read gains from being in L2 on this GPU, and whether the L2
+persistence controls work here. It decides between ``TF_DSV41_L2PF`` (a prefetch kernel on a side stream) and an
+access-policy window (``cudaStreamAttributeAccessPolicyWindow`` / ``cudaLimitPersistingL2CacheSize``).
+
+For a weight-sized buffer W (``--mb``, default 6 and 12: the x group and the half-L2 cap), read by a plain fp32 sum:
+
+- ``cold``      after a 96 MB stream evicted W (the in-window case for a dense group);
+- ``hot``       right after reading W (the L2-hot ceiling a perfect prefetch could reach);
+- ``l2pf``      cold, then ``l2pf``'s bulk prefetch kernel over W on a side stream, a ``--gap`` us spin on the main
+                stream (the glue window), then the read: what the prefetch site buys;
+- ``persist``   cold with W inside the stream's access-policy window (hitRatio 1, persisting) set before the flush:
+                whether persistence keeps W through the 96 MB stream. Skipped (with the reason) when the device
+                reports no persisting L2 (``cudaDevAttrMaxPersistingL2CacheSize`` 0) or the runtime call fails.
+
+    python -m tensorfold.families.deepseek_v41.cuda.l2probe [--mb 6,12] [--gap 40] [--json OUT]
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import glob
+import json
+import os
+
+import torch
+
+ATTR_L2 = 38                    # cudaDevAttrL2CacheSize
+ATTR_PERSIST_MAX = 108          # cudaDevAttrMaxPersistingL2CacheSize
+ATTR_WINDOW_MAX = 109           # cudaDevAttrMaxAccessPolicyWindowSize
+LIMIT_PERSIST = 0x06            # cudaLimitPersistingL2CacheSize
+STREAM_ATTR_WINDOW = 1          # cudaStreamAttributeAccessPolicyWindow (= cudaLaunchAttributeAccessPolicyWindow)
+PROP_NORMAL, PROP_STREAMING, PROP_PERSISTING = 0, 1, 2
+
+
+class _Window(ctypes.Structure):
+    _fields_ = [("base_ptr", ctypes.c_void_p), ("num_bytes", ctypes.c_size_t), ("hitRatio", ctypes.c_float),
+                ("hitProp", ctypes.c_int), ("missProp", ctypes.c_int)]
+
+
+class _Value(ctypes.Union):    # cudaLaunchAttributeValue: 64 bytes, the window first
+    _fields_ = [("window", _Window), ("pad", ctypes.c_char * 64)]
+
+
+def _cudart():
+    names = ["libcudart.so", "libcudart.so.13", "libcudart.so.12"]
+    for d in [os.path.dirname(torch.__file__) + "/lib", *glob.glob(os.path.dirname(torch.__file__) +
+                                                                    "/../nvidia/cu*/lib"),
+              *glob.glob(os.path.dirname(torch.__file__) + "/../nvidia/cuda_runtime/lib"), "/usr/local/cuda/lib64"]:
+        for n in names:
+            p = os.path.join(d, n)
+            if os.path.exists(p):
+                return ctypes.CDLL(p)
+    for n in names:
+        try:
+            return ctypes.CDLL(n)
+        except OSError:
+            continue
+    raise OSError("libcudart not found")
+
+
+def attrs(rt, dev: int) -> dict:
+    out = {}
+    for name, a in (("l2", ATTR_L2), ("persist_max", ATTR_PERSIST_MAX), ("window_max", ATTR_WINDOW_MAX)):
+        v = ctypes.c_int(0)
+        rc = rt.cudaDeviceGetAttribute(ctypes.byref(v), a, dev)
+        out[name] = int(v.value) if rc == 0 else f"error {rc}"
+    return out
+
+
+def _spin(us: float) -> None:
+    torch.cuda._sleep(int(us * 2000))             # ~2,000 cycles a us (GB10 ~2.4 GHz): a rough wait on the main stream
+
+
+def _time(fn, reps: int) -> float:
+    ts = []
+    for _ in range(reps):
+        a, b = torch.cuda.Event(True), torch.cuda.Event(True)
+        fn(a, b)
+        torch.cuda.synchronize()
+        ts.append(a.elapsed_time(b) * 1e3)
+    ts.sort()
+    return ts[len(ts) // 2]
+
+
+def probe(mb_list=(6.0, 12.0), gap_us: float = 40.0, reps: int = 21) -> dict:
+    dev = torch.cuda.current_device()
+    res: dict = {"device": torch.cuda.get_device_name(dev), "rows": []}
+    try:
+        rt = _cudart()
+        res["attrs"] = attrs(rt, dev)
+    except OSError as e:
+        rt, res["attrs"] = None, {"error": str(e)}
+    flush = torch.empty(96 * 2**20 // 4, dtype=torch.float32, device="cuda")
+    from . import l2pf as L2
+
+    ext = L2._ext()
+    side = torch.cuda.Stream()
+    for mb in mb_list:
+        w = torch.randn(int(mb * 2**20) // 4, device="cuda")
+        table = torch.tensor([[w.data_ptr(), w.numel() * 4 // 16 * 16]], dtype=torch.int64, device="cuda")
+        row = {"mb": mb}
+
+        def cold(a, b, w=w):
+            flush.sum()
+            a.record()
+            w.sum()
+            b.record()
+
+        def hot(a, b, w=w):
+            w.sum()
+            a.record()
+            w.sum()
+            b.record()
+
+        def pf(a, b, w=w, table=table):
+            flush.sum()
+            side.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(side):
+                ext.segments(table, 48, 128, 32 * 1024, True)
+            _spin(gap_us)
+            a.record()
+            w.sum()
+            b.record()
+            torch.cuda.current_stream().wait_stream(side)
+
+        for k, fn in (("cold", cold), ("hot", hot), ("l2pf", pf)):
+            us = _time(fn, reps)
+            row[k + "_us"] = round(us, 1)
+            row[k + "_gbps"] = round(mb * 2**20 / us / 1e3, 1)
+        row["persist"] = _persist(rt, res.get("attrs", {}), w, flush, reps) if rt is not None else "no cudart"
+        res["rows"].append(row)
+    return res
+
+
+def _persist(rt, at: dict, w, flush, reps: int):
+    """W in a persisting access-policy window of the current stream, then the cold read; the window reset after."""
+
+    if not isinstance(at.get("persist_max"), int) or at["persist_max"] <= 0:
+        return f"no persisting L2 (max {at.get('persist_max')})"
+    nbytes = min(w.numel() * 4, int(at.get("window_max") or 0) or w.numel() * 4)
+    if rt.cudaDeviceSetLimit(LIMIT_PERSIST, ctypes.c_size_t(min(nbytes, at["persist_max"]))) != 0:
+        return "cudaDeviceSetLimit(persisting) failed"
+    stream = ctypes.c_void_p(torch.cuda.current_stream().cuda_stream)
+    v = _Value()
+    v.window = _Window(w.data_ptr(), nbytes, 1.0, PROP_PERSISTING, PROP_STREAMING)
+    if rt.cudaStreamSetAttribute(stream, STREAM_ATTR_WINDOW, ctypes.byref(v)) != 0:
+        return "cudaStreamSetAttribute(window) failed"
+    try:
+        def run(a, b):
+            w.sum()                                   # W in, persisting
+            flush.sum()                               # a 96 MB stream (normal / streaming lines)
+            a.record()
+            w.sum()
+            b.record()
+
+        us = _time(run, reps)
+        return {"us": round(us, 1), "gbps": round(w.numel() * 4 / us / 1e3, 1), "window_mb": round(nbytes / 2**20, 2)}
+    finally:
+        v.window = _Window(None, 0, 0.0, PROP_NORMAL, PROP_NORMAL)
+        rt.cudaStreamSetAttribute(stream, STREAM_ATTR_WINDOW, ctypes.byref(v))
+        rt.cudaCtxResetPersistingL2Cache()
+        rt.cudaDeviceSetLimit(LIMIT_PERSIST, ctypes.c_size_t(0))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--mb", default="6,12")
+    ap.add_argument("--gap", type=float, default=40.0)
+    ap.add_argument("--json")
+    a = ap.parse_args()
+    r = probe(tuple(float(x) for x in a.mb.split(",")), a.gap)
+    print(f"[G10] l2probe {r['device']}: attrs {r['attrs']}")
+    for row in r["rows"]:
+        print(f"[G10] l2probe {row['mb']} MB: cold {row['cold_us']} us ({row['cold_gbps']} GB/s), hot {row['hot_us']} "
+              f"({row['hot_gbps']}), l2pf + {a.gap:g} us gap {row['l2pf_us']} ({row['l2pf_gbps']}), persist "
+              f"{row['persist']}")
+    if a.json:
+        with open(a.json, "w") as f:
+            json.dump(r, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tensorfold/families/deepseek_v41/cuda/linear.py b/src/tensorfold/families/deepseek_v41/cuda/linear.py
