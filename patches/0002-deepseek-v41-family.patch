+++ b/tests/cuda/test_dsv41_engram_pcache_gpu.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram's projected-row cache on the GPU (``engram_pcache``; collected only where PyTorch sees a GPU):
+
+- upstream's EXL3 linear with the skip word: 0 = the same bits as without it, nonzero = ``out`` untouched; rows alone
+  == rows in a window (the cache's premise), at the real Engram ``wkv`` shape (6,144 -> 25,600, 5 bits) too, with
+  the time of a launch that runs and one that skips printed;
+- ``PCache.project`` over a stream of windows (hits, partial hits, evictions) == the linear, bit for bit, eager and
+  as one captured CUDA graph replayed with a new plan each time;
+- the forward (synthetic checkpoint, packed shards): the gate with the cache == without the gate, eager windows and
+  graph replays, the same windows replayed (every layer window skips its matmul).
+
+Run: python -m pytest -q tests/cuda/test_dsv41_engram_pcache_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.cuda.exl3.linear import Exl3Linear
+from tensorfold.families.deepseek_v41.cuda import engram_pcache as EP
+
+DEV = "cuda"
+
+
+def _lin(k: int, n: int, bits: int, seed: int) -> Exl3Linear:
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device=DEV)
+
+
+def _bits(t: torch.Tensor) -> torch.Tensor:
+    return t.view(torch.int16)
+
+
+@pytest.mark.parametrize("k,n", [(512, 1280), (6144, 25600)])
+def test_skip_word_and_row_invariance(k, n):
+    lin = _lin(k, n, 5, k)
+    x = (torch.randn((7, k), device=DEV) * 0.5).to(torch.bfloat16)
+    ref = lin(x, out_dtype=torch.bfloat16)
+    zero = torch.zeros(1, dtype=torch.int32, device=DEV)
+    one = torch.ones(1, dtype=torch.int32, device=DEV)
+    got = torch.full_like(ref, 3.0)
+    lin(x, out=got, skip=zero)
+    assert torch.equal(_bits(got), _bits(ref))
+    kept = torch.full_like(ref, 3.0)
+    lin(x, out=kept, skip=one)
+    torch.cuda.synchronize()
+    assert bool((kept == 3.0).all())
+    for i in range(x.shape[0]):
+        assert torch.equal(_bits(lin(x[i:i + 1], out_dtype=torch.bfloat16)), _bits(ref[i:i + 1])), i
+    for a, b in ((0, 3), (2, 7)):
+        assert torch.equal(_bits(lin(x[a:b], out_dtype=torch.bfloat16)), _bits(ref[a:b]))
+    if k == 6144:                                   # the real shape: a launch that runs vs one that skips
+        out = torch.empty((1, n), dtype=torch.bfloat16, device=DEV)
+        for flag, name in ((zero, "runs"), (one, "skips")):
+            for _ in range(3):
+                lin(x[:1], out=out, skip=flag)
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            for _ in range(20):
+                lin(x[:1], out=out, skip=flag)
+            torch.cuda.synchronize()
+            print(f"Engram wkv 6144 x 25600 (5 bits, 1 row): rot_in + linear that {name}: "
+                  f"{(time.perf_counter() - t0) / 20 * 1e6:.1f} us")
+
+
+def _row(key: bytes, k: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(int.from_bytes(key, "little"))
+    return torch.randn(k, generator=g).to(torch.bfloat16)
+
+
+def _stream(steps: int, rows: int, seed: int):
+    rng = np.random.default_rng(seed)
+    pool = [bytes([i, 3]) for i in range(12)]
+    for step in range(steps):
+        m = int(rng.integers(1, rows + 1))
+        yield [pool[int(j)] for j in rng.integers(0, len(pool) if step % 3 else 3, size=m)]
+
+
+def test_project_eager_equals_matmul():
+    k, n, rows = 512, 1280, 6
+    lins = {1: _lin(k, n, 5, 1), 14: _lin(k, n, 4, 2)}
+    pc = EP.PCache([1, 14], lins, n, rows, 13, DEV)
+    for step, keys in enumerate(_stream(150, rows, 0)):
+        new = pc.plan({1: keys, 14: keys})
+        x = torch.stack([_row(key, k) for key in keys]).to(DEV)
+        for pos, L in enumerate((1, 14)):
+            got = pc.project(pos, x, torch.bfloat16)
+            assert torch.equal(_bits(got), _bits(lins[L](x, out_dtype=torch.bfloat16))), (step, L)
+        torch.cuda.synchronize()                    # the arm's sync: the next plan rewrites pinned memory
+        if step == 40:
+            pc.forget(new)
+    assert pc.stats["skipped"] > 0 and pc.stats["skipped"] < pc.stats["windows"]
+
+
+def test_project_in_a_cuda_graph():
+    """One capture of the projection over R padded rows; each replay a new plan (all hit, some, none)."""
+
+    k, n, rows = 512, 1280, 4
+    lin = _lin(k, n, 5, 7)
+    pc = EP.PCache([1], {1: lin}, n, rows, 9, DEV)
+    xs = torch.zeros((rows, k), dtype=torch.bfloat16, device=DEV)
+    pc.plan({1: [b"warm"]})
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        pc.project(0, xs, torch.bfloat16)           # Triton compiled outside the capture
+    torch.cuda.current_stream().wait_stream(s)
+    torch.cuda.synchronize()
+    pc.forget({1: [b"warm"]})
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        out = pc.project(0, xs, torch.bfloat16)
+    skipped = 0
+    for step, keys in enumerate(_stream(120, rows, 1)):
+        torch.cuda.synchronize()
+        pc.plan({1: keys})
+        skipped += int(pc.host_np[0, 0])
+        x = torch.stack([_row(key, k) for key in keys] + [_row(b"pad", k)] * (rows - len(keys))).to(DEV)
+        xs.copy_(x)
+        g.replay()
+        want = lin(x[:len(keys)], out_dtype=torch.bfloat16)
+        assert torch.equal(_bits(out[:len(keys)]), _bits(want)), (step, keys)
+    assert 0 < skipped < 120
+
+
+# -- the forward ---------------------------------------------------------------------------------------------------
+LONG = 4096
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "warm": "decode"}
+PROMPT = [int(t) for t in np.random.default_rng(33).integers(3, 250, size=180)]
+WINDOWS = [tuple(int(t) for t in np.random.default_rng(50 + i).integers(3, 250, size=w))
+           for i, w in enumerate((1, 4, 2, 6, 3, 1, 5, 2))]
+
+
+@pytest.fixture(autouse=True)
+def _seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+    monkeypatch.setenv("TF_DSV41_DENSE", "0")
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pcg"))
+
+
+@pytest.fixture(scope="module")
+def packed(ck, tmp_path_factory):
+    import dsv41_fakes as FK
+
+    return FK.write_engram(tmp_path_factory.mktemp("pcache-shards-g"), ck[1], ck[2], 1)
+
+
+def _fw(ck, packed, monkeypatch, gate: bool, pcache: int = 0):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    monkeypatch.setenv("TF_DSV41_ENGRAM_GATE", "1" if gate else "0")
+    monkeypatch.setenv(EP.KNOB, str(pcache))
+    rows = EH.open_shards(packed, 0, 1, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    fw = DF.forward(ck, slots=1, limit=LONG, device=DEV, chunk=128, prefetch=True, rows=rows)
+    assert (fw.gate is not None) == gate and (not gate or (fw.gate.pc is not None) == (pcache > 0))
+    return fw
+
+
+def _pass(fw, b, run):
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    b.ex.slots[0].ensure(LONG)
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(PROMPT))], mode="full")
+    out = []
+    for ids in WINDOWS:
+        out.append(run([Seg(0, fw.slots[0].pos, ids)]).clone())
+        if fw.gate is not None:
+            fw.gate.check()
+        fw.keep(0, len(ids) - 1)
+    return out
+
+
+@pytest.mark.parametrize("graphs", [False, True])
+def test_forward_with_pcache_equals_no_gate(ck, packed, monkeypatch, graphs):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import graphs as G
+
+    e = _fw(ck, packed, monkeypatch, False)
+    be = DF.batcher(ck, e, capacity=LONG, pool_tokens=2 * LONG)
+    ref = _pass(e, be, e.run)
+    g = _fw(ck, packed, monkeypatch, True, pcache=64)
+    bg = DF.batcher(ck, g, capacity=LONG, pool_tokens=2 * LONG)
+    run = g.run
+    if graphs:
+        g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+        g.graphs.warmup(1, lambda s, end: bg.ex.slots[s].ensure(end))
+        run = g.graphs.run
+    for rep in range(3):                            # rep 1, 2: the same windows at the same contexts: all hit
+        got = _pass(g, bg, run)
+        for i, (a, b) in enumerate(zip(got, ref)):
+            assert torch.equal(a, b), (rep, i, len(WINDOWS[i]))
+    st, nl = g.gate.pc.stats, len(g.gate.layers)
+    assert st["skipped"] >= 2 * nl * len(WINDOWS), g.gate.describe()
+    if graphs:
+        assert g.graphs.cache.stats["replays"] > 0 and g.graphs.cache.stats["failed"] == 0
+    print(g.gate.describe())
