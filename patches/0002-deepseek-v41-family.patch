index 0000000..62f5fe4
--- /dev/null
+++ b/tests/cuda/test_dsv41_decode_glue_gpu.py
@@ -0,0 +1,177 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 decode glue on the GPU (collected only where PyTorch sees an NVIDIA GPU), compiled kernels at D = 5,120:
+
+- mHC at decode widths (1 / 2 / 4 / 6 / 16 / 32 rows): the per-stream programs (``_site`` SPLIT, out of place) and the
+  unrolled finish == the 4-stream program and rolled finish in place, bf16 gathered partials == fp32, bit for bit,
+  for boundary (with taps), site and final; inside a CUDA graph too; the time of old vs new (printed, ``[G7D]``);
+- the fused float64 RMSNorm (``rmsnorm``) == torch's 9-kernel float64 form at [n, 1,280] / [n, 512] (bitwise; the
+  test reports any difference, which can only be a float64 sum-order tie) and row-invariant; its time vs torch's;
+- the exchange glue a partial: ``kit_partial`` + fp32 (2 kernels) vs one bf16 cast (printed).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_decode_glue_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import mhc, rmsnorm  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pick as P  # noqa: E402
+
+DEV = "cuda"
+D = 5120
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _us(fn, reps: int = 50) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return 1000.0 * a.elapsed_time(b) / reps
+
+
+def _case(R: int, world: int = 2, seed: int = 1):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16).to(DEV)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16).float().to(DEV)
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, DEV, pre=(torch.rand((R, 4), generator=g) + 0.1).to(DEV),
+                     post=(torch.rand((R, 4), generator=g) * 2).to(DEV), comb=comb.to(DEV))
+    hc = mhc.Hc((torch.randn((24, 4 * D), generator=g) * 0.01).to(DEV), (torch.randn(24, generator=g) * 0.5).to(DEV),
+                (torch.rand(3, generator=g) + 0.5).to(DEV))
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    return x, gathered, prev, hc, nw
+
+
+class _Bufs:
+    def __init__(self, x, R):
+        self.xb, self.xo = x.clone(), torch.zeros_like(x)
+        self.o = torch.zeros((R, D), dtype=torch.bfloat16, device=DEV)
+        self.co = mhc.Coefs(R, DEV)
+        self.sc = mhc.Scratch(R, DEV, D)
+        self.tp = torch.zeros((R, D), dtype=torch.bfloat16, device=DEV)
+
+
+def _boundary(b: _Bufs, x, gathered, prev, hc, nw, in_place: bool):
+    b.xb.copy_(x)
+    mhc.boundary(b.xb, b.xb if in_place else b.xo, gathered, prev, hc, nw, b.o, b.co, b.sc, tap=b.tp)
+
+
+def _outs(b: _Bufs, R: int, in_place: bool) -> dict:
+    return dict(x=(b.xb if in_place else b.xo).clone(), o=b.o.clone(), pre=b.co.pre.clone(), post=b.co.post.clone(),
+                comb=b.co.comb.clone(), c=b.sc.c[:R].clone(), tap=b.tp.clone(), part=b.sc.part[:R].clone())
+
+
+@pytest.mark.parametrize("R", [1, 2, 4, 6, 16, 32])
+def test_mhc_decode_new_equals_old_and_time(monkeypatch, R):
+    x, gathered, prev, hc, nw = _case(R)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "0")
+    monkeypatch.setenv("TF_DSV41_MHC_UNROLL", "0")
+    old = _Bufs(x, R)
+    _boundary(old, x, gathered, prev, hc, nw, True)
+    want = _outs(old, R, True)
+    t_old = _us(lambda: _boundary(old, x, gathered, prev, hc, nw, True))
+    s_old = _us(lambda: mhc.site(x, hc, nw, old.o, old.co, old.sc, prev.pre))
+    monkeypatch.delenv("TF_DSV41_MHC_SPLIT_ROWS")
+    monkeypatch.delenv("TF_DSV41_MHC_UNROLL")
+    assert mhc.out_of_place(R) == (R <= 32)
+    half = gathered.to(torch.bfloat16)
+    new = _Bufs(x, R)
+    _boundary(new, x, half, prev, hc, nw, False)
+    got = _outs(new, R, False)
+    for k in want:
+        assert torch.equal(_bits(got[k]), _bits(want[k])), k
+    t_new = _us(lambda: _boundary(new, x, half, prev, hc, nw, False))
+    s_new = _us(lambda: mhc.site(x, hc, nw, new.o, new.co, new.sc, prev.pre))
+    print(f"[G7D] mhc boundary {R} row(s): old (in place, 4-stream, rolled, fp32 G) {t_old:.1f} us, new (split, "
+          f"unrolled, bf16 G) {t_new:.1f} us; site {s_old:.1f} -> {s_new:.1f} us (each incl. the copy of x: "
+          f"{_us(lambda: new.xb.copy_(x)):.1f} us)")
+
+
+def test_mhc_split_in_a_cuda_graph(monkeypatch):
+    R = 3
+    x, gathered, prev, hc, nw = _case(R, seed=5)
+    want = _Bufs(x, R)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "0")
+    _boundary(want, x, gathered, prev, hc, nw, True)
+    monkeypatch.delenv("TF_DSV41_MHC_SPLIT_ROWS")
+    b = _Bufs(x, R)
+    half = gathered.to(torch.bfloat16)
+    s = torch.cuda.Stream()
+    with torch.cuda.stream(s):
+        _boundary(b, x, half, prev, hc, nw, False)                  # compile outside the capture
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        _boundary(b, x, half, prev, hc, nw, False)
+    b.xo.zero_()
+    g.replay()
+    torch.cuda.synchronize()
+    w, got = _outs(want, R, True), _outs(b, R, False)
+    for k in w:
+        assert torch.equal(_bits(got[k]), _bits(w[k])), k
+
+
+def test_mhc_final_and_site_split(monkeypatch):
+    R = 5
+    x, gathered, prev, hc, nw = _case(R, seed=9)
+    res = {}
+    for split in ("0", "32"):
+        monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", split)
+        o = torch.zeros((R, D), dtype=torch.bfloat16, device=DEV)
+        co, sc = mhc.Coefs(R, DEV), mhc.Scratch(R, DEV, D)
+        mhc.site(x, hc, nw, o, co, sc, None)
+        xf, of, scf = torch.zeros_like(x), torch.zeros_like(o), mhc.Scratch(R, DEV, D)
+        mhc.final(x, xf, gathered.to(torch.bfloat16) if split != "0" else gathered, prev, nw, of, scf)
+        res[split] = [o, co.pre, co.post, co.comb, xf, of, scf.c[:R]]
+    for a, b in zip(res["0"], res["32"]):
+        assert torch.equal(_bits(a), _bits(b))
+
+
+def _rms_torch(x, w, eps):
+    x = x.to(torch.float64)
+    y = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+    return (y * w.to(torch.float64)).to(torch.bfloat16)
+
+
+@pytest.mark.parametrize("K", [1280, 512])
+def test_rms_equals_torch_and_time(K):
+    g = torch.Generator().manual_seed(K)
+    w = (torch.rand(K, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    diffs = 0
+    for n in (1, 6, 16, 128):
+        scale = torch.logspace(-5, 2, K)[torch.randperm(K, generator=g)]
+        x = (torch.randn((n, K), generator=g) * scale).to(torch.bfloat16).to(DEV)
+        got = rmsnorm.rms(x, w, 1e-6, torch.bfloat16)
+        diffs += int((got.view(torch.int16) != _rms_torch(x, w, 1e-6).view(torch.int16)).sum())
+        for r in (0, n - 1):
+            assert torch.equal(rmsnorm.rms(x[r:r + 1], w, 1e-6, torch.bfloat16), got[r:r + 1])
+        if n in (1, 6):
+            t_old = _us(lambda: _rms_torch(x, w, 1e-6))
+            t_new = _us(lambda: rmsnorm.rms(x, w, 1e-6, torch.bfloat16))
+            print(f"[G7D] rms [{n}, {K}]: torch float64 {t_old:.1f} us, fused {t_new:.1f} us")
+    print(f"[G7D] rms [*, {K}]: {diffs} bf16 values differ from torch's float64 form")
+    assert diffs == 0
+
+
+def test_exchange_cast_glue_time():
+    p = torch.randn((3, D), device=DEV)
+    assert torch.equal(_bits(p.to(torch.bfloat16)), _bits(P.kit_partial(p).to(torch.bfloat16)))
+    t_old = _us(lambda: P.kit_partial(p).contiguous())
+    t_new = _us(lambda: p.to(torch.bfloat16))
+    print(f"[G7D] a 3-row partial's glue before the exchange: kit_partial (2 kernels) {t_old:.1f} us, bf16 cast "
+          f"{t_new:.1f} us; bytes a rank {p.numel() * 4} -> {p.numel() * 2}")
