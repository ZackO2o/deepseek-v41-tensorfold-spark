+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""x3dn.cu v2 (``dense``, TF_DSV41_DENSE) builds for sm_121 (GB10) without torch headers (-DDSV41_X3DN_NO_TORCH): every
+instance the launcher dispatches (K2 6-16, ring depth 2-4) and rot_in, with the extension's flags; no spills, no
+stack frame, registers within 3 CTAs an SM (<= 168 at 128 threads). With a cuobjdump (``TF_CUOBJDUMP``, PATH, or
+Triton's bundled one) the SASS of K2 10 / PD 3 is checked too: the weights come in 16-byte LDGSTS (cp.async.cg),
+the inputs in LDGSTS, the k step waits on DEPBAR, and nothing touches local memory. Needs an nvcc that knows
+compute_121 (TF_NVCC, PATH or CUDA_HOME); skipped otherwise. Prints [G8] registers a K2 / PD."""
+
+from __future__ import annotations
+
+import glob
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+import tensorfold.cuda.exl3 as upstream
+from tensorfold.families.deepseek_v41.cuda import dense as D
+
+CU = Path(D.__file__).with_name("x3dn.cu")
+CFGS = [(k2, pd) for k2 in D.K2S for pd in (2, 3, 4)]
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+def _cuobjdump() -> str | None:
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump")]
+    try:
+        import triton
+
+        cands += glob.glob(str(Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "cuobjdump"))
+    except ImportError:
+        pass
+    return next((c for c in cands if c and os.path.exists(c)), None)
+
+
+NVCC = _nvcc()
+pytestmark = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+@pytest.fixture(scope="module")
+def build(tmp_path_factory):
+    tmp = tmp_path_factory.mktemp("x3dn")
+    src = tmp / "inst.cu"
+    src.write_text(f'#include "{CU.name}"\n' + "".join(
+        f"template __global__ void dsv41_x3dn::dense_kernel<{k2}, {pd}>"
+        "(const dsv41_x3dn::Table, float*, int, int);\n" for k2, pd in CFGS))
+    inc = [f"-I{CU.parent}", f"-I{Path(upstream.__file__).parent}"]
+    if os.environ.get("TF_CUDA_INCLUDE"):
+        inc.append(f"-I{os.environ['TF_CUDA_INCLUDE']}")
+    obj = tmp / "inst.o"
+    out = subprocess.run([NVCC, "-std=c++17", "-O3", "--expt-relaxed-constexpr", "-lineinfo",
+                          "-DDSV41_X3DN_NO_TORCH", *inc, "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v",
+                          "-c", str(src), "-o", str(obj)], capture_output=True, text=True, timeout=1800)
+    assert out.returncode == 0, out.stderr[-3000:]
+    return obj, out.stderr
+
+
+def test_builds_for_sm121_without_spills(build):
+    _, log = build
+    rows = []
+    for block in log.split("Compiling entry function")[1:]:
+        name = re.match(r" '(\S+)'", block).group(1)
+        regs = int(re.search(r"Used (\d+) registers", block).group(1))
+        spill = int(re.search(r"(\d+) bytes spill stores", block).group(1))
+        stack = int(re.search(r"(\d+) bytes stack frame", block).group(1))
+        rows.append((name, regs, spill, stack))
+    lin = [r for r in rows if "dense_kernel" in r[0]]
+    assert len(lin) == len(CFGS) and any("rot_in_kernel" in r[0] for r in rows)
+    lines = []
+    for name, regs, spill, stack in lin:
+        k2, pd = (int(v) for v in re.search(r"dense_kernelILi(\d+)ELi(\d+)E", name).groups())
+        assert regs <= 168 and spill == 0 and stack == 0, (k2, pd, regs, spill, stack)
+        lines.append(f"K2 {k2} PD {pd}: {regs} regs")
+    print("[G8] x3dn sm_121: " + "; ".join(lines))
+
+
+def test_sass_load_path(build):
+    tool = _cuobjdump()
+    if tool is None:
+        pytest.skip("no cuobjdump (TF_CUOBJDUMP)")
+    obj, _ = build
+    fn = "_ZN10dsv41_x3dn12dense_kernelILi10ELi3EEEvNS_5TableEPfii"
+    out = subprocess.run([tool, "-sass", "-fun", fn, str(obj)], capture_output=True, text=True, timeout=600)
+    if out.returncode != 0 or "LDGSTS" not in out.stdout:
+        pytest.skip(f"cuobjdump cannot read this sm_121 object: {out.stderr[-300:]}")
+    sass = out.stdout
+    ops = re.findall(r"\b(LDGSTS\.E\.BYPASS\.128|LDGSTS\.E|LDL|STL|DEPBAR|HMMA\.16816\.F32|LDG\.E[.\w]*)\b", sass)
+    count = {op: ops.count(op) for op in set(ops)}
+    assert count.get("LDGSTS.E.BYPASS.128", 0) >= 3, count          # 16-byte weight copies (2.5 a lane a step)
+    assert count.get("LDGSTS.E", 0) >= 4, count                      # the input fragments, 4 B each
+    assert count.get("DEPBAR", 0) >= 2, count                        # wait_group 0 (first step) / PD - 1
+    assert count.get("HMMA.16816.F32", 0) == 16, count               # one k step: 8 tiles x 2 halves, not unrolled
+    assert not count.get("LDL") and not count.get("STL"), count      # no local memory
+    print(f"[G8] x3dn K2 10 PD 3 SASS: {dict(sorted(count.items()))}")
