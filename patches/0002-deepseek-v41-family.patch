index 0000000..257c1e1
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/tree.py
@@ -0,0 +1,511 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Tree verification for DSpark rounds (``TF_DSV41_TREE``): siblings at the first draft position, each the root of
+its own chain, verified in the same window as the main chain, and the round commits the branch the target chose.
+
+**Why.** On prose the round is limited by acceptance times the window's fixed cost: ~1.65 tokens a round. DSpark
+gives the whole draft distribution at every position, so the 2nd and 3rd most likely first tokens are free. When
+the first draft is uncertain, a sibling row (~4 ms) buys more expected tokens than a deeper chain row.
+
+**Shape (the cheapest correct subset of a tree).** Branching only at position 1: the main chain [pending, d_1 ..
+d_k] on the slot, and for sibling j: [pending, a_j, c_j2 .. c_jL] on shadow slot j (``shadow.py``), where a_j is the
+j-th first token of the draft distribution in the keyed order (T = 0: (z desc, id asc); T > 0: the keyed score
+z / T + Gumbel(seed, P + 1, id) over ``choose``'s filtered set) and c_j. continue the Markov chain behind a_j (the
+block's base logits are the noise rows', independent of the first token; only the Markov bias follows it). Every
+branch is a chain window on its own slot state, so each row attends to its ancestors' new rows plus the committed
+context, siblings never see each other, and rejected branches write only shadow state.
+
+**Exactness.** Row 0 (the pending token) is the same in every branch (same token, position and state: the same
+bits), so the target's choice c_0 after it is one token. At most one branch's first token equals c_0 (siblings are
+distinct); the window presents that branch (or the main chain when none does) to the sampler as an ordinary chain:
+its rows were computed from the serial context exactly when their drafts are kept (``dspark.accept``'s induction),
+so drafted == serial whatever the tree. The branch is picked on both ranks from the same candidates (the keyed
+choice of row 0, ``exact_sampling``); if the sampler disagreed (it cannot, absent masks / nucleus rows, which turn
+the tree off) the presented chain would simply be kept shorter, never wrong.
+
+**The cost model** (``plan``): a node's value is its path probability (main row i: q_1 .. q_i; sibling j's row 1:
+P_j, its row i: P_j q_2 .. q_i, the main chain's calibrated conditionals standing in for its own), so for a total of
+R rows the best tree is the R - 1 most probable nodes (prefix-closed: a child is never likelier than its parent).
+R maximizes E(R) - rate x (verify[R] + dup_ms x siblings), the objective ``depth.best_k`` uses for chains (rate: the
+slot's committed tokens per modelled ms); the main chain's first draft comes first (``least``). With no sibling it
+is ``best_k``. P_j = the draft softmax of a_j times a per-sibling calibration (decayed kept / summed P, as
+``depth.Calibration``), learned on both ranks from c_0 at every verified sibling.
+
+Knobs: TF_DSV41_TREE (0 = off, the default; B = 2-4: the first-position branches including the chain), TF_DSV41_TREE_DUP_MS
+(0.4: a duplicated pending row's cost), TF_DSV41_TREE_ROWS (4: a sibling branch's drafts at most).
+
+**Parent-conditioned trees** (TF_DSV41_TREE_PC=1, ``pctree.py``): branches at draft positions 1 .. 3, every child
+scored by the Markov head given its own parent, at most B chains; the window presents the chain with the longest
+accepted prefix (the same exactness argument: each chain is an ordinary chain window).
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+import numpy as np
+
+from . import pctree as PC
+from .depth import DECAY, MAX_ROWS
+from .forward import Seg
+from .phases import PH
+from .protocol import Candidates, Rows
+
+PRIOR, F_MIN, F_MAX, Q_MAX = 2.0, 0.05, 4.0, 0.95
+
+
+def settings(env=None) -> tuple[int, float, int]:
+    """(branches B, dup_ms, sibling rows) from TF_DSV41_TREE / _TREE_DUP_MS / _TREE_ROWS; B 0 = off."""
+
+    env = os.environ if env is None else env
+    b = int((env.get("TF_DSV41_TREE", "") or "0").strip())
+    if b == 1 or not 0 <= b <= 4:
+        raise ValueError(f"TF_DSV41_TREE={b}: expected 0 (off) or 2 to 4 first-position branches")
+    dup = float((env.get("TF_DSV41_TREE_DUP_MS", "") or "0.4").strip())
+    rows = int((env.get("TF_DSV41_TREE_ROWS", "") or "4").strip())
+    if dup < 0 or not 1 <= rows <= 15:
+        raise ValueError("TF_DSV41_TREE_DUP_MS >= 0, TF_DSV41_TREE_ROWS 1 to 15")
+    return b, dup, rows
+
+
+# -- drafting the siblings ------------------------------------------------------------------------------------------
+def ranked(z: np.ndarray, ids: np.ndarray, position: int, sampling, m: int, exclude=()) -> list[tuple[int, float]]:
+    """The first ``m`` tokens (not in ``exclude``) of the draft distribution ``z`` over candidate ``ids`` in the keyed
+    order (greedy: (z desc, id asc); sampled: ``exact_sampling.choose``'s filters, then the keyed score), with their
+    draft probabilities (softmax of z / T over the kept set; T = 1 for greedy)."""
+
+    from tensorfold.engine.exact_sampling import uniform
+
+    live = ids >= 0
+    ids, z = ids[live].astype(np.int64), z[live].astype(np.float64)
+    if not ids.size or m <= 0:
+        return []
+    order = np.lexsort((ids, -z))
+    ids, z = ids[order], z[order]
+    if sampling is None:
+        p = np.exp(z - z[0])
+        p /= p.sum()
+        rank = np.arange(ids.size)
+    else:
+        k = max(1, min(int(sampling.top_k) if sampling.top_k else ids.size, ids.size))
+        ids, sc = ids[:k], z[:k] / max(float(sampling.temperature), 1e-6)
+        p = np.exp(sc - sc.max())
+        p /= p.sum()
+        if 0.0 < sampling.top_p < 1.0:
+            keep = int(np.searchsorted(np.cumsum(p), sampling.top_p) + 1)
+            ids, sc, p = ids[:keep], sc[:keep], p[:keep]
+        if sampling.min_p > 0.0:
+            keep = int((sc >= sc[0] + sampling.min_log).sum())
+            ids, sc, p = ids[:keep], sc[:keep], p[:keep]
+        p = p / p.sum()
+        score = sc - np.log(-np.log(uniform(sampling.seed, position, ids)))
+        rank = np.lexsort((np.arange(ids.size), -score))
+    ex = {int(t) for t in exclude}
+    out = []
+    for r in rank:
+        t = int(ids[r])
+        if t in ex:
+            continue
+        out.append((t, float(p[r])))
+        if len(out) >= m:
+            break
+    return out
+
+
+def markov_z(base: np.ndarray, ids: np.ndarray, prev: int, w1, w2) -> np.ndarray:
+    """z = base + w2[ids] . w1[prev] over the live candidates (``drafter.chain_host``'s bias), fp32."""
+
+    import torch
+
+    live = ids >= 0
+    z = np.full(ids.shape, -np.inf, dtype=np.float32)
+    me = w1[int(prev)].float()
+    z[live] = base[live].astype(np.float32) + (w2[torch.from_numpy(ids[live].astype(np.int64))].float() @ me).numpy()
+    return z
+
+
+def continuation(cand: np.ndarray, base: np.ndarray, w1, w2, first: int, rows: int, pos0: int, sampling) -> list[int]:
+    """The Markov chain behind ``first``: the drafts of positions 1 .. rows - 1 (``chain_host``'s rule, keyed at
+    pos0 + i) with prev = ``first``. ``cand`` / ``base``: the pass's candidates / base logits [N, C] of the slot."""
+
+    from tensorfold.engine.exact_sampling import choose
+
+    out, prev = [], int(first)
+    for i in range(1, min(rows, cand.shape[0])):
+        ids = cand[i]
+        z = markov_z(base[i], ids, prev, w1, w2)
+        live = ids >= 0
+        li, lz = ids[live].astype(np.int64), z[live]
+        if not li.size:
+            break
+        tok = int(li[np.lexsort((li, -lz))[0]]) if sampling is None else choose(lz, li, pos0 + i, sampling)
+        out.append(tok)
+        prev = tok
+    return out
+
+
+# -- the cost model -------------------------------------------------------------------------------------------------
+def plan(qm: Sequence[float], sibs: Sequence[float], cont: Sequence[float], verify: Sequence[float], rate: float, *,
+         least: int = 1, dup_ms: float = 0.4, sib_rows: int = 4, max_rows: int | None = None):
+    """-> (k, lens, ms, expected): the main chain's drafts, each sibling's rows (0 = not verified), the modelled
+    window ms and expected tokens of the tree maximizing E - rate x (verify[R - 1] + dup_ms x siblings) (``verify[r]``:
+    a window of r + 1 rows). ``qm``: the main chain's calibrated conditionals; ``sibs``: the siblings' calibrated
+    chances; ``cont``: the conditionals of a sibling's rows 2 .. (default: the main chain's ``qm[1:]``)."""
+
+    top = len(verify) if max_rows is None else min(len(verify), max_rows)
+    nodes = []                                  # (path probability, kind 0 main / 1 sibling root / 2 sibling row, j)
+    p = 1.0
+    for q in qm:
+        p *= float(q)
+        nodes.append((p, 0, 0))
+    for j, P in enumerate(sibs, 1):
+        p = float(P)
+        for i in range(sib_rows):
+            if i:
+                p *= float(cont[i - 1]) if i - 1 < len(cont) else 0.0
+            if p <= 0.0:
+                break
+            nodes.append((p, 1 if i == 0 else 2, j))
+    head = nodes[:1] if qm else []              # the main chain's first draft before any sibling
+    rest = sorted(nodes[len(head):], key=lambda n: -n[0])                  # stable: parents before children
+    order = head + rest
+    best, best_s, e, dups = 0, float("-inf"), 1.0, 0
+    best_e = best_ms = 0.0
+    for n in range(0, len(order) + 1):
+        if n:
+            e += order[n - 1][0]
+            dups += order[n - 1][1] == 1
+        if n + 1 + dups > top:                  # a slot's window, duplicated pending rows included (graph buckets)
+            break
+        if n < least:
+            continue
+        ms = float(verify[n]) + dup_ms * dups
+        s = e - rate * ms
+        if s > best_s + 1e-12:
+            best, best_s, best_e, best_ms = n, s, e, ms
+    k = sum(1 for o in order[:best] if o[1] == 0)
+    lens = [sum(1 for o in order[:best] if o[2] == j and o[1] != 0) for j in range(1, len(sibs) + 1)]
+    return k, lens, best_ms, best_e
+
+
+class SibCal:
+    """Per sibling rank j (2nd, 3rd, ... first token): decayed kept and summed draft probabilities."""
+
+    def __init__(self, n: int) -> None:
+        self.kept = [0.0] * n
+        self.prob = [0.0] * n
+
+    def factor(self, j: int) -> float:
+        return min(max((self.kept[j] + PRIOR) / (self.prob[j] + PRIOR), F_MIN), F_MAX)
+
+    def q(self, j: int, p: float) -> float:
+        return min(max(float(p), 0.0) * self.factor(j), Q_MAX)
+
+    def record(self, j: int, p: float, kept: bool) -> None:
+        self.kept[j] = self.kept[j] * DECAY + float(kept)
+        self.prob[j] = self.prob[j] * DECAY + max(float(p), 0.0)
+
+
+@dataclass
+class Branches:
+    """A slot's tree this round: the main window's tokens and each sibling's (shadow slot, tokens, raw P)."""
+
+    start: int
+    main: tuple
+    sib: list = field(default_factory=list)         # (j, shadow forward slot, tokens, raw p)
+    sampling: object = None
+    ms: float = 0.0
+    nodes: list | None = None                       # ``pctree``: the selected nodes (None: first-position siblings)
+
+
+class Tree:
+    """Both ranks: the siblings of each DSpark round (``draft``), the extra segments of the window (``extra``), the
+    branch each window presents (``resolve`` / ``took``) and the commit of a sibling's state (``commit``)."""
+
+    def __init__(self, fw, branches: int, dup_ms: float = 0.4, sib_rows: int = 4) -> None:
+        from .shadow import Shadows
+
+        self.fw, self.B, self.dup_ms, self.sib_rows = fw, int(branches), float(dup_ms), int(sib_rows)
+        self.shadows = Shadows(fw, self.B - 1)
+        self.cal = SibCal(self.B - 1)
+        self.plans: dict[int, Branches] = {}
+        self.active: dict[int, Branches] = {}
+        self.won: dict[int, tuple[int, Branches]] = {}
+        self.presented: list | None = None
+        self._w = None
+        self.stats = {"trees": 0, "sib_rows": 0, "sib_wins": 0, "sib_tokens": 0}
+        self.pc = PC.settings()                     # TF_DSV41_TREE_PC: parent-conditioned trees (``pctree``)
+        self.pcal = PC.Cal(self.pc["depths"], self.pc["width"])
+        self._exp = None
+
+    def bind(self, slots) -> list:
+        return self.shadows.extend(slots)
+
+    def _w12(self):
+        if self._w is None:
+            dr = self.fw.drafter
+            self._w = (dr.w1.cpu(), dr.w2.cpu())
+        return self._w
+
+    def alternatives(self, slot: int, start: int, pending: int, first: int, data, sampling) -> list:
+        """The siblings' first tokens and raw draft probabilities: the draft distribution after ``pending`` (the
+        pass's base logits + the Markov bias of the anchor) in the keyed order, the chain's ``first`` excluded."""
+
+        cand, base = data
+        w1, w2 = self._w12()
+        z0 = markov_z(base[0], cand[0], pending, w1, w2)
+        return ranked(z0, cand[0], start + 1, sampling, self.B - 1, exclude=(first,))
+
+    def chain(self, slot: int, start: int, first: int, rows: int, data, sampling) -> list[int]:
+        """Sibling ``first``'s drafts after it (``rows`` - 1 of them): the Markov chain behind it."""
+
+        cand, base = data
+        w1, w2 = self._w12()
+        return continuation(cand, base, w1, w2, first, rows, start + 1, sampling)
+
+    def expander(self) -> PC.Expander:
+        if self._exp is None:
+            dr = self.fw.drafter
+            w1, w2 = self._w12()
+            self._exp = PC.Expander(w1, w2, None if dr.cw is None else dr.cw.cpu())
+        return self._exp
+
+    def _pc_slot(self, s: int, P: int, pending: int, d, q, cap: int, smp, alone: bool, data):
+        """(k, ``pctree.Plan`` | None) of one slot (``depth.Depth.choose_pc``)."""
+
+        dep, st = self.fw.depth, self.pc
+        cand, base = data
+
+        def plan(qmain, rate, least, top):
+            order = PC.grow(self.expander(), cand, base, int(pending), P, smp, [int(t) for t in d[:top]], q, qmain,
+                            self.pcal.q, depths=st["depths"], width=st["width"], rows=MAX_ROWS - 1, chains=self.B)
+            return PC.select(order, dep.costs.rows_ms, rate, least=least, dup_ms=self.dup_ms, slot_ms=dep.costs.slot,
+                             sib_expert=st["sib_expert"], max_rows=MAX_ROWS)
+
+        return dep.choose_pc(s, q, cap, plan, alone=alone, first=d[0] if d else None)
+
+    def _pc_draft(self, slots, pendings, starts, depths, noises, drafts, conf, alone: bool, data) -> list[list[int]]:
+        from .lookup import sampling_of
+
+        fw, dep = self.fw, self.fw.depth
+        out, warm = [], []
+        for i, (s, d, q, cap) in enumerate(zip(slots, drafts, conf, depths)):
+            s, P = int(s), int(starts[i])
+            smp = sampling_of(noises[i]) if noises and noises[i] else None
+            if d and data is not None and int(cap) >= 1 and s < self.shadows.n:
+                k, plan = self._pc_slot(s, P, pendings[i], d, q, int(cap), smp, alone, data[i])
+            else:
+                k, plan = dep.choose(s, q, cap, alone=alone, first=d[0] if d else None), None
+            main = d[:k]
+            out.append(main)
+            if plan is None or not plan.chains or k < 1:
+                continue
+            br = Branches(P, tuple([int(pendings[i])] + [int(t) for t in main]), sampling=smp,
+                          ms=dep.slots[s].ms or 0.0, nodes=plan.nodes)
+            for j, (toks, _) in enumerate(plan.chains, 1):
+                toks = [int(pendings[i])] + [int(t) for t in toks]
+                sid = self.shadows.fork(s, j, P, len(toks))
+                br.sib.append((j, sid, tuple(toks), 0.0))
+                warm.append((sid, list(toks), fw.slots[sid].tail))
+            self.plans[s] = br
+        if warm and getattr(fw, "gate", None) is not None:
+            fw.gate.warm(fw, warm)
+        return out
+
+    # -- drafting (``DecodeForward.draft``) -------------------------------------------------------------------------
+    def draft(self, slots, pendings, starts, depths, noises, drafts, conf, alone: bool, data) -> list[list[int]]:
+        """Each slot's main chain (its drafts to verify) with the tree planned beside it; ``data``: the pass's
+        (candidates, base logits) [N, C] a slot (``drafter.Drafter.last_tree``)."""
+
+        from .lookup import sampling_of
+
+        fw, dep = self.fw, self.fw.depth
+        if self.pc["pc"]:
+            self.plans = {}
+            return self._pc_draft(slots, pendings, starts, depths, noises, drafts, conf, alone, data)
+        noises = noises or [None] * len(slots)
+        out = []
+        self.plans = {}
+        warm = []
+        for i, (s, d, q, cap) in enumerate(zip(slots, drafts, conf, depths)):
+            s, P = int(s), int(starts[i])
+            smp = sampling_of(noises[i]) if noises[i] else None
+            alts = []
+            if d and data is not None and int(cap) >= 1 and s < self.shadows.n:
+                alts = self.alternatives(s, P, int(pendings[i]), int(d[0]), data[i], smp)
+            sib_p = [self.cal.q(j, p) for j, (_, p) in enumerate(alts)]
+            k, lens = dep.choose_tree(s, q, cap, sib_p, alone=alone, first=d[0] if d else None, dup_ms=self.dup_ms,
+                                      sib_rows=self.sib_rows)
+            main = d[:k]
+            out.append(main)
+            if not any(lens) or k < 1:
+                continue
+            br = Branches(P, tuple([int(pendings[i])] + [int(t) for t in main]), sampling=smp,
+                          ms=dep.slots[s].ms or 0.0)
+            for j, ((tok, p), L) in enumerate(zip(alts, lens), 1):
+                if L < 1:
+                    continue
+                toks = [int(pendings[i]), tok] + self.chain(s, P, tok, L, data[i], smp)
+                sid = self.shadows.fork(s, j, P, len(toks))
+                br.sib.append((j, sid, tuple(toks), p))
+                warm.append((sid, list(toks), fw.slots[sid].tail))
+            self.plans[s] = br
+        if warm and getattr(fw, "gate", None) is not None:
+            fw.gate.warm(fw, warm)
+        return out
+
+    # -- the window -------------------------------------------------------------------------------------------------
+    def _match(self, windows) -> dict[int, Branches]:
+        out = {}
+        for w in windows:
+            br = self.plans.get(int(w.slot))
+            if br is not None and int(w.start) == br.start and tuple(int(t) for t in w.tokens) == br.main:
+                out[int(w.slot)] = br
+        return out
+
+    def peek(self, windows) -> list[Rows]:
+        """The sibling windows ``extra`` will add (the Engram reads issued before the window: the same order)."""
+
+        got = self._match(windows)
+        return [Rows(sid, br.start, toks) for w in windows if int(w.slot) in got
+                for br in (got[int(w.slot)],) for _, sid, toks, _ in br.sib]
+
+    def extra(self, windows, masks=None, nucleus=None) -> list[Rows]:
+        """The sibling windows to run beside ``windows`` (the round's slot windows): those whose main window is the
+        planned one (a grammar cut changes it); none when a grammar mask or nucleus row is in the round."""
+
+        plain = not (masks is not None and any(m is not None for m in masks)) and not (nucleus and any(nucleus))
+        self.active = self._match(windows) if plain else {}
+        out = self.peek(windows) if self.active else []
+        self.plans = {}
+        return out
+
+    def resolve(self, windows, extra, cand: Candidates) -> Candidates:
+        """The candidates of the branch each window presents (rows in window order), from those of ``windows`` then
+        ``extra``; the presented chains go to ``took``. Both ranks: the sibling calibration learns c_0."""
+
+        from tensorfold.engine.exact_sampling import choose_rows
+
+        self.won = {}
+        if not self.active:
+            self.presented = None
+            return cand
+        offs, a = {}, 0
+        for w in list(windows) + list(extra):
+            offs[(int(w.slot), id(w))] = a
+            a += len(w.tokens)
+        main_off = [offs[(int(w.slot), id(w))] for w in windows]
+        ext_off = {int(r.slot): offs[(int(r.slot), id(r))] for r in extra}
+        idx, rows = [], []
+        for w, o in zip(windows, main_off):
+            br = self.active.get(int(w.slot))
+            pick, toks, src = 0, tuple(w.tokens), o
+            if br is not None and br.nodes is not None:
+                pick, toks, src = self._pc_resolve(int(w.slot), br, tuple(w.tokens), o, ext_off, cand)
+            elif br is not None:
+                v, ids = cand.values[o:o + 1].astype(np.float32), cand.ids[o:o + 1].astype(np.int64)
+                if br.sampling is None:
+                    c0 = int(ids[0][np.lexsort((ids[0], -v[0]))[0]])
+                else:
+                    c0 = choose_rows(v, ids, [br.start + 1], br.sampling)[0]
+                self.stats["trees"] += 1
+                for j, sid, stoks, p in br.sib:
+                    self.cal.record(j - 1, p, stoks[1] == c0)
+                    self.stats["sib_rows"] += len(stoks) - 1
+                    if stoks[1] == c0 and not (len(w.tokens) > 1 and int(w.tokens[1]) == c0):
+                        pick, toks, src = j, stoks, ext_off[sid]
+                self.won[int(w.slot)] = (pick, br)
+            idx += list(range(src, src + len(toks)))
+            rows.append(Rows(w.slot, w.start, tuple(toks)) if pick else w)
+        self.presented = rows
+        sel = np.asarray(idx, dtype=np.int64)
+        return Candidates(cand.ids[sel], cand.values[sel])
+
+    def _pc_resolve(self, slot: int, br: Branches, main: tuple, off: int, ext_off: dict, cand: Candidates):
+        """A parent-conditioned tree: the chain with the longest accepted prefix (ties: the earlier chain, the main
+        one first) from each chain's own keyed choices; the later children learn from the serial tokens."""
+
+        from tensorfold.engine.exact_sampling import choose_rows
+
+        best, a_main = None, 0
+        for j, toks, o in [(0, main, off)] + [(j, t, ext_off[sid]) for j, sid, t, _ in br.sib]:
+            v = cand.values[o:o + len(toks)].astype(np.float32)
+            ids = cand.ids[o:o + len(toks)].astype(np.int64)
+            if br.sampling is None:
+                chosen = [int(ids[r][np.lexsort((ids[r], -v[r]))[0]]) for r in range(len(toks))]
+            else:
+                chosen = choose_rows(v, ids, [br.start + 1 + r for r in range(len(toks))], br.sampling)
+            a = PC.accepted_len(toks, chosen)
+            if j == 0:
+                a_main = a
+            else:
+                self.stats["sib_rows"] += len(toks) - 1
+            if best is None or a > best[0]:
+                best = (a, j, toks, o, chosen)
+        a, pick, toks, src, chosen = best
+        PC.learn(self.pcal, br.nodes, chosen[:a + 1])
+        self.stats["trees"] += 1
+        self.won[slot] = (pick, br, a_main)
+        return pick, toks, src
+
+    def took(self, rows):
+        """The chains the window presented (``rounds.Executor``): the sampler accepts and commits these."""
+
+        got, self.presented = self.presented, None
+        if got is None or len(got) != len(rows):
+            return rows
+        return got
+
+    # -- the commit -------------------------------------------------------------------------------------------------
+    def commit(self, slot: int, acc: int):
+        """Before ``Forward.keep``: a winning sibling's state becomes the slot's. -> (main rows, main keep, tokens,
+        ms) for ``depth.Depth.record``, or None (no tree this round)."""
+
+        got = self.won.pop(int(slot), None)
+        self.active.pop(int(slot), None)
+        if got is None:
+            return None
+        j, br = got[0], got[1]
+        main_keep = got[2] + 1 if len(got) > 2 else 1     # ``pctree``: the main chain's own accepted drafts + 1
+        main_rows = len(br.main)
+        if j and acc >= 1:
+            self.shadows.promote(int(slot), j, br.start, int(acc))
+            self.stats["sib_wins"] += 1
+            self.stats["sib_tokens"] += int(acc)
+            return main_rows, main_keep, acc + 1, br.ms
+        return main_rows, (acc + 1) if not j else 1, acc + 1, br.ms
+
+    def describe(self) -> str:
+        st = self.stats
+        f = ", ".join(f"{self.cal.factor(j):.2f}" for j in range(self.B - 1))
+        pc = ""
+        if self.pc["pc"]:
+            pc = (f"; parent-conditioned, depths {self.pc['depths']}, width {self.pc['width']}, factors "
+                  + " / ".join(",".join(f"{self.pcal.factor(d, r):.2f}" for r in range(1, self.pc["width"]))
+                               for d in range(self.pc["depths"])))
+        return (f"tree B={self.B} ({st['trees']} trees, {st['sib_rows']} sibling rows, {st['sib_wins']} sibling wins "
+                f"/ {st['sib_tokens']} drafts kept, sibling factors {f}{pc})")
+
+
+def pool_tokens(slots: int, page: int) -> int:
+    """Pool tokens the shadows' private pages take (``shadow.PRIVATE`` pages a shadow, B - 1 shadows a slot)."""
+
+    from .shadow import PRIVATE
+
+    b = settings()[0]
+    return int(slots) * max(0, b - 1) * PRIVATE * int(page) if b >= 2 else 0
+
+
+def make(fw) -> Tree | None:
+    """``Tree`` for ``fw`` (``decode.DecodeForward`` with DSpark) when TF_DSV41_TREE >= 2, else None."""
+
+    b, dup, rows = settings()
+    if b < 2 or getattr(fw, "drafter", None) is None:
+        return None
+    return Tree(fw, b, dup, rows)
+
+
+__all__ = ["Branches", "SibCal", "Tree", "continuation", "make", "markov_z", "plan", "pool_tokens", "ranked",
+           "settings"]
