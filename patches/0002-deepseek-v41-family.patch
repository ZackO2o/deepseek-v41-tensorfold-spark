+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_picks_agree_with_float64(E, topk):
+    x, w, b = _inputs(96, E, 3 + E, D=SMALL, wscale=0.05)
+    pick, wts = RG.emulate(x, w, b, topk, True, 1.5)
+    rp, rw, margin = _f64_route(x, w, b, topk)
+    same = (pick[:, :topk].numpy() == rp).all(1)
+    print(f"[G7] gemv model vs float64 picks (E {E}): {same.mean():.4f} of 96 rows; min margin of a differing row "
+          f"{margin[~same].min() if (~same).any() else '-'}")
+    assert same.mean() >= 0.98
+    assert (margin[~same] < 1e-5).all()                              # only float64 near-ties may differ
+    np.testing.assert_allclose(wts[same, :topk].numpy(), rw[same], rtol=2e-5, atol=0)
+    assert (pick[:, topk] == E).all() and (wts[:, topk] == 1.0).all()
