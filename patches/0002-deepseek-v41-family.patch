index 0000000..478034b
--- /dev/null
+++ b/tests/test_dsv41_engram_gate.py
@@ -0,0 +1,231 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The Engram gate (``engram_gate``, ``TF_DSV41_ENGRAM_GATE=1``) on the CPU twin, with the native reader:
+
+- the bf16 table is torch's dequant for all 65,536 (scale, byte) pairs, and the C dequant through it gives the bits
+  of ``engram_host.dequant(...).to(bf16)`` for random records (NaN / zero / extreme scales included), dims 32 / 256;
+- ``engram_native.readv`` (one batch over two shards, persistent pool) returns the files' bytes at any queue depth;
+- the row cache's LRU keeps a round's own rows;
+- a window's logits through the gate == the synchronous path's (``LazyEngram``), bit for bit, with a delayed reader
+  (the forward reaches layer 1 before the rows), one slot and two, TP = 2 on threads; replies with the gate on ==
+  off, with lookup and DSpark rounds; the drafter-end issue is the round the forward arms (no reissue);
+- a failed read raises after the window and the next round works; nothing is left waiting.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.families.deepseek_v41.cuda import engram_gate as EG
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+from tensorfold.families.deepseek_v41.cuda import engram_native as EN
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+
+if not EN.available():
+    pytest.skip("no C compiler for the native reader", allow_module_level=True)
+
+PROMPTS = [[int(t) for t in np.random.default_rng(s).integers(3, 250, size=n)] for s, n in ((1, 45), (2, 70))]
+
+
+def _records(n: int, seed: int) -> np.ndarray:
+    rng = np.random.default_rng(seed)
+    rec = rng.integers(0, 256, size=(n, EH.ROW_BYTES), dtype=np.uint8)
+    rec[:, 256:] = rng.integers(100, 140, size=(n, 8), dtype=np.uint8)
+    rec[:8, 256:] = np.array([0, 1, 127, 128, 200, 254, 255, 126], dtype=np.uint8)[:, None]    # zero / huge scales
+    rec[8, :256] = np.arange(256, dtype=np.uint8)                                              # NaN bytes, +-0
+    return rec
+
+
+def test_lut_is_torch_dequant():
+    lut = EG.bf16_lut()
+    raw = torch.arange(256, dtype=torch.int32).to(torch.uint8)
+    for s in (0, 1, 100, 127, 200, 255):
+        want = EH.dequant(raw[None, :].repeat(1, 1), torch.full((1, 8), s, dtype=torch.uint8)).to(torch.bfloat16)
+        assert np.array_equal(lut[s * 256:(s + 1) * 256], want.view(torch.int16).numpy().view(np.uint16)[0])
+
+
+@pytest.mark.parametrize("dim", [32, 256])
+def test_native_dequant_is_the_forwards_bits(dim):
+    rec = _records(300, dim)
+    idx = np.random.default_rng(5).integers(0, rec.shape[0], size=500)
+    out = np.empty((idx.size, dim), dtype=np.uint16)
+    EN.dequant(rec, idx, dim, 256, EG.bf16_lut(), out)
+    t = torch.from_numpy(rec[idx])
+    want = EH.dequant(t[:, :dim], t[:, 256:256 + dim // 32]).to(torch.bfloat16)
+    assert np.array_equal(out, want.view(torch.int16).numpy().view(np.uint16))
+
+
+@pytest.fixture(scope="module")
+def shards(tmp_path_factory):
+    root = tmp_path_factory.mktemp("gate")
+    out = []
+    for k, (lo, n) in enumerate(((1000, 30_000), (7, 9_000))):
+        rows = np.random.default_rng(40 + k).integers(0, 256, size=(n, EH.ROW_BYTES), dtype=np.uint8)
+        path = root / f"engram-l{k + 1}-r0of1.bin"
+        EH.write_shard(path, k + 1, lo, rows, lo + n + 3)
+        out.append((EH.ShardRows(path), rows))
+    return out
+
+
+@pytest.mark.parametrize("qd", [1, 3, 64])
+def test_readv_is_the_files_bytes(shards, qd):
+    rng = np.random.default_rng(qd)
+    parts, want = [], []
+    for src, rows in shards:
+        h = src.header
+        r = np.unique(np.concatenate([rng.integers(h.lo, h.hi, size=700), [h.lo, h.hi - 1]]))
+        parts.append((src.fd, r, h.lo, h.row_bytes, EH.HEADER, src.gap))
+        want.append(rows[r - h.lo])
+    parts.append((shards[0][0].fd, np.zeros(0, dtype=np.int64), 0, EH.ROW_BYTES, EH.HEADER, 4096))
+    got = EN.readv(parts, depth=qd)
+    assert all(np.array_equal(g, w) for g, w in zip(got, want)) and got[2].shape == (0, EH.ROW_BYTES)
+
+
+def test_row_cache_keeps_a_rounds_rows():
+    c = EG.RowCache(4, 2)
+    c.put(np.array([1, 2, 3, 4]), np.arange(8, dtype=np.uint8).reshape(4, 2))
+    hit = c.find(np.array([2, 9]))
+    assert hit[1] == -1 and np.array_equal(c.arena[hit[0]], [2, 3])
+    s = c.put(np.array([9]), np.array([[7, 7]], dtype=np.uint8))          # evicts 1 (the oldest), not 2
+    assert 1 not in c.where and 2 in c.where and np.array_equal(c.arena[s[0]], [7, 7])
+
+
+# -- the forward ---------------------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41gate"))
+
+
+@pytest.fixture(scope="module")
+def packed(ck, tmp_path_factory):
+    root = tmp_path_factory.mktemp("gate-shards")
+    FK.write_engram(root, ck[1], ck[2], 1)
+    FK.write_engram(root, ck[1], ck[2], 2)
+    return root
+
+
+def _fw(ck, packed, monkeypatch, gate: bool, *, slots=1, rank=0, world=1, comm=None, delay=0.0, prefetch=True):
+    monkeypatch.setenv("TF_DSV41_ENGRAM_GATE", "1" if gate else "0")
+    rows = EH.open_shards(packed, rank, world, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    fw = DF.forward(ck, slots=slots, rank=rank, world=world, comm=comm, prefetch=prefetch, rows=rows)
+    assert (fw.gate is not None) == gate
+    if gate and delay:
+        real = fw.gate.reader
+        rng = np.random.default_rng(rank)
+
+        def slow(parts):
+            time.sleep(float(rng.uniform(0.5, 1.0)) * delay)
+            return real(parts)
+
+        fw.gate.reader = slow
+    return fw
+
+
+def _windows(fw, prompt, widths, slot=0):
+    """The prompt as windows of ``widths`` rows (each kept), each window's logits."""
+
+    out, a = [], 0
+    for w in widths:
+        ids = prompt[a:a + w]
+        if not ids:
+            break
+        out.append(fw.step(ids, slot=slot))
+        a += w
+    return out
+
+
+WIDTHS = [1, 3, 6, 2, 5, 4, 1, 6, 6, 2]
+
+
+def test_gated_window_bits_equal_sync(ck, packed, monkeypatch):
+    ref = _windows(_fw(ck, packed, monkeypatch, False), PROMPTS[1], WIDTHS)
+    fw = _fw(ck, packed, monkeypatch, True, delay=0.03)
+    got = _windows(fw, PROMPTS[1], WIDTHS)
+    assert len(got) == len(ref) and all(torch.equal(a, b) for a, b in zip(got, ref))
+    st = fw.gate.stats
+    assert st["rounds"] == len(WIDTHS) and st["read"] > 0 and st["reissued"] == 0
+    fw.gate.close()
+
+
+def test_gated_two_slots_one_window(ck, packed, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+
+    def go(fw):
+        out = []
+        for s in (0, 1):
+            fw.step(PROMPTS[s][:9], slot=s)
+        pos = [9, 9]
+        for w in ((2, 5), (6, 1), (3, 3)):
+            segs = [Seg(s, pos[s], tuple(PROMPTS[s][pos[s]:pos[s] + w[s]])) for s in (0, 1)]
+            out.append(fw.run(segs))
+            for s in (0, 1):
+                fw.keep(s, w[s] - 1)
+                pos[s] += w[s]
+        return out
+
+    ref = go(_fw(ck, packed, monkeypatch, False, slots=2))
+    got = go(_fw(ck, packed, monkeypatch, True, slots=2, delay=0.02))
+    assert all(torch.equal(a, b) for a, b in zip(got, ref))
+
+
+def test_gated_tp2_equals_sync(ck, packed, monkeypatch):
+    def pair(gate):
+        tp = FK.ThreadPair()
+        comms = tp.comms()
+        fws = [_fw(ck, packed, monkeypatch, gate, rank=r, world=2, comm=comms[r], delay=0.02 * gate)
+               for r in range(2)]
+        return tp.run([lambda r=r: _windows(fws[r], PROMPTS[0], WIDTHS[:6]) for r in range(2)])
+
+    ref, got = pair(False), pair(True)
+    for r in range(2):
+        assert all(torch.equal(a, b) for a, b in zip(got[r], ref[r]))
+
+
+def test_gated_replies_equal_off(ck, packed, monkeypatch):
+    def replies(gate):
+        fw = _fw(ck, packed, monkeypatch, gate, slots=2, delay=0.01)
+        b = DF.batcher(ck, fw, n=2, lookup=True)
+        out = DF.run(b, [Job(list(PROMPTS[0]), 10, None), Job(list(PROMPTS[1]), 10, None)])
+        return out, fw
+
+    ref, _ = replies(False)
+    got, fw = replies(True)
+    assert got == ref
+    st = fw.gate.stats
+    assert st["rounds"] > 0 and st["warm"] > 0 and st["cached"] > 0
+
+
+def test_failed_read_raises_after_the_window(ck, packed, monkeypatch):
+    fw = _fw(ck, packed, monkeypatch, True)
+    real, calls = fw.gate.reader, []
+
+    def broken(parts):
+        calls.append(1)
+        if len(calls) == 2:
+            raise OSError(5, "injected")
+        return real(parts)
+
+    fw.gate.reader = broken
+    fw.step(PROMPTS[0][:3])
+    with pytest.raises(RuntimeError, match="Engram gate"):
+        fw.step(PROMPTS[0][3:5])
+    fw.reset(0)
+    ref = _windows(_fw(ck, packed, monkeypatch, False), PROMPTS[0], [4, 2])
+    assert all(torch.equal(a, b) for a, b in zip(_windows(fw, PROMPTS[0], [4, 2]), ref))
+
+
+def test_gate_off_by_default(ck, packed, monkeypatch):
+    monkeypatch.delenv("TF_DSV41_ENGRAM_GATE", raising=False)
+    rows = EH.open_shards(packed, 0, 1, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    assert DF.forward(ck, prefetch=True, rows=rows).gate is None
+    assert os.environ.get("TF_DSV41_ENGRAM_GATE") is None
