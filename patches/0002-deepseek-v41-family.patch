+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Expert-budgeted verification (budget.py, ``TF_DSV41_VERIFY_BUDGET``) on the GPU (collected only where PyTorch sees
+an NVIDIA GPU):
+
+- the compiled kernel == the torch reference (picks exactly, kept weights bit for bit, substitutes to 2e-6), B in
+  {0, 2, 4, 8}, sub and drop, windows of 1-4 segments of up to 16 rows;
+- row 1 of every segment and the shared slot untouched; a segment alone == in any window (per-slot budgets);
+  CUDA graph replays == eager; both "ranks" (two runs) give the same bits;
+- the router's ``keep`` logits (gemv / fused / split) leave its picks unchanged and equal ``router.logits``;
+- on a random EXL3 block (upstream's grouped kernels, x3ld on and off): ``group`` never lists an out-of-budget expert
+  (``ucount`` = the segment's allowed set), ``experts.routed`` row 1 == the exact window's row 1;
+- ``moe.GpuMoE`` under ``budget.window``: row 1's output == the exact call's, and the knob off is the exact path.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_budget_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import budget as BU  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+
+DEV = "cuda"
+K = 6
+
+
+def _window(lens, seed, E=384, spread=1.0):
+    g = torch.Generator().manual_seed(seed)
+    bias = (torch.rand(E, generator=g) * 0.2).to(torch.float32)
+    rows = []
+    for n in lens:
+        base = torch.randn(E, generator=g) * 2.0
+        rows += [base + spread * torch.randn(E, generator=g) for _ in range(n)]
+    lg = torch.stack(rows).float()
+    s = BU._score(lg)
+    order = torch.sort(-(s + bias[None, :]), dim=-1, stable=True).indices[:, :K]
+    sv = s.gather(1, order)
+    tot = torch.zeros(lg.shape[0])
+    for i in range(K):
+        tot = tot + sv[:, i]
+    w = 1.5 * (sv / tot[:, None])
+    R = lg.shape[0]
+    pick = torch.cat([order.to(torch.int32), torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous()
+    wts = torch.cat([w, torch.ones((R, 1))], 1).float().contiguous()
+    return pick, wts, lg, bias
+
+
+def _spans(lens):
+    out, a = [], 0
+    for n in lens:
+        out.append((a, a + n))
+        a += n
+    return out
+
+
+def _dev(*ts):
+    return [t.to(DEV) for t in ts]
+
+
+LENS = [[4], [1, 3, 5], [2, 16, 1], [6, 6, 6, 6], [3, 1, 1, 7], [16, 16, 16, 16]]
+
+
+@pytest.mark.parametrize("lens", LENS)
+@pytest.mark.parametrize("b,mode", [(0, "sub"), (2, "sub"), (2, "drop"), (4, "sub"), (8, "sub")])
+def test_kernel_equals_reference(lens, b, mode):
+    pick, wts, lg, bias = _window(lens, 100 + b + len(lens))
+    R = pick.shape[0]
+    cfg = BU.Cfg(b, mode)
+    meta = BU.meta_spans(_spans(lens), R, "cpu")
+    if meta is None:
+        return
+    want = BU.reference(pick, wts, lg, bias, meta, K, cfg, 385)
+    p, w = BU.apply(*_dev(pick, wts, lg), bias.to(DEV), meta.to(DEV), K, cfg, 385)
+    p, w = p.cpu(), w.cpu()
+    assert torch.equal(p, want[0])
+    assert torch.allclose(w, want[1], rtol=2e-6, atol=0)
+    keep = p == pick
+    assert torch.equal(w[keep], wts[keep])                              # kept slots: the router's bits
+    for a, _ in _spans(lens):
+        assert torch.equal(p[a], pick[a]) and torch.equal(w[a], wts[a])  # row 1 exact
+
+
+def test_per_slot_invariance_graphs_and_determinism():
+    lens = [5, 3, 7, 1]
+    pick, wts, lg, bias = _window(lens, 7)
+    cfg = BU.Cfg(2, "sub")
+    spans = _spans(lens)
+    R = pick.shape[0]
+    pd, wd, ld, bd = *_dev(pick, wts, lg), bias.to(DEV)
+    meta = BU.meta_spans(spans, R, DEV)
+    p1, w1 = BU.apply(pd, wd, ld, bd, meta, K, cfg, 385)
+    p2, w2 = BU.apply(pd, wd, ld, bd, meta, K, cfg, 385)
+    assert torch.equal(p1, p2) and torch.equal(w1.view(torch.int32), w2.view(torch.int32))
+    for a, z in spans:                                                  # each segment alone
+        if z - a < 2:
+            continue
+        m1 = BU.meta_spans([(0, z - a)], z - a, DEV)
+        pa, wa = BU.apply(pd[a:z].contiguous(), wd[a:z].contiguous(), ld[a:z].contiguous(), bd, m1, K, cfg, 385)
+        assert torch.equal(pa, p1[a:z]) and torch.equal(wa.view(torch.int32), w1[a:z].view(torch.int32))
+    # a captured graph over static buffers: replay on new inputs == eager
+    sp, sw, sl = pd.clone(), wd.clone(), ld.clone()
+    BU.apply(sp, sw, sl, bd, meta, K, cfg, 385)                         # compiled outside the capture
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        gm = BU.meta_spans(spans, R, DEV)
+        gp, gw = BU.apply(sp, sw, sl, bd, gm, K, cfg, 385)
+    for seed in (8, 9):
+        q, v, l2, _ = _window(lens, seed)
+        sp.copy_(q.to(DEV))
+        sw.copy_(v.to(DEV))
+        sl.copy_(l2.to(DEV))
+        graph.replay()
+        e_p, e_w = BU.apply(sp, sw, sl, bd, meta, K, cfg, 385)
+        torch.cuda.synchronize()
+        assert torch.equal(gp, e_p) and torch.equal(gw.view(torch.int32), e_w.view(torch.int32))
+
