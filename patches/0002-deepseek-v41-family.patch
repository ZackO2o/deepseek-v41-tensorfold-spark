+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The DSpark pass's head options and static inputs (families/deepseek_v41/cuda/draft_head.py, draft_graphs.py), on
+the CPU twin and the synthetic DSpark checkpoint (``dsv41_dspark_fakes``):
+
+- knobs and refusals; the ranking file and the per-rank lists (ascending, a multiple of 64, the fill rule, equal
+  lengths), the shipped ranking;
+- the 4-bit copy read from a head (``probe``): every weight within half a step of its scale, the listed columns only
+  for a trimmed head, the packing layout;
+- the fallback rule (``Tracker``): its threshold over a window of committed tokens, reset;
+- the static inputs equal ``context_meta`` / ``Win.make`` / ``sampling_params`` (what the eager pass built);
+- drafted == serial with every head option (full, q4, trim with and without its fallback), T = 0 and T > 0, 1 and 4
+  slots; a trimmed pass drafts listed ids only; the fallback switches a slot's passes to the full head;
+- two ranks (threads) with the trimmed head draft alike;
+- the calibration key moves with each draft knob.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import draft_head as DH
+from tensorfold.families.deepseek_v41.cuda import drafter as DR
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+S1 = Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95)
+PROMPTS = [[int(t) for t in np.random.default_rng(40 + i).integers(3, 250, size=40 + 13 * i)] for i in range(4)]
+SAMPLINGS = [None, S1, None, Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+N = 16
+HEADS = {"full": {}, "q4": {"TF_DSV41_DRAFT_HEAD": "q4"},
+         "trim": {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "off"},
+         "trimfb": {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "0.2,16"}}
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41dh"))
+
+
+@pytest.fixture(scope="module")
+def vocab(tmp_path_factory):
+    """A ranking for the 256-token fake: odd ids first (so a 64-row list misses most even ids), then the rest."""
+
+    f = tmp_path_factory.mktemp("dsv41dv") / "rank.txt"
+    f.write_text("# test ranking\n" + " ".join(map(str, list(range(1, 256, 2)) + list(range(0, 256, 2)))) + "\n")
+    return str(f)
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    b = DF.batcher(ck, DF.forward(ck, dspark=False), depth=0)
+    return DF.run(b, [Job(list(p), N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+# -- knobs, lists ---------------------------------------------------------------------------------------------------
+def test_settings():
+    assert DH.settings({}) == DH.Settings()
+    assert DH.settings({"TF_DSV41_DRAFT_HEAD": "q4"}).mode == "q4"
+    st = DH.settings({"TF_DSV41_DRAFT_HEAD": "trim:16384", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "0.05,128"})
+    assert (st.mode, st.rows, st.fb_rate, st.fb_window) == ("trim", 16384, 0.05, 128)
+    assert DH.settings({"TF_DSV41_DRAFT_HEAD": "trim", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "off"}).fb_rate is None
+    for bad in ({"TF_DSV41_DRAFT_HEAD": "q8"}, {"TF_DSV41_DRAFT_HEAD": "q4:100"}, {"TF_DSV41_DRAFT_HEAD": "trim:8"},
+                {"TF_DSV41_DRAFT_VOCAB_FALLBACK": "1.5"}):
+        with pytest.raises(ValueError):
+            DH.settings(bad)
+
+
+def test_per_rank_lists():
+    order = [5, 300, 7, 3, 1000, 64, 2, 299]
+    a = DH.per_rank(order, 0, 640, 3)
+    assert len(a) == 64 and list(a) == sorted(a) and {5, 7, 3, 64, 2} <= set(a)        # 5 ranked, then the lowest
+    assert len(DH.per_rank(order, 0, 50, 64)) == 50                                    # at most the half
+    b = DH.per_rank(order, 640, 1280, 3)
+    assert len(b) == 64 and b[0] == 640 and 1000 in b and 300 not in b
+
+
+def test_shipped_ranking():
+    order = DH.ranking()
+    assert len(order) == len(set(order)) > 16384 and all(0 <= i < 129280 for i in order)
+    assert 1 in order[:500] and 128822 in order[:500]                 # end of sentence, </think>
+    lists = [DH.per_rank(order, r * 64640, (r + 1) * 64640, DH.TRIM_ROWS) for r in range(2)]
+    assert [len(x) for x in lists] == [24576, 24576]
+
+
+def test_group():
+    assert DH.group_of(5120) == 128 and DH.group_of(128) == 64 and DH.group_of(96) == 16
+    with pytest.raises(ValueError):
+        DH.group_of(100)
+
+
+# -- the 4-bit copy -------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("k,n", [(256, 96), (128, 64), (512, 40)])
+def test_probe_quantizes_the_head(k, n):
+    g = torch.Generator().manual_seed(k + n)
+    w = torch.randn(k, n, generator=g) * 0.05
+    lin = lambda x, dtype: (x.float() @ w).to(dtype)
+    group = DH.group_of(k)
+    packed, scales = DH.probe(lin, k, None, "cpu", group)
+    assert packed.shape == (n, k // 2) and packed.dtype == torch.uint8 and scales.shape == (n, k // group)
+    deq = DH.dequant(packed, scales, group)
+    step = scales.float().repeat_interleave(group, 1)
+    assert torch.all((deq - w.t()).abs() <= step * 0.5 + 1e-6)
+    lo = (packed[:, :group] & 15).to(torch.int32) - 8                 # byte j of block 0: inputs j and G + j
+    assert torch.equal(lo.float() * scales[:, :1].float(), deq[:, :group])
+    cols = torch.tensor([3, 10, 11, n - 1])
+    p2, s2 = DH.probe(lin, k, cols, "cpu", group)
+    assert torch.equal(p2, packed[cols]) and torch.equal(s2, scales[cols])
+    x = torch.randn(5, k, generator=g).to(torch.bfloat16)
+    assert torch.allclose(DH.q4_matmul(x, packed, scales, group), x.float() @ deq.t(), rtol=1e-5, atol=1e-5)
+
+
+def test_tracker():
+    listed = np.zeros(10, dtype=bool)
+    listed[:5] = True
+    t = DH.Tracker(listed, 0.25, 8)
+    t.feed(0, [0, 1, 2, 3])
+    assert not t.full(0) and not t.full(1)
+    t.feed(0, [7, 8])                    # 2 of 6 unlisted
+    assert t.full(0)
+    t.feed(0, [0, 1, 2, 3, 4, 0])        # the window keeps the last 8: 7, 8, then 6 listed: 2 of 8 is not > 25%
+    assert t.misses[0] == 2 and len(t.q[0]) == 8 and not t.full(0)
+    t.feed(0, [0] * 8)
+    assert not t.full(0)
+    t.feed(0, [9, 300, -1])              # out-of-range ids count as unlisted
+    assert t.misses[0] == 3 and t.full(0)
+    t.reset(0)
+    assert not t.full(0)
+    assert not DH.Tracker(listed, None, 8).full(0)
+
+
+# -- static inputs ----------------------------------------------------------------------------------------------------
+def test_static_inputs_equal_the_eager_metas(ck):
+    from tensorfold.families.deepseek_v41.cuda import dspark
+
+    fw = DF.forward(ck, slots=3)
+    dr = fw.drafter
+    for s in range(3):
+        dr.reset(s)
+    dr.valid[1] = 3
+    key = ((0, 1, 2), dr.rows, "full")
+    inp = dr.inputs(key)
+    assert dr.inputs(key) is inp
+    starts, anchors = [2, 9, 40], [17, 18, 19]
+    inp.stage(anchors, starts, [dr.valid[s] for s in range(3)], [None, S1, None], dr.noise, dr.ring)
+    n = dr.rows
+    for i, (s, p) in enumerate(zip(range(3), starts)):
+        want = DR.context_meta(p, n, dr.ring, dr.window, dr.valid[s])
+        for got, w in zip(inp.metas[i], want):
+            assert torch.equal(got, w)
+        assert torch.equal(inp.wins[i].positions, torch.arange(p, p + n)) and int(inp.wins[i].t) == p
+        assert inp.ids[i * n:(i + 1) * n].tolist() == [anchors[i]] + [dr.noise] * (n - 1)
+        ip, fp = dspark.sampling_params([None, S1, None][i], p)
+        assert inp.ipar[i].tolist() == ip and np.allclose(inp.fpar[i].tolist(), fp)
+    assert inp.anchor.tolist() == anchors
+
+
+# -- drafted == serial ------------------------------------------------------------------------------------------------
+def _env(monkeypatch, name, vocab):
+    for k, v in {**HEADS[name], "TF_DSV41_DRAFT_VOCAB": vocab}.items():
+        monkeypatch.setenv(k, v)
+
+
+@pytest.mark.parametrize("slots", [1, 4])
+@pytest.mark.parametrize("head", list(HEADS))
+def test_drafted_equals_serial(ck, serial, vocab, monkeypatch, head, slots):
+    _env(monkeypatch, head, vocab)
+    fw = DF.forward(ck, slots=slots)
+    assert fw.drafter.head.mode == HEADS[head].get("TF_DSV41_DRAFT_HEAD", "full").split(":")[0]
+    seen = []
+    real = fw.drafter.propose
+
+    def rec(*a, **k):
+        out = real(*a, **k)
+        seen.append((fw.drafter.head.variant(sorted(a[0])), out[0]))
+        return out
+
+    fw.drafter.propose = rec
+    b = DF.batcher(ck, fw, n=slots, pool_tokens=4096 * (slots + 1))
+    jobs = [Job(list(p), N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    assert DF.run(b, jobs) == serial
+    assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0 and seen
+    if head.startswith("trim"):
+        listed = set(fw.drafter.head.ids.tolist())
+        assert len(listed) == 64
+        for variant, drafts in seen:
+            if variant == "trim":
+                assert all(t in listed for row in drafts for t in row)
+        variants = {v for v, _ in seen}
+        # the random prompts are half unlisted ids: with the fallback every pass is full (the switch back and forth
+        # is test_pass_variant_follows_the_tracker's)
+        assert variants == ({"full"} if head == "trimfb" else {"trim"})
+
+
+def test_two_ranks_trimmed_draft_alike(ck, vocab, monkeypatch):
+    import queue
+    import threading
+
+    _env(monkeypatch, "trimfb", vocab)
+
+    class PairLink:
+        def __init__(self):
+            self.q = queue.Queue()
+
+        def send(self, plan):
+            self.q.put(list(plan))
+
+        def recv(self):
+            return self.q.get(timeout=120)
+
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck, slots=2, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    assert [len(f.drafter.head.ids) for f in fws] == [64, 64]
+    assert fws[0].drafter.head.ids.max() < 128 <= fws[1].drafter.head.ids.min()
+    seen = [[], []]
+    for r, f in enumerate(fws):
+        real = f.draft
+
+        def rec(*a, real=real, r=r, **k):
+            out = real(*a, **k)
+            seen[r].append(out)
+            return out
+
+        f.draft = rec
+    link = PairLink()
+    b0 = DF.batcher(ck, fws[0], n=2, link=link, rank=0)
+    b1 = DF.batcher(ck, fws[1], n=2, link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    got = DF.run(b0, [Job(list(PROMPTS[0]), 12, None), Job(list(PROMPTS[1]), 12, S1)])
+    b0.send_stop()
+    t.join(timeout=120)
+    assert not t.is_alive()
+    assert seen[0] == seen[1] and len(seen[0]) > 0 and all(len(g) == 12 for g in got)
+
+
+def test_pass_variant_follows_the_tracker(ck, vocab, monkeypatch):
+    _env(monkeypatch, "trimfb", vocab)
+    fw = DF.forward(ck, slots=2)
+    dr = fw.drafter
+    DF.batcher(ck, fw, n=2).ex.slots[0].ensure(100)
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple([1, 3, 5, 7] * 8))], mode="full")      # listed ids only
+    assert dr.head.variant([0]) == "trim" and dr.head.variants() == ["trim", "full"]
+    dr.observe(1, [2, 4, 6, 8])                                          # slot 1: unlisted
+    assert dr.head.variant([1]) == "full" and dr.head.variant([0, 1]) == "full"
+    d, _ = dr.propose([0], [9], [32])
+    assert len(d[0]) == dr.rows and ((0,), dr.rows, "trim") in dr._inputs
+    fw.reset(1)
+    assert dr.head.variant([0, 1]) == "trim"
+
+
+def test_calibration_key_moves_with_draft_knobs():
+    from tensorfold.families.deepseek_v41.cuda import calib
+
+    base = calib.cache_key("img", {"slots": 1}, {})
+    for k, v in (("TF_DSV41_DRAFT_HEAD", "trim"), ("TF_DSV41_DRAFT_VOCAB", "/x"),
+                 ("TF_DSV41_DRAFT_VOCAB_FALLBACK", "off"), ("TF_DSV41_DRAFT_GRAPHS", "0"),
+                 ("TF_DSV41_DRAFT_Q4_BN", "128")):
+        assert calib.cache_key("img", {"slots": 1}, {k: v}) != base, k
