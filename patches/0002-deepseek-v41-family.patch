+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck, slots=2, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    seen = [[], []]
+    for r, f in enumerate(fws):
+        real = f.draft
+
+        def rec(*a, real=real, r=r, **k):
+            out = real(*a, **k)
+            seen[r].append(out)
+            return out
+
+        f.draft = rec
+    link = PairLink()
+    b0 = DF.batcher(ck, fws[0], n=2, link=link, rank=0)
+    b1 = DF.batcher(ck, fws[1], n=2, link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    jobs = [Job(list(SHORT[0]), 12, None), Job(list(SHORT[1]), 12, SAMPLINGS[1])]
+    got = DF.run(b0, jobs)
+    b0.send_stop()
+    t.join(timeout=120)
+    assert not t.is_alive()
+    assert seen[0] == seen[1] and len(seen[0]) > 0
+    one = DF.run(DF.batcher(ck, DF.forward(ck, slots=2), n=2), [Job(list(SHORT[0]), 12, None),
+                                                               Job(list(SHORT[1]), 12, SAMPLINGS[1])])
+    assert [g[:4] for g in got] == [o[:4] for o in one] and all(len(g) == 12 for g in got)
+
+
+def test_engram_prefetch_hits(ck, tmp_path):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    cfg, table = ck[1], ck[2]
+    FK.write_engram(tmp_path, cfg, table, 1)
+    rows = EH.open_shards(tmp_path, 0, 1, cfg.engram_layer_ids, dim=cfg.engram_head_dim)
+    fw = DF.forward(ck, slots=2, prefetch=True, rows=rows)
+    b = DF.batcher(ck, fw, n=2, lookup=True)
+    got = DF.run(b, [Job(list(SHORT[0]), 10, None), Job(_repeating(5), 10, SAMPLINGS[1])])
+    st = fw.prefetcher.stats
+    assert st["hits"] > 0 and st["misses"] == 0
+    want = _serial_short(ck, [SHORT[0]], n=10) + _serial_short(ck, [_repeating(5)], n=10, sampling=SAMPLINGS[1])
+    assert got == want
