@@ -0,0 +1,194 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 prefill levers on the CPU (no GPU):
+
+- ``TF_DSV41_PREFETCH_AHEAD``: a prefill round's Engram bulk reads of the NEXT segment are kept by the next round's
+  issue (no second read), give the shard's bytes, and a wrong guess is dropped (a miss, the same bytes);
+  ``next_pieces`` / ``piece_runs(after=)`` give the rows and lookback the next round's forward will ask for;
+- ``TF_DSV41_PREFILL_GATHER=bf16``: the prefill exchange's partials stay bf16 into the mHC boundary (the twin and the
+  forward): logits and both ranks' states equal the fp32 path's bit for bit, chunked == unchunked.
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+LO, N, HEADS = 1000, 50_000, 2
+ROWS = PF.BULK_ROWS // HEADS + 8                       # a segment's index tensor is a bulk read
+
+
+@pytest.fixture(scope="module")
+def shard(tmp_path_factory):
+    rows = np.random.default_rng(5).integers(0, 256, size=(N, EH.ROW_BYTES), dtype=np.uint8)
+    path = tmp_path_factory.mktemp("eng2") / "engram-l1-r0of1.bin"
+    EH.write_shard(path, 1, LO, rows, LO + N + 7)
+    return path
+
+
+class FakeHasher:
+    """hashes [n, 1 layer, HEADS] in the shard, a function of (ids, lookback) only."""
+
+    layout = SimpleNamespace(head_shard=lambda li, rank, world: (0, 0, 0, HEADS))
+
+    def __call__(self, ids, lookback=None, **kw):
+        ids = torch.as_tensor(ids, dtype=torch.long)
+        lb = torch.as_tensor([] if lookback is None else lookback, dtype=torch.long)
+        seq = torch.cat([lb, ids])
+        prev = torch.cat([torch.zeros(1, dtype=torch.long), seq[:-1]])[len(lb):]
+        h = torch.stack([(ids * 7919 + prev * 104729 + k * 13) % N + LO for k in range(HEADS)], 1)
+        return h.view(-1, 1, HEADS)
+
+
+def fake_fw(tails):
+    cfg = SimpleNamespace(engram_layer_ids=(1,), engram_max_ngram_size=3)
+    blk = SimpleNamespace(engram=object(), index=1, cfg=cfg)
+    return SimpleNamespace(hasher=FakeHasher(), blocks=[blk], cfg=cfg, rank=0, world=1, pchunk=ROWS, chunk=4,
+                           slots=[SimpleNamespace(tail=list(t)) for t in tails])
+
+
+def bits(t):
+    return t.view(torch.int32)          # random bytes hold e4m3 NaNs: compare the bits
+
+
+def test_next_pieces_and_lookback():
+    prompt = list(range(100, 100 + 3 * ROWS + 5))
+    cur = [Piece(0, ROWS, tuple(prompt[ROWS:2 * ROWS]))]
+    nxt = PF.next_pieces(cur, {0: prompt})
+    assert nxt == [Piece(0, 2 * ROWS, tuple(prompt[2 * ROWS:3 * ROWS]))]
+    last = PF.next_pieces(nxt, {0: prompt})             # stops before the prompt's last token
+    assert last == [Piece(0, 3 * ROWS, tuple(prompt[3 * ROWS:-1]))]
+    assert PF.next_pieces(last, {0: prompt}) == [] and PF.next_pieces(cur, {0: None}) == []
+    fw = fake_fw([prompt[ROWS - 2:ROWS]])
+    ahead = PF.piece_runs(fw, nxt, after=cur)
+    fw.slots[0].tail = prompt[2 * ROWS - 2:2 * ROWS]    # what the slot holds once the current piece is kept
+    assert ahead == PF.piece_runs(fw, nxt)
+
+
+def test_ahead_bulk_reads_are_kept_and_exact(shard):
+    src = EH.ShardRows(shard)
+    pf = PF.Prefetcher({1: src}, workers=2, cache=0)
+    prompt = np.random.default_rng(1).integers(0, 5000, size=3 * ROWS + 1).tolist()
+    fw = fake_fw([[]])
+    cur = [Piece(0, 0, tuple(prompt[:ROWS]))]
+    nxt = PF.next_pieces(cur, {0: prompt})
+    pf.issue(fw, PF.piece_runs(fw, cur), ahead=PF.piece_runs(fw, nxt, after=cur))
+    assert len(pf.bulk) == 2 and pf.stats["ahead"] == 1
+    reads = pf.stats["issued"]
+    fw.slots[0].tail = prompt[ROWS - 2:ROWS]
+    runs = PF.piece_runs(fw, nxt)
+    pf.issue(fw, runs)                                  # the next round: the ahead read is kept, not re-issued
+    assert pf.stats["kept"] == 1 and pf.stats["issued"] == reads and pf.stats["dropped"] == 1   # cur's own: unused
+    idx = fw.hasher(runs[0][0][1], lookback=runs[0][0][2])[:, 0].reshape(-1)
+    got = pf.rows(1, idx)
+    assert pf.stats["hits"] == 1
+    assert torch.equal(bits(got), bits(EH.ShardRows(shard).rows(idx)))
+    pf.close()
+
+
+def test_wrong_guess_is_a_miss_with_the_same_bytes(shard):
+    src = EH.ShardRows(shard)
+    pf = PF.Prefetcher({1: src}, workers=2, cache=0)
+    prompt = np.random.default_rng(2).integers(0, 5000, size=3 * ROWS + 1).tolist()
+    fw = fake_fw([[]])
+    cur = [Piece(0, 0, tuple(prompt[:ROWS]))]
+    pf.issue(fw, PF.piece_runs(fw, cur), ahead=PF.piece_runs(fw, PF.next_pieces(cur, {0: prompt}), after=cur))
+    fw.slots[0].tail = prompt[ROWS - 2:ROWS]
+    other = [Piece(0, ROWS, tuple(prompt[ROWS:2 * ROWS - 16]))]            # the batcher cut the piece elsewhere
+    runs = PF.piece_runs(fw, other)
+    pf.issue(fw, runs)
+    assert pf.stats["kept"] == 0 and pf.stats["dropped"] == 2
+    idx = fw.hasher(runs[0][0][1], lookback=runs[0][0][2])[:, 0].reshape(-1)
+    assert torch.equal(bits(pf.rows(1, idx)), bits(EH.ShardRows(shard).rows(idx)))
+    pf.close()
+
+
+def test_ahead_knob(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_PREFETCH_AHEAD", raising=False)
+    assert not PF.ahead_enabled()
+    monkeypatch.setenv("TF_DSV41_PREFETCH_AHEAD", "1")
+    assert PF.ahead_enabled()
+
+
+# -- TF_DSV41_PREFILL_GATHER=bf16 ------------------------------------------------------------------------------------
+IDS = torch.randint(0, 256, (37,), generator=torch.Generator().manual_seed(23)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41pf2"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def tp_state(fw) -> dict:
+    s = fw.slots[0]
+    snap = fw.snapshot(0)
+    out = {f"snap.{k}": torch.from_numpy(np.asarray(v)) for k, v in snap.arrays.items()}
+    for L, st in s.comp.items():
+        n = s.pos // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    return out
+
+
+def pair_run(ckpt, gather_bf16: bool, pchunk: int = 36):
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+
+    root, cfg, table = ckpt
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    tmap = FK.token_map(cfg)
+    fws = []
+    for r in range(2):
+        tree = W.Loader(cfg, W.Shards(root), r, 2).load(token_map=tmap)
+        rows = {L: EH.MemoryRows(a, b) for L, (a, b) in table.items()}
+        fw = SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comms[r], limit=96,
+                          chunk=4, pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+        fw.gather_bf16 = gather_bf16
+        fw.decode_bf16 = False          # this test isolates the prefill knob (decode bf16: test_dsv41_decode_xchg.py)
+        fws.append(fw)
+    seen = []
+    real = fws[0].hc.boundary
+
+    def spy(x, xout, gathered, *a, **kw):
+        seen.append(gathered.dtype)
+        return real(x, xout, gathered, *a, **kw)
+
+    def go(fw):
+        fw.hc.boundary = spy
+        fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+        return fw.step([IDS[-1]]), tp_state(fw)
+
+    return pair.run([lambda f=f: go(f) for f in fws]), seen
+
+
+@pytest.mark.parametrize("pchunk", [36, 8])
+def test_gather_bf16_same_bits(ckpt, pchunk):
+    """TP=2: prefill segments' partials into the mHC boundary as bf16 == the fp32 widening's logits and both ranks'
+    states bit for bit (one 36-row segment, and 8-row segments == the same)."""
+
+    got, seen = pair_run(ckpt, True, pchunk)
+    want, seen32 = pair_run(ckpt, False, 36)
+    assert torch.bfloat16 in seen and torch.bfloat16 not in seen32
+    assert torch.float32 in seen                         # verify rows (<= chunk) keep fp32 partials
+    for (lg, st), (lw, sw) in zip(got, want):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
