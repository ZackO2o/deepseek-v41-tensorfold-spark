+"""G9 decode mHC site (families/deepseek_v41/cuda/mhc_dec.py) in Triton's CPU interpreter (``gpu_like``):
+
+- ``TF_DSV41_MHC_DEC=1`` == ``0`` (``mhc._site``'s SPLIT launch) bit for bit: the new streams, the collapsed row, the
+  taps, every partial, the coefficients and the normed input; boundary (world 1 / 2, taps on / off) and site (stream
+  0 / the carried pre-mix), 1 / 2 / 3 / 5 / 16 rows;
+- both == the torch emulation ``dsv41_kref.mhc_boundary``; with ``fn`` bf16 (``TF_DSV41_MHC_FN=bf16``) too;
+- row invariance with the decode kernel: a row alone == the same row of a 5-row window;
+- ``prepare`` leaves CPU weights (the torch fallback) alone; the knobs parse.
+
+Run: python -m pytest -q tests/test_dsv41_mhc_dec_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+import dsv41_kref as KR
+
+from tensorfold.families.deepseek_v41.cuda import mhc
+from tensorfold.families.deepseek_v41.cuda import mhc_dec as MD
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(mhc._site).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+D = 1280            # NB = 40 blocks of 32 columns: 2 chain steps a block (the model's 5,120: tests/cuda)
+
+
+def _bits(t):
+    return t.contiguous().view(-1).view(torch.uint8)
+
+
+def _case(R: int, d: int, world: int, seed: int, fn_dtype=torch.float32):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, d), generator=g) * 0.7).to(torch.bfloat16)
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, "cpu", pre=torch.rand((R, 4), generator=g) + 0.1, post=torch.rand((R, 4), generator=g) * 2,
+                     comb=comb)
+    hc = mhc.Hc((torch.randn((24, 4 * d), generator=g) * 0.01).to(fn_dtype).contiguous(),
+                torch.randn(24, generator=g) * 0.5, torch.rand(3, generator=g) + 0.5)
+    nw = (torch.rand(d, generator=g) + 0.5).to(torch.bfloat16)
+    return x, gathered, prev, hc, nw
+
+
+def _boundary(x, gathered, prev, hc, nw, tap: bool):
+    R, d = gathered.shape[1], gathered.shape[2]
+    xout = torch.zeros_like(x)
+    out = torch.zeros((R, d), dtype=torch.bfloat16)
+    co = mhc.Coefs(R, "cpu")
+    sc = mhc.Scratch(R, "cpu", d)
+    tp = torch.zeros((R, 3 * d), dtype=torch.bfloat16)[:, d:2 * d] if tap else None
+    mhc.boundary(x, xout, gathered, prev, hc, nw, out, co, sc, tap=tp)
+    return {"x": xout, "out": out, "pre": co.pre, "post": co.post, "comb": co.comb, "c": sc.c[:R], "part": sc.part[:R],
+            "tap": tp if tap else torch.zeros(0)}
+
+
+def _site(x, hc, nw, pre_in):
+    R, d = x.shape[0], nw.shape[0]
+    out = torch.zeros((R, d), dtype=torch.bfloat16)
+    co = mhc.Coefs(R, "cpu")
+    sc = mhc.Scratch(R, "cpu", d)
+    mhc.site(x, hc, nw, out, co, sc, pre_in=pre_in)
+    return {"out": out, "pre": co.pre, "post": co.post, "comb": co.comb, "c": sc.c[:R], "part": sc.part[:R]}
+
+
+def _same(a: dict, b: dict):
+    for k in a:
+        if k == "part":     # [.., 25] is the collapsed row's square sum at stream 0 only (the others: not written)
+            assert torch.equal(_bits(a[k][..., :25]), _bits(b[k][..., :25])), k
+            assert torch.equal(_bits(a[k][:, 0, :, 25]), _bits(b[k][:, 0, :, 25])), k
+        else:
+            assert torch.equal(_bits(a[k]), _bits(b[k])), k
+
+
+@pytest.mark.parametrize("R,world,tap", [(1, 2, False), (2, 2, True), (3, 1, True), (5, 2, False), (16, 2, True)])
+def test_boundary_dec_equals_split(monkeypatch, R, world, tap):
+    x, gathered, prev, hc, nw = _case(R, D, world, 100 + R)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "0")
+    old = _boundary(x, gathered, prev, hc, nw, tap)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "1")
+    new = _boundary(x, gathered, prev, hc, nw, tap)
+    _same(old, new)
+    want = KR.mhc_boundary(x, gathered.float(), prev.post, prev.comb, prev.pre, 2, hc.fn, mhc.NB)
+    assert torch.equal(_bits(new["x"]), _bits(want["x"])) and torch.equal(_bits(new["c"]), _bits(want["c"]))
+    assert torch.equal(_bits(new["part"][..., :25]), _bits(want["part"][..., :25]))
+    assert torch.equal(_bits(new["out"]), _bits(KR.mhc_finish_norm(want["part"], want["c"], nw, mhc.EPS)))
+    if tap:
+        assert torch.equal(_bits(new["tap"]), _bits(want["tap"]))
+
+
+@pytest.mark.parametrize("unroll", ["1", "0"])
+@pytest.mark.parametrize("pre_in", [False, True])
+def test_site_dec_equals_split(monkeypatch, pre_in, unroll):
+    monkeypatch.setenv("TF_DSV41_MHC_DEC_UNROLL", unroll)
+    x, _, prev, hc, nw = _case(3, D, 1, 7)
+    p_in = prev.pre if pre_in else None
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "0")
+    old = _site(x, hc, nw, p_in)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "1")
+    new = _site(x, hc, nw, p_in)
+    _same(old, new)
+    want = KR.mhc_boundary(x, None, None, None, p_in, 2 if pre_in else 1, hc.fn, mhc.NB)
+    assert torch.equal(_bits(new["c"]), _bits(want["c"]))
+    assert torch.equal(_bits(new["out"]), _bits(KR.mhc_finish_norm(want["part"], want["c"], nw, mhc.EPS)))
+
+
+def test_fn_bf16_against_emulation(monkeypatch):
+    """bf16 mixing weights: the kernels widen them exactly, so the emulation on fn.float() is the reference."""
+
+    x, gathered, prev, hc, nw = _case(2, D, 2, 21, torch.bfloat16)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "1")
+    new = _boundary(x, gathered, prev, hc, nw, True)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "0")
+    old = _boundary(x, gathered, prev, hc, nw, True)
+    _same(old, new)
+    want = KR.mhc_boundary(x, gathered.float(), prev.post, prev.comb, prev.pre, 2, hc.fn.float(), mhc.NB)
+    assert torch.equal(_bits(new["part"][..., :25]), _bits(want["part"][..., :25]))
+    # and the mixes stay close to fp32 weights' (bf16 weights: ~3 significant digits)
+    hc32 = mhc.Hc(hc.fn.float(), hc.base, hc.scale)
+    ref = _boundary(x, gathered, prev, hc32, nw, True)
+    torch.testing.assert_close(new["comb"], ref["comb"], rtol=0, atol=2e-3)
+    torch.testing.assert_close(new["pre"], ref["pre"], rtol=0, atol=2e-3)
+
+
+def test_row_invariance_dec(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "1")
+    R = 5
+    x, gathered, prev, hc, nw = _case(R, D, 2, 31)
+    full = _boundary(x, gathered, prev, hc, nw, True)
+    for r in (0, 4):
+        sl = slice(r, r + 1)
+        p1 = mhc.Coefs(1, "cpu", pre=prev.pre[sl].clone(), post=prev.post[sl].clone(), comb=prev.comb[sl].clone())
+        one = _boundary(x[sl].clone(), gathered[:, sl].clone(), p1, hc, nw, True)
+        for k in ("x", "out", "pre", "post", "comb", "c", "tap"):
+            assert torch.equal(_bits(one[k]), _bits(full[k][sl])), (r, k)
+
+
+def test_knobs_and_prepare(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda.weights import Hc as WHc
+
+    hc = WHc(torch.zeros((24, 4 * D)), torch.zeros(24), torch.ones(3))
+    monkeypatch.setenv("TF_DSV41_MHC_FN", "bf16")
+    assert MD.fn_bf16() and MD.prepare(hc) is hc                   # CPU: the torch fallback keeps fp32
+    monkeypatch.setenv("TF_DSV41_MHC_FN", "fp16")
+    with pytest.raises(ValueError):
+        MD.fn_bf16()
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "0")
+    assert not MD.applies(1, True, True)
+    monkeypatch.setenv("TF_DSV41_MHC_DEC", "1")
+    assert MD.applies(16, True, True) and not MD.applies(17, True, True) and not MD.applies(1, True, False)
+
+
+@pytest.mark.parametrize("R", [1, 3])
+def test_finish_norm_first_bits(monkeypatch, R):
+    """``TF_DSV41_MHC_FIN2``: the finish stores the normed input first, unrolled: the same bits as G7's order."""
+
+    x, gathered, prev, hc, nw = _case(R, D, 2, 50 + R)
+    monkeypatch.setenv("TF_DSV41_MHC_FIN2", "0")
+    old = _boundary(x, gathered, prev, hc, nw, False)
+    monkeypatch.setenv("TF_DSV41_MHC_FIN2", "1")
+    new = _boundary(x, gathered, prev, hc, nw, False)
+    _same(old, new)
+    xo = torch.zeros_like(x)
+    outs = []
+    for v in ("0", "1"):
+        monkeypatch.setenv("TF_DSV41_MHC_FIN2", v)
+        out = torch.zeros((R, D), dtype=torch.bfloat16)
+        mhc.final(x, xo, gathered, prev, nw, out, mhc.Scratch(R, "cpu", D))
+        outs.append(out)
+    assert torch.equal(_bits(outs[0]), _bits(outs[1]))
