new file mode 100644
index 0000000..f50bbdd
--- /dev/null
+++ b/tests/dsv41_x3seg_emu.py
@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A program-level emulator in numpy (no GPU) of upstream's ``linear_kernel`` / ``rot_in_kernel``
+(tensorfold/cuda/exl3/linear.cu) and of the segment-table kernels that fuse them (``x3seg.cu``, ``fused_proj``).
+
+Each program is emulated with the kernels' index formulas transcribed: its segment (the last one whose p0 <= p, as
+``seg_linear_kernel`` picks it), (nb, split) = (q % NB, q // NB), the warps' k tile ranges (kt0 = split * per_warp *
+wk + warp * per_warp), the 16-row passes, the shared-memory sums in warp order, Z at ((split * M + row) * N + col)
+from the segment's Z slice, the counter at pass * NB + nb of its counter slice (the last arriver sums Z in split
+order, applies the epilogue and resets the counter), the output at row * ld + col. Scratch (xh, Z, counters, outputs)
+are flat arrays shared by every segment, as on the GPU: a wrong offset in a table shows up as a collision, a stale
+read or an element written twice. Programs run in any order (a valid serialization of the launch).
+
+Arithmetic is fp32 where the kernels' is: an mma adds its 16-term product (exact in float64 for fp16 inputs) to the
+fp32 accumulator with one rounding; the reductions and the epilogue (``fwht128``'s butterflies, * 1/sqrt(128), *
+svh) are fp32 operations in the kernels' order. The trellis decode is not emulated (both kernels call the same
+``decode_lane``): a segment's W_q [K, N] fp16 is given (``format.unpack`` of a real trellis, or random values).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from dsv41_x3gm_emu import fwht128
+
+HAD = np.float32(0.08838834764831845)
+F32 = np.float32
+
+
+def mma(acc: np.ndarray, x16: np.ndarray, w16: np.ndarray) -> np.ndarray:
+    return (acc.astype(np.float64) + x16 @ w16).astype(F32)
+
+
+def epilogue(v: np.ndarray, svh: np.ndarray) -> np.ndarray:
+    """``finish`` on rows [R, 128] fp32: fwht128 (lane L holds columns 4L..4L+3), * HAD_SCALE, * svh."""
+
+    out = np.stack([fwht128(r.reshape(32, 4)).reshape(128) for r in v]).astype(F32)
+    return ((out * HAD).astype(F32) * svh.astype(F32)).astype(F32)
+
+
+def rot_rows(x: np.ndarray, suh: np.ndarray) -> np.ndarray:
+    """``rot_in``: fp16(fwht128(x * suh) / sqrt(128)) over [M, K] (fp32 math, 128-blocks)."""
+
+    v = (x.astype(F32) * suh.astype(F32)).astype(F32)
+    M, K = v.shape
+    out = np.empty_like(v)
+    for r in range(M):
+        for b in range(K // 128):
+            out[r, 128 * b:128 * b + 128] = fwht128(v[r, 128 * b:128 * b + 128].reshape(32, 4)).reshape(128)
+    return (out * HAD).astype(F32).astype(np.float16)
+
+
+class Mem:
+    """The device memory of one call: flat xh (fp16), Z (fp32, NaN = never written), counters, output buffers (with a
+    write count an element)."""
+
+    def __init__(self, xh_total: int, z_total: int, c_total: int, widths: list[int], m: int) -> None:
+        self.xh = np.full((xh_total,), np.nan, dtype=np.float16)
+        self.z = np.full((max(z_total, 1),), np.nan, dtype=F32)
+        self.counters = np.zeros((max(c_total, 1),), dtype=np.int64)
+        self.ys = [np.full((m * w,), np.nan, dtype=F32) for w in widths]
+        self.writes = [np.zeros((m * w,), dtype=np.int64) for w in widths]
+        self.ld = list(widths)
+
+
+def program(mem: Mem, buf: int, col: int, xh_off: int, z_off: int, c_off: int, W: np.ndarray, svh: np.ndarray,
+            M: int, K: int, N: int, SK: int, wk: int, WK: int, nb: int, split: int) -> None:
+    """One program of upstream's linear_kernel (blockIdx (nb, split)), or of seg_linear_kernel in its segment."""
+
+    NB = N >> 7
+    per_warp = (K >> 4) // SK // wk
+    xh = mem.xh[xh_off:xh_off + M * K].astype(np.float64).reshape(M, K)
+    col0 = nb * 128
+    y, ld = mem.ys[buf], mem.ld[buf]
+    for m0 in range(0, M, 16):
+        pas = m0 // 16
+        R = min(16, M - m0)
+        sums = []
+        for warp in range(WK):
+            acc = np.zeros((R, 128), dtype=F32)
+            if warp < wk:                                       # idle warps of a narrower segment walk nothing
+                kt0 = split * (per_warp * wk) + warp * per_warp
+                for i in range(per_warp):
+                    kt = kt0 + i
+                    acc = mma(acc, xh[m0:m0 + R, kt * 16:kt * 16 + 16], W[kt * 16:kt * 16 + 16, col0:col0 + 128])
+            sums.append(acc)
+        s = sums[0].copy()
+        for w in range(1, wk):
+            s = (s + sums[w]).astype(F32)
+        rows = np.arange(m0, m0 + R)
+        if SK == 1:
+            at = (rows[:, None] * ld + col + col0 + np.arange(128)[None, :]).reshape(-1)
+            y[at] = epilogue(s, svh[col0:col0 + 128]).reshape(-1)
+            mem.writes[buf][at] += 1
+            continue
+        zat = z_off + ((split * M + rows[:, None]) * N + col0 + np.arange(128)[None, :])
+        mem.z[zat.reshape(-1)] = s.reshape(-1)
+        c = c_off + pas * NB + nb
+        old = mem.counters[c]
+        mem.counters[c] += 1
+        if old == SK - 1:                                       # the last arriver
+            base = z_off + (rows[:, None] * N + col0 + np.arange(128)[None, :])
+            t = mem.z[base.reshape(-1)].reshape(R, 128).copy()
+            for qq in range(1, SK):
+                t = (t + mem.z[(base + qq * M * N).reshape(-1)].reshape(R, 128)).astype(F32)
+            at = (rows[:, None] * ld + col + col0 + np.arange(128)[None, :]).reshape(-1)
+            y[at] = epilogue(t, svh[col0:col0 + 128]).reshape(-1)
+            mem.writes[buf][at] += 1
+            mem.counters[c] = 0
+
+
+def upstream(x: np.ndarray, suh, W, svh, sk: int, wk: int, seed: int = 0) -> np.ndarray:
+    """``Exl3Linear.__call__`` of one layer (rot_in + linear_kernel, grid (N / 128, SK)) in fp32, M <= 128."""
+
+    M, K = x.shape
+    N = W.shape[1]
+    mem = Mem(M * K, sk * M * N if sk > 1 else 0, 8 * (N // 128), [N], M)
+    mem.xh[:] = rot_rows(x, suh).reshape(-1)
+    order = [(nb, s) for s in range(sk) for nb in range(N // 128)]
+    np.random.default_rng(seed).shuffle(order)
+    for nb, s in order:
+        program(mem, 0, 0, 0, 0, 0, W, svh, M, K, N, sk, wk, wk, nb, s)
+    assert (mem.writes[0] == 1).all() and not mem.counters.any()
+    return mem.ys[0].reshape(M, N)
+
+
+def segmented(xs: list, suhs: list, Ws: list, svhs: list, segs: list, lay, widths: list[int], seed: int = 0):
+    """``fused_proj.Fused._block`` over ``segs`` / ``lay`` (fused_proj.layout): the one rot_in launch, then each
+    launch's programs in a shuffled order. Returns (output buffers [M, width], the Mem)."""
+
+    M = xs[0].shape[0]
+    mem = Mem(lay.xh_total, lay.z_total, lay.c_total, widths, M)
+    for i, x in enumerate(xs):                                  # seg_rot_in: blockIdx.z = segment
+        K = x.shape[1]
+        mem.xh[lay.xh_off[i]:lay.xh_off[i] + M * K] = rot_rows(x, suhs[i]).reshape(-1)
+    rng = np.random.default_rng(seed)
+    for k2, WK, part, meta, programs in lay.launches:
+        table = [meta[11 * j:11 * j + 11] for j in range(len(part))]
+        order = np.arange(programs)
+        rng.shuffle(order)
+        for p in order:
+            j = 0                                               # seg_linear_kernel: the last segment with p0 <= p
+            for jj in range(1, len(part)):
+                if p >= table[jj][10]:
+                    j = jj
+            K, N, SK, wk, _, _, xo, zo, co, col, p0 = table[j]
+            i = part[j]
+            assert segs[i].k2 == k2 and wk <= WK
+            q = int(p) - p0
+            NB = N >> 7
+            program(mem, segs[i].out, col, xo, zo, co, Ws[i], svhs[i], M, K, N, SK, wk, WK, q % NB, q // NB)
+    return [y.reshape(M, w) for y, w in zip(mem.ys, widths)], mem
