+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Expert-budgeted verification (budget.py) through the whole forward in Triton's CPU interpreter, on the synthetic
+DSpark checkpoint bound to a KV pool (the row-mode harness of test_dsv41_rowmode_fwd_interp.py):
+
+- with ``TF_DSV41_VERIFY_BUDGET`` on, a row-mode run (what a slot-agnostic graph replays: padded, the meta derived
+  from the row table) == one launch sequence a segment (the meta filled from the spans): per-slot budgets;
+- row 1 of every window (the pending row) has the exact model's logits, bit for bit;
+- the draft rows differ from the exact model's (B = 0 drops / substitutes): the mode is lossy, as documented;
+- a segment's logits alone == in a window with other slots (batched == alone per slot).
+
+Run: python -m pytest -q tests/test_dsv41_budget_fwd_interp.py (~25 min on the CPU).
+"""
+
+from __future__ import annotations
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import budget as BU  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.forward import Seg  # noqa: E402
+
+if type(compress._kv_store).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+import test_dsv41_rowmode_fwd_interp as RF  # noqa: E402
+
+STEPS = [[(0, 3), (1, 1), (2, 4)], [(1, 5), (2, 4)], [(2, 2), (0, 5)]]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41budget"))
+
+
+def _ids(g, n):
+    return tuple(int(t) for t in torch.randint(3, 250, (n,), generator=g))
+
+
+def test_budget_row_mode_equals_per_segment_and_row1_exact(ck, monkeypatch):
+    a, _ = RF._forward(ck)
+    b, _ = RF._forward(ck)
+    c, _ = RF._forward(ck)                                      # exact
+    rows = RG.Rows(a, max(RT.BUCKETS[:10]), 2048)
+    g = torch.Generator().manual_seed(9)
+    differ = 0
+    for step, mix in enumerate(STEPS):
+        segs = [Seg(s, a.slots[s].pos, _ids(g, n)) for s, n in mix]
+        key = RT.row_key([(sg.slot, sg.start, len(sg.ids)) for sg in segs], 2048, RF.LIMIT)
+        monkeypatch.setattr(BU, "CFG", BU.Cfg(0, "sub"))
+        got = rows.run(key, segs)
+        want = b.run(segs)
+        monkeypatch.setattr(BU, "CFG", BU.Cfg(None))
+        exact = c.run(segs)
+        assert torch.equal(got, want), (step, mix)              # row mode (padded, table meta) == per segment
+        a0 = 0
+        for sg in segs:
+            n = len(sg.ids)
+            assert torch.equal(got[a0], exact[a0]), (step, sg.slot)         # row 1: the exact model's bits
+            differ += int(not torch.equal(got[a0 + 1:a0 + n], exact[a0 + 1:a0 + n]))
+            a0 += n
+        for f in (a, b, c):
+            for sg in segs:
+                f.keep(sg.slot, 0)
+    assert differ > 0                                           # lossy: some draft rows changed
+
+
+def test_budget_alone_equals_batched(ck, monkeypatch):
+    monkeypatch.setattr(BU, "CFG", BU.Cfg(2, "sub"))
+    a, _ = RF._forward(ck)
+    b, _ = RF._forward(ck)
+    g = torch.Generator().manual_seed(10)
+    segs = [Seg(s, a.slots[s].pos, _ids(g, n)) for s, n in [(0, 4), (1, 3), (2, 5)]]
+    both = a.run(segs)
+    a0 = 0
+    for sg in segs:
+        alone = b.run([sg])
+        assert torch.equal(both[a0:a0 + len(sg.ids)], alone), sg.slot
+        a0 += len(sg.ids)
