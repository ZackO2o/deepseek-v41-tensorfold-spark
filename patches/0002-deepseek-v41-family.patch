index 0000000..d910a93
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/protocol.py
@@ -0,0 +1,211 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The engine-facing protocol of the DeepSeek-V4.1 serving layer: what the batcher (``batch.py``), the session store
+(``sessions.py`` / ``sessdisk.py``) and the app need from the forward, as typed interfaces. The forward (M1:
+``forward.py`` / ``engine.py``) implements ``Forward``; the serving layer is tested against a fake forward that keeps
+the same rules (``tests/serving/fake_forward.py``).
+
+Positions and rows:
+
+- a slot's **position** ``pos`` = the tokens whose state is written (pool rows, rings, carries, lookback, taps);
+- a prompt of n tokens is **prefilled** over [0, n - 1) in pieces (``Piece``); its last token is the first verify
+  window's pending row, so every logit the server samples comes from ``window`` (prefill rows == decode rows: one
+  sampling path, one grammar path, M1 gate 3);
+- pieces start on the 16-token grid (``GRID``); a piece ends on the grid or at n - 1; one piece ends exactly at the
+  prompt's replay point S = ``sessions.snapshot_point(n)`` (GLM 0540) so the slot can be snapshotted there;
+- ``finish_prompt`` runs once a prompt's pieces are done, before its first window: in ``replay`` mode (CED,
+  ``TF_DSV41_PREFILL=replay``) the decoder over the prompt's last rows (``tail``); in ``full`` mode a no-op;
+- ``window`` writes each window's rows at [start, start + len(tokens)), every row computed as the serial step at
+  its position (row-invariant kernels); ``commit`` keeps the pending row + ``accepted`` drafts, so pos = start +
+  accepted + 1. Rejected rows' writes lie past pos and are overwritten before anything reads them.
+
+Pages: the batcher owns the slot's page table (``pool.Slot``: GLM 0290's ``SlotPages`` with shared pages). Before any
+call that writes positions < end it has mapped them (``Slot.ensure``); the forward reads ``pool.view(slot, family)``
+(a GLM ``Paged`` per family) or the device page table ``Slot.table`` + ``Pool.phys``.
+
+Ranks (TP=2): rank 0 plans every round and shares it (``Link``); both ranks make the same calls with the same
+arguments in the same order. ``window`` returns the candidates merged over both ranks' vocabulary halves (one
+exchange, GLM ``decode.sample_rows``), so both ranks see the same ``Candidates``; only rank 0 samples.
+
+Snapshots: ``snapshot`` returns the slot's bounded state (``state.Bounded``) at its position; the pool pages below
+the position are the store's business (``sessions.Store`` keeps them mapped, ``sessdisk`` parks them). ``restore``
+loads a bounded state into a slot whose pages the store has mapped already.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any, Protocol, runtime_checkable
+
+import numpy as np
+
+GRID = 16                    # snapshot / piece alignment in tokens (ratio 2 x candidate block 8)
+ROW_BYTES, VB, SB = 584, 576, 8          # csa2.rows' FP8 KV record: 448 e4m3 + 64 bf16 RoPE dims, 8 scale bytes
+                                         # (sizes only: the host modules need no Triton; tests check they agree)
+REPLAY = 128                 # CED: the decoder's rows over a prompt's end (replay mode)
+MODES = ("full", "replay")
+
+
+@dataclass(frozen=True)
+class Piece:
+    """Prompt tokens ``ids`` of ``slot`` at positions [start, start + len(ids)) (prefill, no logits)."""
+
+    slot: int
+    start: int
+    ids: tuple[int, ...]
+
+    @property
+    def end(self) -> int:
+        return self.start + len(self.ids)
+
+
+@dataclass(frozen=True)
+class Rows:
+    """One slot's verify window: ``tokens[0]`` the pending token at ``start``, then the drafts (a chain)."""
+
+    slot: int
+    start: int
+    tokens: tuple[int, ...]
+
+
+@dataclass
+class Candidates:
+    """The top ``count`` columns of each verify row, merged over the ranks: ``ids`` [R, C] int64, ``values`` [R, C]
+    float32 logits, rows in window order (window 0's rows first), each row sorted by (value desc, id asc) (greedy
+    takes column 0). Masked columns (structured output) never appear unless a row allows fewer than C tokens; then
+    the rest are -inf (sampling skips them)."""
+
+    ids: np.ndarray
+    values: np.ndarray
+    nucleus: dict | None = None     # row -> ("keep", n) | ("full", ids, values): top-p rows (``nucleus.py``)
+
+    def rows(self, a: int, b: int) -> Candidates:
+        nuc = None if self.nucleus is None else {r - a: v for r, v in self.nucleus.items() if a <= r < b}
+        return Candidates(self.ids[a:b], self.values[a:b], nuc or None)
+
+
+@dataclass
+class Bounded:
+    """A slot's bounded state at ``pos`` (``state.py``): the SWA rings' last rows, the compressor carries when pos is
+    odd, the Engram lookback, the DSpark taps. ``arrays`` are host numpy arrays (the forward copies them; ~10 MB),
+    ``meta`` small ints / strings (the CED mode it was taken in, ring layout)."""
+
+    pos: int
+    arrays: dict[str, np.ndarray] = field(default_factory=dict)
+    meta: dict[str, Any] = field(default_factory=dict)
+
+    def nbytes(self) -> int:
+        return int(sum(a.nbytes for a in self.arrays.values()))
+
+
+@runtime_checkable
+class Forward(Protocol):
+    """What the serving layer calls on each rank (M1 implements it in ``forward.py``)."""
+
+    vocab: int                    # the full vocabulary (129,280)
+
+    def reset(self, slot: int) -> None:
+        """A new request in ``slot``: position 0, rings / carries / lookback / taps cleared (pages: the batcher)."""
+
+    def prefill(self, pieces: Sequence[Piece], *, mode: str) -> None:
+        """One forward over several slots' pieces (GLM 0560: the experts' pass shared; rows independent). In
+        ``replay`` mode only the encoder layers (0-19, + layer 20's compressor projection)."""
+
+    def finish_prompt(self, slot: int, end: int, tail: Sequence[int], *, mode: str) -> None:
+        """The prompt's prefilled part ends at ``end`` (= n - 1); ``tail`` = its last ids (at most REPLAY - 1, ending
+        at ``end``). Replay mode: rebuild the decoder rings from ``tail``. Full mode: nothing."""
+
+    def window(self, windows: Sequence[Rows], *, count: int,
+               masks: Sequence[np.ndarray | None] | None = None) -> Candidates:
+        """One verify forward over every window (rows concatenated); ``masks[i]``: xgrammar bits [len(rows_i),
+        ceil(vocab / 32)] int32 for window i (None: unconstrained), applied as -inf before the top ``count``."""
+
+    def commit(self, slot: int, accepted: int) -> None:
+        """Keep the last window's pending row + ``accepted`` drafts of ``slot`` (carry, lookback, taps, pos)."""
+
+    def snapshot(self, slot: int) -> Bounded:
+        """The slot's bounded state at its position (any position; carries included when it is odd)."""
+
+    def restore(self, slot: int, snap: Bounded) -> None:
+        """Load ``snap`` into ``slot`` (its pages below snap.pos are mapped and hold the entry's rows)."""
+
+
+class Bind(Protocol):
+    """Optional: the executor hands the forward its slots' page tables once at load (``pool.Slot``: ``table`` is the
+    device int32 page table, ``pages`` the host list); the forward keeps them for every call."""
+
+    def bind(self, slots: Sequence[Any]) -> None: ...
+
+
+class Drafts(Protocol):
+    """Optional (M2): DSpark proposals, run on both ranks inside the round (``plan.WindowSpec.depth`` > 0).
+    ``draft(slots, pendings, starts, depths)`` -> each slot's drafted tokens after its pending token (at most its
+    depth; the taps of the slot's last window + the pending token, keyed draft noise at T > 0). Both ranks must get
+    the same tokens (they come from merged candidates)."""
+
+    def draft(self, slots: Sequence[int], pendings: Sequence[int], starts: Sequence[int],
+              depths: Sequence[int]) -> list[list[int]]: ...
+
+
+class Prefetch(Protocol):
+    """Optional: Engram reads for the next forward, issued before it (``engram.Reader``)."""
+
+    def prefetch(self, pieces: Sequence[Piece], windows: Sequence[Rows]) -> None: ...
+
+
+class Link(Protocol):
+    """Rank agreement for round plans: rank 0 ``send``s each plan, rank 1 ``recv``s it (GLM ``_share`` of an int
+    list: a length gather then a value gather on the communicator); ``wake`` / ``wait``: the idle doorbell."""
+
+    def send(self, plan: list[int]) -> None: ...
+
+    def recv(self) -> list[int]: ...
+
+
+@dataclass
+class LocalLink:
+    """One rank (tests, single-node bring-up): plans go nowhere."""
+
+    def send(self, plan: list[int]) -> None:
+        return None
+
+    def recv(self) -> list[int]:
+        raise RuntimeError("a one-rank link has nothing to receive")
+
+
+def pack_bytes(data: bytes) -> list[int]:
+    """3 bytes an int (non-negative int32 words, GLM ``grammar._pack_bytes``)."""
+
+    data = data + b"\0" * (-len(data) % 3)
+    return [data[i] | data[i + 1] << 8 | data[i + 2] << 16 for i in range(0, len(data), 3)]
+
+
+def unpack_bytes(words: Sequence[int], n: int) -> bytes:
+    out = bytearray()
+    for v in words:
+        v = int(v)
+        out += bytes((v & 255, v >> 8 & 255, v >> 16 & 255))
+    return bytes(out[:n])
+
+
+def accepted(window_tokens: Sequence[int], chosen: Sequence[int]) -> int:
+    """Drafts kept from a chain window: ``window_tokens`` = [pending, d1, d2, ...], ``chosen`` = the target's keyed
+    choice after each row. Keep d_i while d_i == chosen[i - 1]; the round emits accepted + 1 tokens (drafted ==
+    serial for any drafter: ``drafting.accepted``)."""
+
+    n = 0
+    for d, c in zip(window_tokens[1:], chosen):
+        if d != c:
+            break
+        n += 1
+    return n
+
+
+def check_forward(fwd: Any) -> None:
+    """Raise TypeError when ``fwd`` lacks a ``Forward`` method (load-time check of M1's object)."""
+
+    missing = [m for m in ("reset", "prefill", "finish_prompt", "window", "commit", "snapshot", "restore")
+               if not callable(getattr(fwd, m, None))]
+    if missing or not isinstance(getattr(fwd, "vocab", None), int):
+        raise TypeError(f"not a V4.1 Forward: missing {', '.join(missing) or 'vocab'}")
diff --git a/src/tensorfold/families/deepseek_v41/cuda/prune.py b/src/tensorfold/families/deepseek_v41/cuda/prune.py
new file mode 100644
index 0000000..5b574db
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/prune.py
@@ -0,0 +1,286 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dynamic routed-expert pruning (G9 lever ``prune``): after the router's top-k, drop the routed experts that carry
+little of a row's weight, so a verify window reads fewer expert bytes. Decode is bound by those bytes (G9: a second
+verify row brings ~5-6 new experts a layer, ~5 ms; experts are 59% of a 2-stream joint window).
+
+A row's routed weights w_0..w_{K-1} (the router's fp32 ``1.5 s_i / sum s``, slot = pick order) give fractions
+f_i = w_i / sum_j w_j. By f descending (ties: the lower slot first) a row keeps the shortest prefix that
+
+- reaches the cumulative mass ``TOPP`` (a slot is kept while the mass before it is < TOPP), and
+- holds only fractions >= ``MIN_W`` (a fraction of the routed mass, not of the x 1.5 weights),
+
+but never fewer than ``MIN_K`` slots. If every slot is kept the row is untouched (bit for bit the router's).
+Otherwise the kept weights are either left at their router values (``TF_DSV41_EXPERT_RENORM=orig``, the default:
+normalized by the ORIGINAL top-6 mass, so the output shrinks by the dropped mass instead of inflating the survivors;
+Training-Free Halving, arXiv 2609.04575: top-8 -> 4 costs 0.35 MMLU this way vs 4.65 rescaled) or renormalized the
+router's way (``kept``: w_i' = 1.5 (w_i / sum_kept w), the sum in slot order), and a dropped slot gets weight 0 and an id that groups to nothing:
+
+- decode / verify windows and exact prefill (``experts.routed``): the table size ``ex.count`` (past the shared
+  expert). Upstream's ``group`` kernel counts only ids < E, so the expert is never a group member: no trellis read by
+  ``grouped_kernel`` / x3ld / x3pf (their grids exit at ``u >= ucount``), no rot_in / epilogue program for the pair.
+  ``down_combine`` then adds 0 x the pair's stale ``y`` (the scratch's own buffer, finite values only: upstream's
+  prefill_moe already relies on this for its masked shared slot);
+- fast prefill (``prefill_moe``: x3gm / x3tc read ``suh`` at the pick unguarded and alias ``y`` into raw scratch):
+  ``dup``: the row's top kept expert, weight 0. That expert is read for the row anyway, so no byte is added; its
+  extra member row is compute only and contributes exactly 0.
+
+The shared expert's slot (after the K routed slots) is never touched. Row-invariant: a row's kept set and weights
+are a function of its own (pick, wts) only, in fixed sequential order (no reduction tree across rows or slots), so
+batched == alone, drafted == serial and decode rows == exact-prefill rows (when both prune) hold as before.
+
+Knobs (read at import; a bad value refuses to start):
+
+``TF_DSV41_EXPERT_MIN_W``          fraction floor of the target's routed experts (default off; e.g. 0.08)
+``TF_DSV41_EXPERT_TOPP``           cumulative mass of the target's routed experts (default off; e.g. 0.9)
+``TF_DSV41_EXPERT_MIN_K``          never fewer routed experts than this (default 3)
+``TF_DSV41_EXPERT_RENORM``         orig (default) | kept: how kept weights are normalized (target and DSpark)
+``TF_DSV41_EXPERT_PRUNE_PREFILL``  1: prompt rows prune too (default 0: prompts keep all 6; ``gate.py``'s
+                                   teacher-forced top-1 runs prompts, so the quality sweep sets it to 1)
+``TF_DSV41_DRAFT_EXPERT_MIN_W`` / ``_TOPP`` / ``_MIN_K``   DSpark's blocks (128 experts, top-3; MIN_K default 2):
+                                   drafts never change outputs, only acceptance
+
+The step costs one launch a layer (one program a 16 rows; ~3 us) and is skipped entirely when its rule is off.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+ENV_MIN_W, ENV_TOPP, ENV_MIN_K = "TF_DSV41_EXPERT_MIN_W", "TF_DSV41_EXPERT_TOPP", "TF_DSV41_EXPERT_MIN_K"
+ENV_PREFILL = "TF_DSV41_EXPERT_PRUNE_PREFILL"
+DRAFT = "TF_DSV41_DRAFT_EXPERT_"
+OFF = ("", "0", "false", "no", "off")
+BR = 16                     # rows a program
+KP = 8                      # routed slots padded (top-k <= 8)
+TOPP_OFF = 2.0
+RENORMS = ("orig", "kept")              # an exclusive prefix mass is never >= 2
+
+
+@dataclass(frozen=True)
+class Rule:
+    min_w: float = 0.0      # 0: off
+    topp: float = 0.0       # 0 or >= 1: off
+    min_k: int = 3
+    renorm: str = "orig"    # orig: kept weights keep their top-6 values (x 1.5 of the full top-6 mass) | kept
+
+    @property
+    def on(self) -> bool:
+        return self.min_w > 0.0 or 0.0 < self.topp < 1.0
+
+    def describe(self) -> str:
+        if not self.on:
+            return "off"
+        parts = ([f"min_w {self.min_w:g}"] if self.min_w > 0 else []) + (
+            [f"topp {self.topp:g}"] if 0 < self.topp < 1 else [])
+        return ", ".join(parts) + f", min_k {self.min_k}, renorm {self.renorm}"
+
+
+def _float(env, name: str) -> float:
+    raw = env.get(name, "").strip().lower()
+    if raw in OFF:
+        return 0.0
+    try:
+        v = float(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: a number in [0, 1]") from None
+    if not 0.0 <= v <= 1.0:
+        raise ValueError(f"{name}={raw!r}: a number in [0, 1]")
+    return v
+
+
+def _rule(env, prefix: str, min_k: int) -> Rule:
+    raw = env.get(prefix + "MIN_K", "").strip()
+    k = int(raw) if raw else min_k
+    if not 1 <= k <= KP:
+        raise ValueError(f"{prefix}MIN_K={raw!r}: 1..{KP}")
+    rn = env.get("TF_DSV41_EXPERT_RENORM", "").strip().lower() or "orig"
+    if rn not in RENORMS:
+        raise ValueError(f"TF_DSV41_EXPERT_RENORM={rn!r}: one of {RENORMS}")
+    return Rule(_float(env, prefix + "MIN_W"), _float(env, prefix + "TOPP"), k, rn)
+
+
+def parse(env: dict | None = None) -> dict:
+    env = os.environ if env is None else env
+    return {"target": _rule(env, "TF_DSV41_EXPERT_", 3), "draft": _rule(env, DRAFT, 2),
+            "prefill": env.get(ENV_PREFILL, "0").strip().lower() not in OFF}
+
+
+CFG = parse()
+_TL = threading.local()
+
+
+@contextmanager
+def phase(prefill: bool):
+    """The forward's prompt rows (``Forward.run(prefill=True)``, CED's replay) vs decode / verify windows."""
+
+    old = getattr(_TL, "prefill", False)
+    _TL.prefill = bool(prefill)
+    try:
+        yield
+    finally:
+        _TL.prefill = old
+
+
+def in_prefill() -> bool:
+    return getattr(_TL, "prefill", False)
+
+
+def rule_for(moe, cfg: dict | None = None, prefill: bool | None = None) -> Rule | None:
+    """The rule a MoE block's call uses now, or None (off): DSpark's blocks (fewer experts than the target's) take
+    the draft rule in any phase; the target's prompt rows prune only with ``TF_DSV41_EXPERT_PRUNE_PREFILL``."""
+
+    from . import experts as X
+
+    cfg = CFG if cfg is None else cfg
+    if moe.gate.shape[0] != X.EXPERTS:
+        r = cfg["draft"]
+    else:
+        prefill = in_prefill() if prefill is None else prefill
+        r = cfg["target"] if (cfg["prefill"] or not prefill) else None
+    return r if r is not None and r.on and r.min_k < moe.topk else None
+
+
+# -- the rule ------------------------------------------------------------------------------------------------------
+def reference(pick: torch.Tensor, wts: torch.Tensor, topk: int, rule: Rule, scale: float, drop: int,
+              dup: bool = False) -> tuple[torch.Tensor, torch.Tensor]:
+    """The kernel's arithmetic in torch fp32, step for step (sequential sums, IEEE divisions): new (pick, wts), the
+    shared slots copied. CPU forward and tests."""
+
+    pick, wts = pick.clone(), wts.clone()
+    K = int(topk)
+    w = wts[:, :K].to(torch.float32)
+    R = w.shape[0]
+    total = torch.zeros(R, dtype=torch.float32)
+    for i in range(K):
+        total = total + w[:, i]
+    f = w / total[:, None]
+    j = torch.arange(K)
+    gt = (f[:, None, :] > f[:, :, None]) | ((f[:, None, :] == f[:, :, None]) & (j[None, None, :] < j[None, :, None]))
+    rank = gt.sum(-1)                                           # [R, K]: slots ahead of slot i
+    excl = torch.zeros_like(f)
+    acc = torch.zeros(R, dtype=torch.float32)
+    for r in range(K):
+        at = rank == r
+        excl = torch.where(at, acc[:, None], excl)
+        acc = acc + (f * at).sum(-1)                            # one nonzero term: exact
+    topp = rule.topp if 0.0 < rule.topp < 1.0 else TOPP_OFF
+    keep = ((excl < topp) & (f >= rule.min_w)) | (rank < rule.min_k)
+    part = ~keep.all(-1)
+    ks = torch.zeros(R, dtype=torch.float32)
+    for i in range(K):
+        ks = ks + torch.where(keep[:, i], w[:, i], torch.zeros_like(ks))
+    if rule.renorm == "kept":
+        nw = torch.where(keep, torch.tensor(scale, dtype=torch.float32) * (w / ks[:, None]), torch.zeros_like(w))
+    else:                                                       # orig: the router's own weights, dropped ones 0
+        nw = torch.where(keep, w, torch.zeros_like(w))
+    top = (pick[:, :K] * (rank == 0)).sum(-1, keepdim=True).to(pick.dtype)
+    fill = top.expand(R, K) if dup else torch.full_like(pick[:, :K], drop)
+    np_ = torch.where(keep, pick[:, :K], fill)
+    pick[part, :K] = np_[part].to(pick.dtype)
+    wts[part, :K] = nw[part].to(wts.dtype)
+    return pick, wts
+
+
+@triton.jit
+def _col(t, j, i):
+    return tl.sum(tl.where(j[None, :] == i, t, 0), 1)
+
+
+@triton.jit
+def _prune(PICK, WTS, R, stride, MIN_W, TOPP, SCALE, DROP, MIN_K, K: tl.constexpr, KP: tl.constexpr,
+           DUP: tl.constexpr, BR: tl.constexpr, ORIG: tl.constexpr):
+    """Program (a block of BR rows): ``reference``'s steps on the K routed slots of each row, in place."""
+
+    rows = tl.program_id(0) * BR + tl.arange(0, BR)
+    rok = rows < R
+    j = tl.arange(0, KP)
+    jok = j < K
+    m = rok[:, None] & jok[None, :]
+    off = rows[:, None].to(tl.int64) * stride + j[None, :]
+    w = tl.load(WTS + off, mask=m, other=0.0)
+    p = tl.load(PICK + off, mask=m, other=0)
+    total = tl.zeros((BR,), tl.float32)
+    for i in tl.static_range(K):
+        total = total + _col(w, j, i)
+    f = tl.math.div_rn(w, total[:, None])
+    rank = tl.zeros((BR, KP), tl.int32)
+    for i in tl.static_range(K):
+        fi = _col(f, j, i)
+        ahead = jok[None, :] & ((f > fi[:, None]) | ((f == fi[:, None]) & (j[None, :] < i)))
+        rank = tl.where(j[None, :] == i, tl.sum(ahead.to(tl.int32), 1)[:, None], rank)
+    excl = tl.zeros((BR, KP), tl.float32)
+    acc = tl.zeros((BR,), tl.float32)
+    for r in tl.static_range(K):
+        at = (rank == r) & jok[None, :]
+        excl = tl.where(at, acc[:, None], excl)
+        acc = acc + tl.sum(tl.where(at, f, 0.0), 1)
+    keep = ((excl < TOPP) & (f >= MIN_W)) | (rank < MIN_K)
+    keep = keep & jok[None, :]
+    part = tl.sum(keep.to(tl.int32), 1) < K
+    ks = tl.zeros((BR,), tl.float32)
+    for i in tl.static_range(K):
+        ks = ks + _col(tl.where(keep, w, 0.0), j, i)
+    if ORIG:
+        nw = tl.where(keep, w, 0.0)
+    else:
+        nw = tl.where(keep, SCALE * tl.math.div_rn(w, ks[:, None]), 0.0)
+    if DUP:
+        top = tl.sum(tl.where((rank == 0) & jok[None, :], p, 0), 1)
+        fill = top[:, None] + tl.zeros((BR, KP), tl.int32)
+    else:
+        fill = tl.zeros((BR, KP), tl.int32) + DROP
+    np_ = tl.where(keep, p, fill)
+    sm = m & part[:, None]
+    tl.store(WTS + off, nw, mask=sm)
+    tl.store(PICK + off, np_, mask=sm)
+
+
+def apply(pick: torch.Tensor, wts: torch.Tensor, topk: int, rule: Rule, scale: float, drop: int,
+          dup: bool = False) -> tuple[torch.Tensor, torch.Tensor]:
+    """Prune (pick int32 [R, slots], wts fp32 [R, slots]) in place (one launch; graph-safe) and return them. CPU
+    tensors run ``reference`` (copied back in place)."""
+
+    R = pick.shape[0]
+    if R == 0 or not rule.on or rule.min_k >= topk:
+        return pick, wts
+    if topk > KP or pick.stride(1) != 1 or wts.stride(1) != 1 or pick.stride(0) != wts.stride(0):
+        raise ValueError(f"prune: top-k <= {KP}, unit-stride rows of one stride")
+    if wts.dtype != torch.float32 or pick.dtype != torch.int32:
+        raise ValueError("prune: wts fp32, pick int32 (before kit_weights)")
+    topp = rule.topp if 0.0 < rule.topp < 1.0 else TOPP_OFF
+    if not pick.is_cuda and os.environ.get("TRITON_INTERPRET") != "1":
+        p2, w2 = reference(pick, wts, topk, rule, scale, drop, dup)
+        pick.copy_(p2)
+        wts.copy_(w2)
+        return pick, wts
+    _prune[(triton.cdiv(R, BR),)](pick, wts, R, pick.stride(0), float(rule.min_w), float(topp), float(scale),
+                                  int(drop), int(rule.min_k), K=int(topk), KP=KP, DUP=bool(dup), BR=BR,
+                                  ORIG=rule.renorm != "kept", num_warps=1)
+    return pick, wts
+
+
+def kept(pick: torch.Tensor, topk: int, drop: int) -> torch.Tensor:
+    """Routed experts each row keeps (``drop`` ids and duplicates of an earlier slot do not count)."""
+
+    p = pick[:, :topk].long()
+    dupe = torch.zeros_like(p, dtype=torch.bool)
+    for i in range(1, topk):
+        dupe[:, i] = (p[:, :i] == p[:, i:i + 1]).any(-1)
+    return ((p != drop) & ~dupe).sum(-1)
+
+
+def describe(cfg: dict | None = None) -> str:
+    cfg = CFG if cfg is None else cfg
+    return (f"expert prune: target {cfg['target'].describe()} (prompts {'on' if cfg['prefill'] else 'off'}), "
+            f"draft {cfg['draft'].describe()}")
+
+
+__all__ = ["CFG", "Rule", "apply", "describe", "in_prefill", "kept", "parse", "phase", "reference", "rule_for"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/replay.py b/src/tensorfold/families/deepseek_v41/cuda/replay.py
new file mode 100644
index 0000000..4e8a98e
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/replay.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CED bounded replay prefill (``TF_DSV41_PREFILL=replay``, docs/ENGINE-PLAN.md section 8): the design's prefill.
+
+A prompt of n tokens (prefilled over [0, n - 1); its last token is the first verify row):
+
+- **encoder pass** (``encode``): every prefill segment runs the encoder layers (0 .. D - 1, D = the decoder's first
+  layer: 20) and, of layer D, only its attention site and its compressor: layer D's projection of H_19 is the whole
+  decoder's global KV and index keys (layers D .. 39 read kv source D), stored for every prompt position. Layers
+  D .. 39 do not run, so a prompt row costs about half a full row;
+- **stash**: the rows entering layer D (the streams after layer D - 1, layer D's site coefficients and normed input)
+  of a slot's last ``REPLAY - 1`` positions, kept across segments and rounds (and in prompt snapshots);
+- **decoder replay** (``finish``, ``Forward.finish_prompt``): layers D .. 39 over the prompt's last
+  min(n, 128) - 1 rows [R0, n - 1) from the stash, every row's SWA window starting at R0 (``csa2.attn``'s ``lo``);
+  layer D's compressor is skipped (the encoder pass stored those rows). The DSpark taps of those rows feed the
+  drafter. The last token then runs as a full 40-layer verify row (window [R0, n - 1]), and so does every reply row.
+
+Exactness rules (ENGINE-PLAN section 8; ``sessions`` / ``rounds``):
+
+1. approximate by design against ``full`` (the model was trained for it): its own session tag (Tag.ced);
+2. always replay: every prompt rebuilds the decoder state from its own tail, so the decode start state is a
+   function of the token sequence alone: resumed == fresh (prompt snapshots carry the encoder rings, carries,
+   lookback and the stash; no turn snapshots in replay mode: a turn's end has decoder rows a fresh prompt would
+   replay differently), batched == alone (row-invariant kernels, one replay a slot), drafted == serial (decode rows
+   are full rows);
+3. the encoder state is exact (the full forward's for those layers);
+4. every prefill replays, whatever its size; for n <= 128 replay equals ``full`` bit for bit (R0 = 0: the decoder
+   sees every row with untruncated windows) -- ``tests/test_dsv41_replay.py``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+
+from . import blocks as B
+from .forward import Seg, Streams
+
+REPLAY = 128                    # protocol.REPLAY: the decoder's rows over a prompt's end, its last token included
+KEEP = REPLAY - 1               # stash rows a slot keeps (the prefilled part of the tail)
+
+
+def decoder_start(cfg) -> int:
+    """The decoder's first layer: the first ratio-1 layer (20); it must be a kv source (its compressor is the
+    decoder's global KV)."""
+
+    d = min((i for i in range(cfg.num_hidden_layers) if cfg.compress_ratio(i) == 1), default=cfg.num_hidden_layers)
+    if d < cfg.num_hidden_layers and not cfg.is_kv_source(d):
+        raise ValueError(f"CED: the decoder's first layer {d} is not a kv source")
+    return d
+
+
+@dataclass
+class Stash:
+    """A slot's rows entering the decoder for positions [lo, lo + len): streams [m, 4 D] bf16, normed input [m, D]
+    bf16, layer D's site coefficients (pre / post [m, 4], comb [m, 16] fp32), the token ids."""
+
+    lo: int
+    x: torch.Tensor
+    out: torch.Tensor
+    pre: torch.Tensor
+    post: torch.Tensor
+    comb: torch.Tensor
+    ids: list
+
+    @property
+    def hi(self) -> int:
+        return self.lo + len(self.ids)
+
+    def extend(self, other: "Stash") -> "Stash":
+        """This stash followed by ``other`` (which starts where this one ends), the last ``KEEP`` rows kept."""
+
+        if other.lo != self.hi:
+            raise RuntimeError(f"CED stash: rows at {other.lo} after rows ending at {self.hi}")
+        cut = max(0, len(self.ids) + len(other.ids) - KEEP)
+        cat = (lambda a, b: torch.cat([a, b])[cut:].contiguous())                        # noqa: E731
+        return Stash(self.lo + cut, cat(self.x, other.x), cat(self.out, other.out), cat(self.pre, other.pre),
+                     cat(self.post, other.post), cat(self.comb, other.comb), (self.ids + other.ids)[cut:])
+
+    def rows(self, a: int, b: int) -> "Stash":
+        i, j = a - self.lo, b - self.lo
+        return Stash(a, self.x[i:j], self.out[i:j], self.pre[i:j], self.post[i:j], self.comb[i:j], self.ids[i:j])
+
+    # -- snapshots -----------------------------------------------------------------------------------------------
+    def arrays(self) -> dict[str, np.ndarray]:
+        f = (lambda t: t.view(torch.int16).cpu().numpy() if t.dtype == torch.bfloat16 else t.cpu().numpy())  # noqa
+        return {"ced_lo": np.asarray([self.lo], dtype=np.int64), "ced_ids": np.asarray(self.ids, dtype=np.int64),
+                "ced_x": f(self.x), "ced_out": f(self.out), "ced_pre": f(self.pre), "ced_post": f(self.post),
+                "ced_comb": f(self.comb)}
+
+    @classmethod
+    def from_arrays(cls, a: dict, device, act: torch.dtype) -> "Stash | None":
+        if "ced_lo" not in a:
+            return None
+
+        def t(name, dtype=None):
+            v = torch.from_numpy(np.ascontiguousarray(a[name]))
+            if dtype == torch.bfloat16 and v.dtype == torch.int16:
+                v = v.view(torch.bfloat16)
+            return v.to(device)
+
+        return cls(int(a["ced_lo"][0]), t("ced_x", torch.bfloat16).to(act), t("ced_out", torch.bfloat16).to(act),
+                   t("ced_pre"), t("ced_post"), t("ced_comb"), [int(v) for v in a["ced_ids"].tolist()])
+
+
+def empty(fw, pos: int) -> Stash:
+    from . import numerics as N
+
+    D, dev, act = fw.cfg.hidden_size, fw.device, N.ACT
+    z = (lambda *s, dt=torch.float32: torch.zeros(s, dtype=dt, device=dev))             # noqa: E731
+    return Stash(pos, z(0, fw.cfg.hc_mult * D, dt=act), z(0, D, dt=act), z(0, 4), z(0, 4), z(0, 16), [])
+
+
+def encode(fw, runs) -> None:
+    """The encoder pass over a round's prefill runs (``slots.prefill_runs``), every segment kept; each slot's stash
+    gets the segment's rows entering the decoder."""
+
+    d = decoder_start(fw.cfg)
+    for run in runs:
+        segs = [Seg(*sg) for sg in run]
+        st = fw.run(segs, logits=False, prefill=True, upto=d)
+        coefs = st.coefs[st.cur]                    # layer D's site coefficients (its attention post's)
+        a = 0
+        for sg in segs:
+            n = len(sg.ids)
+            got = Stash(sg.start, st.x[a:a + n], st.out[a:a + n], coefs.pre[a:a + n], coefs.post[a:a + n],
+                        coefs.comb[a:a + n], list(sg.ids))
+            have = fw.stash.get(sg.slot)
+            if have is None or have.hi != sg.start:
+                have = empty(fw, sg.start)
+            fw.stash[sg.slot] = have.extend(got)
+            fw.keep(sg.slot, n - 1)
+            a += n
+
+
+def finish(fw, slot: int, end: int, tail) -> dict:
+    """The decoder replay over the prompt's prefilled tail [end - len(tail), end); returns its DSpark taps."""
+
+    m = len(tail)
+    if m == 0:
+        return {}
+    r0 = end - m
+    sh = fw.stash.get(slot)
+    if sh is None or sh.hi != end or sh.lo > r0:
+        have = "none" if sh is None else f"[{sh.lo}, {sh.hi})"
+        raise RuntimeError(f"slot {slot}: CED replay of [{r0}, {end}) but the stash holds {have}")
+    rows = sh.rows(r0, end)
+    if rows.ids != [int(t) for t in tail]:
+        raise RuntimeError(f"slot {slot}: the CED stash's ids differ from the prompt's tail")
+    cfg, ops, dev = fw.cfg, fw.hc, fw.device
+    st = Streams(rows.x.clone(), rows.out.clone(), ops.Scratch(m, dev, cfg.hidden_size),
+                 [ops.Coefs(m, dev, pre=rows.pre.clone(), post=rows.post.clone(), comb=rows.comb.clone()),
+                  ops.Coefs(m, dev)])
+    from .csa2.backend import Win
+
+    win = Win.make(r0, m, dev)
+    ctx = B.Context(win, fw.tables, fw.csa2, fw.ring, fw.slots[slot], 0, fw.staging(m))
+    ctx.lo = torch.full((m,), r0, dtype=torch.int32, device=dev)        # every window starts at R0
+    ctx.comp_done = True
+    d = decoder_start(cfg)
+    first = next(i for i, blk in enumerate(fw.blocks) if blk.index == d)
+    from . import prefill_mm as PM
+    from . import prune as PR
+
+    with PM.fast(fw.fast_prefill), PR.phase(True):
+        fw._layers(st, [ctx], None, first=first, entered=True)
+        fw._finish(st, logits=False)
+    taps = {L: t for L, t in st.taps.items()}
+    fw.slots[slot].taps = taps
+    return taps
+
+
+__all__ = ["KEEP", "REPLAY", "Stash", "decoder_start", "encode", "finish"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rmsnorm.py b/src/tensorfold/families/deepseek_v41/cuda/rmsnorm.py
new file mode 100644
index 0000000..fe455d6
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rmsnorm.py
@@ -0,0 +1,184 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``blocks.rms`` (the attention's q_norm / kv_norm, the drafter's norms) as one Triton launch in float64 (G7 decode).
+
+The torch form ``x.double(); x * rsqrt(x.square().mean(-1) + eps) * w.double()`` then ``.to(bf16)`` is 9 kernels a
+call on CUDA (widen x, pow, ``MeanOps<double>``, add, rsqrt, 2 muls, widen w, narrow): G4's nsys put ~87 such sets in
+a verify window, ~15-18 us each (~1.5 ms a window), every kernel launch-bound. Here one program a row does the same
+operations in the same precision:
+
+    ss  = sum_k x_k^2                 float64; a bf16 / fp16 value squared is exact in float64
+    r   = rsqrt(ss * (1 / K) + eps)    float64; torch's MeanOps projects with ``* (outputs / numel)`` = ``* fl(1 / K)``,
+                                       and its CUDA rsqrt is libdevice's ``__nv_rsqrt``, which this calls too
+    y   = (x * r) * w                  float64, the same two rounded products
+    out = bf16(fp32(y))                c10's double -> BFloat16 conversion goes through float: the same two roundings
+
+The one difference is the order of the float64 sum of squares: torch's reduction tree depends on the tensor's shape
+(rows included), this one on K alone (``BK`` lanes ascending, then ``tl.sum``'s fixed tree), so it is row-invariant
+by construction. The squares are exact and their sum is exact whenever a row's squares span less than ~2^37 (all
+but extreme rows); otherwise the two orders can differ in the last float64 bit, which moves the bf16 output only at
+a rounding tie within ~2^-44 of a value (``plain_fp64``'s argument). The interpreter tests find it bitwise.
+
+``TF_DSV41_RMS_TRITON`` (1 = on, the default; 0 = the torch form) selects it on CUDA; other devices keep torch.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+BK = 512
+LAUNCH = {"enable_fp_fusion": False}      # no FMA contraction: every product and sum rounded as torch rounds it
+
+_RSQRT = None
+if os.environ.get("TRITON_INTERPRET") != "1":   # libdevice's rsqrt (torch's CUDA rsqrt); the interpreter has none:
+    try:                                        # there 1 / sqrt, as torch's CPU form computes it
+        from triton.language.extra import libdevice as _ld
+
+        _RSQRT = _ld.rsqrt
+    except ImportError:                         # pragma: no cover - older Triton
+        _RSQRT = None
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_RMS_TRITON", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _rsqrt64(v):
+    return 1.0 / tl.sqrt(v)               # fp64: sqrt.rn.f64 and div.rn.f64, both correctly rounded
+
+
+_rsqrt = _RSQRT if _RSQRT is not None else _rsqrt64
+
+
+@triton.jit
+def _rms(X, x_rs, W, OUT, o_rs, K, inv_k, eps, BK: tl.constexpr, HAS_W: tl.constexpr, NARROW: tl.constexpr,
+         PDL: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, BK)
+    xr = X + r * x_rs
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        v = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += v * v
+    ss = tl.sum(acc, axis=0)
+    rn = _rsqrt(ss * inv_k + eps)
+    orow = OUT + r * o_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        y = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64) * rn
+        if HAS_W:
+            y = y * tl.load(W + c + k, mask=m, other=0.0).to(tl.float64)
+        if NARROW:
+            tl.store(orow + c + k, y.to(tl.float32).to(OUT.dtype.element_ty), mask=m)
+        else:
+            tl.store(orow + c + k, y.to(OUT.dtype.element_ty), mask=m)
+
+
+@triton.jit
+def _rms2(XA, xa_rs, WA, OA, oa_rs, KA, inv_ka, XB, xb_rs, WB, OB, ob_rs, KB, inv_kb, eps, BK: tl.constexpr,
+          NARROW: tl.constexpr, PDL: tl.constexpr = False):
+    """G9: two norms in one launch, program (row, which): ``_rms``'s program on (XA, WA, OA, KA) or (XB, ...)."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    if tl.program_id(1) == 0:
+        _rms_row(XA, xa_rs, WA, OA, oa_rs, KA, inv_ka, eps, BK, NARROW)
+    else:
+        _rms_row(XB, xb_rs, WB, OB, ob_rs, KB, inv_kb, eps, BK, NARROW)
+
+
+@triton.jit
+def _rms_row(X, x_rs, W, OUT, o_rs, K, inv_k, eps, BK: tl.constexpr, NARROW: tl.constexpr):
+    """``_rms``'s body with a weight (the same operations in the same order)."""
+
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, BK)
+    xr = X + r * x_rs
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        v = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += v * v
+    ss = tl.sum(acc, axis=0)
+    rn = _rsqrt(ss * inv_k + eps)
+    orow = OUT + r * o_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        y = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64) * rn
+        y = y * tl.load(W + c + k, mask=m, other=0.0).to(tl.float64)
+        if NARROW:
+            tl.store(orow + c + k, y.to(tl.float32).to(OUT.dtype.element_ty), mask=m)
+        else:
+            tl.store(orow + c + k, y.to(OUT.dtype.element_ty), mask=m)
+
+
+_IN = (torch.bfloat16, torch.float16, torch.float32)
+_OUT = (torch.bfloat16, torch.float16, torch.float32)
+
+
+def eligible(x: torch.Tensor, weight: torch.Tensor | None, dtype: torch.dtype) -> bool:
+    return (x.is_cuda and enabled() and x.dtype in _IN and dtype in _OUT and x.dim() >= 1 and x.shape[-1] > 0
+            and (weight is None or (weight.device == x.device and weight.dim() == 1
+                                    and weight.shape[0] == x.shape[-1] and weight.dtype in _IN + (torch.float64,))))
+
+
+def rms(x: torch.Tensor, weight: torch.Tensor | None, eps: float, dtype: torch.dtype) -> torch.Tensor:
+    """RMSNorm over the last dim in float64, rounded to ``dtype`` through fp32 (as torch's double -> bf16 does)."""
+
+    K = x.shape[-1]
+    x2 = x.reshape(-1, K)
+    if x2.stride(-1) != 1:
+        x2 = x2.contiguous()
+    w = weight
+    if w is not None and w.stride(0) != 1:
+        w = w.contiguous()
+    out = torch.empty((x2.shape[0], K), dtype=dtype, device=x.device)
+    if x2.shape[0]:
+        _rms[(x2.shape[0],)](x2, x2.stride(0), w if w is not None else x2, out, out.stride(0), K, 1.0 / K,
+                             float(eps), BK=BK, HAS_W=w is not None, NARROW=dtype != torch.float32,
+                             num_warps=4, **LAUNCH, **P.triton_kw())
+    return out.view(*x.shape[:-1], K)
+
+
+def pair_enabled() -> bool:
+    """``TF_DSV41_RMS_PAIR`` (1, the default): the attention's q_norm and kv_norm in one launch (``rms_pair``)."""
+
+    return (os.environ.get("TF_DSV41_RMS_PAIR", "1").strip() or "1") != "0"
+
+
+def rms_pair(xa: torch.Tensor, wa: torch.Tensor, xb: torch.Tensor, wb: torch.Tensor, eps: float,
+             dtype: torch.dtype) -> tuple[torch.Tensor, torch.Tensor]:
+    """``(rms(xa, wa), rms(xb, wb))`` [n, K] each, the same rows, in one launch (G9: 80 ``_rms`` launches a 1-row window
+    were 0.39 ms, the kv_norm's ~3 us mostly launch and latency). Each program is ``_rms``'s: the same bits."""
+
+    def prep(x, w):
+        x2 = x.reshape(-1, x.shape[-1])
+        return (x2 if x2.stride(-1) == 1 else x2.contiguous()), (w if w.stride(0) == 1 else w.contiguous())
+
+    (a, wa), (b, wb) = prep(xa, wa), prep(xb, wb)
+    if a.shape[0] != b.shape[0]:
+        raise ValueError("rms_pair: the same rows")
+    ka, kb = a.shape[1], b.shape[1]
+    oa = torch.empty((a.shape[0], ka), dtype=dtype, device=a.device)
+    ob = torch.empty((b.shape[0], kb), dtype=dtype, device=b.device)
+    if a.shape[0]:
+        _rms2[(a.shape[0], 2)](a, a.stride(0), wa, oa, oa.stride(0), ka, 1.0 / ka, b, b.stride(0), wb, ob,
+                               ob.stride(0), kb, 1.0 / kb, float(eps), BK=BK, NARROW=dtype != torch.float32,
+                               num_warps=4, **LAUNCH, **P.triton_kw())
+    return oa.view(*xa.shape[:-1], ka), ob.view(*xb.shape[:-1], kb)
+
+
+__all__ = ["BK", "eligible", "enabled", "pair_enabled", "rms", "rms_pair"]
