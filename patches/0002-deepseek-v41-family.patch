@@ -0,0 +1,315 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 prefill kernels in Triton's CPU interpreter (no GPU), with the ``gpu_like`` dot / cast model:
+
+- mHC: bf16 gathered partials (``TF_DSV41_PREFILL_GATHER=bf16``) == their fp32 widening, bit for bit; every
+  ``TF_DSV41_MHC_BM`` / warps tile == the 16-row tile, bit for bit (boundary, site, final, post_only);
+- RoPE in place (``TF_DSV41_ROPE_INPLACE``: ``rope_fused.apply_``) == ``apply``'s new tensor, bit for bit, and the
+  NoPE dims untouched;
+- the fused prefill attention (``TF_DSV41_PREFILL_ATTN=fused``: ``csa2.attn_pf``): against float64 (``csa2.ref``) as
+  close as the chunked kernels, and against the chunked kernels; SWA-only and bounded replay; row invariance (a row
+  alone == the same row in windows of other sizes, BMQ 16 and 32), paged == contiguous.
+
+Run: python -m pytest -q tests/test_dsv41_prefill2_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+triton = pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import mhc, rope_fused  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn, attn_pf, ref  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import rows as RW  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(mhc._site).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+# -- mHC -------------------------------------------------------------------------------------------------------------
+def _mhc_case(R: int, d: int, world: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, d), generator=g) * 0.7).to(torch.bfloat16).float()   # kit-rounded partials
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, "cpu", pre=torch.rand((R, 4), generator=g) + 0.1, post=torch.rand((R, 4), generator=g) * 2,
+                     comb=comb)
+    hc = mhc.Hc(torch.randn((24, 4 * d), generator=g) * 0.01, torch.randn(24, generator=g) * 0.5,
+                torch.rand(3, generator=g) + 0.5)
+    nw = (torch.rand(d, generator=g) + 0.5).to(torch.bfloat16)
+    return x, gathered, prev, hc, nw
+
+
+def _mhc_all(x, gathered, prev, hc, nw):
+    """boundary (with taps), site (pre-mix carried), final, post_only: every output."""
+
+    R, d = gathered.shape[1], gathered.shape[2]
+    out = {}
+    xo = torch.zeros_like(x)
+    o = torch.zeros((R, d), dtype=torch.bfloat16)
+    co = mhc.Coefs(R, "cpu")
+    sc = mhc.Scratch(R, "cpu", d)
+    tp = torch.zeros((R, d), dtype=torch.bfloat16)
+    mhc.boundary(x, xo, gathered, prev, hc, nw, o, co, sc, tap=tp)
+    out.update(bx=xo, bo=o, bpre=co.pre, bpost=co.post, bcomb=co.comb, bc=sc.c[:R].clone(), btap=tp)
+    o2 = torch.zeros((R, d), dtype=torch.bfloat16)
+    co2 = mhc.Coefs(R, "cpu")
+    sc2 = mhc.Scratch(R, "cpu", d)
+    mhc.site(x, hc, nw, o2, co2, sc2, pre_in=prev.pre)
+    out.update(so=o2, spre=co2.pre, scomb=co2.comb)
+    xf = torch.zeros_like(x)
+    o3 = torch.zeros((R, d), dtype=torch.bfloat16)
+    sc3 = mhc.Scratch(R, "cpu", d)
+    mhc.final(x, xf, gathered, prev, nw, o3, sc3)
+    out.update(fx=xf, fo=o3, fc=sc3.c[:R].clone())
+    xp = x.clone()
+    mhc.post_only(xp, xp, gathered, prev)
+    out.update(px=xp)
+    return out
+
+
+def test_mhc_bf16_gathered_equals_fp32():
+    x, gathered, prev, hc, nw = _mhc_case(5, 1280, 2, 3)
+    want = _mhc_all(x, gathered, prev, hc, nw)
+    got = _mhc_all(x, gathered.to(torch.bfloat16), prev, hc, nw)
+    for k in want:
+        assert torch.equal(_bits(got[k]), _bits(want[k])), k
+
+
+@pytest.mark.parametrize("bm,warps", [(32, 8), (64, 8), (32, 4)])
+def test_mhc_row_tile_does_not_change_a_bit(monkeypatch, bm, warps):
+    R = 70                                              # several tiles of every size, a ragged last one
+    x, gathered, prev, hc, nw = _mhc_case(R, 1280, 2, 4)
+    monkeypatch.setenv("TF_DSV41_MHC_ROWS", "1")
+    want = _mhc_all(x, gathered, prev, hc, nw)          # BM 16 (the default)
+    assert mhc.tile(R) == (16, 8)
+    monkeypatch.setenv("TF_DSV41_MHC_BM", str(bm))
+    monkeypatch.setenv("TF_DSV41_MHC_WARPS", str(warps))
+    assert mhc.tile(R) == (bm, warps)
+    got = _mhc_all(x, gathered, prev, hc, nw)
+    for k in want:
+        assert torch.equal(_bits(got[k]), _bits(want[k])), k
+
+
+def test_mhc_tile_knobs(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_MHC_BM", "32")
+    assert mhc.tile(128) == (16, 8) and mhc.tile(2048) == (32, 8)       # verify windows keep the 16-row tile
+    monkeypatch.setenv("TF_DSV41_MHC_BM", "48")
+    with pytest.raises(ValueError):
+        mhc.tile(2048)
+
+
+# -- RoPE in place ---------------------------------------------------------------------------------------------------
+def _cs(n: int) -> torch.Tensor:
+    inv = 160000.0 ** (-torch.arange(0, 64, 2, dtype=torch.float64) / 64)
+    ang = torch.arange(n, dtype=torch.float64)[:, None] * inv[None, :]
+    return torch.cat([ang.cos(), ang.sin()], 1).float().contiguous()
+
+
+@pytest.mark.parametrize("dh", [512, 128])
+def test_rope_in_place_equals_new_tensor(dh):
+    g = torch.Generator().manual_seed(9)
+    T, H = 7, 8
+    x = (torch.randn((T, H, dh), generator=g) * 3).to(torch.bfloat16)
+    cs = _cs(300)
+    pos = torch.arange(200, 200 + T)
+    want = rope_fused.apply(x.float(), cs, pos, 64)     # the old call: a widened copy in, a new bf16 tensor out
+    y = x.clone()
+    got = rope_fused.apply_(y, cs, pos, 64)
+    assert got.data_ptr() == y.data_ptr()
+    assert torch.equal(_bits(got), _bits(want))
+    assert torch.equal(_bits(got[..., :dh - 64]), _bits(x[..., :dh - 64]))
+
+
+# -- the fused prefill attention -------------------------------------------------------------------------------------
+def _attn_case(R: int, P: int, ncomp: int, seed: int, ring: int = 256):
+    g = torch.Generator().manual_seed(seed)
+    q = (torch.randn((R, 32, 512), generator=g) * 0.5).to(torch.bfloat16).contiguous()
+    cv, csc = ref.quantize_rows(torch.randn((ncomp, 512), generator=g) * 2)
+    sv = torch.zeros((ring, RW.VB), dtype=torch.uint8)
+    ssc = torch.zeros((ring, RW.SB), dtype=torch.uint8)
+    swa = {}
+    for p in range(max(0, P - 140), P + R):
+        v, s = ref.quantize_rows(torch.randn((1, 512), generator=g) * 2)
+        sv[p % ring], ssc[p % ring] = v[0], s[0]
+        swa[p] = ref.dequantize_rows(v, s)[0]
+    sink = torch.randn(32, generator=g) * 2
+    return q, (cv, csc), (sv, ssc), swa, sink, _cs(P + R + 8)
+
+
+def _lists(R: int, ncomp: int, seed: int, sizes=None):
+    g = torch.Generator().manual_seed(seed)
+    tok = torch.full((R, 512), -1, dtype=torch.int32)
+    cnt = torch.zeros(R, dtype=torch.int32)
+    lists = []
+    for r in range(R):
+        k = sizes[r] if sizes else int(torch.randint(1, 512, (1,), generator=g))
+        sel = sorted(torch.randperm(ncomp, generator=g)[:k].tolist())
+        tok[r, :len(sel)] = torch.tensor(sel, dtype=torch.int32)
+        cnt[r] = len(sel)
+        lists.append(sel)
+    return tok, cnt, lists
+
+
+def _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs, *, ring=256, pg=None):
+    out = torch.zeros((q.shape[0], 32, 512), dtype=torch.bfloat16)
+    return attn_pf.attention(q, comp, tok, cnt, swa_t, lo, torch.tensor([P], dtype=torch.int32), sink, cs, out,
+                             ring=ring, **(pg or {}))
+
+
+def _chunks(q, comp, tok, cnt, swa_t, lo, P, sink, cs, *, ring=256):
+    out = torch.zeros((q.shape[0], 32, 512), dtype=torch.bfloat16)
+    attn.attention(q, comp, tok, cnt, swa_t, lo, torch.tensor([P], dtype=torch.int32), sink, cs, out,
+                   attn.Scratch(q.shape[0], "cpu"), ring=ring)
+    return out
+
+
+@pytest.mark.parametrize("bmq", [16, 32])
+def test_fused_attention_against_float64_and_chunks(monkeypatch, bmq):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    R, P, ncomp = 4, 900, 700
+    q, comp, swa_t, swa, sink, cs = _attn_case(R, P, ncomp, 1)
+    tok, cnt, lists = _lists(R, ncomp, 2, sizes=[512, 300, 1, 129])
+    lo = torch.zeros(R, dtype=torch.int32)
+    got = _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    want = ref.attention(q, ref.dequantize_rows(*comp), lists, swa, [0] * R, [P + r for r in range(R)],
+                         [P + r for r in range(R)], sink, cs)
+    torch.testing.assert_close(got.double(), want, rtol=2e-2, atol=5e-3)
+    old = _chunks(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    torch.testing.assert_close(got.float(), old.float(), rtol=2e-2, atol=4e-3)      # within a bf16 rounding or two
+    err_new = (got.double() - want).abs().max()
+    err_old = (old.double() - want).abs().max()
+    assert err_new <= 2 * err_old + 1e-3                # one softmax chain is no worse than five merged ones
+
+
+def test_fused_attention_swa_only_and_replay():
+    R, P = 5, 60
+    q, _, swa_t, swa, sink, cs = _attn_case(R, P, 1, 3)
+    lo = torch.tensor([0, 0, 40, 40, 61], dtype=torch.int32)
+    got = _fused(q, None, None, None, swa_t, lo, P, sink, cs)
+    want = ref.attention(q, None, [[]] * R, swa, lo.tolist(), [P + r for r in range(R)], [P + r for r in range(R)],
+                         sink, cs)
+    torch.testing.assert_close(got.double(), want, rtol=2e-2, atol=5e-3)
+
+
+@pytest.mark.parametrize("bmq", [16, 32])
+def test_fused_attention_row_invariance_and_paging(monkeypatch, bmq):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    R, P, ncomp = 6, 1000, 900
+    q, comp, swa_t, swa, sink, cs = _attn_case(R, P, ncomp, 5)
+    tok, cnt, _ = _lists(R, ncomp, 6)
+    lo = torch.zeros(R, dtype=torch.int32)
+    out = _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    for r in (0, 2, 5):
+        one = _fused(q[r:r + 1].contiguous(), comp, tok[r:r + 1].contiguous(), cnt[r:r + 1].contiguous(), swa_t,
+                     lo[r:r + 1].contiguous(), P + r, sink, cs)
+        assert torch.equal(_bits(one[0]), _bits(out[r]))
+    mid = _fused(q[1:4].contiguous(), comp, tok[1:4].contiguous(), cnt[1:4].contiguous(), swa_t,
+                 lo[1:4].contiguous(), P + 1, sink, cs)
+    assert torch.equal(_bits(mid), _bits(out[1:4]))
+    big = _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs, ring=512)            # a staging ring: the same rows
+    sv2 = torch.zeros((512, RW.VB), dtype=torch.uint8)
+    ss2 = torch.zeros((512, RW.SB), dtype=torch.uint8)
+    for p in range(max(0, P - 140), P + R):
+        sv2[p % 512], ss2[p % 512] = swa_t[0][p % 256], swa_t[1][p % 256]
+    big = _fused(q, comp, tok, cnt, (sv2, ss2), lo, P, sink, cs, ring=512)
+    assert torch.equal(_bits(big), _bits(out))
+    page = 64
+    n_log = triton.cdiv(ncomp, page)
+    pt = torch.randperm(n_log + 3, generator=torch.Generator().manual_seed(7))[:n_log].to(torch.int32).contiguous()
+    nphys = (n_log + 3) * page
+    pv = torch.full((nphys, RW.VB), 0x7F, dtype=torch.uint8)
+    ps = torch.full((nphys, RW.SB), 0xFF, dtype=torch.uint8)
+    for j in range(ncomp):
+        pv[int(pt[j // page]) * page + j % page] = comp[0][j]
+        ps[int(pt[j // page]) * page + j % page] = comp[1][j]
+    outp = _fused(q, (pv, ps), tok, cnt, swa_t, lo, P, sink, cs, pg=dict(page_table=pt, page_shift=6))
+    assert torch.equal(_bits(outp), _bits(out))
+
+
+def test_fused_attention_knobs_and_tag(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+    from tensorfold.families.deepseek_v41.cuda.csa2 import backend
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    monkeypatch.delenv("TF_DSV41_PREFILL_ATTN", raising=False)
+    assert attn_pf.variant() == 0 and PM.tag_grid() == 48
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    assert attn_pf.variant() == 1 and PM.tag_grid() == 49
+    assert not backend.fused_prefill()                  # only inside a fast prefill run
+    with PM.fast(True):
+        assert backend.fused_prefill()
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "exact")
+    assert PM.tag_grid() == 0
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "flash")
+    with pytest.raises(ValueError):
+        attn_pf.variant()
+
+
+# -- the fused attention in the forward (fast tag): chunked == unchunked ---------------------------------------------
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+
+
+def test_fused_attention_forward_chunked_equals_unchunked(tmp_path, monkeypatch):
+    """A fast-tag prompt with the fused prefill attention in one 20-row segment == in 8-row segments (the rows'
+    bits do not depend on the segment), then the same decode step; the fused kernel ran for every prefill segment
+    and never for the decode step."""
+
+    import json
+
+    import dsv41_fakes as FK
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    root = FK.write_checkpoint(tmp_path, **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    table = FK.engram_table(cfg)
+    ids = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(4)).tolist()
+    calls = []
+    real = attn_pf.attention
+
+    def spy(q, *a, **kw):
+        calls.append(q.shape[0])
+        return real(q, *a, **kw)
+
+    monkeypatch.setattr(attn_pf, "attention", spy)
+
+    def run(pchunk: int):
+        tmap = FK.token_map(cfg)
+        tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+        rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+        fw = FW.Forward(cfg, tree, csa2=Triton(8, cfg.num_attention_heads, "cpu"), limit=64, chunk=1, pchunk=pchunk,
+                        engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+        assert fw.fast_prefill
+        calls.clear()
+        last = fw.prompt(ids[:-1])
+        n_pf = len(calls)
+        step = fw.step([ids[-1]])
+        assert len(calls) == n_pf and n_pf > 0           # decode rows keep the chunk kernels
+        return torch.cat([last, step])
+
+    one = run(20)
+    assert not torch.isnan(one).any()
+    assert torch.equal(run(8), one)
