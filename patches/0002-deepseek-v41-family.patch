index 0000000..5fb0120
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/csa2/dtopk.py
@@ -0,0 +1,203 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Decode top-k for CSA2's indexer (``TF_DSV41_INDEX_DTOPK``, default 1): one Triton launch a selection instead of
+``index.sort_keys`` + ``index.top_positions`` (``_keys``, ``torch.topk``'s gatherTopK, ``torch.sort``'s
+radixSortKVInPlace and ~17 torch elementwise kernels) and ``backend.visible_counts`` (~8 more).
+
+One program a row reads the row's materialised fp32 scores, makes ``index``'s unique int64 key of every entry on the
+fly (``stream_topk.score_key``: the score's bits in two's-complement order, then 0x7FFFFFFF - position: score
+descending, then the lower position; a missing entry is KEY_NONE) and finds the K-th largest key of the row exactly
+by a most-significant-digit radix select over the keys' order-preserving uint64 image (``RB``-bit digits, a
+``tl.histogram`` a tile, one pass over the row a digit, stopping once the digit prefix holds exactly K keys). The
+selection is then {valid keys >= the K-th}: the top K keys (``torch.topk``'s set: keys are unique) or, when the row
+has fewer than K valid keys, all of them (``torch.topk`` then also returns KEY_NONE entries, which become -1).
+
+Output (``index.top_positions``' layout): the selected positions ascending, -1 padded to K, int32 [R, K]; and the
+row's visible count (``backend.visible_counts``: entries in [0, n(q))), int32 [R]. Positions in index order are
+ascending in the dense modes, so a compaction in scan order is sorted; the gather modes sort the K survivors
+(``tl.sort``) so the result does not depend on the order of the gathered positions.
+
+Modes (the materialised paths of ``backend.Triton``):
+
+- 0 ``select``: dense scores [R, n] (key i = position i; every entry valid, -inf scores included);
+- 1 ``gather``: scores over gathered positions ``P`` [R, n] (-1 = missing: KEY_NONE), ``index.reindex``'s keys;
+- 2 ``blocks``: layer 20's candidate blocks from its dense scores (``index._block_keys``: block max over its visible
+  members, the newest block pinned to +inf, blocks past the visible ones missing), K = 2,048;
+- 3 ``gather`` from candidate blocks: position i = cand[r, i // BS] * BS + i % BS (-1 for a missing block), the
+  positions ``index.candidate_keys`` would list, without materialising them.
+
+Rows are independent programs (a row's bits do not depend on the window), the launch has a fixed grid (R,) and no
+host sync or data-dependent allocation: CUDA-graph safe.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from .stream_topk import score_key
+
+RB = 8                  # radix digit bits (8 passes for 64-bit keys at most; 4 when the K-th score is unique)
+TILE = 4096             # entries a tile (modes 0 / 1 / 3; mode 2: TILE // BS blocks): a pass's loads in flight
+WARPS = 8               # TILE and WARPS only set the speed (the selection is exact whatever they are)
+MAX_ROWS = 64           # windows up to this many rows (the decode graphs' row buckets) take this path
+
+
+def enabled() -> bool:
+    """``TF_DSV41_INDEX_DTOPK`` (default 1): 0 keeps ``index.sort_keys`` + ``index.top_positions``."""
+
+    v = os.environ.get("TF_DSV41_INDEX_DTOPK", "1").strip() or "1"
+    if v not in ("0", "1"):
+        raise ValueError(f"TF_DSV41_INDEX_DTOPK={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+@triton.jit
+def _tile(S, s_stride, P, p_stride, r, t0, NK, nvis, MODE: tl.constexpr, T: tl.constexpr, BS: tl.constexpr):
+    """Tile [t0, t0 + T) of row r: (uint64 order image of the keys (0 = missing), valid, position, in range)."""
+
+    r64 = r.to(tl.int64)
+    if MODE == 2:
+        NBT: tl.constexpr = T // BS
+        b = t0 + tl.arange(0, NBT)
+        j = b[:, None] * BS + tl.arange(0, BS)[None, :]
+        v = tl.load(S + r64 * s_stride + j, mask=j < nvis, other=float("-inf"))
+        m = tl.max(v, 1)
+        m = tl.where(b == (nvis - 1) // BS, float("inf"), m)
+        inr = b < NK
+        valid = inr & (b * BS < nvis)
+        key = score_key(m, b)
+        p = b
+    else:
+        i = t0 + tl.arange(0, T)
+        inr = i < NK
+        s = tl.load(S + r64 * s_stride + i, mask=inr, other=float("-inf"))
+        if MODE == 1:
+            p = tl.load(P + r64 * p_stride + i, mask=inr, other=-1)
+        elif MODE == 3:
+            cb = tl.load(P + r64 * p_stride + i // BS, mask=inr, other=-1)
+            p = tl.where(cb >= 0, cb * BS + i % BS, -1)
+        else:
+            p = i
+        valid = inr & (p >= 0)
+        key = score_key(s, p)
+    u = key.to(tl.uint64, bitcast=True) ^ 0x8000000000000000
+    u = tl.where(valid, u, tl.zeros_like(u))
+    return u, valid, p.to(tl.int32), inr
+
+
+@triton.jit
+def _dtopk(S, s_stride, P, p_stride, POS, NK, OUT, o_stride, CNT, RATIO: tl.constexpr, K: tl.constexpr,
+           MODE: tl.constexpr, ROWS: tl.constexpr, T: tl.constexpr, BS: tl.constexpr, RB: tl.constexpr,
+           NPASS: tl.constexpr, SORT: tl.constexpr, COUNT: tl.constexpr, KP: tl.constexpr):
+    """Program r: OUT[r, :K] = the positions of the row's top-K keys ascending, -1 padded; CNT[r] = how many are
+    below n(q) (COUNT). ROWS: q = POS[r], else POS[0] + r."""
+
+    r = tl.program_id(0)
+    if ROWS:
+        q = tl.load(POS + r).to(tl.int32)
+    else:
+        q = tl.load(POS).to(tl.int32) + r
+    nvis = (q + 1) // RATIO
+    NB: tl.constexpr = 1 << RB
+    if MODE == 2:
+        STEP: tl.constexpr = T // BS
+    else:
+        STEP: tl.constexpr = T
+    idx = tl.arange(0, NB)
+    thr = tl.full((), 0, tl.uint64)
+    if NK > K:                                   # else every entry is in (the K-th key does not exist)
+        hmask = tl.full((), 0, tl.uint64)
+        above = tl.zeros((), tl.int32)           # keys above the current prefix's range
+        go = tl.full((), 1, tl.int32)
+        for t in range(NPASS):
+            if go != 0:
+                sh = tl.maximum(64 - RB * (t + 1), 0).to(tl.uint64)
+                hist = tl.zeros((NB,), tl.int32)
+                for t0 in range(0, NK, STEP):
+                    u, valid, p, inr = _tile(S, s_stride, P, p_stride, r, t0, NK, nvis, MODE, T, BS)
+                    d = ((u >> sh) & (NB - 1)).to(tl.int32)
+                    hist += tl.histogram(d, NB, mask=inr & ((u & hmask) == thr))
+                ge = tl.sum(hist, 0) - tl.cumsum(hist, 0) + hist        # entries with digit >= idx
+                dg = tl.max(tl.where(above + ge >= K, idx, -1), 0)
+                hd = tl.sum(tl.where(idx == dg, hist, 0), 0)
+                above += tl.sum(tl.where(idx == dg, ge, 0), 0) - hd
+                thr = thr | (dg.to(tl.uint64) << sh)
+                hmask = hmask | (tl.full((), NB - 1, tl.uint64) << sh)
+                if above + hd == K:              # the prefix's keys complete the top K exactly
+                    go = tl.zeros((), tl.int32)
+    orow = OUT + r.to(tl.int64) * o_stride
+    base = tl.zeros((), tl.int32)
+    nv = tl.zeros((), tl.int32)
+    for t0 in range(0, NK, STEP):
+        u, valid, p, inr = _tile(S, s_stride, P, p_stride, r, t0, NK, nvis, MODE, T, BS)
+        sel = valid & (u >= thr)
+        si = sel.to(tl.int32)
+        off = base + tl.cumsum(si, 0) - 1
+        tl.store(orow + off, p, mask=sel & (off < K))
+        base += tl.sum(si, 0)
+        nv += tl.sum((sel & (p < nvis)).to(tl.int32), 0)
+    kk = tl.arange(0, KP)
+    if SORT:
+        tl.debug_barrier()
+        v = tl.load(orow + kk, mask=kk < base, other=2147483647)
+        v = tl.sort(v, 0)
+        tl.debug_barrier()
+        tl.store(orow + kk, tl.where(v == 2147483647, -1, v), mask=kk < K)
+    else:
+        tl.store(orow + kk, tl.full((KP,), -1, tl.int32), mask=(kk >= base) & (kk < K))
+    if COUNT:
+        tl.store(CNT + r, nv)
+
+
+def _run(s: torch.Tensor, pos: torch.Tensor, ratio: int, k: int, mode: int, *, p: torch.Tensor | None = None,
+         block: int = 8, rows: bool = False, count: bool = True):
+    if s.dtype != torch.float32 or s.stride(1) != 1:
+        raise ValueError("dtopk: fp32 scores with unit-stride entries")
+    if k < 1:
+        raise ValueError("dtopk: k >= 1")
+    R, n = s.shape
+    nk = triton.cdiv(n, block) if mode == 2 else n
+    out = torch.empty((R, k), dtype=torch.int32, device=s.device)
+    cnt = torch.empty((R,), dtype=torch.int32, device=s.device) if count else out
+    pt = p if p is not None else s
+    _dtopk[(R,)](s, s.stride(0), pt, pt.stride(0) if p is not None else 0, pos, nk, out, out.stride(0), cnt,
+                 RATIO=ratio, K=k, MODE=mode, ROWS=rows, T=TILE, BS=block, RB=RB, NPASS=triton.cdiv(64, RB),
+                 SORT=mode in (1, 3), COUNT=count, KP=triton.next_power_of_2(k), num_warps=WARPS)
+    return out, (cnt if count else None)
+
+
+def select(s: torch.Tensor, pos: torch.Tensor, ratio: int, topk: int, *, rows: bool = False):
+    """Full mode from dense scores [R, n]: (``index.top_positions(index.sort_keys(s), topk)``, visible counts)."""
+
+    return _run(s, pos, ratio, topk, 0, rows=rows)
+
+
+def gather(s: torch.Tensor, keys: torch.Tensor, pos: torch.Tensor, ratio: int, topk: int, *, rows: bool = False):
+    """Reindex from scores over ``keys`` int32 [R, n] (-1 = none): (``top_positions(sort_keys(s, keys))``, counts)."""
+
+    if keys.dtype != torch.int32 or keys.stride(1) != 1:
+        raise ValueError("dtopk.gather: int32 positions with unit stride")
+    return _run(s, pos, ratio, topk, 1, p=keys, rows=rows)
+
+
+def gather_cand(s: torch.Tensor, cand: torch.Tensor, pos: torch.Tensor, ratio: int, topk: int, *, block: int = 8,
+                rows: bool = False):
+    """``gather`` over ``index.candidate_keys(cand, block)`` without materialising them (s: [R, cand cols x block])."""
+
+    if cand.dtype != torch.int32 or cand.stride(1) != 1 or s.shape[1] != cand.shape[1] * block:
+        raise ValueError("dtopk.gather_cand: int32 candidate blocks, scores [R, blocks x block]")
+    return _run(s, pos, ratio, topk, 3, p=cand, block=block, rows=rows)
+
+
+def blocks(s: torch.Tensor, pos: torch.Tensor, ratio: int, topk_blocks: int, *, block: int = 8,
+           rows: bool = False) -> torch.Tensor:
+    """Layer 20's candidate blocks from dense scores [R, n]: ``index.candidate_blocks``' result."""
+
+    return _run(s, pos, ratio, topk_blocks, 2, block=block, rows=rows, count=False)[0]
+
+
+__all__ = ["MAX_ROWS", "blocks", "enabled", "gather", "gather_cand", "select"]
