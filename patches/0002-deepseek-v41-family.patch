@@ -0,0 +1,196 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The torch twin of the CSA2 kernels: the same calls as ``backend.Triton`` for any head / index width (the kernels
+are built for 512 / 128), float64 sums rounded where the kernels round, one row at a time where it matters. The CPU
+forward runs it (tests on tiny configs); engine/reference's attention.py is the math it follows.
+
+Stores (``stores``): 512-wide rows are the kernels' FP8 records (``Records``, byte for byte the kernels' format, so a
+pool or a snapshot holds the same bytes on either path); other widths (tiny test configs) and ``numerics.exact``
+keep the dequantized values (``Floats``: the record's rounding for any width, none in exact numerics); index keys
+hold bf16 values (``Keys``).
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+from .. import numerics as N
+from . import fmt as RW
+from .stores import Floats, Keys, Records
+
+F32, F64, BF16 = torch.float32, torch.float64, torch.bfloat16
+FP8_MAX = 448.0
+
+
+def fp8_row(x: torch.Tensor, rope_dim: int, tile: int = 64) -> torch.Tensor:
+    """Rows [n, D] (RoPE applied, fp32) through the KV record: NoPE e4m3 with a UE8M0 scale a ``tile`` dims (one
+    tile when NoPE does not divide), RoPE dims bf16."""
+
+    if not N.QUANT:
+        return x.to(N.ACT).to(N.ACC)
+    nope = x.shape[-1] - rope_dim
+    tile = tile if nope % tile == 0 else nope
+    head = x[..., :nope].to(F32).reshape(*x.shape[:-1], nope // tile, tile)
+    amax = head.abs().amax(-1, keepdim=True).clamp(min=1e-4)
+    s = torch.exp2(torch.ceil(torch.log2(amax / FP8_MAX)))
+    q = (head / s).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn).to(F32) * s
+    return torch.cat([q.reshape(*x.shape[:-1], nope), x[..., nope:].to(BF16).to(F32)], -1)
+
+
+class Twin:
+    """CSA2 on torch tensors (any device); ``window`` is the SWA length (128 on the checkpoint)."""
+
+    name = "torch"
+
+    def __init__(self, rope_dim: int, window: int) -> None:
+        self.rope_dim, self.window = rope_dim, window
+
+    # -- stores ----------------------------------------------------------------------------------------------------
+    def rows(self, n: int, dim: int, device):
+        if dim == RW.D and N.QUANT:
+            return Records.new(n, device)
+        return Floats(torch.zeros((n, dim), dtype=N.ACC, device=device))
+
+    def keys(self, n: int, dim: int, device):
+        return Keys(torch.zeros((n, dim), dtype=N.ACC, device=device))
+
+    def read_rows(self, store, rows: torch.Tensor) -> torch.Tensor:
+        return store.read(rows)
+
+    # -- writers ---------------------------------------------------------------------------------------------------
+    def kv_store(self, lat, table, store, win, ratio: int, ring: int = 0) -> None:
+        """Window rows lat [n, D] (bf16 values) -> RoPE'd FP8 records: ratio 0 into ring slot q % ring; ratio r > 0,
+        where a group closes, into compressed row q // r with RoPE at the group's first position."""
+
+        q = win.positions.to(torch.long)
+        if ratio == 0:
+            keep = torch.ones_like(q, dtype=torch.bool)
+            at, dst = q, q % ring
+        else:
+            keep = (q + 1) % ratio == 0
+            at, dst = q // ratio * ratio, q // ratio
+        if not bool(keep.any()):
+            return
+        x = table.apply(lat[keep], at[keep])
+        store.write(dst[keep], x if isinstance(store, Records) else fp8_row(x, self.rope_dim))
+
+    def pool_norm(self, buf, weight, win, ratio: int, eps: float) -> torch.Tensor:
+        """buf fp32 [n + 1, 2 D] (ratio 2: the carry row first; [kv | score]) or [n, D] (ratio 1) -> latents bf16
+        [n, D] (rows where no group closes stay 0)."""
+
+        n = win.n
+        D = buf.shape[1] // ratio
+        out = torch.zeros((n, D), dtype=N.ACT, device=buf.device)
+        q = win.positions.to(torch.long)
+        if ratio == 1:
+            pooled = buf[:n].to(F64)
+            close = torch.ones(n, dtype=torch.bool, device=buf.device)
+        else:
+            close = (q + 1) % 2 == 0
+            a, b = buf[:n].to(F64), buf[1:n + 1].to(F64)
+            sc = torch.stack([a[:, D:], b[:, D:]])
+            kv = torch.stack([a[:, :D], b[:, :D]])
+            pooled = (kv * torch.softmax(sc, 0)).sum(0)
+        y = pooled * torch.rsqrt(pooled.square().mean(-1, keepdim=True) + eps) * weight.to(F64)
+        out[close] = y[close].to(N.ACT)
+        return out
+
+    def index_k(self, k_pre, weight, table, keys, win, ratio: int, eps: float) -> None:
+        q = win.positions.to(torch.long)
+        close = (q + 1) % ratio == 0
+        if not bool(close.any()):
+            return
+        k = k_pre[close].to(F64)
+        k = (k * torch.rsqrt(k.square().mean(-1, keepdim=True) + eps) * weight.to(F64)).to(N.ACT)
+        keys.write(q[close] // ratio, table.apply(k, q[close] // ratio * ratio, dtype=N.ACT))
+
+    # -- the indexer -----------------------------------------------------------------------------------------------
+    def scores(self, qi, w, keys, win, ratio: int, positions: torch.Tensor | None = None) -> torch.Tensor:
+        """[R, n] float64: dense over positions 0..nvis_max - 1, or over ``positions`` [R, n] (-1 = none); -inf past a
+        row's visible positions. s_j = sum_h w_h relu(qi_h . k_j) / sqrt(Dk) / sqrt(NH) (vLLM's order)."""
+
+        R, NH, Dk = qi.shape
+        nvis = (win.positions.to(torch.long) + 1) // ratio
+        wh = w.to(F64) * Dk ** -0.5 * NH ** -0.5
+        if positions is None:
+            n = max(int(nvis.max()), 1)
+            j = torch.arange(n, device=qi.device).expand(R, n)
+        else:
+            j = positions.to(torch.long)
+        ok = (j >= 0) & (j < nvis[:, None])
+        k = keys.read(j.clamp(min=0).reshape(-1)).to(F64).reshape(R, j.shape[1], Dk)
+        dots = torch.relu(torch.einsum("rhd,rjd->rhj", qi.to(F64), k))
+        s = (dots * wh[:, :, None]).sum(1)
+        return s.masked_fill(~ok, float("-inf"))
+
+    @staticmethod
+    def _top(s: torch.Tensor, pos: torch.Tensor, count: int) -> torch.Tensor:
+        """The ``count`` best (score desc, position asc) positions scoring above -inf, ascending, -1 padded."""
+
+        R = s.shape[0]
+        out = torch.full((R, count), -1, dtype=torch.int32, device=s.device)
+        for r in range(R):
+            ok = (s[r] > float("-inf")) & (pos[r] >= 0)
+            sv, pv = s[r][ok].tolist(), pos[r][ok].tolist()
+            best = sorted(range(len(sv)), key=lambda i: (-sv[i], pv[i]))[:count]
+            sel = sorted(pv[i] for i in best)
+            out[r, :len(sel)] = torch.tensor(sel, dtype=torch.int32)
+        return out
+
+    def select(self, qi, w, keys, win, ratio: int, topk: int, want_scores: bool = False):
+        s = self.scores(qi, w, keys, win, ratio)
+        pos = torch.arange(s.shape[1], device=s.device).expand_as(s)
+        return self._top(s, pos, topk), (s if want_scores else None)
+
+    def select_cand(self, qi, w, keys, win, ratio: int, topk: int, block: int, topk_blocks: int):
+        sel, s = self.select(qi, w, keys, win, ratio, topk, want_scores=True)
+        return sel, self.candidates(s, win, ratio, block, topk_blocks)
+
+    def candidates(self, s, win, ratio: int, block: int, topk_blocks: int) -> torch.Tensor:
+        """Ascending candidate blocks [R, topk_blocks] (-1 pad): block score = max over its visible scores, the block
+        of the newest visible position pinned to +inf."""
+
+        R, n = s.shape
+        nb = -(-n // block)
+        pad = torch.full((R, nb * block - n), float("-inf"), dtype=s.dtype, device=s.device)
+        bs = torch.cat([s, pad], 1).view(R, nb, block).amax(-1)
+        nvis = (win.positions.to(torch.long) + 1) // ratio
+        blocks = torch.arange(nb, device=s.device).expand(R, nb)
+        live = blocks * block < nvis[:, None]
+        newest = blocks == ((nvis - 1) // block)[:, None]
+        bs = torch.where(newest & live, torch.full_like(bs, float("inf")), bs)
+        bpos = torch.where(live, blocks, torch.full_like(blocks, -1))
+        return self._top(bs, bpos, topk_blocks)
+
+    def reindex(self, qi, w, keys, win, cand, ratio: int, topk: int, block: int) -> torch.Tensor:
+        j = cand.to(torch.long)[:, :, None] * block + torch.arange(block, device=cand.device)
+        j = torch.where(cand[:, :, None] >= 0, j, torch.full_like(j, -1)).reshape(cand.shape[0], -1)
+        s = self.scores(qi, w, keys, win, ratio, positions=j)
+        return self._top(s, j, topk)
+
+    # -- attention -------------------------------------------------------------------------------------------------
+    def attention(self, q, comp, sel, counts, swa, lo, win, sink, table, ring: int, hi=None) -> torch.Tensor:
+        """q bf16 [R, H, D] (RoPE'd); comp: the kv source's compressed rows or None; sel / counts: each row's first
+        ``counts[r]`` entries of ``sel`` are its rows; swa: the layer's ring; lo [R]: window starts -> bf16 [R, H, D]
+        with the inverse RoPE at each row's position."""
+
+        R, H, D = q.shape
+        qpos = win.positions.to(torch.long)
+        out = torch.empty((R, H, D), dtype=F64, device=q.device)
+        sk = sink.to(F64)
+        for r in range(R):
+            end = int(qpos[r]) if hi is None else int(hi[r])
+            a = max(int(lo[r]), end - self.window + 1, 0)
+            p = torch.arange(a, end + 1, device=q.device)
+            keys = [swa.read(p % ring)]
+            if comp is not None and counts is not None and int(counts[r]) > 0:
+                keys.insert(0, comp.read(sel[r, :int(counts[r])].to(torch.long)))
+            k = torch.cat(keys, 0).to(F64)
+            s = q[r].to(F64) @ k.t() / math.sqrt(D)
+            m = torch.maximum(s.amax(-1), sk)
+            e = torch.exp(s - m[:, None])
+            den = e.sum(-1) + torch.exp(sk - m)
+            out[r] = (e @ k) / den[:, None]
+        return table.apply(out.to(N.ACC), qpos, inverse=True, dtype=N.ACT)
