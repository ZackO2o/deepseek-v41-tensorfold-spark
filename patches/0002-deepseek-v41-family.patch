index 0000000..aa0f015
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rope.py
@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1 RoPE: GPT-J interleaved pairs on the LAST ``rope_dim`` dims, two flavours a layer, as tables.
+
+Math reference: vLLM ``models/deepseek_v4_1/common/rope.py`` and ``rotary_embedding/deepseek_scaling_rope.py``
+(Apache-2.0; no code copied):
+
+- compressed layers (ratio > 0): theta ``compress_rope_theta`` (160,000) with DeepSeek YaRN (factor 16 over an
+  original 65,536 positions, beta_fast 32, beta_slow 1, mscale 1);
+- sliding-window-only layers (ratio 0: layers 0-1 and the DSpark blocks): theta ``rope_theta`` (10,000), plain.
+
+A ``Table`` is ``[max_pos, rope_dim]`` fp32: the cos of each pair frequency, then the sin (the layout vLLM's
+``cos_sin_cache`` has and ``csa2.rows.cos_sin`` reads). Angles are ``fp32(t) * fp32(inv_freq)`` in fp32, so a
+table entry equals the one computed on the fly for that position (engine/reference/rope.py, bit for bit).
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from dataclasses import dataclass
+
+import torch
+
+from . import numerics as N
+
+F32 = torch.float32
+
+
+def inplace() -> bool:
+    """``TF_DSV41_ROPE_INPLACE`` (G7; 0 = off): the query / index-query RoPE rotates the bf16 projection in place
+    (``Table.apply_`` -> ``rope_fused.apply_``) instead of a widened fp32 copy into a new bf16 tensor. G5 nsys at
+    2,048 rows: the fp32 copy 0.87 ms + the kernel 0.92 ms a layer; in place only the 64 RoPE dims of each head
+    move. The same bits (bf16 widens exactly; the NoPE dims' bf16 rounding of a bf16 value is the value)."""
+
+    return (os.environ.get("TF_DSV41_ROPE_INPLACE", "0").strip() or "0") != "0"
+
+
+def _correction_dim(num_rotations: float, dim: int, base: float, max_pos: int) -> float:
+    return (dim * math.log(max_pos / (num_rotations * 2 * math.pi))) / (2 * math.log(base))
+
+
+def inv_freq(rope_dim: int, base: float, factor: float = 1.0, original_max: int = 65536, beta_fast: float = 32.0,
+             beta_slow: float = 1.0) -> torch.Tensor:
+    """[rope_dim / 2] fp32 pair frequencies; ``factor`` 1 is plain RoPE, > 1 DeepSeek's YaRN blend."""
+
+    pos_freqs = base ** (torch.arange(0, rope_dim, 2, dtype=F32) / rope_dim)
+    extrapolation = 1.0 / pos_freqs
+    if factor == 1.0:
+        return extrapolation
+    interpolation = 1.0 / (factor * pos_freqs)
+    low = math.floor(_correction_dim(beta_fast, rope_dim, base, original_max))
+    high = math.ceil(_correction_dim(beta_slow, rope_dim, base, original_max))
+    low, high = max(low, 0), min(high, rope_dim - 1)
+    if low == high:
+        high += 0.001
+    ramp = ((torch.arange(rope_dim // 2, dtype=F32) - low) / (high - low)).clamp(0, 1)
+    mask = 1 - ramp
+    return interpolation * (1 - mask) + extrapolation * mask
+
+
+@dataclass
+class Table:
+    """cos / sin of every position below ``cs.shape[0]`` for one layer flavour."""
+
+    cs: torch.Tensor            # [max_pos, rope_dim] fp32: cos half, then sin half
+    rope_dim: int
+
+    @classmethod
+    def build(cls, freqs: torch.Tensor, max_pos: int, device="cpu") -> "Table":
+        t = torch.arange(max_pos, dtype=F32)
+        ang = t[:, None] * freqs.to(F32)[None, :]
+        return cls(torch.cat([torch.cos(ang), torch.sin(ang)], 1).contiguous().to(device), 2 * freqs.numel())
+
+    def cos_sin(self, positions: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows = self.cs.index_select(0, positions.reshape(-1).to(device=self.cs.device, dtype=torch.long))
+        half = self.rope_dim // 2
+        return rows[:, :half], rows[:, half:]
+
+    def apply(self, x: torch.Tensor, positions: torch.Tensor, inverse: bool = False,
+              dtype: torch.dtype | None = None) -> torch.Tensor:
+        """Rotate the last ``rope_dim`` dims of x [T, ..., D] at ``positions`` [T] (GPT-J pairs); fp32 math (the
+        kernels' and the reference's), the result in ``dtype``. On CUDA, [T, H, Dh] to bf16 is one launch with the
+        same bits (``rope_fused``)."""
+
+        if x.is_cuda and N.ACC == F32:
+            from . import rope_fused
+
+            if rope_fused.eligible(x, positions, self.rope_dim, dtype):
+                return rope_fused.apply(x, self.cs, positions, self.rope_dim, inverse)
+        x = x.to(N.ACC)
+        cos, sin = self.cos_sin(positions)
+        if inverse:
+            sin = -sin
+        shape = (cos.shape[0],) + (1,) * (x.dim() - 2) + (cos.shape[1],)
+        cos, sin = cos.reshape(shape).to(x.device, x.dtype), sin.reshape(shape).to(x.device, x.dtype)
+        rot = x[..., -self.rope_dim:]
+        even, odd = rot[..., 0::2], rot[..., 1::2]
+        out = torch.stack((even * cos - odd * sin, odd * cos + even * sin), dim=-1).flatten(-2)
+        return torch.cat((x[..., :-self.rope_dim], out), dim=-1).to(dtype or N.ACC)
+
+
+    def apply_(self, x: torch.Tensor, positions: torch.Tensor, dtype: torch.dtype | None = None) -> torch.Tensor:
+        """``apply(x, positions, dtype=dtype)``'s values; in place (x returned) when x is a bf16 [T, H, Dh] CUDA
+        tensor the fused kernel takes (``rope_fused.apply_``), a new tensor otherwise."""
+
+        if x.is_cuda and N.ACC == F32 and x.dtype == torch.bfloat16 and x.stride(-1) == 1:
+            from . import rope_fused
+
+            if rope_fused.eligible(x, positions, self.rope_dim, dtype):
+                return rope_fused.apply_(x, self.cs, positions, self.rope_dim)
+        return self.apply(x, positions, dtype=dtype)
+
+
+def tables(cfg, max_pos: int, device="cpu") -> dict[int, Table]:
+    """{0: the window-only layers' table, 1: the compressed layers'} for a ``config.Config``."""
+
+    r = cfg.rope
+    plain = inv_freq(cfg.qk_rope_head_dim, r.rope_theta)
+    if r.yarn:
+        comp = inv_freq(cfg.qk_rope_head_dim, r.compress_rope_theta, r.factor, r.original_max_position_embeddings,
+                        r.beta_fast, r.beta_slow)
+    else:
+        comp = inv_freq(cfg.qk_rope_head_dim, r.compress_rope_theta)
+    return {0: Table.build(plain, max_pos, device), 1: Table.build(comp, max_pos, device)}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rope_fused.py b/src/tensorfold/families/deepseek_v41/cuda/rope_fused.py
new file mode 100644
index 0000000..a239ee6
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rope_fused.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The query / index-query RoPE of ``rope.Table.apply`` as one Triton launch (G4: the torch form is ~10 launches and
+two full copies a call, twice a layer on the index layers).
+
+Bit for bit the torch form: every value is fp32 (bf16 inputs widen exactly), the NoPE dims are rounded to the output
+dtype unchanged, each rotated pair is ``(even * cos - odd * sin, odd * cos + even * sin)`` with every product and sum
+rounded once (``enable_fp_fusion=False``: no FMA contraction, as torch's separate kernels), cos / sin the table's own
+fp32 entries at the row's position (``inverse``: -sin, as ``apply``), one round to bf16 (nearest even). One program a
+(row, head block): a row's output depends on that row alone.
+
+``rope.Table.apply`` calls it on CUDA for [T, H, Dh] inputs with bf16 output (``TF_DSV41_ROPE_FUSED``, 1 = on);
+elsewhere, and for any other shape or dtype, the torch form runs.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+LAUNCH = {"enable_fp_fusion": False}
+BH = 4                  # heads a program
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_ROPE_FUSED", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _rope(X, x_rs, x_hs, OUT, o_rs, o_hs, CS, cs_rs, POS, H, NOPE: tl.constexpr, NB: tl.constexpr,
+          HALF: tl.constexpr, BH: tl.constexpr, INV: tl.constexpr, COPY: tl.constexpr = True,
+          PDL: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    h = tl.program_id(1) * BH + tl.arange(0, BH)
+    hm = h < H
+    xr = X + r.to(tl.int64) * x_rs + h.to(tl.int64)[:, None] * x_hs
+    orow = OUT + r.to(tl.int64) * o_rs + h.to(tl.int64)[:, None] * o_hs
+    d = tl.arange(0, NB)
+    if COPY:                                                            # in place (bf16): the NoPE dims stay
+        for c in range(0, NOPE, NB):                                    # the NoPE dims: one rounding to bf16
+            m = hm[:, None] & ((c + d)[None, :] < NOPE)
+            v = tl.load(xr + c + d[None, :], mask=m, other=0.0).to(tl.float32)
+            tl.store(orow + c + d[None, :], v.to(tl.bfloat16), mask=m)
+    pos = tl.load(POS + r).to(tl.int64)
+    j = tl.arange(0, HALF)
+    cs = tl.load(CS + pos * cs_rs + j)
+    sn = tl.load(CS + pos * cs_rs + HALF + j)
+    if INV:
+        sn = -sn
+    m = hm[:, None]
+    ev = tl.load(xr + NOPE + 2 * j[None, :], mask=m, other=0.0).to(tl.float32)
+    od = tl.load(xr + NOPE + 2 * j[None, :] + 1, mask=m, other=0.0).to(tl.float32)
+    a = ev * cs[None, :] - od * sn[None, :]
+    b = od * cs[None, :] + ev * sn[None, :]
+    tl.store(orow + NOPE + 2 * j[None, :], a.to(tl.bfloat16), mask=m)
+    tl.store(orow + NOPE + 2 * j[None, :] + 1, b.to(tl.bfloat16), mask=m)
+
+
+def apply(x: torch.Tensor, cs: torch.Tensor, positions: torch.Tensor, rope_dim: int,
+          inverse: bool = False) -> torch.Tensor:
+    """x [T, H, Dh] (bf16 or fp32, unit stride in Dh), cs [max_pos, rope_dim] fp32, positions [T] -> bf16 [T, H, Dh]
+    with the last ``rope_dim`` dims rotated."""
+
+    T, H, Dh = x.shape
+    if x.stride(2) != 1:
+        x = x.contiguous()
+    out = torch.empty((T, H, Dh), dtype=torch.bfloat16, device=x.device)
+    if T == 0:
+        return out
+    pos = positions.reshape(-1).to(device=x.device, dtype=torch.long)
+    _rope[(T, triton.cdiv(H, BH))](x, x.stride(0), x.stride(1), out, out.stride(0), out.stride(1), cs, cs.stride(0),
+                                    pos, H, NOPE=Dh - rope_dim, NB=64, HALF=rope_dim // 2, BH=BH, INV=bool(inverse),
+                                    num_warps=4, **LAUNCH, **P.triton_kw())
+    return out
+
+
+def apply_(x: torch.Tensor, cs: torch.Tensor, positions: torch.Tensor, rope_dim: int,
+           inverse: bool = False) -> torch.Tensor:
+    """``apply`` into x itself: x bf16 [T, H, Dh] (unit stride in Dh); only the last ``rope_dim`` dims are written."""
+
+    T, H, Dh = x.shape
+    if x.dtype != torch.bfloat16 or x.stride(2) != 1:
+        raise ValueError("rope_fused.apply_: bf16 [T, H, Dh] with unit-stride Dh")
+    if T == 0:
+        return x
+    pos = positions.reshape(-1).to(device=x.device, dtype=torch.long)
+    _rope[(T, triton.cdiv(H, BH))](x, x.stride(0), x.stride(1), x, x.stride(0), x.stride(1), cs, cs.stride(0),
+                                    pos, H, NOPE=Dh - rope_dim, NB=64, HALF=rope_dim // 2, BH=BH, INV=bool(inverse),
+                                    COPY=False, num_warps=4, **LAUNCH, **P.triton_kw())
+    return x
+
+
+def eligible(x: torch.Tensor, positions: torch.Tensor, rope_dim: int, dtype) -> bool:
+    """Where ``Table.apply`` may use the kernel: CUDA, [T, H, Dh] with Dh - rope_dim a multiple of 64 (or 0), bf16 out."""
+
+    return (x.is_cuda and x.dim() == 3 and dtype == torch.bfloat16 and x.dtype in (torch.float32, torch.bfloat16)
+            and rope_dim % 2 == 0 and (rope_dim // 2) & (rope_dim // 2 - 1) == 0 and (x.shape[2] - rope_dim) % 64 == 0
+            and x.shape[2] >= rope_dim and positions.numel() == x.shape[0] and enabled())
+
+
+__all__ = ["apply", "apply_", "eligible", "enabled"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rounds.py b/src/tensorfold/families/deepseek_v41/cuda/rounds.py
new file mode 100644
index 0000000..9abbd0b
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rounds.py
@@ -0,0 +1,263 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The round executor of the V4.1 batcher: one ``plan.Plan`` applied to the forward, the pool, the session store and
+the slots' grammars, identically on both ranks (rank 0's ``batch.Batcher`` plans and samples; rank 1 only executes).
+
+Everything here is deterministic given the plan and the rank's previous state, so both ranks' pools, stores and
+grammar matchers stay identical; the only cross-rank data is the plan (and, inside the forward, its exchanges).
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+import numpy as np
+
+from .phases import PH
+from .plan import Admit, Plan
+from .pool import Pool
+from .protocol import REPLAY, Candidates, Piece, Rows
+
+
+@dataclass
+class Result:
+    rows: list[Rows] = field(default_factory=list)          # the windows run, in plan order (after grammar cuts)
+    cand: Candidates | None = None
+    errors: dict[int, BaseException] = field(default_factory=dict)    # slot -> its request's failure
+    restored: dict[int, int] = field(default_factory=dict)            # slot -> tokens resumed
+    skipped: set[int] = field(default_factory=set)    # slots whose restore failed: nothing more for them this round
+    piece_s: float = 0.0                                # the prefill forward's seconds (fairness)
+    window_s: float = 0.0                               # the verify forward's seconds
+
+    def out(self, slot: int) -> bool:
+        return slot in self.errors or slot in self.skipped
+
+
+class Executor:
+    """One rank's slots: page tables, token histories (what each slot's state holds), grammar states."""
+
+    def __init__(self, fwd, pool: Pool, n_slots: int, capacity: int, *, store=None, grammars=None, tag: int = 0,
+                 mode: str = "full", rank: int = 0, session_min: int = 64) -> None:
+        self.fwd = fwd
+        self.pool = pool
+        self.store = store
+        self.grammars = grammars
+        self.tag = int(tag)
+        self.mode = mode
+        self.rank = rank
+        self.session_min = int(session_min)
+        self.capacity = int(capacity)
+        self.slots = [pool.new_slot(capacity) for _ in range(n_slots)]
+        if callable(getattr(fwd, "bind", None)):
+            fwd.bind(self.slots)                # the forward reads the slots' page tables (``Forward.bind``)
+        self.hist: list[list[int]] = [[] for _ in range(n_slots)]
+        self.prompts: list[list[int] | None] = [None] * n_slots
+        self.cons: list[Any] = [None] * n_slots
+        self.last: list[Rows | None] = [None] * n_slots
+        self.rounds = 0
+
+    # -- steps ---------------------------------------------------------------------------------------------------
+    def run(self, plan: Plan) -> Result:
+        res = Result()
+        self.rounds += 1
+        with PH("commit"):
+            for slot, acc, bonus in plan.commits:
+                self._commit(slot, int(acc), int(bonus))
+        for slot, save, cancelled in plan.finishes:
+            self._finish(slot, bool(save))
+        for key in plan.spills:
+            self.store.evict(key)
+        for a in plan.admits:
+            self._admit(a, res)
+        if plan.pieces:
+            pieces = []
+            for slot, start, end in plan.pieces:
+                if res.out(slot):
+                    continue
+                self.slots[slot].ensure(end)
+                ids = tuple(self.prompts[slot][start:end])
+                pieces.append(Piece(slot, start, ids))
+                self.hist[slot].extend(ids)
+            if pieces:
+                t0 = time.perf_counter()
+                with PH("prefill"):
+                    self._prefetch(pieces, [], ahead=True)
+                    self.fwd.prefill(pieces, mode=plan.mode)
+                res.piece_s = time.perf_counter() - t0
+        for slot in plan.saves:
+            if not res.out(slot):
+                self._save(slot, "prompt")
+        for slot in plan.finals:
+            if res.out(slot):
+                continue
+            p = self.prompts[slot]
+            n = len(p)
+            self.fwd.finish_prompt(slot, n - 1, tuple(p[max(0, n - REPLAY):n - 1]), mode=plan.mode)
+        if plan.windows:
+            t0 = time.perf_counter()
+            self._windows(plan, res)
+            res.window_s = time.perf_counter() - t0
+        return res
+
+    def _commit(self, slot: int, acc: int, bonus: int) -> None:
+        rows = self.last[slot]
+        if rows is None:
+            raise RuntimeError(f"commit for slot {slot} without a window")
+        self.fwd.commit(slot, acc)
+        seen = getattr(self.fwd, "committed", None)
+        if callable(seen):
+            seen(slot, acc, bonus)              # the depth's counterfactual first draft (``depth.Depth.bonus``)
+        nxt = getattr(self.fwd, "prefetch_pending", None)
+        if callable(nxt):
+            nxt(slot, bonus)                    # the next window's pending row: its Engram reads start now
+        kept = list(rows.tokens[:acc + 1])
+        self.hist[slot].extend(kept)
+        con = self.cons[slot]
+        if con is not None:
+            con.advance(kept[1:] + [bonus])
+        self.last[slot] = None
+
+    def _finish(self, slot: int, save: bool) -> None:
+        # prompt snapshots only under the fast prefill tag (``prefill_mm``) and in CED replay mode (``replay``): a
+        # turn's end holds rows a fresh prefill of the next prompt would compute differently
+        if save and not self.tag >> 8 and self.mode != "replay":
+            self._save(slot, "turn")
+        self.slots[slot].release()
+        self.hist[slot] = []
+        self.prompts[slot] = None
+        self.cons[slot] = None
+        self.last[slot] = None
+
+    def _save(self, slot: int, kind: str):
+        if self.store is None or len(self.hist[slot]) < self.session_min:
+            return None
+        snap = self.fwd.snapshot(slot)
+        if snap.pos != len(self.hist[slot]):
+            raise RuntimeError(f"slot {slot}: snapshot at {snap.pos}, history {len(self.hist[slot])}")
+        return self.store.save(self.slots[slot], snap, self.hist[slot], self.tag, kind)
+
+    def _admit(self, a: Admit, res: Result) -> None:
+        sl = self.slots[a.slot]
+        if sl.pages:
+            raise RuntimeError(f"slot {a.slot} admitted while it maps pages")
+        sl.reserve(a.quota)
+        self.fwd.reset(a.slot)
+        self.prompts[a.slot] = list(a.prompt)
+        self.hist[a.slot] = []
+        self.last[a.slot] = None
+        cached = 0
+        if a.tier:
+            try:
+                snap = self.store.restore(a.tier, a.key, sl)
+                if snap.pos != a.cached:
+                    raise ValueError(f"entry holds {snap.pos} tokens, the plan says {a.cached}")
+                self.fwd.restore(a.slot, snap)
+                cached = a.cached
+            except (ValueError, KeyError):      # a damaged NVMe entry: prefill from the start instead
+                sl.truncate(0)
+                self.fwd.reset(a.slot)
+                cached = 0
+                res.skipped.add(a.slot)
+        self.hist[a.slot] = list(a.prompt[:cached])
+        res.restored[a.slot] = cached
+        self.cons[a.slot] = None
+        if a.grammar:
+            from tensorfold.families.glm5_next.spark import grammar as gm
+
+            body, _ = gm.split(a.grammar)
+            try:
+                bound = self.grammars.follow(body)
+                self.cons[a.slot] = self.grammars.constraint(bound)
+            except Exception as exc:            # noqa: BLE001  (the request fails, not the server)
+                res.errors[a.slot] = exc
+
+    def _windows(self, plan: Plan, res: Result) -> None:
+        specs = [w for w in plan.windows if not res.out(w.slot)]
+        drafts: dict[int, list[int]] = {}
+        deep = [w for w in specs if w.depth > 0]
+        if deep and callable(getattr(self.fwd, "draft", None)):
+            for w in deep:                      # the window's rows (pending + depth) may be written by the drafter
+                self.slots[w.slot].ensure(w.start + w.depth + 1)
+            kw = {"noises": [list(w.noise) for w in deep]} if getattr(self.fwd, "keyed_noise", False) else {}
+            if getattr(self.fwd, "zero_depth", False):
+                kw["alone"] = len(specs) == 1   # no other window shares the verify: k may be 0 (``depth.py``)
+            if getattr(self.fwd, "joint_depth", False):     # the shared window's other rows (``joint.py``)
+                kw["others"] = [1 + len(w.drafts) for w in specs if w.depth <= 0]
+            with PH("draft"):
+                got = self.fwd.draft([w.slot for w in deep], [w.pending for w in deep], [w.start for w in deep],
+                                     [w.depth for w in deep], **kw)
+            drafts = {w.slot: [int(t) for t in d][:w.depth] for w, d in zip(deep, got)}
+        rows, masks, nucs, flags, any_mask = [], [], [], [], False
+        for w in specs:
+            tokens = [int(w.pending)] + (drafts.get(w.slot) or [int(t) for t in w.drafts])
+            con = self.cons[w.slot]
+            bits = None
+            if con is not None:
+                try:
+                    gwin = con.fill(con.cut(tokens))
+                    tokens, bits = gwin.tokens, self._full_bits(gwin, len(gwin.tokens), con.words)
+                except Exception as exc:        # noqa: BLE001  (GrammarError: that request ends)
+                    res.errors[w.slot] = exc
+                    continue
+            any_mask = any_mask or bits is not None
+            self.slots[w.slot].ensure(w.start + len(tokens))
+            r = Rows(w.slot, w.start, tuple(tokens))
+            self.last[w.slot] = r
+            rows.append(r)
+            masks.append(bits)
+            nucs.append(list(getattr(w, "nucleus", None) or []))
+            flags.append((w.slot in drafts, list(w.noise)))     # a DSpark round: the next pass may start early
+        res.rows = rows
+        if rows:
+            with PH("prefetch"):
+                self._prefetch([], rows)        # drafter end: the window's Engram reads (``Forward.prefetch``)
+            kw = {"nucleus": nucs} if any(nucs) else {}         # top-p rows' normalizers (``nucleus.py``)
+            if getattr(self.fwd, "speculates", False):
+                kw["spec"] = flags                              # ``spec.py`` (TF_DSV41_SPEC_DRAFT)
+            with PH("window"):
+                res.cand = self.fwd.window(rows, count=plan.count, masks=masks if any_mask else None, **kw)
+            took = getattr(self.fwd, "took", None)
+            if callable(took):                  # tree verification (``tree.py``): the branch each window presents
+                res.rows = took(rows)
+                for r in res.rows:
+                    self.last[r.slot] = r
+
+    def _prefetch(self, pieces, rows, ahead: bool = False) -> None:
+        pf = getattr(self.fwd, "prefetch", None)
+        if not callable(pf):
+            return
+        from . import prefetch as PF
+
+        nxt = PF.next_pieces(pieces, self.prompts) if ahead and PF.ahead_enabled() else []
+        if nxt:                                 # the next segment's Engram reads behind this one's (G7)
+            pf(pieces, rows, ahead=nxt)
+        else:
+            pf(pieces, rows)
+
+    @staticmethod
+    def _full_bits(gwin, n: int, words: int) -> np.ndarray | None:
+        """The window's mask for every row ([n, words]; unconstrained rows (thinking) all ones), or None."""
+
+        if gwin.bits is None or not gwin.rows:
+            return None
+        bits = np.full((n, words), -1, dtype=np.int32)
+        bits[np.asarray(gwin.rows)] = gwin.bits
+        return bits
+
+    # -- views ---------------------------------------------------------------------------------------------------
+    def describe(self) -> str:
+        busy = sum(1 for p in self.prompts if p is not None)
+        return f"{busy} of {len(self.slots)} slots busy; pool {self.pool.describe()}"
+
+
+def take_rows(cand: Candidates, rows: Sequence[Rows]) -> list[Candidates]:
+    """Split a window's candidates per slot window."""
+
+    out, off = [], 0
+    for r in rows:
+        out.append(cand.rows(off, off + len(r.tokens)))
+        off += len(r.tokens)
+    return out
