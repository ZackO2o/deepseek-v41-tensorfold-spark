index 0000000..0abe0c4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/vsample.py
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A verify window's candidates merged, chosen and accepted on the device (torch ops, no host round trip): the
+speculative DSpark pass (``spec.py``) starts from these, and the host's candidates come back already sorted.
+
+- ``merge(g, k, count)``: every rank's top ``k`` (``slots.SlotsForward.cand_gather``: [W, R, 2k] fp32, values then
+  int32 ids as fp32 bits, rank order) -> each row's best ``count`` by (value desc, id asc), the order of
+  ``np.lexsort((ids, -values))`` that ``candidates`` used to run on the host: one int64 key a candidate
+  (the value's order-preserving int32 image with +0.0 for -0.0, then 2^31 - 1 - id), one device sort;
+- ``choose(vals, ids, rows)``: each row's token under ``exact_sampling.choose_rows``' rule (greedy: the first sorted
+  candidate; sampled: top-k, the keyed Gumbel draw of splitmix64(seed, position, id), top-p over the top-k mass,
+  min-p) in float64. Speculation only: the host's ``choose_rows`` stays the authority (exp / log and the sums' order
+  may differ from numpy's in the last bit, which can move a near-tie);
+- ``accept(chosen, nxt, win, local, starts, firsts)``: a window's kept drafts a = the first row whose choice differs
+  from the next window token (the last row always does), the bonus token chosen[first + a] and the next pending
+  position start + a + 1.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import torch
+
+C1 = 0xBF58476D1CE4E5B9
+C2 = 0x94D049BB133111EB
+GOLD = 0x9E3779B97F4A7C15
+POSM = 0xD1B54A32D192ED03
+ID_MAX = (1 << 31) - 1
+
+
+def s64(v: int) -> int:
+    """A 64-bit pattern as the signed int64 torch stores."""
+
+    v &= (1 << 64) - 1
+    return v - (1 << 64) if v >> 63 else v
+
+
+def _srl(x: torch.Tensor, s: int) -> torch.Tensor:
+    """Logical right shift of int64 bit patterns."""
+
+    return (x >> s) & ((1 << (64 - s)) - 1)
+
+
+def _mix(x: torch.Tensor) -> torch.Tensor:
+    x = x ^ _srl(x, 30)
+    x = x * s64(C1)
+    x = x ^ _srl(x, 27)
+    x = x * s64(C2)
+    return x ^ _srl(x, 31)
+
+
+def uniform(seeds: torch.Tensor, positions: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """``exact_sampling.uniform_rows`` a row: float64 [R, C] from int64 seeds [R] (bit patterns), positions [R] and
+    ids [R, C], the same bits as numpy's uint64 arithmetic (int64 wraps alike)."""
+
+    x = _mix(seeds + s64(GOLD))
+    x = _mix(x ^ (positions * s64(POSM)))
+    x = _mix(x[:, None] ^ ids)
+    return _srl(x, 11).to(torch.float64) * 2.0 ** -53 + 2.0 ** -54
+
+
+def sort_keys(vals: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """int64 keys, larger = (larger value, then lower id); ids in [0, 2^31)."""
+
+    bits = (vals.float() + 0.0).contiguous().view(torch.int32)        # -0.0 + 0.0 = +0.0
+    mono = torch.where(bits >= 0, bits, bits ^ 0x7FFFFFFF).to(torch.int64)
+    return (mono << 32) | (ID_MAX - ids.to(torch.int64))
+
+
+def merge(g: torch.Tensor, k: int, count: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """[W, R, 2k] gathered candidates -> (values fp32 [R, c], ids int64 [R, c]) sorted, c = min(count, W k)."""
+
+    W, R = g.shape[0], g.shape[1]
+    vals = g[:, :, :k].permute(1, 0, 2).reshape(R, W * k)
+    ids = g[:, :, k:].contiguous().view(torch.int32).permute(1, 0, 2).reshape(R, W * k).to(torch.int64)
+    c = min(int(count), W * k)
+    order = torch.sort(sort_keys(vals, ids), dim=1, descending=True).indices[:, :c]
+    return torch.gather(vals, 1, order), torch.gather(ids, 1, order)
+
+
+def choose(vals: torch.Tensor, ids: torch.Tensor, seeds: torch.Tensor, positions: torch.Tensor,
+           ints: torch.Tensor, floats: torch.Tensor) -> torch.Tensor:
+    """int64 [R] tokens from sorted candidates (``merge``). ``ints`` int64 [R, 2] (top_k (0 = all), sampled 0/1),
+    ``floats`` float64 [R, 3] (temperature, top_p, min_p); ``seeds`` / ``positions`` int64 [R]."""
+
+    C = ids.shape[1]
+    j = torch.arange(C, device=ids.device)
+    topk = ints[:, 0]
+    k = torch.where(topk > 0, topk.clamp(max=C), torch.full_like(topk, C)).clamp(min=1)
+    inside = j[None, :] < k[:, None]
+    temp = floats[:, 0].clamp(min=1e-6)
+    scaled = vals.to(torch.float64) / temp[:, None]
+    score = scaled - torch.log(-torch.log(uniform(seeds, positions, ids)))
+    top_p, min_p = floats[:, 1], floats[:, 2]
+    e = torch.where(inside, torch.exp(scaled - scaled[:, :1]), torch.zeros_like(scaled))
+    probs = e / e.sum(dim=1, keepdim=True)
+    keep = ((torch.cumsum(probs, dim=1) < top_p[:, None]) & inside).sum(dim=1) + 1
+    nucleus = (top_p > 0.0) & (top_p < 1.0)
+    keep = torch.where(nucleus, keep, k)
+    ok = j[None, :] < torch.minimum(keep, k)[:, None]
+    min_log = torch.where(min_p > 0.0, torch.log(min_p.clamp(min=1e-300)), torch.full_like(min_p, float("-inf")))
+    ok &= scaled >= scaled[:, :1] + min_log[:, None]
+    score = torch.where(ok, score, torch.full_like(score, float("-inf")))
+    pick = torch.gather(ids, 1, score.argmax(dim=1, keepdim=True))[:, 0]
+    return torch.where(ints[:, 1] != 0, pick, ids[:, 0])
+
+
+def accept(chosen: torch.Tensor, nxt: torch.Tensor, win: torch.Tensor, local: torch.Tensor, starts: torch.Tensor,
+           firsts: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """(accepted, bonus, next start) int64 [Wn] of every window. ``nxt`` int64 [R]: the window token after each row
+    (-1 after the last row), ``win`` / ``local`` int64 [R]: each row's window and index in it, ``starts`` /
+    ``firsts`` int64 [Wn]: each window's start position and first row."""
+
+    big = torch.full_like(local, 1 << 40)
+    bad = torch.where(chosen != nxt, local, big)
+    acc = torch.full_like(starts, 1 << 40).scatter_reduce(0, win, bad, reduce="amin", include_self=True)
+    bonus = chosen.index_select(0, firsts + acc)
+    return acc, bonus, starts + acc + 1
+
+
+def row_tables(windows: Sequence, samplings: Sequence) -> tuple[list[int], list[float]]:
+    """Host values of a round's rows for ``choose`` / ``accept``, flat: int64 [nxt R | win R | local R | seeds R |
+    positions R | top_k R | sampled R | starts Wn | firsts Wn] and float64 [T R | top_p R | min_p R].
+    ``windows``: (start, tokens) a window; ``samplings``: ``exact_sampling.Sampling`` or None (greedy)."""
+
+    nxt, win, local, seeds, pos, topk, smp, temp, top_p, min_p, starts, firsts = ([] for _ in range(12))
+    r = 0
+    for w, ((start, tokens), s) in enumerate(zip(windows, samplings)):
+        n = len(tokens)
+        starts.append(int(start))
+        firsts.append(r)
+        on = s is not None and float(s.temperature) > 0.0
+        for i in range(n):
+            nxt.append(int(tokens[i + 1]) if i + 1 < n else -1)
+            win.append(w)
+            local.append(i)
+            seeds.append(s64(int(s.seed)) if on else 0)
+            pos.append(int(start) + 1 + i)
+            topk.append(int(s.top_k) if on else 0)
+            smp.append(int(on))
+            temp.append(float(s.temperature) if on else 1.0)
+            top_p.append(float(s.top_p) if on else 1.0)
+            min_p.append(float(s.min_p) if on else 0.0)
+        r += n
+    return nxt + win + local + seeds + pos + topk + smp + starts + firsts, temp + top_p + min_p
+
+
+def run(vals: torch.Tensor, ids: torch.Tensor, i64: torch.Tensor, f64: torch.Tensor, R: int, Wn: int):
+    """``choose`` then ``accept`` from ``row_tables``' values on the device: (chosen [R], accepted, bonus, next start
+    [Wn])."""
+
+    nxt, win, local, seeds, pos, topk, smp = (i64[a * R:(a + 1) * R] for a in range(7))
+    starts, firsts = i64[7 * R:7 * R + Wn], i64[7 * R + Wn:7 * R + 2 * Wn]
+    floats = f64[:3 * R].view(3, R).t()
+    chosen = choose(vals, ids, seeds, pos, torch.stack([topk, smp], 1), floats)
+    acc, bonus, nstart = accept(chosen, nxt, win, local, starts, firsts)
+    return chosen, acc, bonus, nstart
+
+
+__all__ = ["accept", "choose", "merge", "row_tables", "run", "s64", "sort_keys", "uniform"]
