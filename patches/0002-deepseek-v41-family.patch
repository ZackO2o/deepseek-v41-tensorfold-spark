+++ b/src/tensorfold/families/deepseek_v41/cuda/draftcap.py
@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Drafting-log capture on the real checkpoint, both ranks (``python -m ...cuda.draftcap`` on each; rank 1 follows
+rank 0's round plans), for ``draftsim`` / ``treesim`` / ``drafttrain``: rank 0 decodes a prompt set with DSpark on
+while ``TF_DSV41_DRAFT_LOG`` (and ``_HID`` for training features) records every pass.
+
+Prompts: ``--prompts FILE`` (JSON lines: {"msg": ..., "max": 384, "t": 0.0}) or the built-in set: prose in several
+forms over varied topics (the low-acceptance text this work targets), chat answers, and some code, as user turns with
+thinking off. ``--streams`` requests run at once (more passes a minute; each slot's passes are separate sessions in
+the log); every ``--hot``-th request samples at T = 0.7 (keyed: the log scores it against the keyed samples).
+
+Output: the log directory (``TF_DSV41_DRAFT_LOG``) and ``--out`` JSON (per request: tokens, tok/s, drafting stats).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import threading
+import time
+from pathlib import Path
+
+TOPICS = ["lighthouses and their keepers", "the history of tea in Britain", "how glaciers shape valleys",
+          "the invention of the printing press", "life in a medieval monastery", "why bees dance",
+          "the first transatlantic telegraph cable", "urban gardens in dense cities", "the science of sourdough",
+          "the Silk Road's trading towns", "how vaccines train the immune system", "the decline of night skies",
+          "the economics of a small bakery", "learning a second language as an adult", "the ethics of zoos",
+          "deep-sea hydrothermal vents", "the craft of bookbinding", "the rise and fall of the telegraph",
+          "how rivers change course", "the psychology of habits", "Roman roads and their engineering",
+          "the migration of monarch butterflies", "jazz in 1920s New Orleans", "the restoration of old paintings",
+          "the challenges of desert agriculture", "why cities flood", "the history of the bicycle",
+          "volcanic islands and new soil", "the life of a lighthouse lens maker", "public libraries in small towns",
+          "the long voyage of the Endurance", "how bridges carry load", "the culture of night markets",
+          "coral reefs under warming seas", "the slow food movement", "the history of maps",
+          "train travel across Siberia", "what owls hear at night", "the making of a violin", "the first airmail"]
+FORMS = ["Write a 350-word essay on {t}. Plain prose, no lists or headings.",
+         "Explain {t} to a curious friend in a few warm, conversational paragraphs.",
+         "Write a short story (about 300 words) set against the background of {t}.",
+         "Write a thoughtful letter to a younger relative about {t}, around 300 words."]
+CHAT = ["What are the trade-offs between renting and buying a home? Answer in prose.",
+        "How should I prepare for a job interview at a small company? Give advice in paragraphs.",
+        "Why do some people find it hard to fall asleep, and what helps?",
+        "Summarize the causes of the First World War for a high-school student.",
+        "What makes a good teacher? Discuss in a few paragraphs.",
+        "Compare living in a big city with living in the countryside."]
+CODE = ["Write a Python function that merges overlapping intervals, with a docstring and two tests.",
+        "Write a small Rust program that counts word frequencies from stdin and prints the top ten.",
+        "Write a JavaScript debounce function with comments and an example.",
+        "Write a SQL schema for a library (books, members, loans) and three example queries."]
+
+
+def builtin() -> list[dict]:
+    out = [{"msg": f.format(t=t), "max": 384} for t in TOPICS for f in FORMS]
+    out += [{"msg": m, "max": 384} for m in CHAT]
+    out += [{"msg": m, "max": 384} for m in CODE]
+    return out
+
+
+def load_prompts(path: str) -> list[dict]:
+    if not path:
+        return builtin()
+    return [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+
+
+def run_rank0(eng, a) -> dict:
+    from tokenizers import Tokenizer
+
+    from tensorfold.engine.exact_sampling import Sampling
+
+    from .batch import Job
+    from .encoding import encode
+    from .m2bench import Clock
+
+    tok = Tokenizer.from_file(str(Path(a.model) / "tokenizer.json"))
+    prompts = load_prompts(a.prompts)[a.skip:a.skip + a.count if a.count else None]
+    b = eng.batch
+    hot = Sampling(seed=4321, temperature=0.7, top_k=0, top_p=0.95)
+    rep = {"knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith("TF_DSV41_")}, "requests": []}
+    t0 = time.perf_counter()
+    for at in range(0, len(prompts), a.streams):
+        group = prompts[at:at + a.streams]
+        jobs, clocks, ths = [], [], []
+        for j, pr in enumerate(group):
+            ids = list(tok.encode(encode([{"role": "user", "content": pr["msg"]}], thinking=False),
+                                  add_special_tokens=False).ids)
+            n = (at + j)
+            smp = hot if (a.hot and n % a.hot == a.hot - 1) or float(pr.get("t", 0.0)) > 0 else None
+            jobs.append(b.submit(Job(ids, int(pr.get("max", 384)), smp)))
+            c = Clock()
+            clocks.append(c)
+            th = threading.Thread(target=b.collect, args=(jobs[-1], c))
+            th.start()
+            ths.append(th)
+        for th in ths:
+            th.join()
+        for pr, jb, c in zip(group, jobs, clocks):
+            rep["requests"].append({"msg": pr["msg"][:80], "tokens": len(c.toks), "tok_s": c.tok_s(),
+                                    "drafting": jb.stats.get("drafting")})
+        print(f"[draftcap] {min(at + a.streams, len(prompts))}/{len(prompts)} requests, "
+              f"{time.perf_counter() - t0:.0f} s", flush=True)
+    dl = getattr(eng.fw, "dlog", None)
+    if dl is not None:
+        dl.flush()
+    rep["wall_s"] = round(time.perf_counter() - t0, 1)
+    rep["m2_after"] = eng.fw.describe() if hasattr(eng.fw, "describe") else ""
+    return rep
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--out", default="draftcap.json")
+    ap.add_argument("--context", type=int, default=16384)
+    ap.add_argument("--parallel", type=int, default=4)
+    ap.add_argument("--streams", type=int, default=4)
+    ap.add_argument("--hot", type=int, default=4, help="every n-th request at T = 0.7 (0: all greedy)")
+    ap.add_argument("--prompts", default="")
+    ap.add_argument("--skip", type=int, default=0)
+    ap.add_argument("--count", type=int, default=0)
+    a = ap.parse_args(argv)
+    if a.rank == 0 and not os.environ.get("TF_DSV41_DRAFT_LOG"):
+        print("[draftcap] TF_DSV41_DRAFT_LOG is not set: nothing would be logged", file=sys.stderr)
+        return 2
+    from .engine import Dsv41Engine
+
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context,
+                      parallel=a.parallel, serving=True)
+    if a.rank != 0:
+        eng.follow()
+        return 0
+    rc = 0
+    try:
+        rep = run_rank0(eng, a)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(f"[draftcap] report {a.out}: {len(rep['requests'])} requests in {rep['wall_s']} s", flush=True)
+    except Exception as exc:          # noqa: BLE001 - rank 1 must still be told to stop
+        print(f"[draftcap] failed: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
+        rc = 1
+    finally:
+        eng.batch.stop()
+        eng.batch.send_stop()
+    return rc
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
