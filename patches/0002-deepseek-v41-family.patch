@@ -0,0 +1,387 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Horizontal fusion of the attention's EXL3 projections (``TF_DSV41_FUSED_PROJ``, default on; 0 = one upstream
+``Exl3Linear`` call a projection, as before). docs/DECODE-ROOFLINE.md section 5 (lever 1) has the inventory and the
+cost model.
+
+Why. A verify window runs ~300 upstream ``linear_kernel`` launches (G4 nsys: ~293 at K2 10 / 4 warps, 28 us mean,
+19 us median, + 40 ``wq_b``) and as many ``rot_in`` launches: each projection is one partial wave of short
+programs (every plan walks 8-10 k steps a warp), so a layer pays its projections' latencies one after another.
+Projections that read the same input run as ONE launch here (and one ``rot_in``):
+
+    x      wq_a (1,280) + wkv (512) [+ compressor wkv (512) + wgate (512) on the kv sources]   5,120 -> ...
+    qr     wq_b (16,384, 8 warps) + indexer wq_b (4,096, 4 warps) on the index sources       1,280 -> ...
+    o      wo_a's 4 groups of this rank (4,096 -> 1,024 each; inputs: column slices of o)
+    wo_b alone (it reads wo_a's output); the indexer ``weights_proj`` is a native bf16 matrix (``linear.Plain``).
+
+Design: a segment table, not restacked weights (``x3seg.cu``). Restacking along the output rows would be a
+concatenation of 128-column strips, but it cannot keep the bits: (1) every projection has its own input rotation
+``suh``, so a stacked matrix has no single ``rot_in``; (2) upstream's split plan ``plan(K, N)`` depends on N, and a
+stacked N changes SK (the split-K partial sums' order) or WK (the warps' ranges): other bits. The table keeps each
+projection's own words, ``svh``, ``suh`` and (SK, WK): program p of a launch is upstream's program (p - p0) % NB,
+(p - p0) // NB of its segment, so every output element is computed by the same statements in the same order.
+
+Bits: identical to the unfused path at the same plan (tests: ``test_dsv41_fused_proj_emu.py`` emulates both
+kernels' programs over this module's tables, ``tests/cuda/test_dsv41_fused_proj_gpu.py`` compares the launches on the
+real weights at R = 1..16). Prefill runs with the fast tag (``prefill_mm.active()``) keep their own GEMMs; the CPU
+twin is unchanged.
+
+The plan (G7, lever 1b; ``TF_DSV41_PROJ_PLAN``, default ``upstream``). Upstream's ``plan(K, N)`` splits K until a
+lone launch fills the SMs, so every warp walks only 8-10 k steps; fused launches are full with fewer splits. ``long``
+gives the attention's linears 20-32 k steps a warp (``PLANS``). That is another split-K summation order, so other
+bits than upstream (an fp32 reordering, a few ulp), while the structure holds: the plan is the shape's alone, set on
+the ``Exl3Linear`` objects (``apply_plan``), so every path and every row count sums alike. It is adopted after G7's
+gate (top-1 vs the kit's oracle >= 0.96, MMLU within 1 point); the disk sessions' compat ident carries the knob.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from . import numerics as N
+
+ENV = "TF_DSV41_FUSED_PROJ"
+MAXSEG = 8
+ROWS = 128                      # rows a launch (upstream's limit; longer windows in blocks of 128 rows)
+K2S = (4, 6, 8, 10, 12, 16)     # the widths x3seg.cu is built for (2-8 bits, integer)
+META = 11                       # ints a segment in the launch table (x3seg.cpp)
+
+
+def minb(env=None) -> int:
+    """``TF_DSV41_FUSED_PROJ_MINB`` (3 or 2): blocks an SM the 4-warp kernels' registers allow (x3seg.cu). 3 is
+    upstream's occupancy at K2 10 (168 registers, some spills), 2 spends 218 registers and spills none."""
+
+    v = int(((os.environ if env is None else env).get(ENV + "_MINB", "3").strip() or "3"))
+    if v not in (2, 3):
+        raise ValueError(f"{ENV}_MINB={v}: expected 2 or 3")
+    return v
+
+
+def enabled(env=None) -> bool:
+    v = ((os.environ if env is None else env).get(ENV, "1").strip() or "1")
+    if v not in ("0", "1"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+# -- the attention projections' split plan (TF_DSV41_PROJ_PLAN) -----------------------------------------------------
+PLAN_ENV = "TF_DSV41_PROJ_PLAN"
+PLAN_GROUPS = ("x", "q", "o", "wob")
+# "long": fewer K splits, 4 warps: k steps a warp x 20 (SK 4), q 20 (SK 1), o 32 (SK 2), wo_b 32 (SK 2) instead of
+# upstream's 10 / 10 / 8 / 8 (the head's 40-step walks run this kernel at 239 GB/s, the 8-10-step ones at ~159)
+PLANS = {"long": {"x": (4, 4), "q": (1, 4), "o": (2, 4), "wob": (2, 4)}}
+
+
+def plan_spec(env=None) -> dict | None:
+    """``TF_DSV41_PROJ_PLAN``: None for ``upstream`` (default: upstream's ``plan(K, N)``, the bits before G7), else
+    {group: (SK, WK)} for ``long`` or an explicit ``x:4,q:1,o:2,wob:2`` (``SK`` or ``SK/WK``, WK 4 or 8; groups left
+    out keep upstream's). Groups: x (wq_a, wkv, compressor wkv / wgate), q (wq_b, indexer wq_b), o (wo_a's groups),
+    wob (wo_b)."""
+
+    raw = ((os.environ if env is None else env).get(PLAN_ENV, "upstream").strip().lower() or "upstream")
+    if raw == "upstream":
+        return None
+    if raw in PLANS:
+        return dict(PLANS[raw])
+    out = {}
+    try:
+        for part in raw.split(","):
+            g, v = (s.strip() for s in part.split(":"))
+            sk, wk = (int(t) for t in v.split("/")) if "/" in v else (int(v), 4)
+            if g not in PLAN_GROUPS or sk < 1 or wk not in (4, 8) or g in out:
+                raise ValueError(part)
+            out[g] = (sk, wk)
+    except ValueError as exc:
+        raise ValueError(f"{PLAN_ENV}={raw!r}: expected upstream, long or e.g. x:4,q:1,o:2,wob:2 ({exc})") from None
+    return out
+
+
+def apply_plan(attn, spec: dict | None) -> None:
+    """Give the attention's EXL3 linears the plan ``spec`` (``plan_spec``), on the ``Exl3Linear`` objects themselves:
+    every call (fused or not: the compressor in CED's encoder pass, the drafter, exact prefill windows) then sums in
+    the same order, so a row's bits depend on its own values only (row invariance, batched == alone, drafted ==
+    serial) whichever path computes it. Called before ``build`` (a ``Fused`` reads the plans when made)."""
+
+    if not spec:
+        return
+    groups = {"x": [attn.wq_a, attn.wkv, attn.comp_wkv, attn.comp_wgate], "q": [attn.wq_b, attn.ix_wq_b],
+              "o": list(attn.wo_a), "wob": [attn.wo_b]}
+    for g, (sk, wk) in spec.items():
+        for lin in (lin_of(x) for x in groups[g] if x is not None):
+            if lin is None:
+                continue
+            if (lin.k // 16) % (sk * wk):
+                raise ValueError(f"{PLAN_ENV}: {g} K={lin.k} does not split into {sk} x {wk} warps of whole k tiles")
+            lin.split = (sk, wk)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    # upstream linear's flags exactly: the same contraction / codegen choices for the transcribed statements
+    return load(name="tf_dsv41_x3seg_v3", sources=[str(here / "x3seg.cpp"), str(here / "x3seg.cu")],
+                extra_include_paths=[str(Path(upstream.__file__).parent)],
+                extra_cuda_cflags=["-O3", "--expt-relaxed-constexpr"], verbose=False)
+
+
+# -- the tables (pure Python: the CUDA launcher and the emulator use the same ones) --------------------------------
+@dataclass(frozen=True)
+class Seg:
+    """One projection as the kernel sees it: K x N, width K2 (= 2 bits), its upstream plan (SK, WK), and where its
+    output goes (buffer ``out``, column ``col``)."""
+
+    k: int
+    n: int
+    k2: int
+    sk: int
+    wk: int
+    out: int = 0
+    col: int = 0
+
+    @property
+    def programs(self) -> int:
+        return (self.n // 128) * self.sk
+
+
+@dataclass(frozen=True)
+class Layout:
+    """A call's scratch and launches for M rows: ``xh_off`` / ``z_off`` / ``c_off`` a segment (elements of the fp16
+    rotated inputs, floats of Z, ints of the counters), ``launches`` [(K2, WK, [segment], meta ints, programs)]."""
+
+    m: int
+    xh_off: tuple
+    z_off: tuple
+    c_off: tuple
+    xh_total: int
+    z_total: int
+    c_total: int
+    launches: tuple
+
+
+def layout(segs: list[Seg], m: int) -> Layout:
+    """Offsets and launches of ``segs`` at ``m`` rows (1-128): one launch a width (K2), the segments in their order,
+    up to MAXSEG a launch; WK of a launch = its segments' largest (a smaller one idles its extra warps)."""
+
+    if not 1 <= m <= ROWS:
+        raise ValueError(f"layout: 1-{ROWS} rows, got {m}")
+    xh_off, z_off, c_off = [], [], []
+    xo = zo = co = 0
+    for s in segs:
+        if s.k % 128 or s.n % 128 or (s.k // 16) % (s.sk * s.wk) or s.wk not in (4, 8) or s.sk < 1:
+            raise ValueError(f"layout: segment {s} is not a valid upstream plan")
+        xh_off.append(xo)
+        z_off.append(zo)
+        c_off.append(co)
+        xo += m * s.k
+        zo += s.sk * m * s.n if s.sk > 1 else 0
+        co += 8 * (s.n // 128)
+    launches = []
+    for k2 in dict.fromkeys(s.k2 for s in segs):
+        idx = [i for i, s in enumerate(segs) if s.k2 == k2]
+        for a in range(0, len(idx), MAXSEG):
+            part = idx[a:a + MAXSEG]
+            meta, p = [], 0
+            for i in part:
+                s = segs[i]
+                tw = 4 * s.k2
+                meta += [s.k, s.n, s.sk, s.wk, 8 * tw, (s.k // 16) * 8 * tw, xh_off[i], z_off[i], c_off[i], s.col, p]
+                p += s.programs
+            launches.append((k2, max(segs[i].wk for i in part), tuple(part), tuple(meta), p))
+    return Layout(m, tuple(xh_off), tuple(z_off), tuple(c_off), xo, zo, co, tuple(launches))
+
+
+# -- the run-time object --------------------------------------------------------------------------------------------
+def lin_of(obj):
+    """The upstream ``Exl3Linear`` behind a forward linear (``linear.Exl3``, or a ``prefill_mm.FastLinear`` around
+    one), else None."""
+
+    inner = getattr(obj, "inner", obj)
+    lin = getattr(inner, "lin", None)
+    return lin if lin is not None and hasattr(lin, "words") else None
+
+
+def why_not(lin) -> str | None:
+    """None when x3seg takes this ``Exl3Linear`` as a segment, else why not."""
+
+    if lin is None:
+        return "not an EXL3 linear on CUDA"
+    if getattr(lin, "layout", "strips") != "strips" or lin.bias is not None:
+        return "layout / bias"
+    if lin.codebook != "mul1" or lin.k2 not in K2S:
+        return "codebook / width"
+    sk, wk = lin.split
+    if wk not in (4, 8) or (lin.k // 16) % (sk * wk):
+        return "plan"
+    return None
+
+
+class Fused:
+    """Several ``Exl3Linear`` as one rot_in launch + one linear launch a width. ``outs[i]``: the output buffer of
+    segment i (buffers in first-use order; a buffer's segments side by side in their order)."""
+
+    def __init__(self, lins: list, outs: list[int] | None = None, part: str = "seg") -> None:
+        if not 1 <= len(lins) <= MAXSEG:
+            raise ValueError(f"Fused: 1-{MAXSEG} projections")
+        for lin in lins:
+            if why_not(lin) is not None:
+                raise ValueError(f"Fused: {why_not(lin)}")
+        outs = list(range(len(lins))) if outs is None else list(outs)
+        width: dict[int, int] = {}
+        segs = []
+        for lin, o in zip(lins, outs):
+            sk, wk = lin.split
+            segs.append(Seg(lin.k, lin.n, lin.k2, sk, wk, o, width.get(o, 0)))
+            width[o] = width.get(o, 0) + lin.n
+        self.lins, self.segs, self.widths = list(lins), segs, [width[o] for o in sorted(width)]
+        self.part = part                                    # pdl.py's part (TF_DSV41_PDL): seg, or single
+        dev = lins[0].words.device
+        self.counters = torch.zeros((sum(8 * (s.n // 128) for s in segs),), dtype=torch.int32, device=dev)
+        self._layouts: dict[int, Layout] = {}
+        self._dense = None
+
+    def dense(self):
+        """The x3dn group of these matrices when every one is ``dense.wanted`` (TF_DSV41_DENSE), else None."""
+
+        from . import dense as D
+
+        if not all(D.wanted(lin) for lin in self.lins):
+            return None
+        if self._dense is None:
+            self._dense = D.Group(self.lins, [s.out for s in self.segs])
+        return self._dense
+
+    def layout(self, m: int) -> Layout:
+        lay = self._layouts.get(m)
+        if lay is None:
+            lay = self._layouts[m] = layout(self.segs, m)
+        return lay
+
+    def __call__(self, xs, dtype: torch.dtype = N.ACC) -> list[torch.Tensor]:
+        """y_b [M, width_b] for each output buffer b; ``xs``: one input [M, K] for every segment or a list (row-strided
+        views allowed: unit stride in K, 16-byte rows)."""
+
+        dn = self.dense()
+        if dn is not None:                                  # TF_DSV41_DENSE: x3dn, the same contract
+            return dn(xs, dtype)
+        xs = [xs] * len(self.segs) if isinstance(xs, torch.Tensor) else list(xs)
+        xs = [x if x.stride(-1) == 1 and (x.stride(0) * x.element_size()) % 16 == 0 and x.data_ptr() % 16 == 0
+              else x.contiguous() for x in xs]
+        M = xs[0].shape[0]
+        dev = xs[0].device
+        ys = [torch.empty((M, w), dtype=dtype, device=dev) for w in self.widths]
+        for a in range(0, M, ROWS):
+            b = min(M, a + ROWS)
+            self._block([x[a:b] for x in xs], [y[a:b] for y in ys])
+        return ys
+
+    def _block(self, xs: list, ys: list) -> None:
+        from . import pdl as P
+
+        lay = self.layout(xs[0].shape[0])
+        ext = _ext()
+        dev = xs[0].device
+        pdl = P.on(self.part, dev.index)                    # G10 (TF_DSV41_PDL): programmatic dependents, timing only
+        xh = torch.empty((lay.xh_total,), dtype=torch.float16, device=dev)
+        z = torch.empty((lay.z_total,), dtype=torch.float32, device=dev) if lay.z_total else None
+        for a in range(0, len(self.segs), MAXSEG):          # one rot_in launch (more only past 8 segments)
+            idx = range(a, min(len(self.segs), a + MAXSEG))
+            ext.rot_in([xs[i] for i in idx], [self.lins[i].suh for i in idx], xh, [lay.xh_off[i] for i in idx], pdl)
+        mb = minb()
+        for k2, wk, part, meta, programs in lay.launches:
+            ext.linear(xh, [self.lins[i].words for i in part], [self.lins[i].svh for i in part],
+                       [ys[self.segs[i].out] for i in part], z, self.counters, list(meta), programs, k2, wk, mb, pdl)
+
+
+_SINGLE: dict = {}
+
+
+def single(lin) -> Fused | None:
+    """G10 (TF_DSV41_PDL part ``single``): an unfused ``Exl3Linear`` as a 1-segment ``Fused`` (upstream's programs:
+    the same bits as ``lin(x, out=...)``, x3seg's PDL launches), cached on the matrix; None if x3seg cannot take it."""
+
+    key = id(lin)
+    hit = _SINGLE.get(key)
+    if hit is not None and hit.lins[0] is lin:
+        return hit
+    if why_not(lin) is not None or lin.words.device.type != "cuda" or torch.cuda.is_current_stream_capturing():
+        return None                                         # built eagerly only (its counters outlive any graph pool)
+    f = _SINGLE[key] = Fused([lin], part="single")
+    return f
+
+@dataclass
+class Groups:
+    """A block's fused attention projections (None where a group does not apply)."""
+
+    x2: Fused                   # wq_a, wkv
+    x4: Fused | None            # wq_a, wkv, compressor wkv [, wgate]: one buffer [kv | score] for the compressor
+    q: Fused | None             # wq_b, indexer wq_b
+    o: Fused | None             # wo_a's groups, one buffer (their concatenation, wo_b's input)
+
+    def x(self, x: torch.Tensor, comp: bool):
+        """(wq_a x, wkv x) in ACT, and the compressor projection fp32 [n, D] or [n, 2 D] when ``comp``."""
+
+        g = self.x4 if comp else self.x2
+        ys = g(x, N.ACT)
+        return ys[0], ys[1], (ys[2].to(N.ACC) if comp else None)
+
+    def qproj(self, qr: torch.Tensor):
+        """(wq_b qr, indexer wq_b qr) in ACT."""
+
+        q, qi = self.q(qr, N.ACT)
+        return q, qi
+
+    def oproj(self, o: torch.Tensor) -> torch.Tensor:
+        """wo_a over o [n, groups x 4,096]: [n, groups x 1,024] in ACT."""
+
+        gl = len(self.o.segs)
+        w = o.shape[1] // gl
+        return self.o([o[:, g * w:(g + 1) * w] for g in range(gl)], N.ACT)[0]
+
+
+def build(attn) -> Groups | None:
+    """The fused groups of a ``blocks.Attn`` on CUDA, or None (CPU twin, other widths / layouts). Also flags the
+    attention's matrices for x3dn under ``TF_DSV41_DENSE`` (``dense.mark``: fused or not, they sum alike)."""
+
+    from . import dense as D
+
+    D.mark(attn)
+    a = [lin_of(attn.wq_a), lin_of(attn.wkv)]
+    if any(why_not(x) for x in a):
+        return None
+    x2 = Fused(a)
+    x4 = None
+    if attn.comp_wkv is not None:
+        comp = [lin_of(attn.comp_wkv)] + ([lin_of(attn.comp_wgate)] if attn.comp_wgate is not None else [])
+        if not any(why_not(x) for x in comp):
+            x4 = Fused(a + comp, [0, 1] + [2] * len(comp))
+    q = None
+    if attn.ix_wq_b is not None:
+        qa = [lin_of(attn.wq_b), lin_of(attn.ix_wq_b)]
+        if not any(why_not(x) for x in qa):
+            q = Fused(qa)
+    oa = [lin_of(w) for w in attn.wo_a]
+    o = Fused(oa, [0] * len(oa)) if oa and len(oa) <= MAXSEG and not any(why_not(x) for x in oa) else None
+    return Groups(x2, x4, q, o)
+
+
+def active(blk) -> Groups | None:
+    """The block's groups when this call fuses: built, ``TF_DSV41_FUSED_PROJ`` on, not a fast prefill run."""
+
+    g = getattr(blk, "fused", None)
+    if g is None or not enabled():
+        return None
+    from . import prefill_mm as PM
+
+    return None if PM.active() else g
+
+
+__all__ = ["ENV", "PLANS", "PLAN_ENV", "Fused", "Groups", "Layout", "Seg", "active", "apply_plan", "build", "enabled",
+           "layout", "lin_of", "minb", "plan_spec", "single", "why_not"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/gate.py b/src/tensorfold/families/deepseek_v41/cuda/gate.py
new file mode 100644
index 0000000..47cf8ff
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/gate.py
@@ -0,0 +1,307 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Milestone M1's gates on the real checkpoint, two ranks (run on both Sparks at once, like the server):
+
+    python -m tensorfold.families.deepseek_v41.cuda.gate --model DIR --rank R --master ADDR [--port P]
+        --capture oracle-kit.json --out report.json [--decode 256] [--prompts 8]
+
+1. teacher-forced top-1: our argmax after every prompt position against the kit's ``prompt_logprobs`` rank-1 token
+   (the oracle captured in the baseline window), over the whole 2,048 tokens and over each prompt's first copy (the
+   prompts repeat their text, so later copies are easy); also the kit's top-1 in our top-5 and the logprob error;
+2. greedy replies (``--decode`` tokens after each prompt's first copy), recorded for the comparison with the kit's
+   (the oracle has no kit replies: that comparison needs a kit capture of greedy replies);
+3. row invariance on the real weights: one prompt's logits in prefill windows of ``chunk`` rows == windows of 8 ==
+   one row at a time, bit for bit, on both ranks;
+4. serial decode tok/s (the floor: the kit's SPEC_METHOD=none);
+5. boot seconds (the engine's construction, prepared folder or checkpoint).
+
+Rank 0 writes the report; exit status 0 when gates 1 (whole prompts), 3 and 4 pass.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+TOP1 = 0.99
+DECODE_FLOOR = 23.0              # tok/s: the kit's serial decode (SPEC_METHOD=none), ENGINE-PLAN section 11 M1
+
+
+def period(ids: list[int]) -> int:
+    """The first copy's length after BOS (the capture repeats BOS + text to length), or the whole prompt."""
+
+    n = len(ids)
+    for k in range(1, n - 1):
+        if all(ids[1 + i] == ids[1 + i + k] for i in range(n - 1 - k)):
+            return k
+    return n - 1
+
+
+def mem_available_gib() -> float:
+    for line in open("/proc/meminfo"):
+        if line.startswith("MemAvailable:"):
+            return int(line.split()[1]) / 2 ** 20
+    return -1.0
+
+
+def first_divergence(a: list[int], b: list[int]) -> int:
+    for i, (x, y) in enumerate(zip(a, b)):
+        if x != y:
+            return i
+    return min(len(a), len(b))
+
+
+class Scorer:
+    """Per prompt row: our global top-1 / top-5, and our logprob of the kit's top-1 (both ranks call every step)."""
+
+    def __init__(self, eng) -> None:
+        self.eng = eng
+
+    def _gather(self, x):
+        import torch
+
+        from tensorfold.cuda.comm import fast_gather
+
+        x = x.contiguous()
+        out = torch.empty((2 * x.numel(),), dtype=x.dtype, device=x.device)
+        fast_gather(self.eng.comm, x.view(-1), out)
+        return out.view(2, *x.shape)
+
+    def rows(self, logits, kit_top1) -> tuple[list[int], list[list[int]], list[float]]:
+        import torch
+
+        from . import pick as P
+
+        fw = self.eng.fw
+        lg = logits.float()
+        vals, ids = P.top(lg, 5)
+        ids = ids + fw.vocab_lo
+        lse = torch.logsumexp(lg, -1)
+        local = kit_top1 - fw.vocab_lo
+        ok = (local >= 0) & (local < lg.shape[1])
+        at = torch.where(ok, lg.gather(1, local.clamp(0, lg.shape[1] - 1)[:, None])[:, 0],
+                         torch.full_like(lse, float("-inf")))
+        packed = torch.cat([vals, ids.to(torch.float32), lse[:, None], at[:, None]], 1)
+        g = self._gather(packed).cpu().double()
+        v = torch.cat([g[0, :, :5], g[1, :, :5]], 1)
+        t = torch.cat([g[0, :, 5:10], g[1, :, 5:10]], 1).long()
+        top5, top1 = [], []
+        for r in range(v.shape[0]):
+            o = sorted(range(10), key=lambda j: (-float(v[r, j]), int(t[r, j])))
+            top5.append([int(t[r, j]) for j in o[:5]])
+            top1.append(top5[-1][0])
+        gl = torch.logaddexp(g[0, :, 10], g[1, :, 10])
+        lp = torch.maximum(g[0, :, 11], g[1, :, 11]) - gl
+        return top1, top5, lp.tolist()
+
+
+def run(a, comm=None, device: str = "cuda") -> int:
+    import torch
+
+    from .engine import Dsv41Engine
+
+    t0 = time.time()
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context, comm=comm,
+                      device=device, serving=False)
+    cuda = eng.device.type == "cuda"
+    sync = torch.cuda.synchronize if cuda else (lambda: None)
+    boot = time.time() - t0
+    launch = float(os.environ.get("TF_DSV41_LAUNCH_T0", "0") or 0)
+    mem = {"after_boot_alloc_gib": round(torch.cuda.memory_allocated() / 2 ** 30, 2) if cuda else None,
+           "after_boot_reserved_gib": round(torch.cuda.memory_reserved() / 2 ** 30, 2) if cuda else None,
+           "mem_available_after_boot_gib": round(mem_available_gib(), 2)}
+    if cuda:
+        torch.cuda.reset_peak_memory_stats()
+    mins = [mem_available_gib()]
+    rec = json.loads(Path(a.capture).read_text()) if a.rank == 0 else None
+    if getattr(a, "profile", 0):        # debugging: where a serial decode step's time goes (rank 0 prints)
+        ids = eng._share(rec["prompts"][0]["ids"][:256] if a.rank == 0 else None)
+        eng.fw.reset()
+        lg = eng.fw.prompt(ids)
+        tok = int(eng.choose(lg, [len(ids)], None)[0])
+        for _ in range(8):
+            lg = eng.fw.step([tok])
+        sync()
+        from torch.profiler import ProfilerActivity, profile
+        with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+            t1 = time.time()
+            for _ in range(a.profile):
+                lg = eng.fw.step([tok])
+                tok = int(eng.choose(lg, [0], None)[0])
+            sync()
+            dt = (time.time() - t1) / a.profile
+        from .forward import Seg
+        t2 = time.time()
+        for _ in range(20):
+            eng.fw._engram_inputs([Seg(0, eng.fw.slots[0].pos, (tok,))])
+        sync()
+        te = (time.time() - t2) / 20
+        if a.rank == 0:
+            print(f"profile: {1e3 * dt:.1f} ms a step; Engram inputs (host hash + reads + gather) {1e3 * te:.2f} ms",
+                  flush=True)
+            print(prof.key_averages().table(sort_by="self_cpu_time_total", row_limit=40), flush=True)
+            print(prof.key_averages().table(sort_by="self_cuda_time_total", row_limit=30), flush=True)
+        return 0
+    if getattr(a, "trace", ""):         # debugging: the streams after every block for the first N tokens of prompts
+        n_tok, plist = a.trace.split(":")
+        n_tok = int(n_tok)
+        for p in [int(x) for x in plist.split(",")]:
+            ids = eng._share(rec["prompts"][p]["ids"][:n_tok] if a.rank == 0 else None)
+            eng.fw.reset()
+            eng.fw.trace = {}
+            out = []
+            for s0 in range(0, len(ids), eng.fw.chunk):
+                lg = eng.fw.step(ids[s0:s0 + eng.fw.chunk])
+                from .forward import greedy
+                out.append(greedy(eng.fw, lg).cpu())
+            if a.rank == 0:
+                torch.save({L: t.float().cpu() for L, t in eng.fw.trace.items()} | {"top1": torch.cat(out)},
+                           str(Path(a.out).parent / f"ours-p{p}-n{n_tok}.pt"))
+            eng.fw.trace = None
+        return 0
+    n = eng._share([min(a.prompts, len(rec["prompts"]))] if a.rank == 0 else None)[0]
+    sc = Scorer(eng)
+    report: dict = {"boot_s": round(boot, 1), "launch_to_ready_s": round(time.time() - launch, 1) if launch else None,
+                    "knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TF_DSV41_", "GLM53_TF_"))},
+                    "prompts": []}
+    agree = total = first_agree = first_total = top5 = 0
+    errs: list[float] = []
+    for p in range(n):
+        ids = eng._share(rec["prompts"][p]["ids"] if a.rank == 0 else None)
+        kit = eng._share([(e["top"][0][0] if e and e.get("top") else -1)
+                          for e in rec["prompts"][p]["positions"]] if a.rank == 0 else None)
+        ours, ours5, lps = [], [], []
+
+        def every(start, logits, kit=kit, ids=ids):
+            nxt = torch.tensor([kit[start + i + 1] if start + i + 1 < len(ids) else -1
+                                for i in range(logits.shape[0])], device=logits.device)
+            t1, t5, lp = sc.rows(logits, nxt)
+            ours.extend(t1)
+            ours5.extend(t5)
+            lps.extend(lp)
+            mins.append(mem_available_gib())
+
+        eng.fw.reset()
+        tp = time.time()
+        eng.fw.prompt(ids, every=every)
+        sync()
+        prefill_s = time.time() - tp
+        per = period(ids)
+        pa = pt = fa = ft = 0
+        miss = []
+        for i in range(len(ids) - 1):
+            k = kit[i + 1]
+            if k < 0:
+                continue
+            hit = ours[i] == k
+            pa, pt = pa + hit, pt + 1
+            if not hit and a.rank == 0:
+                top = rec["prompts"][p]["positions"][i + 1]["top"]
+                miss.append([i + 1, k, ours[i], round(top[0][1] - top[1][1], 4) if len(top) > 1 else None,
+                             round(lps[i], 4)])
+            top5 += k in ours5[i]
+            errs.append(abs(lps[i] - rec["prompts"][p]["positions"][i + 1]["top"][0][1]) if a.rank == 0 else 0.0)
+            if i + 1 <= per:
+                fa, ft = fa + hit, ft + 1
+        agree, total, first_agree, first_total = agree + pa, total + pt, first_agree + fa, first_total + ft
+        reply: list[int] = []
+        stats = {"decode_tok_s": None}
+        if a.decode > 0:
+            stats = eng._run(ids[:1 + per], a.decode, None, False, lambda new: reply.extend(new) and False)
+        mins.append(mem_available_gib())
+        report["prompts"].append({"tokens": len(ids), "first_copy": per, "top1": pa / max(pt, 1),
+                                  "top1_first_copy": fa / max(ft, 1), "prefill_s": round(prefill_s, 2),
+                                  "prefill_tok_s": round(len(ids) / max(prefill_s, 1e-9), 1),
+                                  "greedy_reply": reply, "decode_tok_s": stats["decode_tok_s"],
+                                  "misses": miss})
+        if a.rank == 0:
+            print(f"prompt {p}: top-1 {pa / max(pt, 1):.4f} (first copy of {per}: {fa / max(ft, 1):.4f}), "
+                  f"prefill {prefill_s:.1f}s, decode {stats['decode_tok_s']} tok/s", flush=True)
+    # row invariance on the real weights: one prompt in windows of chunk / 8 / 1 rows
+    ids = eng._share(rec["prompts"][0]["ids"][:2 * eng.fw.chunk + 3] if a.rank == 0 else None)
+    if getattr(a, "invariance", True):
+        outs = []
+        for size in (eng.fw.chunk, 8, 1):
+            eng.fw.reset()
+            got = []
+            for s in range(0, len(ids), size):
+                got.append(eng.fw.step(ids[s:s + size]).clone())
+            outs.append(torch.cat(got))
+        same = [int(torch.equal(outs[0], outs[1])), int(torch.equal(outs[0], outs[2]))]
+        if not all(same):
+            for j, o in ((1, outs[1]), (2, outs[2])):
+                d = (o - outs[0]).abs().amax(-1)
+                bad = (d > 0).nonzero().flatten().tolist()
+                print(f"[rank {a.rank}] invariance: windows {(8, 1)[j - 1]}: {len(bad)} rows differ, first "
+                      f"{bad[:8]}, max |d| {float(d.max()):.3g}", flush=True)
+        both = eng._gather_ints(same)
+    else:
+        both = [[0, 0], [0, 0]]
+    invariant = all(both[0]) and all(both[1])
+    tok_s = [p["decode_tok_s"] for p in report["prompts"] if p["decode_tok_s"]]
+    report.update({
+        "top1_agreement": agree / max(total, 1), "top1_first_copy": first_agree / max(first_total, 1),
+        "kit_top1_in_our_top5": top5 / max(total, 1), "positions": total,
+        "median_abs_logprob_err": sorted(errs)[len(errs) // 2] if errs else None,
+        "row_invariance": {"windows_of_8": bool(both[0][0] and both[1][0]), "one_row": bool(both[0][1] and both[1][1]),
+                           "rows": len(ids)},
+        "decode_tok_s_median": sorted(tok_s)[len(tok_s) // 2] if tok_s else None,
+        "memory": {**mem, "peak_alloc_gib": round(torch.cuda.max_memory_allocated() / 2 ** 30, 2) if cuda else None,
+                   "peak_reserved_gib": round(torch.cuda.max_memory_reserved() / 2 ** 30, 2) if cuda else None,
+                   "workspace_peak_gib": round((torch.cuda.max_memory_allocated() - torch.cuda.memory_allocated())
+                                               / 2 ** 30, 2) if cuda else None,
+                   "mem_available_min_gib": round(min(mins), 2)},
+        "gates": {}})
+    mems = eng._gather_ints([int(report["memory"]["mem_available_min_gib"] * 100),
+                             int((report["memory"]["peak_reserved_gib"] or 0) * 100)])
+    report["memory"]["per_rank_mem_available_min_gib"] = [m[0] / 100 for m in mems]
+    report["memory"]["per_rank_peak_reserved_gib"] = [m[1] / 100 for m in mems]
+    if getattr(a, "kit_replies", "") and a.rank == 0:
+        kit_r = json.loads(Path(a.kit_replies).read_text())["replies"]
+        div = [first_divergence(p["greedy_reply"], k) for p, k in zip(report["prompts"], kit_r)]
+        full = [d >= min(len(p["greedy_reply"]), len(k)) for d, p, k in zip(div, report["prompts"], kit_r)]
+        report["greedy_vs_kit"] = {"first_divergence": div, "identical": full, "identical_n": sum(full)}
+    g = report["gates"]
+    g["top1"] = report["top1_agreement"] >= TOP1
+    g["row_invariance"] = invariant
+    g["decode_floor"] = (report["decode_tok_s_median"] or 0) >= DECODE_FLOOR
+    g["boot_le_90s"] = boot <= 90
+    g["boot_le_60s"] = boot <= 60
+    if "greedy_vs_kit" in report:
+        g["greedy_6_of_8"] = report["greedy_vs_kit"]["identical_n"] >= 6
+    report["pass"] = bool(g["top1"] and g["row_invariance"] and g["decode_floor"])
+    if a.rank == 0:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(report, indent=1))
+        print(json.dumps({k: v for k, v in report.items() if k != "prompts"}, indent=1), flush=True)
+    a.report = report
+    return 0 if report["pass"] else 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--capture", default="", help="the kit's oracle (rank 0)")
+    ap.add_argument("--out", default="m1-report.json")
+    ap.add_argument("--decode", type=int, default=256)
+    ap.add_argument("--prompts", type=int, default=8)
+    ap.add_argument("--context", type=int, default=4096)
+    ap.add_argument("--no-invariance", dest="invariance", action="store_false", help="skip gate 3 (A/B runs)")
+    ap.add_argument("--kit-replies", default="", help="the kit's greedy replies (oracle greedy capture), rank 0")
+    ap.add_argument("--profile", type=int, default=0, help="debugging: profile N serial decode steps")
+    ap.add_argument("--trace", default="", help="N:p,q debugging: save the streams after every block (rank 0)")
+    a = ap.parse_args(argv)
+    if a.rank == 0 and not a.capture:
+        ap.error("rank 0 needs --capture")
+    return run(a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/gmbench.py b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
