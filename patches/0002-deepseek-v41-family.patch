+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The torch paths' storage precisions, read at call time: bf16 activations, fp32 results, the kit's quantization
+(fp16 inputs of the EXL3 linears, FP8 KV rows).
+
+``exact()`` (tests, CPU only) makes every storage boundary float64 and drops the quantization, so the forward computes
+the model's real-number function to ~1e-12 and can be compared with the reference's math with no rounding noise: a
+wrong position, ring slot, split or selection then shows as a large error, not as a bf16 flip. The GPU kernels have
+their own dtypes; ``exact()`` applies to the torch twins and fallbacks only.
+"""
+
+from __future__ import annotations
+
+import os
+from contextlib import contextmanager
+
+import torch
+
+ACT = torch.bfloat16          # activations between kernels (streams, layer inputs, projections)
+ACC = torch.float32           # fp32 results (partials, mixes, logits)
+QUANT = True                  # fp16 inputs of EXL3 linears, FP8 KV rows
+# the head's output as the kit returns it (bf16: its EXL3 head casts to the activation dtype); held in ACC.
+# TF_DSV41_LOGITS=fp32 keeps the unrounded fp32 logits (A/B only: greedy ties then differ from the kit's).
+LOGITS = torch.float32 if os.environ.get("TF_DSV41_LOGITS", "bf16").strip().lower() == "fp32" else torch.bfloat16
+# the kit's TP=2 roundings (vLLM's row-parallel outputs and its EXL3 MoE): each rank's attention / MoE partial is bf16
+# before the bf16 all-reduce, and the routed weights (x 1.5) are fp16 in its expert kernels. TF_DSV41_KIT_ROUNDING=0
+# keeps fp32 partials and weights (A/B). Off in exact().
+KIT_ROUNDING = os.environ.get("TF_DSV41_KIT_ROUNDING", "1").strip().lower() not in ("0", "off", "no", "false")
+
+
+@contextmanager
+def exact():
+    global ACT, ACC, QUANT, LOGITS, KIT_ROUNDING
+    old = ACT, ACC, QUANT, LOGITS, KIT_ROUNDING
+    ACT, ACC, QUANT, LOGITS, KIT_ROUNDING = torch.float64, torch.float64, False, torch.float64, False
+    try:
+        yield
+    finally:
+        ACT, ACC, QUANT, LOGITS, KIT_ROUNDING = old
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pctree.py b/src/tensorfold/families/deepseek_v41/cuda/pctree.py
