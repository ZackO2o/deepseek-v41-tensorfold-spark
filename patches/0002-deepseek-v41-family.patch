+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_sink_rows_all_logits_below_underflow(E, topk):
+    """router.py's G4 case: a row reduced to one massive channel, every logit in [-60, -34] (below -16.6, where
+    log(1 + e^z) is 0 in fp32): finite weights, float64's picks and weights."""
+
+    C = 2455
+    g = torch.Generator().manual_seed(0)
+    x = torch.zeros((3, RG.D))
+    x[:, C] = torch.tensor([64.0, 48.0, 32.0])
+    x = x.to(torch.bfloat16)
+    w = torch.randn((E, RG.D), generator=g) * 1e-3
+    w[:, C] = torch.linspace(-60.0, -34.0, E)[torch.randperm(E, generator=g)] / 64.0
+    w = w.to(torch.bfloat16).contiguous()
+    b = torch.randperm(E, generator=g) * 1e-3
+    pick, wts = RG.emulate(x, w, b, topk, True, 1.5)
+    assert bool(torch.isfinite(wts).all())
+    rp, rw, _ = _f64_route(x, w, b, topk)
+    assert (pick[:, :topk].numpy() == rp).all()
+    np.testing.assert_allclose(wts[:, :topk].numpy(), rw, rtol=1e-4, atol=0)
+    np.testing.assert_allclose(wts[:, :topk].double().sum(1).numpy(), 1.5, rtol=1e-6)
