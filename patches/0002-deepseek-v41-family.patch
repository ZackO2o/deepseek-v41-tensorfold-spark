index 0000000..d662e5a
--- /dev/null
+++ b/tests/dsv41_x3tc_ptx.py
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Compile ``x3tc``'s kernels for sm_121a (GB10) without a GPU (Triton's bundled ptxas) at the model's shapes and
+report registers / spills / shared memory (the development tree's (unpublished) csa2_ptx.py pattern): ``python tests/dsv41_x3tc_ptx.py``.
+``test_dsv41_x3tc_compile.py`` runs it under pytest."""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+if __name__ == "__main__":
+    os.environ.pop("TRITON_INTERPRET", None)
+
+import triton  # noqa: E402
+from triton.backends.compiler import GPUTarget  # noqa: E402
+from triton.compiler import ASTSource  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import x3tc as X  # noqa: E402
+
+TGT = GPUTarget("cuda", 121, 32)
+SMEM = 99 * 1024                        # sm_121's shared memory a block (G1: the router / attention overflows)
+GSIG = {"XG": "*fp16", "XU": "*fp16", "TG": "*i32", "TU": "*i32", "SVG": "*fp16", "SVU": "*fp16", "SUD": "*fp16",
+        "XD": "*fp16", "H": "*bf16", "ITEM_E": "*i32", "ITEM_M": "*i32", "CNT": "*i32", "OFF": "*i32",
+        "ORDER": "*i32", "E": "i32", "limit": "fp32", "se_t": "i64", "sk_t": "i32"}
+DSIG = {"XD": "*fp16", "TD": "*i32", "SVD": "*fp16", "WTS": "*fp32", "Y": "*fp32", "H": "*bf16", "ITEM_E": "*i32",
+        "ITEM_M": "*i32", "CNT": "*i32", "OFF": "*i32", "ORDER": "*i32", "E": "i32", "se_t": "i64", "sk_t": "i32",
+        "n0": "i32", "y_stride": "i32"}
+
+
+def compile_one(fn, sig: dict, cst: dict, warps: int = 8, stages: int = 2):
+    sig = dict(sig)
+    for k in cst:
+        sig[k] = "constexpr"
+    return triton.compile(ASTSource(fn=fn, signature=sig, constexprs=dict(cst)), target=TGT,
+                          options={"num_warps": warps, "num_stages": stages})
+
+
+def ptxas(ptx: str) -> dict:
+    from triton.backends.nvidia import compiler as nvc
+
+    exe = nvc.get_ptxas(TGT.arch).path if hasattr(nvc, "get_ptxas") else nvc._path_to_binary("ptxas")[0]
+    with tempfile.TemporaryDirectory() as td:
+        p = Path(td) / "k.ptx"
+        p.write_text(ptx)
+        r = subprocess.run([exe, "-arch=sm_121a", "-v", str(p), "-o", str(Path(td) / "k.cubin")], capture_output=True, check=False,
+                           text=True)
+    if r.returncode:
+        raise RuntimeError(r.stderr[-2000:])
+    regs = re.search(r"Used (\d+) registers", r.stderr)
+    sp = re.search(r"(\d+) bytes spill stores, (\d+) bytes spill loads", r.stderr)
+    return {"regs": int(regs.group(1)) if regs else -1, "spill": int(sp.group(1)) + int(sp.group(2)) if sp else 0}
+
+
+def cases(bits=(3, 2), asm=(True, False)):
+    kt = X.config()[0]
+    for b in bits:
+        for a in asm:
+            cst = {"D": 5120, "I": 1152, "BITS": b, "ASM": a, "KT": kt}
+            yield f"gateup_b{b}{'_asm' if a else ''}", X._gateup, GSIG, cst
+            yield f"down_b{b}{'_asm' if a else ''}", X._down, DSIG, cst
+
+
+def run(**kw) -> dict:
+    _, stages, warps = X.config()
+    out = {}
+    for name, fn, sig, cst in cases(**kw):
+        k = compile_one(fn, sig, cst, warps, stages)
+        out[name] = {**ptxas(k.asm["ptx"]), "smem": int(k.metadata.shared),
+                     "dp4a": "dp4a" in k.asm["ptx"], "mma": "mma.sync" in k.asm["ptx"]}
+    return out
+
+
+if __name__ == "__main__":
+    for k, v in run().items():
+        print(f"{k:20s} {v}", flush=True)
