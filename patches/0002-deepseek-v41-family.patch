+"""Routed EXL3 experts for fast prefill segments in CUDA (``TF_DSV41_FAST_EXPERTS=gm``; ``x3gm.cu``; never decode).
+
+Where the time goes (G5 nsys, 32K, all on): routed experts 17.0 s of 32.9 s GPU, ~45 ms a 2,048-row layer segment on
+one rank, against floors (one rank, 3-bit layer, 2,048 rows x top-6 of 384 = 12,288 pairs, ~32 members an expert):
+
+    DRAM   trellis 2.55 GB once + Xg/Xu 0.25 + Xd 0.06 + Y 0.25 written and read back 0.25 = ~3.4 GB -> 14.3 ms
+           at 235 GB/s (G1 probe 3 reached 245-255)
+    MMA    2 x 12,288 x 3 x 5,120 x 1,152 = 435 GFLOP -> 4.0 ms at the measured 110 TFLOP/s mma.sync f16
+    decode 6.8 G weights once x ~6 instructions (window, imul, dp4a, hfma2) / (48 SMs x 128 lanes x 2.5 GHz) -> ~2.7 ms
+
+so the segment is DRAM-bound at ~14 ms. Upstream's grouped kernel (the decode path) runs 1,024-row blocks (its group
+kernel's limit), so every weight is streamed twice a segment and decoded once a 16 members, with split-K partials
+(Z, 0.45 GB a block) summed by separate epilogue kernels: ~45 ms.
+
+Why x3tc (Triton, 3-5x SLOWER: ~230 ms a layer segment, 1.9 TFLOP/s, 11 GB/s of trellis) lost: it is bound by
+neither floor but by the decode path's codegen and latency. (1) Triton has no fragment-level control: the 7-D
+reshape / permute of the decoded tile and its conversion to the dot operand layout go through shared memory every k
+step, for both matrices; CUDA's lane decode IS the mma fragment (zero data movement). (2) Each value gathers its two
+trellis words with its own int64 address: two scalar loads a value (16x upstream's one 16-byte load a lane a tile),
+irregular, so Triton's pipeliner cannot turn them into cp.async stages and every k step waits on L2 / DRAM latency.
+(3) One 256-thread CTA an SM at ~200 registers hides none of that latency, and 32-row member blocks decode each weight
+1.5-2x (masked rows included). On sm_121 Triton also has no wgmma / TMA to lean on: mma.sync is the only tensor-core
+path, so the kernel's quality is all in data movement, which Triton does not expose.
+
+Design picked by the cost model -- (b), fused decode + mma, the GLM spark engine's ``fat`` kernel at this geometry:
+
+- persistent CTAs claim items (expert pass of <= 64 members, one 128-column Hadamard block) by ticket; per stage of a
+  cp.async ring they copy the members' rows (gathered by pair index, XOR-swizzled) and the item's trellis words as
+  stored (16 K2 bytes a tile); each warp decodes 2 column tiles from shared memory straight into the m16n8k16 A
+  fragment (W^T: upstream's lane layout is the A fragment) and runs it against up to 8 n8 groups of members
+  (ldmatrix B): a weight is read from DRAM once a segment and decoded once a 64-member pass;
+- full K in one mma chain a warp (no split-K, no Z), the epilogue (fwht128, ACT_F32 SwiGLU, the down input's
+  rotation; or svh_d) in the CTA; Y fp32 a pair, then upstream's ``combine`` (fma in slot order);
+- one 2,048-row block a segment: Xg / Xu, Xd and Y alias the shared upstream scratch (``moe.scratch_for``; Y reuses
+  Xg / Xu's bytes once gate/up is done), so nothing new is allocated at 2,048 rows (memory floor unchanged).
+
+Expected: GLM's fat runs 1.25-1.36x its DRAM floor at 2,048 rows (EXPERT-TC / EXPERT-PREFILL-V2), so ~18-21 ms a
+segment + rot 1 ms + combine 1 ms vs ~45 now: -23 to -26 ms a layer segment. At 32K with replay (~340 layer segments)
+-8 to -9 s of 34 s: ~965 -> ~1,250-1,330 tok/s; full prefill (no replay) ~483 -> ~600 tok/s.
+
+Rejected, kept as notes -- (a) decode to a bf16 scratch, then a grouped bf16 GEMM: the scratch round trip is 2 bytes
+written + 2 read a weight against 0.375 read (3-bit), i.e. 27 GB a layer segment (~115 ms at 235 GB/s), 8x the floor
+at ~32 rows an expert; it pays only above ~16 x 4 / 0.375 = 170 rows an expert (8K+ segments, which the 4-6 GiB floor
+does not allow at 4 x 300K), and one layer's decode is 13.6 GB (expert groups only cut it to groups x 35 MB, not the
+bytes). GLM 0080's v1 (dequant once into shared memory, reuse across row tiles) was shared-memory-bandwidth-bound.
+Next steps if gm is DRAM-bound as predicted: Y in bf16 (-0.25 GB), Xg shared by gate / up when their sign vectors
+match (``shx``: half the rot and row traffic), fat2's cross-item ring (GLM 0590), 4,096-row segments for one stream.
+
+Exactness (the fast tag): row-independent and deterministic (fixed chains, no atomics on data, one writer an
+element); other bits than grouped, hence its own tag value (``prefill_mm.tag_grid``: 48).
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+BM = 64                                  # members a pass (NG 8 x n8)
+K2S = (4, 6, 8)                          # widths the kernels are built for (2 / 3 / 4 bits); others fall back
+ENV_CFG = "TF_DSV41_GM_CFG"              # "gu,dn": gu a (by shx) / 0 / 1, dn 0 / 1 (x3gm.cu GM_GU* / GM_DN*)
+ENV_TICKET = "TF_DSV41_GM_TICKET"        # 1: CTAs claim items by ticket; 0: static stride
+ENV_ROWS = "TF_DSV41_GM_ROWS"            # rows a block (2,048: one block a 2,048-row segment)
+
+
+def config(env=None) -> dict:
+    env = os.environ if env is None else env
+    raw = (env.get(ENV_CFG, "") or "a,0").strip()
+    try:
+        gu, dn = (v.strip() for v in raw.split(","))
+        gu_v = None if gu == "a" else int(gu)
+        dn_v = int(dn)
+    except ValueError:
+        gu_v = dn_v = -1
+    if gu_v not in (None, 0, 1) or dn_v not in (0, 1):
+        raise ValueError(f"{ENV_CFG}={raw!r}: expected gu,dn with gu in a/0/1 and dn in 0/1")
+    rows = int(env.get(ENV_ROWS, "") or 2048)
+    if rows < 16:
+        raise ValueError(f"{ENV_ROWS}={rows}: at least 16")
+    return {"gu": gu_v, "dn": dn_v, "ticket": (env.get(ENV_TICKET, "1").strip() or "1") != "0", "rows": rows}
+
+
+def gu_cfg(cfg: dict, shx: bool) -> int:
+    """gate/up configuration: auto = 0 (4 k tiles a stage, 2 CTAs an SM) with one shared input, 1 (2 k tiles, 4
+    stages: 45 KB, still 2 CTAs an SM) with two."""
+
+    return (0 if shx else 1) if cfg["gu"] is None else cfg["gu"]
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_x3gm_v1", sources=[str(here / "x3gm.cpp"), str(here / "x3gm.cu")],
+                extra_include_paths=[str(Path(upstream.__file__).parent)], extra_cuda_cflags=["-O3", "-lineinfo"],
+                verbose=False)
+
+
+def k2_of(trellis: torch.Tensor) -> int:
+    return int(trellis.shape[-1]) // 8
+
+
+def words(trellis: torch.Tensor) -> torch.Tensor:
+    """A stored stack int16 [E, K/16, N/16, 16 bits] as int32 words [E, K/16, N/16, 4 K2] (a view)."""
+
+    if trellis.dtype != torch.int16 or not trellis.is_contiguous() or trellis.shape[-1] % 2:
+        raise ValueError("x3gm: contiguous int16 trellis stacks")
+    return trellis.view(torch.int32)
+
+
+def supported(gate, up, down) -> str | None:
+    """None when the gm kernels take this block (``weights.X3Stack`` gate / up / down), else why not."""
+
+    tg, tu, td = gate.trellis, up.trellis, down.trellis
+    if getattr(gate, "codebook", "mul1") != "mul1":
+        return "codebook"
+    if tg.shape != tu.shape or tg.dim() != 4 or td.dim() != 4:
+        return "shapes"
+    D, I = tg.shape[1] * 16, tg.shape[2] * 16
+    if td.shape[1] * 16 != I or td.shape[2] * 16 != D or D % 128 or I % 128 or (I // 16) % 4 or (D // 16) % 4:
+        return "shapes"
+    if k2_of(tg) not in K2S or k2_of(td) not in K2S or k2_of(tu) != k2_of(tg):
+        return "width"
+    return None
+
+
+def plan(pick: torch.Tensor, E: int, bm: int = BM):
+    """Passes of a block's routed pairs, on the device, no host sync: (order, pe, poff, pcnt, npass). ``order`` is
+    the pair indices (row * slots + slot) by expert, rows ascending; pass t is ``pcnt[t]`` members of expert
+    ``pe[t]`` from ``order[poff[t]]``; ``npass[0]`` passes are real (the rest: count 0, never read)."""
+
+    flat = pick.reshape(-1).to(torch.int64)
+    P = flat.numel()
+    order = torch.argsort(flat, stable=True).to(torch.int32)
+    cnt = torch.bincount(flat, minlength=E)[:E]
+    off = torch.cumsum(cnt, 0) - cnt
+    npe = (cnt + bm - 1) // bm
+    pend = torch.cumsum(npe, 0)
+    tmax = P // bm + E + 1                           # sum ceil(c / bm) <= P / bm + E
+    tt = torch.arange(tmax, device=pick.device)
+    e = torch.searchsorted(pend, tt, right=True).clamp_(max=E - 1)
+    j = tt - (pend - npe)[e]
+    poff = (off[e] + j * bm).clamp_(max=max(P - 1, 0))
+    pcnt = (cnt[e] - j * bm).clamp_(min=0, max=bm)
+    i32 = torch.int32
+    return order, e.to(i32), poff.to(i32), pcnt.to(i32), pend[-1:].to(i32)
+
+
+class Buffers:
+    """Per-pair buffers of a row block, aliased into the shared upstream scratch when it holds them: X (gate / up
+    rotated inputs) and later Y in its ``z``, Xd in its ``xg``. ``rows``: the block's rows (what fits, <= want)."""
+
+    def __init__(self, scratch, want: int, R: int, slots: int, D: int, I: int, mats_x: int, device) -> None:
+        def fits(r: int) -> bool:
+            P = r * slots
+            return (z is not None and max(mats_x * P * D * 2, P * D * 4) <= z.numel() * z.element_size()
+                    and xgs is not None and P * I * 2 <= xgs.numel() * xgs.element_size())
+
+        z, xgs = getattr(scratch, "z", None), getattr(scratch, "xg", None)
+        rows = min(want, R)
+        while rows > 16 and not fits(rows):
+            rows //= 2
+        self.rows = rows
+        P = rows * slots
+        if fits(rows):
+            raw = z.view(-1)
+            self.x = raw.view(torch.float16)[:mats_x * P * D].view(mats_x, P, D)
+            self.y = raw.view(torch.float32)[:P * D].view(P, D)
+            self.xd = xgs.view(-1).view(torch.float16)[:P * I].view(P, I)
+            self.aliased = True
+        else:
+            self.rows = rows = min(want, R)
+            P = rows * slots
+            self.x = torch.empty((mats_x, P, D), dtype=torch.float16, device=device)
+            self.y = torch.empty((P, D), dtype=torch.float32, device=device)
+            self.xd = torch.empty((P, I), dtype=torch.float16, device=device)
+            self.aliased = False
+        self.ticket = torch.zeros((2,), dtype=torch.int32, device=device)
+
+
+def shared_input(moe, gate, up) -> bool:
+    """gate and up share their input sign vector (one rotated input), checked once a block."""
+
+    got = getattr(moe, "_gm_shx", None)
+    if got is None:
+        got = bool(torch.equal(gate.suh, up.suh))
+        try:
+            moe._gm_shx = got
+        except AttributeError:
+            pass
+    return got
+
+
+def routed(moe, x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor, limit: float) -> torch.Tensor | None:
+    """This rank's routed experts' partial fp32 [R, D] for a fast prefill run (``prefill_moe``): ``pick`` / ``wts``
+    [R, topk] (routed slots only, the kit's fp16 weights); None when the block is not one gm takes."""
+
+    m = moe.block.keep[0]
+    if supported(m.w1, m.w3, m.w2) is not None:
+        return None
+    return run(x, pick, wts, m.w1, m.w3, m.w2, limit, scratch=moe.scratch, shx=shared_input(moe, m.w1, m.w3))
+
+
+def run(x, pick, wts, gate, up, down, limit: float, *, scratch=None, shx: bool | None = None, cfg: dict | None = None,
+        out: torch.Tensor | None = None) -> torch.Tensor:
+    """The routed experts of rows x [R, D] (gate / up / down: ``weights.X3Stack``, this rank's slices), in row blocks
+    of ``cfg['rows']``: out[r] = sum over slots in order of wts[r, s] * Y[r, s] (fp32)."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    why = supported(gate, up, down)
+    if why is not None:
+        raise ValueError(f"x3gm: {why}")
+    cfg = config() if cfg is None else cfg
+    R, D = x.shape
+    S = pick.shape[1]
+    E = gate.trellis.shape[0]
+    I = gate.trellis.shape[2] * 16
+    shx = bool(torch.equal(gate.suh, up.suh)) if shx is None else shx
+    mats_x = 1 if shx else 2
+    ext, up_ext = _ext(), x3._ext()
+    tg, tu, td = words(gate.trellis), words(up.trellis), words(down.trellis)
+    k2gu, k2d = k2_of(gate.trellis), k2_of(down.trellis)
+    cg = gu_cfg(cfg, shx)
+    buf = Buffers(scratch, cfg["rows"], R, S, D, I, mats_x, x.device)
+    if out is None:
+        out = torch.empty((R, D), dtype=torch.float32, device=x.device)
+    pick = pick.to(torch.int32)
+    wts = wts.to(torch.float32)
+    for a in range(0, R, buf.rows):
+        b = min(R, a + buf.rows)
+        pk = pick[a:b].contiguous()
+        w = wts[a:b].contiguous()
+        P = (b - a) * S
+        xg = buf.x[0, :P]
+        xu = buf.x[mats_x - 1, :P]
+        xd, y = buf.xd[:P], buf.y[:P]
+        ext.rot(x[a:b], x.stride(0), pk, gate.suh, up.suh, xg, xu, D, S, P, mats_x)
+        order, pe, poff, pcnt, npass = plan(pk, E)
+        buf.ticket.zero_()
+        ext.gateup(xg, xu, tg, tu, order, pe, poff, pcnt, npass, buf.ticket[0:1], gate.svh, up.svh, down.suh, xd, D,
+                   I, k2gu, shx, cg, cfg["ticket"], float(limit))
+        ext.down(xd, td, order, pe, poff, pcnt, npass, buf.ticket[1:2], down.svh, y, I, D, k2d, cfg["dn"],
+                 cfg["ticket"])
+        up_ext.combine(y, w, out[a:b], b - a, D, S)
+    return out
+
+
+def dequant(trellis: torch.Tensor) -> torch.Tensor:
+    """W_q [K, N] fp16 of one stored trellis [K/16, N/16, 16 bits] through the gm kernels' decode (GPU tests)."""
+
+    t = trellis.contiguous().view(torch.int32)
+    out = torch.empty((trellis.shape[0] * 16, trellis.shape[1] * 16), dtype=torch.float16, device=trellis.device)
+    _ext().dequant(t, out, k2_of(trellis))
+    return out
+
+
+def flops(rows: int, topk: int = 6, D: int = 5120, I: int = 1152) -> float:
+    return 2.0 * rows * topk * 3 * D * I
+
+
+def floor_bytes(rows: int, trellis_bytes: int, topk: int = 6, D: int = 5120, I: int = 1152, mats_x: int = 2) -> int:
+    """The DRAM floor of a block: the trellis once, X written + read, Xd written + read, Y written + read, out."""
+
+    P = rows * topk
+    return trellis_bytes + 2 * mats_x * P * D * 2 + 2 * P * I * 2 + 2 * P * D * 4 + rows * D * 4
+
+
+__all__ = [
+    "BM",
+    "K2S",
+    "Buffers",
+    "config",
+    "dequant",
+    "floor_bytes",
+    "flops",
+    "plan",
+    "routed",
+    "run",
+    "shared_input",
+    "supported",
+    "words",
+]
