@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Big prefill segments through the Triton CSA2 kernels in Triton's CPU interpreter (512-wide FP8 rows, 32 x 128
+index heads, a 128-token window): a segment on the staging ring (the slot's ring holds one row), attention in row
+blocks of the scratch's rows, the materialised indexer and the reindex in row blocks under the index budget, and the
+streaming top-k, against one plain window: logits bit for bit, then the decode step after the prompt."""
+
+from __future__ import annotations
+
+import json
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton  # noqa: E402
+
+if type(compress._kv_store).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+IDS = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(4)).tolist()
+
+
+def _ckpt(folder, **over):
+    root = FK.write_checkpoint(folder, **SHAPES, **over)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    return _ckpt(tmp_path_factory.mktemp("dsv41pfk"))
+
+
+def run(ckpt, chunk: int, pchunk: int, attn_rows: int, budget: int | None = None, stream: int = 0):
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    cs = Triton(attn_rows, cfg.num_attention_heads, "cpu")
+    if budget is not None:
+        cs.index_budget = budget
+    cs.stream_min = stream
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = FW.Forward(cfg, tree, csa2=cs, limit=64, chunk=chunk, pchunk=pchunk, engram_rows=rows,
+                    hasher=EH.NgramHasher(cfg, tmap))
+    last = fw.prompt(IDS[:-1])
+    step = fw.step([IDS[-1]])
+    return fw, torch.cat([last, step])
+
+
+def test_staging_and_row_blocks_equal_one_window(ckpt):
+    """(the plain run is made here: ``gpu_like`` is function-scoped and must be active)"""
+
+    plain = run(ckpt, 20, 20, 20)[1]
+    assert not torch.isnan(plain).any()
+    fw, got = run(ckpt, 1, 20, 8, budget=1)         # ring of 128 rows: the 20-row segment stages; blocks of 8 / 16
+    assert fw.ring == 128 and fw.stage is not None
+    assert torch.equal(got, plain)
+
+
+def test_streaming_topk_equals_materialised(tmp_path):
+    """The backend's streaming path (power-of-two top-k: 64; the kernel itself is checked against index.select at
+    real key counts in test_dsv41_stream_topk_interp): -1 pads where index.select lists invisible keys, so the
+    counts and every row agree."""
+
+    ck = _ckpt(tmp_path, index_topk=64)
+    plain = run(ck, 20, 20, 20)[1]
+    _, got = run(ck, 20, 20, 20, stream=1)
+    assert torch.equal(got, plain)
