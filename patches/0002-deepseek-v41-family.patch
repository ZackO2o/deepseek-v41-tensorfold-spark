+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The gemv router (TF_DSV41_ROUTER=gemv, router_gemv.cu) on the GPU at the real geometry (D 5,120; E 384 top-6 and
+E 128 top-3), window G7 (collected only where PyTorch sees an NVIDIA GPU):
+
+- the kernel's logits == router_gemv's numpy model bit for bit (every row tile 1..16, every (NW, EW) config, a
+  prefill-sized call); picks == the model's, weights within 2 ulp-ish (exp / log are CUDA's vs numpy's);
+- a row alone == the row in windows of R = 1..16 at offsets 0 / 7 / N - R, and 40 / 4,100 rows (row tiles of 16,
+  chunks of 2,048) == the same rows in 16-row windows, picks and weights bit for bit;
+- CUDA graphs: replays == eager bits, counters back to 0, new inputs == eager; the first call a capture;
+- ties to the lower id, the safe softplus on sink rows (every logit below -16.6), the shared slot;
+- gemv vs split and float64 on random rows; us a layer (printed: routerbench --mode gemv is the real measurement).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_router_gemv_gpu.py (one GPU; the first call builds the extension).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import numpy as np
+
+from tensorfold.families.deepseek_v41.cuda import router
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+DEV = "cuda"
+D = 5120
+
+
+def _inputs(R, E, seed, wscale=0.02):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * wscale).to(torch.bfloat16).contiguous()
+    b = torch.randn(E, generator=g) * 0.01
+    return x.to(DEV), w.to(DEV), b.to(DEV)
+
+
+def _bits(p, w):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def _gemv(x, w, b, topk=6, **kw):
+    return router.route(x, w, b, topk=topk, mode="gemv", **kw)
+
+
+@pytest.mark.parametrize("E", [384, 128])
+@pytest.mark.parametrize("R", [1, 2, 3, 8, 16, 40])
+def test_logits_equal_the_model(E, R):
+    x, w, _ = _inputs(R, E, 100 + R)
+    want = RG.model_logits(x.cpu(), w.cpu())
+    for cfg in RG.CFGS:
+        got = RG.logits(x, w, cfg=cfg).cpu().numpy()
+        assert np.array_equal(got.view(np.int32), want.view(np.int32)), (cfg, int((got != want).sum()))
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_selection_equals_the_model(E, topk):
+    x, w, b = _inputs(64, E, 7 + E)
+    pick, wts = _gemv(x, w, b, topk=topk)
+    mp, mw = RG.model_select(RG.model_logits(x.cpu(), w.cpu()), b.cpu(), topk, True, 1.5)
+    assert np.array_equal(pick.cpu().numpy(), mp)
+    np.testing.assert_allclose(wts.cpu().numpy(), mw, rtol=1e-6, atol=0)
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_rows_invariant_r1_to_16(E, topk):
+    x, w, b = _inputs(40, E, E)
+    alone = [_bits(*_gemv(x[r:r + 1].contiguous(), w, b, topk=topk)) for r in range(40)]
+    for R in range(1, 17):
+        for off in sorted({0, 7, 40 - R}):
+            p, wt = _bits(*_gemv(x[off:off + R].contiguous(), w, b, topk=topk))
+            for i in range(R):
+                assert torch.equal(p[i], alone[off + i][0][0]) and torch.equal(wt[i], alone[off + i][1][0]), (R, off, i)
+    p, wt = _bits(*_gemv(x, w, b, topk=topk))                       # 40 rows: row tiles of 16, the prefill config
+    assert torch.equal(p, torch.cat([a[0] for a in alone])) and torch.equal(wt, torch.cat([a[1] for a in alone]))
+
+
+def test_chunks_equal_windows():
+    x, w, b = _inputs(4100, 384, 3)
+    whole = _bits(*_gemv(x, w, b))
+    parts = [_bits(*_gemv(x[a:a + 16].contiguous(), w, b)) for a in range(0, 4100, 16)]
+    assert torch.equal(whole[0], torch.cat([p for p, _ in parts]))
+    assert torch.equal(whole[1], torch.cat([q for _, q in parts]))
+
+
+def test_unaligned_and_strided_rows():
+    x, w, b = _inputs(9, 384, 4)
+    want = _bits(*_gemv(x, w, b))
+    big = torch.zeros((9, D + 4), dtype=torch.bfloat16, device=DEV)
+    big[:, 4:] = x                                                   # rows 8-byte aligned only: copied first
+    assert all(torch.equal(a, c) for a, c in zip(want, _bits(*_gemv(big[:, 4:], w, b))))
+
+
+@pytest.mark.parametrize("first_is_capture", [False, True])
+def test_graph_replays_and_counters(first_is_capture):
+    x, w, b = _inputs(16, 384, 5)
+    if first_is_capture:
+        RG._COUNTERS.clear()
+    pick = torch.empty((16, 7), dtype=torch.int32, device=DEV)
+    wts = torch.empty((16, 7), dtype=torch.float32, device=DEV)
+    if not first_is_capture:
+        st = torch.cuda.Stream()
+        st.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(st):
+            _gemv(x, w, b, pick=pick, wts=wts)
+        torch.cuda.current_stream().wait_stream(st)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for _ in range(3):                                           # 3 layers on one counter buffer
+            _gemv(x, w, b, pick=pick, wts=wts)
+    want = _bits(*_gemv(x, w, b))
+    cnt = RG._counters(x.device)
+    for _ in range(2):
+        g.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(pick, want[0]) and torch.equal(wts.view(torch.int32), want[1])
+        assert int(cnt.abs().sum()) == 0
+    x.copy_(_inputs(16, 384, 6)[0])
+    g.replay()
+    torch.cuda.synchronize()
+    want = _bits(*_gemv(x, w, b))
+    assert torch.equal(pick, want[0]) and torch.equal(wts.view(torch.int32), want[1])
+
+
+def test_ties_go_to_the_lower_id():
+    x, w, _ = _inputs(4, 128, 8)
+    w[40] = w[90]
+    w[77] = w[90]
+    b = torch.zeros(128, device=DEV)
+    b[[40, 77, 90]] = 5.0
+    pick, wts = _gemv(x, w, b, topk=3)
+    assert pick[:, :3].tolist() == [[40, 77, 90]] * 4 and (pick[:, 3] == 128).all() and (wts[:, 3] == 1.0).all()
+    assert torch.equal(wts[:, 0], wts[:, 1]) and torch.equal(wts[:, 1], wts[:, 2])
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_sink_rows_route_finite(E, topk):
+    C = 2455
+    g = torch.Generator().manual_seed(0)
+    x = torch.zeros((3, D))
+    x[:, C] = torch.tensor([64.0, 48.0, 32.0])
+    w = torch.randn((E, D), generator=g) * 1e-3
+    w[:, C] = torch.linspace(-60.0, -34.0, E)[torch.randperm(E, generator=g)] / 64.0
+    x, w = x.to(torch.bfloat16).to(DEV), w.to(torch.bfloat16).contiguous().to(DEV)
+    b = (torch.randperm(E, generator=g) * 1e-3).to(DEV)
+    pick, wts = _gemv(x, w, b, topk=topk)
+    assert bool(torch.isfinite(wts).all())
+    rp, rw = router.reference(x.cpu(), w.cpu(), b.cpu(), topk)
+    assert torch.equal(pick[:, :topk].cpu(), rp)
+    torch.testing.assert_close(wts[:, :topk].double().cpu(), rw, rtol=1e-4, atol=0.0)
+
+
+def test_agrees_with_split_and_float64():
+    x, w, b = _inputs(512, 384, 9)
+    pg, _ = _gemv(x, w, b)
+    ps, _ = router.route(x, w, b, mode="split")
+    rp, _ = router.reference(x[:64].cpu(), w.cpu(), b.cpu())
+    agree = float((pg == ps).all(1).float().mean())
+    print(f"[G7] gemv vs split picks agree on {agree:.4f} of 512 random rows")
+    assert agree >= 0.99
+    assert torch.equal(pg[:64, :6].cpu(), rp)
+    exact = x.double() @ w.double().T
+    assert float((router.logits(x, w, "gemv").double() - exact).abs().max()) <= float(
+        (router.logits(x, w, "split").double() - exact).abs().max())
+
+
+def test_fallbacks_are_split():
+    x, w, b = _inputs(5, 384, 10)
+    w16 = w.to(torch.float16)
+    assert all(torch.equal(a, c) for a, c in zip(router.route(x, w16, b, mode="gemv"),
+                                                  router.route(x, w16, b, mode="split")))
+
+
+def test_time_a_layer():
+    """Informational (routerbench --mode gemv is the measurement): us a call, 40 distinct gates (no L2 reuse)."""
+
+    for E, topk in ((384, 6), (128, 3)):
+        gates = [_inputs(1, E, 200 + i)[1:] for i in range(40)]
+        for R in (1, 4, 16):
+            x = _inputs(R, E, 300 + R)[0]
+            out = {}
+            for mode in ("gemv", "split"):
+                for w, b in gates:
+                    router.route(x, w, b, topk=topk, mode=mode)
+                torch.cuda.synchronize()
+                a, z = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                a.record()
+                for _ in range(5):
+                    for w, b in gates:
+                        router.route(x, w, b, topk=topk, mode=mode)
+                z.record()
+                torch.cuda.synchronize()
+                out[mode] = a.elapsed_time(z) * 1000 / (5 * len(gates))
+            print(f"[G7] E {E} R {R}: gemv {out['gemv']:.1f} us, split {out['split']:.1f} us a call (eager)")
