@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A 2,048-row prefill window under upstream's ``group`` kernel limit (48 KiB of int32 picks: 1,750 rows at 7 picks a
+row): GpuMoE runs the experts in row blocks of at most TF_DSV41_EXPERT_BLOCK (1,024) rows, into one output, with one
+block-sized scratch shared by every layer of a geometry (allocated once, never grown). The kernels are faked here
+(CPU); the GPU check is G4's 2,048-row step (``kbench --chunk 2048``)."""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import experts as X
+from tensorfold.families.deepseek_v41.cuda import moe as M
+from tensorfold.families.deepseek_v41.cuda import router
+
+
+def test_limits():
+    assert M.group_rows_limit(X.MODEL.slots) == 1750          # 6 routed + 1 shared
+    assert M.group_rows_limit(X.DSPARK.slots) == 3064         # 3 routed + 1 shared
+    assert M.expert_block(X.MODEL.slots) == 1024
+    assert M.row_blocks(2048, 1024) == [(0, 1024), (1024, 2048)]
+    assert M.row_blocks(1500, 1024) == [(0, 1024), (1024, 1500)]
+
+
+def test_block_knob(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "4096")
+    assert M.expert_block(X.MODEL.slots) == 1750               # never over the kernel's limit
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "512")
+    assert M.expert_block(X.MODEL.slots) == 512
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "0")
+    with pytest.raises(ValueError):
+        M.expert_block(X.MODEL.slots)
+
+
+class _Block:
+    geom = X.MODEL
+
+
+class _Scratch:
+    def __init__(self, rows):
+        self.rows = rows
+
+
+@pytest.mark.parametrize("R", [1, 128, 1024, 1755, 2048])
+def test_a_2048_row_window_runs_in_blocks_under_the_group_limit(monkeypatch, R):
+    calls, made = [], []
+    D = 8
+
+    def route(x, gate, bias, *, topk, shared, scale, **kw):     # kw: keep (router keep logits, 1f46bc7)
+        pick = (torch.arange(x.shape[0] * 7, dtype=torch.int32) % 384).view(-1, 7)
+        return pick, torch.ones((x.shape[0], 7))
+
+    def routed(x, pick, wts, block, s, out, n, *, limit):
+        assert n == x.shape[0] == pick.shape[0] <= M.group_rows_limit(7) and n <= s.rows
+        calls.append(n)
+        y = x.float() * 2 + pick[:, :1].float()              # a per-row function: blocks must not change it
+        if out is None:
+            return y
+        assert out.is_contiguous()
+        out.copy_(y)
+        return out
+
+    def scratch(block, rows, device=None):
+        made.append(rows)
+        return _Scratch(rows)
+
+    monkeypatch.setattr(router, "route", route)
+    monkeypatch.setattr(X, "routed", routed)
+    monkeypatch.setattr(X, "scratch", scratch)
+    monkeypatch.setattr(M, "_SCRATCH", {})
+    layers = [M.GpuMoE(torch.zeros(384, D), torch.zeros(384), _Block(), 6, 1.5, 10.0) for _ in range(3)]
+    x = torch.randn(R, D)
+    pick = route(x, None, None, topk=6, shared=True, scale=1.5)[0]
+    for m in layers:
+        assert torch.equal(m(x), x * 2 + pick[:, :1].float())
+        m(x[:16])                                            # a decode-width call later: same scratch, no growth
+    assert max(calls) <= 1024 and sum(calls) == 3 * (R + min(R, 16))
+    assert made == [1024]                                    # one block-sized scratch for every layer, once
+    assert len({id(m.scratch) for m in layers}) == 1
+
+
+def test_the_drafter_geometry_gets_its_own_small_scratch(monkeypatch):
+    made = []
+    monkeypatch.setattr(X, "scratch", lambda block, rows, device=None: made.append((block.geom, rows)) or
+                        _Scratch(rows))
+    monkeypatch.setattr(M, "_SCRATCH", {})
+
+    class Draft:
+        geom = X.DSPARK
+
+    M.shared_scratch([M.GpuMoE(torch.zeros(128, 8), torch.zeros(128), Draft(), 3, 1.5, 10.0),
+                      M.GpuMoE(torch.zeros(384, 8), torch.zeros(384), _Block(), 6, 1.5, 10.0)])
+    assert made == [(X.DSPARK, 64), (X.MODEL, 1024)]
+    assert M.scratch_bytes_total() == X.scratch_bytes(64, X.DSPARK) + X.scratch_bytes(1024, X.MODEL)
