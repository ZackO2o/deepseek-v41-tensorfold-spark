+def test_softplus_edges():
+    z = np.array([-100.0, -87.0, -30.0, -16.7, -16.5, -10.5, -10.0, -9.5, 0.0, 5.0, 19.9, 20.0, 20.5, 60.0],
+                 np.float32)
+    got = RG.softplus32(z).astype(np.float64)
+    ref = torch.nn.functional.softplus(torch.from_numpy(z.astype(np.float64))).numpy()
+    assert (got > 0).all()                                           # never 0: the G4 NaN fix (s = 0 for all)
+    tight = (z >= -87) & ((z < -10) | (z > -7)) & (z <= 20)          # -100: e^z is an fp32 subnormal
+    np.testing.assert_allclose(got[tight], ref[tight], rtol=2e-6, atol=0)
+    mid = (z >= -10) & (z <= -7)                                     # log(1 + e^z): router.py's arithmetic kept
+    np.testing.assert_allclose(got[mid], ref[mid], rtol=5e-3, atol=0)
+    assert got[-1] == 60.0 and got[-2] == np.float32(20.5)            # z above 20: z
