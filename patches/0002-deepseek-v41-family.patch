index 0000000..2a9724d
--- /dev/null
+++ b/tests/test_dsv41_weights.py
@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's loader and roles on the synthetic EXL3 pack: every group's width comes from its trellis
+shape, a rank's matrix is exactly the slice of the full one (upstream's float64 EXL3 decoder), the vocabulary and
+heads split in halves, and the CSA2 roles / topology follow config.json."""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.cuda.exl3 import format as fmt  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41w"))
+    return root, Config.from_dict(json.loads((root / "config.json").read_text()))
+
+
+def dense(x: W.X3) -> np.ndarray:
+    return fmt.dequantize(x.trellis.numpy(), x.suh.numpy(), x.svh.numpy(), fmt.bits_of(tuple(x.trellis.shape)),
+                          x.codebook)
+
+
+def same(parts: list, whole, axis: int) -> bool:
+    """The rank matrices assemble the full one: W_q tiles and scales exactly, the decoded matrices to float64
+    rounding (BLAS orders the Hadamard sums by matrix size)."""
+
+    cat = np.concatenate([dense(p) for p in parts], axis)
+    q = np.concatenate([fmt.unpack(p.trellis.numpy(), fmt.bits_of(tuple(p.trellis.shape)), p.codebook)
+                        for p in parts], axis)
+    exact = np.array_equal(q, fmt.unpack(whole.trellis.numpy(), fmt.bits_of(tuple(whole.trellis.shape)),
+                                         whole.codebook))
+    scales = torch.equal(torch.cat([p.suh for p in parts]) if axis == 0 else parts[0].suh, whole.suh) and \
+        torch.equal(torch.cat([p.svh for p in parts]) if axis == 1 else parts[0].svh, whole.svh)
+    return exact and scales and np.allclose(cat, dense(whole), rtol=0, atol=1e-12)
+
+
+def test_widths_from_trellis_shapes(ckpt):
+    root, cfg = ckpt
+    t = W.Loader(cfg, W.Shards(root), 0, 1).load()
+    bits = lambda x: fmt.bits_of(tuple(x.trellis.shape))  # noqa: E731
+    assert bits(t.layers[0].attn.wq_a) == 6 and bits(t.layers[1].attn.wq_a) == 5
+    assert bits(t.layers[2].attn.ix_wk) == 8 and bits(t.head) == 6
+    assert fmt.bits_of(tuple(t.layers[3].moe.w1.trellis.shape[1:])) == 3
+    assert bits(t.layers[3].moe.shared[0][0]) == 5
+    assert t.layers[0].attn.wq_a.codebook == "mul1"
+
+
+def test_tp_slices_are_slices_of_the_full_matrices(ckpt):
+    root, cfg = ckpt
+    full = W.Loader(cfg, W.Shards(root), 0, 1).load()
+    ranks = [W.Loader(cfg, W.Shards(root), r, 2).load() for r in range(2)]
+    L = 2
+    for name, axis in (("wq_b", 1), ("wo_b", 0)):
+        assert same([getattr(rk.layers[L].attn, name) for rk in ranks], getattr(full.layers[L].attn, name), axis)
+    for e in (0, 5):
+        for which, axis in (("w1", 1), ("w3", 1), ("w2", 0)):
+            parts = [getattr(rk.layers[L].moe, which).item(e) for rk in ranks]
+            assert same(parts, getattr(full.layers[L].moe, which).item(e), axis), (e, which)
+    for j, axis in ((0, 1), (2, 1), (1, 0)):
+        assert same([rk.layers[L].moe.shared[0][j] for rk in ranks], full.layers[L].moe.shared[0][j], axis)
+    assert same([rk.head for rk in ranks], full.head, 1)
+    assert torch.equal(torch.cat([rk.embed for rk in ranks]), full.embed)
+    assert [rk.vocab_lo for rk in ranks] == [0, cfg.vocab_size // 2]
+    assert torch.equal(torch.cat([rk.layers[L].attn.sink for rk in ranks]), full.layers[L].attn.sink)
+    assert [len(rk.layers[L].attn.wo_a) for rk in ranks] == [1, 1]
+    assert torch.equal(ranks[1].layers[L].attn.wo_a[0].trellis, full.layers[L].attn.wo_a[1].trellis)
+    for rk in ranks:                                      # replicated
+        assert torch.equal(rk.layers[L].attn.wq_a.trellis, full.layers[L].attn.wq_a.trellis)
+        assert torch.equal(rk.layers[L].moe.gate, full.layers[L].moe.gate)
+
+
+def test_parameters_as_vllm_holds_them(ckpt):
+    root, cfg = ckpt
+    src = W.Shards(root)
+    t = W.Loader(cfg, src, 0, 1).load()
+    g = src.tensor("layers.3.ffn.gate.weight")
+    assert g.dtype == torch.float16 and t.layers[3].moe.gate.dtype == torch.bfloat16
+    assert torch.equal(t.layers[3].moe.gate, g.to(torch.bfloat16))
+    assert t.layers[3].moe.bias.dtype == torch.float32 and t.layers[3].moe.bias_vl is None
+    assert torch.equal(t.layers[2].attn.ix_wp, src.tensor("layers.2.attn.indexer.weights_proj.weight").to(
+        torch.bfloat16).float())
+    q = src.tensor("layers.1.engram.q_weight").to(torch.bfloat16).float()
+    k = src.tensor("layers.1.engram.k_weight").to(torch.bfloat16).float()
+    assert torch.equal(t.layers[1].engram.qk, q * k)
+    assert t.layers[0].engram is None and t.layers[4].attn.comp_wgate is None and t.layers[2].attn.comp_wgate
+    assert t.layers[6].attn.ix_wq_b is not None and t.layers[6].attn.ix_wk is None and t.layers[5].attn.ix_wq_b is None
+
+
+def test_bias_vl_from_source_shards(ckpt, tmp_path):
+    from safetensors.torch import save_file
+
+    root, cfg = ckpt
+    src = tmp_path / "src"
+    src.mkdir()
+    bv = torch.randn(cfg.n_routed_experts)
+    save_file({"layers.3.ffn.gate.bias_vl": bv}, str(src / "model-00003-of-00048.safetensors"))
+    t = W.Loader(cfg, W.Shards(root), 0, 1, bias_vl=W.bias_vl_source({"TF_DSV41_BIAS_VL": str(src)})).load(4)
+    assert torch.equal(t.layers[3].moe.bias_vl, bv) and t.layers[2].moe.bias_vl is None
+    assert W.bias_vl_source({}) is None
+
+
+def test_refuses_splits_that_break_hadamard_blocks(ckpt):
+    root, cfg = ckpt
+    with pytest.raises(ValueError):
+        W.Loader(cfg, W.Shards(root), 0, 4).load(1)          # 2 heads over 4 ranks
+
+
+def test_roles_and_topology(ckpt):
+    root, cfg = ckpt
+    modes = [cfg.attention_mode(L) for L in range(cfg.num_hidden_layers)]
+    assert modes == ["swa", "swa", "full", "reuse", "full", "reuse", "reindex", "reuse"]
+    assert cfg.is_candidate_source(4) and cfg.uses_candidates(6) and not cfg.uses_candidates(4)
+    topo = topology.load(root)
+    assert topo.kv_sources == [2, 4] and topo.by_role("reindex") == [6]
+    assert [ly.kv_source for ly in topo.layers][2:] == [2, 2, 4, 4, 4, 4]
+    assert topo.layers[4].candidates == "write" and topo.layers[6].candidates == "read"
+    assert topo.layers[1].engram and len(topo.dspark) == 2 and topo.decoder_start == 4
+
+
+def test_real_config_roles():
+    """The checkpoint's own layer schedule (docs/ARCHITECTURE.md section 3.2) from Config's defaults."""
+
+    cfg = Config()
+    modes = [cfg.attention_mode(L) for L in range(40)]
+    assert modes[:2] == ["swa", "swa"] and [i for i, m in enumerate(modes) if m == "full"] == [2, 8, 14, 20]
+    assert [i for i, m in enumerate(modes) if m == "reindex"] == [24, 28, 32, 36]
+    assert cfg.kv_source(39) == 20 and cfg.index_source(39) == 36 and cfg.kv_source(13) == 8
+    assert cfg.compress_ratio(19) == 2 and cfg.compress_ratio(20) == 1 and cfg.compress_ratio(40) == 0
