+# -- x3pf: prefill experts == upstream ---------------------------------------------------------------------------
+def _group_torch(pick, ids, count, members, R: int, slots: int, E: int) -> None:
+    """Upstream's ``group_kernel`` in torch (distinct experts < E in id order, members row * 32 + slot in row order,
+    -1 after the last): its one block holds R x slots picks in 48 KiB of dynamic shared memory, so it cannot launch
+    past 1,755 rows at 7 slots (G1: invalid argument at 2,048); the test groups those windows here."""
+
+    flat = pick.reshape(-1)[:R * slots].long()
+    uniq = torch.unique(flat[flat < E])
+    count[0] = uniq.numel()
+    ids[:uniq.numel()] = uniq.to(ids.dtype)
+    maxm = members.shape[1]
+    for u, e in enumerate(uniq.tolist()):
+        at = (flat == e).nonzero().flatten()[:maxm]
+        members[u].fill_(-1)
+        members[u, :at.numel()] = ((at // slots) * 32 + at % slots).to(members.dtype)
+
+
+@pytest.mark.parametrize("k2", [4, 6, 8])
+@pytest.mark.parametrize("rows", [16, 256, 1024, 2048])
+def test_x3pf_equals_upstream_bitwise(k2, rows):
+    from test_dsv41_gpu import _random_layer
+
+    from tensorfold.cuda.exl3 import experts as x3
+    from tensorfold.families.deepseek_v41.cuda import expert_prefill as PF
+
+    layer = _random_layer(k2, k2, experts=64, seed=k2 + rows)
+    ex = layer.ex
+    D, I = ex.dims, ex.width
+    slots = 7
+    g = torch.Generator(device=DEV).manual_seed(rows)
+    x = torch.randn((rows, D), generator=g, device=DEV).to(torch.bfloat16)
+    pick = torch.stack([torch.randperm(64, generator=g, device=DEV)[:6] for _ in range(rows)]).to(torch.int32)
+    pick = torch.cat([pick, torch.full((rows, 1), 64, dtype=torch.int32, device=DEV)], 1).contiguous()
+    s = x3.Scratch(ex, rows, slots, device=DEV)
+    ext = x3._ext()
+    ids, members = s.window(rows)
+    if rows * slots * 4 <= 48 * 1024:
+        ext.group(pick, ids, s.count, members, rows, slots, ex.count)
+        if rows == 1024:                    # the torch grouping == upstream's where both run
+            gi, gc, gm = ids.clone(), s.count.clone(), members.clone()
+            _group_torch(pick, gi, gc, gm, rows, slots, ex.count)
+            n = int(gc[0])
+            assert n == int(s.count[0]) and torch.equal(gi[:n], ids[:n]) and torch.equal(gm[:n], members[:n])
+    else:
+        _group_torch(pick, ids, s.count, members, rows, slots, ex.count)
+    ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, rows, D, slots, ex.count)
+    P = rows * slots
+    for mats, K, N, cfg, a in ((2, D, I, s.cfg_gu, (s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2)),
+                               (1, I, D, s.cfg_d, (s.xg[:, :I].contiguous(),) * 2 + (ex.down_ptr, ex.down_ptr,
+                                                                                    ex.down_k2, ex.down_k2))):
+        nt, w, sk, pf = cfg
+        lo, hi = (ex.k2_gu if mats == 2 else ex.k2_d)
+        s.z.zero_()
+        torch.cuda.synchronize()
+        t0 = time.perf_counter()
+        ext.grouped(*a, ids, s.count, members, s.z, mats, K, N, P, sk, slots, ex.cb, nt, w, pf, lo, hi)
+        torch.cuda.synchronize()
+        t1 = time.perf_counter()
+        want = s.z.clone()
+        for pcfg in PF.CFGS:
+            s.z.zero_()
+            torch.cuda.synchronize()
+            t2 = time.perf_counter()
+            assert PF.grouped(*a, ids, s.count, members, s.z, mats, K, N, P, sk, slots, ex.cb, w, lo, hi, rows=rows,
+                              cfg=pcfg)
+            torch.cuda.synchronize()
+            t3 = time.perf_counter()
+            assert torch.equal(s.z.view(torch.int32), want.view(torch.int32)), (mats, pcfg)
+            print(f"\nk2={k2} rows={rows} mats={mats} {pcfg}: upstream {1e3 * (t1 - t0):.3f} ms, "
+                  f"x3pf {1e3 * (t3 - t2):.3f} ms (first calls include builds)")
