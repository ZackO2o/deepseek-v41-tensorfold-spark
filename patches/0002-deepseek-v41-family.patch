@@ -0,0 +1,191 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's forward on a tiny synthetic EXL3 checkpoint, on the CPU (the torch twins of the kernels):
+
+- TP=2 (two ranks on threads, the real split weights and exchanges) == one rank, at ~1e-12 in exact numerics, and
+  the two ranks hold identical streams bit for bit with the kit's numerics;
+- row invariance with the kit's numerics (bf16 activations, fp16 inputs, FP8 KV rows), bit for bit: a row alone ==
+  the same row in an 8-row window == in a whole-prompt prefill window (prefill rows == decode rows), across every
+  layer kind (SWA, Engram, ratio-2 kv source, reuse, ratio-1 candidate source, reindex);
+- Engram rows from the kit's packed per-rank shards (O_DIRECT reader) == rows held in memory.
+
+The comparison against the development tree's (unpublished) torch reference (per layer kind and the whole model, 3e-15 in exact
+numerics) lives there (deepseek-v41-tensorfold-spark tests/family), next to the reference.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+IDS = torch.randint(0, 256, (37,), generator=torch.Generator().manual_seed(11)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    table = FK.engram_table(cfg)
+    return root, cfg, table
+
+
+def build(ckpt, rank: int = 0, world: int = 1, comm=None, chunk: int = 8, rows=None) -> FW.Forward:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = rows or {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def run(fw: FW.Forward, ids, windows) -> torch.Tensor:
+    """Logits of every row, the prompt cut into ``windows`` (sizes)."""
+
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(ids[a:a + n]))
+        a += n
+    assert a == len(ids)
+    return torch.cat(out)
+
+
+def tp2(ckpt, fn, **kw):
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = [build(ckpt, r, 2, comms[r], **kw) for r in range(2)]
+    return fws, pair.run([lambda f=f: fn(f) for f in fws])
+
+
+def test_tp2_equals_one_rank_exact(ckpt):
+    with N.exact():
+        one = run(build(ckpt, chunk=16), IDS, [16, 16, 5])
+        fws, halves = tp2(ckpt, lambda f: run(f, IDS, [16, 16, 5]), chunk=16)
+    both = torch.cat(halves, 1)
+    assert one.dtype == torch.float64
+    assert (both - one).abs().max().item() < 1e-10 * max(1.0, one.abs().max().item())
+
+
+def test_tp2_ranks_agree_bit_for_bit(ckpt):
+    def go(f):
+        f.trace = {}
+        run(f, IDS, [8] * 4 + [5])
+        return {k: v.clone() for k, v in f.trace.items()}
+
+    _, (t0, t1) = tp2(ckpt, go)
+    assert set(t0) == set(range(8))
+    for L in t0:
+        assert torch.equal(t0[L], t1[L]), L
+
+
+def test_tp2_kit_numerics_close_to_one_rank(ckpt):
+    one = run(build(ckpt), IDS, [8] * 4 + [5])
+    _, halves = tp2(ckpt, lambda f: run(f, IDS, [8] * 4 + [5]))
+    both = torch.cat(halves, 1)
+    assert (both.argmax(-1) == one.argmax(-1)).float().mean() >= 0.9
+    assert (both - one).abs().max() < 0.25 * one.abs().max()
+
+
+@pytest.mark.parametrize("windows", [[1] * 37, [8] * 4 + [5], [3, 8, 8, 8, 8, 2]])
+def test_row_invariance(ckpt, windows):
+    """Prefill rows == decode rows == verify-window rows, bit for bit (one prefill window of 37 is the yardstick)."""
+
+    want = run(build(ckpt, chunk=37), IDS, [37])
+    got = run(build(ckpt, chunk=37), IDS, windows)
+    assert torch.equal(got, want)
+
+
+def test_row_invariance_tp2(ckpt):
+    _, a = tp2(ckpt, lambda f: run(f, IDS, [1] * 37), chunk=37)
+    _, b = tp2(ckpt, lambda f: run(f, IDS, [37]), chunk=37)
+    assert torch.equal(a[0], b[0]) and torch.equal(a[1], b[1])
+
+
+def test_prefill_keeps_the_last_row_and_reset(ckpt):
+    fw = build(ckpt)
+    last = fw.prompt(IDS)
+    every = []
+    fw.reset()
+    fw.prompt(IDS, every=lambda a, lg: every.append(lg))
+    assert torch.equal(last, torch.cat(every)[-1:])
+    assert fw.slot.pos == len(IDS)
+
+
+def test_engram_rows_from_packed_shards(ckpt, tmp_path):
+    root, cfg, table = ckpt
+    folder = FK.write_engram(tmp_path / "eng", cfg, table, world=2)
+    want = run(build(ckpt), IDS, [8] * 4 + [5])
+    fws, halves = tp2(ckpt, lambda f: run(f, IDS, [8] * 4 + [5]))
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    shard = [build(ckpt, r, 2, comms[r], rows=EH.open_shards(folder, r, 2, cfg.engram_layer_ids,
+                                                                dim=cfg.engram_head_dim)) for r in range(2)]
+    got = pair.run([lambda f=f: run(f, IDS, [8] * 4 + [5]) for f in shard])
+    assert torch.equal(got[0], halves[0]) and torch.equal(got[1], halves[1])
+    assert want.shape[1] == 2 * got[0].shape[1]
+    reads = sum(f.engram_rows[1].stats["rows"] for f in shard)
+    assert reads == len(IDS) * cfg.n_hash_cols                 # each rank read its own heads' rows only
+
+
+def test_greedy_over_vocabulary_halves(ckpt):
+    with N.exact():
+        lg = run(build(ckpt, chunk=9), IDS[:9], [9])
+        _, toks = tp2(ckpt, lambda f: FW.greedy(f, run(f, IDS[:9], [9])), chunk=9)
+    assert torch.equal(toks[0], lg.argmax(-1)) and torch.equal(toks[1], lg.argmax(-1))
+
+
+def test_window_limits(ckpt):
+    fw = build(ckpt, chunk=8)
+    with pytest.raises(ValueError):
+        fw.step(IDS[:9])
+    fw.slot.pos = 95
+    with pytest.raises(ValueError):
+        fw.step(IDS[:2])
+
+
+def test_fp8_index_key_roundtrip_is_idempotent_and_close():
+    """The gate's FP8 index-key emulation (TF_DSV41_INDEX_KEY_SIM=fp8): rows land on e4m3 x 2^k, a second pass keeps
+    every bit, and the error stays within e4m3's half step (2^-4 relative)."""
+
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import fp8_roundtrip_
+
+    g = torch.Generator().manual_seed(0)
+    k = (torch.randn((64, 128), generator=g) * torch.logspace(-3, 3, 64)[:, None]).to(torch.bfloat16)
+    k[5] = 0
+    want = k.clone()
+    fp8_roundtrip_(k)
+    once = k.clone()
+    fp8_roundtrip_(k)
+    assert torch.equal(k, once)
+    assert torch.equal(once[5], want[5])
+    amax = want.float().abs().amax(-1, keepdim=True).clamp(min=1e-30)
+    err = (once.float() - want.float()).abs() / amax
+    assert float(err.max()) <= 2 ** -4
+
+
+def test_query_has_no_per_head_norm(ckpt):
+    """V4.1's q is rope(wq_b(qr)) with no per-head RMS (vLLM deepseek_v4_1: apply_q_norm=False; V4.0 had it). With
+    the norm, doubling wq_b's output would not change a logit; without it the attention sharpens (G2: the norm cost
+    top-1 92.3% -> 99.6% against the kit)."""
+
+    fw = build(ckpt)
+    want = run(fw, IDS[:12], [8, 4]).clone()
+    for blk in fw.blocks:
+        f = blk.attn.wq_b
+        blk.attn.wq_b = (lambda x, dt, f=f: f(x, dt) * 2)
+    fw.reset()
+    got = run(fw, IDS[:12], [8, 4])
+    rel = float((got.double() - want.double()).abs().max() / want.double().abs().max())
+    assert rel > 1e-2
