@@ -0,0 +1,191 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The decode top-k (families/deepseek_v41/cuda/csa2/dtopk.py) in Triton's CPU interpreter: bit for bit the torch
+path it replaces (``index.sort_keys`` + ``index.top_positions`` + ``backend.visible_counts``):
+
+- dense selections over random scores with ties (a block of equal scores straddling the cut, +0.0 / -0.0, NaN),
+  -inf (masked) entries, rows with fewer visible keys than the top-k next to longer rows, n < k, n == k, digit
+  widths 8 and 11; row mode (each row's own position) == the window launch;
+- candidate blocks == ``index.candidate_blocks`` (newest pinned, dead blocks, fewer live blocks than k);
+- gathered selections (``gather`` over shuffled, -1 holed positions; ``gather_cand`` from candidate blocks) ==
+  ``top_positions(sort_keys(s, keys))``; ``index.scores``' candidate-block gather == the materialised keys';
+- row invariance (a row alone == in a window), and ``backend.Triton`` with TF_DSV41_INDEX_DTOPK on == off for
+  select / select_cand / reindex (selections, candidates and visible counts).
+
+Run: python -m pytest -q tests/test_dsv41_dtopk_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+triton = pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import dtopk as DT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import index  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Win, visible_counts  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(DT._dtopk).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+NINF = float("-inf")
+
+
+def _scores(R: int, n: int, P: int, ratio: int, seed: int, ties: bool = True) -> torch.Tensor:
+    """Dense scores [R, n] as ``index._scores`` leaves them: -inf past each row's visible keys (P + r + 1) // ratio."""
+
+    g = torch.Generator().manual_seed(seed)
+    s = torch.randn((R, n), generator=g)
+    if ties and n > 400:
+        s[:, 10:60] = 0.0
+        s[:, 61:70] = -0.0
+        s[:, 100:400:3] = 0.75                            # many equal scores straddling the top-k cut
+        s[:, n // 2] = float("nan")
+        s[:, 5] = float("inf")
+    for r in range(R):
+        s[r, (P + r + 1) // ratio:] = NINF
+    return s.contiguous()
+
+
+def _old(s, pos, ratio, k, positions=None):
+    return index.top_positions(index.sort_keys(s, positions), k)
+
+
+def _win(P, R):
+    return Win.make(P, R, "cpu")
+
+
+@pytest.mark.parametrize("R,n,P,ratio,k,rb", [
+    (4, 3000, 2996, 1, 512, 8),        # long rows, ties at the cut
+    (3, 3000, 2997, 1, 64, 11),        # 11-bit digits
+    (5, 900, 3000, 4, 512, 8),         # ratio 4: rows see 750 .. 751 keys
+    (6, 700, 498, 1, 512, 8),          # rows see 499 .. 504 (< 512) next to n > 512: -inf at the cut
+    (2, 300, 299, 1, 512, 8),          # n < k
+    (2, 512, 511, 1, 512, 8),          # n == k
+    (1, 1, 0, 1, 512, 8),              # one key
+    (3, 400, 397, 1, 48, 8),           # k not a power of two (synthetic configs)
+    (2, 40, 37, 1, 48, 8),
+])
+def test_select_equals_torch_path(monkeypatch, R, n, P, ratio, k, rb):
+    monkeypatch.setattr(DT, "RB", rb)
+    monkeypatch.setattr(DT, "TILE", 512)                            # several tiles a pass
+    s = _scores(R, n, P, ratio, R * n + k)
+    pos = torch.tensor([P], dtype=torch.int32)
+    want = _old(s, pos, ratio, k)
+    got, cnt = DT.select(s, pos, ratio, k)
+    assert torch.equal(got, want)
+    win = _win(P, R)
+    assert torch.equal(cnt, visible_counts(want, win, ratio))
+    rows, rcnt = DT.select(s, win.positions, ratio, k, rows=True)     # row mode: the positions a row
+    assert torch.equal(rows, want) and torch.equal(rcnt, cnt)
+
+
+def test_all_equal_scores_and_row_invariance():
+    R, n, P, k = 5, 2000, 1995, 128
+    s = torch.zeros((R, n))
+    for r in range(R):
+        s[r, P + r + 1:] = NINF
+    pos = torch.tensor([P], dtype=torch.int32)
+    got, _ = DT.select(s, pos, 1, k)
+    assert torch.equal(got, _old(s, pos, 1, k))
+    assert got[0].tolist() == list(range(k))                        # all ties: the lowest positions
+    s = _scores(R, n, P, 1, 9)
+    got, cnt = DT.select(s, pos, 1, k)
+    for r in (0, 2, 4):
+        one, c1 = DT.select(s[r:r + 1].contiguous(), torch.tensor([P + r], dtype=torch.int32), 1, k)
+        assert torch.equal(one[0], got[r]) and int(c1[0]) == int(cnt[r])
+
+
+@pytest.mark.parametrize("n,P,kb", [(3000, 2996, 64), (3000, 2996, 2048), (100, 96, 64)])
+def test_candidate_blocks_equal_torch_path(monkeypatch, n, P, kb):
+    monkeypatch.setattr(DT, "TILE", 1024)                           # 128 blocks a tile
+    R = 4
+    s = _scores(R, n, P, 1, n + kb)
+    pos = torch.tensor([P], dtype=torch.int32)
+    want = index.candidate_blocks(s, pos, R, 1, topk_blocks=kb)
+    assert torch.equal(DT.blocks(s, pos, 1, kb), want)
+    win = _win(P, R)
+    assert torch.equal(DT.blocks(s, win.positions, 1, kb, rows=True), want)
+
+
+def test_gather_and_candidate_gather_equal_torch_path():
+    R, n, P, kb, k = 3, 3000, 2997, 64, 128
+    s = _scores(R, n, P, 1, 11)
+    pos = torch.tensor([P], dtype=torch.int32)
+    cand = index.candidate_blocks(s, pos, R, 1, topk_blocks=kb)
+    cand[1, -5:] = -1                                               # missing blocks
+    keys = index.candidate_keys(cand)
+    g = torch.Generator().manual_seed(12)
+    s2 = torch.randn(keys.shape, generator=g)
+    s2[:, 20:200] = 0.5
+    s2 = torch.where(keys >= 0, s2, torch.full_like(s2, NINF)).contiguous()
+    want = _old(s2, pos, 1, k, keys)
+    win = _win(P, R)
+    got, cnt = DT.gather_cand(s2, cand, pos, 1, k)
+    assert torch.equal(got, want) and torch.equal(cnt, visible_counts(want, win, 1))
+    got, cnt = DT.gather(s2, keys, pos, 1, k)
+    assert torch.equal(got, want)
+    got, _ = DT.gather(s2, keys, pos, 1, 100)                       # k not a power of two
+    assert torch.equal(got, _old(s2, pos, 1, 100, keys))
+    perm = torch.randperm(keys.shape[1], generator=g)               # any order of the gathered positions
+    kp, sp = keys[:, perm].contiguous(), s2[:, perm].contiguous()
+    got, cnt2 = DT.gather(sp, kp, pos, 1, k)
+    assert torch.equal(got, _old(sp, pos, 1, k, kp)) and torch.equal(got, want) and torch.equal(cnt2, cnt)
+    few = cand.clone()
+    few[:, 4:] = -1                                                 # 32 candidate positions < k
+    fk = index.candidate_keys(few)
+    fs = torch.where(fk >= 0, s2, torch.full_like(s2, NINF)).contiguous()
+    got, _ = DT.gather_cand(fs, few, pos, 1, k)
+    assert torch.equal(got, _old(fs, pos, 1, k, fk))
+
+
+def _index_inputs(R: int, nkeys: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    qi = torch.randn((R, 32, 128), generator=g).to(torch.bfloat16).contiguous()
+    w = torch.randn((R, 32), generator=g).contiguous()
+    ik = torch.randn((nkeys, 128), generator=g)
+    ik[100:140] = ik[7]
+    ik[300:500] = 0.0
+    return qi, w, ik.to(torch.bfloat16).contiguous()
+
+
+def test_scores_candidate_gather_equals_materialised_keys():
+    R, P = 2, 700
+    qi, w, ik = _index_inputs(R, P + R, 13)
+    pos = torch.tensor([P], dtype=torch.int32)
+    s = index.scores(qi, w, ik, pos, R, P + R, 1)
+    cand = index.candidate_blocks(s, pos, R, 1, topk_blocks=16)
+    cand[0, -2:] = -1
+    keys = index.candidate_keys(cand)
+    a = index.scores(qi, w, ik, pos, R, keys.shape[1], 1, keys=keys)
+    b = index.scores(qi, w, ik, pos, R, keys.shape[1], 1, keys=cand, cand_block=index.BLOCK)
+    assert torch.equal(a.view(torch.int32), b.view(torch.int32))
+
+
+def test_backend_knob_on_equals_off():
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.csa2.stores import Keys
+
+    R, P, ratio = 3, 2400, 4                        # rows see 600 .. 600 keys: top-k 64 of 600, 16 blocks of 75
+    qi, w, ik = _index_inputs(R, P // ratio + 1, 14)
+    keys = Keys(ik)
+    be = Triton(R, 16, "cpu")
+    win = _win(P, R)
+    out = {}
+    for on in (False, True):
+        be.dtopk = on
+        sel, cand = be.select_cand(qi, w, keys, win, ratio, 64, index.BLOCK, 16)
+        rsel = be.reindex(qi, w, keys, win, cand, ratio, 64, index.BLOCK)
+        fsel, _ = be.select(qi, w, keys, win, ratio, 64)
+        out[on] = [sel, cand, rsel, fsel] + [visible_counts(x, win, ratio) for x in (sel, rsel, fsel)]
+        assert (getattr(rsel, "_dsv41_counts", None) is not None) == on
+    for a, b in zip(out[False], out[True]):
+        assert torch.equal(a, b)
