+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fast prefill tag (``prefill_mm``, ``TF_DSV41_PREFILL_KERNELS=fast``) on the CPU twin, whose fast variant
+rounds the linears' outputs through fp16 first (other bits, row-independent, like the GPU's prefill GEMMs):
+
+- fast prompt rows are row-independent: any prefill segments give the same state and logits, bit for bit;
+- fast rows are NOT decode rows (so the tag is needed), and decode / verify rows never take the fast path;
+- serving under the fast tag: no turn snapshots; a second turn resumes from the first prompt's snapshot and equals a
+  fresh fast prefill of the whole conversation (resumed == fresh); batched == alone; an exact store's entries never
+  resume a fast prompt (and back).
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.sessions import Store, Tag  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+IDS = torch.randint(0, 256, (37,), generator=torch.Generator().manual_seed(29)).tolist()
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+FAST = Tag(prefill="fast", grid=16, ced="full").code()
+EXACT = Tag(ced="full").code()
+
+
+@pytest.fixture(scope="module")
+def tiny(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41ff"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), None
+
+
+@pytest.fixture(scope="module")
+def wide(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41fw"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def build(ck, mode: str, chunk: int = 4, pchunk: int | None = None, slots: int = 1, limit: int = 96):
+    root, cfg, table, _ = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    mp = pytest.MonkeyPatch()
+    mp.setenv("TF_DSV41_PREFILL_KERNELS", mode)
+    try:
+        return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), limit=limit, chunk=chunk,
+                            pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+    finally:
+        mp.undo()
+
+
+def state(fw, slot: int = 0) -> dict:
+    s = fw.slots[slot]
+    out = {f"snap.{k}": torch.from_numpy(np.asarray(v)) for k, v in fw.snapshot(slot).arrays.items()}
+    for L, st in s.comp.items():
+        n = s.pos // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    return out
+
+
+def prefilled(fw, ids, slot: int = 0):
+    fw.prefill([Piece(slot, 0, tuple(ids[:-1]))])
+    st = state(fw, slot)
+    return st, torch.cat([fw.step([ids[-1]], slot=slot), fw.step([7], slot=slot)])
+
+
+def same(a: dict, b: dict) -> bool:
+    return set(a) == set(b) and all(torch.equal(a[k], b[k]) for k in a)
+
+
+def test_mode_and_tag(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_PREFILL_KERNELS", raising=False)
+    monkeypatch.delenv("TF_DSV41_FAST_EXPERTS", raising=False)
+    assert PM.mode() == "fast" and PM.tag_grid() == 48               # G6 defaults: the fast tag, gm experts
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "exact")
+    assert PM.mode() == "exact" and PM.tag_grid() == 0
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "grouped")
+    assert PM.tag_grid() == 16
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "tc")
+    assert PM.tag_grid() == 32
+    assert Tag(prefill="fast", grid=16).code() != Tag().code()
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "nope")
+    with pytest.raises(ValueError):
+        PM.mode()
+
+
+@pytest.mark.parametrize("pchunk", [8, 6, 4])
+def test_fast_prefill_is_row_independent(tiny, pchunk):
+    want_st, want = prefilled(build(tiny, "fast", pchunk=36), IDS)
+    got_st, got = prefilled(build(tiny, "fast", pchunk=pchunk), IDS)
+    assert same(got_st, want_st)
+    assert torch.equal(got, want)
+
+
+def test_fast_rows_are_not_decode_rows(tiny):
+    fast_st, _ = prefilled(build(tiny, "fast", pchunk=36), IDS)
+    exact_st, _ = prefilled(build(tiny, "exact", pchunk=36), IDS)
+    assert not same(fast_st, exact_st)
+    one = build(tiny, "fast", chunk=1)
+    for t in IDS[:-1]:
+        one.step([t])                               # verify-style runs: never the fast path
+    assert same(state(one), exact_st)
+
+
+def test_twin_fast_linear_only_inside_prefill_runs(tiny):
+    fw = build(tiny, "fast", pchunk=36)
+    lin = fw.blocks[0].attn.wq_a
+    assert isinstance(lin, PM.FastLinear)
+    x = torch.randn(3, lin.k).to(torch.bfloat16)
+    with PM.fast():
+        a = lin(x)
+    assert not torch.equal(a, lin(x)) and torch.equal(lin(x), lin.inner(x))
+
+
+# -- serving -------------------------------------------------------------------------------------------------------
+def batcher(ck, fw, tag: int, store=None) -> Batcher:
+    pool = Pool(ck[3], 4096)
+    st = Store(pool, ram_bytes=1 << 30) if store is True else store
+    return Batcher(fw, pool, n_slots=len(fw.slots), capacity=1024, store=st, mode="full", tag=tag, prefill_rows=64,
+                   depth=0, session_min=16, start=False)
+
+
+def run(b: Batcher, jobs) -> list[list[int]]:
+    for j in jobs:
+        b.submit(j)
+    for _ in range(10000):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while (item := j.out.get_nowait()) is not None:
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out
+
+
+PROMPTS = [[int(t) for t in np.random.default_rng(s).integers(3, 256, size=n)] for s, n in ((5, 45), (6, 70))]
+
+
+def test_fast_serving_resumed_equals_fresh(wide):
+    p = PROMPTS[1]
+    fw = build(wide, "fast", chunk=8, pchunk=32, limit=1024)
+    b = batcher(wide, fw, FAST, store=True)
+    r1 = run(b, [Job(list(p), 5, None)])[0]
+    kinds = sorted(e.kind for e in b.store.entries.values())
+    assert kinds == ["prompt"]                      # no turn snapshot under the fast tag
+    turn2 = p + r1 + [5, 6, 7]
+    j2 = Job(list(turn2), 5, None)
+    got = run(b, [j2])[0]
+    assert j2.stats["tier"] == "ram" and 0 < j2.stats["cached"] < len(p)
+    fresh = run(batcher(wide, build(wide, "fast", chunk=8, pchunk=32, limit=1024), FAST),
+                [Job(list(turn2), 5, None)])[0]
+    assert got == fresh
+
+
+def test_fast_batched_equals_alone_and_tags_do_not_mix(wide):
+    fw = build(wide, "fast", chunk=8, pchunk=32, slots=2, limit=1024)
+    both = run(batcher(wide, fw, FAST), [Job(list(p), 6, None) for p in PROMPTS])
+    for p, got in zip(PROMPTS, both):
+        alone = run(batcher(wide, build(wide, "fast", chunk=8, pchunk=32, limit=1024), FAST), [Job(list(p), 6, None)])
+        assert got == alone[0]
+    ex = batcher(wide, build(wide, "exact", chunk=8, pchunk=32, limit=1024), EXACT, store=True)
+    run(ex, [Job(list(PROMPTS[0]), 3, None)])
+    assert ex.store.find(PROMPTS[0] + [9, 9], FAST) is None
+    assert ex.store.find(PROMPTS[0] + [9, 9], EXACT) is not None
+
+
+def test_g4_prefill_defaults(monkeypatch):
+    """G4: every prefill change on by default, each with its knob to turn it off."""
+
+    from tensorfold.families.deepseek_v41.cuda import stack as ST
+    from tensorfold.families.deepseek_v41.cuda.csa2 import backend as BK
+
+    for k in ("TF_DSV41_PREFILL", "TF_DSV41_INDEX_STREAM_MIN", "TF_DSV41_PREFILL_KERNELS", "TF_DSV41_FAST_EXPERTS"):
+        monkeypatch.delenv(k, raising=False)
+    assert ST.mode_from_env() == "replay" and BK.stream_min() == 16384
+    assert PM.mode() == "fast" and PM.experts_variant() == 2        # G6: x3gm 3.3x grouped a layer segment
+    monkeypatch.setenv("TF_DSV41_PREFILL", "full")
+    monkeypatch.setenv("TF_DSV41_INDEX_STREAM_MIN", "0")
+    assert ST.mode_from_env() == "full" and BK.stream_min() == 0
+
+
+def test_g6_router_modes(monkeypatch):
+    """G6: decode / verify windows route with ``fused`` (TF_DSV41_ROUTER default), fast prefill runs with
+    ``TF_DSV41_PREFILL_ROUTER`` (split: fused is 0.5x split at 2,048 rows)."""
+
+    import os
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import prefill_moe, router
+
+    if "TF_DSV41_ROUTER" not in os.environ:
+        assert router.MODE == "fused"
+    if "TF_DSV41_PREFILL_ROUTER" not in os.environ:
+        assert router.PREFILL_MODE == "split"
+    seen = {}
+
+    class Stop(Exception):
+        pass
+
+    def fake(x, *a, **kw):
+        seen["mode"] = kw.get("mode")
+        raise Stop
+
+    monkeypatch.setattr(router, "route", fake)
+    moe = SimpleNamespace(ensure=lambda R: None, gate=None, bias=None, topk=6, scale=1.5)
+    with pytest.raises(Stop):
+        prefill_moe.forward(moe, torch.zeros((4, 8)))
+    assert seen["mode"] == router.PREFILL_MODE
