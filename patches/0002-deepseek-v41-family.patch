@@ -0,0 +1,371 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The native Engram reader for prefill (ENGINE-PLAN section 13 item 4): a prompt segment's rows of a packed shard in
+one call, read by C threads with ``pread`` (O_DIRECT when the shard is open that way), the GIL released for the
+whole call.
+
+A 2,048-row segment reads 2,048 x 12 rows a layer a rank (~25K random 264-byte records). The Python reader
+(``engram_host.ShardRows.raw`` / ``prefetch._Rows``) pays a Python loop iteration, an mmap and a future per extent:
+~0.3-0.5 s a layer a segment, more than the segment's GPU time at the 1,500 tok/s target. Here:
+
+- ``plan(rows, lo, row_bytes)``: sorted unique rows -> sector-aligned extents merged across holes <= ``gap``
+  (vectorized ``engram_host.extents``: the same extents), each placed at a 4 KiB-aligned offset of one buffer;
+- ``read(fd, plan)``: ``tf_dsv41_engram_read`` (C, ``TF_DSV41_ENGRAM_THREADS`` threads, default 32) fills the
+  buffer; then one numpy gather takes every row's 264 bytes.
+
+Decode (``engram_gate``): ``readv`` takes one round's rows of every Engram layer (several shards) in one submission
+to a persistent pool of ``TF_DSV41_ENGRAM_QD`` (64) threads (Docker's default seccomp profile refuses io_uring, so
+no io_uring), ``dequant`` turns records into bf16 bits through a 256 x 256 table built by torch's own dequant, and
+``publish`` is the release store of the gate's ready flag.
+
+Exactness: the bytes are the file's (the extents cover each row whole), the same records the Python reader returns
+(``tests/test_dsv41_engram_native.py``). The library is compiled once with the system C compiler into
+``TF_DSV41_NATIVE_DIR`` (default ``~/.cache/tensorfold/dsv41-native``), keyed by the source's digest; without a
+compiler ``available()`` is False and the Python reader runs as before.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import os
+import shutil
+import subprocess
+import threading
+from pathlib import Path
+
+import numpy as np
+
+SECTOR = 512
+ALIGN = 4096
+
+SOURCE = r"""
+#define _GNU_SOURCE
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <unistd.h>
+
+typedef struct {
+    int fd, n, stride, start;
+    const int64_t *off, *len, *dst;
+    uint8_t *buf;
+    int err;
+} job_t;
+
+static void *work(void *p) {
+    job_t *j = (job_t *)p;
+    for (int i = j->start; i < j->n; i += j->stride) {
+        int64_t done = 0;
+        while (done < j->len[i]) {
+            ssize_t got = pread(j->fd, j->buf + j->dst[i] + done, (size_t)(j->len[i] - done), j->off[i] + done);
+            if (got < 0) { if (errno == EINTR) continue; j->err = errno; return 0; }
+            if (got == 0) break;                    /* end of file: the last extent's sector padding */
+            done += got;
+        }
+    }
+    return 0;
+}
+
+int tf_dsv41_engram_read(int fd, int n, const int64_t *off, const int64_t *len, const int64_t *dst, uint8_t *buf,
+                         int threads) {
+    if (threads < 1) threads = 1;
+    if (threads > 256) threads = 256;
+    if (threads > n) threads = n > 0 ? n : 1;
+    pthread_t tid[256];
+    job_t jobs[256];
+    for (int t = 0; t < threads; ++t) {
+        jobs[t] = (job_t){fd, n, threads, t, off, len, dst, buf, 0};
+        if (t > 0 && pthread_create(&tid[t], 0, work, &jobs[t]) != 0) { jobs[t].stride = 0; work(&jobs[t]); }
+    }
+    work(&jobs[0]);
+    for (int t = 1; t < threads; ++t) if (jobs[t].stride) pthread_join(tid[t], 0);
+    for (int t = 0; t < threads; ++t) if (jobs[t].err) return jobs[t].err;
+    return 0;
+}
+
+/* decode (engram_gate): one batch of extents over several shards on a persistent pool (no thread start a call) */
+typedef struct {
+    int n;
+    const int *fd;
+    const int64_t *off, *len, *dst;
+    uint8_t *buf;
+    int next, err;
+} batch_t;
+
+static pthread_mutex_t pool_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t pool_submit = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t pool_work = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t pool_done = PTHREAD_COND_INITIALIZER;
+static batch_t *pool_cur = 0;
+static long pool_gen = 0;
+static int pool_active = 0, pool_size = 0;
+
+static void run_batch(batch_t *b) {
+    for (;;) {
+        int i = __atomic_fetch_add(&b->next, 1, __ATOMIC_RELAXED);
+        if (i >= b->n) return;
+        int64_t done = 0;
+        while (done < b->len[i]) {
+            ssize_t got = pread(b->fd[i], b->buf + b->dst[i] + done, (size_t)(b->len[i] - done), b->off[i] + done);
+            if (got < 0) {
+                if (errno == EINTR) continue;
+                __atomic_store_n(&b->err, errno, __ATOMIC_RELAXED);
+                break;
+            }
+            if (got == 0) break;                    /* end of file: the last extent's sector padding */
+            done += got;
+        }
+    }
+}
+
+static void *pool_main(void *arg) {
+    (void)arg;
+    long seen = 0;
+    for (;;) {
+        pthread_mutex_lock(&pool_mu);
+        while (pool_gen == seen) pthread_cond_wait(&pool_work, &pool_mu);
+        seen = pool_gen;
+        batch_t *b = pool_cur;                      /* NULL: that batch is over, its caller no longer waits */
+        if (b) pool_active++;
+        pthread_mutex_unlock(&pool_mu);
+        if (!b) continue;
+        run_batch(b);
+        pthread_mutex_lock(&pool_mu);
+        if (--pool_active == 0) pthread_cond_broadcast(&pool_done);
+        pthread_mutex_unlock(&pool_mu);
+    }
+    return 0;
+}
+
+int tf_dsv41_engram_readv(int n, const int *fd, const int64_t *off, const int64_t *len, const int64_t *dst,
+                          uint8_t *buf, int threads) {
+    if (n <= 0) return 0;
+    if (threads > 512) threads = 512;
+    pthread_mutex_lock(&pool_submit);
+    while (pool_size < threads - 1) {
+        pthread_t t;
+        pthread_attr_t at;
+        pthread_attr_init(&at);
+        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+        pthread_attr_setstacksize(&at, 1 << 18);
+        int rc = pthread_create(&t, &at, pool_main, 0);
+        pthread_attr_destroy(&at);
+        if (rc != 0) break;                         /* fewer threads: the caller reads the rest */
+        pool_size++;
+    }
+    batch_t b = {n, fd, off, len, dst, buf, 0, 0};
+    pthread_mutex_lock(&pool_mu);
+    pool_cur = &b;
+    pool_gen++;
+    pthread_cond_broadcast(&pool_work);
+    pthread_mutex_unlock(&pool_mu);
+    run_batch(&b);                                  /* every extent claimed when this returns */
+    pthread_mutex_lock(&pool_mu);
+    pool_cur = 0;
+    while (pool_active > 0) pthread_cond_wait(&pool_done, &pool_mu);
+    pthread_mutex_unlock(&pool_mu);
+    pthread_mutex_unlock(&pool_submit);
+    return b.err;
+}
+
+/* records -> bf16 through torch's own table: out[k, i] = lut[scale byte << 8 | value byte] (engram_gate.bf16_lut) */
+void tf_dsv41_engram_dequant(const uint8_t *arena, const int64_t *idx, int n, int dim, int row_bytes, int values,
+                             const uint16_t *lut, uint16_t *out) {
+    for (int k = 0; k < n; ++k) {
+        const uint8_t *r = arena + idx[k] * (int64_t)row_bytes;
+        uint16_t *o = out + (int64_t)k * dim;
+        for (int i = 0; i < dim; ++i) o[i] = lut[((int)r[values + (i >> 5)] << 8) | r[i]];
+    }
+}
+
+/* the gate's flag: every store of this thread before it is visible to whoever reads the flag with acquire */
+void tf_dsv41_engram_publish(int64_t *p, int64_t v) { __atomic_store_n(p, v, __ATOMIC_RELEASE); }
+int64_t tf_dsv41_engram_peek(const int64_t *p) { return __atomic_load_n(p, __ATOMIC_ACQUIRE); }
+"""
+
+_LOCK = threading.Lock()
+_LIB: list = []
+
+
+def _lib():
+    """The compiled reader (ctypes; releases the GIL during the call), or None."""
+
+    with _LOCK:
+        if _LIB:
+            return _LIB[0]
+        lib = None
+        cc = os.environ.get("CC", "") or shutil.which("cc") or shutil.which("gcc")
+        if cc and (os.environ.get("TF_DSV41_ENGRAM_NATIVE", "1").strip() or "1") != "0":
+            root = Path(os.environ.get("TF_DSV41_NATIVE_DIR", "") or Path.home() / ".cache/tensorfold/dsv41-native")
+            tag = hashlib.sha256(SOURCE.encode()).hexdigest()[:16]
+            so = root / f"engram_read_{tag}.so"
+            try:
+                if not so.exists():
+                    root.mkdir(parents=True, exist_ok=True)
+                    src = root / f"engram_read_{tag}.c"
+                    src.write_text(SOURCE)
+                    tmp = root / f".engram_read_{tag}.{os.getpid()}.so"
+                    subprocess.run([cc, "-O2", "-shared", "-fPIC", "-pthread", str(src), "-o", str(tmp)], check=True,
+                                   capture_output=True, timeout=120)
+                    os.replace(tmp, so)
+                lib = ctypes.CDLL(str(so))
+                p64 = ctypes.POINTER(ctypes.c_int64)
+                lib.tf_dsv41_engram_read.argtypes = [ctypes.c_int, ctypes.c_int, p64, p64, p64,
+                                                     ctypes.POINTER(ctypes.c_uint8), ctypes.c_int]
+                lib.tf_dsv41_engram_read.restype = ctypes.c_int
+                lib.tf_dsv41_engram_readv.argtypes = [ctypes.c_int, ctypes.c_void_p, p64, p64, p64, ctypes.c_void_p,
+                                                      ctypes.c_int]
+                lib.tf_dsv41_engram_readv.restype = ctypes.c_int
+                lib.tf_dsv41_engram_dequant.argtypes = [ctypes.c_void_p, p64, ctypes.c_int, ctypes.c_int,
+                                                        ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p]
+                lib.tf_dsv41_engram_dequant.restype = None
+                lib.tf_dsv41_engram_publish.argtypes = [ctypes.c_void_p, ctypes.c_int64]
+                lib.tf_dsv41_engram_publish.restype = None
+                lib.tf_dsv41_engram_peek.argtypes = [ctypes.c_void_p]
+                lib.tf_dsv41_engram_peek.restype = ctypes.c_int64
+            except (OSError, subprocess.SubprocessError):
+                lib = None
+        _LIB.append(lib)
+        return lib
+
+
+def available() -> bool:
+    return _lib() is not None
+
+
+def threads() -> int:
+    return max(1, int(os.environ.get("TF_DSV41_ENGRAM_THREADS", "") or 32))
+
+
+def plan(rows: np.ndarray, lo: int, row_bytes: int, header: int, gap: int = 4096):
+    """Sorted unique rows -> (extent offsets, lengths, buffer offsets, buffer bytes, each row's buffer offset):
+    ``engram_host.extents``' extents (sector-aligned, merged across holes <= ``gap``), vectorized."""
+
+    start = header + (rows.astype(np.int64) - lo) * row_bytes
+    s0 = start // SECTOR * SECTOR
+    s1 = -(-(start + row_bytes) // SECTOR) * SECTOR
+    reach = np.maximum.accumulate(s1)
+    new = np.ones(rows.size, dtype=bool)
+    new[1:] = s0[1:] > reach[:-1] + gap
+    first = np.flatnonzero(new)
+    off = s0[first]
+    end = np.maximum.reduceat(s1, first)
+    length = end - off
+    room = -(-length // ALIGN) * ALIGN
+    dst = np.concatenate([[0], np.cumsum(room)[:-1]]).astype(np.int64)
+    ext = np.cumsum(new) - 1                                    # each row's extent
+    at = dst[ext] + (start - off[ext])
+    return off.astype(np.int64), length.astype(np.int64), dst, int(room.sum()), at.astype(np.int64)
+
+
+def read(fd: int, rows: np.ndarray, lo: int, row_bytes: int, header: int, gap: int = 4096) -> np.ndarray:
+    """[N, row_bytes] uint8 records of sorted unique ``rows`` from the shard open as ``fd``."""
+
+    lib = _lib()
+    if lib is None:
+        raise RuntimeError("the native Engram reader is not available (no C compiler)")
+    if rows.size == 0:
+        return np.empty((0, row_bytes), dtype=np.uint8)
+    off, length, dst, total, at = plan(rows, lo, row_bytes, header, gap)
+    raw = np.empty(total + ALIGN, dtype=np.uint8)
+    a = (-raw.ctypes.data) % ALIGN                              # 4 KiB aligned: what O_DIRECT needs
+    buf = raw[a:a + total]
+    p64 = ctypes.POINTER(ctypes.c_int64)
+    rc = lib.tf_dsv41_engram_read(int(fd), int(off.size), off.ctypes.data_as(p64), length.ctypes.data_as(p64),
+                                  dst.ctypes.data_as(p64), buf.ctypes.data_as(ctypes.POINTER(ctypes.c_uint8)),
+                                  threads())
+    if rc != 0:
+        raise OSError(rc, f"Engram shard read failed: {os.strerror(rc)}")
+    return buf[at[:, None] + np.arange(row_bytes)]
+
+
+def records(src, index) -> np.ndarray:
+    """``engram_host.ShardRows.raw`` through the native reader: [N, 264] records of global rows ``index`` (any
+    order, duplicates allowed)."""
+
+    h = src.header
+    want = np.asarray(index.reshape(-1).cpu().numpy() if hasattr(index, "cpu") else index, dtype=np.int64)
+    if want.size and (want.min() < h.lo or want.max() >= h.hi):
+        raise ValueError(f"{src.path}: rows outside this shard [{h.lo}, {h.hi})")
+    uniq, inv = np.unique(want, return_inverse=True)
+    from .engram_host import HEADER
+
+    got = read(src.fd, uniq, h.lo, h.row_bytes, HEADER, src.gap)
+    src.stats["rows"] += int(want.size)
+    src.stats["reads"] += 1
+    return got[inv]
+
+
+def queue_depth() -> int:
+    """``TF_DSV41_ENGRAM_QD`` (64): reads in flight in a decode batch (``readv``: the persistent pool's threads + 1)."""
+
+    return max(1, int(os.environ.get("TF_DSV41_ENGRAM_QD", "") or 64))
+
+
+def readv(parts, depth: int | None = None) -> list[np.ndarray]:
+    """One decode batch over several shards: ``parts`` [(fd, sorted unique rows, lo, row_bytes, header, gap)] ->
+    each part's [n, row_bytes] records, every extent of every part in one submission (``queue_depth`` in flight)."""
+
+    lib = _lib()
+    if lib is None:
+        raise RuntimeError("the native Engram reader is not available (no C compiler)")
+    plans, fds, offs, lens, dsts, base = [], [], [], [], [], 0
+    for fd, rows, lo, row_bytes, header, gap in parts:
+        if rows.size == 0:
+            plans.append(None)
+            continue
+        off, length, dst, total, at = plan(rows, lo, row_bytes, header, gap)
+        plans.append((base, at, row_bytes))
+        fds.append(np.full(off.size, int(fd), dtype=np.int32))
+        offs.append(off)
+        lens.append(length)
+        dsts.append(dst + base)
+        base += -(-total // ALIGN) * ALIGN
+    out = [np.empty((0, p[3]), dtype=np.uint8) for p in parts]
+    if not fds:
+        return out
+    fd_a, off_a, len_a, dst_a = (np.ascontiguousarray(np.concatenate(v)) for v in (fds, offs, lens, dsts))
+    raw = np.empty(base + ALIGN, dtype=np.uint8)
+    a = (-raw.ctypes.data) % ALIGN                              # 4 KiB aligned: what O_DIRECT needs
+    buf = raw[a:a + base]
+    p64 = ctypes.POINTER(ctypes.c_int64)
+    rc = lib.tf_dsv41_engram_readv(int(fd_a.size), fd_a.ctypes.data, off_a.ctypes.data_as(p64),
+                                   len_a.ctypes.data_as(p64), dst_a.ctypes.data_as(p64), buf.ctypes.data,
+                                   int(depth or queue_depth()))
+    if rc != 0:
+        raise OSError(rc, f"Engram shard read failed: {os.strerror(rc)}")
+    for i, pl in enumerate(plans):
+        if pl is not None:
+            b0, at, rb = pl
+            out[i] = buf[b0 + at[:, None] + np.arange(rb)]
+    return out
+
+
+def dequant(arena: np.ndarray, idx: np.ndarray, dim: int, values: int, lut: np.ndarray, out: np.ndarray) -> None:
+    """``out`` [n, dim] uint16 (bf16 bits) = ``lut[scale << 8 | byte]`` of records ``arena[idx]`` (C, no GIL)."""
+
+    lib = _lib()
+    idx = np.ascontiguousarray(idx, dtype=np.int64)
+    if not (arena.flags.c_contiguous and out.flags.c_contiguous and lut.dtype == np.uint16 and out.dtype == np.uint16):
+        raise ValueError("engram_native.dequant: contiguous arena / out, uint16 table and output")
+    if out.shape[0] < idx.size or out.shape[1] != dim:
+        raise ValueError("engram_native.dequant: out [>= n, dim]")
+    if idx.size and (idx.min() < 0 or idx.max() >= arena.shape[0]):
+        raise ValueError("engram_native.dequant: record index outside the arena")
+    lib.tf_dsv41_engram_dequant(arena.ctypes.data, idx.ctypes.data_as(ctypes.POINTER(ctypes.c_int64)),
+                                int(idx.size), int(dim), int(arena.shape[1]), int(values), lut.ctypes.data,
+                                out.ctypes.data)
+
+
+def publish(addr: int, value: int) -> None:
+    """A release store of ``value`` at ``addr`` (int64): the GPU's acquire load of the flag sees every byte before."""
+
+    _lib().tf_dsv41_engram_publish(int(addr), int(value))
+
+
+def peek(addr: int) -> int:
+    return int(_lib().tf_dsv41_engram_peek(int(addr)))
+
+
+__all__ = ["available", "dequant", "peek", "plan", "publish", "queue_depth", "read", "readv", "records", "threads"]
