index 0000000..9147f44
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/prefetch.py
@@ -0,0 +1,391 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram reads off the critical path (docs/ENGINE-PLAN.md section 6; the serving protocol's ``Prefetch`` hook).
+
+G2 measured 5.75 ms a serial step of Engram inputs on the host before any GPU work: the n-gram hash, then each
+layer's rows read one O_DIRECT extent after another (a 5-row window is ~60 random 4 KiB reads a layer, ~80 us each),
+then the exchange. Here:
+
+- **Rows, not windows.** Each Engram layer's reads are tracked per table row: a row is cached (an LRU of
+  ``TF_DSV41_ENGRAM_CACHE`` records a layer, 65,536 = 17 MB), in flight (a future of the extent read holding it), or
+  unknown. ``issue`` starts reads for every row of the next forward that is neither; ``rows(index)`` (the forward's
+  row source) takes cached rows, waits for in-flight ones, reads the rest synchronously (a *miss*), and caches all.
+- **Parallel extents.** A batch's sector-aligned extents (``engram_host.extents``, holes up to 4 KiB merged) are
+  read concurrently on ``TF_DSV41_PREFETCH_WORKERS`` threads (16; ``os.preadv`` releases the GIL), so a window's
+  reads cost about one NVMe latency, not one per extent.
+- **Earlier issue.** The batcher's commit names the next window's pending token (the bonus), so its rows are issued
+  at commit (``issue_pending``), before the DSpark pass; the drafted rows at drafter end (``issue``); a prefill's
+  chunks before ``Forward.prefill``.
+- **Hash once.** ``CachedHasher`` memoizes the forward's hasher by (ids, lookback): the issue's hashes are the
+  forward's (``fw.hasher`` is the same function; only repeated calls are skipped).
+- The forward's ``_engram_inputs`` is lazy in ``decode.DecodeForward`` (a layer's rows are gathered when the
+  forward reaches that layer: layer 14's reads finish behind 13 layers of launches).
+
+Exactness: a row's bytes are the file's whatever the path (cache, in flight, synchronous), dequantized by the
+source's own rule (``engram_host.dequant``), so replies never depend on prefetching. Sources without records
+(``MemoryRows``: tests, in-memory tables) are read through as before (a future per issued index tensor).
+
+- **One segment ahead** (``TF_DSV41_PREFETCH_AHEAD=1``, G7): a prefill round also issues the bulk reads of the slot's
+  NEXT segment (``rounds.Executor``: the prompt's next rows with the lookback they will see), and the next round's
+  ``issue`` keeps a bulk read already in flight for the same (layer, rows) instead of dropping it. G5's nsys of a 32K
+  prefill: the GPU's only idle time (1.87 of 2.1 s) is layer 1's Engram wait at the start of every segment (~115 ms
+  of a ~220 ms read issued at round start, behind the plan exchange that drained the GPU); read a round early it is
+  ready when the forward reaches layer 1. A wrong guess (a piece cut at the snapshot point) is a miss: the rows are
+  read then, the same bytes.
+
+Knobs: TF_DSV41_PREFETCH (1; 0 = synchronous reads), TF_DSV41_PREFETCH_WORKERS (16), TF_DSV41_ENGRAM_CACHE (65536
+rows a layer; 0 = no cache), TF_DSV41_PREFETCH_AHEAD (0; 1 = the next prefill segment's bulk reads a round early).
+"""
+
+from __future__ import annotations
+
+import os
+from collections import OrderedDict
+from concurrent.futures import Future, ThreadPoolExecutor
+
+import numpy as np
+import torch
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_PREFETCH", "1").strip() or "1") != "0"
+
+
+def ahead_enabled() -> bool:
+    """``TF_DSV41_PREFETCH_AHEAD``: a prefill round also reads the next segment's Engram rows (0 = off, default)."""
+
+    return (os.environ.get("TF_DSV41_PREFETCH_AHEAD", "0").strip() or "0") != "0"
+
+
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    v = int(raw) if raw else default
+    if v < 0:
+        raise ValueError(f"{name}={v}: expected >= 0")
+    return v
+
+
+class CachedHasher:
+    """The forward's hasher with a small memo keyed by (ids, lookback): the prefetch and the forward hash a window
+    once. Calls with ``dead`` or other keywords go straight through (the hash is a function of its arguments only)."""
+
+    def __init__(self, inner, size: int = 256) -> None:
+        self.inner, self.size = inner, size
+        self.memo: OrderedDict = OrderedDict()
+        self.stats = {"hits": 0, "calls": 0}
+
+    def __getattr__(self, name):
+        return getattr(self.inner, name)
+
+    def __call__(self, ids, dead=None, lookback=None, **kw):
+        if dead is not None or kw:                      # anything beyond (ids, lookback): not memoized
+            return self.inner(ids, dead=dead, lookback=lookback, **kw)
+        key = (tuple(int(t) for t in torch.as_tensor(ids).reshape(-1).tolist()),
+               tuple(int(t) for t in torch.as_tensor([] if lookback is None else lookback).reshape(-1).tolist()))
+        self.stats["calls"] += 1
+        got = self.memo.get(key)
+        if got is not None:
+            self.memo.move_to_end(key)
+            self.stats["hits"] += 1
+            return got.clone()
+        out = self.inner(ids, lookback=lookback)
+        self.memo[key] = out
+        if len(self.memo) > self.size:
+            self.memo.popitem(last=False)
+        return out.clone()
+
+
+class _Rows:
+    """One layer's records of a packed shard (``engram_host.ShardRows``): the LRU cache and the in-flight reads."""
+
+    def __init__(self, src, pool: ThreadPoolExecutor, cache: int, stats: dict) -> None:
+        self.src, self.pool, self.cap, self.stats = src, pool, cache, stats
+        self.cache: OrderedDict[int, np.ndarray] = OrderedDict()
+        self.flight: dict[int, Future] = {}
+
+    def _read(self, ids: np.ndarray) -> dict[int, Future]:
+        """Start the extent reads of sorted unique rows ``ids``: {row: future of {row: record}}."""
+
+        from .engram_host import HEADER, extents
+
+        h = self.src.header
+        if ids.size and (ids.min() < h.lo or ids.max() >= h.hi):
+            raise ValueError(f"{self.src.path}: rows outside this shard [{h.lo}, {h.hi})")
+        out: dict[int, Future] = {}
+        for off, length, rs in extents(ids, h.lo, h.row_bytes, self.src.gap):
+            def job(off=off, length=length, rs=rs):
+                buf = self.src._extent(off, length)
+                a = HEADER + (rs - h.lo) * h.row_bytes - off
+                return {int(r): buf[int(x):int(x) + h.row_bytes].copy() for r, x in zip(rs.tolist(), a.tolist())}
+
+            fut = self.pool.submit(job)
+            self.stats["reads"] += 1
+            for r in rs.tolist():
+                out[int(r)] = fut
+        return out
+
+    def issue(self, index) -> int:
+        """Start reads for the rows of ``index`` neither cached nor in flight; the number started."""
+
+        want = np.unique(np.asarray(index, dtype=np.int64).reshape(-1))
+        new = np.asarray([r for r in want.tolist() if r not in self.cache and r not in self.flight], dtype=np.int64)
+        if new.size:
+            self.flight.update(self._read(new))
+        return int(new.size)
+
+    def _put(self, r: int, rec: np.ndarray) -> None:
+        if self.cap <= 0:
+            return
+        self.cache[r] = rec
+        self.cache.move_to_end(r)
+        while len(self.cache) > self.cap:
+            self.cache.popitem(last=False)
+
+    def records(self, index: torch.Tensor) -> tuple[np.ndarray, bool]:
+        """([N, 264] uint8 records of ``index``, whether every row was cached or in flight)."""
+
+        want = np.asarray(index.reshape(-1).cpu().numpy(), dtype=np.int64)
+        uniq, inv = np.unique(want, return_inverse=True)
+        got: dict[int, np.ndarray] = {}
+        missing = []
+        for r in uniq.tolist():
+            rec = self.cache.get(r)
+            if rec is not None:
+                self.cache.move_to_end(r)
+                got[r] = rec
+                self.stats["cached"] += 1
+            elif r in self.flight:
+                got[r] = None
+            else:
+                missing.append(r)
+        for r in [r for r, v in got.items() if v is None]:
+            fut = self.flight.pop(r)
+            rows = fut.result()
+            self.stats["waited"] += 1
+            got[r] = rows[r]
+        if missing:
+            futs = self._read(np.asarray(missing, dtype=np.int64))
+            for r, fut in futs.items():
+                got[r] = fut.result()[r]
+        for r in uniq.tolist():
+            self._put(r, got[r])
+        out = np.stack([got[r] for r in uniq.tolist()]) if uniq.size else \
+            np.empty((0, self.src.header.row_bytes), dtype=np.uint8)
+        return out[inv], not missing
+
+    def drop_flight(self) -> int:
+        """Forget reads nobody asked for (their rows still land in the cache when they finish)."""
+
+        n = 0
+        for r, fut in list(self.flight.items()):
+            if fut.done():
+                rows = fut.result()
+                self._put(r, rows[r])
+                del self.flight[r]
+                n += 1
+        return n
+
+
+class Prefetched:
+    """A row source whose reads may have been issued ahead (``rows(index)`` as the source's)."""
+
+    def __init__(self, src, owner: Prefetcher, layer: int) -> None:
+        self.src, self.owner, self.layer = src, owner, layer
+
+    def rows(self, index: torch.Tensor) -> torch.Tensor:
+        return self.owner.rows(self.layer, index)
+
+    def __getattr__(self, name):
+        return getattr(self.src, name)
+
+
+class Prefetcher:
+    """This rank's Engram reads: per layer, the record cache and in-flight reads of a packed shard (``_Rows``), or
+    a future per issued index tensor for sources without records."""
+
+    def __init__(self, sources: dict, *, workers: int | None = None, cache: int | None = None) -> None:
+        self.sources = dict(sources)
+        n = workers or _env_int("TF_DSV41_PREFETCH_WORKERS", 16) or 1
+        cap = _env_int("TF_DSV41_ENGRAM_CACHE", 65536) if cache is None else int(cache)
+        self.pool = ThreadPoolExecutor(max_workers=max(1, n), thread_name_prefix="dsv41-engram")
+        self.stats = {"issued": 0, "hits": 0, "misses": 0, "dropped": 0, "reads": 0, "cached": 0, "waited": 0,
+                      "ahead": 0, "kept": 0}
+        self.layers = {L: _Rows(src, self.pool, cap, self.stats) for L, src in self.sources.items()
+                       if hasattr(src, "_extent") and hasattr(src, "header")}
+        self.pending: dict[tuple[int, bytes], list[Future]] = {}
+        self.bulk: dict[tuple[int, bytes], Future] = {}         # prompt-sized reads: one job a (layer, run)
+
+    def wrap(self) -> dict:
+        return {L: Prefetched(src, self, L) for L, src in self.sources.items()}
+
+    def close(self) -> None:
+        self.pool.shutdown(wait=True)
+
+    @staticmethod
+    def _key(layer: int, index: torch.Tensor) -> tuple[int, bytes]:
+        return int(layer), index.detach().reshape(-1).to("cpu", torch.int64).numpy().tobytes()
+
+    def take(self, layer: int, index: torch.Tensor) -> Future | None:
+        q = self.pending.get(self._key(layer, index))
+        return q.pop(0) if q else None
+
+    def rows(self, layer: int, index: torch.Tensor) -> torch.Tensor:
+        """The forward's read of ``index`` (global rows of this rank's heads) -> fp32 [N, 256]."""
+
+        lr = self.layers.get(layer)
+        if lr is not None and index.numel() >= BULK_ROWS:
+            fut = self.bulk.pop(self._key(layer, index), None)
+            self.stats["hits" if fut is not None else "misses"] += 1
+            return fut.result() if fut is not None else bulk_rows(lr.src, index)
+        if lr is None:
+            fut = self.take(layer, index)
+            if fut is not None:
+                self.stats["hits"] += 1
+                return fut.result()
+            self.stats["misses"] += 1
+            return self.sources[layer].rows(index)
+        from .engram_host import VALUES, dequant
+
+        rec, ahead = lr.records(index)
+        self.stats["hits" if ahead else "misses"] += 1
+        dim = lr.src.dim
+        t = torch.from_numpy(rec)
+        return dequant(t[:, :dim], t[:, VALUES:VALUES + dim // 32])
+
+    def clear(self) -> None:
+        self.stats["dropped"] += sum(len(q) for q in self.pending.values()) + len(self.bulk)
+        self.pending.clear()
+        self.bulk.clear()
+        for lr in self.layers.values():
+            lr.drop_flight()
+
+    def _issue_index(self, layer: int, idx: torch.Tensor, reuse: dict | None = None) -> None:
+        lr = self.layers.get(layer)
+        if lr is not None and idx.numel() >= BULK_ROWS:
+            key = self._key(layer, idx)
+            fut = reuse.pop(key, None) if reuse else None
+            if fut is not None:
+                self.stats["kept"] += 1                 # issued a round ahead: still the same rows
+                self.bulk[key] = fut
+                return
+            self.bulk[key] = self.pool.submit(bulk_rows, lr.src, idx)
+        elif lr is not None:
+            lr.issue(idx.numpy())
+        else:
+            src = self.sources[layer]
+            self.pending.setdefault(self._key(layer, idx), []).append(self.pool.submit(src.rows, idx))
+        self.stats["issued"] += 1
+
+    def _hashes(self, fw, ids, lookback) -> torch.Tensor:
+        return fw.hasher(torch.tensor([int(t) for t in ids], dtype=torch.long),
+                         lookback=torch.tensor([t for t in lookback if t >= 0], dtype=torch.long))
+
+    def _issue_hashes(self, fw, hashes: torch.Tensor, reuse: dict | None = None, bulk_only: bool = False) -> None:
+        for blk in fw.blocks:
+            if blk.engram is None:
+                continue
+            li = blk.cfg.engram_layer_ids.index(blk.index)
+            _, _, h0, nh = fw.hasher.layout.head_shard(li, fw.rank, fw.world)
+            idx = hashes[:, li, h0:h0 + nh].reshape(-1)
+            if bulk_only and (blk.index not in self.layers or idx.numel() < BULK_ROWS):
+                continue
+            self._issue_index(blk.index, idx, reuse)
+
+    def issue(self, fw, segments, ahead=()) -> None:
+        """``segments``: runs (lists of (slot, ids, lookback ids)) in the order the forward will run them. Rows of
+        a packed shard are issued row by row (a row cached or in flight is not read again); other sources get a
+        future per run's index tensor, as the forward will ask for it. ``ahead``: the next round's likely runs
+        (``TF_DSV41_PREFETCH_AHEAD``): their bulk reads start now, after this round's; a bulk read issued ahead by the
+        previous round for the same rows is kept, any other one dropped."""
+
+        keep, self.bulk = self.bulk, {}
+        self.clear()
+        try:
+            if fw.hasher is None or not any(blk.engram is not None for blk in fw.blocks):
+                return
+            for run in segments:
+                hashes = torch.cat([self._hashes(fw, ids, lb) for _, ids, lb in run])
+                self._issue_hashes(fw, hashes, keep)
+            for run in ahead:
+                hashes = torch.cat([self._hashes(fw, ids, lb) for _, ids, lb in run])
+                n = len(self.bulk)
+                self._issue_hashes(fw, hashes, keep, bulk_only=True)
+                self.stats["ahead"] += len(self.bulk) - n
+        finally:
+            self.stats["dropped"] += len(keep)
+
+    def issue_pending(self, fw, slot: int, token: int) -> None:
+        """At a commit: the next window's pending row (``token`` after the slot's committed ids), before the DSpark
+        pass. Only packed shards (row-level tracking) take it."""
+
+        if fw.hasher is None or not self.layers:
+            return
+        hashes = self._hashes(fw, [int(token)], list(fw.slots[slot].tail))
+        for blk in fw.blocks:
+            if blk.engram is None or blk.index not in self.layers:
+                continue
+            li = blk.cfg.engram_layer_ids.index(blk.index)
+            _, _, h0, nh = fw.hasher.layout.head_shard(li, fw.rank, fw.world)
+            self.layers[blk.index].issue(hashes[:, li, h0:h0 + nh].reshape(-1).numpy())
+
+
+BULK_ROWS = 4096                # rows of one layer's read (a prompt segment's): one bulk job, no per-row cache
+
+
+def bulk_rows(src, index: torch.Tensor) -> torch.Tensor:
+    """A prompt segment's rows of a packed shard at once (``engram_native`` when built, else the shard's reader),
+    dequantized by the source's rule: fp32 [N, 256], the bytes and values ``rows`` gives."""
+
+    from .engram_host import VALUES, dequant
+
+    rec = torch.from_numpy(src.raw(index))
+    return dequant(rec[:, :src.dim], rec[:, VALUES:VALUES + src.dim // 32])
+
+
+def lookback_after(tail: list[int], ids, keep: int) -> list[int]:
+    """``forward.keep``'s Engram lookback after ``ids`` were kept on top of ``tail``."""
+
+    return (list(tail) + [int(t) for t in ids])[-max(1, keep):]
+
+
+def piece_runs(fw, pieces, after=()) -> list[list[tuple[int, tuple, list]]]:
+    """``slots.SlotsForward.prefill``'s runs of a round's pieces: the k-th chunk of every piece in run k, each chunk
+    with the lookback it will see (the slot's tail, then the piece's own ids). ``after``: pieces that run first (the
+    current round's, when ``pieces`` are the next round's guess): their ids extend the lookback."""
+
+    from .slots import prefill_runs
+
+    keep = max(1, fw.cfg.engram_max_ngram_size - 1)
+    tails = {pc.slot: list(fw.slots[pc.slot].tail) for pc in list(after) + list(pieces)}
+    for pc in after:
+        tails[pc.slot] = lookback_after(tails[pc.slot], pc.ids, keep)
+    out = []
+    for run in prefill_runs(pieces, getattr(fw, "pchunk", fw.chunk)):
+        r = []
+        for slot, _, ids in run:
+            r.append((slot, ids, list(tails[slot])))
+            tails[slot] = lookback_after(tails[slot], ids, keep)
+        out.append(r)
+    return out
+
+
+def next_pieces(pieces, prompts) -> list:
+    """The likely next round's pieces (``TF_DSV41_PREFETCH_AHEAD``): each slot's prompt rows after this round's piece,
+    as many as this piece held, up to the prompt's last token (which runs as the first verify row). ``prompts``:
+    slot -> the prompt (or None)."""
+
+    from .protocol import Piece
+
+    out = []
+    for pc in pieces:
+        p = prompts[pc.slot]
+        if p is None:
+            continue
+        a, last = pc.start + len(pc.ids), len(p) - 1
+        if a < last:
+            out.append(Piece(pc.slot, a, tuple(int(t) for t in p[a:min(last, a + len(pc.ids))])))
+    return out
+
+
+__all__ = ["CachedHasher", "Prefetched", "Prefetcher", "ahead_enabled", "enabled", "lookback_after", "next_pieces",
+           "piece_runs"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/prefill_mm.py b/src/tensorfold/families/deepseek_v41/cuda/prefill_mm.py
