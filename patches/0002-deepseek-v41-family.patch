@@ -0,0 +1,507 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DSpark (checkpoint ``mtp.0-2``) on the multi-slot forward: the drafter's weights, its per-slot context rings fed
+from the target's mHC taps, and one drafting pass over several slots (docs/ENGINE-PLAN.md section 7; the glue and
+kernels are ``dspark.py``; engine/reference/model.py ``DSpark`` is the math).
+
+- **Taps** (``forward.run`` with ``taps=True``): the mean of the 4 streams entering layers 37, 38, 39, written by
+  the mHC boundary kernels; ``forward.keep`` keeps the committed rows' taps and ``ingest`` turns them into each
+  block's context rows: ``main_x = bf16(rms(main_proj(taps), main_norm))``, then per block
+  ``rope(bf16(rms(wkv(main_x), kv_norm)))`` into the slot's ring for that block (``ring`` >= window + block, a
+  power of two). Only the last ``window`` rows of a run are written (older ones are never read).
+- **A pass** (``propose``): block ids [anchor, noise x (N - 1)] at positions P .. P + N - 1 for every slot at once;
+  the blocks run like backbone blocks (mHC sites / boundaries, attention, the 128-expert top-3 MoE) with the
+  attention of ``dspark.attention_meta``: every draft row sees the context rows max(P - window, 0) .. P - 1 (ring
+  slots as the "compressed" list) plus the whole block (the SWA chunk lo = P, hi = P + N - 1), vLLM's non-causal
+  DSpark window; then ``mhc.final`` with DSpark's norm, the target's head (vocabulary halves), each rank's best K
+  candidates gathered (one exchange), and the chain (Markov head, keyed draft noise, confidence head): on CUDA the
+  ``dspark.chain`` kernel, elsewhere ``chain_host`` (the same rule in numpy / ``exact_sampling.choose``).
+
+Pass rows (``TF_DSV41_DRAFT_ROWS``, 1 .. block, default the block, 5): the rows a pass drafts. vLLM runs
+``num_speculative_steps`` rows (the kit at k = 3: [anchor, noise, noise]), we run the whole trained block. Fewer rows
+read fewer of the blocks' routed experts (top-3 a row) and attend fewer noise rows, so they change the drafts and
+their confidences (an acceptance A/B for prose, where depth rarely passes 2) and cap the depth at the rows.
+
+The pass (``propose``) runs on static inputs (``draft_graphs.DraftInputs``: one set per (slots padded to a power of
+two, rows, head variant), staged with two copies) and replays that key's CUDA graph when
+``decode.DecodeForward.boot`` made ``draft_graphs.DraftGraphs`` (else eagerly, the same kernels). G8: the slots'
+rings of a block are one stacked store (``stacked``; a slot's ring is a view), so on the Triton kernels the pass is
+row mode: one ring store and one attention launch a block over every slot's rows (``rowmode``), any slots. The
+head is ``TF_DSV41_DRAFT_HEAD`` (``draft_head``: the target's EXL3 head, a 4-bit copy, or a 4-bit copy of a listed
+vocabulary with a full-head fallback); a trimmed head's columns map to token ids before the candidates' exchange,
+so the keyed draft noise is the target's.
+
+Both ranks run every pass with the same inputs, so both get the same drafts and confidences. Drafts never change a
+reply (verification is exact: ``dspark.accept``); rows of the block written into the ring at P .. P + N - 1 lie past
+the context and are overwritten by the commit's taps before any pass reads them.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import os
+
+import numpy as np
+import torch
+
+from . import blocks as B
+from . import numerics as N
+from .csa2.backend import Win
+from .draft_graphs import DraftInputs
+from .draft_head import DraftHead
+from .forward import next_pow2
+from .lookup import sampling_of
+
+F32, BF16 = torch.float32, torch.bfloat16
+
+
+@dataclass
+class DraftW:
+    layers: list                 # weights.LayerW of mtp.0 .. mtp.{n - 1}
+    main_proj: object            # X3 [3 D -> D]
+    main_norm: torch.Tensor
+    norm: torch.Tensor
+    w1: torch.Tensor             # bf16 [V, r] markov_head.embed
+    w2: torch.Tensor             # bf16 [V, r] markov_head.head
+    conf: torch.Tensor | None    # fp32 [D + r] confidence_head.proj
+
+
+def _find(src, cfg, suffix: str) -> str | None:
+    for i in reversed(range(cfg.num_nextn_predict_layers)):
+        n = f"mtp.{i}.{suffix}"
+        if n in src or f"{n}.trellis" in src or f"{n}.weight" in src:
+            return n
+    return None
+
+
+def present(src, cfg) -> bool:
+    """The checkpoint holds DSpark (its blocks and heads)."""
+
+    return cfg.num_nextn_predict_layers > 0 and all(_find(src, cfg, s) for s in (
+        "main_proj", "main_norm", "norm", "markov_head.embed", "markov_head.head"))
+
+
+def load(loader) -> DraftW:
+    """This rank's DSpark weights (``weights.Loader``): the blocks split like backbone blocks, the rest whole."""
+
+    cfg, src = loader.cfg, loader.src
+    nh = cfg.num_hidden_layers
+    layers = [loader.layer(nh + i) for i in range(cfg.num_nextn_predict_layers)]
+    f = lambda s: _find(src, cfg, s)
+    conf = f("confidence_head.proj")
+    w = DraftW(layers, loader.x3(f("main_proj")), loader.native(f"{f('main_norm')}.weight"),
+               loader.native(f"{f('norm')}.weight"),
+               loader.native(f"{f('markov_head.embed')}.weight", BF16, bf16_param=True),
+               loader.native(f"{f('markov_head.head')}.weight", BF16, bf16_param=True),
+               None if conf is None else loader.native(f"{conf}.weight").reshape(-1).contiguous())
+    return heads_override(w)
+
+
+def heads_override(w: DraftW, path: str | None = None) -> DraftW:
+    """TF_DSV41_DSPARK_HEADS=<file.safetensors>: refit Markov / confidence heads (``drafttrain.export``) replace the
+    checkpoint's (same shapes; both ranks load the same file). Drafts only propose: replies stay serial."""
+
+    path = os.environ.get("TF_DSV41_DSPARK_HEADS", "").strip() if path is None else path
+    if not path:
+        return w
+    from safetensors import safe_open
+
+    with safe_open(path, "pt") as fh:
+        for k in fh.keys():
+            t = fh.get_tensor(k)
+            if k.endswith("markov_head.embed.weight") or k.endswith("markov_head.head.weight"):
+                old = w.w1 if "embed" in k else w.w2
+                if tuple(t.shape) != tuple(old.shape):
+                    raise ValueError(f"TF_DSV41_DSPARK_HEADS: {k} {tuple(t.shape)}, expected {tuple(old.shape)}")
+                new = t.to(BF16).to(old.device).contiguous()
+                if "embed" in k:
+                    w.w1 = new
+                else:
+                    w.w2 = new
+            elif k.endswith("confidence_head.proj.weight") and w.conf is not None:
+                t = t.reshape(-1)
+                if t.numel() != w.conf.numel():
+                    raise ValueError(f"TF_DSV41_DSPARK_HEADS: {k} has {t.numel()} values, expected {w.conf.numel()}")
+                w.conf = t.to(w.conf.dtype).to(w.conf.device).contiguous()
+    return w
+
+
+def context_meta(p: int, n: int, ring: int, window: int, valid: int = 0, device="cpu"):
+    """``dspark.attention_meta`` with a lower bound: context rows max(p - window, valid, 0) .. p - 1 (``valid``: the
+    first position whose ring row is this slot's, after a restore without DSpark rows)."""
+
+    a = max(p - window, valid, 0)
+    ctx = torch.arange(a, p, dtype=torch.int64) % ring
+    tokens = torch.full((n, window), -1, dtype=torch.int32)
+    tokens[:, :ctx.numel()] = ctx.to(torch.int32)
+    counts = torch.full((n,), ctx.numel(), dtype=torch.int32)
+    lo = torch.full((n,), p, dtype=torch.int32)
+    hi = torch.full((n,), p + n - 1, dtype=torch.int32)
+    return tokens.to(device), counts.to(device), lo.to(device), hi.to(device)
+
+
+def topk_host(logits: torch.Tensor, k: int, id0: int = 0) -> tuple[torch.Tensor, torch.Tensor]:
+    """``dspark.candidates`` in torch (any device): the best ``k`` of each row by (value desc, id asc)."""
+
+    v, i = torch.sort(-logits.float(), dim=1, stable=True)
+    return (i[:, :k] + id0).to(torch.int32), (-v[:, :k]).contiguous()
+
+
+def chain_host(cand: np.ndarray, cval: np.ndarray, w1: torch.Tensor, w2: torch.Tensor, anchors: Sequence[int],
+               samplings: Sequence, pos0: Sequence[int], hid: torch.Tensor | None, cw: torch.Tensor | None):
+    """The chain's rule on the host: z_i = base_i + w2[c] . w1[prev_i] over each row's candidates, the token by
+    (z desc, id asc) at T = 0 or ``exact_sampling.choose`` keyed at pos0 + i; conf_i = sigmoid(cw . [h_i; me_i])."""
+
+    from tensorfold.engine.exact_sampling import choose
+
+    S, Nn, _ = cand.shape
+    drafts = np.zeros((S, Nn), dtype=np.int64)
+    conf = np.zeros((S, Nn), dtype=np.float32)
+    D = hid.shape[-1] if hid is not None else 0
+    for s in range(S):
+        prev = int(anchors[s])
+        for i in range(Nn):
+            ids = cand[s, i]
+            live = ids >= 0
+            ids = ids[live].astype(np.int64)
+            me = w1[prev].float()
+            z = cval[s, i][live].astype(np.float32) + (w2[torch.from_numpy(ids)].float() @ me).numpy()
+            if samplings[s] is None:
+                tok = int(ids[np.lexsort((ids, -z))[0]])
+            else:
+                tok = choose(z, ids, int(pos0[s]) + i, samplings[s])
+            if cw is not None and hid is not None:
+                x = float(hid[s, i].float() @ cw[:D].float() + me @ cw[D:].float())
+                conf[s, i] = 1.0 / (1.0 + np.exp(-x))
+            drafts[s, i] = tok
+            prev = tok
+    return drafts, conf
+
+
+def _keep(inp, cand: torch.Tensor, cval: torch.Tensor, hid: torch.Tensor | None = None) -> None:
+    """The pass's gathered candidates and base logits (and the head hidden, ``hid``: TF_DSV41_DRAFT_LOG_HID) into
+    ``inp``'s static copies (made on the first, eager, call: a graph captured later writes the same buffers)."""
+
+    c = getattr(inp, "tree_cand", None)
+    if c is None or c.shape != cand.shape:
+        inp.tree_cand, inp.tree_base = torch.empty_like(cand), torch.empty_like(cval, dtype=F32)
+    inp.tree_cand.copy_(cand)
+    inp.tree_base.copy_(cval)
+    if hid is not None:
+        h = getattr(inp, "tree_hid", None)
+        if h is None or h.shape != hid.shape:
+            inp.tree_hid = torch.empty_like(hid)
+        inp.tree_hid.copy_(hid)
+
+
+def pass_rows(block: int) -> int:
+    """TF_DSV41_DRAFT_ROWS: the rows of a DSpark pass, 1 .. ``block`` (default ``block``)."""
+
+    raw = os.environ.get("TF_DSV41_DRAFT_ROWS", "").strip()
+    n = int(raw) if raw else block
+    if not 1 <= n <= block:
+        raise ValueError(f"TF_DSV41_DRAFT_ROWS={n}: expected 1 to {block}")
+    return n
+
+
+class Drafter:
+    """DSpark on ``fw`` (``forward.Forward``): ``ingest`` after each commit, ``propose`` for a round's slots."""
+
+    def __init__(self, fw, w: DraftW, *, k: int = 64) -> None:
+        cfg = fw.cfg
+        self.fw, self.cfg, self.dev = fw, cfg, fw.device
+        self.n = int(cfg.dspark_block_size)
+        self.rows = pass_rows(self.n)
+        self.noise = int(cfg.dspark_noise_token_id)
+        self.window = int(cfg.sliding_window)
+        self.ring = next_pow2(self.window + self.n)
+        self.k = max(1, min(int(k), 128 // fw.world))
+        self.blocks = [B.Block(cfg, lw, fw.device, fw.world) for lw in w.layers]
+        w.layers = []
+        self.main_proj = B.materialize(w.main_proj, fw.device)
+        self.main_norm, self.norm = w.main_norm, w.norm
+        self.w1, self.w2, self.cw = w.w1, w.w2, w.conf
+        self.rings: list[list] = []                 # slot -> a view a block of ``stacked``
+        self.stacked: list = []                     # block -> every slot's ring (slot x ``ring`` rows)
+        self.valid: list[int] = []
+        self.cuda = torch.device(fw.device).type == "cuda"
+        self.rowmode = getattr(fw.csa2, "name", "") == "triton"   # one launch a block over every slot (G8)
+        self.last_conf: list[list[float]] = []
+        self.head = DraftHead(fw)                   # TF_DSV41_DRAFT_HEAD (``draft_head``)
+        self.graphs = None                          # ``draft_graphs.DraftGraphs`` (``decode.DecodeForward.boot``)
+        self._inputs: dict = {}
+        self.keep_tree = False                      # ``tree.py``: keep each pass's candidates and base logits
+        self.last_tree: list | None = None          # [(cand int32 [N, C], base fp32 [N, C])] a slot, caller order
+        self.keep_hid = False                       # ``draftlog``: keep the head hidden too (TF_DSV41_DRAFT_LOG_HID)
+        self.last_hid: list | None = None           # [bf16 [N, D]] a slot, caller order (with ``keep_hid``)
+        self.on_ingest = None                       # ``draftlog`` (TF_DSV41_DRAFT_LOG_TAPS): (slot, start, taps [n, 3 D])
+
+    # -- per slot --------------------------------------------------------------------------------------------------
+    def _slot(self, slot: int) -> list:
+        if len(self.rings) <= slot:                 # restacked for more slots (contents kept; draft graphs drop)
+            from . import rowmode
+
+            S = max(slot + 1, len(self.fw.slots))
+            rings = [[None] * len(self.blocks) for _ in range(S)]
+            stacked = []
+            for b in range(len(self.blocks)):
+                big, views = rowmode.stack_rings(self.fw.csa2, [r[b] for r in self.rings], self.ring,
+                                                 self.cfg.head_dim, self.dev, S)
+                stacked.append(big)
+                for s in range(S):
+                    rings[s][b] = views[s]
+            self.rings, self.stacked = rings, stacked
+            self.valid += [0] * (S - len(self.valid))
+        return self.rings[slot]
+
+    def reset(self, slot: int) -> None:
+        self._slot(slot)
+        self.valid[slot] = 0
+        self.head.reset(slot)
+
+    def observe(self, slot: int, ids) -> None:
+        """Committed token ids of the slot (prompt and replies): the trimmed head's fallback rule."""
+
+        self.head.observe(slot, ids)
+
+    def ingest(self, slot: int, start: int, taps: dict) -> None:
+        """The committed rows' taps ({layer: [n, D]} at positions start ..) into the slot's context rings."""
+
+        aux = self.cfg.aux_layer_ids
+        if not taps or any(L not in taps for L in aux):
+            return
+        rings = self._slot(slot)
+        t = torch.cat([taps[L] for L in aux], -1)
+        if self.on_ingest is not None:
+            self.on_ingest(slot, start, t)
+        skip = max(0, t.shape[0] - self.window)
+        t = t[skip:].contiguous()
+        if not t.shape[0]:
+            return
+        eps = self.cfg.rms_norm_eps
+        mx = B.rms(self.main_proj(t, N.ACT), self.main_norm, eps)
+        win = Win.make(start + skip, t.shape[0], self.dev)
+        table = self.fw.tables[0]
+        for blk, ring in zip(self.blocks, rings):
+            A = blk.attn
+            kv = B.rms(A.wkv(mx, N.ACT), A.kv_norm, eps)
+            self.fw.csa2.kv_store(kv, table, ring, win, 0, self.ring)
+
+    # -- snapshots (the bounded state's DSpark part) ---------------------------------------------------------------
+    def snapshot(self, slot: int, pos: int) -> dict:
+        rows = torch.arange(max(0, pos - self.window, self.valid[slot] if slot < len(self.valid) else 0), pos,
+                            dtype=torch.long) % self.ring
+        out = {}
+        if len(rows):
+            raws = [r.raw(rows) for r in self._slot(slot)]
+            for name in raws[0]:
+                out[f"dspark_{name}"] = np.stack([r[name] for r in raws])
+        return out
+
+    def restore(self, slot: int, pos: int, arrays: dict) -> None:
+        rings = self._slot(slot)
+        names = [k[len("dspark_"):] for k in arrays if k.startswith("dspark_")]
+        n = arrays[f"dspark_{names[0]}"].shape[1] if names else 0
+        self.head.reset(slot)
+        if not names or len(rings) != arrays[f"dspark_{names[0]}"].shape[0]:
+            self.valid[slot] = pos                  # no rows: the context restarts at the restored position
+            return
+        rows = torch.arange(pos - n, pos, dtype=torch.long) % self.ring
+        for b, ring in enumerate(rings):
+            ring.put_raw(rows, {nm: np.ascontiguousarray(arrays[f"dspark_{nm}"][b]) for nm in names})
+        self.valid[slot] = pos - n
+
+    # -- one pass --------------------------------------------------------------------------------------------------
+    def inputs(self, key) -> DraftInputs:
+        """The static inputs of ``key`` = (sorted slots, rows, head variant), made once."""
+
+        inp = self._inputs.get(key)
+        if inp is None:
+            inp = self._inputs[key] = DraftInputs(self, key)
+        return inp
+
+    def _attention(self, blk, x: torch.Tensor, slots, inp: DraftInputs) -> torch.Tensor:
+        cfg, A, fw = self.cfg, blk.attn, self.fw
+        eps, n, act, acc = cfg.rms_norm_eps, x.shape[0], N.ACT, N.ACC
+        table = fw.tables[0]
+        fz = None
+        if getattr(blk, "fused", None) is not None:     # one launch a shared input (``fused_proj``), the same bits
+            from . import fused_proj as FP
+
+            fz = FP.active(blk)
+        if fz is not None:
+            qa, kva, _ = fz.x(x, False)
+        else:
+            qa, kva = A.wq_a(x, act), A.wkv(x, act)
+        qr = B.rms(qa, A.q_norm, eps)
+        kv = B.rms(kva, A.kv_norm, eps)
+        q = A.wq_b(qr, act).view(n, -1, cfg.head_dim)
+        q = table.apply(q.to(acc), inp.positions, dtype=act)    # no per-head q norm in V4.1 (as blocks.attention)
+        b_i = self.blocks.index(blk)
+        if inp.rowwin is not None:                  # every slot's rows at once over the stacked rings (G8)
+            ring = self.stacked[b_i]
+            fw.csa2.kv_store(kv, table, ring, inp.rowwin, 0, self.ring)
+            o = fw.csa2.attention(q.contiguous(), ring, inp.tok_all, inp.cnt_all, ring, inp.lo_all, inp.rowwin,
+                                  A.sink, table, self.ring, hi=inp.hi_all)
+            return self._out(fz, A, o, n)
+        o = None if len(slots) == 1 else torch.empty((n, q.shape[1], cfg.head_dim), dtype=act, device=x.device)
+        for i, (slot, win, (tok, cnt, lo, hi)) in enumerate(zip(slots, inp.wins, inp.metas)):
+            a, b = i * self.rows, (i + 1) * self.rows
+            ring = self.rings[slot][b_i]
+            fw.csa2.kv_store(kv[a:b], table, ring, win, 0, self.ring)
+            oi = fw.csa2.attention(q[a:b].contiguous(), ring, tok, cnt, ring, lo, win, A.sink, table, self.ring,
+                                   hi=hi)
+            if o is None:
+                o = oi
+            else:
+                o[a:b] = oi
+        return self._out(fz, A, o, n)
+
+    @staticmethod
+    def _out(fz, A, o, n):
+        act, acc = N.ACT, N.ACC
+        if fz is not None and getattr(fz, "o", None) is not None:
+            z = fz.oproj(o.reshape(n, -1))
+        else:
+            gl = len(A.wo_a)
+            og = o.reshape(n, gl, -1)
+            z = torch.cat([A.wo_a[g](og[:, g].contiguous(), act) for g in range(gl)], 1)
+        return A.wo_b(z, acc)
+
+    def _device_pass(self, inp: DraftInputs, variant: str):
+        """The blocks, the head and the gathered candidates of a staged pass: (cand int32, cval fp32 [R, W K], hid)."""
+
+        fw, cfg, dev = self.fw, self.cfg, self.dev
+        slots, R = inp.slots, inp.S * inp.n
+        D, hcm, ops = cfg.hidden_size, cfg.hc_mult, fw.hc
+        x = fw.embed_rows(inp.ids).repeat(1, hcm).contiguous()
+        out = torch.empty((R, D), dtype=N.ACT, device=dev)
+        scratch = ops.Scratch(R, dev, D)
+        coefs = [ops.Coefs(R, dev), ops.Coefs(R, dev)]
+        cur, gathered = 0, None
+        for blk in self.blocks:
+            ha = ops.Hc(blk.hc_attn.fn, blk.hc_attn.base, blk.hc_attn.scale)
+            if gathered is None:
+                ops.site(x, ha, blk.attn_norm, out, coefs[1 - cur], scratch, None)
+            else:
+                ops.boundary(x, x, gathered, coefs[cur], ha, blk.attn_norm, out, coefs[1 - cur], scratch)
+            cur = 1 - cur
+            gathered = fw.gather_partials(self._attention(blk, out, slots, inp))
+            hf = ops.Hc(blk.hc_ffn.fn, blk.hc_ffn.base, blk.hc_ffn.scale)
+            ops.boundary(x, x, gathered, coefs[cur], hf, blk.ffn_norm, out, coefs[1 - cur], scratch)
+            cur = 1 - cur
+            gathered = fw.gather_partials(blk.moe(out))
+        ops.final(x, x, gathered, coefs[cur], self.norm, out, scratch, None)
+        logits, idmap, id0 = self.head.logits(out, variant)
+        cand, cval = self._candidates(logits, idmap, id0)
+        return cand, cval, scratch.c[:R]
+
+    def pass_fn(self, inp: DraftInputs, variant: str):
+        """The whole pass on the device (blocks, head, candidates, chain into ``inp.out``): what a graph captures."""
+
+        from . import dspark
+
+        S, Nn, D = inp.S, inp.n, self.cfg.hidden_size
+        conf = inp.conf if self.cw is not None else None
+
+        def fn():
+            cand, cval, hid = self._device_pass(inp, variant)
+            if self.keep_tree:                      # before ``chain`` overwrites cval (static buffers: graphs too)
+                _keep(inp, cand, cval, hid if self.keep_hid else None)
+            dspark.chain(cand.view(S, Nn, -1).contiguous(), cval.view(S, Nn, -1).contiguous(), self.w1, self.w2,
+                         inp.anchor, inp.ipar, inp.fpar, inp.draft,
+                         hid=hid.reshape(S, Nn, D).contiguous() if conf is not None else None, cw=self.cw, conf=conf,
+                         scr=inp.scr)
+        return fn
+
+    def propose(self, slots: Sequence[int], anchors: Sequence[int], starts: Sequence[int],
+                noises: Sequence | None = None) -> tuple[list[list[int]], list[list[float]]]:
+        """Each slot's N drafts after its anchor (the pending token at ``starts[i]``) and their confidences."""
+
+        S, Nn = len(slots), self.rows
+        if not S:
+            return [], []
+        order = sorted(range(S), key=lambda i: int(slots[i]))      # one key a set of slots (graphs)
+        sl = tuple(int(slots[i]) for i in order)
+        for s in sl:
+            self._slot(s)
+        noises = noises or [None] * S
+        samplings = [sampling_of(noises[i]) if noises[i] else None for i in order]
+        from .draft_graphs import pad_slots
+
+        key = ((pad_slots(S) if self.rowmode else sl), Nn, self.head.variant(sl))   # row mode: any slots
+        inp = self.inputs(key)
+        inp.stage([anchors[i] for i in order], [starts[i] for i in order], [self.valid[s] for s in sl], samplings,
+                  self.noise, self.ring, slots=sl)
+        if self.cuda and self.w1.shape[1] & (self.w1.shape[1] - 1) == 0:
+            fn = self.pass_fn(inp, key[2])
+            if self.graphs is not None:
+                self.graphs.run(inp, fn)
+            else:
+                fn()
+            drafts, conf = inp.result(self.cw is not None)
+        else:
+            cand, cval, hid = self._device_pass(inp, key[2])
+            if self.keep_tree:
+                _keep(inp, cand, cval, hid if self.keep_hid else None)
+            D, P = self.cfg.hidden_size, inp.S             # P: the slots padded (row mode); the first S are real
+            d, c = chain_host(cand.view(P, Nn, -1)[:S].cpu().numpy(), cval.view(P, Nn, -1)[:S].cpu().numpy(), self.w1,
+                              self.w2, [anchors[i] for i in order], samplings, [int(starts[i]) + 1 for i in order],
+                              hid.view(P, Nn, D)[:S].cpu() if self.cw is not None else None,
+                              None if self.cw is None else self.cw.cpu())
+            drafts, conf = d.tolist(), c.tolist()
+        if self.cw is None or conf is None:
+            conf = [[0.5] * Nn for _ in range(S)]
+        back = [0] * S
+        for j, i in enumerate(order):
+            back[i] = j
+        self.tree_of(inp, back)
+        drafts = [[int(t) for t in drafts[back[i]]] for i in range(S)]
+        conf = [[float(q) for q in conf[back[i]]] for i in range(S)]
+        self.last_conf = conf
+        return drafts, conf
+
+    def tree_of(self, inp, back: Sequence[int]) -> None:
+        """``last_tree``: the pass's (candidates, base logits) [N, C] a slot in the caller's order (``back[i]``: the
+        caller's slot i's row in ``inp``), when ``keep_tree`` (``tree.py``); else None."""
+
+        self.last_tree = self.last_hid = None
+        if self.keep_tree and getattr(inp, "tree_cand", None) is not None:
+            S, Nn = len(back), inp.n
+            c = inp.tree_cand.view(inp.S, Nn, -1)[:S].cpu().numpy()
+            v = inp.tree_base.view(inp.S, Nn, -1)[:S].cpu().numpy()
+            self.last_tree = [(c[back[i]], v[back[i]]) for i in range(S)]
+            if self.keep_hid and getattr(inp, "tree_hid", None) is not None:
+                h = inp.tree_hid.view(inp.S, Nn, -1)[:S].cpu()
+                self.last_hid = [h[back[i]] for i in range(S)]
+
+    def _candidates(self, logits: torch.Tensor, idmap: torch.Tensor | None = None,
+                    id0: int | None = None) -> tuple[torch.Tensor, torch.Tensor]:
+        """Every rank's best K of its head's columns, as token ids (``idmap``: a trimmed head's listed ids, else
+        column + ``id0``), gathered (rank order) -> ids int32 / values fp32 [R, W K]."""
+
+        fw = self.fw
+        id0 = fw.vocab_lo if id0 is None else id0
+        k = min(self.k, logits.shape[1])
+        if self.cuda:
+            from . import dspark
+
+            ids, vals = dspark.candidates(logits, k, id0)
+        else:
+            ids, vals = topk_host(logits, k, id0)
+        if idmap is not None:
+            ids = idmap[ids.long()]
+        packed = torch.cat([vals.float(), ids.view(F32)], 1).contiguous()
+        g = fw.gather_cols(packed).view(packed.shape[0], fw.world, 2 * k)
+        cval = g[:, :, :k].reshape(packed.shape[0], -1).contiguous()
+        cand = g[:, :, k:].contiguous().view(torch.int32).reshape(packed.shape[0], -1).contiguous()
+        return cand, cval
+
+    def describe(self) -> str:
+        return self.head.describe() + ("; " + self.graphs.describe() if self.graphs is not None else "")
+
+
+__all__ = ["DraftW", "Drafter", "chain_host", "context_meta", "heads_override", "load", "pass_rows", "present",
+           "topk_host"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/draftlog.py b/src/tensorfold/families/deepseek_v41/cuda/draftlog.py
new file mode 100644
index 0000000..349a261
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/draftlog.py
@@ -0,0 +1,149 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DSpark drafting log (``TF_DSV41_DRAFT_LOG=<dir>``): what offline acceptance work needs from a GPU run, written by
+rank 0 (both ranks hold the same drafts and candidates). Off by default; nothing here changes a token or a draft.
+
+Per round, as events (``draftsim.load`` reads them back):
+
+- ``r`` reset(slot): a request starts on the slot (its positions restart);
+- ``d`` draft: for every slot of the pass: start P, pending token, the pass's drafts and raw confidences (all N
+  rows), the drafts verified (the depth's k), the request's keyed noise, and the pass's gathered candidates and base
+  logits [N, C] (before the Markov bias: ``Drafter.last_tree``); with ``TF_DSV41_DRAFT_LOG_HID=1`` also the head
+  hidden [N, D] (bf16 bits as int16: the self-distillation features, ``drafttrain``);
+- ``w`` window: every segment verified (slot, start, tokens; tree siblings on their shadow slots too) and the
+  target's top ``TF_DSV41_DRAFT_LOG_TOPK`` (default 8) candidates of each row (ids, logits): the target's
+  top-2 at each verified row;
+- ``k`` commit: slot, drafts accepted, the chain presented (``tree``: 0 = the main chain), its start and tokens
+  ([pending, drafts ..]), then the bonus token.
+
+The committed tokens give the serial continuation after every pass (T = 0: exactly the greedy reply; T > 0: the
+keyed samples), so a pass's drafts, its whole draft distribution (base + any Markov rule) and any tree over it can
+be scored offline against the tokens the target chose, at every logged position.
+
+Cost: the pass's candidates are already kept for ``tree.py`` (one [N, C] copy to the host a pass); the window's
+top-K rows come from the candidates the sampler fetched anyway. Events are pickled every ``FLUSH`` rounds to
+``<dir>/draftlog-<pid>-<seq>.pkl`` (and at exit). Logging adds host time only, and the depth prices modelled
+costs, never clocks: drafts and acceptance are those of an unlogged run.
+
+- ``t`` taps (``TF_DSV41_DRAFT_LOG_TAPS=1``): every ingest's taps [n, 3 D] at its start position (30 KB a token): the
+  drafter's whole input, so another drafter (source-precision weights, a trained one) can be replayed offline
+  (``engine/reference``'s DSpark) on exactly these contexts and scored against the same serial tokens.
+
+Knobs: TF_DSV41_DRAFT_LOG (a directory; empty = off), TF_DSV41_DRAFT_LOG_HID (0 | 1), TF_DSV41_DRAFT_LOG_TOPK (8),
+TF_DSV41_DRAFT_LOG_TAPS (0 | 1).
+"""
+
+from __future__ import annotations
+
+import atexit
+import os
+import pickle
+import time
+
+import numpy as np
+
+FLUSH = 256
+
+
+def settings(env=None) -> tuple[str, bool, int, bool]:
+    env = os.environ if env is None else env
+    d = (env.get("TF_DSV41_DRAFT_LOG", "") or "").strip()
+    hid = (env.get("TF_DSV41_DRAFT_LOG_HID", "") or "0").strip() not in ("0", "off", "false")
+    taps = (env.get("TF_DSV41_DRAFT_LOG_TAPS", "") or "0").strip() not in ("0", "off", "false")
+    topk = int((env.get("TF_DSV41_DRAFT_LOG_TOPK", "") or "8").strip())
+    if not 1 <= topk <= 64:
+        raise ValueError(f"TF_DSV41_DRAFT_LOG_TOPK={topk}: expected 1 to 64")
+    return d, hid, topk, taps
+
+
+class DraftLog:
+    """The events of one process (rank 0), flushed to ``folder``."""
+
+    def __init__(self, folder: str, *, hid: bool = False, topk: int = 8) -> None:
+        self.folder, self.hid, self.topk = folder, bool(hid), int(topk)
+        os.makedirs(folder, exist_ok=True)
+        self.events: list = []
+        self.rounds = 0
+        self.seq = 0
+        self.t0 = time.time()
+        atexit.register(self.flush)
+
+    def taps(self, slot: int, start: int, t) -> None:
+        """The committed rows' taps (the drafter's context input, [n, 3 D]) at positions start .. (bf16 bits)."""
+
+        import torch
+
+        self.events.append(("t", {"slot": int(slot), "start": int(start),
+                                  "taps": t.detach().to(torch.bfloat16).view(torch.int16).cpu().numpy().copy()}))
+
+    def reset(self, slot: int) -> None:
+        self.events.append(("r", {"slot": int(slot)}))
+
+    def drafted(self, slots, pendings, starts, noises, drafts, conf, verified, tree, hid=None) -> None:
+        for i, s in enumerate(slots):
+            ev = {"slot": int(s), "start": int(starts[i]), "pending": int(pendings[i]),
+                  "drafts": [int(t) for t in drafts[i]], "conf": [float(c) for c in conf[i]],
+                  "k": len(verified[i]), "noise": list(noises[i]) if noises and noises[i] else []}
+            if tree is not None and i < len(tree):
+                c, v = tree[i]
+                ev["cand"], ev["base"] = np.asarray(c, dtype=np.int32).copy(), np.asarray(v, dtype=np.float32).copy()
+            if self.hid and hid is not None and i < len(hid):
+                import torch
+
+                ev["hid"] = hid[i].to(torch.bfloat16).view(torch.int16).numpy().copy()
+            self.events.append(("d", ev))
+
+    def window(self, segs, cand) -> None:
+        if cand is None:
+            return
+        k = min(self.topk, cand.ids.shape[1])
+        segs_out, a = [], 0
+        for g in segs:
+            toks = getattr(g, "ids", None) or getattr(g, "tokens")
+            n = len(toks)
+            segs_out.append({"slot": int(g.slot), "start": int(g.start), "tokens": [int(t) for t in toks],
+                             "ids": np.asarray(cand.ids[a:a + n, :k], dtype=np.int32).copy(),
+                             "values": np.asarray(cand.values[a:a + n, :k], dtype=np.float32).copy()})
+            a += n
+        self.events.append(("w", {"segs": segs_out}))
+
+    def commit(self, slot: int, accepted: int, chain: int, start: int = -1, tokens=()) -> None:
+        self.events.append(("k", {"slot": int(slot), "accepted": int(accepted), "chain": int(chain),
+                                  "start": int(start), "tokens": [int(t) for t in tokens]}))
+
+    def bonus(self, slot: int, token: int) -> None:
+        for kind, ev in reversed(self.events):
+            if kind == "k" and ev["slot"] == int(slot) and "bonus" not in ev:
+                ev["bonus"] = int(token)
+                break
+        self.rounds += 1
+        if self.rounds % FLUSH == 0:
+            self.flush()
+
+    def flush(self) -> None:
+        if not self.events:
+            return
+        path = os.path.join(self.folder, f"draftlog-{os.getpid()}-{self.seq:05d}.pkl")
+        with open(path + ".tmp", "wb") as f:
+            pickle.dump({"t0": self.t0, "events": self.events}, f, protocol=5)
+        os.replace(path + ".tmp", path)
+        self.seq += 1
+        self.events = []
+
+
+def make(fw) -> DraftLog | None:
+    """A ``DraftLog`` for ``fw`` (``decode.DecodeForward``) on rank 0 when TF_DSV41_DRAFT_LOG names a directory and
+    the forward drafts; it turns on the drafter's candidate copies (``keep_tree``) and, with _HID, the hidden."""
+
+    folder, hid, topk, taps = settings()
+    if not folder or getattr(fw, "drafter", None) is None or int(getattr(fw, "rank", 0)) != 0:
+        return None
+    fw.drafter.keep_tree = True
+    fw.drafter.keep_hid = hid
+    log = DraftLog(folder, hid=hid, topk=topk)
+    if taps:
+        fw.drafter.on_ingest = log.taps
+    return log
+
+
+__all__ = ["DraftLog", "make", "settings"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/draftsim.py b/src/tensorfold/families/deepseek_v41/cuda/draftsim.py
new file mode 100644
index 0000000..7c1cf4f
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/draftsim.py
@@ -0,0 +1,406 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Offline DSpark acceptance analysis of a drafting log (``draftlog``, TF_DSV41_DRAFT_LOG): no GPU, no model.
+
+A pass at position P is scored against the serial tokens the run committed at P + 1 .. P + N (T = 0: the greedy
+reply; T > 0: the keyed samples, which the keyed draft noise targets). Its base logits [N, C] do not depend on the
+drafted tokens (noise rows), so any rule over (base, Markov head) is re-scored exactly at every logged pass:
+
+- ``positions``: per draft position, drafts reached (their prefix serial) and kept, all N rows (not only the
+  depth's k): the conditional acceptance a deeper or wider policy would see;
+- ``ranks``: the serial token's rank in the draft distribution (keyed order) given the serial prefix (teacher
+  forced: the parent a tree node would have) and given the drafted prefix: recall@m tells what width buys;
+- ``near_ties``: at each first rejected draft whose row was verified, the target's top-2 (logged top-K) there: is the
+  draft the target's 2nd choice, and the target's logit margin (a near tie at T = 0 cannot be bought: the greedy
+  choice is exact; at T > 0 the keyed noise already shares the target's uniforms);
+- ``markov_sweep``: chain acceptance with the Markov bias scaled (z = base + alpha w2 . w1[prev]);
+- ``ngram_sweep``: chain acceptance with z += beta log p_ngram(c | the last two tokens), from the other sessions'
+  serial tokens (leave one out) or a corpus of token ids;
+- ``fit_temps``: per-position temperatures of the confidence head (TF_DSV41_CONF_TEMP), sequentially (position j on
+  the passes whose drafts 1 .. j - 1 were serial).
+
+``treesim.replay`` prices chains and parent-conditioned trees (``pctree``) on the same passes with a cost table.
+
+CLI: python -m tensorfold.families.deepseek_v41.cuda.draftsim LOGDIR --heads MODEL_DIR_OR_SHARD [--out x.json]
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+import pickle
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+import numpy as np
+
+
+@dataclass
+class Pass:
+    slot: int
+    start: int
+    pending: int
+    drafts: list
+    conf: list
+    k: int
+    noise: list
+    cand: np.ndarray | None = None
+    base: np.ndarray | None = None
+    hid: np.ndarray | None = None
+    serial: list = field(default_factory=list)      # committed tokens at start + 1 ..
+    target: tuple | None = None                     # (ids, values) [rows, K] of the slot's window at start
+    session: int = 0
+
+    @property
+    def sampling(self):
+        from .lookup import sampling_of
+
+        return sampling_of(self.noise) if self.noise else None
+
+
+def load(folder: str) -> list[Pass]:
+    """Every logged pass with its serial continuation and its window's target top-K rows."""
+
+    files = sorted(glob.glob(os.path.join(folder, "draftlog-*.pkl")),
+                   key=lambda f: (os.path.basename(f).split("-")[1], f))
+    events = []
+    for f in files:
+        with open(f, "rb") as fh:
+            events += pickle.load(fh)["events"]
+    sess = {}                                   # slot -> session id
+    nxt = 0
+    toks: dict = defaultdict(dict)              # session -> {position: token}
+    passes: list[Pass] = []
+    open_pass: dict = {}                        # (session, start) -> Pass
+    for kind, ev in events:
+        s = ev.get("slot")
+        if kind == "r":
+            sess[s] = nxt
+            nxt += 1
+        elif kind == "d":
+            if s not in sess:
+                sess[s] = nxt
+                nxt += 1
+            sid = sess[s]
+            p = Pass(s, ev["start"], ev["pending"], ev["drafts"], ev["conf"], ev["k"], ev["noise"], ev.get("cand"),
+                     ev.get("base"), ev.get("hid"), session=sid)
+            passes.append(p)
+            open_pass[(sid, p.start)] = p
+        elif kind == "w":
+            for g in ev["segs"]:
+                sid = sess.get(g["slot"])
+                p = open_pass.get((sid, g["start"])) if sid is not None else None
+                if p is not None and p.target is None and list(g["tokens"][:1]) == [p.pending]:
+                    p.target = (g["ids"], g["values"])
+        elif kind == "k":
+            sid = sess.get(s)
+            if sid is None or "bonus" not in ev or ev["start"] < 0:
+                continue
+            got = ev["tokens"][1:ev["accepted"] + 1] + [ev["bonus"]]
+            for i, t in enumerate(got):
+                toks[sid][ev["start"] + 1 + i] = int(t)
+    for p in passes:
+        m = toks.get(p.session, {})
+        out = []
+        for i in range(len(p.drafts)):
+            t = m.get(p.start + 1 + i)
+            if t is None:
+                break
+            out.append(t)
+        p.serial = out
+    return passes
+
+
+def streams(passes) -> dict[int, dict[int, int]]:
+    """Each session's serial tokens by position (from the passes' pending tokens and continuations)."""
+
+    by: dict = defaultdict(dict)
+    for p in passes:
+        by[p.session][p.start] = int(p.pending)
+        for i, t in enumerate(p.serial):
+            by[p.session][p.start + 1 + i] = t
+    return dict(by)
+
+
+def _kept(drafts, serial) -> int:
+    a = 0
+    for d, s in zip(drafts, serial):
+        if int(d) != int(s):
+            break
+        a += 1
+    return a
+
+
+def positions(passes, n: int = 5) -> dict:
+    reached, kept, verified = [0] * n, [0] * n, [0] * n
+    for p in passes:
+        a = _kept(p.drafts, p.serial)
+        for i in range(min(n, len(p.serial))):
+            if i <= a:
+                reached[i] += 1
+                kept[i] += int(i < a)
+            verified[i] += int(i < p.k)
+    cond = [round(k / r, 4) if r else None for k, r in zip(kept, reached)]
+    lens = [_kept(p.drafts, p.serial) for p in passes if len(p.serial) >= n]
+    return {"passes": len(passes), "reached": reached, "kept": kept, "conditional": cond, "verified": verified,
+            "chain_tokens_all_n": round(1 + float(np.mean(lens)), 4) if lens else None}
+
+
+def children_z(p: Pass, i: int, prev: int, w1, w2, alpha: float = 1.0, extra=None) -> tuple[np.ndarray, np.ndarray]:
+    """(ids, z) of row i after ``prev``: base + alpha x the Markov bias (+ ``extra(ids)``)."""
+
+    from .tree import markov_z
+
+    ids = p.cand[i]
+    z = p.base[i].astype(np.float32).copy() if alpha == 0.0 else None
+    if z is None:
+        mz = markov_z(p.base[i], ids, prev, w1, w2)
+        z = mz if alpha == 1.0 else (p.base[i] + alpha * (mz - p.base[i])).astype(np.float32)
+    if extra is not None:
+        z = z + extra(ids).astype(np.float32)
+    live = ids >= 0
+    return ids[live].astype(np.int64), z[live]
+
+
+def keyed_rank(ids, z, token: int, position: int, sampling, m: int = 8) -> int:
+    """The rank of ``token`` in the keyed order of (ids, z), m if not among the first m."""
+
+    from .tree import ranked
+
+    got = ranked(z, ids, position, sampling, m)
+    for r, (t, _) in enumerate(got):
+        if t == int(token):
+            return r
+    return m
+
+
+def ranks(passes, w1, w2, m: int = 4, n: int = 5) -> dict:
+    tf = np.zeros((n, m + 1), dtype=np.int64)       # teacher-forced prefix
+    dr = np.zeros((n, m + 1), dtype=np.int64)       # the drafted prefix, while it is serial (= tf) or not
+    outside = np.zeros(n, dtype=np.int64)
+    for p in passes:
+        if p.cand is None:
+            continue
+        smp = p.sampling
+        prev_t = prev_d = p.pending
+        for i in range(min(n, len(p.serial), p.cand.shape[0])):
+            ids, z = children_z(p, i, prev_t, w1, w2)
+            r = keyed_rank(ids, z, p.serial[i], p.start + 1 + i, smp, m)
+            tf[i, r] += 1
+            outside[i] += int(p.serial[i] not in set(ids.tolist()))
+            ids2, z2 = children_z(p, i, prev_d, w1, w2)
+            dr[i, keyed_rank(ids2, z2, p.serial[i], p.start + 1 + i, smp, m)] += 1
+            prev_t, prev_d = p.serial[i], p.drafts[i]
+
+    def recall(h):
+        tot = h.sum(1, keepdims=True).clip(min=1)
+        return np.round(np.cumsum(h[:, :m], 1) / tot, 4).tolist()
+
+    return {"teacher_forced_recall@1..m": recall(tf), "drafted_prefix_recall@1..m": recall(dr),
+            "outside_candidates": outside.tolist(), "rows": tf.sum(1).tolist()}
+
+
+def near_ties(passes) -> dict:
+    """First rejected drafts in a verified row: draft == target's 2nd choice, and the target's top-1 margin."""
+
+    n = second = 0
+    margins, margins_ok = [], []
+    for p in passes:
+        if p.target is None:
+            continue
+        ids, vals = p.target
+        a = _kept(p.drafts, p.serial)
+        for r in range(min(a, len(ids))):
+            if vals.shape[1] > 1:
+                margins_ok.append(float(vals[r, 0] - vals[r, 1]))
+        if a >= p.k or a >= len(ids) or p.sampling is not None:
+            continue                                # the mismatch row was not verified (or T > 0: keyed)
+        n += 1
+        if ids.shape[1] > 1:
+            second += int(int(ids[a, 1]) == int(p.drafts[a]))
+            margins.append(float(vals[a, 0] - vals[a, 1]))
+    mg = np.asarray(margins) if margins else np.zeros(0)
+    return {"rejections": n, "draft_is_target_2nd": round(second / n, 4) if n else None,
+            "margin_median": round(float(np.median(mg)), 3) if mg.size else None,
+            "margin_lt_0.5": round(float((mg < 0.5).mean()), 4) if mg.size else None,
+            "margin_lt_1.0": round(float((mg < 1.0).mean()), 4) if mg.size else None,
+            "accepted_rows_margin_median": round(float(np.median(margins_ok)), 3) if margins_ok else None}
+
+
+def chain(p: Pass, w1, w2, alpha: float = 1.0, extra_of=None, n: int = 5) -> list[int]:
+    """The chain's keyed drafts under z = base + alpha Markov (+ ``extra_of(prefix)(ids)``)."""
+
+    from tensorfold.engine.exact_sampling import choose
+
+    out, prev, smp = [], p.pending, p.sampling
+    hist = [p.pending]
+    for i in range(min(n, p.cand.shape[0])):
+        ids, z = children_z(p, i, prev, w1, w2, alpha, extra_of(hist) if extra_of else None)
+        if not ids.size:
+            break
+        tok = int(ids[np.lexsort((ids, -z))[0]]) if smp is None else choose(z, ids, p.start + 1 + i, smp)
+        out.append(tok)
+        hist.append(tok)
+        prev = tok
+    return out
+
+
+def accept_stats(passes, drafts_of, n: int = 5) -> dict:
+    lens, firsts = [], []
+    for p in passes:
+        if p.cand is None or len(p.serial) < n:
+            continue
+        d = drafts_of(p)
+        lens.append(_kept(d, p.serial))
+        firsts.append(int(bool(d) and d[0] == p.serial[0]))
+    return {"n": len(lens), "tokens_all_n": round(1 + float(np.mean(lens)), 4) if lens else None,
+            "first": round(float(np.mean(firsts)), 4) if firsts else None}
+
+
+def markov_sweep(passes, w1, w2, alphas=(0.0, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0)) -> dict:
+    return {str(a): accept_stats(passes, lambda p, a=a: chain(p, w1, w2, a)) for a in alphas}
+
+
+class NGram:
+    """Counts of (t-2, t-1) -> next over token streams; ``logp(ctx)(ids)``: log p with add-k over the candidates
+    (0 where the context was never seen: no bias)."""
+
+    def __init__(self, order: int = 3) -> None:
+        self.order = order
+        self.tab: dict = defaultdict(lambda: defaultdict(int))
+
+    def add(self, toks) -> None:
+        o = self.order - 1
+        for i in range(o, len(toks)):
+            self.tab[tuple(toks[i - o:i])][int(toks[i])] += 1
+
+    def remove(self, toks) -> None:
+        o = self.order - 1
+        for i in range(o, len(toks)):
+            c = self.tab[tuple(toks[i - o:i])]
+            c[int(toks[i])] -= 1
+
+    def logp(self, hist, k: float = 0.1):
+        o = self.order - 1
+        c = self.tab.get(tuple(hist[-o:])) if len(hist) >= o else None
+        tot = sum(c.values()) if c else 0
+
+        def f(ids):
+            if not tot:
+                return np.zeros(len(ids), dtype=np.float32)
+            return np.log(np.asarray([c.get(int(t), 0) + k for t in ids], dtype=np.float64) / (tot + k * len(ids)))
+        return f
+
+
+def ngram_sweep(passes, w1, w2, betas=(0.0, 0.25, 0.5, 1.0), corpus: list | None = None) -> dict:
+    """Leave one session out: each session's chains see the other sessions' streams (and ``corpus``)."""
+
+    st = {s: [m[k] for k in sorted(m)] for s, m in streams(passes).items()}
+    pos = streams(passes)
+    ng = NGram()
+    for toks in st.values():
+        ng.add(toks)
+    for toks in corpus or []:
+        ng.add(toks)
+    out = {}
+    for b in betas:
+        res_l, firsts = [], []
+        for s, toks in st.items():
+            ng.remove(toks)
+            for p in passes:
+                if p.session != s or p.cand is None or len(p.serial) < 5:
+                    continue
+                pre = [t for t in (pos[s].get(p.start - 1), p.pending) if t is not None]   # the pending one last
+
+                def ext(hist, pre=pre, b=b):
+                    f = ng.logp(list(pre[:-1]) + list(hist))
+                    return lambda ids: b * f(ids)
+                d = chain(p, w1, w2, 1.0, ext if b else None)
+                res_l.append(_kept(d, p.serial))
+                firsts.append(int(d[0] == p.serial[0]))
+            ng.add(toks)
+        out[str(b)] = {"n": len(res_l), "tokens_all_n": round(1 + float(np.mean(res_l)), 4) if res_l else None,
+                       "first": round(float(np.mean(firsts)), 4) if firsts else None}
+    return out
+
+
+def fit_temps(passes, n: int = 5) -> dict:
+    """Sequential temperature scaling: T_j on the passes whose drafts before j were serial."""
+
+    from .confcal import _logit, fit
+
+    temps, ece = [], []
+    for j in range(n):
+        xs, ys = [], []
+        for p in passes:
+            if len(p.serial) > j and _kept(p.drafts, p.serial) >= j and j < len(p.conf):
+                xs.append(_logit(p.conf[j]))
+                ys.append(float(p.drafts[j] == p.serial[j]))
+        if len(xs) < 32:
+            temps.append(None)
+            ece.append(None)
+            continue
+        a, _ = fit(xs, ys, bias=False, ridge=1.0, steps=20)
+        temps.append(round(1.0 / a, 4))
+        ece.append((_ece(xs, ys, 1.0), _ece(xs, ys, a)))
+    return {"temps": temps, "ece_raw_vs_scaled": ece}
+
+
+def _ece(xs, ys, a: float, bins: int = 10) -> float:
+    p = 1.0 / (1.0 + np.exp(-a * np.asarray(xs)))
+    y = np.asarray(ys)
+    b = np.minimum((p * bins).astype(int), bins - 1)
+    return round(float(sum(abs(p[b == i].sum() - y[b == i].sum()) for i in range(bins)) / len(p)), 4)
+
+
+def heads(path: str):
+    """(w1 bf16 [V, r], w2 bf16 [V, r], cw fp32 [D + r] | None) from a checkpoint folder or one safetensors shard."""
+
+    import torch
+    from safetensors import safe_open
+
+    files = [path]
+    if os.path.isdir(path):
+        idx = json.load(open(os.path.join(path, "model.safetensors.index.json")))["weight_map"]
+        files = sorted({os.path.join(path, f) for k, f in idx.items() if "markov_head" in k or "confidence_head" in k})
+    got = {}
+    for f in files:
+        with safe_open(f, "pt") as fh:
+            for k in fh.keys():
+                if "markov_head" in k or "confidence_head" in k:
+                    got[k.split(".", 2)[2]] = fh.get_tensor(k)
+    cw = got.get("confidence_head.proj.weight")
+    return (got["markov_head.embed.weight"].to(torch.bfloat16), got["markov_head.head.weight"].to(torch.bfloat16),
+            None if cw is None else cw.float().reshape(-1))
+
+
+def report(passes, w1, w2) -> dict:
+    return {"positions": positions(passes), "ranks": ranks(passes, w1, w2), "near_ties": near_ties(passes),
+            "markov_sweep": markov_sweep(passes, w1, w2), "ngram_sweep": ngram_sweep(passes, w1, w2),
+            "fit_temps": fit_temps(passes)}
+
+
+def main(argv=None) -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("log")
+    ap.add_argument("--heads", required=True, help="checkpoint folder or the safetensors shard of the DSpark heads")
+    ap.add_argument("--out", default="")
+    ap.add_argument("--costs", default="", help="verify ms of 1, 2, .. rows (default: G9's)")
+    a = ap.parse_args(argv)
+    passes = load(a.log)
+    w1, w2, cw = heads(a.heads)
+    rep = report(passes, w1, w2)
+    from . import treesim
+
+    costs = [float(x) for x in a.costs.split(",")] if a.costs else None
+    rep["replay"] = treesim.replay_all(passes, w1, w2, cw, verify=costs)
+    js = json.dumps(rep, indent=1, default=lambda o: o.tolist() if hasattr(o, "tolist") else str(o))
+    if a.out:
+        open(a.out, "w").write(js)
+    print(js)
+
+
+if __name__ == "__main__":
+    main()
