+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CED bounded replay (``replay.py``, ``TF_DSV41_PREFILL=replay``) on the CPU twin, a synthetic checkpoint with the
+kernels' shapes and a 128-token window (decoder = layers 4-7, layer 4 its kv / candidate source):
+
+- semantics: for prompts of at most 128 tokens replay == full bit for bit (the decoder sees every row); for longer
+  ones it differs from full, and the decoder rows before R0 are never read (garbage in the decoder rings before the
+  replay changes nothing); the encoder state (encoder rings, every kv source's compressed rows and index keys,
+  layer 4's included) is full mode's, bit for bit;
+- chunked == unchunked: any prefill pieces (the stash crosses pieces and rounds) give the same state and logits;
+- serving: resumed == fresh (a prompt snapshot carries the stash; an identical resend replays a tail that starts
+  before the snapshot), no turn snapshots, batched == alone; two ranks agree.
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import replay as RP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.sessions import Store, Tag  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+LONG = [int(t) for t in np.random.default_rng(41).integers(3, 256, size=160)]
+SHORT = LONG[:70]
+REPLAY = Tag(ced="replay").code()
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41rp"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def build(ck, pchunk: int = 64, slots: int = 1, rank: int = 0, world: int = 1, comm=None) -> SlotsForward:
+    root, cfg, table, _ = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=1024,
+                        chunk=8, pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+def prompt(fw, ids, mode: str, cuts=None, slot: int = 0, garbage: bool = False) -> torch.Tensor:
+    """Prefill ids[:-1] in pieces ending at ``cuts``, finish (replay: the decoder over the tail), then the last token
+    and two more as verify rows: their logits."""
+
+    n = len(ids)
+    a = 0
+    for b in list(cuts or []) + [n - 1]:
+        fw.prefill([Piece(slot, a, tuple(ids[a:b]))], mode=mode)
+        a = b
+    if garbage:
+        d = RP.decoder_start(fw.cfg)
+        g = torch.Generator().manual_seed(5)
+        for L, ring in fw.slots[slot].swa.items():
+            if L >= d:
+                ring.values.copy_(torch.randint(0, 120, ring.values.shape, generator=g, dtype=torch.uint8))
+    fw.finish_prompt(slot, n - 1, tuple(ids[max(0, n - RP.REPLAY):n - 1]), mode=mode)
+    return torch.cat([fw.step([ids[-1]], slot=slot), fw.step([11], slot=slot), fw.step([12], slot=slot)])
+
+
+def encoder_state(fw, slot: int = 0) -> dict:
+    s, d = fw.slots[slot], RP.decoder_start(fw.cfg)
+    out = {}
+    for L, ring in s.swa.items():
+        if L < d:
+            out[f"ring.{L}"] = ring.values.clone()
+    for L, st in s.comp.items():
+        n = (s.pos + 1) // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    return out
+
+
+def test_short_prompt_replay_equals_full(ck):
+    assert torch.equal(prompt(build(ck), SHORT, "replay"), prompt(build(ck), SHORT, "full"))
+
+
+def test_long_prompt_replay_semantics(ck):
+    fw = build(ck)
+    rep = prompt(fw, LONG, "replay")
+    full = prompt(build(ck), LONG, "full")              # approximate by design: differs, no bound asserted here
+    assert not torch.equal(rep, full)
+    assert torch.equal(prompt(build(ck), LONG, "replay", garbage=True), rep)
+    # the encoder state after the prompt's prefilled part: replay's == full's
+    a, b = build(ck), build(ck)
+    for f, mode in ((a, "replay"), (b, "full")):
+        f.prefill([Piece(0, 0, tuple(LONG[:-1]))], mode=mode)
+    ea, eb = encoder_state(a), encoder_state(b)
+    assert set(ea) == set(eb)
+    for k in ea:
+        assert torch.equal(ea[k], eb[k]), k
+
+
+@pytest.mark.parametrize("cuts,pchunk", [([], 200), ([100], 32), ([16, 150, 158], 64)])
+def test_replay_chunked_equals_unchunked(ck, cuts, pchunk):
+    want = prompt(build(ck, pchunk=64), LONG, "replay")
+    assert torch.equal(prompt(build(ck, pchunk=pchunk), LONG, "replay", cuts=cuts), want)
+
+
+def test_replay_with_fast_prefill_kernels(ck, monkeypatch):
+    """Both knobs together: the fast kernels in the encoder pass and the decoder replay, still row-independent."""
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    want = prompt(build(ck, pchunk=200), LONG, "replay")
+    assert torch.equal(prompt(build(ck, pchunk=32), LONG, "replay", cuts=[150]), want)
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "exact")
+    assert not torch.equal(prompt(build(ck, pchunk=200), LONG, "replay"), want)
+
+
+def test_replay_snapshot_round_trip(ck):
+    """A prompt snapshot at 150 (stash of [23, 150)) restored on a fresh forward; the tail [32, 159) starts before
+    it: the same logits as one uninterrupted prompt."""
+
+    want = prompt(build(ck), LONG, "replay")
+    fw = build(ck)
+    fw.prefill([Piece(0, 0, tuple(LONG[:150]))], mode="replay")
+    snap = fw.snapshot(0)
+    assert snap.meta["ced"] == "replay" and "ced_x" in snap.arrays
+    assert int(snap.arrays["ced_lo"][0]) == 150 - RP.KEEP
+    other = build(ck)
+    other.restore(0, snap)
+    for L, st in fw.slots[0].comp.items():                  # the pool pages are the store's: copy them over
+        other.slots[0].comp[L], other.slots[0].ikeys[L] = st, fw.slots[0].ikeys[L]
+    other.prefill([Piece(0, 150, tuple(LONG[150:-1]))], mode="replay")
+    other.finish_prompt(0, 159, tuple(LONG[32:159]), mode="replay")
+    got = torch.cat([other.step([LONG[-1]]), other.step([11]), other.step([12])])
+    assert torch.equal(got, want)
+
+
+# -- serving -------------------------------------------------------------------------------------------------------
+def batcher(ck, fw, store=None) -> Batcher:
+    pool = Pool(ck[3], 4096)
+    st = Store(pool, ram_bytes=1 << 30) if store is True else store
+    return Batcher(fw, pool, n_slots=len(fw.slots), capacity=1024, store=st, mode="replay", tag=REPLAY,
+                   prefill_rows=64, depth=0, session_min=16, start=False)
+
+
+def run(b: Batcher, jobs) -> list[list[int]]:
+    for j in jobs:
+        b.submit(j)
+    for _ in range(10000):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while (item := j.out.get_nowait()) is not None:
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out
+
+
+def test_replay_serving_resumed_equals_fresh(ck):
+    b = batcher(ck, build(ck), store=True)
+    r1 = run(b, [Job(list(LONG), 4, None)])[0]
+    assert sorted(e.kind for e in b.store.entries.values()) == ["prompt"]
+    again = Job(list(LONG), 4, None)                        # an identical resend: resumes at 144, replays [32, 159)
+    assert run(b, [again])[0] == r1 and again.stats["cached"] == 144
+    turn2 = LONG + r1 + [5, 6, 7]
+    j2 = Job(list(turn2), 4, None)
+    got = run(b, [j2])[0]
+    assert j2.stats["tier"] == "ram" and j2.stats["cached"] == 144
+    assert got == run(batcher(ck, build(ck)), [Job(list(turn2), 4, None)])[0]
+
+
+def test_replay_batched_equals_alone(ck):
+    ps = [LONG, LONG[7:150]]
+    both = run(batcher(ck, build(ck, slots=2)), [Job(list(p), 4, None) for p in ps])
+    for p, got in zip(ps, both):
+        assert got == run(batcher(ck, build(ck)), [Job(list(p), 4, None)])[0]
+
+
+def test_replay_two_ranks_agree(ck):
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = [build(ck, rank=r, world=2, comm=comms[r]) for r in range(2)]
+    got = pair.run([lambda f=f: prompt(f, SHORT, "replay") for f in fws])
+    fws = [build(ck, rank=r, world=2, comm=comms[r]) for r in range(2)]
+    want = pair.run([lambda f=f: prompt(f, SHORT, "full") for f in fws])
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+
+
+def test_replay_drafted_equals_serial(tmp_path):
+    """DSpark over a replayed prompt (the drafter's context from the replay's taps): drafted == serial, T = 0 and
+    T > 0, and the drafter proposed something."""
+
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.engine.exact_sampling import Sampling
+
+    ck2 = DF.ckpt(tmp_path / "dsp")
+    prompts = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 250, size=150 + 9 * i)] for i in range(2)]
+    samplings = [None, Sampling(seed=4, temperature=0.8, top_k=20, top_p=0.95)]
+
+    def go(depth):
+        fw = DF.forward(ck2, slots=2)
+        pool = Pool(ck2[3], 4096)
+        b = Batcher(fw, pool, n_slots=2, capacity=1024, store=None, mode="replay", tag=REPLAY, prefill_rows=4096,
+                    depth=depth, session_min=16, start=False)
+        jobs = [Job(list(p), 24, s) for p, s in zip(prompts, samplings)]
+        return run(b, jobs), jobs
+
+    serial, _ = go(0)
+    drafted, jobs = go(None)
+    assert drafted == serial
+    assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0
