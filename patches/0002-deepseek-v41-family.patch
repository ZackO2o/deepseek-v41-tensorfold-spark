@@ -0,0 +1,174 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G4's decode-speed changes on the GPU (collected only where PyTorch sees an NVIDIA GPU), on the synthetic DSpark
+checkpoint with the Triton CSA2 / router / DSpark kernels and upstream's EXL3:
+
+- CUDA graphs captured at boot, then a 128-row multi-chunk prefill, commits, a snapshot / restore: every replay ==
+  the eager window bit for bit, no graph dropped (the carries and the MoE scratch kept their addresses: G3's crash);
+- the memory floor: under it no graph is captured and windows run eagerly, same logits;
+- top-p rows from candidates (TF_DSV41_NUCLEUS) == the full-vocabulary candidates, replies token for token, with
+  graphs on;
+- the Engram prefetch from packed shards (row reads, the pending row at commit, lazy per-layer inputs) with graphs
+  on == synchronous reads, graphs off.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_perf_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import graphs as G
+from tensorfold.families.deepseek_v41.cuda import nucleus as NU
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Seg
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+DEV = "cuda"
+LONG = 4096
+PROMPTS = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 250, size=300 + 37 * i)] for i in range(4)]
+HOT = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), Sampling(seed=5, temperature=0.2, top_k=0,
+                                                                                top_p=0.95),
+       Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "warm": "decode",
+            "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41perfg"))
+
+
+def _fw(ck, slots=1, **kw):
+    return DF.forward(ck, slots=slots, limit=LONG, device=DEV, chunk=128, **kw)
+
+
+def _prefill(fw, slot, ids):
+    fw.reset(slot)
+    fw.prefill([Piece(slot, 0, tuple(ids))], mode="full")
+
+
+def _carries(fw):
+    return [c.data_ptr() for s in fw.slots for _, c in sorted(s.carry.items())]
+
+
+def test_graphs_survive_prefill_commit_and_restore(ck):
+    g, e = _fw(ck, slots=2), _fw(ck, slots=2)
+    bg = DF.batcher(ck, g, n=2, capacity=LONG, pool_tokens=3 * LONG)
+    be = DF.batcher(ck, e, n=2, capacity=LONG, pool_tokens=3 * LONG)
+    g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+    assert g.graphs.warmup(2, lambda s, end: bg.ex.slots[s].ensure(end)) == 6
+    ptrs = _carries(g)
+    for f, b in ((g, bg), (e, be)):
+        for s in range(2):
+            b.ex.slots[s].ensure(LONG)
+            _prefill(f, s, PROMPTS[s])                  # 128-row chunks after the 1-6-row captures
+    rng = np.random.default_rng(3)
+    seen, want = {(0, w) for w in range(1, 7)}, 0      # boot warms slot 0 only: slot 1's keys are captured on use
+    for step in range(10):
+        s = step % 2
+        w = int(rng.integers(1, 7))
+        want += (s, w) in seen
+        seen.add((s, w))
+        segs = [Seg(s, g.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=w)))]
+        lg = g.graphs.run(segs).clone()
+        assert torch.equal(lg, e.run(segs)), step
+        keep = int(rng.integers(0, w))
+        g.keep(s, keep)
+        e.keep(s, keep)
+        if step == 5:
+            snap = g.snapshot(s)
+            g.restore(s, snap)
+            e.restore(s, e.snapshot(s))
+    st = g.graphs.cache.stats
+    # every window whose (slot, width) key was met before replays (G4: the old ">= 8" assumed slot 1 was warm)
+    assert st["replays"] == want and st["lazy"] == len(seen) - 6
+    assert st["dropped"] == 0 and _carries(g) == ptrs
+
+
+def test_memory_floor_keeps_windows_eager(ck):
+    g, e = _fw(ck), _fw(ck)
+    bg = DF.batcher(ck, g, capacity=LONG, pool_tokens=2 * LONG)
+    be = DF.batcher(ck, e, capacity=LONG, pool_tokens=2 * LONG)
+    g.graphs = G.CudaGraphs(g, settings={**SETTINGS, "floor_gib": 1e9})
+    assert g.graphs.warmup(1, lambda s, end: bg.ex.slots[s].ensure(end)) == 0 and g.graphs.cache.full
+    for f, b in ((g, bg), (e, be)):
+        b.ex.slots[0].ensure(LONG)
+        _prefill(f, 0, PROMPTS[0])
+    segs = [Seg(0, g.slots[0].pos, (5, 6, 7))]
+    assert torch.equal(g.graphs.run(segs), e.run(segs)) and not g.graphs.cache.graphs
+
+
+def _replies(ck, monkeypatch, nucleus, graphs, n=4, **kw):
+    monkeypatch.setenv(NU.ENV, nucleus)
+    fw = _fw(ck, slots=n, **kw)
+    b = DF.batcher(ck, fw, n=n, capacity=LONG, pool_tokens=(n + 1) * LONG, lookup=True)
+    if graphs:
+        fw.graphs = G.CudaGraphs(fw, settings=SETTINGS)
+        fw.graphs.warmup(n, lambda s, end: b.ex.slots[s].ensure(end))
+        for s in b.ex.slots:
+            s.release()
+    if getattr(fw, "prefetcher", None) is not None:
+        fw.prefetcher.stats.update(hits=0, misses=0)        # the warm-up's windows were never issued
+    got = DF.run(b, [Job(list(p), 40, s) for p, s in zip(PROMPTS, HOT)])
+    return got, fw
+
+
+def test_nucleus_equals_full_vocabulary_gpu(ck, monkeypatch):
+    old, _ = _replies(ck, monkeypatch, "0", graphs=False)
+    new, fw = _replies(ck, monkeypatch, "64", graphs=True)
+    assert new == old and fw.graphs.cache.stats["replays"] > 0
+
+
+def test_engram_prefetch_with_graphs_gpu(ck, monkeypatch, tmp_path):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    cfg, table = ck[1], ck[2]
+    FK.write_engram(tmp_path, cfg, table, 1)
+    rows = lambda: EH.open_shards(tmp_path, 0, 1, cfg.engram_layer_ids, dim=cfg.engram_head_dim)   # noqa: E731
+    sync, _ = _replies(ck, monkeypatch, "64", graphs=False, rows=rows())
+    got, fw = _replies(ck, monkeypatch, "64", graphs=True, rows=rows(), prefetch=True)
+    st = fw.prefetcher.stats
+    assert got == sync and st["misses"] == 0 and st["hits"] > 0 and fw.graphs.cache.stats["replays"] > 0
+
+
+def test_fused_rope_bitwise_gpu(ck, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import rope as RP
+    from tensorfold.families.deepseek_v41.cuda import rope_fused as RF
+
+    table = RP.Table.build(RP.inv_freq(64, 160000.0, 16.0, 65536, 32.0, 1.0), 8192, DEV)
+    g = torch.Generator(device=DEV).manual_seed(1)
+    for heads, dh in ((32, 512), (32, 128)):
+        x = (torch.randn(17, heads, dh, generator=g, device=DEV) * 4).to(torch.bfloat16)
+        pos = torch.randint(0, 8192, (17,), device=DEV, generator=g)
+        for inverse in (False, True):
+            monkeypatch.setenv("TF_DSV41_ROPE_FUSED", "0")
+            want = table.apply(x.float(), pos, inverse=inverse, dtype=torch.bfloat16)
+            monkeypatch.setenv("TF_DSV41_ROPE_FUSED", "1")
+            assert RF.eligible(x.float(), pos, 64, torch.bfloat16)
+            got = table.apply(x.float(), pos, inverse=inverse, dtype=torch.bfloat16)
+            assert torch.equal(got.view(torch.int16), want.view(torch.int16))
+    # a whole forward: fused == torch RoPE, logits bit for bit
+    outs = []
+    for on in ("0", "1"):
+        monkeypatch.setenv("TF_DSV41_ROPE_FUSED", on)
+        fw = _fw(ck, dspark=False)
+        b = DF.batcher(ck, fw, capacity=LONG, pool_tokens=2 * LONG)
+        b.ex.slots[0].ensure(LONG)
+        _prefill(fw, 0, PROMPTS[1])
+        outs.append(fw.run([Seg(0, fw.slots[0].pos, (3, 4, 5, 6))]).clone())
+    assert torch.equal(outs[0], outs[1])
