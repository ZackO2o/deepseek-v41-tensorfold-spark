@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The real forward behind the serving layer (``slots.SlotsForward`` under ``batch.Batcher``), on the CPU twin of the
+kernels and a synthetic checkpoint with the kernels' shapes (512-wide FP8 records in the KV pool's pages):
+
+- the forward meets ``protocol.Forward``; its rows live in the pool's 584-byte records through the slots' tables;
+- batched == alone: replies of several slots decoded together == each request alone == the one-slot serial decode;
+- window / commit: a window moves no position, a commit keeps the pending row + accepted drafts (rollback of the
+  rest), and a later window gives the serial step's logits;
+- resumed == fresh: a second turn restored from the session store (snapshot + shared pages) == a fresh prefill;
+- grammar masks act as -inf before the top-k; two ranks (threads) produce the same plan results as one.
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Rows, check_forward  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.sessions import Store, Tag  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41s"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def forward(ckpt, slots=2, rank=0, world=1, comm=None, chunk=32) -> SlotsForward:
+    root, cfg, table, _ = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=1024,
+                        chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+def batcher(ckpt, fw, n=2, store=False, **kw) -> Batcher:
+    topo = ckpt[3]
+    pool = Pool(topo, 4096)
+    st = Store(pool, ram_bytes=1 << 30) if store else None
+    return Batcher(fw, pool, n_slots=n, capacity=1024, store=st, mode="full", tag=Tag(ced="full").code(),
+                   prefill_rows=64, depth=0, session_min=16, start=False, **kw)
+
+
+def run(b: Batcher, jobs) -> list[list[int]]:
+    for j in jobs:
+        b.submit(j)
+    for _ in range(10000):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while True:
+            item = j.out.get_nowait()
+            if item is None:
+                break
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out
+
+
+PROMPTS = [list(np.random.default_rng(s).integers(3, 256, size=n)) for s, n in ((1, 45), (2, 70))]
+
+
+def serial(ckpt, prompt, n) -> list[int]:
+    """The one-slot path: prompt windows, then one row a step, the argmax each time."""
+
+    from tensorfold.families.deepseek_v41.cuda.forward import greedy
+
+    fw = forward(ckpt, slots=1)
+    lg = fw.prompt([int(t) for t in prompt])
+    out = []
+    for _ in range(n):
+        out.append(int(greedy(fw, lg)[0]))
+        lg = fw.step([out[-1]])
+    return out
+
+
+def test_protocol_and_pool_rows(ckpt):
+    fw = forward(ckpt)
+    check_forward(fw)
+    b = batcher(ckpt, fw)
+    st = fw.slots[0]
+    L = next(iter(st.comp))
+    assert st.comp[L].values.data_ptr() == b.pool.phys[f"comp.{L}"].data_ptr()
+    assert st.comp[L].table is b.ex.slots[0].table and fw.vocab == 256
+
+
+def test_batched_equals_alone_equals_serial(ckpt):
+    alone = [run(batcher(ckpt, forward(ckpt, slots=1), n=1), [Job([int(t) for t in p], 6, None)])[0]
+             for p in PROMPTS]
+    both = run(batcher(ckpt, forward(ckpt)), [Job([int(t) for t in p], 6, None) for p in PROMPTS])
+    assert both == alone and all(len(t) == 6 for t in both)
+    assert alone[0] == serial(ckpt, PROMPTS[0], 6)
+
+
+def test_window_commit_rollback(ckpt):
+    fw = forward(ckpt, slots=1)
+    b = batcher(ckpt, fw, n=1)
+    b.ex.slots[0].ensure(200)
+    p = [int(t) for t in PROMPTS[0]]
+    fw.reset(0)
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    assert fw.slots[0].pos == len(p) - 1
+    c1 = fw.window([Rows(0, len(p) - 1, (p[-1], 7, 9, 11))], count=5)
+    assert fw.slots[0].pos == len(p) - 1                  # a window moves nothing
+    fw.commit(0, 1)                                        # keep the pending row + one draft (7)
+    assert fw.slots[0].pos == len(p) + 1 and fw.slots[0].tail[-2:] == [p[-1], 7]
+    c2 = fw.window([Rows(0, len(p) + 1, (13,))], count=5)
+    want = serial_logits(ckpt, p + [7, 13])
+    assert np.array_equal(c2.ids[0], want[0]) and np.array_equal(c2.values[0], want[1])
+    assert c1.ids.shape == (4, 5)
+
+
+def serial_logits(ckpt, ids):
+    fw = forward(ckpt, slots=1)
+    lg = fw.prompt(ids)
+    v, i = torch.topk(lg[-1].float(), 5)
+    return i.numpy(), v.numpy().astype(np.float32)
+
+
+def test_resumed_equals_fresh(ckpt):
+    p = [int(t) for t in PROMPTS[1]]
+    b = batcher(ckpt, forward(ckpt, slots=1), n=1, store=True)
+    r1 = run(b, [Job(list(p), 5, None)])[0]
+    turn2 = p + r1 + [5, 6, 7]
+    j2 = Job(list(turn2), 5, None)
+    got = run(b, [j2])[0]
+    assert j2.stats["tier"] == "ram" and j2.stats["cached"] > 0
+    fresh = run(batcher(ckpt, forward(ckpt, slots=1), n=1), [Job(list(turn2), 5, None)])[0]
+    assert got == fresh
+
+
+def test_masks_and_snapshot_round_trip(ckpt):
+    fw = forward(ckpt, slots=1)
+    batcher(ckpt, fw, n=1).ex.slots[0].ensure(100)
+    fw.reset(0)
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    p = [int(t) for t in PROMPTS[0]]
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    snap = fw.snapshot(0)
+    allow = np.zeros((1, 8), dtype=np.int32)
+    allow[0, 3] = 1 << 5                                    # token 101 only
+    c = fw.window([Rows(0, len(p) - 1, (p[-1],))], count=3, masks=[allow])
+    assert c.ids[0, 0] == 101 and np.isneginf(c.values[0, 1:]).all()
+    free = fw.window([Rows(0, len(p) - 1, (p[-1],))], count=3)
+    fw.restore(0, snap)
+    again = fw.window([Rows(0, len(p) - 1, (p[-1],))], count=3)
+    assert np.array_equal(again.ids, free.ids) and np.array_equal(again.values, free.values)
+
+
+def test_two_ranks(ckpt):
+    import queue
+    import threading
+
+    class PairLink:
+        def __init__(self):
+            self.q = queue.Queue()
+
+        def send(self, plan):
+            self.q.put(list(plan))
+
+        def recv(self):
+            return self.q.get(timeout=60)
+
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: forward(ckpt, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    link = PairLink()
+    b0 = batcher(ckpt, fws[0], link=link, rank=0)
+    b1 = batcher(ckpt, fws[1], link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    got = run(b0, [Job([int(t) for t in p], 4, None) for p in PROMPTS])
+    b0.send_stop()
+    t.join(timeout=60)
+    assert not t.is_alive()
+    one = run(batcher(ckpt, forward(ckpt)), [Job([int(t) for t in p], 4, None) for p in PROMPTS])
+    assert len(got[0]) == 4 and [g[0] for g in got] == [o[0] for o in one]
