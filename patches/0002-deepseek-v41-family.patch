+++ b/src/tensorfold/families/deepseek_v41/cuda/csa2/attn_pf.py
@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CSA2 attention for fast prefill runs in one pass (``TF_DSV41_PREFILL_ATTN=fused``, G7; never decode or verify).
+
+``attn.attention`` (the decode path, also every prefill row today) runs a program per (row, 16-head tile, chunk):
+four chunks of the row's compressed list and one of its SWA window, each writing fp32 partials (o [16, 512], m, l),
+then ``_merge`` reads the five partials back. That shape is right for a verify window (a few rows: the chunks are the
+parallelism) and wasteful for a 2,048-row segment, which has rows enough to fill the GPU. G5's nsys of a 32K prefill
+(all on): ``_chunks`` 2.59 s + ``_merge`` 0.99 s, 16 launches of 128 rows a layer segment (the scratch holds 128 rows),
+~11 ms a layer segment; per 128 rows the partials are 42 MB written and read back, and each head tile loads (and
+dequantizes) the row's keys again.
+
+Here a program is (row, BMQ-head tile): the row's compressed entries in list order, then its SWA window, ONE online
+softmax over all of them (``attn._tile``: bf16 q x bf16 rows on tensor cores, fp32 sums), then the sink, 1 / l, the
+inverse RoPE and one bf16 rounding, as ``_merge`` finishes. No partials, no merge, no scratch: every row of the
+segment in one launch. ``TF_DSV41_PREFILL_ATTN_BMQ=32`` puts all 32 local heads in one program, so a row's keys are
+loaded and dequantized once (half the key traffic; ~2x the registers).
+
+Cost model (one rank, 2,048 rows, 32 heads; per row 512 compressed + 128 SWA keys of 584 B): keys 0.75 MB a row a
+head tile from L2 / DRAM (adjacent rows share most of their selection), partials 0.33 MB a row written + read. Fused,
+BMQ 16: -0.66 MB a row and the merge launch (~-45% of the 11 ms); BMQ 32: keys once more (~-65% in all). At 32K with
+replay (~336 layer segments): -1.6 to -2.4 s of 34 s.
+
+Exactness: one softmax chain instead of five merged ones: other bits than the decode path's (within fp32 rounding of
+the same sums), so it is a fast-tag kernel set of its own (``prefill_mm.tag_grid`` + 1). Row-independent: a row's
+output depends on its q, its list, its window and the stored rows only (no other row, no segment size, no block),
+so chunked == unchunked and batched == alone hold within the tag. No atomics.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import rows as RW
+from .attn import KT, WINDOW, _tile
+
+D = 512
+
+
+def variant() -> int:
+    """``TF_DSV41_PREFILL_ATTN``: 0 = ``chunks`` (``attn.attention``, default), 1 = ``fused`` (this module)."""
+
+    from .. import prefill_mm as PM
+
+    return PM.attn_variant()
+
+
+def config() -> tuple[int, int]:
+    """(BMQ heads a program, warps): ``TF_DSV41_PREFILL_ATTN_BMQ`` (16 / 32), ``TF_DSV41_PREFILL_ATTN_WARPS`` (8)."""
+
+    bmq = int(os.environ.get("TF_DSV41_PREFILL_ATTN_BMQ", "") or 16)
+    warps = int(os.environ.get("TF_DSV41_PREFILL_ATTN_WARPS", "") or 8)
+    if bmq not in (16, 32) or warps not in (4, 8, 16):
+        raise ValueError(f"TF_DSV41_PREFILL_ATTN_BMQ={bmq} (16 / 32), TF_DSV41_PREFILL_ATTN_WARPS={warps} (4 / 8 / 16)")
+    return bmq, warps
+
+
+@triton.jit
+def _rope_rows(x, c, s):
+    """Inverse GPT-J RoPE on the last 64 dims of x [BMQ, 512] fp32 (``rows.rope_pairs`` a row; c / s [256])."""
+
+    even, odd = tl.split(tl.reshape(x, (x.shape[0], 256, 2)))
+    ne = even * c[None, :] + odd * s[None, :]
+    no = odd * c[None, :] - even * s[None, :]
+    return tl.reshape(tl.join(ne, no), (x.shape[0], 512))
+
+
+@triton.jit
+def _fused(Q, CV, CSC, cvs, css, TOK, t_stride, CNT, SV, SSC, svs, sss, LO, POS, SINK, CS, cs_stride, OUT,
+           H: tl.constexpr, KT: tl.constexpr, BMQ: tl.constexpr, SCALE: tl.constexpr, RING: tl.constexpr,
+           WINDOW: tl.constexpr, COMP: tl.constexpr, PT=None, PSH: tl.constexpr = 0):
+    """Program (row r, head tile): the row's compressed entries [0, CNT[r]) in list order, then its SWA window
+    [max(LO[r], q - 127), q] (q = POS + r), one online softmax; the sink, 1 / l, the inverse RoPE at q, bf16."""
+
+    r = tl.program_id(0)
+    hb = tl.program_id(1)
+    h = hb * BMQ + tl.arange(0, BMQ)
+    d = tl.arange(0, 512)
+    m = tl.full((BMQ,), float("-inf"), tl.float32)
+    l = tl.zeros((BMQ,), tl.float32)
+    o = tl.zeros((BMQ, 512), tl.float32)
+    q = tl.load(Q + (r.to(tl.int64) * H + h[:, None]) * 512 + d[None, :]).to(tl.bfloat16)
+    if COMP:
+        n = tl.load(CNT + r)
+        for t in range(tl.cdiv(n, KT)):
+            idx = t * KT + tl.arange(0, KT)
+            ok = idx < n
+            tok = tl.load(TOK + r.to(tl.int64) * t_stride + idx, mask=ok, other=0).to(tl.int64)
+            ok = ok & (tok >= 0)
+            rows = RW.prow(tl.where(ok, tok, 0), PT, PSH, ok)
+            kv = RW.load_rows(CV, CSC, rows, ok, d, cvs, css)
+            m, l, o = _tile(q, kv, m, l, o, ok[None, :], SCALE)
+    pos = tl.load(POS) + r
+    lo = tl.maximum(tl.load(LO + r), pos - (WINDOW - 1))
+    for t in range(WINDOW // KT):
+        p = pos - (WINDOW - 1) + t * KT + tl.arange(0, KT)
+        ok = (p >= lo) & (p >= 0)
+        rows = (tl.where(ok, p, 0) % RING).to(tl.int64)
+        kv = RW.load_rows(SV, SSC, rows, ok, d, svs, sss)
+        m, l, o = _tile(q, kv, m, l, o, ok[None, :], SCALE)
+    sink = tl.load(SINK + h).to(tl.float32)
+    top = tl.maximum(m, sink)
+    a = tl.where(m == float("-inf"), 0.0, tl.exp(m - top))
+    e = tl.where(sink == float("-inf"), 0.0, tl.exp(sink - top))
+    x = (o * a[:, None]) / (l * a + e)[:, None]
+    c, s = RW.cos_sin(CS, pos, cs_stride, 256, 32)
+    x = _rope_rows(x, c, s)
+    tl.store(OUT + (r.to(tl.int64) * H + h[:, None]) * 512 + d[None, :], x.to(tl.bfloat16))
+
+
+def attention(q: torch.Tensor, comp, tokens: torch.Tensor | None, counts: torch.Tensor | None, swa, lo: torch.Tensor,
+              pos: torch.Tensor, sink: torch.Tensor, cs: torch.Tensor, out: torch.Tensor, *, ring: int,
+              page_table=None, page_shift: int = 0) -> torch.Tensor:
+    """``attn.attention``'s arguments (no DSpark ``hi``, no scratch): q bf16 [R, H, 512] RoPE'd, comp = (values,
+    scales) or None, tokens int32 [R, <= 512] / counts int32 [R], swa = the ring's (values, scales), lo int32 [R],
+    pos int32 [1], sink fp32 [H], cs the RoPE table -> out bf16 [R, H, 512]."""
+
+    R, H, _ = q.shape
+    bmq, warps = config()
+    if H % bmq or not q.is_contiguous() or q.dtype != torch.bfloat16 or q.shape[2] != D:
+        raise ValueError(f"attn_pf: q bf16 [R, H, 512] contiguous with H a multiple of {bmq}")
+    if ring <= 0 or ring & (ring - 1) or ring < WINDOW or ring < R + WINDOW - 1:
+        raise ValueError(f"attn_pf: a ring of {ring} rows cannot hold {R} rows and their windows")
+    if R == 0:
+        return out
+    pg = {}
+    if comp is None:
+        cv, csc = swa
+        tokens = counts = lo                    # never read (COMP off)
+        t_stride = 0
+    else:
+        cv, csc = comp
+        if tokens.shape[1] > 512:
+            raise ValueError("attn_pf: at most 512 compressed rows a query row")
+        t_stride = tokens.stride(0)
+        if page_table is not None:
+            pg = dict(PT=page_table, PSH=page_shift)
+    _fused[(R, H // bmq)](q, cv, csc, cv.stride(0), csc.stride(0), tokens, t_stride, counts, swa[0], swa[1],
+                          swa[0].stride(0), swa[1].stride(0), lo, pos, sink, cs, cs.stride(0), out, H=H, KT=KT,
+                          BMQ=bmq, SCALE=D ** -0.5, RING=ring, WINDOW=WINDOW, COMP=comp is not None,
+                          num_warps=warps, num_stages=1 if bmq == 32 else 2, **pg)   # BMQ 32 at 2 stages: 114,816 B
+    # of shared memory, over sm_121's 101,376 (G7)
+    return out
+
+
+__all__ = ["attention", "config", "variant"]
