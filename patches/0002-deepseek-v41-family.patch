+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Cost-derived DSpark depth for DeepSeek-V4.1-Flash (GLM patches/0071) with DSpark's confidence head as the
+acceptance input (docs/ENGINE-PLAN.md section 7, M2).
+
+One DSpark pass drafts a whole block (5 positions) and its confidence head estimates, per position i, the chance
+q_i that draft i is kept given drafts 1..i-1 were. A round that verifies k drafts commits on average
+
+    E(k) = 1 + q_1 + q_1 q_2 + ... + q_1 ... q_k
+
+tokens and costs ``verify[k]`` (a window of k + 1 rows; the pass is paid whatever k is). With lambda the slot's
+running rate (committed tokens per modelled ms over its recent rounds), k maximizes E(k) - lambda verify[k]
+(``glm5_next.spark.depth.best_k``; the first draft is always verified, as upstream: the pass already ran). The
+head's raw probabilities are corrected per position by a decayed (kept / summed q) factor (``Calibration``).
+
+**Zero depth** (TF_DSV41_DRAFT_SKIP, default 1): when the slot's window is the round's only one (``alone``: no other
+slot shares the verify), k may be 0: the pass ran, but a 1-row window is cheaper than a 2-row one by
+verify[1] - verify[0] (~8 ms measured, against ~4 ms for each further row), so a first draft whose calibrated q_1 is
+under lambda (verify[1] - verify[0]) (~0.26 on prose's rates) is not worth its row. The unverified first draft still
+teaches the calibration: the 1-row window's choice is the serial token after the pending one, so the draft would have
+been kept iff it equals the committed bonus token (``bonus``: the counterfactual, exact, free). In a shared window a
+row costs only its marginal ~4 ms and the first draft is always verified, as before.
+
+``Costs`` is the load-time table (``calib.py``: measured on the real model, cached per image / knobs / shape, the
+same integers on both ranks); ``default_costs`` the section 1.3 round model before any measurement.
+
+Rank consistency: everything here is Python floats of shared inputs in a fixed order: the confidences come out of
+the same kernels on both ranks' identical streams, the commits arrive in plan order, the costs are one shared table
+and nothing reads a clock. Drafts only propose: replies are serial whatever k is.
+
+**Joint depth** (TF_DSV41_DEPTH_JOINT, default 1; ``joint.py``): a round of several windows chooses every DSpark
+slot's k together (``choose_joint``), priced by the shared window's total rows (``Costs.rows_ms``) at the round's
+aggregate rate (``joint_rate``: committed tokens of all slots per modelled round-ms, kept per number of windows),
+instead of each slot pricing a window it would run alone at its own rate. A lone window keeps ``choose``.
+
+**Confidence calibration** (TF_DSV41_CONF_CAL, ``confcal.py``): ``factor`` (default, ``Calibration`` below) or
+sequential temperature scaling of the head's logit a position (``temp`` / ``platt``, or fixed TF_DSV41_CONF_TEMP).
+
+Knobs: TF_DSV41_DEPTH (cost | static, default cost), TF_DSV41_DRAFT_DEPTH (the most DSpark drafts a round, 1-5,
+default 5; ``static``: the fixed k, default 3, the kit's), TF_DSV41_DRAFT_SKIP (1; 0 = the first draft is always
+verified, and ``lookup.Planner`` never skips the pass), TF_DSV41_DEPTH_JOINT (1).
+"""
+
+from __future__ import annotations
+
+import os
+from collections import deque
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+from tensorfold.families.glm5_next.spark.depth import F_MAX, F_MIN, PRIOR, Q_MAX, RATE_WINDOW, best_k, expected_tokens
+
+from . import joint as J
+
+DECAY = 0.97
+US = 1000.0
+MAX_ROWS = 16                    # the widest verify window (lookup copies; 0380's cap)
+
+
+@dataclass
+class Costs:
+    """``verify[k]``: ms of a verify window of k + 1 rows in total, whatever slots they belong to (k = 0 .. 15, or
+    .. 63 measured on the row graphs, ``calib.py``); ``draft``: ms of one DSpark pass (one slot); ``slot``: the extra
+    ms of each further slot in a window (its attention and bookkeeping, beyond its rows); ``source``: default |
+    measured | cached."""
+
+    verify: list[float]
+    draft: float
+    source: str = "default"
+    slot: float = 0.0
+
+    def window_ms(self, rows: int) -> float:
+        return self.verify[max(0, min(rows, len(self.verify)) - 1)]
+
+    def rows_ms(self, rows: int) -> float:
+        """A window of ``rows`` total rows; past the table on the line of its last two entries."""
+
+        v, r = self.verify, max(1, int(rows))
+        if r <= len(v):
+            return v[r - 1]
+        slope = max(v[-1] - v[-2], 0.0) if len(v) >= 2 else 0.0
+        return v[-1] + slope * (r - len(v))
+
+    def encode(self) -> list[int]:
+        return [max(1, min(round(v * US), 10 ** 9)) for v in [self.draft, self.slot, *self.verify]]
+
+    @classmethod
+    def decode(cls, ints: Sequence[int], source: str = "measured") -> Costs:
+        vals = [int(v) / US for v in ints]
+        return cls(vals[2:], vals[0], source, vals[1])
+
+    def monotone(self) -> Costs:
+        out = list(self.verify)
+        for i in range(1, len(out)):
+            out[i] = max(out[i], out[i - 1])
+        return Costs(out, self.draft, self.source, self.slot)
+
+
+def default_costs(rows: int = MAX_ROWS) -> Costs:
+    """Section 1.3's round model at 65% of the floor: ~37 ms + ~5 ms a verify row; the DSpark pass ~5.6 ms."""
+
+    return Costs([37.0 + 5.0 * (r + 1) for r in range(rows)], 5.6)
+
+
+def env_mode() -> tuple[str, int]:
+    """(TF_DSV41_DEPTH, TF_DSV41_DRAFT_DEPTH): ``cost`` with a cap (default 5) or ``static`` k (default 3)."""
+
+    mode = (os.environ.get("TF_DSV41_DEPTH", "cost").strip().lower() or "cost")
+    if mode not in ("cost", "static"):
+        raise ValueError(f"TF_DSV41_DEPTH={mode!r}: expected cost or static")
+    raw = os.environ.get("TF_DSV41_DRAFT_DEPTH", "").strip()
+    k = int(raw) if raw else (5 if mode == "cost" else 3)
+    if not 0 <= k <= 15:
+        raise ValueError(f"TF_DSV41_DRAFT_DEPTH={k}: expected 0 to 15")
+    return mode, k
+
+
+def env_skip() -> bool:
+    """TF_DSV41_DRAFT_SKIP: 1 (default) lets a lone window verify no draft (here) and a low-acceptance request skip
+    the DSpark pass (``lookup.Planner``); 0 keeps the first draft always verified and every round drafting."""
+
+    v = os.environ.get("TF_DSV41_DRAFT_SKIP", "1").strip().lower() or "1"
+    if v not in ("0", "1", "on", "off", "true", "false"):
+        raise ValueError(f"TF_DSV41_DRAFT_SKIP={v!r}: expected 0 or 1")
+    return v in ("1", "on", "true")
+
+
+class Stats:
+    """Acceptance evidence for reports (G6): per draft position the verified / kept drafts, and per bin of the
+    calibrated first-draft q the rounds and first drafts kept (counterfactual ones included), zero-depth rounds."""
+
+    BINS = 10
+
+    def __init__(self, positions: int) -> None:
+        self.reset(positions)
+
+    def reset(self, positions: int | None = None) -> None:
+        n = positions if positions is not None else len(self.reached)
+        self.reached, self.kept = [0] * n, [0] * n
+        self.q1 = [[0, 0] for _ in range(self.BINS)]
+        self.rounds = self.zero = 0
+        self.joint = [0, 0, 0]          # joint rounds, their total rows, their DSpark drafts verified
+
+    def add(self, q1: float | None, verified: int, keep: int, first_kept: bool | None) -> None:
+        for j in range(min(verified, keep, len(self.reached))):
+            self.reached[j] += 1
+            self.kept[j] += int(j < keep - 1)
+        if q1 is not None and first_kept is not None:
+            b = self.q1[min(int(q1 * self.BINS), self.BINS - 1)]
+            b[0] += 1
+            b[1] += int(first_kept)
+
+    def report(self) -> dict:
+        return {"rounds": self.rounds, "zero_depth": self.zero, "reached": list(self.reached), "kept": list(self.kept),
+                "q1_bins": [list(b) for b in self.q1], "joint": list(self.joint)}
+
+
+class Calibration:
+    """Per draft position: decayed kept drafts and summed confidences (the head's correction factor)."""
+
+    def __init__(self, positions: int) -> None:
+        self.kept = [0.0] * positions
+        self.prob = [0.0] * positions
+
+    def factor(self, j: int) -> float:
+        j = min(j, len(self.kept) - 1)
+        return min(max((self.kept[j] + PRIOR) / (self.prob[j] + PRIOR), F_MIN), F_MAX)
+
+    def q(self, j: int, p: float) -> float:
+        return min(max(float(p), 0.0) * self.factor(j), Q_MAX)
+
+    def record(self, probs: Sequence[float], keep: int) -> None:
+        """``probs``: the verified drafts' confidences, ``keep``: rows committed (1 + drafts kept)."""
+
+        for j, p in enumerate(probs[:len(self.kept)]):
+            if j >= keep:
+                break
+            self.kept[j] = self.kept[j] * DECAY + (1.0 if j < keep - 1 else 0.0)
+            self.prob[j] = self.prob[j] * DECAY + max(float(p), 0.0)
+
+
+@dataclass
+class _Slot:
+    rounds: deque = field(default_factory=lambda: deque(maxlen=RATE_WINDOW))    # (tokens, modelled ms)
+    used: list = field(default_factory=list)                                     # this window's confidences
+    drafted: bool = False
+    first: tuple | None = None          # a zero-depth round's (first draft, its raw confidence), until its bonus
+    q1: float | None = None             # this round's calibrated q_1 (stats)
+    rows: int = 0                       # the last window's rows, keep (stats, after ``record``)
+    keep: int = 0
+    ms: float | None = None             # a tree round's modelled ms (``choose_tree``: window + duplicates + pass)
+
+
+class Depth:
+    """Both ranks: each slot's DSpark depth from its drafts' confidences (``choose``), the calibration and rates
+    from the commits (``record``). One ``Calibration`` for the whole model (the head's bias is the model's)."""
+
+    def __init__(self, costs: Costs | None = None, *, block: int = 5, mode: str | None = None,
+                 cap: int | None = None, skip: bool | None = None, joint: bool | None = None) -> None:
+        m, k = env_mode()
+        self.mode = mode or m
+        self.cap = k if cap is None else int(cap)
+        self.skip = env_skip() if skip is None else bool(skip)
+        self.joint = J.env_on() if joint is None else bool(joint)
+        self.max_rows = J.rows_cap()
+        self.costs = costs or default_costs()
+        from . import confcal
+
+        self.cal = confcal.make(block)              # TF_DSV41_CONF_CAL (default: ``Calibration``)
+        self.stats = Stats(block)
+        self.slots: dict[int, _Slot] = {}
+        self._acc: dict = {}            # the open round's commits: slot -> (tokens, rows, drafted)
+        self._agg: dict[int, deque] = {}    # windows in a round -> recent (tokens, modelled ms) of such rounds
+
+    def reset(self, slot: int) -> None:
+        self.slots.pop(slot, None)
+
+    def _s(self, slot: int) -> _Slot:
+        return self.slots.setdefault(slot, _Slot())
+
+    def rate(self, slot: int) -> float:
+        r = self._s(slot).rounds
+        if r:
+            return sum(t for t, _ in r) / sum(ms for _, ms in r)
+        return 2.0 / (self.costs.window_ms(2) + self.costs.draft)
+
+    def choose(self, slot: int, conf: Sequence[float], most: int, *, alone: bool = False,
+               first: int | None = None) -> int:
+        """Drafts to verify (1 .. min(most, len(conf), cap); 0 .. when ``alone`` and zero depth is on, ``first``:
+        the first draft's token, for the counterfactual calibration); 0 when ``most`` is 0."""
+
+        top = min(int(most), len(conf), self.cap)
+        st = self._s(slot)
+        st.first, st.q1, st.ms = None, None, None
+        if top <= 0:
+            st.used, st.drafted = [], False
+            return 0
+        if self.mode == "static":
+            k = top
+        else:
+            qs = [self.cal.q(j, p) for j, p in enumerate(conf[:top])]
+            least = 0 if (self.skip and alone and first is not None) else 1
+            k, _ = best_k(qs, self.costs.verify, self.rate(slot), least=least)
+            k = max(least, min(k, top))
+            st.q1 = qs[0]
+            if k == 0:
+                st.first = (int(first), float(conf[0]))
+        st.used, st.drafted = [float(c) for c in conf[:k]], True
+        return k
+
+    # -- the joint depth (``joint.py``) ------------------------------------------------------------------------------
+    def round_ms(self, rows: int, windows: int, drafted: bool) -> float:
+        """Modelled ms of a round: its window of ``rows`` total rows, each further window's overhead, the pass."""
+
+        return (self.costs.rows_ms(rows) + self.costs.slot * max(0, windows - 1)
+                + (self.costs.draft if drafted else 0.0))
+
+    def _close(self) -> None:
+        """The open round's commits (``record``) -> one (tokens, modelled ms) of the aggregate rate."""
+
+        acc, self._acc = self._acc, {}
+        if not acc:
+            return
+        n = len(acc)
+        toks = sum(t for t, _, _ in acc.values())
+        ms = self.round_ms(sum(r for _, r, _ in acc.values()), n, any(d for _, _, d in acc.values()))
+        self._agg.setdefault(n, deque(maxlen=RATE_WINDOW)).append((toks, ms))
+
+    def joint_rate(self, windows: int) -> float:
+        """lambda of a round of ``windows`` windows: its recent rounds' tokens per modelled ms, else two tokens a
+        drafting window over a round of two rows a window."""
+
+        r = self._agg.get(int(windows))
+        if r:
+            return sum(t for t, _ in r) / sum(ms for _, ms in r)
+        n = max(1, int(windows))
+        return 2.0 * n / self.round_ms(2 * n, n, True)
+
+    def choose_joint(self, slots: Sequence[int], confs: Sequence[Sequence[float]], mosts: Sequence[int], *,
+                     others: Sequence[int] = (), firsts: Sequence[int | None] | None = None,
+                     alone: bool | None = None) -> list[int]:
+        """Every DSpark slot's k for one round, together (``joint.allocate``). ``others``: the rows of the round's
+        other windows (lookup copies, plain rows), fixed. A lone window (``alone``; None: one slot, no others),
+        static depth or the joint depth off: ``choose`` a slot at a time, as before."""
+
+        self._close()
+        firsts = list(firsts) if firsts is not None else [None] * len(slots)
+        if alone is None:
+            alone = len(slots) == 1 and not others
+        alone = bool(alone) and len(slots) == 1 and not others
+        if not self.joint or self.mode == "static" or alone or len(slots) + len(others) <= 1:
+            return [self.choose(s, c, m, alone=alone, first=f) for s, c, m, f in zip(slots, confs, mosts, firsts)]
+        qs, lo, top = [], [], []
+        for s, conf, most in zip(slots, confs, mosts):
+            t = max(0, min(int(most), len(conf), self.cap, MAX_ROWS - 1))
+            st = self._s(s)
+            st.first, st.q1, st.ms = None, None, None
+            q = [self.cal.q(j, p) for j, p in enumerate(conf[:t])]
+            st.q1 = q[0] if q else None
+            qs.append(q)
+            top.append(t)
+            lo.append(1 if t > 0 else 0)
+        rate = self.joint_rate(len(slots) + len(others))
+        ks, _ = J.allocate(qs, lo, top, shared=sum(int(r) for r in others), rows_ms=self.costs.rows_ms,
+                           rate=rate, max_rows=self.max_rows)
+        for s, conf, k, t in zip(slots, confs, ks, top):
+            st = self._s(s)
+            st.used, st.drafted = [float(c) for c in conf[:k]], t > 0
+        self.stats.joint[0] += 1
+        self.stats.joint[1] += sum(1 + k for k in ks) + sum(int(r) for r in others)
+        self.stats.joint[2] += sum(ks)
+        return ks
+
+    def expected(self, slot: int, conf: Sequence[float], k: int) -> float:
+        """E(k) of the calibrated confidences (reports, tests)."""
+
+        return expected_tokens([self.cal.q(j, p) for j, p in enumerate(conf[:k])])[k]
+
+    def choose_tree(self, slot: int, conf: Sequence[float], most: int, sibs: Sequence[float], *, alone: bool = False,
+                    first: int | None = None, dup_ms: float = 0.4, sib_rows: int = 4) -> tuple[int, list[int]]:
+        """``choose`` with first-position siblings (``tree.plan``): ``sibs`` their calibrated chances -> (k, each
+        sibling's rows, 0 = not verified). Without siblings (or static depth) it is ``choose``."""
+
+        from .tree import plan
+
+        top = min(int(most), len(conf), self.cap)
+        if top <= 0 or self.mode == "static" or not sibs:
+            return self.choose(slot, conf, most, alone=alone, first=first), [0] * len(sibs)
+        st = self._s(slot)
+        st.first, st.q1, st.ms = None, None, None
+        qs = [self.cal.q(j, p) for j, p in enumerate(conf[:top])]
+        least = 0 if (self.skip and alone and first is not None) else 1
+        k, lens, ms, _ = plan(qs, sibs, qs[1:], self.costs.verify, self.rate(slot), least=least, dup_ms=dup_ms,
+                              sib_rows=min(int(sib_rows), top), max_rows=MAX_ROWS)   # a slot's 16 (the table: 64)
+        k = max(least, min(k, top))
+        st.q1 = qs[0]
+        if k == 0:
+            st.first = (int(first), float(conf[0]))
+            lens = [0] * len(sibs)
+        if any(lens):
+            st.ms = ms + self.costs.draft
+        st.used, st.drafted = [float(c) for c in conf[:k]], True
+        return k, lens
+
+    def choose_pc(self, slot: int, conf: Sequence[float], most: int, plan, *, alone: bool = False,
+                  first: int | None = None):
+        """``choose`` for a parent-conditioned tree (``pctree``): ``plan(q, rate, least, top)`` -> ``pctree.Plan``
+        (``q(j, p)``: this calibration) -> (k, the plan when it has extra chains, else None)."""
+
+        top = min(int(most), len(conf), self.cap)
+        if top <= 0 or self.mode == "static":
+            return self.choose(slot, conf, most, alone=alone, first=first), None
+        st = self._s(slot)
+        st.first, st.q1, st.ms = None, None, None
+        least = 0 if (self.skip and alone and first is not None) else 1
+        got = plan(self.cal.q, self.rate(slot), least, top)
+        k = max(least, min(got.k, top))
+        st.q1 = self.cal.q(0, conf[0])
+        if k == 0:
+            st.first = (int(first), float(conf[0]))
+            got = None
+        elif got.chains:
+            st.ms = got.ms + self.costs.draft
+        else:
+            got = None
+        st.used, st.drafted = [float(c) for c in conf[:k]], True
+        return k, got
+
+    def record(self, slot: int, rows: int, keep: int, *, tokens: int | None = None) -> None:
+        """The slot's last window had ``rows`` rows and committed ``keep`` (= accepted + 1). A tree round
+        (``tree.Tree.commit``): ``rows`` / ``keep`` are the main chain's (its calibration), ``tokens`` the round's."""
+
+        if slot in self._acc:           # a slot commits once a round: a second commit opens the next round
+            self._close()
+        st = self._s(slot)
+        self._acc[slot] = (keep if tokens is None else int(tokens), int(rows), bool(st.drafted))
+        if st.drafted:
+            used = st.used[:max(0, rows - 1)]
+            self.cal.record(used, keep)
+            self.stats.rounds += 1
+            if st.first is None:
+                self.stats.add(st.q1, len(used), keep, (keep > 1) if used else None)
+        ms = self.costs.window_ms(rows) + (self.costs.draft if st.drafted else 0.0)
+        if st.ms is not None:
+            ms = st.ms
+        st.rounds.append((keep if tokens is None else int(tokens), ms))
+        st.used, st.drafted, st.ms = [], False, None
+        st.rows, st.keep = rows, keep
+
+    def bonus(self, slot: int, token: int) -> None:
+        """After ``record``: the token the window chose after its last kept row. A zero-depth round's first draft
+        would have been kept iff it equals the bonus (its 1-row window's choice is the serial token there), so the
+        calibration learns from it as if it had been verified."""
+
+        st = self.slots.get(slot)
+        if st is None or st.first is None:
+            return
+        draft, p = st.first
+        st.first = None
+        if st.rows != 1 or st.keep != 1:
+            return
+        kept = int(token) == draft
+        self.cal.record([p], 2 if kept else 1)
+        self.stats.zero += 1
+        self.stats.add(st.q1, 0, 1, kept)
+
+
+__all__ = ["MAX_ROWS", "Calibration", "Costs", "Depth", "Stats", "default_costs", "env_mode", "env_skip"]
