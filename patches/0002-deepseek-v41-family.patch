index 0000000..31a2297
--- /dev/null
+++ b/tests/cuda/test_dsv41_glue_gpu.py
@@ -0,0 +1,315 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9 decode glue on the GPU (collected only where PyTorch sees an NVIDIA GPU), compiled kernels at D = 5,120:
+
+- the decode mHC site (``mhc_dec``, TF_DSV41_MHC_DEC) == ``mhc._site``'s SPLIT launch bit for bit at 1-16 rows:
+  boundary (bf16 / fp32 partials, taps), site (stream 0 / carried pre-mix); inside a CUDA graph too; with bf16 mixing
+  weights (TF_DSV41_MHC_FN=bf16) against the same launch on bf16 weights, and row invariance;
+- the finish (TF_DSV41_MHC_FIN2): == the G7 finish bit for bit;
+- times, DRAM-cold (a ring of 24 sites' weights, 48 MB > L2), printed as ``[G9G]`` lines: site old / dec / dec+bf16
+  and the finish old / new, at 1 / 2 / 4 / 8 / 16 rows;
+- q_norm + kv_norm in one launch (TF_DSV41_RMS_PAIR) == two launches; an EXL3 linear's bf16 store == its fp32 output
+  cast (TF_DSV41_PARTIAL_BF16); the Engram fuse with its loads in flight (TF_DSV41_ENGRAM_FUSE_DEC) == engram.fuse;
+  bit for bit, with times.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_glue_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import mhc  # noqa: E402
+
+DEV = "cuda"
+D = 5120
+RING = 24
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _hc(g, dtype=torch.float32):
+    return mhc.Hc((torch.randn((24, 4 * D), generator=g) * 0.01).to(dtype).contiguous().to(DEV),
+                  (torch.randn(24, generator=g) * 0.5).to(DEV), (torch.rand(3, generator=g) + 0.5).to(DEV))
+
+
+def _case(R: int, world: int = 2, seed: int = 1, dtype=torch.float32, gdtype=torch.bfloat16):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16).to(DEV)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16).to(gdtype).to(DEV)
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, DEV, pre=(torch.rand((R, 4), generator=g) + 0.1).to(DEV),
+                     post=(torch.rand((R, 4), generator=g) * 2).to(DEV), comb=comb.to(DEV))
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    return x, gathered, prev, _hc(g, dtype), nw
+
+
+class _Out:
+    def __init__(self, R: int, tap: bool) -> None:
+        self.xout = torch.zeros((R, 4 * D), dtype=torch.bfloat16, device=DEV)
+        self.out = torch.zeros((R, D), dtype=torch.bfloat16, device=DEV)
+        self.co = mhc.Coefs(R, DEV)
+        self.sc = mhc.Scratch(R, DEV, D)
+        self.tap = torch.zeros((R, 2 * D), dtype=torch.bfloat16, device=DEV)[:, D:] if tap else None
+
+    def all(self, R: int) -> dict:
+        d = {"x": self.xout, "out": self.out, "pre": self.co.pre, "post": self.co.post, "comb": self.co.comb,
+             "c": self.sc.c[:R], "part": self.sc.part[:R, :, :, :25], "p25": self.sc.part[:R, 0, :, 25]}
+        if self.tap is not None:
+            d["tap"] = self.tap
+        return {k: v.clone() for k, v in d.items()}
+
+
+def _boundary(case, o: _Out):
+    x, gathered, prev, hc, nw = case
+    mhc.boundary(x, o.xout, gathered, prev, hc, nw, o.out, o.co, o.sc, tap=o.tap)
+
+
+def _same(a: dict, b: dict, what: str):
+    bad = [k for k in a if not torch.equal(_bits(a[k]), _bits(b[k]))]
+    assert not bad, f"{what}: {bad}"
+
+
+def _with(monkeypatch, **env):
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+
+
+@pytest.mark.parametrize("R", [1, 2, 3, 4, 6, 8, 16])
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_mhc_dec_boundary_bits(monkeypatch, R, dtype):
+    case = _case(R, seed=R, dtype=dtype)
+    got = {}
+    for dec in ("0", "1"):
+        _with(monkeypatch, TF_DSV41_MHC_DEC=dec)
+        o = _Out(R, tap=True)
+        _boundary(case, o)
+        got[dec] = o.all(R)
+    _same(got["0"], got["1"], f"boundary R={R} fn={dtype}")
+
+
+@pytest.mark.parametrize("R", [1, 4, 16])
+def test_mhc_dec_site_and_fp32_partials(monkeypatch, R):
+    x, gathered, prev, hc, nw = _case(R, seed=40 + R, gdtype=torch.float32)
+    for pre_in in (None, prev.pre):
+        got = {}
+        for dec in ("0", "1"):
+            _with(monkeypatch, TF_DSV41_MHC_DEC=dec)
+            o = _Out(R, tap=False)
+            mhc.site(x, hc, nw, o.out, o.co, o.sc, pre_in=pre_in)
+            got[dec] = {k: v for k, v in o.all(R).items() if k != "x"}
+        _same(got["0"], got["1"], f"site R={R} pre_in={pre_in is not None}")
+    got = {}
+    for dec in ("0", "1"):
+        _with(monkeypatch, TF_DSV41_MHC_DEC=dec)
+        o = _Out(R, tap=False)
+        _boundary((x, gathered, prev, hc, nw), o)
+        got[dec] = o.all(R)
+    _same(got["0"], got["1"], f"boundary fp32 partials R={R}")
+
+
+def test_mhc_dec_graph_and_row_invariance(monkeypatch):
+    _with(monkeypatch, TF_DSV41_MHC_DEC="1")
+    R = 4
+    case = _case(R, seed=77, dtype=torch.bfloat16)
+    eager = _Out(R, tap=True)
+    _boundary(case, eager)
+    o = _Out(R, tap=True)
+    _boundary(case, o)                     # compile outside the capture
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        _boundary(case, o)
+    o.xout.zero_()
+    o.out.zero_()
+    g.replay()
+    torch.cuda.synchronize()
+    _same(eager.all(R), o.all(R), "graph replay")
+    x, gathered, prev, hc, nw = case
+    full = eager.all(R)
+    for r in range(R):
+        sl = slice(r, r + 1)
+        p1 = mhc.Coefs(1, DEV, pre=prev.pre[sl].clone(), post=prev.post[sl].clone(), comb=prev.comb[sl].clone())
+        one = _Out(1, tap=True)
+        _boundary((x[sl].clone(), gathered[:, sl].clone(), p1, hc, nw), one)
+        a = one.all(1)
+        _same(a, {k: v[sl] for k, v in full.items()}, f"row {r} alone")
+
+
+@pytest.mark.parametrize("R", [1, 4, 16])
+def test_finish_fin2_bits(monkeypatch, R):
+    case = _case(R, seed=90 + R)
+    got = {}
+    for v in ("0", "1"):
+        _with(monkeypatch, TF_DSV41_MHC_FIN2=v)
+        o = _Out(R, tap=False)
+        _boundary(case, o)
+        got[v] = o.all(R)
+    _same(got["0"], got["1"], f"finish norm first R={R}")
+    for w in ("1", "2", "8"):           # another layout: the coefficients within fp32 rounding, the rest the same
+        _with(monkeypatch, TF_DSV41_MHC_FIN_WARPS=w)
+        o = _Out(R, tap=False)
+        _boundary(case, o)
+        a = o.all(R)
+        for k in ("pre", "post", "comb"):
+            torch.testing.assert_close(a[k], got["1"][k], rtol=1e-5, atol=1e-6)
+        _same({k: a[k] for k in ("x", "out", "c", "part")}, {k: got["1"][k] for k in ("x", "out", "c", "part")},
+              f"finish warps {w}")
+        same = all(torch.equal(_bits(a[k]), _bits(got["1"][k])) for k in ("pre", "post", "comb"))
+        print(f"[G9G] finish warps {w} R={R}: coefficients {'bit for bit' if same else 'differ (fp32 rounding)'}")
+    monkeypatch.delenv("TF_DSV41_MHC_FIN_WARPS")
+
+
+def _ring_us(R: int, dtype, env: dict, monkeypatch, site_only: bool, reps: int = 4) -> float:
+    """us a boundary (or its site launch alone) over a ring of RING sites' weights (DRAM-cold like the window)."""
+
+    _with(monkeypatch, **env)
+    g = torch.Generator().manual_seed(5)
+    x, gathered, prev, _, nw = _case(R, seed=5)
+    hcs = [_hc(g, dtype) for _ in range(RING)]
+    o = _Out(R, tap=False)
+
+    def one(hc):
+        if site_only:
+            mhc._launch(x, o.xout, gathered, prev, prev.pre, hc, o.sc, None, R, D, True, 2, True)
+        else:
+            mhc.boundary(x, o.xout, gathered, prev, hc, nw, o.out, o.co, o.sc)
+
+    for hc in hcs:
+        one(hc)
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        for hc in hcs:
+            one(hc)
+    b.record()
+    torch.cuda.synchronize()
+    return 1000.0 * a.elapsed_time(b) / (reps * RING)
+
+
+def test_mhc_times(monkeypatch):
+    for R in (1, 2, 4, 8, 16):
+        cells = []
+        for name, dtype, env in (("split", torch.float32, {"TF_DSV41_MHC_DEC": "0", "TF_DSV41_MHC_FIN2": "0"}),
+                                 ("dec", torch.float32, {"TF_DSV41_MHC_DEC": "1"}),
+                                 ("dec-bf16", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1"}),
+                                 ("dec-bf16-8w", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1",
+                                                                  "TF_DSV41_MHC_DEC_WARPS": "8"}),
+                                 ("dec-bf16-rolled", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1",
+                                                                      "TF_DSV41_MHC_DEC_UNROLL": "0"}),
+                                 ("dec-bf16-fin1", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1", "TF_DSV41_MHC_FIN2": "0"}),
+                                 ("dec-bf16-finw1", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1",
+                                                                     "TF_DSV41_MHC_FIN_WARPS": "1"}),
+                                 ("dec-bf16-finw2", torch.bfloat16, {"TF_DSV41_MHC_DEC": "1",
+                                                                     "TF_DSV41_MHC_FIN_WARPS": "2"})):
+            s = _ring_us(R, dtype, env, monkeypatch, True)
+            t = _ring_us(R, dtype, env, monkeypatch, False)
+            cells.append(f"{name} site {s:.1f} + finish {t - s:.1f} = {t:.1f}")
+            for k in ("TF_DSV41_MHC_DEC_WARPS", "TF_DSV41_MHC_DEC_UNROLL", "TF_DSV41_MHC_FIN2",
+                      "TF_DSV41_MHC_FIN_WARPS"):
+                monkeypatch.delenv(k, raising=False)
+        print(f"[G9G] mhc R={R}: " + "; ".join(cells) + " us (DRAM-cold ring)", flush=True)
+    assert os.environ.get("TF_DSV41_MHC_DEC", "1") in ("0", "1")
+
+
+@pytest.mark.parametrize("R", [1, 2, 4, 16])
+def test_rms_pair_bits_and_time(R):
+    """q_norm / kv_norm in one launch (TF_DSV41_RMS_PAIR) == two ``rmsnorm.rms`` launches bit for bit; times."""
+
+    from tensorfold.families.deepseek_v41.cuda import rmsnorm as RN
+
+    g = torch.Generator().manual_seed(R)
+    both = (torch.randn((R, 1024 + 512), generator=g) * 3).to(torch.bfloat16).to(DEV)
+    xa, xb = both[:, :1024], both[:, 1024:]
+    wa = (torch.rand(1024, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    wb = (torch.rand(512, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    oa, ob = RN.rms_pair(xa, wa, xb, wb, 1e-6, torch.bfloat16)
+    assert torch.equal(_bits(oa), _bits(RN.rms(xa, wa, 1e-6, torch.bfloat16)))
+    assert torch.equal(_bits(ob), _bits(RN.rms(xb, wb, 1e-6, torch.bfloat16)))
+
+    def us(fn, reps=200):
+        fn()
+        torch.cuda.synchronize()
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        for _ in range(reps):
+            fn()
+        b.record()
+        torch.cuda.synchronize()
+        return 1000.0 * a.elapsed_time(b) / reps
+
+    two = us(lambda: (RN.rms(xa, wa, 1e-6, torch.bfloat16), RN.rms(xb, wb, 1e-6, torch.bfloat16)))
+    one = us(lambda: RN.rms_pair(xa, wa, xb, wb, 1e-6, torch.bfloat16))
+    print(f"[G9G] rms R={R}: two launches {two:.1f} us, pair {one:.1f} us (host-bound eager; graphs: kernel times)")
+
+
+@pytest.mark.parametrize("split", [(1, 4), (2, 4), (8, 8)])
+def test_linear_bf16_out_equals_cast(split):
+    """TF_DSV41_PARTIAL_BF16: an EXL3 linear storing bf16 == its fp32 output cast to bf16, bit for bit (wo_b's
+    partial goes to the decode exchange without the cast launch)."""
+
+    import numpy as np
+
+    from tensorfold.cuda.exl3 import format as fmt
+    from tensorfold.cuda.exl3 import linear
+
+    rng = np.random.default_rng(3)
+    kt, nt, bits = 64, 16, 3
+    trellis = torch.from_numpy(rng.integers(-2**15, 2**15, size=(kt, nt, fmt.tile_words(bits))).astype(np.int16))
+    suh = torch.from_numpy((rng.standard_normal(16 * kt) * 0.05).astype(np.float16))
+    svh = torch.from_numpy((rng.standard_normal(16 * nt) * 0.05).astype(np.float16))
+    layer = linear.Exl3Linear.from_tensors(trellis, suh, svh, "mul1")
+    if kt % (split[0] * split[1]):
+        pytest.skip("split does not divide K")
+    layer.split = split
+    for R in (1, 2, 4, 16):
+        x = (torch.randn((R, 16 * kt)) * 2).to(torch.bfloat16).to(DEV)
+        y32 = torch.empty((R, 16 * nt), dtype=torch.float32, device=DEV)
+        y16 = torch.empty((R, 16 * nt), dtype=torch.bfloat16, device=DEV)
+        layer(x, out=y32)
+        layer(x, out=y16)
+        assert torch.equal(_bits(y16), _bits(y32.to(torch.bfloat16))), (split, R)
+
+
+@pytest.mark.parametrize("R", [1, 2, 4, 16])
+def test_engram_fuse_dec_bits_and_time(R):
+    """TF_DSV41_ENGRAM_FUSE_DEC: ``engram_dec.fuse`` == ``engram.fuse`` bit for bit (gates, streams); times."""
+
+    from tensorfold.families.deepseek_v41.cuda import engram, engram_dec
+
+    g = torch.Generator().manual_seed(R)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16).to(DEV)
+    kv = (torch.randn((R, 5 * D), generator=g) * 0.5).to(torch.bfloat16).to(DEV)
+    qk = engram.qk_weights(torch.rand((4, D), generator=g) + 0.5, torch.rand((4, D), generator=g) + 0.5).to(DEV)
+    keep = torch.ones(R, device=DEV)
+    a, b = x.clone(), x.clone()
+    ga, gb = torch.zeros((R, 4), device=DEV), torch.zeros((R, 4), device=DEV)
+    engram.fuse(a, kv, qk, keep, ga)
+    engram_dec.fuse(b, kv, qk, keep, gb, eps=engram.EPS, clamp=engram.CLAMP)
+    assert torch.equal(_bits(ga), _bits(gb)) and torch.equal(_bits(a), _bits(b))
+
+    def us(fn, reps=50):
+        y = x.clone()
+        fn(y)
+        torch.cuda.synchronize()
+        e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        e0.record()
+        for _ in range(reps):
+            fn(y)
+        e1.record()
+        torch.cuda.synchronize()
+        return 1000.0 * e0.elapsed_time(e1) / reps
+
+    old = us(lambda y: engram.fuse(y, kv, qk, keep))
+    new = us(lambda y: engram_dec.fuse(y, kv, qk, keep, eps=engram.EPS, clamp=engram.CLAMP))
+    print(f"[G9G] engram fuse R={R}: engram.fuse {old:.1f} us, engram_dec {new:.1f} us")
