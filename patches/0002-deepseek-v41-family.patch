+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The round's host tail on the GPU (window G8 ``host``; collected only where PyTorch sees an NVIDIA GPU), on the
+synthetic DSpark checkpoint (``dsv41_dspark_fakes``) with the Triton kernels:
+
+- ``vsample`` on the device: splitmix64 uniforms == numpy's bit for bit; the merged candidates == the old host
+  lexsort (ties, -0.0, -inf); the device choice == ``choose_rows`` (greedy exactly; sampled: the rare last-bit
+  disagreements counted, ``[G8-host]``: they only cost a speculation);
+- ``SlotsForward.candidates`` (device sort, pinned non-blocking copy) == the old merge of the same gathered halves;
+- ``spec.stage_device`` == ``DraftInputs.stage`` on the device arenas;
+- speculation on with draft graphs: drafted == serial (1 and 4 slots, T = 0 and T > 0), the passes are used, every
+  round's drafts == the run without speculation; the host's time a round in ``window`` / ``spec`` / ``draft.pass``
+  (``[G8-host]`` lines, PHASES=1).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_host_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.engine.exact_sampling import Sampling, choose_rows, uniform_rows
+from tensorfold.families.deepseek_v41.cuda import draft_graphs as DG
+from tensorfold.families.deepseek_v41.cuda import phases
+from tensorfold.families.deepseek_v41.cuda import spec as SP
+from tensorfold.families.deepseek_v41.cuda import vsample as VS
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.draft_graphs import DraftInputs
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece, Rows
+
+DEV = "cuda"
+LONG = 4096
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=(1 << 64) - 5, temperature=1.1, top_k=40, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(80 + i).integers(3, 250, size=n)]
+           for i, n in enumerate((2070, 300, 2101, 180))]
+N = 32
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41host"))
+
+
+def _fw(ck, slots=1, dspark=True):
+    return DF.forward(ck, slots=slots, limit=LONG, dspark=dspark, device=DEV, chunk=128)
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        mp.setenv(SP.ENV, "0")
+        b = DF.batcher(ck, _fw(ck, slots=4, dspark=False), n=4, capacity=LONG, pool_tokens=5 * LONG, depth=0)
+        return DF.run(b, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+# -- vsample -----------------------------------------------------------------------------------------------------------
+def test_uniform_bits_gpu():
+    rng = np.random.default_rng(0)
+    for seed in (0, 7, (1 << 63) - 1, (1 << 64) - 5):
+        pos = rng.integers(0, 1 << 20, 64)
+        ids = rng.integers(0, 129280, (64, 128))
+        got = VS.uniform(torch.full((64,), VS.s64(seed), dtype=torch.int64, device=DEV),
+                         torch.from_numpy(pos).to(DEV), torch.from_numpy(ids).to(DEV)).cpu().numpy()
+        assert np.array_equal(got, uniform_rows(seed, pos, ids))
+
+
+def _old_merge(g, k, count):
+    g = g.cpu()
+    W = g.shape[0]
+    values = torch.cat([g[r, :, :k] for r in range(W)], 1).numpy().astype(np.float32)
+    tokens = torch.cat([g[r, :, k:].contiguous().view(torch.int32) for r in range(W)], 1).numpy().astype(np.int64)
+    order = np.lexsort((tokens, -values), axis=-1)[:, :count]
+    return np.take_along_axis(tokens, order, 1), np.take_along_axis(values, order, 1)
+
+
+def _gathered(rng, R, k, W=2):
+    parts = []
+    for r in range(W):
+        v = torch.from_numpy(rng.normal(0, 3, (R, k)).astype(np.float32)).to(torch.bfloat16).float()
+        v[:, 1], v[:, 3], v[:, 4] = v[:, 0], 0.0, -0.0
+        v[2, :] = v[2, 0]
+        v[5, -3:] = float("-inf")
+        ids = torch.from_numpy(np.stack([rng.permutation(64640)[:k] for _ in range(R)]).astype(np.int32) + 64640 * r)
+        parts.append(torch.cat([v, ids.view(torch.float32)], 1))
+    return torch.stack(parts).to(DEV)
+
+
+@pytest.mark.parametrize("k,count", [(9, 9), (28, 28), (64, 128)])
+def test_merge_gpu_is_lexsort(k, count):
+    g = _gathered(np.random.default_rng(k), 16, k)
+    vals, ids = VS.merge(g, k, count)
+    want_ids, want_vals = _old_merge(g, k, count)
+    assert np.array_equal(ids.cpu().numpy(), want_ids)
+    assert np.array_equal(vals.cpu().numpy().view(np.int32), want_vals.view(np.int32))
+
+
+@pytest.mark.parametrize("si", range(len(SAMPLINGS)))
+def test_choose_gpu_is_choose_rows(si):
+    s = SAMPLINGS[si] or Sampling(seed=1, temperature=0.0)
+    rng = np.random.default_rng(si)
+    R, k = 4096, 64
+    g = _gathered(rng, R, k)
+    count = (int(s.top_k) + 8) if s.temperature > 0 else 9
+    vals, ids = VS.merge(g, k, count)
+    v, i = vals.cpu().numpy(), ids.cpu().numpy()
+    pos = list(range(5000, 5000 + R))
+    sp = SAMPLINGS[si]
+    want = [int(t) for t in i[:, 0]] if sp is None else choose_rows(v, i, pos, sp)
+    i64, f64 = VS.row_tables([(4999, list(range(R)))], [sp])
+    got = VS.run(vals, ids, torch.tensor(i64, device=DEV), torch.tensor(f64, dtype=torch.float64, device=DEV), R, 1)[0]
+    diff = int((got.cpu().numpy() != np.asarray(want)).sum())
+    print(f"[G8-host] device choice vs choose_rows, sampling {si}: {diff} of {R} rows differ")
+    assert diff == 0 if sp is None else diff <= R // 1000
+
+
+def test_candidates_gpu_is_old_merge(ck):
+    fw = _fw(ck)
+    DF.batcher(ck, fw, capacity=LONG, pool_tokens=2 * LONG).ex.slots[0].ensure(LONG)
+    p = PROMPTS[1]
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+
+    logits = fw.run([Seg(0, len(p) - 1, (p[-1], 5, 6, 7))])
+    for count in (9, 28, 300):
+        g, k = fw.cand_gather(logits, [4], count)
+        c = fw.cand_wait(fw.cand_fetch(g, k, count))
+        want_ids, want_vals = _old_merge(g, k, count)
+        assert np.array_equal(c.ids, want_ids) and np.array_equal(c.values, want_vals)
+
+
+@pytest.mark.parametrize("live", [(0, 2), (1, 2, 0)])
+def test_stage_device_gpu(ck, live):
+    fw = _fw(ck, slots=3)
+    dr = fw.drafter
+    for s in range(3):
+        dr._slot(s)
+    sl = tuple(sorted(live))
+    rowmode = bool(getattr(dr, "rowmode", False))
+    if rowmode:
+        key = (DG.pad_slots(len(sl)), dr.rows, dr.head.variant(sl))
+    else:
+        key = (sl, dr.rows, dr.head.variant(sl))
+    a, b = dr.inputs(key), DraftInputs(dr, key)
+    kw = {"slots": sl} if hasattr(a, "rowwin") else {}
+    P, A, valid = [300, 7, 129][:len(sl)], [41, 42, 43][:len(sl)], [250, 0, 3][:len(sl)]
+    samp = [SAMPLINGS[1], None, SAMPLINGS[3]][:len(sl)]
+    b.stage(A, P, valid, samp, dr.noise, dr.ring, **kw)
+    a.stage([0] * len(sl), [p - 3 for p in P], valid, samp, dr.noise, dr.ring, **kw)
+    S = a.S
+    base = [(sl[j] if j < len(sl) else sl[0]) * dr.ring if rowmode else 0 for j in range(S)]
+    t = lambda v: torch.tensor(v, device=DEV)
+    SP.stage_device(a, t(P), t(A), t(valid), dr.ring, t(base))
+    torch.cuda.synchronize()
+    assert torch.equal(a.d64, b.d64) and torch.equal(a.d32, b.d32)
+
+
+# -- speculation -------------------------------------------------------------------------------------------------------
+def _run(ck, slots, spec, monkeypatch):
+    monkeypatch.setenv(SP.ENV, "1" if spec else "0")
+    fw = _fw(ck, slots=slots)
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    fw.drafter.graphs.warmup()
+    seen = []
+    real = fw.draft
+
+    def rec(*a, **k):
+        out = real(*a, **k)
+        seen.append(out)
+        return out
+
+    fw.draft = rec
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(slots + 1) * LONG)
+    jobs = [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    monkeypatch.setenv("TF_DSV41_PHASES", "1")
+    PH = phases.reload()
+    t0 = time.perf_counter()
+    got = DF.run(b, jobs)
+    wall = time.perf_counter() - t0
+    rep = PH.report()
+    monkeypatch.setenv("TF_DSV41_PHASES", "0")
+    phases.reload()
+    return got, seen, fw, rep, wall
+
+
+@pytest.mark.parametrize("slots", [1, 4])
+def test_spec_drafted_equals_serial_gpu(ck, serial, monkeypatch, slots):
+    got, seen, fw, rep, wall = _run(ck, slots, True, monkeypatch)
+    assert got == serial
+    st = fw.spec.stats
+    assert st["launched"] > 0 and st["hit"] > 0, fw.spec.describe()
+    off, seen_off, _, rep_off, wall_off = _run(ck, slots, False, monkeypatch)
+    assert off == serial and seen == seen_off
+    n, n_off = rep.get("round", {}).get("n", 1), rep_off.get("round", {}).get("n", 1)
+    ms = lambda r, k, n: (r.get(k) or {}).get("ms", 0.0) / max(n, 1)
+    keys = ("round", "window", "candidates", "spec", "draft.pass", "commit", "sample")
+    print(f"[G8-host] slots {slots}: {fw.spec.describe()}; ms a round on / off: "
+          + ", ".join(f"{k} {ms(rep, k, n):.3f} / {ms(rep_off, k, n_off):.3f}" for k in keys)
+          + f"; wall {wall:.2f} / {wall_off:.2f} s")
+
+
+def test_window_returns_before_the_pass(ck, monkeypatch):
+    """With a speculation launched, ``window`` waits for the candidates' copy only: the stream still holds the pass."""
+
+    monkeypatch.setenv(SP.ENV, "1")
+    fw = _fw(ck)
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    fw.drafter.graphs.warmup()
+    DF.batcher(ck, fw, capacity=LONG, pool_tokens=2 * LONG).ex.slots[0].ensure(LONG)
+    p = PROMPTS[2]
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    busy = 0
+    for i in range(5):
+        P = len(p) - 1 + i
+        torch.cuda.synchronize()
+        fw.window([Rows(0, P, (p[-1] if i == 0 else 7, 9, 9))], count=9, spec=[(True, [])])
+        busy += int(not torch.cuda.current_stream().query())
+        torch.cuda.synchronize()
+        fw.commit(0, 0)
+    print(f"[G8-host] window returned with the speculative pass still queued in {busy} of 5 rounds; "
+          f"{fw.spec.describe()}")
+    assert fw.spec.stats["launched"] == 5
