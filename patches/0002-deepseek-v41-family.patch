+++ b/tests/test_dsv41_forward_interp.py
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The forward through the Triton CSA2 kernels (``csa2.backend.Triton``: rows, compressors, indexer, candidates,
+reindex, attention) in Triton's CPU interpreter, on a synthetic checkpoint with the kernels' shapes (512-wide rows,
+32 x 128 index heads, a 128-token window), against the same forward on the torch twin: the adapter's arguments
+(positions, rings, compressed rows, carries, selections, counts) are right when the two agree to rounding. Rows are
+also checked to be the same in one prefill window and one row at a time (the kernels' row invariance)."""
+
+from __future__ import annotations
+
+import json
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+if type(compress._kv_store).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+IDS = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(4)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41k"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def run(ckpt, backend: str, windows) -> torch.Tensor:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    chunk = max(windows)
+    cs = Triton(chunk, cfg.num_attention_heads, "cpu") if backend == "triton" else \
+        Twin(cfg.qk_rope_head_dim, cfg.sliding_window)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = FW.Forward(cfg, tree, csa2=cs, limit=64, chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(IDS[a:a + n]))
+        a += n
+    return torch.cat(out)
+
+
+def test_triton_csa2_equals_twin(ckpt):
+    got = run(ckpt, "triton", [21])
+    want = run(ckpt, "torch", [21])
+    assert (got.argmax(-1) == want.argmax(-1)).float().mean() >= 0.9
+    row = (got.double() - want.double()).abs().amax(-1) / want.double().abs().amax(-1)
+    assert float(row.median()) < 0.02
+
+
+def test_triton_rows_are_window_invariant(ckpt):
+    assert torch.equal(run(ckpt, "triton", [21]), run(ckpt, "triton", [5, 8, 8]))
