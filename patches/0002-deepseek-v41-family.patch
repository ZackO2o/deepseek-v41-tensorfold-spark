+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9 decode glue in Triton's CPU interpreter:
+
+- ``Forward.partial_dtype`` (TF_DSV41_PARTIAL_BF16): bf16 partials only for a decode window's exchange;
+- ``engram_dec.fuse`` (TF_DSV41_ENGRAM_FUSE_DEC) == ``engram.fuse`` bit for bit (gates and streams; ``gpu_like``);
+- ``rmsnorm.rms_pair`` (q_norm and kv_norm in one launch, ``TF_DSV41_RMS_PAIR``) == two ``rmsnorm.rms`` calls bit
+  for bit, at the model's widths (1,024 / 512) and others, 1 / 5 rows, strided inputs; row invariance.
+
+Run: python -m pytest -q tests/test_dsv41_glue_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import rmsnorm  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(rmsnorm._rms).__name__ == "InterpretedFunction"
+pytestmark = pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)")
+
+
+def _bits(t):
+    return t.contiguous().view(-1).view(torch.uint8)
+
+
+@pytest.mark.parametrize("R,ka,kb", [(1, 1024, 512), (5, 1024, 512), (3, 1536, 512), (2, 700, 1300)])
+def test_rms_pair_equals_two_rms(R, ka, kb):
+    g = torch.Generator().manual_seed(R * 7 + ka)
+    both = (torch.randn((R, ka + kb + 64), generator=g) * 3).to(torch.bfloat16)
+    xa, xb = both[:, :ka], both[:, ka + 64:]                 # strided views, as the fused x projection hands them
+    wa = (torch.rand(ka, generator=g) + 0.5).to(torch.bfloat16)
+    wb = (torch.rand(kb, generator=g) + 0.5).to(torch.bfloat16)
+    oa, ob = rmsnorm.rms_pair(xa, wa, xb, wb, 1e-6, torch.bfloat16)
+    assert torch.equal(_bits(oa), _bits(rmsnorm.rms(xa, wa, 1e-6, torch.bfloat16)))
+    assert torch.equal(_bits(ob), _bits(rmsnorm.rms(xb, wb, 1e-6, torch.bfloat16)))
+    for r in range(R):
+        a1, b1 = rmsnorm.rms_pair(xa[r:r + 1], wa, xb[r:r + 1], wb, 1e-6, torch.bfloat16)
+        assert torch.equal(_bits(a1), _bits(oa[r:r + 1])) and torch.equal(_bits(b1), _bits(ob[r:r + 1]))
+
+
+def test_rms_pair_knob(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_RMS_PAIR", "0")
+    assert not rmsnorm.pair_enabled()
+    monkeypatch.setenv("TF_DSV41_RMS_PAIR", "1")
+    assert rmsnorm.pair_enabled()
+    with pytest.raises(ValueError):
+        rmsnorm.rms_pair(torch.zeros((2, 8), dtype=torch.bfloat16), torch.ones(8), torch.zeros((3, 8)), torch.ones(8),
+                         1e-6, torch.bfloat16)
+
+
+def test_partial_dtype(monkeypatch):
+    """``Forward.partial_dtype``: bf16 for a decode window's exchange (2 ranks, bf16 decode exchange, kit rounding),
+    else None (fp32), and never with TF_DSV41_PARTIAL_BF16=0."""
+
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import forward as F
+    from tensorfold.families.deepseek_v41.cuda import numerics as N
+
+    cls = next(v for v in vars(F).values() if isinstance(v, type) and hasattr(v, "partial_dtype"))
+    me = SimpleNamespace(world=2, decode_bf16=True, chunk=64)
+    monkeypatch.setattr(N, "KIT_ROUNDING", True)
+    assert cls.partial_dtype(me, 4) == torch.bfloat16 and cls.partial_dtype(me, 65) is None
+    assert cls.partial_dtype(SimpleNamespace(world=1, decode_bf16=True, chunk=64), 4) is None
+    assert cls.partial_dtype(SimpleNamespace(world=2, decode_bf16=False, chunk=64), 4) is None
+    monkeypatch.setenv("TF_DSV41_PARTIAL_BF16", "0")
+    assert cls.partial_dtype(me, 4) is None
+    monkeypatch.setenv("TF_DSV41_PARTIAL_BF16", "1")
+    monkeypatch.setattr(N, "KIT_ROUNDING", False)
+    assert cls.partial_dtype(me, 4) is None
+
+
+@pytest.mark.usefixtures("gpu_like")
+@pytest.mark.parametrize("R,d", [(1, 5120), (3, 1024), (2, 2048)])
+def test_engram_fuse_dec_bits(R, d):
+    from tensorfold.families.deepseek_v41.cuda import engram, engram_dec
+
+    g = torch.Generator().manual_seed(R + d)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    kv = (torch.randn((R, 5 * d), generator=g) * 0.5).to(torch.bfloat16)
+    kv[0, :d] = x[0, :d]
+    qk = engram.qk_weights(torch.rand((4, d), generator=g) + 0.5, torch.rand((4, d), generator=g) + 0.5)
+    keep = torch.ones(R)
+    keep[-1] = 0.0 if R > 1 else 1.0
+    a, b = x.clone(), x.clone()
+    ga, gb = torch.zeros((R, 4)), torch.zeros((R, 4))
+    engram.fuse(a, kv, qk, keep, ga)
+    engram_dec.fuse(b, kv, qk, keep, gb, eps=engram.EPS, clamp=engram.CLAMP)
+    assert torch.equal(_bits(ga), _bits(gb)) and torch.equal(_bits(a), _bits(b))
