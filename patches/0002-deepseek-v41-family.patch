+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The DSpark pass on the GPU (G7 decode, lever 5; collected only where PyTorch sees an NVIDIA GPU), on the synthetic
+DSpark checkpoint (``dsv41_dspark_fakes``) with the Triton CSA2 / DSpark kernels and upstream's EXL3:
+
+- drafted == serial with every draft head (``TF_DSV41_DRAFT_HEAD`` full / q4 / trim, trim with its fallback), with
+  the pass's CUDA graphs on (``draft_graphs.DraftGraphs``: boot warm-up + lazy keys), T = 0 and T > 0, 1 and 4 slots,
+  past 2,048 tokens of context;
+- draft graph replay == the eager pass, bit for bit (drafts, confidences, the rings' block rows), over slot sets,
+  positions, samplings and both variants of a trimmed head; a moved buffer drops the draft graphs;
+- the int4 GEMV == its dequantized product at the real head's shapes, and its ms beside the EXL3 head's at the same
+  rows (``[G7-draft]`` lines: 64,640 x 5,120 a rank, the trimmed 24,576 x 5,120).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_draft_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import draft_graphs as DG
+from tensorfold.families.deepseek_v41.cuda import draft_head as DH
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.lookup import noise_of
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+DEV = "cuda"
+LONG = 4096
+S1 = Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95)
+SAMPLINGS = [None, S1, None, Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(60 + i).integers(3, 250, size=n)]
+           for i, n in enumerate((2070, 300, 2101, 180))]
+N = 32
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "floor_gib": 0.0}
+HEADS = {"full": {}, "q4": {"TF_DSV41_DRAFT_HEAD": "q4"},
+         "trim": {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "off"},
+         "trimfb": {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "0.2,16"}}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41dg"))
+
+
+@pytest.fixture(scope="module")
+def vocab(tmp_path_factory):
+    f = tmp_path_factory.mktemp("dsv41dgv") / "rank.txt"
+    f.write_text(" ".join(map(str, list(range(1, 256, 2)) + list(range(0, 256, 2)))) + "\n")
+    return str(f)
+
+
+def _fw(ck, slots=1, dspark=True):
+    return DF.forward(ck, slots=slots, limit=LONG, dspark=dspark, device=DEV, chunk=128)
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        b = DF.batcher(ck, _fw(ck, dspark=False), capacity=LONG, pool_tokens=2 * LONG, depth=0)
+        return DF.run(b, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+def _env(monkeypatch, head, vocab):
+    for k, v in {**HEADS[head], "TF_DSV41_DRAFT_VOCAB": vocab}.items():
+        monkeypatch.setenv(k, v)
+
+
+def _graphs(fw):
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    n = fw.drafter.graphs.warmup()
+    assert n == 3 * len(fw.drafter.head.variants()) and fw.drafter.graphs.cache.on     # 1, 2, 4 padded slots
+    return fw.drafter.graphs
+
+
+@pytest.mark.parametrize("slots", [1, 4])
+@pytest.mark.parametrize("head", list(HEADS))
+def test_drafted_equals_serial_graphs(ck, serial, vocab, monkeypatch, head, slots):
+    _env(monkeypatch, head, vocab)
+    fw = _fw(ck, slots=slots)
+    g = _graphs(fw)
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(slots + 1) * LONG, lookup=True)
+    jobs = [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    assert DF.run(b, jobs) == serial
+    assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0
+    st = g.cache.stats
+    assert st["replays"] > 0 and st["failed"] == 0, st
+    print(f"[G7-draft] head {head} slots {slots}: {fw.drafter.describe()}; DSpark tokens a round "
+          f"{[j.stats['drafting'].get('dspark_tokens_per_round') for j in jobs]}")
+
+
+def _prefill(fw, slot, ids):
+    fw.reset(slot)
+    fw.prefill([Piece(slot, 0, tuple(ids))], mode="full")
+
+
+@pytest.mark.parametrize("head", ["full", "trimfb"])
+def test_draft_graph_replay_equals_eager(ck, vocab, monkeypatch, head):
+    """Two forwards fed the same prompts and passes: one replaying draft graphs, one eager."""
+
+    _env(monkeypatch, head, vocab)
+    g, e = _fw(ck, slots=4), _fw(ck, slots=4)
+    bg = DF.batcher(ck, g, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    be = DF.batcher(ck, e, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    graphs = _graphs(g)
+    for f, b in ((g, bg), (e, be)):
+        for s in range(4):
+            b.ex.slots[s].ensure(LONG)
+            _prefill(f, s, PROMPTS[s][:150 + 40 * s] if head == "full" or s % 2 else [1, 3, 5, 7] * 30)
+    rng = np.random.default_rng(3)
+    for step in range(10):
+        live = sorted(int(s) for s in rng.choice(4, size=int(rng.integers(1, 5)), replace=False))
+        if step % 3 == 0:
+            live = live[::-1]                           # the drafter sorts: the same key, the drafts back in order
+        anchors = [int(rng.integers(3, 250)) for _ in live]
+        starts = [g.slots[s].pos for s in live]
+        noises = [noise_of(SAMPLINGS[s]) if SAMPLINGS[s] else None for s in live]
+        dg, cg = g.drafter.propose(live, anchors, starts, noises)
+        de, ce = e.drafter.propose(live, anchors, starts, noises)
+        assert dg == de and cg == ce, (step, live)
+        for s in live:
+            for rg, re_ in zip(g.drafter.rings[s], e.drafter.rings[s]):
+                assert all(torch.equal(a, b) for a, b in zip(rg.kernel(), re_.kernel())), (step, s)
+        if step == 5 and head == "trimfb":
+            for f in (g, e):
+                f.drafter.observe(0, [2, 4, 6, 8, 10])  # slot 0's passes go full
+    st = graphs.cache.stats
+    assert st["replays"] > 0 and st["failed"] == 0, st          # G8: 1-4 slots are warm keys (no lazy capture)
+    assert {k[0] for k in graphs.cache.graphs} <= {1, 2, 4}
+    if head == "trimfb":
+        assert {k[2] for k in graphs.cache.graphs} == {"trim", "full"}
+
+
+def test_moved_buffer_drops_draft_graphs(ck, monkeypatch):
+    fw = _fw(ck, slots=1)
+    b = DF.batcher(ck, fw, capacity=LONG, pool_tokens=2 * LONG)
+    graphs = _graphs(fw)
+    b.ex.slots[0].ensure(LONG)
+    _prefill(fw, 0, PROMPTS[1])
+    p = fw.slots[0].pos
+    d1, _ = fw.drafter.propose([0], [5], [p])
+    real = graphs.fingerprint
+    monkeypatch.setattr(graphs, "fingerprint", lambda key: real(key) + (1,))
+    d2, _ = fw.drafter.propose([0], [5], [p])
+    assert d1 == d2 and graphs.cache.stats["dropped"] >= 1
+
+
+@pytest.mark.parametrize("rows", [1, 5, 20])
+def test_q4_gemv_real_shapes(rows):
+    """The 4-bit GEMV at the real head's shapes (random codes): equal to the dequantized product, and its ms."""
+
+    k, n, group = 5120, 64640, 128
+    g = torch.Generator(device=DEV).manual_seed(rows)
+    packed = torch.randint(0, 256, (n, k // 2), dtype=torch.uint8, device=DEV, generator=g)
+    scales = (torch.rand((n, k // group), device=DEV, generator=g) * 0.01 + 1e-3).to(torch.float16)
+    x = torch.randn((rows, k), device=DEV, generator=g).to(torch.bfloat16)
+    got = DH.q4_matmul(x, packed, scales, group)
+    sub = slice(0, 4096)
+    want = x.float() @ DH.dequant(packed[sub], scales[sub], group).t()
+    assert torch.allclose(got[:, sub], want, rtol=1e-3, atol=1e-2)
+    out = torch.empty_like(got)
+    for m, label in ((n, "q4 64,640"), (24576, "trim 24,576")):
+        p, s = packed[:m].contiguous(), scales[:m].contiguous()
+        o = out[:, :m].contiguous()
+        for _ in range(3):
+            DH.q4_matmul(x, p, s, group, out=o)
+        torch.cuda.synchronize()
+        t0, t1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        t0.record()
+        for _ in range(20):
+            DH.q4_matmul(x, p, s, group, out=o)
+        t1.record()
+        torch.cuda.synchronize()
+        ms = t0.elapsed_time(t1) / 20
+        mb = (p.numel() + 2 * s.numel()) / 1e6
+        print(f"[G7-draft] q4 GEMV {label} x 5,120, {rows} rows: {ms:.3f} ms ({mb / ms:.0f} GB/s, {mb:.1f} MB)")
