+# -- the narrow kernel and the folded tail (TF_DSV41_RG_NARROW / TF_DSV41_RG_TAIL) ------------------------------------
+def _narrow_src() -> str:
+    src = CU.read_text()
+    return src[src.index("__global__ void __launch_bounds__(NW * 32) narrow_kernel"):src.index("cudaError_t launch_narrow")]
+
+
+def test_narrow_kernel_runs_the_same_chains():
+    """narrow_kernel's arithmetic is gemv_kernel's chain (read from the .cu): lane l pairs gate vector j * 32 + l with
+    x at k = (j * 32 + l) * 8, j ascending over all NV steps, i = 0..7 ascending, one __fmaf_rn chain from 0.0 a row,
+    then the same butterfly; so its logits are model_logits' bits (tests/cuda checks it on the GPU)."""
+
+    src = _narrow_src()
+    assert "acc[r] = __fmaf_rn(xf[i], wf[i], acc[r]);" in src
+    assert "for (int r = 0; r < RT; ++r) acc[r] = 0.0f;" in src
+    assert "for (int o = 16; o > 0; o >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xffffffffu, v, o));" in src
+    assert "for (int j = 0; j < NV; ++j) {" in src and "for (int i = 0; i < 8; ++i)" in src
+    assert "a.w + (size_t)(live ? e : 0) * D + (size_t)lane * 8" in src and "wrow + (size_t)j * 256" in src
+    assert "(size_t)(j * 32 + lane) * 8" in src                     # x: the same k as the gate vector
+    assert "widen8(wsh[warp][j % PD][lane], wf);" in src            # gate vector j from its slot
+    assert "if (lane == r && r < nr && live) a.lg[(size_t)(r0 + r) * a.E + e] = v;" in src
+    order = RG.lane_order()
+    for j in range(RG.NV):
+        for lane in (0, 5, 31):
+            v = j * 32 + lane                                        # the vector both loads address
+            assert order[lane, 8 * j] == 8 * v and (j * 32 + lane) * 8 == 8 * v
+
