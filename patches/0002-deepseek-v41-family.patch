+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused router (TF_DSV41_ROUTER=fused) on the GPU at the real geometry (D 5,120; E 384 top-6 and E 128 top-3),
+window G6 (collected only where PyTorch sees an NVIDIA GPU):
+
+- a row alone == the row in windows of R = 1..16 at tile offsets 0 / 7 / N - R, picks and weights bit for bit;
+- rows above a chunk (4,100) == the same rows in 16-row windows;
+- CUDA graphs: replays == eager bits, the device counters back to 0 after each replay, new inputs == eager; the same
+  when the first call ever is captured (the per-call counter buffer);
+- fused == split picks and float64's on random rows, logits at least as close to float64 as split's;
+- route_check (TF_DSV41_ROUTER_CHECK's recorder) counts agreement and writes its report.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_router_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import router  # noqa: E402
+
+DEV = "cuda"
+D = 5120
+
+
+def _inputs(R, E, seed):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * 0.02).to(torch.bfloat16).contiguous()
+    b = torch.randn(E, generator=g) * 0.01
+    return x.to(DEV), w.to(DEV), b.to(DEV)
+
+
+def _bits(p, w):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_rows_invariant_r1_to_16(E, topk):
+    x, w, b = _inputs(40, E, E)
+    alone = [_bits(*router.route(x[r:r + 1].contiguous(), w, b, topk=topk, mode="fused")) for r in range(40)]
+    for R in range(1, 17):
+        for off in sorted({0, 7, 40 - R}):
+            p, wt = _bits(*router.route(x[off:off + R].contiguous(), w, b, topk=topk, mode="fused"))
+            for i in range(R):
+                assert torch.equal(p[i], alone[off + i][0][0]) and torch.equal(wt[i], alone[off + i][1][0]), (R, off, i)
+
+
+def test_chunks_equal_windows():
+    x, w, b = _inputs(4100, 384, 3)
+    whole = _bits(*router.route(x, w, b, mode="fused"))
+    parts = [_bits(*router.route(x[a:a + 16].contiguous(), w, b, mode="fused")) for a in range(0, 4100, 16)]
+    assert torch.equal(whole[0], torch.cat([p for p, _ in parts]))
+    assert torch.equal(whole[1], torch.cat([q for _, q in parts]))
+
+
+@pytest.mark.parametrize("first_is_capture", [False, True])
+def test_graph_replays_and_counters(first_is_capture):
+    x, w, b = _inputs(16, 384, 5)
+    if first_is_capture:
+        router._COUNTERS.clear()
+    pick = torch.empty((16, 7), dtype=torch.int32, device=DEV)
+    wts = torch.empty((16, 7), dtype=torch.float32, device=DEV)
+    if not first_is_capture:
+        st = torch.cuda.Stream()
+        st.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(st):
+            router.route(x, w, b, pick=pick, wts=wts, mode="fused")
+        torch.cuda.current_stream().wait_stream(st)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        router.route(x, w, b, pick=pick, wts=wts, mode="fused")
+    want = _bits(*router.route(x, w, b, mode="fused"))
+    cnt = router._counters(x.device)
+    for _ in range(2):
+        g.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(pick, want[0]) and torch.equal(wts.view(torch.int32), want[1])
+        assert int(cnt.abs().sum()) == 0
+    x.copy_(_inputs(16, 384, 6)[0])
+    g.replay()
+    torch.cuda.synchronize()
+    want = _bits(*router.route(x, w, b, mode="fused"))
+    assert torch.equal(pick, want[0]) and torch.equal(wts.view(torch.int32), want[1])
+
+
+def test_fused_agrees_with_split_and_float64():
+    x, w, b = _inputs(512, 384, 9)
+    pf, wf = router.route(x, w, b, mode="fused")
+    ps, ws = router.route(x, w, b, mode="split")
+    rp, _ = router.reference(x[:64].cpu(), w.cpu(), b.cpu())
+    agree = float((pf == ps).all(1).float().mean())
+    print(f"[G6] fused vs split picks agree on {agree:.4f} of 512 random rows")
+    assert agree >= 0.99
+    assert torch.equal(pf[:64, :6].cpu(), rp)
+    exact = x.double() @ w.double().T
+    assert float((router.logits(x, w, "fused").double() - exact).abs().max()) <= float(
+        (router.logits(x, w, "split").double() - exact).abs().max())
+
+
+def test_route_check_records(tmp_path, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import router_check
+
+    monkeypatch.setattr(router_check, "PATH", str(tmp_path / "rc.json"))
+    monkeypatch.setattr(router, "_CHECK", True)
+    router_check._STATE.update(calls=0, by_e={}, samples=[], seen=set())
+    x, w, b = _inputs(64, 384, 12)
+    router.route(x, w, b, mode="fused")
+    router_check.dump()
+    import json
+
+    rep = json.loads((tmp_path / "rc.json").read_text())
+    assert rep["by_e"]["384"]["rows"] == 64 and rep["by_e"]["384"]["agree_order"] >= 0.95
+    assert (tmp_path / "rc.json.samples.pt").exists()
