+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused attention projections (``fused_proj``, ``x3seg.cu``; TF_DSV41_FUSED_PROJ) without a GPU:
+
+- the tables: every real attention group (x: wq_a + wkv [+ compressor], qr: wq_b + indexer wq_b, wo_a's 4 groups)
+  is one launch with each projection's own upstream plan; programs, xh / Z / counter slices tile their scratch;
+- bits: ``dsv41_x3seg_emu`` runs the segment-table launch over this module's own tables and upstream's launches one
+  projection at a time; every output element is equal bit for bit (any program order, 1-128 rows, split-K and
+  single-split segments, 4- and 8-warp plans in one launch, two widths, several outputs a buffer), every element is
+  written once and every counter is back to zero; on the real pack's layer 1 (wq_a + wkv, wo_a) when its tensors
+  are cached (``TF_DSV41_PACK_CACHE``: a local cache directory of the 2.9 bpw pack's headers);
+- the wiring: ``blocks.attention`` with stand-in groups (the CPU twin's linears behind ``Groups``) == unfused.
+
+Run: python -m pytest -q tests/test_dsv41_fused_proj_emu.py
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from itertools import pairwise
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_x3seg_emu as E  # noqa: E402
+
+from tensorfold.cuda.exl3.linear import plan  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP  # noqa: E402
+
+# (K, N, bits) of a rank's attention projections in the real pack (tests/family/test_real_pack.py's headers)
+WQ_A, WKV, COMP, WQ_B, IX_WQ_B, WO_A, WO_B = ((5120, 1280), (5120, 512), (5120, 512), (1280, 16384), (1280, 4096),
+                                             (4096, 1024), (4096, 5120))
+
+
+def seg(k: int, n: int, k2: int = 10, out: int = 0, col: int = 0) -> FP.Seg:
+    sk, wk = plan(k, n)
+    return FP.Seg(k, n, k2, sk, wk, out, col)
+
+
+def check_tiling(lay: FP.Layout, segs: list) -> None:
+    m = lay.m
+    spans = sorted((lay.xh_off[i], lay.xh_off[i] + m * s.k) for i, s in enumerate(segs))
+    assert spans[0][0] == 0 and spans[-1][1] == lay.xh_total and all(a[1] == b[0] for a, b in pairwise(spans))
+    z = sorted((lay.z_off[i], lay.z_off[i] + s.sk * m * s.n) for i, s in enumerate(segs) if s.sk > 1)
+    assert all(a[1] <= b[0] for a, b in pairwise(z)) and (not z or z[-1][1] == lay.z_total)
+    c = sorted((lay.c_off[i], lay.c_off[i] + 8 * (s.n // 128)) for i, s in enumerate(segs))
+    assert all(a[1] == b[0] for a, b in pairwise(c)) and c[-1][1] == lay.c_total
+    seen = []
+    for k2, wk, part, meta, programs in lay.launches:
+        assert len(part) <= FP.MAXSEG and wk == max(segs[i].wk for i in part)
+        p = 0
+        for j, i in enumerate(part):
+            row = meta[11 * j:11 * j + 11]
+            s = segs[i]
+            assert row[:4] == (s.k, s.n, s.sk, s.wk) and row[10] == p and row[9] == s.col and s.k2 == k2
+            assert (row[4], row[5]) == (32 * k2, (s.k // 16) * 32 * k2)       # upstream's strips strides
+            p += s.programs
+        assert p == programs
+        seen += part
+    assert sorted(seen) == list(range(len(segs)))
+
+
+@pytest.mark.parametrize("m", [1, 2, 3, 5, 8, 16, 17, 64, 128])
+def test_real_groups_are_one_launch_each(m):
+    x4 = [seg(*WQ_A, out=0), seg(*WKV, out=1), seg(*COMP, out=2), seg(*COMP, out=2, col=512)]
+    q = [seg(*WQ_B, out=0), seg(*IX_WQ_B, out=1)]
+    o = [seg(*WO_A, out=0, col=1024 * g) for g in range(4)]
+    l0 = [seg(*WQ_A, k2=12, out=0), seg(*WKV, k2=12, out=1)]               # layer 0: 6-bit wq_a / wkv
+    for segs, wk in ((x4, 4), (q, 8), (o, 4), (l0, 4)):
+        lay = FP.layout(segs, m)
+        assert len(lay.launches) == 1 and lay.launches[0][1] == wk
+        check_tiling(lay, segs)
+    assert [(s.sk, s.wk) for s in q] == [(1, 8), (2, 4)]                    # the qr launch mixes 8- and 4-warp plans
+
+
+def test_layout_refuses_bad_plans_and_rows():
+    with pytest.raises(ValueError):
+        FP.layout([FP.Seg(5120, 1280, 10, 8, 4)], 0)
+    with pytest.raises(ValueError):
+        FP.layout([FP.Seg(5120, 1280, 10, 3, 4)], 1)                        # K / 16 not split evenly
+    with pytest.raises(ValueError):
+        FP.layout([FP.Seg(5120, 1000, 10, 1, 4)], 1)
+
+
+def test_more_than_eight_segments_split_launches():
+    segs = [FP.Seg(256, 128, 10, 1, 4, 0, 128 * i) for i in range(11)] + [FP.Seg(256, 128, 8, 1, 4, 1)]
+    lay = FP.layout(segs, 4)
+    assert [len(x[2]) for x in lay.launches] == [8, 3, 1] and [x[0] for x in lay.launches] == [10, 10, 8]
+    check_tiling(lay, segs)
+
+
+def _rand(rng, shape, scale=1.0, dtype=np.float16):
+    return (rng.standard_normal(shape) * scale).astype(dtype)
+
+
+def _case(rng, segs, m, shared_x: bool):
+    """Random inputs / W_q / scales for ``segs``; inputs shared by every segment of the same K when ``shared_x``."""
+
+    xs, by_k = [], {}
+    for s in segs:
+        if shared_x and s.k in by_k:
+            xs.append(by_k[s.k])
+            continue
+        x = _rand(rng, (m, s.k), 2.0).astype(np.float32)
+        by_k[s.k] = x
+        xs.append(x)
+    suh = [np.where(rng.random(s.k) < 0.5, -1.0, 1.0).astype(np.float16) for s in segs]
+    W = [_rand(rng, (s.k, s.n), 0.5).astype(np.float64) for s in segs]
+    svh = [(_rand(rng, (s.n,), 0.02) + np.float16(0.03)).astype(np.float32) for s in segs]
+    return xs, suh, W, svh
+
+
+def _compare(segs, xs, suh, W, svh, m, seeds=(0, 1, 2)):
+    widths: dict[int, int] = {}
+    for s in segs:
+        widths[s.out] = max(widths.get(s.out, 0), s.col + s.n)
+    lay = FP.layout(segs, m)
+    check_tiling(lay, segs)
+    want = [np.full((m, widths[b]), np.nan, dtype=np.float32) for b in sorted(widths)]
+    for i, s in enumerate(segs):
+        want[s.out][:, s.col:s.col + s.n] = E.upstream(xs[i], suh[i], W[i], svh[i], s.sk, s.wk, seed=i)
+    for seed in seeds:
+        got, mem = E.segmented(xs, suh, W, svh, segs, lay, [widths[b] for b in sorted(widths)], seed=seed)
+        for g, w in zip(got, want):
+            assert np.array_equal(g.view(np.uint32), w.view(np.uint32))
+        assert all((c == 1).all() for c in mem.writes) and not mem.counters.any()
+    return want
+
+
+@pytest.mark.parametrize("m", [1, 3, 16, 17, 40])
+def test_segments_equal_upstream_launches_bitwise(m):
+    rng = np.random.default_rng(100 + m)
+    segs = [FP.Seg(256, 256, 10, 2, 4, 0, 0),           # split-K
+            FP.Seg(512, 384, 10, 1, 8, 1, 0),           # 8 warps, one split
+            FP.Seg(256, 128, 10, 4, 4, 2, 0),           # 4 splits, 2 per_warp
+            FP.Seg(256, 128, 10, 1, 4, 2, 128),         # same buffer, next to it
+            FP.Seg(512, 256, 8, 2, 8, 3, 0)]            # another width: its own launch
+    xs, suh, W, svh = _case(rng, segs, m, shared_x=True)
+    _compare(segs, xs, suh, W, svh, m)
+
+
+def test_float64_sanity_of_the_emulator():
+    rng = np.random.default_rng(7)
+    s = FP.Seg(512, 256, 10, 2, 4)
+    xs, suh, W, svh = _case(rng, [s], 3, shared_x=False)
+    y = E.upstream(xs[0], suh[0], W[0], svh[0], s.sk, s.wk)
+    from tensorfold.cuda.exl3 import format as fmt
+
+    H = fmt.hadamard() / np.sqrt(128.0)
+    xr = (xs[0].astype(np.float64) * suh[0]).reshape(3, -1, 128) @ H
+    ref = (xr.reshape(3, -1) @ W[0]).reshape(3, -1, 128) @ H * svh[0].reshape(-1, 128).astype(np.float64)
+    ref = ref.reshape(3, -1)
+    assert np.abs(y - ref).max() / np.abs(ref).max() < 3e-3
+
+
+# -- the real pack's layer 1, when cached --------------------------------------------------------------------------
+def _pack() -> Path | None:
+    p = os.environ.get("TF_DSV41_PACK_CACHE", "").strip()
+    return Path(p) if p and (Path(p) / "headers.json").is_file() else None
+
+
+def _tensor(root: Path, wm: dict, info: dict, name: str) -> np.ndarray:
+    key = hashlib.sha1(f"{wm[name]}:{name}".encode()).hexdigest()[:16]
+    dt, shape = info[name]
+    raw = (root / "tensors" / f"{key}.bin").read_bytes()
+    return np.frombuffer(raw, dtype={"I16": np.int16, "F16": np.float16}[dt]).reshape(shape)
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached layer-1 tensors")
+@pytest.mark.parametrize("group", ["x", "wo_a"])
+def test_real_layer1_bitwise(group):
+    from tensorfold.cuda.exl3 import format as fmt
+
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: (e["dtype"], tuple(e["shape"])) for v in m["headers"].values() for n, e in v["header"].items()
+            if n != "__metadata__"}
+    names = ["wq_a", "wkv"] if group == "x" else [f"wo_a.slice.{g}" for g in range(4)]
+    segs, suh, W, svh = [], [], [], []
+    col = 0
+    for i, nm in enumerate(names):
+        p = f"layers.1.attn.{nm}"
+        tr = _tensor(root, wm, info, f"{p}.trellis")
+        bits = fmt.bits_of(tr.shape)
+        k, n = 16 * tr.shape[0], 16 * tr.shape[1]
+        out = i if group == "x" else 0
+        segs.append(seg(k, n, k2=int(2 * bits), out=out, col=0 if group == "x" else col))
+        col += n
+        W.append(fmt.unpack(tr, bits, "mul1").astype(np.float64))
+        suh.append(_tensor(root, wm, info, f"{p}.suh"))
+        svh.append(_tensor(root, wm, info, f"{p}.svh").astype(np.float32))
+    rng = np.random.default_rng(1)
+    for rows in (1, 3):
+        if group == "x":
+            x = (rng.standard_normal((rows, 5120)) * 0.7).astype(np.float32)
+            xs = [x, x]
+        else:
+            o = (rng.standard_normal((rows, 4 * 4096)) * 0.3).astype(np.float32)
+            xs = [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]       # column slices of o, as blocks passes
+        _compare(segs, xs, suh, W, svh, rows, seeds=(0,))
+
+
+# -- TF_DSV41_PROJ_PLAN=long: other bits than upstream, the same structure -----------------------------------------
+def _long(k: int, n: int, group: str, k2: int = 10, out: int = 0, col: int = 0) -> FP.Seg:
+    sk, wk = FP.PLANS["long"][group]
+    return FP.Seg(k, n, k2, sk, wk, out, col)
+
+
+def test_long_plan_is_valid_on_every_real_shape():
+    groups = {"x": [WQ_A, WKV, COMP], "q": [WQ_B, IX_WQ_B], "o": [WO_A], "wob": [WO_B]}
+    for g, shapes in groups.items():
+        sk, wk = FP.PLANS["long"][g]
+        for k, n in shapes:
+            assert (k // 16) % (sk * wk) == 0 and (k // 16) // (sk * wk) >= 20, (g, k, n)
+    x4 = [_long(*WQ_A, "x", out=0), _long(*WKV, "x", out=1), _long(*COMP, "x", out=2),
+          _long(*COMP, "x", out=2, col=512)]
+    for m in (1, 16, 128):
+        lay = FP.layout(x4, m)
+        assert len(lay.launches) == 1 and lay.launches[0][4] == 4 * (10 + 4 + 4 + 4)
+        check_tiling(lay, x4)
+
+
+@pytest.mark.parametrize("plans", [((2, 4), (1, 8), (4, 4)), ((1, 4), (1, 4), (2, 4))])
+def test_row_invariance_any_plan(plans):
+    """A row alone == the same row in a 17-row launch, bit for bit, whatever the segments' plans."""
+
+    rng = np.random.default_rng(31)
+    segs = [FP.Seg(512, 256, 10, *plans[0], 0, 0), FP.Seg(512, 384, 10, *plans[1], 1, 0),
+            FP.Seg(512, 128, 10, *plans[2], 1, 384)]
+    xs, suh, W, svh = _case(rng, segs, 17, shared_x=True)
+    whole = _compare(segs, xs, suh, W, svh, 17, seeds=(0,))
+    for r in (0, 7, 16):
+        alone = _compare(segs, [x[r:r + 1] for x in xs], suh, W, svh, 1, seeds=(1,))
+        for a, w in zip(alone, whole):
+            assert np.array_equal(a.view(np.uint32), w[r:r + 1].view(np.uint32))
+
+
+def test_long_and_upstream_plans_differ_by_rounding_only():
+    rng = np.random.default_rng(32)
+    up, lo = FP.Seg(1024, 256, 10, 8, 4), FP.Seg(1024, 256, 10, 1, 4)
+    xs, suh, W, svh = _case(rng, [up], 5, shared_x=False)
+    a = E.upstream(xs[0], suh[0], W[0], svh[0], up.sk, up.wk)
+    b = E.upstream(xs[0], suh[0], W[0], svh[0], lo.sk, lo.wk)
+    assert not np.array_equal(a, b)                         # another summation order: other bits
+    assert np.abs(a - b).max() <= 1e-5 * np.abs(a).max()    # ... at fp32 rounding
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached layer-1 tensors")
+def test_real_layer1_long_plan_row_invariant():
+    from tensorfold.cuda.exl3 import format as fmt
+
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: (e["dtype"], tuple(e["shape"])) for v in m["headers"].values() for n, e in v["header"].items()
+            if n != "__metadata__"}
+    segs, suh, W, svh = [], [], [], []
+    for i, nm in enumerate(["wq_a", "wkv"]):
+        p = f"layers.1.attn.{nm}"
+        tr = _tensor(root, wm, info, f"{p}.trellis")
+        bits = fmt.bits_of(tr.shape)
+        segs.append(_long(16 * tr.shape[0], 16 * tr.shape[1], "x", k2=int(2 * bits), out=i))
+        W.append(fmt.unpack(tr, bits, "mul1").astype(np.float64))
+        suh.append(_tensor(root, wm, info, f"{p}.suh"))
+        svh.append(_tensor(root, wm, info, f"{p}.svh").astype(np.float32))
+    x = (np.random.default_rng(2).standard_normal((3, 5120)) * 0.7).astype(np.float32)
+    whole = _compare(segs, [x, x], suh, W, svh, 3, seeds=(0,))
+    alone = _compare(segs, [x[1:2], x[1:2]], suh, W, svh, 1, seeds=(0,))
+    assert all(np.array_equal(a.view(np.uint32), w[1:2].view(np.uint32)) for a, w in zip(alone, whole))
