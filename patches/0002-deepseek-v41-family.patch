+++ b/tests/test_dsv41_engram_pcache.py
@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram's projected-row cache (``engram_pcache``, ``TF_DSV41_ENGRAM_PCACHE``) on the CPU:
+
+- the LRU's plans: a window of hits skips (padded rows read row 0's slot), a miss's first occurrence writes, hits are
+  promoted before evictions, the least recent key is evicted, ``forget`` frees the slots;
+- ``PCache.project`` over a stream of windows (keys from a small pool: hits, partial hits, evictions) == the linear
+  without the cache, bit for bit, with a fake linear that honours the skip word;
+- the gated forward (CPU twin, ``wkv`` through a skip-honouring wrapper of the float64 twin) with the cache == the
+  synchronous path without the gate, bit for bit, replaying the same windows (whole windows hit and skip); a failed
+  read forgets the rows its window stored, so the same windows run again give the right bits.
+
+Hit rates (not tested here; CPU replays through the real hasher and tokenizer, LRU over every window's rows):
+kit greedy replies (8 x 256) rows 36%; repo .py files as a token stream rows 8 / 11 / 16 / 20% and 4-row windows
+3 / 5 / 7 / 9% at 256 / 1K / 4K / 16K rows; docs prose rows 5 / 7 / 11 / 14%, 2-row windows 3 / 4 / 6 / 9%.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+from tensorfold.families.deepseek_v41.cuda import engram_pcache as EP
+
+
+def _plan(lru, keys, rows=4):
+    out = np.zeros(1 + rows, dtype=np.int32)
+    new = lru.plan(keys, out)
+    return out, new
+
+
+def test_lru_plans():
+    lru = EP.Lru(8)
+    out, new = _plan(lru, [b"a", b"b", b"a"])
+    assert out[0] == 0 and new == [b"a", b"b"] and out[3] == -1 and out[1] != out[2] and out[4] == -1
+    sa, sb = out[1], out[2]
+    out, new = _plan(lru, [b"b", b"a"])
+    assert out[0] == 1 and new == [] and list(out[1:]) == [sb, sa, sb, sb]          # pads read row 0's slot
+    out, new = _plan(lru, [b"a", b"c"])
+    assert out[0] == 0 and out[1] == -1 and out[2] >= 0 and new == [b"c"]
+    for i in range(5):                                                               # fill: 8 keys
+        _plan(lru, [bytes([100 + i])])
+    assert len(lru.where) == 8 and not lru.free
+    _plan(lru, [b"a"])                                                              # a hit: promoted
+    out, new = _plan(lru, [b"z"])                                                    # evicts the oldest: b
+    assert b"b" not in lru.where and b"a" in lru.where and out[1] == sb
+    lru.forget([b"z", b"nope"])
+    assert b"z" not in lru.where and lru.free == [sb]
+    with pytest.raises(ValueError):
+        _plan(EP.Lru(4), [b"a"], rows=4)                                             # cap < 2 x rows
+
+
+class FakeLin:
+    """Row-wise y = bf16(x @ W) unless the skip word is set (then ``out`` is left alone, like the EXL3 kernel)."""
+
+    def __init__(self, k, n, seed=0):
+        g = torch.Generator().manual_seed(seed)
+        self.w = torch.randn((k, n), generator=g, dtype=torch.float64)
+        self.n = n
+        self.calls = self.skipped = 0
+
+    def __call__(self, x, out, skip):
+        self.calls += 1
+        if int(skip[0]):
+            self.skipped += 1
+            return out
+        out.copy_((x.double() @ self.w).to(out.dtype))
+        return out
+
+
+def _row(key: bytes, k: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(int.from_bytes(key, "little"))
+    return torch.randn(k, generator=g).to(torch.bfloat16)
+
+
+def test_project_bits_equal_uncached():
+    k, n, rows = 32, 48, 4
+    lin = FakeLin(k, n)
+    pc = EP.PCache([1, 14], {1: lin, 14: FakeLin(k, n, 1)}, n, rows, 9, "cpu")
+    assert pc.cap == 9
+    rng = np.random.default_rng(0)
+    pool = [bytes([i, 7]) for i in range(14)]
+    for step in range(200):
+        m = int(rng.integers(1, rows + 1))
+        keys = [pool[int(j)] for j in rng.integers(0, len(pool) if step % 3 else 4, size=m)]
+        new = pc.plan({1: keys, 14: keys})
+        x = torch.stack([_row(key, k) for key in keys])
+        for pos, L in enumerate((1, 14)):
+            got = pc.project(pos, x, torch.bfloat16)
+            want = (x.double() @ pc.lins[L].w).to(torch.bfloat16)
+            assert torch.equal(got.view(torch.int16), want.view(torch.int16)), (step, keys)
+        if step == 50:
+            pc.forget(new)                       # forgotten rows come back as misses, recomputed
+    assert lin.skipped > 10 and lin.skipped < lin.calls
+    assert pc.stats["skipped"] > 0 and pc.stats["hits"] > 0 and "pcache" in pc.describe()
+
+
+def test_apply_kernel_interpreted(monkeypatch):
+    """``_apply`` (Triton, interpreted): a miss stores its row's bits, a skip reads the slots' bits."""
+
+    pytest.importorskip("triton")
+    import triton
+
+    monkeypatch.setenv("TRITON_INTERPRET", "1")
+    kern = EP._triton_apply()
+    n, m = 3000, 3
+    kv, store = torch.randn(m, n).to(torch.bfloat16), torch.randn(8, n).to(torch.bfloat16)
+
+    def run(plan):
+        a, p = kv.view(torch.int16), store.view(torch.int16)
+        kern[(m, triton.cdiv(n, EP.BLOCK))](a, a.stride(0), p, p.stride(0), torch.tensor(plan, dtype=torch.int32), n,
+                                             BLOCK=EP.BLOCK)
+
+    kv0 = kv.clone()
+    run([0, 5, -1, 2, -1])
+    assert torch.equal(store[5], kv0[0]) and torch.equal(store[2], kv0[2])
+    s0 = store.clone()
+    run([1, 1, 5, 2, 1])
+    assert torch.equal(kv, s0[[1, 5, 2]]) and torch.equal(store, s0)
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.delenv(EP.KNOB, raising=False)
+    assert EP.rows_knob() == 0 and EP.make(None, [1], 4) is None
+
+
+# -- the gated forward (needs the native reader) -------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pcache"))
+
+
+@pytest.fixture(scope="module")
+def packed(ck, tmp_path_factory):
+    import dsv41_fakes as FK
+
+    root = tmp_path_factory.mktemp("pcache-shards")
+    FK.write_engram(root, ck[1], ck[2], 1)
+    return root
+
+
+class TwinSkip:
+    """The CPU twin's ``wkv`` (float64 sums) with the EXL3 kernel's skip word."""
+
+    def __init__(self, inner):
+        self.inner, self.n = inner, inner.n
+        self.skipped = 0
+
+    def __call__(self, x, out, skip):
+        if int(skip[0]):
+            self.skipped += 1
+            return out
+        return out.copy_(self.inner(x, out.dtype))
+
+
+def _fw(ck, packed, monkeypatch, gate: bool, pcache: int = 0):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import engram_native as EN
+
+    if not EN.available():
+        pytest.skip("no C compiler for the native reader")
+    monkeypatch.setenv("TF_DSV41_ENGRAM_GATE", "1" if gate else "0")
+    monkeypatch.setenv(EP.KNOB, str(pcache))
+    monkeypatch.setattr(EP, "_exl3", lambda wkv: TwinSkip(getattr(wkv, "inner", wkv)))
+    rows = EH.open_shards(packed, 0, 1, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    fw = DF.forward(ck, slots=1, prefetch=True, rows=rows)
+    assert (fw.gate is not None) == gate and (not gate or (fw.gate.pc is not None) == (pcache > 0))
+    return fw
+
+
+PROMPT = [int(t) for t in np.random.default_rng(3).integers(3, 250, size=40)]
+WIDTHS = [1, 3, 6, 2, 5, 4, 1, 6]
+
+
+def _windows(fw, widths):
+    out, a = [], 0
+    for w in widths:
+        out.append(fw.step(PROMPT[a:a + w]).clone())
+        if fw.gate is not None:
+            fw.gate.check()
+        a += w
+    return out
+
+
+def test_gated_forward_with_pcache_equals_sync(ck, packed, monkeypatch):
+    ref = _windows(_fw(ck, packed, monkeypatch, False), WIDTHS)
+    fw = _fw(ck, packed, monkeypatch, True, pcache=256)
+    for rep in range(3):                          # the same windows again: every row hits, every matmul skips
+        fw.reset(0)
+        got = _windows(fw, WIDTHS)
+        assert all(torch.equal(a, b) for a, b in zip(got, ref)), rep
+    st, nl = fw.gate.pc.stats, len(fw.gate.layers)
+    assert st["skipped"] >= 2 * nl * len(WIDTHS) and st["windows"] == 3 * nl * len(WIDTHS)
+    assert sum(lin.skipped for lin in fw.gate.pc.lins.values()) == st["skipped"]
+    fw.gate.close()
+
+
+def test_failed_read_forgets_the_stored_rows(ck, packed, monkeypatch):
+    fw = _fw(ck, packed, monkeypatch, True, pcache=256)
+    real, calls = fw.gate.reader, []
+
+    def broken(parts):
+        calls.append(1)
+        if len(calls) == 2:
+            raise OSError(5, "injected")
+        return real(parts)
+
+    fw.gate.reader = broken
+    fw.step(PROMPT[:3])
+    fw.gate.check()
+    with pytest.raises(RuntimeError, match="Engram gate"):
+        fw.step(PROMPT[3:5])
+        fw.gate.check()
+    fw.reset(0)
+    ref = _windows(_fw(ck, packed, monkeypatch, False), [3, 2])
+    assert all(torch.equal(a, b) for a, b in zip(_windows(fw, [3, 2]), ref))
+    assert fw.gate.pc.stats["forgotten"] > 0
