+    assert d.choose_joint([0], [low], [5], firsts=[17], alone=False) == [1]     # the caller says shared
+    assert d.choose_joint([0], [low], [5], others=[1], firsts=[17]) == [1]  # a plain row shares it: verified
+    assert d.choose_joint([0, 1], [low, low], [5, 5], firsts=[17, 17]) == [1, 1]
+    assert d.choose_joint([0, 1], [low, [0.9] * 5], [5, 0], firsts=[17, 17]) == [1, 0]     # most 0: nothing
