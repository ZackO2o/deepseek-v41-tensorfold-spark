+    s = X.scratch(layer, 16)
+    ext = x3._ext()
+    lens = [5, 4]
+    R = 9
+    pick, wts, lg, bias = _window(lens, 5, E=64, spread=2.0)
+    pick[:, K] = ex.count - 1                                           # the shared entry of this block (64)
+    cfg = BU.Cfg(1, "sub")
+    meta = BU.meta_spans(_spans(lens), R, "cpu")
+    pb, wb = BU.apply(*_dev(pick, wts, lg), bias.to(DEV), meta.to(DEV), K, cfg, ex.count)
+    sets = BU.allowed_sets(pick, wts, meta, K, 1, cfg.ratio)
+    allowed = set().union(*(a | set(x) for a, x in sets.values())) | {ex.count - 1}
+    ids, members = s.window(R)
