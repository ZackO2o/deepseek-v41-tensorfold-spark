+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Parent-conditioned trees (TF_DSV41_TREE_PC=1) and the drafting log with hidden rows (TF_DSV41_DRAFT_LOG_HID=1) on
+the GPU (collected only where PyTorch sees an NVIDIA GPU): the synthetic DSpark checkpoint, Triton kernels, row
+graphs and DSpark pass graphs (the log's copies are captured into the pass graph):
+
+- replies through the batcher == serial with oracle children at depth 1 and 2 (``test_dsv41_pctree_e2e.Oracle``),
+  4 slots and 1 slot, T = 0 and T > 0, past 2,048 tokens of context;
+- the log: every pass has its candidates, base logits and hidden [N, D] (graph replays write them), and its serial
+  continuation is the reply's;
+- ``[G10-draft]`` lines: the tree's counters.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_pctree_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+from test_dsv41_pctree_e2e import Oracle  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import draft_graphs as DG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import draftsim as DS  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.depth import Costs  # noqa: E402
+
+DEV = "cuda"
+LONG = 4096
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(190 + i).integers(3, 250, size=2030 + 60 * i)] for i in range(4)]
+N = 24
+SETTINGS = {"on": True, "budget_s": 300.0, "max_graphs": 128, "bucket": 2048, "slots": 4, "warm": "decode",
+            "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pctreegpu"))
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        mp.setenv("TF_DSV41_TREE", "0")
+        bs = DF.batcher(ck, DF.forward(ck, slots=1, limit=LONG, dspark=False, device=DEV, chunk=128),
+                        capacity=LONG, pool_tokens=2 * LONG, depth=0)
+        return DF.run(bs, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+def _replies(ck, monkeypatch, tmp_path, slots, ix, serial):
+    monkeypatch.setenv("TF_DSV41_TREE", "3")
+    monkeypatch.setenv("TF_DSV41_TREE_PC", "1")
+    monkeypatch.setenv("TF_DSV41_TREE_DEPTHS", "2")
+    monkeypatch.setenv("TF_DSV41_DRAFT_LOG", str(tmp_path))
+    monkeypatch.setenv("TF_DSV41_DRAFT_LOG_HID", "1")
+    fw = DF.forward(ck, slots=slots, limit=LONG, device=DEV, chunk=128)
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(slots + 2) * LONG)
+    fw.graphs = RG.make(fw, settings=SETTINGS)
+    fw.graphs.warmup(slots, lambda s, end: b.ex.slots[s].ensure(end))
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    fw.drafter.graphs.warmup()
+    for s in b.ex.slots:
+        s.release()
+    c = Costs([10.0] * 16, 1.0)
+    fw.set_costs(c)
+    b.planner.costs = c
+    orc = Oracle([PROMPTS[i] + serial[i] for i in ix], [PROMPTS[i] for i in ix])
+    fw.tree._exp = orc
+    t0 = time.perf_counter()
+    got = DF.run(b, [Job(PROMPTS[i], N, SAMPLINGS[i]) for i in ix])
+    assert got == [serial[i] for i in ix]
+    st = fw.tree.stats
+    assert st["trees"] > 0 and st["sib_wins"] > 0 and orc.depth2 > 0
+    assert fw.graphs.cache.stats["replays"] > 0 and fw.drafter.graphs.cache.stats["replays"] > 0
+    fw.dlog.flush()
+    passes = DS.load(str(tmp_path))
+    D = fw.cfg.hidden_size
+    seqs = [PROMPTS[i] + serial[i] for i in ix]
+    for p in passes:
+        assert p.cand is not None and p.hid is not None and np.asarray(p.hid).shape == (len(p.drafts), D)
+        s = next(q for q in seqs if len(q) > p.start + len(p.serial) and q[p.start] == p.pending)
+        assert p.serial == s[p.start + 1:p.start + 1 + len(p.serial)]
+    print(f"[G10-draft] pctree replies == serial, {slots} slot(s), {time.perf_counter() - t0:.1f} s, "
+          f"{len(passes)} passes logged: {fw.tree.describe()}")
+
+
+def test_pctree_replies_equal_serial_four_slots(ck, serial, monkeypatch, tmp_path):
+    _replies(ck, monkeypatch, tmp_path, 4, [0, 1, 2, 3], serial)
+
+
+def test_pctree_replies_equal_serial_one_slot(ck, serial, monkeypatch, tmp_path):
+    _replies(ck, monkeypatch, tmp_path, 1, [1, 2], serial)
