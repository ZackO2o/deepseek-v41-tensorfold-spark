+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The native Engram reader (``engram_native``) and the prefetcher's bulk reads for prompt segments: the records are
+the shard's bytes, the same as the Python reader's, for any order, duplicates, both ends of the shard, merged and
+unmerged extents; the vectorized extent plan is ``engram_host.extents``; the forward's rows through a bulk prefetch
+equal the shard's rows."""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import engram_native as EN  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF  # noqa: E402
+
+LO, N = 1000, 40_000
+
+if not EN.available():
+    pytest.skip("no C compiler for the native reader", allow_module_level=True)
+
+
+@pytest.fixture(scope="module")
+def shard(tmp_path_factory):
+    rows = np.random.default_rng(3).integers(0, 256, size=(N, EH.ROW_BYTES), dtype=np.uint8)
+    path = tmp_path_factory.mktemp("eng") / "engram-l1-r0of2.bin"
+    EH.write_shard(path, 1, LO, rows, LO + N + 7)
+    return path, rows
+
+
+def index(seed: int, n: int) -> torch.Tensor:
+    rng = np.random.default_rng(seed)
+    idx = np.concatenate([rng.integers(LO, LO + N, size=n), [LO, LO + N - 1, LO + 1, LO + N - 1]])
+    return torch.from_numpy(idx)
+
+
+@pytest.mark.parametrize("n", [5, 3000, 20000])
+def test_native_records_are_the_files_bytes(shard, n):
+    path, rows = shard
+    src = EH.ShardRows(path)
+    idx = index(n, n)
+    got = EN.records(src, idx)
+    assert np.array_equal(got, rows[idx.numpy() - LO])
+    py = EH.ShardRows(path)
+    old = EH.NATIVE_ROWS
+    EH.NATIVE_ROWS = 1 << 40
+    try:
+        assert np.array_equal(py.raw(idx), got)
+    finally:
+        EH.NATIVE_ROWS = old
+
+
+def test_plan_is_the_python_extents(shard):
+    path, _ = shard
+    h = EH.read_header(path)
+    want = np.unique(index(9, 6000).numpy())
+    off, length, dst, total, at = EN.plan(want, h.lo, h.row_bytes, EH.HEADER, 4096)
+    ext = EH.extents(want, h.lo, h.row_bytes, 4096)
+    assert [(int(a), int(b)) for a, b in zip(off, length)] == [(a, b) for a, b, _ in ext]
+    assert all(d % EN.ALIGN == 0 for d in dst) and total >= int(length.sum())
+    assert at.size == want.size
+
+
+def test_threads_and_one_thread_agree(shard, monkeypatch):
+    path, rows = shard
+    idx = index(4, 9000)
+    monkeypatch.setenv("TF_DSV41_ENGRAM_THREADS", "1")
+    one = EN.records(EH.ShardRows(path), idx)
+    monkeypatch.setenv("TF_DSV41_ENGRAM_THREADS", "64")
+    assert np.array_equal(EN.records(EH.ShardRows(path), idx), one)
+
+
+def test_bulk_prefetch_rows(shard):
+    path, _ = shard
+    src = EH.ShardRows(path)
+    pf = PF.Prefetcher({1: src}, workers=2, cache=0)
+    idx = index(11, PF.BULK_ROWS + 10)
+    pf._issue_index(1, idx)
+    assert len(pf.bulk) == 1
+    got = pf.rows(1, idx)
+    assert not pf.bulk and pf.stats["hits"] == 1
+    bits = (lambda t: t.view(torch.int32))         # random bytes hold e4m3 NaNs: compare the bits
+    assert torch.equal(bits(got), bits(EH.ShardRows(path).rows(idx)))
+    again = pf.rows(1, idx)                         # not issued: read now, same values
+    assert torch.equal(bits(again), bits(got)) and pf.stats["misses"] == 1
+    pf.close()
