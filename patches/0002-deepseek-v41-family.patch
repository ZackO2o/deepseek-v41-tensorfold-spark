@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dynamic routed-expert pruning (prune.py, G9 section ``prune``) on the GPU (collected only where PyTorch sees an
+NVIDIA GPU):
+
+- the compiled kernel == the torch reference bit for bit (drop and dup modes, target and DSpark geometries), a row
+  alone == the row in windows of 1..64 rows, CUDA graph replays == eager;
+- on a random EXL3 block (upstream's grouped kernels, x3ld on and off): ``group`` never lists a dropped pair or an
+  expert nobody keeps (``ucount`` falls), and ``experts.routed`` with the pruned (pick, wts) == the same window where
+  the dropped slots point at a kept expert with weight 0 (dup), and == each row alone (row invariance end to end);
+- the router -> prune -> kit weights sequence of ``moe.GpuMoE`` on real-shaped router inputs keeps the shared slot.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_prune_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prune as PR  # noqa: E402
+
+DEV = "cuda"
+RULES = [PR.Rule(topp=0.9, min_k=3), PR.Rule(min_w=0.1, min_k=4, renorm="kept"),
+         PR.Rule(min_w=0.05, topp=0.85, min_k=3), PR.Rule(topp=0.85, min_k=3, renorm="kept")]
+
+
+def _rows(R, seed, K=6, E=384):
+    g = torch.Generator().manual_seed(seed)
+    ids = torch.stack([torch.randperm(E, generator=g)[:K] for _ in range(R)]).to(torch.int32)
+    s = torch.rand((R, K), generator=g) ** 3 + 1e-3
+    w = (1.5 * (s / s.sum(-1, keepdim=True))).to(torch.float32)
+    pick = torch.cat([ids, torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous()
+    return pick, torch.cat([w, torch.ones((R, 1))], 1).contiguous()
+
+
+def _bits(p, w):
+    return p.clone().cpu(), w.view(torch.int32).clone().cpu()
+
+
+@pytest.mark.parametrize("rule", RULES)
+@pytest.mark.parametrize("dup", [False, True])
+@pytest.mark.parametrize("K,E", [(6, 384), (3, 128)])
+def test_kernel_equals_reference(rule, dup, K, E):
+    pick, wts = _rows(300, 1, K, E)
+    rule = PR.Rule(rule.min_w, rule.topp, min(rule.min_k, K - 1), rule.renorm)
+    want = _bits(*PR.reference(pick, wts, K, rule, 1.5, E + 1, dup))
+    p, w = pick.to(DEV), wts.to(DEV)
+    PR.apply(p, w, K, rule, 1.5, E + 1, dup)
+    got = _bits(p, w)
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+
+
+def test_row_invariance_and_graphs():
+    pick, wts = _rows(80, 2)
+    rule = RULES[2]
+    alone = []
+    for r in range(80):
+        p, w = pick[r:r + 1].to(DEV), wts[r:r + 1].to(DEV)
+        PR.apply(p, w, 6, rule, 1.5, 385)
+        alone.append(_bits(p, w))
+    for R, off in ((2, 0), (16, 3), (17, 40), (64, 16)):
+        p, w = pick[off:off + R].to(DEV), wts[off:off + R].to(DEV)
+        PR.apply(p, w, 6, rule, 1.5, 385)
+        b = _bits(p, w)
+        for i in range(R):
+            assert torch.equal(b[0][i], alone[off + i][0][0]) and torch.equal(b[1][i], alone[off + i][1][0])
+    # a captured graph: replays on new inputs == eager
+    p, w = pick[:16].to(DEV), wts[:16].to(DEV)
+    src_p, src_w = p.clone(), w.clone()
+    PR.apply(p.clone(), w.clone(), 6, rule, 1.5, 385)                   # warm (compile) outside the capture
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        PR.apply(p, w, 6, rule, 1.5, 385)
+    for off in (0, 30, 64):
+        p.copy_(pick[off:off + 16].to(DEV))
+        w.copy_(wts[off:off + 16].to(DEV))
+        graph.replay()
+        torch.cuda.synchronize()
+        b = _bits(p, w)
+        for i in range(16):
+            assert torch.equal(b[0][i], alone[off + i][0][0]) and torch.equal(b[1][i], alone[off + i][1][0])
+    del src_p, src_w
+
+
+def _layer(seed):
+    from test_dsv41_gpu import _random_layer
+
+    return _random_layer(6, 10, experts=64, seed=seed)
+
+
+def _window(R, seed, E=64):
+    g = torch.Generator().manual_seed(seed)
+    ids = torch.stack([torch.randperm(E, generator=g)[:6] for _ in range(R)]).to(torch.int32)
+    s = torch.rand((R, 6), generator=g) ** 3 + 1e-3
+    w = (1.5 * (s / s.sum(-1, keepdim=True))).to(torch.float32)
+    pick = torch.cat([ids, torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous().to(DEV)
+    return pick, torch.cat([w, torch.ones((R, 1))], 1).contiguous().to(DEV)
+
+
+@pytest.mark.parametrize("ld", [False, True], ids=["upstream", "x3ld"])
+def test_routed_skips_dropped_pairs(ld):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    layer = _layer(3)
+    ex = layer.ex
+    s = X.scratch(layer, 16)
+    ext = x3._ext()
+    R = 8
+    g = torch.Generator(device=DEV).manual_seed(4)
+    x = torch.randn((R, ex.dims), generator=g, device=DEV).to(torch.bfloat16)
+    pick, wts = _window(R, 5)
+    rule = PR.Rule(topp=0.7, min_k=2)
+    pd, wd = pick.clone(), wts.clone()
+    PR.apply(pd, wd, 6, rule, 1.5, ex.count)
+    pu, wu = pick.clone(), wts.clone()
+    PR.apply(pu, wu, 6, rule, 1.5, ex.count, dup=True)
+    assert torch.equal(wd, wu)
+    ids, members = s.window(R)
+    ext.group(pick, ids, s.count, members, R, 7, ex.count)
+    full = int(s.count[0])
+    ext.group(pd, ids, s.count, members, R, 7, ex.count)
+    n = int(s.count[0])
+    kept = {int(v) for v in pd[:, :6].reshape(-1).tolist() if v < ex.count}
+    assert set(ids[:n].tolist()) == kept | {64} and n < full                # no read of a dropped-only expert
+    code = members[:n].reshape(-1)
+    code = code[code >= 0]
+    assert bool((pd.reshape(-1)[(code // 32) * 7 + code % 32] < ex.count).all())
+    saved = dict(loads.CFG)
+    try:
+        loads.CFG.update(on=ld)
+        s.y.fill_(1e30)                                                 # stale y: finite, huge
+        out_d = X.routed(x, pd, wd.to(torch.float16).float(), layer, s, None, R)
+        out_u = X.routed(x, pu, wu.to(torch.float16).float(), layer, s, None, R)
+        torch.cuda.synchronize()
+        assert torch.equal(out_d, out_u)
+        for r in (0, 5):                                                # each row alone
+            alone = X.routed(x[r:r + 1], pd[r:r + 1], wd[r:r + 1].to(torch.float16).float(), layer, s, None, 1)
+            assert torch.equal(alone[0], out_d[r])
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+
+
+def test_gpu_moe_sequence(monkeypatch):
+    """``moe.GpuMoE``'s router -> prune -> kit weights on a random block: the shared slot stays, rows keep >= min_k,
+    and the knob off gives the router's picks."""
+
+    from tensorfold.families.deepseek_v41.cuda import moe as M
+
+    layer = _layer(6)
+    g = torch.Generator(device=DEV).manual_seed(7)
+    gate = (torch.randn((64, X.DIMS), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    bias = torch.zeros(64, device=DEV)
+    m = M.GpuMoE(gate, bias, layer, 6, 1.5, 10.0)
+    m.ensure()                                                          # a DSpark-sized scratch (64 experts)
+    x = torch.randn((12, X.DIMS), generator=g, device=DEV).to(torch.bfloat16)
+    monkeypatch.setattr(X, "EXPERTS", 64)                              # this 64-expert block is the target
+    monkeypatch.setattr(PR, "CFG", PR.parse({"TF_DSV41_EXPERT_TOPP": "0.8", "TF_DSV41_EXPERT_MIN_K": "3"}))
+    out_p = m(x)
+    pp = m.last_pick.clone()
+    monkeypatch.setattr(PR, "CFG", PR.parse({}))
+    out_f = m(x)
+    pf = m.last_pick.clone()
+    assert torch.equal(pp[:, 6], pf[:, 6]) and bool((PR.kept(pp, 6, layer.ex.count) >= 3).all())
+    assert bool((pp[:, :6] == layer.ex.count).any()) and not bool((pf[:, :6] == layer.ex.count).any())
+    rel = float((out_p - out_f).norm() / out_f.norm())
+    print(f"\nprune topp 0.8 on a random block: kept {PR.kept(pp, 6, layer.ex.count).float().mean():.2f} a row, "
+          f"relative output change {rel:.3f}")
+    assert torch.isfinite(out_p).all()
