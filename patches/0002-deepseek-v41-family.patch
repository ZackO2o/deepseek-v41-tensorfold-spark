index 0000000..12b6c9a
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/nucleus.py
@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Top-p sampling without top-k (``top_k = 0``) from a few hundred candidates a row, with the same tokens as
+``exact_sampling.choose_rows`` over the whole vocabulary.
+
+Why: with ``top_k = 0`` the batcher asked every verify row of the round for all 129,280 candidates (``Plan.count`` =
+vocab): a [R, 129,280] top-k on each rank, ~1 MB a row through the exchange and the D2H copy, then numpy lexsorts
+over the full width on the host, once in ``candidates`` and again per window in ``choose_rows``. G3's T = 0.7 code
+ran at 15.4 tok/s against 41.9 at T = 0, and one T = 0.7 stream made every round of the 4-stream bench pay it for
+every slot's rows (16 tok/s aggregate).
+
+How: a nucleus row (``spec``: T > 0, top_k 0, 0 < top_p < 1) is sent ``count`` = ``TF_DSV41_NUCLEUS`` (512)
+candidates like any other row, plus each rank's (max m_r, sum_r exp(v / T - m_r / T)) in float64 over its whole
+vocabulary half (one more small exchange). From those, every rank computes the full vocabulary's normalizer Z and,
+over the sorted candidates, ``choose_rows``' own rule: probs = exp(scaled - max) / Z, keep = #(cumsum < top_p) + 1,
+then min_p. The row's tokens past ``keep`` never matter to ``choose_rows`` (they are masked to -inf), so sampling
+from the kept prefix with the keyed Gumbel noise gives its token, provided:
+
+- the kept prefix is the full vocabulary's sorted prefix: keep < count and the last kept value is strictly above
+  the merged candidates' last (then every token at least that large is among them, whatever the ranks' cut ties);
+- the keep count does not depend on how Z was summed: no cumsum within ``GUARD`` (1e-9) of top_p (Z differs from
+  numpy's pairwise sum by ~1e-15 relative).
+
+A row failing either (a flat distribution, a grammar mask, a guard hit) falls back to the full row, exchanged for
+that row alone (the old path). Both ranks decide alike: the decision reads only gathered data and the plan.
+Rank 0 samples (``choose``); the result is ``choose_rows``' token, so drafted == serial and batched == alone hold as
+before, and replies are unchanged token for token.
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Sequence
+
+import numpy as np
+
+ENV = "TF_DSV41_NUCLEUS"
+DEFAULT = 512
+GUARD = 1e-9
+
+
+def candidates() -> int:
+    """TF_DSV41_NUCLEUS: candidates a nucleus row (default 512; 0 = off: such rows ask for the whole vocabulary)."""
+
+    v = int(os.environ.get(ENV, "") or DEFAULT)
+    if v < 0:
+        raise ValueError(f"{ENV}={v}: expected >= 0")
+    return v
+
+
+def spec(sampling) -> list:
+    """``WindowSpec.nucleus``: [T, top_p, min_p] for top-p sampling without top-k, else []."""
+
+    if sampling is None or float(sampling.temperature) <= 0.0 or int(sampling.top_k):
+        return []
+    if not 0.0 < float(sampling.top_p) < 1.0:
+        return []
+    return [float(sampling.temperature), float(sampling.top_p), float(sampling.min_p)]
+
+
+def row_stats(logits, temps):
+    """float64 [R, 2]: this rank's (max, sum exp(v / T - max / T)) a row; ``temps`` float64 [R] (> 0)."""
+
+    import torch
+
+    v = logits.to(torch.float64)
+    m = v.max(dim=1).values
+    t = temps.to(device=v.device, dtype=torch.float64)
+    s = torch.exp(v / t[:, None] - (m / t)[:, None]).sum(dim=1)
+    return torch.stack([m, s], 1)
+
+
+def normalizer(stats: np.ndarray, temp: float) -> tuple[float, float]:
+    """(max, Z) of a row from every rank's (m_r, s_r): Z = sum_r s_r exp(m_r / T - max / T)."""
+
+    m = float(stats[:, 0].max())
+    t = max(float(temp), 1e-6)
+    z = float(sum(float(s) * np.exp(float(mr) / t - m / t) for mr, s in stats))
+    return m, z
+
+
+def keep_count(values: np.ndarray, ids: np.ndarray, sp: Sequence[float], z_max: float, z: float) -> int | None:
+    """Tokens ``choose_rows`` may sample in a row (top_p, then min_p) from its sorted candidates, or None when the
+    candidates cannot decide it (fall back to the full row). ``values`` / ``ids``: the row's candidates."""
+
+    temp, top_p, min_p = float(sp[0]), float(sp[1]), float(sp[2])
+    order = np.lexsort((ids, -values))
+    vals = values[order]
+    n = vals.size
+    if n < 2 or not np.isfinite(vals[0]) or not np.isfinite(z) or z <= 0.0:
+        return None
+    if float(vals[0]) != float(z_max):
+        return None                                     # the candidates' best is not the row's max
+    t = max(temp, 1e-6)
+    scaled = vals.astype(np.float64) / t
+    cum = np.cumsum(np.exp(scaled - scaled[0]) / z)
+    if np.any(np.abs(cum - top_p) <= GUARD):
+        return None
+    keep = int((cum < top_p).sum()) + 1
+    if keep >= n or not vals[keep - 1] > vals[n - 1]:
+        return None
+    if min_p > 0.0:
+        keep = min(keep, int((scaled >= scaled[0] + np.log(min_p)).sum()))
+    return max(1, keep)
+
+
+def choose(values: np.ndarray, ids: np.ndarray, positions: Sequence[int], s, info: dict) -> list[int]:
+    """Rank 0: a window's tokens. ``info[r]``: ("keep", n) -> the keyed draw over the row's first n sorted
+    candidates; ("full", ids, values) -> ``choose_rows`` over the whole row (the fallback)."""
+
+    from tensorfold.engine.exact_sampling import choose_rows, uniform_rows
+
+    out = []
+    t = max(float(s.temperature), 1e-6)
+    for r in range(values.shape[0]):
+        kind = info[r]
+        if kind[0] == "full":
+            out += choose_rows(kind[2][None, :], kind[1][None, :], [positions[r]], s)
+            continue
+        n = int(kind[1])
+        order = np.lexsort((ids[r], -values[r]))[:n]
+        rid, scaled = ids[r][order], values[r][order].astype(np.float64) / t
+        score = scaled - np.log(-np.log(uniform_rows(s.seed, np.asarray([positions[r]]), rid[None, :])[0]))
+        out.append(int(rid[int(np.argmax(score))]))
+    return out
+
+
+def finish(fw, logits, cand, sizes: Sequence[int], specs: Sequence, masks=None):
+    """Both ranks, after ``fw.candidates``: each nucleus row's keep count, or its full row (one more exchange for
+    those rows only); returns ``cand`` with ``nucleus`` = {row: info} for every row of a nucleus window."""
+
+    import torch
+
+    from .protocol import Candidates
+
+    rows, temps, masked = [], [], set()
+    a = 0
+    for i, (n, sp) in enumerate(zip(sizes, specs)):
+        if sp:
+            rows += list(range(a, a + n))
+            temps += [float(sp[0])] * n
+            if masks is not None and masks[i] is not None:
+                masked.update(range(a, a + n))
+        a += n
+    if not rows:
+        return cand
+    idx = torch.tensor(rows, dtype=torch.long, device=logits.device)
+    st = row_stats(logits.index_select(0, idx), torch.tensor(temps, dtype=torch.float64))
+    st = fw.gather_cols(st.contiguous()) if fw.world > 1 else st
+    stats = st.cpu().numpy().reshape(len(rows), fw.world, 2)
+    spec_of = {}
+    a = 0
+    for n, sp in zip(sizes, specs):
+        for r in range(a, a + n):
+            if sp:
+                spec_of[r] = sp
+        a += n
+    info: dict[int, tuple] = {}
+    full: list[int] = []
+    for j, r in enumerate(rows):
+        k = None
+        if r not in masked:
+            zm, z = normalizer(stats[j], spec_of[r][0])
+            k = keep_count(cand.values[r], cand.ids[r], spec_of[r], zm, z)
+        if k is None:
+            full.append(r)
+        else:
+            info[r] = ("keep", k)
+    if full:
+        sub_masks = None
+        if masked:
+            sub_masks = []
+            starts = np.cumsum([0, *sizes])
+            for r in full:
+                w = int(np.searchsorted(starts, r, side="right")) - 1
+                m = masks[w] if masks is not None else None
+                sub_masks.append(None if m is None else m[r - starts[w]:r - starts[w] + 1])
+            if all(m is None for m in sub_masks):
+                sub_masks = None
+        sel = logits.index_select(0, torch.tensor(full, dtype=torch.long, device=logits.device))
+        got = fw.candidates(sel, [1] * len(full), fw.vocab, sub_masks)
+        for j, r in enumerate(full):
+            info[r] = ("full", got.ids[j], got.values[j])
+    return Candidates(cand.ids, cand.values, info)
+
+
+__all__ = ["DEFAULT", "ENV", "GUARD", "candidates", "choose", "finish", "keep_count", "normalizer", "row_stats",
+           "spec"]
