+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""M2's host-side policies, without a model (families/deepseek_v41/cuda: depth.py, lookup.py, graphs.py, calib.py):
+
+- cost-derived DSpark depth from the confidence head: confident drafts verify deeper, the first draft always in a
+  shared window, none in a lone one when q_1 does not pay the second row (zero depth; the unverified first draft
+  calibrates against the bonus token), the correction factor learns from commits, ``static`` is the kit's fixed k,
+  the cap and ``most`` bound it;
+- the pass skip: a lone request whose DSpark rounds reliably lose to serial ones skips the pass, probes every
+  ``SKIP_PROBE`` + 1 rounds and returns when a probe pays; never for prose-like streams, shared windows or off;
+- the lookup planner: long suffix matches draft (deep windows up to 15 drafts), short ones in prose do not until a
+  band's evidence says so, a long band skipped 8 times is probed, EOS cuts drafts, no draft past ``max_tokens``,
+  DSpark rounds carry a depth cap; the keyed draft noise survives the plan's encoding (rank 1 rebuilds Sampling);
+- CUDA graph keys (mix x context bucket), the warm-up order and its 15 s budget (ranks agree), lazy capture on first
+  use, the cap, and the fallback when a capture fails on either rank;
+- calibration: the fitted window line, the cache keyed by image / knobs / shape, the shared integer table.
+"""
+
+from __future__ import annotations
+
+import itertools
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import calib, depth, graphs, lookup
+from tensorfold.families.deepseek_v41.cuda.plan import Plan, WindowSpec
+
+
+# -- depth ---------------------------------------------------------------------------------------------------------
+def test_depth_follows_the_confidence_head():
+    d = depth.Depth(depth.default_costs(), block=5, mode="cost", cap=5)
+    assert d.choose(0, [0.99] * 5, 5) == 5
+    assert d.choose(1, [0.05] * 5, 5) == 1                      # the pass ran: its first draft is verified
+    mid = d.choose(2, [0.95, 0.9, 0.3, 0.2, 0.1], 5)
+    assert 1 <= mid <= 3
+    assert d.choose(3, [0.99] * 5, 2) == 2                      # the plan's depth bounds it
+    assert d.choose(4, [0.99] * 5, 0) == 0
+    s = depth.Depth(depth.default_costs(), block=5, mode="static", cap=3)
+    assert s.choose(0, [0.01] * 5, 5) == 3 and s.choose(0, [0.9] * 5, 2) == 2
+
+
+def test_depth_calibration_and_rate_learn_from_commits():
+    d = depth.Depth(depth.default_costs(), block=5, mode="cost", cap=5)
+    before = d.cal.factor(0)
+    for _ in range(40):                                         # the head says 0.5, every draft is kept
+        k = d.choose(0, [0.5] * 5, 5)
+        d.record(0, k + 1, k + 1)
+    assert d.cal.factor(0) > before and d.choose(0, [0.5] * 5, 5) >= 3
+    r0 = d.rate(0)
+    d.record(0, 1, 1)
+    assert d.rate(0) < r0                                       # a serial round lowers the running rate
+    d.reset(0)
+    assert d.rate(0) == pytest.approx(2.0 / (d.costs.window_ms(2) + d.costs.draft))
+    d2 = depth.Depth(depth.default_costs(), block=5, mode="cost", cap=5)
+    e0 = d2.expected(0, [0.9] * 5, 5)
+    for _ in range(40):                                         # the head says 0.9, nothing is ever kept
+        k = d2.choose(1, [0.9] * 5, 5)
+        d2.record(1, k + 1, 1)
+    assert d2.cal.factor(0) < 0.5 and d2.expected(1, [0.9] * 5, 5) < e0
+
+
+def test_zero_depth_for_a_lone_window_and_its_counterfactual():
+    c = depth.Costs([35.5, 43.5, 47.6, 51.6, 55.7, 59.7], 4.7)          # G4's measured table (+8 ms for row 2)
+    d = depth.Depth(c, block=5, mode="cost", cap=5, skip=True)
+    low = [0.08, 0.3, 0.3, 0.3, 0.3]
+    assert d.choose(0, low, 5) == 1                                  # in a shared window the first draft is verified
+    assert d.choose(0, low, 5, alone=True) == 1                      # no first token: no counterfactual, verified
+    assert d.choose(0, low, 5, alone=True, first=17) == 0            # q_1 under lambda x 8 ms: a 1-row window
+    assert d.choose(1, [0.9] * 5, 5, alone=True, first=17) >= 2      # confident drafts still verify deep
+    f0, p0 = d.cal.kept[0], d.cal.prob[0]
+    d.record(0, 1, 1)
+    d.bonus(0, 17)                                                   # the serial token == the unverified draft
+    assert d.cal.kept[0] == f0 * depth.DECAY + 1.0 and d.cal.prob[0] == pytest.approx(p0 * depth.DECAY + 0.08)
+    assert d.stats.zero == 1 and d.stats.q1[0] == [1, 1]
+    d.bonus(0, 17)                                                   # once only
+    assert d.stats.zero == 1
+    assert d.choose(0, [0.02] + low[1:], 5, alone=True, first=17) == 0
+    d.record(0, 1, 1)
+    d.bonus(0, 18)                                                   # a different serial token: it was not kept
+    assert d.stats.q1[0] == [2, 1] and d.stats.zero == 2
+    assert d.rate(0) == pytest.approx(2 / (2 * (c.verify[0] + c.draft)))     # zero-depth rounds pay the pass
+    off = depth.Depth(c, block=5, mode="cost", cap=5, skip=False)
+    assert off.choose(0, low, 5, alone=True, first=17) == 1
+    st = depth.Depth(c, block=5, mode="static", cap=3, skip=True)
+    assert st.choose(0, low, 5, alone=True, first=17) == 3
+    d.stats.reset()
+    k = d.choose(2, [0.9, 0.9, 0.1, 0.1, 0.1], 5, alone=False)
+    d.record(2, k + 1, 2)
+    rep = d.stats.report()
+    assert rep["reached"][:2] == [1, 1] and rep["kept"][:2] == [1, 0] and rep["rounds"] == 1
+
+
+def test_costs_encode_and_env(monkeypatch):
+    c = depth.default_costs()
+    back = depth.Costs.decode(c.encode())
+    assert back.draft == pytest.approx(c.draft) and back.verify == pytest.approx(c.verify)
+    assert c.window_ms(1) == c.verify[0] and c.window_ms(99) == c.verify[-1]
+    monkeypatch.setenv("TF_DSV41_DEPTH", "static")
+    monkeypatch.delenv("TF_DSV41_DRAFT_DEPTH", raising=False)
+    assert depth.env_mode() == ("static", 3)
+    monkeypatch.setenv("TF_DSV41_DEPTH", "cost")
+    assert depth.env_mode() == ("cost", 5)
+    monkeypatch.setenv("TF_DSV41_DEPTH", "fast")
+    with pytest.raises(ValueError):
+        depth.env_mode()
+    monkeypatch.setenv("TF_DSV41_DEPTH", "cost")
+    monkeypatch.delenv("TF_DSV41_DRAFT_SKIP", raising=False)
+    assert depth.env_skip() is True
+    monkeypatch.setenv("TF_DSV41_DRAFT_SKIP", "0")
+    assert depth.env_skip() is False and depth.Depth(c, mode="cost").skip is False
+    assert lookup.Planner(c, dspark=True).skip is False
+    monkeypatch.setenv("TF_DSV41_DRAFT_SKIP", "maybe")
+    with pytest.raises(ValueError):
+        depth.env_skip()
+
+
+# -- lookup planner --------------------------------------------------------------------------------------------------
+def _planner(**kw):
+    kw.setdefault("dspark", True)
+    kw.setdefault("cap", 5)
+    return lookup.Planner(depth.default_costs(), lookup=True, min_match=4, max_rows=16, eos=(1,), **kw)
+
+
+def test_long_matches_draft_deep_windows():
+    span = list(range(10, 60))                                   # 50 tokens, then the same text again
+    p = _planner()
+    r = p.start(span + span[:40])
+    dep, drafts = p.window(r, left=100)
+    assert dep == 0 and r.kind == "l"                           # 15 drafts: a 16-row verify window, the copy
+    assert drafts == span[40:50] + span[:5]                      # of what followed the match (into the 2nd copy)
+    p.observe(r, 16, 15, span[40:56])
+    assert r.stats["lookup_kept"] == 15 and p.report(r)["tokens_per_round"] == 16.0
+    dep, drafts = p.window(r, left=3)                            # never past max_tokens
+    assert len(drafts) <= 2
+
+
+def test_short_matches_wait_for_evidence_and_probes():
+    p = _planner()
+    r = p.start([5, 6, 7, 8, 9, 2, 3, 4, 5, 6, 7, 8])           # a 4-token match: band 0 (prior 0.45)
+    dep, drafts = p.window(r, left=50)
+    assert drafts == [] and dep == 5 and r.kind == "d"           # DSpark instead, with its depth cap
+    p.observe(r, 3, 0, [11])
+    long = _planner()
+    span = list(range(100, 120))
+    r2 = long.start(span + [7] + span)                           # a 20-token match: band 2 (16+)
+    r2.acc[2], r2.tri[2] = 0.0, 50.0                             # the band's evidence: never kept
+    got = [long.window(r2, left=50)[1] for _ in range(8)]
+    assert all(g == [] for g in got[:7]) and got[7]              # skipped 7 times, probed the 8th
+
+
+def _measured():
+    return depth.Costs([35.5, 43.5, 47.6, 51.6, 55.7, 59.7], 4.7)
+
+
+def _rounds(p, r, n, rows, kept, others=None):
+    """``n`` rounds of the request: its window (rows, kept drafts) and, with ``others``, another request's."""
+
+    kinds = []
+    for _ in range(n):
+        dep, drafts = p.window(r, left=10 ** 6)
+        if others is not None:
+            p.window(others, left=10 ** 6)
+        kinds.append(r.kind)
+        if r.kind == "d":
+            p.observe(r, rows, kept, [0] * (kept + 1))
+        else:
+            p.observe(r, 1, 0, [0])
+        if others is not None:
+            p.observe(others, 2, 1, [0, 0])
+    return kinds
+
+
+def test_pass_skip_for_a_losing_stream_with_probes():
+    p = lookup.Planner(_measured(), dspark=True, cap=5, lookup=False, skip=True)
+    r = p.start([1, 2, 3])
+    kinds = _rounds(p, r, lookup.SKIP_MIN, 1, 0)                    # zero-depth rounds: the pass for nothing
+    assert kinds == ["d"] * lookup.SKIP_MIN and p.value(r)[0] == pytest.approx(-4.7 / 35.5)
+    kinds = _rounds(p, r, 2 * (lookup.SKIP_PROBE + 1), 1, 0)
+    assert kinds == (["s"] * lookup.SKIP_PROBE + ["d"]) * 2 and r.stats["skip_rounds"] == 2 * lookup.SKIP_PROBE
+    assert p.window(r, left=10 ** 6) == (0, [])                       # still skipping (no window observed yet)
+    p.observe(r, 1, 0, [0])
+    for _ in range(lookup.SKIP_PROBE - 1):                            # the rest of the skip run, then a probe
+        assert p.window(r, left=10 ** 6) == (0, [])
+        p.observe(r, 1, 0, [0])
+    assert p.window(r, left=10 ** 6)[0] == 5 and r.kind == "d"
+    p.observe(r, 4, 3, [0] * 4)                                       # the stream recovered: one probe brings it back
+    assert p.window(r, left=10 ** 6)[0] == 5 and r.kind == "d"
+
+
+def test_pass_skip_never_for_good_streams_shared_windows_or_off():
+    p = lookup.Planner(_measured(), dspark=True, cap=5, lookup=False, skip=True)
+    r = p.start([1, 2, 3])
+    pattern = [(2, 1), (3, 0), (1, 0), (2, 0), (3, 2), (1, 0), (2, 1), (2, 0)]   # G4 prose-like: ~1.6 a round
+    kinds = []
+    for i in range(80):
+        rows, kept = pattern[i % len(pattern)]
+        kinds += _rounds(p, r, 1, rows, kept)
+    assert set(kinds) == {"d"} and r.stats["skip_rounds"] == 0
+    shared = lookup.Planner(_measured(), dspark=True, cap=5, lookup=False, skip=True)
+    a, b = shared.start([1, 2, 3]), shared.start([4, 5, 6])
+    assert set(_rounds(shared, a, 40, 1, 0, others=b)) == {"d"}      # another window shares the verify
+    off = lookup.Planner(_measured(), dspark=True, cap=5, lookup=False, skip=False)
+    r = off.start([1, 2, 3])
+    assert set(_rounds(off, r, 40, 1, 0)) == {"d"}
+
+
+def test_eos_cut_serial_and_noise():
+    p = _planner(dspark=False)
+    r = p.start([3, 4, 5, 6, 1, 8, 3, 4, 5, 6])
+    dep, drafts = p.window(r, left=20)
+    assert dep == 0 and drafts == []                             # the copy starts with EOS: nothing to draft
+    assert p.window(r, left=1) == (0, []) and p.window(r, left=9, draft=False) == (0, [])
+    from tensorfold.engine.exact_sampling import Sampling
+
+    s = Sampling(seed=(1 << 63) + 5, temperature=0.7, top_k=20, top_p=0.9, min_p=0.05)
+    noise = lookup.noise_of(s)
+    plan = Plan(round=3, windows=[WindowSpec(0, 10, 7, 5, [], noise), WindowSpec(1, 4, 9, 0, [1, 2])])
+    back = Plan.decode(plan.encode())
+    s2 = lookup.sampling_of(back.windows[0].noise)
+    assert (s2.seed, s2.temperature, s2.top_k, s2.top_p, s2.min_p) == (s.seed, 0.7, 20, 0.9, 0.05)
+    assert back.windows[1].noise == [] and lookup.sampling_of([]) is None and lookup.noise_of(None) == []
+
+
+# -- graphs ------------------------------------------------------------------------------------------------------------
+def test_graph_keys():
+    assert graphs.make_key([(0, 100, 6)], 2048, 8192) == (((0, 6),), 0)
+    assert graphs.make_key([(2, 2040, 6), (0, 100, 3)], 2048, 8192) == (((2, 6), (0, 3)), 0)
+    assert graphs.make_key([(2, 2045, 6)], 2048, 8192) == (((2, 6),), 1)          # its rows end in bucket 1
+    assert graphs.make_key([(0, 0, 17)], 2048, 8192) is None                       # past 16 rows
+    assert graphs.make_key([(0, 0, 1), (0, 5, 1)], 2048, 8192) is None              # a slot twice
+    assert graphs.make_key([(i, 0, 1) for i in range(5)], 2048, 8192) is None       # past the captured slots
+    assert graphs.make_key([(0, 8190, 4)], 2048, 8192) is None                      # past the context
+    assert graphs.bucket_end(1, 2048, 8192) == 4095 and graphs.bucket_end(3, 2048, 7000) == 6999
+    keys = graphs.warmup_keys(4)
+    assert keys[:9] == [(((0, w),), 0) for w in (1, 2, 3, 4, 5, 6, 8, 12, 16)]
+    assert keys[9] == (((0, 6), (1, 6), (2, 6), (3, 6)), 0) and len(keys) == 15
+    assert len(graphs.warmup_keys(1)) == 9
+
+
+class _Clock:
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+
+def test_graph_warmup_budget_lazy_and_cap():
+    clock = _Clock()
+    taken = []
+
+    def capture(key):
+        clock.t += 4.0                                           # each capture takes 4 s
+        taken.append(key)
+        return {"key": key}
+
+    gc = graphs.GraphCache(capture, budget_s=15.0, max_graphs=6, clock=clock)
+    assert gc.warmup(graphs.warmup_keys(4)) == 4                  # 0, 4, 8, 12 s started; at 16 s: over budget
+    assert taken == graphs.warmup_keys(4)[:4] and gc.stats["warm_s"] == 16.0
+    k = gc.key([(0, 0, 8)], 8192)
+    assert gc.get(k) is None and gc.wants(k)
+    gc.lazy(k)
+    assert gc.get(k) == {"key": k} and gc.stats["lazy"] == 1 and gc.stats["replays"] == 1
+    gc.lazy(gc.key([(0, 0, 12)], 8192))
+    assert len(gc.graphs) == 6 and not gc.wants(gc.key([(0, 0, 16)], 8192))     # the cap
+    # the other rank is past the budget: both stop
+    gc2 = graphs.GraphCache(lambda key: key, budget_s=15.0, agree_any=lambda flag: True)
+    assert gc2.warmup(graphs.warmup_keys(1)) == 0
+
+
+def test_graph_capture_failure_turns_graphs_off():
+    def bad(key):
+        raise RuntimeError("operation not permitted when stream is capturing")
+
+    gc = graphs.GraphCache(bad)
+    k = gc.key([(0, 0, 2)], 4096)
+    gc.lazy(k)
+    assert not gc.on and gc.key([(0, 0, 2)], 4096) is None and gc.stats["failed"] == 1
+    # this rank captured, the other failed: both drop their graphs
+    ok = graphs.GraphCache(lambda key: key, agree_all=lambda mine: False)
+    assert ok.warmup(graphs.warmup_keys(1)) == 0 and not ok.on and not ok.graphs
+    off = graphs.GraphCache(lambda key: key, on=False)
+    assert off.key([(0, 0, 1)], 4096) is None and off.warmup(graphs.warmup_keys(1)) == 0
+
+
+def test_graph_env(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_GRAPHS", "0")
+    monkeypatch.setenv("TF_DSV41_GRAPH_BUDGET_S", "7.5")
+    st = graphs.env_settings()
+    assert st["on"] is False and st["budget_s"] == 7.5 and st["bucket"] == 2048 and st["max_graphs"] == 256
+
+
+# -- calibration -------------------------------------------------------------------------------------------------------
+def test_calibration_fit_and_cache(tmp_path, monkeypatch):
+    times = [40.0, 46.0, 50.5, 55.0, 61.0, 65.0, 70.5, 75.0, 79.0, 84.0, 88.0, 93.0, 97.0, 102.0, 107.0, 111.0]
+    t = calib.fit(times)
+    assert len(t) == 16 and t[0] == 40.0 and all(b >= a for a, b in itertools.pairwise(t))
+    assert t[7] == pytest.approx(75.0, abs=1.5) and t[15] == pytest.approx(111.0, abs=3.0)
+    monkeypatch.setenv("TF_DSV41_CALIB_DIR", str(tmp_path))
+    shape = {"slots": 4, "context": 65536, "world": 2, "gpu": "NVIDIA GB10", "dspark": True}
+    k = calib.cache_key("abc-2.9", shape)
+    assert calib.load(k) is None
+    c = depth.Costs(t, 5.5, "measured")
+    assert calib.save(k, c, {"shape": shape}).parent == tmp_path
+    got = calib.load(k)
+    assert got.verify == c.verify and got.draft == 5.5 and got.source == "cached"
+    assert calib.cache_key("abc-2.9", {**shape, "slots": 1}) != k
+    assert calib.cache_key("abd-2.9", shape) != k
+    assert calib.cache_key("abc-2.9", shape, {"TF_DSV41_GRAPHS": "0"}) != calib.cache_key("abc-2.9", shape, {})
+    monkeypatch.setenv("TF_DSV41_CALIB", "bogus")
+    with pytest.raises(ValueError):
+        calib.mode()
+
+
+class _Eng:
+    """Two ranks' ``_share`` / ``_gather_ints`` without a communicator (rank 0's list is what both get)."""
+
+    def __init__(self, rank, shared):
+        self.rank, self.shared, self.model_dir = rank, shared, None
+
+    def _share(self, values):
+        if self.rank == 0:
+            self.shared.append(list(values))
+            return list(values)
+        return self.shared.pop(0)
+
+    def _gather_ints(self, values):
+        return [list(values), list(values)]
+
+
+def test_costs_for_cached_is_shared(tmp_path, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_CALIB_DIR", str(tmp_path))
+    monkeypatch.setenv("TF_DSV41_CALIB", "cached")
+    shape = {"slots": 1}
+    c = depth.Costs([30.0 + 4 * r for r in range(16)], 4.0)
+    calib.save(calib.cache_key("img", shape), c, {})
+    q: list = []
+    r0 = calib.costs_for(None, _Eng(0, q), ensure=None, image="img", shape=shape, sync=None)
+    r1 = calib.costs_for(None, _Eng(1, q), ensure=None, image="img", shape=shape, sync=None)
+    assert r0.verify == r1.verify == pytest.approx(c.verify) and r0.source == "cached"
+    monkeypatch.setenv("TF_DSV41_CALIB", "default")
+    assert calib.costs_for(None, None, ensure=None, image="", shape={}, sync=None).source == "default"
