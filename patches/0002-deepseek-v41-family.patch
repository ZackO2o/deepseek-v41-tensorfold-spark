+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's CUDA engine on two ranks (one a DGX Spark), the GLM Spark engine's contract for one slot
+(M1: ``full`` prefill, serial decode, one request at a time).
+
+- ``generate(prompt, max_tokens, sampling, on_tokens, draft=True, stop_eos=True) -> stats`` on rank 0,
+  ``follow()`` on rank 1 (forever); ``eos``, ``limit``, ``request`` (a ``threading.local`` the app fills), ``batch``
+  (the serving layer's ``batch.Batcher``), ``grammar_host``, ``vision`` (None).
+- Serving (default; ``TF_DSV41_SERVING=0`` or ``serving=False`` for the one-slot path the M1 gates use): the forward
+  is ``slots.SlotsForward`` with ``--parallel`` slots on the KV pool, and ``stack.build`` makes the pool, the session
+  store (RAM + NVMe tiers), the grammar host and the batcher; rank 0's ``generate`` is
+  ``batch.generate_request``, rank 1's ``follow`` is ``batch.follow`` (round plans through the all-gather). At boot
+  both ranks keep only the NVMe entries both hold.
+- Rank agreement: rank 0 shares an int header (max tokens, stop_eos, the sampling settings as exact integers) and
+  the prompt (a length gather, then a value gather), rank 1 runs the same windows; after every token both ranks
+  trade a stop flag (the client may leave), so both stop at the same token.
+- Tokens: each rank's top candidates of its vocabulary half, one gather, then the same rule on both ranks:
+  greedy = the largest logit, ties to the lower id; T > 0 = ``exact_sampling.choose_rows`` (keyed by seed, absolute
+  position and token id), so a reply never depends on timing or on the rank.
+
+Start-up (``fastboot`` timeline): NCCL (``tensorfold.cuda.comm``; our GLM RoCE all-gather for the model's
+exchanges with the GLM deployment's ``GLM53_TF_COMM_BACKEND=roce``), the settings both ranks must share, the
+weights (prepared folder or checkpoint), the Engram shards, the forward, one warm-up window (Triton compiles), a
+barrier.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import struct
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+from . import fastboot
+from . import pick as P
+from .config import Config
+
+DEFAULT_CONTEXT = 65536
+MARGIN = 8
+
+
+def token_map_for(model_dir: Path, cfg: Config) -> tuple[list[int], str]:
+    """Engram's compressed-vocabulary map and an identity of its source: ``TF_DSV41_TOKEN_MAP`` (a JSON list) when
+    set, else built from tokenizer.json (a few seconds)."""
+
+    from .engram_host import token_map
+
+    path = os.environ.get("TF_DSV41_TOKEN_MAP", "").strip()
+    if path:
+        raw = Path(path).read_bytes()
+        lookup = json.loads(raw)
+        n = len(set(lookup))
+    else:
+        raw = (Path(model_dir) / "tokenizer.json").read_bytes()
+        lookup, n = token_map(Path(model_dir) / "tokenizer.json")
+    if n != cfg.engram_compressed_vocab_size:
+        raise ValueError(f"Engram's compressed vocabulary has {n} ids, the config {cfg.engram_compressed_vocab_size}: "
+                         "the hashes would not match the tables")
+    return lookup, hashlib.sha256(raw).hexdigest()[:16]
+
+
+class _Link:
+    """``protocol.Link`` over the engine's all-gather: rank 0 sends each round plan, rank 1 receives it."""
+
+    def __init__(self, engine: "Dsv41Engine") -> None:
+        self.engine = engine
+
+    def send(self, plan: list[int]) -> None:
+        self.engine._share(list(plan))
+
+    def recv(self) -> list[int]:
+        return self.engine._share(None)
+
+
+# Modules and kernel sources outside ``code_digest``'s import list that also decide a row's bits (hashed as files, so
+# nothing is imported or built): the router, sampling picks, plain fp64, the prefill / replay paths and their kernels.
+DIGEST_FILES = ("router.py", "router_gemv.py", "router_gemv.cu", "router_gemv.cpp", "pick.py", "plain_fp64.py",
+                "prefill_mm.py", "prefill_moe.py", "experts.py", "expert_loads.py", "x3ld.cu", "x3ld.cpp", "replay.py",
+                "x3tc.py", "x3gm.py", "x3gm.cu", "x3gm.cpp", "rope_fused.py", "csa2/stream_topk.py", "csa2/attn_pf.py",
+                "fused_proj.py", "x3seg.cu", "x3seg.cpp", "rmsnorm.py", "dense.py", "x3dn.cu", "x3dn.cpp")
+
+
+def code_digest() -> str:
+    """The code that decides an NVMe session entry's bytes (the forward, its kernels, the weights' tree), torch."""
+
+    import hashlib
+    from pathlib import Path
+
+    import torch
+
+    pkg = __name__.rsplit(".", 1)[0]
+    mods = [f"{pkg}.{m}" for m in ("forward", "blocks", "slots", "weights", "seams", "linear", "moe", "rope",
+                                   "engram_host", "numerics", "csa2.fmt", "csa2.compress", "csa2.index",
+                                   "csa2.attn", "csa2.rows")]
+    mods += [f"{pkg}.{m}" for m in ("mhc", "engram") if _exists(f"{pkg}.{m}")]
+    h = hashlib.sha256(fastboot.source_digest(mods).encode())
+    here = Path(__file__).resolve().parent
+    for name in DIGEST_FILES:
+        f = here / name
+        if f.is_file():
+            h.update(b"\0" + name.encode() + b"\0" + f.read_bytes())
+    return h.hexdigest()[:16] + "-" + torch.__version__
+
+
+def _exists(mod: str) -> bool:
+    import importlib.util
+
+    return importlib.util.find_spec(mod) is not None
+
+
+def _f64_ints(x: float) -> list[int]:
+    lo, hi = struct.unpack("<ii", struct.pack("<d", float(x)))
+    return [lo, hi]
+
+
+def _ints_f64(lo: int, hi: int) -> float:
+    return struct.unpack("<d", struct.pack("<ii", lo, hi))[0]
+
+
+class Dsv41Engine:
+    """DeepSeek-V4.1-Flash on two ranks (this one ``rank``)."""
+
+    vision = None
+
+    def __init__(self, model_dir: Path, *, rank: int, master: str, port: int, context: int = 0,
+                 serial_only: bool = False, draft_depth: int | None = None, comm=None, device: str = "cuda",
+                 parallel: int = 1, serving: bool | None = None, kv_dtype: str = "fp8") -> None:
+        import torch
+
+        from . import weights as W
+        from .csa2.backend import Triton
+        from .csa2.twin import Twin
+        from .engram_host import NgramHasher, open_shards
+        from .forward import CHUNK, prefill_chunk
+        from .slots import SlotsForward
+
+        fastboot.set_rank(rank)
+        fastboot.mark("start: imports, CLI")
+        self.torch = torch
+        self.model_dir, self.rank = Path(model_dir), rank
+        self.master, self.port = master, int(port)        # the plan link's address (``planlink``, TF_DSV41_PLAN_LINK)
+        self.serial_only, self.draft_depth = serial_only, draft_depth
+        self.request = threading.local()
+        self.batch = self.store = self.grammar_host = None
+        if kv_dtype != "fp8":
+            raise ValueError(f"--kv-dtype {kv_dtype}: this engine's KV cache is the FP8 record (--kv-dtype fp8)")
+        if serving is None:
+            serving = (os.environ.get("TF_DSV41_SERVING", "1").strip() or "1") != "0"
+        parallel = max(1, int(parallel or 1))
+        self.device = torch.device(device)
+        cuda = self.device.type == "cuda"
+        if cuda:
+            torch.cuda.set_device(0)
+        cfg = Config.from_file(self.model_dir / "config.json")
+        self.cfg = cfg
+        self.eos = (int(cfg.eos_token_id),)
+        context = int(context or os.environ.get("TF_DSV41_CONTEXT", "") or DEFAULT_CONTEXT)
+        chunk = int(os.environ.get("TF_DSV41_CHUNK", "") or CHUNK)
+        if not 1 <= chunk <= CHUNK:
+            raise ValueError(f"TF_DSV41_CHUNK={chunk}: 1 to {CHUNK}")
+        pchunk = prefill_chunk(chunk)
+        attn_rows = max(chunk, int(os.environ.get("TF_DSV41_PREFILL_ATTN_ROWS", "") or chunk))
+        self.limit = context
+        if comm is None:
+            from tensorfold.cuda.comm import NCCL
+            from tensorfold.families.glm5_next.spark.roce import select
+
+            comm = NCCL(rank, 2, master, port)
+            comm.barrier()
+            comm = select(comm)             # GLM53_TF_COMM_BACKEND=roce: our one-shot RoCE all-gather (0230 / 0350)
+        self.comm = comm
+        fastboot.mark("NCCL (both ranks up)")
+        tmap, tm_ident = token_map_for(self.model_dir, cfg)
+        from . import prefill_mm
+
+        mine = [context, chunk, int(serial_only), int(tm_ident[:7], 16), parallel, int(serving), pchunk,
+                prefill_mm.tag_grid()]
+        both = self._gather_ints(mine)
+        if both[0] != both[1]:
+            raise RuntimeError(f"the two ranks were started with different settings (context, TF_DSV41_CHUNK, "
+                               f"--no-drafts, Engram token map, --parallel, TF_DSV41_SERVING, "
+                               f"TF_DSV41_PREFILL_CHUNK, TF_DSV41_PREFILL_KERNELS / FAST_EXPERTS): rank 0 {both[0]}, "
+                               f"rank 1 {both[1]}")
+        key = fastboot.weights_key(self.model_dir, rank, 2, device=device, extra={"token_map": tm_ident})
+
+        def build():
+            return W.Loader(cfg, W.Shards(self.model_dir), rank, 2, device, W.bias_vl_source()).load(token_map=tmap)
+
+        tree = fastboot.cached_tree("weights", key, build, device)
+        fastboot.mark("weights", f"{tree.nbytes() / 1e9:.1f} GB")
+        token_ids = tree.token_map.tolist() if tree.token_map is not None else tmap
+        hasher = NgramHasher(cfg, token_ids)
+        engram_dir = os.environ.get("TF_DSV41_ENGRAM_DIR", "").strip()
+        if not engram_dir:
+            raise ValueError("TF_DSV41_ENGRAM_DIR: the kit's packed per-rank Engram shards on this node's NVMe "
+                             "(engram-l{1,14}-r{rank}of2.bin, `./start.sh pack` writes them)")
+        rows = open_shards(engram_dir, rank, 2, cfg.engram_layer_ids, dim=cfg.engram_head_dim)
+        csa2 = Triton(attn_rows, cfg.num_attention_heads // 2, device) if cuda else \
+            Twin(cfg.qk_rope_head_dim, cfg.sliding_window)
+        fw_args = {"csa2": csa2, "comm": comm, "device": device, "limit": context, "chunk": chunk, "pchunk": pchunk,
+                   "engram_rows": rows, "hasher": hasher, "slots": parallel, "contiguous": not serving}
+        if serving:                 # M2: DSpark, depth, lookup, Engram prefetch, graphs (``decode.py``)
+            from . import decode
+
+            loader = W.Loader(cfg, W.Shards(self.model_dir), rank, 2, device)
+            self.fw = decode.make(cfg, tree, loader=loader, **fw_args, cached=lambda b: fastboot.cached_tree(
+                "dspark", {**key, "part": "dspark"}, b, device))
+        else:
+            self.fw = SlotsForward(cfg, tree, **fw_args)
+        del tree
+        if cuda:
+            torch.cuda.empty_cache()
+            fastboot.mark("forward built", f"{torch.cuda.memory_allocated() / 2 ** 30:.1f} GiB allocated")
+        if serving:
+            self._serve(parallel, device)
+            if callable(getattr(self.fw, "boot", None)):
+                self.fw.boot(self)          # graph warm-up (15 s budget), the cost table (cached per image / shape)
+                fastboot.mark("M2 boot", self.fw.describe())
+        else:
+            self.fw.step([int(cfg.bos_token_id)])          # Triton compiles the kernels once
+            self.fw.reset()
+        if cuda:
+            torch.cuda.synchronize()
+        comm.barrier()
+        from . import memory
+
+        back = memory.host_trim()           # the compiles' and loaders' freed host memory (GPU memory on GB10)
+        fastboot.mark("serving" if serving else "warm-up window, barrier: serving",
+                      f"host trim {back:.2f} GiB; {memory.snapshot()}")
+        if serving and self.rank == 0:
+            self.batch.begin()          # the round thread shares the communicator: only after the boot exchanges
+
+    def _serve(self, parallel: int, device) -> None:
+        """The serving layer (``stack.build``) on this forward, and the NVMe entries both ranks hold."""
+
+        from . import planlink, topology
+        from .protocol import pack_bytes, unpack_bytes
+        from .stack import build
+
+        topo = topology.load(self.model_dir)
+        link = planlink.make(_Link(self), self.rank, self.master, self.port)      # TF_DSV41_PLAN_LINK: nccl | tcp
+        self.batch, self.grammar_host = build(self.fw, topo, rank=self.rank, link=link, model_dir=self.model_dir,
+                                              eos=self.eos, slots=parallel, context=self.limit, device=device,
+                                              image=code_digest(), start=False)
+        self.store = getattr(self.batch, "store", None)
+        disk = getattr(self.store, "disk", None)
+        n = self._gather_ints([int(disk is not None)])
+        if disk is None or not all(v[0] for v in n):
+            return
+        raw = json.dumps(disk.keys()).encode()
+        words = pack_bytes(raw)
+        lens = self._gather_ints([len(raw), len(words)])
+        width = max(lens[0][1], lens[1][1])
+        got = self._gather_ints(words + [0] * (width - len(words)))
+        keys = [set(json.loads(unpack_bytes(got[r][:lens[r][1]], lens[r][0]))) for r in range(2)]
+        common = sorted(keys[0] & keys[1])
+        disk.retain(common)
+        if self.rank == 0:
+            print(f"[tensorfold] session NVMe tier: {len(common)} entries on both ranks "
+                  f"({len(keys[0]) - len(common)} / {len(keys[1]) - len(common)} dropped)", flush=True)
+
+    # -- rank agreement ------------------------------------------------------------------------------------------
+    def _gather_ints(self, values: list[int]) -> list[list[int]]:
+        torch = self.torch
+        mine = torch.tensor(values, dtype=torch.int64, device=self.device)
+        got = torch.empty((2 * len(values),), dtype=torch.int64, device=self.device)
+        self.comm.all_gather(mine, got)
+        return [got[:len(values)].tolist(), got[len(values):].tolist()]
+
+    def _share(self, values: list[int] | None) -> list[int]:
+        """Rank 0's int list on both ranks (its length, then the values)."""
+
+        n = self._gather_ints([len(values) if self.rank == 0 else 0])[0][0]
+        vals = values if self.rank == 0 else [0] * n
+        return self._gather_ints(list(vals))[0] if n else []
+
+    # -- tokens --------------------------------------------------------------------------------------------------
+    def choose(self, logits, positions: list[int], sampling) -> list[int]:
+        """Rows of this rank's vocabulary half -> the same tokens on both ranks."""
+
+        import numpy as np
+
+        from tensorfold.cuda import comm as comm_mod
+        from tensorfold.engine.exact_sampling import NUCLEUS_CANDIDATES, choose_rows
+
+        torch = self.torch
+        greedy = sampling is None or sampling.temperature <= 0
+        k = 1 if greedy else (int(sampling.top_k) + MARGIN if sampling.top_k else NUCLEUS_CANDIDATES)
+        k = min(k, logits.shape[1])
+        vals, ids = P.top(logits.float(), k)       # ties: the lower id (the kit's argmax)
+        ids = (ids + self.fw.vocab_lo).to(torch.int32)
+        packed = torch.cat([vals, ids.view(torch.float32)], 1).contiguous()
+        got = torch.empty((2 * packed.numel(),), dtype=torch.float32, device=logits.device)
+        comm_mod.fast_gather(self.comm, packed.view(-1), got)
+        g = got.view(2, logits.shape[0], 2 * k).cpu()
+        comm_mod.check(self.comm)           # a failed RoCE exchange raises before any token
+        values = torch.cat([g[r, :, :k] for r in range(2)], 1).numpy().astype(np.float32)
+        tokens = torch.cat([g[r, :, k:].contiguous().view(torch.int32) for r in range(2)], 1).numpy().astype(np.int64)
+        if greedy:
+            order = np.lexsort((tokens, -values), axis=-1)
+            return [int(tokens[i, order[i, 0]]) for i in range(logits.shape[0])]
+        return choose_rows(values, tokens, positions, sampling)
+
+    # -- one request ---------------------------------------------------------------------------------------------
+    def _run(self, prompt: list[int], max_tokens: int, sampling, stop_eos: bool,
+             on_tokens: Callable[[list[int]], Any]) -> dict[str, Any]:
+        fw = self.fw
+        t0 = time.perf_counter()
+        fw.reset()
+        logits = fw.prompt(prompt)
+        if self.device.type == "cuda":
+            self.torch.cuda.synchronize()
+        t1 = time.perf_counter()
+        out: list[int] = []
+        reason = "length"
+        while True:
+            tok = self.choose(logits, [len(prompt) + len(out)], sampling)[0]
+            out.append(tok)
+            stop = bool(on_tokens([tok])) if self.rank == 0 else False
+            if stop_eos and tok in self.eos:
+                reason = "stop"
+                break
+            if len(out) >= max_tokens or len(prompt) + len(out) >= self.limit:
+                break
+            if self._gather_ints([int(stop)])[0][0]:
+                reason = "client"
+                break
+            logits = fw.step([tok])
+        t2 = time.perf_counter()
+        n = len(out)
+        return {"cached": 0, "prompt_tokens": len(prompt), "completion_tokens": n, "finish_reason": reason,
+                "prefill_s": round(t1 - t0, 4), "decode_s": round(t2 - t1, 4),
+                "prefill_tok_s": round(len(prompt) / max(t1 - t0, 1e-9), 1),
+                "decode_tok_s": round((n - 1) / max(t2 - t1, 1e-9), 2) if n > 1 else None}
+
+    def generate(self, prompt: list[int], max_tokens: int, sampling, on_tokens, draft: bool = True,
+                 stop_eos: bool | None = None) -> dict[str, Any]:
+        """Rank 0: one request, mirrored by rank 1 (``follow``): through the batcher when serving, else the one-slot
+        serial path (whatever ``draft`` says)."""
+
+        if self.batch is not None:
+            if stop_eos is not None:
+                self.request.stop_eos = bool(stop_eos)
+            return self.batch.generate_request(prompt, max_tokens, sampling, on_tokens, draft, request=self.request,
+                                               host=self.grammar_host)
+        stop_eos = bool(getattr(self.request, "stop_eos", True)) if stop_eos is None else bool(stop_eos)
+        if not prompt or len(prompt) >= self.limit:
+            raise ValueError(f"prompt of {len(prompt)} tokens: this engine serves contexts up to {self.limit}")
+        max_tokens = max(1, min(int(max_tokens), self.limit - len(prompt)))
+        seed = (sampling.seed if sampling else 0) & 0xFFFFFFFFFFFFFFFF
+        header = [max_tokens, int(stop_eos), seed & 0x7FFFFFFF, (seed >> 31) & 0x7FFFFFFF, seed >> 62,
+                  *_f64_ints(sampling.temperature if sampling else 0.0), int(sampling.top_k) if sampling else 0,
+                  *_f64_ints(sampling.top_p if sampling else 1.0), *_f64_ints(sampling.min_p if sampling else 0.0)]
+        self._share(header)
+        self._share(list(prompt))
+        stats = self._run(list(prompt), max_tokens, sampling, stop_eos, on_tokens)
+        stats.update(policy="0", drafts=False)
+        return stats
+
+    def follow(self) -> None:
+        """Rank 1: mirror every request rank 0 serves, forever."""
+
+        from tensorfold.engine.exact_sampling import Sampling
+
+        if self.batch is not None:
+            return self.batch.follow()
+        while True:
+            h = self._share(None)
+            max_tokens, stop_eos, s_lo, s_hi, s_top, t_lo, t_hi, top_k, p_lo, p_hi, m_lo, m_hi = h
+            prompt = self._share(None)
+            temperature = _ints_f64(t_lo, t_hi)
+            seed = (s_top << 62) | (s_hi << 31) | s_lo
+            sampling = (Sampling(seed, temperature, top_k, _ints_f64(p_lo, p_hi), _ints_f64(m_lo, m_hi))
+                        if temperature > 0 else None)
+            self._run(prompt, max_tokens, sampling, bool(stop_eos), lambda new: None)
