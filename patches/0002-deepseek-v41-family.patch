+    for a, z in ((0, 5), (5, 8)):
+        used = {int(e) for e in pb[a:z, :6].reshape(-1)} - {layer.ex.count}
+        assert used <= set(pe[a, :6].tolist())                          # B = 0: row 1's experts only
+    rel = float((got - exact).norm() / exact.norm())
+    print(f"\nbudget B 0 on a random block: relative MoE output change {rel:.3f} (rows 2..)")
