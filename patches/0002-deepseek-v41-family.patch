@@ -0,0 +1,387 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G6's router bench on one GPU: every real router of the checkpoint (40 target layers, E = 384, top-6;
+DSpark's blocks, E = 128, top-3), the fused router (``TF_DSV41_ROUTER=fused``) against G4's ``split``:
+
+- agree: picks fused == split (order and set) on real router inputs (``--samples``, router_check's capture of a gate
+  run) and on random rows; every differing row adjudicated by float64 (which path equals float64's picks, and
+  float64's margin there);
+- invariance: a row alone == the row in windows of R = 1..16 at tile offsets 0 / 7 / N - R, and a 4,100-row call
+  (chunks of 2,048) == the same rows in 16-row windows, picks and weights bit for bit;
+- graphs: route() captured at R = 1 / 3 / 16 (one layer and the 40-layer sweep, as decode does), replayed twice ==
+  eager bits, the counters back to 0 after every replay, new inputs copied in == eager on them; the same when the
+  first call ever is a capture (the per-call counter buffer);
+- time: us a layer over the 40-layer sweep (each layer's own gate: no L2 reuse between layers), eager and as one CUDA
+  graph, fused and split, at R = 1 / 2 / 4 / 8 / 16 / 64 / 2,048. ``--nsys`` brackets one graph-replayed sweep a mode
+  with cudaProfilerStart / Stop and NVTX ranges (nsys --capture-range=cudaProfilerApi).
+
+``--mode gemv`` (window G7): the candidate is ``router_gemv`` (TF_DSV41_ROUTER=gemv) instead of fused, in every check
+above (the report's "fused" keys are the candidate's), plus ``gemv``: on every router the kernel's logits == the numpy
+model of its summation order (bit for bit, real rows), the same bits under every (NW, EW) config, and picks vs float64
+on every real / random row (gemv's rate and split's).
+
+    python -m tensorfold.families.deepseek_v41.cuda.routerbench --model DIR [--mode gemv] [--samples X.pt] [--out J]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+TIME_ROWS = (1, 2, 4, 8, 16, 64, 2048)
+MODE = "fused"          # the candidate path (--mode)
+GRAPH_ROWS = (1, 3, 16)
+
+
+def _gates(model: str):
+    import torch
+
+    from . import weights as W
+    from .config import Config
+
+    cfg = Config.from_file(Path(model) / "config.json")
+    src = W.Shards(model)
+    ld = W.Loader(cfg, src, 0, 2, "cuda")
+    out = []
+    names = [(L, f"layers.{L}.ffn") for L in range(cfg.num_hidden_layers)]
+    names += [(cfg.num_hidden_layers + i, f"mtp.{i}.ffn") for i in range(8) if f"mtp.{i}.ffn.gate.weight" in src]
+    for L, f in names:
+        _, topk = cfg.experts_of(L)
+        out.append({"layer": L, "topk": topk, "w": ld.native(f"{f}.gate.weight", torch.bfloat16, bf16_param=True),
+                    "b": ld.native(f"{f}.gate.bias"), "scale": cfg.routed_scaling_factor})
+    return cfg, out
+
+
+def _bits(p, w):
+    import torch
+
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def _sample(samples, g):
+    """The real router inputs captured for this router (matched by the weight's fingerprint), or None."""
+
+    import torch
+
+    for s in samples or ():
+        if s["E"] == g["w"].shape[0] and torch.equal(s["fp"], g["w"][:2, :16].float().cpu()):
+            return s["x"].to("cuda", torch.bfloat16).contiguous()
+    return None
+
+
+def _route(g, x, mode=None, pick=None, wts=None):
+    from . import router
+
+    mode = mode or MODE
+    return router.route(x, g["w"], g["b"], topk=g["topk"], shared=True, scale=g["scale"], mode=mode, pick=pick,
+                        wts=wts)
+
+
+def agree(gates, samples, D: int, rows_random: int) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(7)
+    rep: dict = {}
+    for src in ("real", "random"):
+        tot = {"rows": 0, "same_order": 0, "same_set": 0, "diff": 0, "fused_f64": 0, "split_f64": 0, "neither": 0,
+               "margins": [], "max_logit_diff": 0.0, "max_w_diff": 0.0}
+        for g in gates:
+            if src == "real":
+                x = _sample(samples, g)
+                if x is None:
+                    continue
+            else:
+                x = torch.randn((rows_random, D), generator=gen, device="cuda").to(torch.bfloat16)
+            from . import router
+
+            pf, wf = _route(g, x, MODE)
+            ps, ws = _route(g, x, "split")
+            k = g["topk"]
+            pf, wf, ps, ws = pf[:, :k], wf[:, :k], ps[:, :k], ws[:, :k]
+            so = (pf == ps).all(1)
+            tot["rows"] += x.shape[0]
+            tot["same_order"] += int(so.sum())
+            tot["same_set"] += int((pf.sort(1).values == ps.sort(1).values).all(1).sum())
+            if bool(so.any()):
+                tot["max_w_diff"] = max(tot["max_w_diff"], float((wf[so] - ws[so]).abs().max()))
+            tot["max_logit_diff"] = max(tot["max_logit_diff"], float(
+                (router.logits(x, g["w"], MODE) - router.logits(x, g["w"], "split")).abs().max()))
+            for r in (~so).nonzero().flatten().tolist():
+                tot["diff"] += 1
+                s = torch.nn.functional.softplus(x[r:r + 1].double() @ g["w"].double().T).sqrt()[0]
+                ch = s + g["b"].double()
+                order = sorted(range(ch.numel()), key=lambda e: (-float(ch[e]), e))
+                ref = order[:k]
+                fa, sa = pf[r].tolist(), ps[r].tolist()
+                tot["fused_f64"] += int(fa == ref)
+                tot["split_f64"] += int(sa == ref)
+                tot["neither"] += int(fa != ref and sa != ref)
+                c = [float(ch[e]) for e in order[:k + 1]]
+                tot["margins"].append(min(c[j] - c[j + 1] for j in range(k)))
+        tot["agree_order"] = tot["same_order"] / max(1, tot["rows"])
+        tot["agree_set"] = tot["same_set"] / max(1, tot["rows"])
+        tot["margins"] = sorted(tot["margins"])[:50]
+        rep[src] = tot
+        print(f"[routerbench] agree {src}: {tot['rows']} rows, order {tot['agree_order']:.6f}, set "
+              f"{tot['agree_set']:.6f}; {tot['diff']} differ (fused == f64 {tot['fused_f64']}, split == f64 "
+              f"{tot['split_f64']}, neither {tot['neither']}); max |logit diff| {tot['max_logit_diff']:.2e}, "
+              f"max |w diff| {tot['max_w_diff']:.2e}", flush=True)
+    return rep
+
+
+def invariance(gates, samples, D: int) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(11)
+    bad = []
+    checked = 0
+    for g in gates:
+        x = torch.randn((40, D), generator=gen, device="cuda").to(torch.bfloat16)
+        real = _sample(samples, g)
+        if real is not None:                        # the real rows first (a capture may hold fewer than 40)
+            n = min(40, real.shape[0])
+            x[:n] = real[:n]
+        N = x.shape[0]
+        alone = [_bits(*_route(g, x[r:r + 1].contiguous())) for r in range(N)]
+        for R in range(1, 17):
+            for off in sorted({0, min(7, N - R), N - R}):
+                p, w = _bits(*_route(g, x[off:off + R].contiguous()))
+                for j in range(R):
+                    checked += 1
+                    if not (torch.equal(p[j], alone[off + j][0][0]) and torch.equal(w[j], alone[off + j][1][0])):
+                        bad.append((g["layer"], R, off, j))
+    # chunks: 4,100 rows in one call (3 launches of <= 2,048) == the same rows in 16-row windows
+    g = gates[0]
+    x = torch.randn((4100, D), generator=gen, device="cuda").to(torch.bfloat16)
+    whole = _bits(*_route(g, x))
+    parts = [_bits(*_route(g, x[a:a + 16].contiguous())) for a in range(0, 4100, 16)]
+    pp = torch.cat([p for p, _ in parts])
+    ww = torch.cat([w for _, w in parts])
+    chunk_ok = bool(torch.equal(whole[0], pp) and torch.equal(whole[1], ww))
+    rep = {"rows_checked": checked, "mismatches": len(bad), "first": bad[:10], "chunked_4100_eq_windows": chunk_ok,
+           "pass": not bad and chunk_ok}
+    print(f"[routerbench] invariance: {checked} row checks over {len(gates)} routers, R = 1..16: "
+          f"{len(bad)} mismatches; 4,100 rows in chunks == 16-row windows: {chunk_ok}", flush=True)
+    return rep
+
+
+def graphs(gates, D: int) -> dict:
+    import torch
+
+    from . import router
+    from . import router_gemv as RG
+
+    gen = torch.Generator(device="cuda").manual_seed(13)
+    dev = torch.device("cuda")
+    rep: dict = {"cases": []}
+
+    def case(name, R, gs, fresh_counters=False):
+        if fresh_counters:
+            router._COUNTERS.clear()
+            RG._COUNTERS.clear()
+        xs = torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16)
+        outs = [(torch.empty((R, g["topk"] + 1), dtype=torch.int32, device=dev),
+                 torch.empty((R, g["topk"] + 1), dtype=torch.float32, device=dev)) for g in gs]
+        st = torch.cuda.Stream()
+        st.wait_stream(torch.cuda.current_stream())
+        if not fresh_counters:
+            with torch.cuda.stream(st):                     # warm-up (the counters exist before the capture)
+                for g, (p, w) in zip(gs, outs):
+                    _route(g, xs, pick=p, wts=w)
+            torch.cuda.current_stream().wait_stream(st)
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            for g, (p, w) in zip(gs, outs):
+                _route(g, xs, pick=p, wts=w)
+        eager = [_bits(*_route(g, xs)) for g in gs]
+        res = {"name": name, "R": R, "routers": len(gs)}
+        same = []
+        zero = []
+        for _ in range(2):
+            graph.replay()
+            torch.cuda.synchronize()
+            same.append(all(torch.equal(p, e[0]) and torch.equal(w.view(torch.int32), e[1])
+                            for (p, w), e in zip(outs, eager)))
+            cnt = (RG._COUNTERS if MODE == "gemv" else router._COUNTERS).get((dev.type, torch.cuda.current_device()))
+            zero.append(cnt is None or int(cnt.abs().sum()) == 0)
+        xs.copy_(torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16))
+        graph.replay()
+        torch.cuda.synchronize()
+        eager2 = [_bits(*_route(g, xs)) for g in gs]
+        res["replay_eq_eager"] = same
+        res["counters_zero"] = zero
+        res["new_input_eq_eager"] = all(torch.equal(p, e[0]) and torch.equal(w.view(torch.int32), e[1])
+                                        for (p, w), e in zip(outs, eager2))
+        res["pass"] = all(same) and all(zero) and res["new_input_eq_eager"]
+        rep["cases"].append(res)
+        print(f"[routerbench] graph {name} R={R} x{len(gs)}: replays == eager {same}, counters 0 {zero}, "
+              f"new input == eager {res['new_input_eq_eager']}", flush=True)
+        del graph
+
+    case("capture-first", 3, gates[:1], fresh_counters=True)
+    for R in GRAPH_ROWS:
+        case("one-layer", R, gates[:1])
+        case("sweep", R, gates)
+    rep["pass"] = all(c["pass"] for c in rep["cases"])
+    return rep
+
+
+def timing(gates, D: int, iters: int, nsys: bool) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(17)
+    rep: dict = {}
+    if nsys:
+        torch.cuda.cudart().cudaProfilerStart()
+    for R in TIME_ROWS:
+        x = torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16)
+        row = {}
+        for mode in ("split", MODE):
+            def sweep(mode=mode, x=x):
+                for g in gates:
+                    _route(g, x, mode)
+
+            sweep()
+            torch.cuda.synchronize()
+            a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            n = iters if R <= 64 else max(3, iters // 10)
+            a.record()
+            for _ in range(n):
+                sweep()
+            b.record()
+            torch.cuda.synchronize()
+            eager_us = a.elapsed_time(b) * 1000 / n / len(gates)
+            graph_us = None
+            if R <= 64:
+                st = torch.cuda.Stream()
+                st.wait_stream(torch.cuda.current_stream())
+                with torch.cuda.stream(st):
+                    sweep()
+                torch.cuda.current_stream().wait_stream(st)
+                gr = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(gr):
+                    sweep()
+                gr.replay()
+                torch.cuda.synchronize()
+                if nsys:
+                    torch.cuda.nvtx.range_push(f"router-{mode}-R{R}")
+                a.record()
+                for _ in range(n):
+                    gr.replay()
+                b.record()
+                torch.cuda.synchronize()
+                if nsys:
+                    torch.cuda.nvtx.range_pop()
+                graph_us = a.elapsed_time(b) * 1000 / n / len(gates)
+                del gr
+            row[mode] = {"eager_us_layer": round(eager_us, 2),
+                         "graph_us_layer": None if graph_us is None else round(graph_us, 2)}
+        sp, fu = row["split"], row[MODE]
+        key = "graph_us_layer" if fu["graph_us_layer"] is not None else "eager_us_layer"
+        row["speedup"] = round(sp[key] / fu[key], 2)
+        row["saved_ms_44_calls"] = round((sp[key] - fu[key]) * 44 / 1000, 3)
+        rep[str(R)] = row
+        print(f"[routerbench] time R={R}: split {sp} {MODE} {fu} -> x{row['speedup']}, "
+              f"{row['saved_ms_44_calls']} ms a 44-call window", flush=True)
+    if nsys:
+        torch.cuda.cudart().cudaProfilerStop()
+    return rep
+
+
+def gemv_checks(gates, samples, D: int, model_rows: int = 8) -> dict:
+    """router_gemv only: kernel logits == the numpy model (bit for bit) and every (NW, EW) config the same bits, on
+    each router's real rows (random where none); picks vs float64 (stable sort: ties to the lower id) on every real
+    and random row, gemv's rate and split's."""
+
+    import numpy as np
+    import torch
+
+    from . import router
+    from . import router_gemv as RG
+
+    gen = torch.Generator(device="cuda").manual_seed(19)
+    rep = {"model_mismatch": [], "cfg_mismatch": [], "f64": {}}
+    for g in gates:
+        real = _sample(samples, g)
+        x = real if real is not None else torch.randn((64, D), generator=gen, device="cuda").to(torch.bfloat16)
+        xm = x[:model_rows].contiguous()
+        got = RG.logits(xm, g["w"]).cpu().numpy()
+        want = RG.model_logits(xm.cpu(), g["w"].cpu())
+        if not np.array_equal(got.view(np.int32), want.view(np.int32)):
+            rep["model_mismatch"].append((g["layer"], int((got != want).sum())))
+        base = _bits(*_route(g, x, "gemv"))
+        for cfg in RG.CFGS:
+            p = torch.empty_like(base[0])
+            w = torch.empty((x.shape[0], g["topk"] + 1), dtype=torch.float32, device="cuda")
+            RG.route(x, g["w"], g["b"], g["topk"], g["topk"] + 1, g["scale"], p, w, cfg=cfg)
+            if not (torch.equal(p, base[0]) and torch.equal(w.view(torch.int32), base[1])):
+                rep["cfg_mismatch"].append((g["layer"], cfg))
+        for src, xs in (("real", real), ("random", torch.randn((512, D), generator=gen, device="cuda").to(
+                torch.bfloat16))):
+            if xs is None:
+                continue
+            k = g["topk"]
+            s = torch.nn.functional.softplus(xs.double() @ g["w"].double().T).sqrt()
+            ref = torch.sort(-(s + g["b"].double()), dim=1, stable=True).indices[:, :k].int()
+            t = rep["f64"].setdefault(src, {"rows": 0, "gemv": 0, "split": 0})
+            t["rows"] += xs.shape[0]
+            t["gemv"] += int((_route(g, xs, "gemv")[0][:, :k] == ref).all(1).sum())
+            t["split"] += int((router.route(xs, g["w"], g["b"], topk=k, mode="split")[0][:, :k] == ref).all(1).sum())
+    for src, t in rep["f64"].items():
+        t["gemv_rate"] = t["gemv"] / max(1, t["rows"])
+        t["split_rate"] = t["split"] / max(1, t["rows"])
+        print(f"[routerbench] gemv vs float64 picks ({src}): {t['rows']} rows, gemv {t['gemv_rate']:.6f}, split "
+              f"{t['split_rate']:.6f}", flush=True)
+    rep["pass"] = not rep["model_mismatch"] and not rep["cfg_mismatch"]
+    print(f"[routerbench] gemv: logits == model on {len(gates)} routers: {not rep['model_mismatch']} "
+          f"{rep['model_mismatch'][:5]}; configs {RG.CFGS} same bits: {not rep['cfg_mismatch']} "
+          f"{rep['cfg_mismatch'][:5]}", flush=True)
+    return rep
+
+
+def main(argv: list[str] | None = None) -> int:
+    import torch
+
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--samples", default="", help="router_check's <report>.samples.pt (real router inputs)")
+    ap.add_argument("--random-rows", type=int, default=2048)
+    ap.add_argument("--iters", type=int, default=50)
+    ap.add_argument("--nsys", action="store_true")
+    ap.add_argument("--mode", default="fused", choices=("fused", "gemv"), help="the candidate path (vs split)")
+    ap.add_argument("--only", default="agree,invariance,graphs,time,gemv")
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    torch.cuda.set_device(0)
+    cfg, gates = _gates(a.model)
+    D = cfg.hidden_size
+    samples = torch.load(a.samples) if a.samples and Path(a.samples).exists() else None
+    print(f"[routerbench] {len(gates)} routers (E {sorted({int(g['w'].shape[0]) for g in gates})}), samples "
+          f"{0 if samples is None else len(samples)}", flush=True)
+    only = set(a.only.split(","))
+    global MODE
+    MODE = a.mode
+    rep: dict = {"routers": len(gates)}
+    if "agree" in only:
+        rep["agree"] = agree(gates, samples, D, a.random_rows)
+    if "invariance" in only:
+        rep["invariance"] = invariance(gates, samples, D)
+    if "graphs" in only:
+        rep["graphs"] = graphs(gates, D)
+    if "gemv" in only and MODE == "gemv":
+        rep["gemv"] = gemv_checks(gates, samples, D)
+    if "time" in only:
+        rep["time"] = timing(gates, D, a.iters, a.nsys)
+    rep["mode"] = MODE
+    rep["pass"] = all(rep[k]["pass"] for k in ("invariance", "graphs", "gemv") if k in rep)
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({"pass": rep["pass"]}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rowgraphs.py b/src/tensorfold/families/deepseek_v41/cuda/rowgraphs.py
new file mode 100644
index 0000000..1feb6f9
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rowgraphs.py
@@ -0,0 +1,266 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Slot-agnostic CUDA graphs for verify windows (G8, ``TF_DSV41_GRAPH_MODE=rows``, the default where row mode is
+possible): one graph per (padded total rows, context bucket) serves **any mix of slots**.
+
+G7 found 2- and 4-stream decode slower than 1 stream because a window mixing slots ran eagerly (graphs were keyed
+by the mix: (slot, rows) of each window), 23-34 ms of Python launches a round. Here a window of any slots is one
+row-mode run (``rowtab`` / ``rowmode``): every per-row value (id, position, the slot it reads and writes, ratio-2
+pooling's previous row, the Engram mirror row) is a column of one device table written by one non-blocking copy from
+pinned memory before the replay, and the slots' rings, carries and page tables are stacked, so a slot id is an
+offset. The rows are padded to a bucket (``rowtab.BUCKETS``: 1-8, 12, 16, 24, 32, 48, 64): padding rows mirror the
+last real row (the same arithmetic and experts) and write nothing; their logits are cut before the candidates.
+
+- **Key** (rows bucket, context bucket): the indexer scores ``nvis_max`` keys, a host value fixed at capture
+  (``graphs.bucket_end``; a row's keys past its own end score -inf and never reach its attention). A window of more
+  than 16 rows a slot, more than 64 rows or a slot twice runs eagerly.
+- **Boot** captures ``TF_DSV41_GRAPH_WARM`` (``decode``: 1-8 rows; ``all``: every bucket) at context bucket 0
+  within ``TF_DSV41_GRAPH_BUDGET_S``; the rest are captured on first use (that window runs eagerly, one launch
+  sequence a segment: its result is the round's). Memory floor, cap, both-ranks agreement and fallback are
+  ``graphs.GraphCache``'s.
+- **Exactness**: a row-mode run gives every real row the per-segment run's bits (each kernel's program computes a
+  row from that row, at the addresses the table names), so replay == eager, batched == alone, drafted == serial
+  (tests/test_dsv41_rowmode_interp.py, tests/cuda/test_dsv41_multistream_gpu.py).
+- **Fingerprint**: the MoE scratch, the stacked rings / carries / page tables and the row table; any change drops
+  every graph (captured again on use).
+- **Engram**: staged into persistent rows (``LazyEngram``: the host reads them) or, with ``TF_DSV41_ENGRAM_GATE=1``,
+  read by the gate kernel inside the graph (``engram_gate``: staging only arms the round); either way the padded
+  rows take their mirror's rows through one in-graph gather (``rowmode.Mirrored``).
+
+Knobs: TF_DSV41_GRAPH_MODE (rows; mix = the per-mix graphs of ``graphs.CudaGraphs``), TF_DSV41_GRAPH_ROWS_MAX (64:
+the largest bucket), and ``graphs.env_settings``'s.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from dataclasses import dataclass, field
+from typing import Any
+
+from . import rowtab as RT
+from .graphs import GraphCache, bucket_end, env_settings, room_for
+from .phases import PH
+
+
+def mode() -> str:
+    m = (os.environ.get("TF_DSV41_GRAPH_MODE", "rows").strip() or "rows").lower()
+    if m not in ("rows", "mix"):
+        raise ValueError(f"TF_DSV41_GRAPH_MODE={m!r}: expected rows or mix")
+    return m
+
+
+def buckets(env=None) -> tuple[int, ...]:
+    env = os.environ if env is None else env
+    top = int((env.get("TF_DSV41_GRAPH_ROWS_MAX", "") or "64").strip())
+    out = tuple(b for b in RT.BUCKETS if b <= top)
+    if not out:
+        raise ValueError(f"TF_DSV41_GRAPH_ROWS_MAX={top}: below the smallest bucket")
+    return out
+
+
+@dataclass
+class RowView:
+    win: Any                    # csa2.backend.RowWin over the table's first R rows
+    src: Any                    # int64 [R]: each row's Engram source row
+
+
+@dataclass
+class RowStatic:
+    """What ``fw.static`` holds during a row-mode run: the ids, the staged Engram rows, the row view."""
+
+    ids: Any
+    engram: dict
+    rowv: RowView
+
+
+@dataclass
+class Entry:
+    key: tuple
+    graph: Any = None
+    out: Any = None             # logits [R, V / W] (graph memory)
+    proj: dict = field(default_factory=dict)        # ratio-2 layer -> [R, 2 D] (pending carries)
+    taps: dict = field(default_factory=dict)        # tap layer -> [R, D]
+
+
+class Rows:
+    """Row mode's inputs (no CUDA needed: the CPU interpreter tests drive it): the persistent row table, the staged
+    Engram rows and each key's ``RowStatic`` (what ``fw.static`` holds for a row-mode run)."""
+
+    def __init__(self, fw, rmax: int, bucket: int) -> None:
+        import torch
+
+        self.torch, self.fw, self.bucket = torch, fw, int(bucket)
+        self.tab = RT.RowTable(rmax, fw.device)
+        self.engram: dict = {}                      # layer -> persistent rows [R max, cols] (staged Engram)
+        self.statics: dict = {}
+
+    def static(self, key) -> RowStatic:
+        st = self.statics.get(key)
+        if st is None:
+            R = key[0]
+            cap = bucket_end(key[1], self.bucket, self.fw.limit)
+            st = self.statics[key] = RowStatic(self.tab.ids(R), {}, RowView(self.tab.win(R, cap), self.tab.src(R)))
+        st.engram = {L: buf[:key[0]] for L, buf in self.engram.items()}
+        return st
+
+    def stage(self, key, segs) -> None:
+        """The window's table (one copy) and Engram rows (the real rows; through the gate: armed only)."""
+
+        fw = self.fw
+        mix = [(sg.slot, sg.start, len(sg.ids)) for sg in segs]
+        self.tab.stage(RT.plan_rows(mix, [t for sg in segs for t in sg.ids], key[0], len(fw.slots)))
+        for L, v in fw.engram_inputs_eager(segs).items():
+            buf = self.engram.get(L)
+            if buf is None or buf.shape[1:] != v.shape[1:] or buf.dtype != v.dtype:
+                buf = self.engram[L] = self.torch.zeros((self.tab.rmax, *v.shape[1:]), dtype=v.dtype,
+                                                        device=fw.device)
+            buf[:v.shape[0]].copy_(v)
+
+    def run(self, key, segs):
+        """One row-mode run of ``segs`` padded to ``key``'s rows (eager): this rank's logits of the real rows."""
+
+        fw = self.fw
+        self.stage(key, segs)
+        fw.static = self.static(key)
+        try:
+            out = fw.run(segs)
+        finally:
+            fw.static = None
+        return out[:sum(len(sg.ids) for sg in segs)]
+
+
+class RowGraphs:
+    """Graphs of ``fw`` (``decode.DecodeForward``, bound to the pool: ``rowmode.ready``): ``run(segs)`` replays the
+    key's graph, or runs eagerly and captures it. The interface of ``graphs.CudaGraphs``."""
+
+    def __init__(self, fw, *, agree_all=None, agree_any=None, settings: dict | None = None) -> None:
+        import torch
+
+        self.torch, self.fw = torch, fw
+        st = settings or env_settings()
+        self.buckets = tuple(st.get("buckets") or buckets())
+        self.pool = torch.cuda.graph_pool_handle()
+        self.rows = Rows(fw, max(self.buckets), st["bucket"])
+        self.warm = st.get("warm", "decode")
+        self.cache = GraphCache(self._capture, st["budget_s"], st["max_graphs"], st["bucket"], 64, st["on"],
+                                agree_all or (lambda ok: ok), agree_any or (lambda f: f),
+                                room=room_for(float(st.get("floor_gib", 5.0))))
+        self._pending = None
+        self._fp = self.fingerprint()
+
+    def fingerprint(self) -> tuple:
+        from . import rowmode
+
+        fw = self.fw
+        return tuple([id(getattr(b.moe, "scratch", None)) for b in fw.blocks]) + rowmode.fingerprint(fw) + (
+            self.rows.tab.ptr(),)
+
+    def key(self, segs):
+        if not self.cache.on:
+            return None
+        return RT.row_key([(sg.slot, sg.start, len(sg.ids)) for sg in segs], self.cache.bucket, self.fw.limit,
+                          self.buckets)
+
+    def _capture(self, key) -> Entry:
+        torch, fw = self.torch, self.fw
+        segs = self._pending
+        saved = {sg.slot: fw.slots[sg.slot].pending for sg in segs}
+        self.rows.stage(key, segs)
+        st = self.rows.static(key)
+        e = Entry(key)
+        g = torch.cuda.CUDAGraph()
+        fw.static = st
+        try:
+            # once eagerly in row mode (the same rows at the same positions: the same writes), so every Triton
+            # specialisation of the key is compiled and loaded before the capture
+            fw.run(segs)
+            torch.cuda.synchronize()
+            with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
+                e.out = fw.run(segs)
+            e.proj, e.taps = fw.row_out
+        finally:
+            fw.static = None
+            for sg in segs:
+                fw.slots[sg.slot].pending = saved[sg.slot]
+        e.graph = g
+        return e
+
+    def run(self, segs):
+        """This rank's logits of the windows ``segs`` (``forward.Seg``): replayed, or eager (+ captured)."""
+
+        from .forward import Pending
+
+        fw = self.fw
+        fp = self.fingerprint()
+        if fp != self._fp:
+            if self.cache.graphs:
+                print(f"[tensorfold] dsv41 row graphs: a persistent buffer moved; {len(self.cache.graphs)} graphs "
+                      "dropped (captured again on use)", file=sys.stderr, flush=True)
+            self.cache.drop()
+            self.rows.statics.clear()
+            self._fp = fp
+        key = self.key(segs)
+        e = self.cache.get(key)
+        if e is not None:
+            with PH("graph.stage"):
+                self.rows.stage(key, segs)
+            with PH("graph.replay"):
+                e.graph.replay()
+            spans = RT.bounds([(sg.slot, sg.start, len(sg.ids)) for sg in segs])
+            for sg, (a, b) in zip(segs, spans):
+                fw.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), {L: p[a:b] for L, p in e.proj.items()},
+                                                    {L: t[a:b] for L, t in e.taps.items()})
+            return e.out[:spans[-1][1]]
+        out = fw.run(segs)
+        if self.cache.wants(key):
+            self._pending = segs
+            try:
+                with PH("graph.capture"):
+                    self.cache.lazy(key)
+            finally:
+                self._pending = None
+        return out
+
+    def warmup(self, slots: int, ensure, bos: int = 0) -> int:
+        """Boot captures at context bucket 0: slot 0 at position 0 with min(rows, 16) rows, padded to the bucket
+        (``ensure(slot, rows)`` maps its pages); slot 0 is reset afterwards (the caller releases its pages)."""
+
+        from .forward import Seg
+
+        fw = self.fw
+        keys = [(R, 0) for R in RT.warm_buckets(self.warm) if R in self.buckets]
+
+        def capture_key(key, inner=self._capture):
+            n = min(key[0], RT.SEG_MAX)
+            fw.reset(0)
+            ensure(0, n + 1)
+            self._pending = [Seg(0, 0, tuple([int(bos)] * n))]
+            try:
+                return inner(key)
+            finally:
+                self._pending = None
+
+        real = self.cache.capture
+        self.cache.capture = capture_key
+        try:
+            n = self.cache.warmup(keys)
+        finally:
+            self.cache.capture = real
+            fw.reset(0)
+        return n
+
+
+def make(fw, *, agree_all=None, agree_any=None, settings: dict | None = None):
+    """The verify windows' graphs: ``RowGraphs`` (``TF_DSV41_GRAPH_MODE=rows`` and row mode possible: the pool is
+    bound, Triton CSA2), else ``graphs.CudaGraphs`` (per mix)."""
+
+    from . import rowmode
+    from .graphs import CudaGraphs
+
+    if mode() == "rows" and rowmode.ready(fw):
+        return RowGraphs(fw, agree_all=agree_all, agree_any=agree_any, settings=settings)
+    return CudaGraphs(fw, agree_all=agree_all, agree_any=agree_any, settings=settings)
+
+
+__all__ = ["RowGraphs", "RowStatic", "Rows", "RowView", "buckets", "make", "mode"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rowmode.py b/src/tensorfold/families/deepseek_v41/cuda/rowmode.py
new file mode 100644
index 0000000..bb4ea9e
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rowmode.py
@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Row mode's stacked slot state (G8): every slot's SWA ring of a layer, ratio-2 carry and KV-pool page table live in
+one tensor each, so a row's slot id (``rowtab``) is an offset and one launch serves rows of any slots.
+
+- ``stack(fw, pool_slots)`` (``slots.SlotsForward.bind``): a layer's rings become one store of S x ring rows (a
+  slot's ring is the view of rows [s ring, (s + 1) ring)), a ratio-2 layer's carries one fp32 [S, 2 D] tensor (a
+  slot's carry is row s), and the pool slots' page tables one int32 [S, pages] tensor (a pool slot's ``table`` is its
+  row: the pool writes it in place). The one-slot paths keep using the views, so nothing else changes; the contents
+  are copied, so a bind after use keeps every slot's state.
+- ``RowSlot``: the stores a row-mode window reads and writes (``blocks.Context.slot``): the stacked rings, the pool's
+  physical rows through the stacked page tables, the stacked carries.
+- ``fingerprint(fw)``: the addresses a captured row-mode graph holds.
+
+``ring_view`` / ``stack_rings`` serve the DSpark rings too (``drafter.Drafter``).
+"""
+
+from __future__ import annotations
+
+import torch
+
+from .csa2.stores import Floats, Keys, Records
+
+
+def ring_view(store, a: int, b: int):
+    """Rows [a, b) of a ring store as a store of their own (a view: writes land in the stacked tensor)."""
+
+    if isinstance(store, Records):
+        return Records(store.values[a:b], store.scales[a:b])
+    if isinstance(store, Keys):
+        return Keys(store.data[a:b])
+    return Floats(store.data[a:b])
+
+
+def stack_rings(csa2, rings: list, ring: int, dim: int, device, slots: int):
+    """One store of ``slots`` x ``ring`` rows holding ``rings`` (each slot's ring store, copied as stored bytes),
+    and the per-slot views replacing them (slots past ``rings`` start empty)."""
+
+    big = csa2.rows(slots * ring, dim, device)
+    views = []
+    for s in range(slots):
+        v = ring_view(big, s * ring, (s + 1) * ring)
+        if s < len(rings) and rings[s] is not None:
+            old = rings[s]
+            if isinstance(v, Records):
+                v.values.copy_(old.values)
+                v.scales.copy_(old.scales)
+            else:
+                v.data.copy_(old.data)
+        views.append(v)
+    return big, views
+
+
+class RowSlot:
+    """The stores of a row-mode window (``blocks.Context.slot``): ``swa`` {layer: stacked ring}, ``comp`` /
+    ``ikeys`` {kv source: the pool's rows through the stacked page tables}, ``carry`` {ratio-2 layer: fp32 [S, 2D]}."""
+
+    def __init__(self) -> None:
+        self.swa: dict = {}
+        self.comp: dict = {}
+        self.ikeys: dict = {}
+        self.carry: dict = {}
+        self.ptab = None
+
+
+def stack(fw, pool_slots=None) -> RowSlot:
+    """Stack ``fw``'s slots' rings, carries and (``pool_slots``: ``pool.Slot`` of each forward slot) page tables;
+    the result is ``fw.rowslot``. Row mode needs the pool (compressed rows and index keys through page tables)."""
+
+    S, cs, dev = len(fw.slots), fw.csa2, fw.device
+    rs = RowSlot()
+    for blk in fw.blocks:
+        L = blk.index
+        big, views = stack_rings(cs, [s.swa.get(L) for s in fw.slots], fw.ring, fw.cfg.head_dim, dev, S)
+        rs.swa[L] = big
+        for s, v in zip(fw.slots, views):
+            s.swa[L] = v
+        if any(L in s.carry for s in fw.slots):
+            first = next(s.carry[L] for s in fw.slots if L in s.carry)
+            allc = torch.zeros((S, first.numel()), dtype=first.dtype, device=first.device)
+            for i, s in enumerate(fw.slots):
+                if L in s.carry:
+                    allc[i].copy_(s.carry[L].reshape(-1))
+                s.carry[L] = allc[i]
+            rs.carry[L] = allc
+    if pool_slots:
+        pool = pool_slots[0].pool
+        tabs = [ps.table for ps in pool_slots]
+        if all(t is not None for t in tabs):
+            mp = max(int(t.numel()) for t in tabs)
+            ptab = torch.full((len(tabs), mp), int(pool.null), dtype=torch.int32, device=tabs[0].device)
+            for i, (ps, t) in enumerate(zip(pool_slots, tabs)):
+                ptab[i, :t.numel()].copy_(t)
+                ps.table = ptab[i, :t.numel()]          # the pool writes the slot's pages in place, into ptab
+            rs.ptab = ptab
+            for blk in fw.blocks:
+                if blk.mode != "full":
+                    continue
+                L = blk.index
+                comp, keys = pool.phys[f"comp.{L}"], pool.phys[f"index_k.{L}"]
+                shift = pool.family(f"comp.{L}").page_rows(pool.page).bit_length() - 1
+                rs.comp[L] = Records.packed(comp, ptab, shift)
+                rs.ikeys[L] = Keys(keys, ptab, shift)
+    fw.rowslot = rs
+    return rs
+
+
+class Mirrored:
+    """A row-mode window's Engram inputs: layer L's rows of the real rows (staged, or ``engram_gate``'s over the
+    graph's rows) taken through ``src`` (each row's source row: a padding row takes the last real row's), so every
+    row of the padded run has its mirror's inputs. One gather a layer, inside the graph."""
+
+    def __init__(self, inner, n: int, src) -> None:
+        view = getattr(inner, "view", None)
+        self.inner = view(n) if callable(view) and not isinstance(inner, dict) else inner
+        self.n, self.src = n, src
+
+    def __getitem__(self, L: int):
+        return self.inner[L][:self.n].index_select(0, self.src)
+
+    def __contains__(self, L) -> bool:
+        return L in self.inner
+
+    def keys(self):
+        return self.inner.keys()
+
+    def items(self):
+        return [(L, self[L]) for L in sorted(self.keys())]
+
+    def __len__(self) -> int:
+        return len(self.inner)
+
+
+def mirrored(rows, n: int, src) -> Mirrored:
+    return Mirrored(rows, n, src)
+
+
+def ready(fw) -> bool:
+    """Row mode is possible: the stacked state exists, with page tables for every slot (the pool is bound)."""
+
+    rs = getattr(fw, "rowslot", None)
+    return rs is not None and rs.ptab is not None and rs.ptab.shape[0] == len(fw.slots) and \
+        getattr(fw.csa2, "name", "") == "triton"
+
+
+def fingerprint(fw) -> tuple:
+    """The stacked buffers' addresses (a re-stack moves them: captured row-mode graphs must go)."""
+
+    rs = getattr(fw, "rowslot", None)
+    if rs is None:
+        return ()
+    parts = [rs.ptab.data_ptr() if rs.ptab is not None else 0]
+    parts += [st.values.data_ptr() if isinstance(st, Records) else st.data.data_ptr() for st in rs.swa.values()]
+    parts += [c.data_ptr() for c in rs.carry.values()]
+    return tuple(parts)
+
+
+__all__ = ["Mirrored", "RowSlot", "mirrored", "fingerprint", "ready", "ring_view", "stack", "stack_rings"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/rowtab.py b/src/tensorfold/families/deepseek_v41/cuda/rowtab.py
new file mode 100644
index 0000000..b346523
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rowtab.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Slot-agnostic verify windows (G8): the per-row metadata tables, the padded row buckets and the padding rule.
+
+A verify forward over any mix of slots runs as **one** sequence of launches over its rows padded to a bucket
+(``BUCKETS``: 1-8, 12, 16, 24, 32, 48, 64 rows), so one CUDA graph a (bucket, context bucket) serves every mix
+(``rowgraphs.py``). What used to be a per-slot Python scalar or a per-slot tensor is a column of one int64 table
+[``NCOL``, rows] on the device, written by one asynchronous copy from a pinned host buffer before each replay:
+
+- ``ids``: the token ids (the embedding's input);
+- ``pos``: each row's position (RoPE, the CSA2 kernels' POS in row mode, the indexer's visible range, the SWA
+  window, the compressor's group);
+- ``rslot``: the slot whose rings / page table / carry a row reads; ``wslot``: the slot a row writes (-1: padding);
+- ``prev``: ratio-2 pooling's previous row in [the slots' carries (row s = slot s) | the window's rows (S + r)]:
+  the slot's carry for a segment's first row, else the row before;
+- ``src``: the row whose Engram rows a row takes (itself; a padding row the last real row's: an in-graph gather,
+  so the Engram inputs need only the real rows, staged or through ``engram_gate``).
+
+The SWA rings, ratio-2 carries and page tables of every slot are stacked (``rowmode.py``), so a row's slot id is
+an offset into them. **Padding rows** mirror the last real row (its id, position, read slot and previous row: the
+same arithmetic, so the same experts: no extra expert reads) and write nothing (``wslot`` -1: the kernels skip
+their stores); their logits are cut before the candidates (``rows`` of the plan). The sampling keys and window
+boundaries stay on the host (``bounds``): the candidates are merged there.
+
+This module runs no CUDA: tests check the tables, the padding and the bucket choice on the CPU.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import numpy as np
+
+BUCKETS = (1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 24, 32, 48, 64)
+SEG_MAX = 16                    # rows a slot's window at most (graphs.MAX_ROWS)
+COLS = ("ids", "pos", "rslot", "wslot", "prev", "src")
+IDS, POS, RSLOT, WSLOT, PREV, SRC = range(len(COLS))
+NCOL = len(COLS)
+WARM = {"decode": BUCKETS[:8], "all": BUCKETS, "none": ()}
+
+Mix = Sequence[tuple[int, int, int]]          # (slot, start, rows) of each window, in plan order
+
+
+def bucket_rows(n: int, buckets: Sequence[int] = BUCKETS) -> int | None:
+    """The smallest bucket holding ``n`` rows (None: more rows than the largest)."""
+
+    for b in buckets:
+        if b >= n:
+            return int(b)
+    return None
+
+
+def row_key(mix: Mix, size: int, limit: int, buckets: Sequence[int] = BUCKETS, seg_max: int = SEG_MAX):
+    """``mix`` -> (padded rows, context bucket) or None (not graphable: no window, a slot twice, a window of more
+    than ``seg_max`` rows, more rows than the largest bucket, a position past ``limit``). ``size``: the context
+    bucket's tokens (``TF_DSV41_GRAPH_BUCKET``)."""
+
+    if not mix or len({int(m[0]) for m in mix}) != len(mix):
+        return None
+    if any(not 1 <= int(r) <= seg_max for _, _, r in mix):
+        return None
+    R = bucket_rows(sum(int(r) for _, _, r in mix), buckets)
+    last = max(int(s) + int(r) - 1 for _, s, r in mix)
+    if R is None or last >= limit:
+        return None
+    return R, last // size
+
+
+def bounds(mix: Mix) -> list[tuple[int, int]]:
+    """Each window's rows [a, b) in the padded run."""
+
+    out, a = [], 0
+    for _, _, n in mix:
+        out.append((a, a + int(n)))
+        a += int(n)
+    return out
+
+
+def plan_rows(mix: Mix, ids: Sequence[int], R: int, carries: int) -> np.ndarray:
+    """The table int64 [NCOL, R] of ``mix`` (``ids``: every window's ids in order) padded to ``R`` rows;
+    ``carries``: the slots' stacked carry rows (the offset of the window's rows in ratio-2 pooling's buffer)."""
+
+    n = sum(int(m[2]) for m in mix)
+    if len(ids) != n:
+        raise ValueError(f"{len(ids)} ids for a mix of {n} rows")
+    if not 1 <= n <= R:
+        raise ValueError(f"{n} rows do not fit a {R}-row bucket")
+    t = np.empty((NCOL, R), dtype=np.int64)
+    t[IDS, :n] = np.asarray(ids, dtype=np.int64)
+    for (slot, start, rows), (a, b) in zip(mix, bounds(mix)):
+        if not 0 <= int(slot) < carries:
+            raise ValueError(f"slot {slot} past the {carries} stacked slots")
+        t[POS, a:b] = np.arange(int(start), int(start) + int(rows))
+        t[RSLOT, a:b] = t[WSLOT, a:b] = int(slot)
+        t[PREV, a] = int(slot)                            # the slot's carry: position start - 1
+        t[PREV, a + 1:b] = carries + np.arange(a, b - 1)  # the row before, in the window's rows
+    t[SRC, :n] = np.arange(n)
+    if n < R:                                             # padding: the last real row, writing nothing
+        t[:, n:] = t[:, n - 1:n]
+        t[WSLOT, n:] = -1
+    return t
+
+
+def warm_buckets(warm: str) -> tuple[int, ...]:
+    """The boot captures (context bucket 0): ``decode`` 1-8 rows, ``all`` every bucket, ``none`` none."""
+
+    if warm not in WARM:
+        raise ValueError(f"TF_DSV41_GRAPH_WARM={warm!r}: expected one of {', '.join(WARM)}")
+    return WARM[warm]
+
+
+class RowTable:
+    """The persistent device table [NCOL, rmax] int64 and its pinned host mirror: ``stage`` writes a plan's
+    columns and copies the whole table in one non-blocking copy (every graph reads views of the same buffer, so
+    the addresses never move). Before the host mirror is written again, the previous copy is waited for (an
+    event), so a pending copy never reads a half-written plan."""
+
+    def __init__(self, rmax: int, device) -> None:
+        import torch
+
+        self.torch, self.rmax = torch, int(rmax)
+        cuda = torch.device(device).type == "cuda"
+        self.host = torch.zeros((NCOL, self.rmax), dtype=torch.int64, pin_memory=cuda)
+        self.dev = torch.zeros((NCOL, self.rmax), dtype=torch.int64, device=device)
+        self.cuda = cuda
+        self.event = None
+
+    def stage(self, t: np.ndarray) -> None:
+        R = t.shape[1]
+        if t.shape[0] != NCOL or R > self.rmax:
+            raise ValueError(f"a table [{t.shape[0]}, {R}] for [{NCOL}, {self.rmax}]")
+        if self.event is not None:
+            self.event.synchronize()
+        self.host.numpy()[:, :R] = t
+        self.dev.copy_(self.host, non_blocking=self.cuda)
+        if self.cuda:
+            if self.event is None:
+                self.event = self.torch.cuda.Event()
+            self.event.record()
+
+    def ids(self, R: int):
+        return self.dev[IDS, :R]
+
+    def src(self, R: int):
+        return self.dev[SRC, :R]
+
+    def win(self, R: int, cap: int):
+        """The ``csa2.backend.RowWin`` of the first ``R`` rows; ``cap``: the context bucket's last position."""
+
+        from .csa2.backend import RowWin
+
+        d = self.dev
+        return RowWin(R, d[POS, :R], d[RSLOT, :R], d[WSLOT, :R], d[PREV, :R], int(cap))
+
+    def ptr(self) -> int:
+        return self.dev.data_ptr()
+
+
+__all__ = ["BUCKETS", "COLS", "NCOL", "RowTable", "SEG_MAX", "bounds", "bucket_rows", "plan_rows", "row_key",
+           "warm_buckets"]
