new file mode 100644
index 0000000..74b5b90
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3dn.cu
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Dense EXL3 linears (dense.py, TF_DSV41_DENSE), v2: upstream's grid shape (one program a 128-column strip x K
+// split) with the x3ld load path (16-byte cp.async into a PD-deep shared-memory ring a warp, the input fragments
+// cp.async too), PDL (a program's first weights requested before griddepcontrol.wait), and few K splits chosen a
+// shape (dense.split_of: none where N alone fills the GPU). One launch runs up to MAXSEG matrices of one width.
+//
+// v1 (persistent CTAs over 16-step atoms from a work counter) measured 9-24% SLOWER than upstream in the engine
+// (G9-RESULTS section 2): 16-20 partials a strip, each with a fence, two atomics and a last-arriver sum, against
+// upstream's 8 (1 for wq_b). v2 has one reduction a program: the 4 warps in shared memory, and only with SK > 1 one
+// Z partial + one arrival atomic, the last split summing the SK partials.
+//
+// The arithmetic (the bits' parameters: K and SK, both the matrix's): split s of a strip = k steps
+// [s KT / SK, (s + 1) KT / SK); warp w of its program walks the quarter [lo + w L / 4, lo + (w + 1) L / 4) as one
+// mma.m16n8k16 chain (ascending k, from +0.0), decode.cuh's decode; the 4 warps added in warp order; the SK split
+// partials in split order; upstream's epilogue (fwht128, * 1/sqrt(128), * svh) and output rounding. Rows never mix:
+// row invariance, batched == alone, a matrix's bits in any group.
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#ifndef DSV41_X3DN_NO_TORCH       // the kernels alone (tests/test_dsv41_dense_compile.py: nvcc, no torch)
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#endif
+#include <algorithm>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "decode.cuh"
+
+using namespace tf_exl3;
+
+namespace dsv41_x3dn {
+
+constexpr int MAXSEG = 8;
+constexpr int W = 4;                 // warps a CTA
+constexpr int RB = 4;                // rows a reduction round (one a warp)
+enum DType : int { F16 = 0, BF16 = 1, F32 = 2 };
+
+__device__ __forceinline__ void load4(const void* p, int dtype, size_t i, float (&v)[4]) {
+    if (dtype == F32) {
+        const float4 u = *reinterpret_cast<const float4*>(static_cast<const float*>(p) + i);
+        v[0] = u.x; v[1] = u.y; v[2] = u.z; v[3] = u.w;
+    } else if (dtype == BF16) {
+        const uint2 u = *reinterpret_cast<const uint2*>(static_cast<const __nv_bfloat16*>(p) + i);
+        const float2 a = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.x));
+        const float2 b = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.y));
+        v[0] = a.x; v[1] = a.y; v[2] = b.x; v[3] = b.y;
+    } else {
+        const uint2 u = *reinterpret_cast<const uint2*>(static_cast<const half*>(p) + i);
+        const float2 a = __half22float2(*reinterpret_cast<const half2*>(&u.x));
+        const float2 b = __half22float2(*reinterpret_cast<const half2*>(&u.y));
+        v[0] = a.x; v[1] = a.y; v[2] = b.x; v[3] = b.y;
+    }
+}
+
+__device__ __forceinline__ void store4(void* p, int dtype, size_t i, const float (&v)[4]) {
+    if (dtype == F32) {
+        *reinterpret_cast<float4*>(static_cast<float*>(p) + i) = make_float4(v[0], v[1], v[2], v[3]);
+    } else if (dtype == BF16) {
+        __nv_bfloat162 a = __floats2bfloat162_rn(v[0], v[1]), b = __floats2bfloat162_rn(v[2], v[3]);
+        uint2 u;
+        u.x = *reinterpret_cast<uint32_t*>(&a);
+        u.y = *reinterpret_cast<uint32_t*>(&b);
+        *reinterpret_cast<uint2*>(static_cast<__nv_bfloat16*>(p) + i) = u;
+    } else {
+        half2 a = __floats2half2_rn(v[0], v[1]), b = __floats2half2_rn(v[2], v[3]);
+        uint2 u;
+        u.x = *reinterpret_cast<uint32_t*>(&a);
+        u.y = *reinterpret_cast<uint32_t*>(&b);
+        *reinterpret_cast<uint2*>(static_cast<half*>(p) + i) = u;
+    }
+}
+
+// upstream linear.cu's epilogue (no bias): H / sqrt(128), * svh
+__device__ __forceinline__ void finish(float (&v)[4], int lane, const half* svh, int col) {
+    fwht128(v, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] = v[j] * HAD_SCALE * __half2float(__ldg(svh + col + j));
+}
+
+__device__ __forceinline__ void pdl_wait() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+#endif
+}
+
+__device__ __forceinline__ void pdl_trigger() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+#endif
+}
+
+// release / acquire at GPU scope (the arrival counters' pattern; lighter than __threadfence's fence.sc)
+__device__ __forceinline__ void fence_gpu() { asm volatile("fence.acq_rel.gpu;" ::: "memory"); }
+
+__device__ __forceinline__ void cp16(uint32_t* dst, const uint32_t* src) {
+    const unsigned d = (unsigned)__cvta_generic_to_shared(dst);
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;" ::"r"(d), "l"(src) : "memory");
+}
+
+__device__ __forceinline__ void cp4(uint32_t* dst, const void* src) {
+    const unsigned d = (unsigned)__cvta_generic_to_shared(dst);
+    asm volatile("cp.async.ca.shared.global [%0], [%1], 4;" ::"r"(d), "l"(src) : "memory");
+}
+
+__device__ __forceinline__ void cp_commit() { asm volatile("cp.async.commit_group;" ::: "memory"); }
+
+template <int N>
+__device__ __forceinline__ void cp_wait() {
+    asm volatile("cp.async.wait_group %0;" ::"n"(N) : "memory");
+}
+
+// -- the tables (kernel parameters: graph-capture safe) ----------------------------------------------------------------
+struct RotSeg {
+    const void* x;          // [M, K] rows at x + row * ld (fp16, bf16 or fp32)
+    const half* suh;        // [K]
+    half* xh;               // [M, K] fp16, contiguous
+    long long ld;
+    int K, x_dtype;
+};
+struct RotTable {
+    RotSeg s[MAXSEG];
+    int n;
+};
+
+struct Seg {
+    const half* xh;          // [M, K] fp16 rotated input
+    const uint32_t* T;       // trellis words, upstream's strips layout [N/128, K/16, 8, TW]
+    const half* svh;         // [N]
+    void* y;                 // element (row, col) at y + row * ld + col
+    int* cnt;                // [passes, N / 128] strip arrivals (SK > 1), left zero
+    long long stride_nb;     // words between 128-column strips
+    int K, N, SK, p0, ld;    // SK: K splits of a strip (the shape's, dense.split_of); p0: first program
+};
+struct Table {
+    Seg s[MAXSEG];
+    int n, P;                // segments; programs of the launch
+};
+
+// the segment of program p: the last one with p0 <= p (unrolled selects: no local copy of the table)
+__device__ __forceinline__ int seg_of(const Table& tab, int p) {
+    int s = 0;
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i < tab.n && p >= tab.s[i].p0) s = i;
+    return s;
+}
+
+template <typename F>
+__device__ __forceinline__ auto field(const Table& tab, int s, F f) -> decltype(f(tab.s[0])) {
+    auto v = f(tab.s[0]);
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i == s) v = f(tab.s[i]);
+    return v;
+}
+
+template <int K2>
+__device__ __forceinline__ void req_w(const uint32_t* T, int kt, uint32_t* dst, int lane) {
+    constexpr int WORDS = 8 * tile_words<K2>();
+    constexpr int NV = (WORDS + 127) / 128;
+    const uint32_t* src = T + (size_t)kt * WORDS;
+#pragma unroll
+    for (int v = 0; v < NV; ++v) {
+        const int off = 128 * v + 4 * lane;
+        if (WORDS % 128 == 0 || off < WORDS) cp16(dst + off, src + off);
+    }
+}
+
+__device__ __forceinline__ void req_a(const half* x0, const half* x1, int kt, uint32_t* a) {
+    const int k = kt * 16;
+    cp4(a + 0, x0 + k);
+    cp4(a + 1, x1 + k);
+    cp4(a + 2, x0 + k + 8);
+    cp4(a + 3, x1 + k + 8);
+}
+
+template <int K2>
+__host__ __device__ constexpr int smem_words(int PD) {
+    return W * PD * (8 * tile_words<K2>() + 128) + W * RB * 128;
+}
+
+// Program p: strip nb, K split `split` of its segment ((nb, split) = divmod(p - p0, SK): a strip's splits are
+// consecutive programs, consecutive memory). Split s covers k steps [s KT / SK, (s + 1) KT / SK), warp w its quarter.
+template <int K2, int PD>
+__global__ void __launch_bounds__(W * 32, 3) dense_kernel(const Table tab, float* __restrict__ Z, int y_dtype,
+                                                          int M) {
+    constexpr int TW = tile_words<K2>(), LW = lane_words<K2>(), WORDS = 8 * TW;
+    static_assert(PD >= 2 && PD <= 4, "PD 2-4");
+    extern __shared__ __align__(16) uint32_t smem[];
+    __shared__ int last;
+
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    uint32_t* stage = smem + warp * PD * WORDS;
+    uint32_t* astg = smem + W * PD * WORDS + warp * PD * 128;
+    float* red = reinterpret_cast<float*>(smem + W * PD * (WORDS + 128));
+    const int RP = min(M, 16), passes = (M + 15) >> 4;
+    const int p = blockIdx.x, sg = seg_of(tab, p);
+    const int K = field(tab, sg, [](const Seg& s) { return s.K; });
+    const int SK = field(tab, sg, [](const Seg& s) { return s.SK; });
+    const int q = p - field(tab, sg, [](const Seg& s) { return s.p0; });
+    const int nb = q / SK, split = q - nb * SK, KT = K >> 4;
+    const int ka = split * KT / SK, L = (split + 1) * KT / SK - ka;
+    const int lo = ka + warp * L / W, n = ka + (warp + 1) * L / W - lo;
+    const uint32_t* Ts = field(tab, sg, [](const Seg& s) { return s.T; }) +
+                         (size_t)nb * field(tab, sg, [](const Seg& s) { return s.stride_nb; });
+    const half* xh = field(tab, sg, [](const Seg& s) { return s.xh; });
+    int wsel[LW];
+    {
+        int word, offset;
+        lane_start<K2>(lane, word, offset);
+#pragma unroll
+        for (int qq = 0; qq < LW; ++qq) wsel[qq] = (word + qq) % TW;
+    }
+
+    for (int pass = 0; pass < passes; ++pass) {
+        const int m0 = pass * 16, R = min(16, M - m0);
+        const half* x0 = xh + (size_t)(m0 + (g < R ? g : R - 1)) * K + 2 * t;
+        const half* x1 = xh + (size_t)(m0 + (g + 8 < R ? g + 8 : R - 1)) * K + 2 * t;
+        // the ring's first PD steps: weights before griddepcontrol.wait (the previous kernel's tail), inputs after
+#pragma unroll
+        for (int d = 0; d < PD; ++d)
+            if (d < n) req_w<K2>(Ts, lo + d, stage + d * WORDS, lane);
+        if (pass == 0) pdl_wait();
+#pragma unroll
+        for (int d = 0; d < PD; ++d)
+            if (d < n) req_a(x0, x1, lo + d, astg + d * 128 + 4 * lane);
+        cp_commit();
+
+        float acc[8][2][4];
+#pragma unroll
+        for (int i = 0; i < 8; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[i][h][c] = 0.f;
+
+#pragma unroll 1
+        for (int i = 0; i < n; ++i) {
+            const int slot = i % PD;
+            if (i == 0) cp_wait<0>();
+            else cp_wait<PD - 1>();
+            __syncwarp();
+            uint32_t w[8][LW];
+            const uint32_t* st = stage + slot * WORDS;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+#pragma unroll
+                for (int qq = 0; qq < LW; ++qq) w[j][qq] = st[j * TW + wsel[qq]];
+            const uint4 av = *reinterpret_cast<const uint4*>(astg + slot * 128 + 4 * lane);
+            const uint32_t a[4] = {av.x, av.y, av.z, av.w};
+            __syncwarp();                    // every lane has read the slot: refill it
+            if (i + PD < n) {
+                req_w<K2>(Ts, lo + i + PD, stage + slot * WORDS, lane);
+                req_a(x0, x1, lo + i + PD, astg + slot * 128 + 4 * lane);
+            }
+            cp_commit();
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                uint32_t b0[2], b1[2];
+                decode_lane<K2, 2>(w[j], lane, b0, b1);
+                mma16816(acc[j][0], a, b0);
+                mma16816(acc[j][1], a, b1);
+            }
+        }
+        cp_wait<0>();
+
+        // the warps' partials in warp order, RB rows a round (warp w sums row rlo + w)
+        const int NB = field(tab, sg, [](const Seg& s) { return s.N; }) >> 7;
+        const half* svh = field(tab, sg, [](const Seg& s) { return s.svh; });
+        void* y = field(tab, sg, [](const Seg& s) { return s.y; });
+        const int ld = field(tab, sg, [](const Seg& s) { return s.ld; });
+        const int col0 = nb * 128;
+        for (int rlo = 0; rlo < R; rlo += RB) {
+            __syncthreads();
+            const int gr = g - (rlo & 7);
+            if (gr >= 0 && gr < RB) {
+#pragma unroll
+                for (int i = 0; i < 8; ++i)
+#pragma unroll
+                    for (int h = 0; h < 2; ++h) {
+                        const int col = i * 16 + h * 8 + 2 * t;
+                        *reinterpret_cast<float2*>(red + (warp * RB + gr) * 128 + col) =
+                            rlo >= 8 ? make_float2(acc[i][h][2], acc[i][h][3])
+                                     : make_float2(acc[i][h][0], acc[i][h][1]);
+                    }
+            }
+            __syncthreads();
+            const int r = rlo + warp;
+            if (r < R) {
+                float4 s = *reinterpret_cast<const float4*>(red + warp * 128 + 4 * lane);
+#pragma unroll
+                for (int ww = 1; ww < W; ++ww) {
+                    const float4 v4 = *reinterpret_cast<const float4*>(red + (ww * RB + warp) * 128 + 4 * lane);
+                    s.x += v4.x; s.y += v4.y; s.z += v4.z; s.w += v4.w;
+                }
+                if (SK == 1) {
+                    float v[4] = {s.x, s.y, s.z, s.w};
+                    finish(v, lane, svh, col0 + 4 * lane);
+                    store4(y, y_dtype, (size_t)(m0 + r) * ld + col0 + 4 * lane, v);
+                } else {
+                    *reinterpret_cast<float4*>(Z + ((size_t)(pass * tab.P + p) * RP + r) * 128 + 4 * lane) = s;
+                }
+            }
+        }
+        if (SK > 1) {                        // the strip's last split to arrive sums the SK partials in split order
+            int* cnt = field(tab, sg, [](const Seg& s) { return s.cnt; }) + pass * NB + nb;
+            fence_gpu();
+            __syncthreads();
+            if (threadIdx.x == 0) last = atomicAdd(cnt, 1) == SK - 1;
+            __syncthreads();
+            if (last) {
+                fence_gpu();
+                for (int r = warp; r < R; r += W) {
+                    const float* zp = Z + ((size_t)(pass * tab.P + p - split) * RP + r) * 128 + 4 * lane;
+                    float4 s = __ldcg(reinterpret_cast<const float4*>(zp));
+#pragma unroll 4
+                    for (int j = 1; j < SK; ++j) {
+                        const float4 v4 = __ldcg(reinterpret_cast<const float4*>(zp + (size_t)j * RP * 128));
+                        s.x += v4.x; s.y += v4.y; s.z += v4.z; s.w += v4.w;
+                    }
+                    float v[4] = {s.x, s.y, s.z, s.w};
+                    finish(v, lane, svh, col0 + 4 * lane);
+                    store4(y, y_dtype, (size_t)(m0 + r) * ld + col0 + 4 * lane, v);
+                }
+                if (threadIdx.x == 0) *cnt = 0;
+            }
+        }
+    }
+    pdl_trigger();
+}
+
+// upstream's rot_in for up to MAXSEG (input, suh) pairs (blockIdx.z = segment), a PDL dependent that lets its own
+// dependent (the dense kernel) launch at once: that one's weight prologue overlaps this kernel.
+__global__ void __launch_bounds__(128) rot_in_kernel(const RotTable tab) {
+    pdl_wait();
+    pdl_trigger();
+    RotSeg s = tab.s[0];
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i == (int)blockIdx.z) s = tab.s[i];
+    const int blk = blockIdx.x * 4 + (threadIdx.x >> 5), row = blockIdx.y, lane = threadIdx.x & 31;
+    if (blk * 128 >= s.K) return;
+    const int k = blk * 128 + 4 * lane;
+    float v[4], sc[4];
+    load4(s.x, s.x_dtype, (size_t)row * s.ld + k, v);
+    load4(s.suh, F16, k, sc);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] *= sc[j];
+    fwht128(v, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] *= HAD_SCALE;
+    store4(s.xh, F16, (size_t)row * s.K + k, v);
+}
+
+}  // namespace dsv41_x3dn
+
+#ifndef DSV41_X3DN_NO_TORCH
+
+using namespace dsv41_x3dn;
+
+namespace {
+
+int dtype_of(const at::Tensor& t) {
+    return t.scalar_type() == at::kFloat ? F32 : t.scalar_type() == at::kBFloat16 ? BF16 : F16;
+}
+
+template <typename K, typename... A>
+void launch_ex(K kernel, dim3 grid, dim3 block, int smem, bool pdl, A... args) {
+    cudaLaunchConfig_t cfg = {};
+    cfg.gridDim = grid;
+    cfg.blockDim = block;
+    cfg.dynamicSmemBytes = (size_t)smem;
+    cfg.stream = at::cuda::getCurrentCUDAStream();
+    cudaLaunchAttribute attr[1];
+    attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+    attr[0].val.programmaticStreamSerializationAllowed = 1;
+    cfg.attrs = attr;
+    cfg.numAttrs = pdl ? 1 : 0;
+    C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, kernel, args...));
+}
+
+// the kernel's attributes, once (the schedule only, never a value)
+template <typename K>
+void prepare(K kernel, int smem) {
+    static std::map<const void*, bool> done;
+    if (done.count(reinterpret_cast<const void*>(kernel))) return;
+    if (smem > 48 * 1024)
+        C10_CUDA_CHECK(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem));
+    // the ring lives in shared memory and the weights bypass L1: the largest carveout (3 CTAs an SM at K2 10)
+    C10_CUDA_CHECK(cudaFuncSetAttribute(kernel, cudaFuncAttributePreferredSharedMemoryCarveout,
+                                        (int)cudaSharedmemCarveoutMaxShared));
+    done[reinterpret_cast<const void*>(kernel)] = true;
+}
+
+}  // namespace
+
+void dsv41_x3dn_rot_in_cuda(const std::vector<at::Tensor>& xs, const std::vector<at::Tensor>& suh, at::Tensor& xh,
+                            const std::vector<int64_t>& xh_off, bool pdl) {
+    RotTable tab{};
+    tab.n = (int)xs.size();
+    const int M = (int)xs[0].size(0);
+    int kmax = 0;
+    for (int i = 0; i < tab.n; ++i) {
+        const int K = (int)xs[i].size(1);
+        tab.s[i] = RotSeg{xs[i].data_ptr(), reinterpret_cast<const half*>(suh[i].data_ptr()),
+                          reinterpret_cast<half*>(xh.data_ptr()) + xh_off[i], (long long)xs[i].stride(0), K,
+                          dtype_of(xs[i])};
+        kmax = std::max(kmax, K);
+    }
+    launch_ex(rot_in_kernel, dim3((unsigned)((kmax / 128 + 3) / 4), (unsigned)M, (unsigned)tab.n), dim3(128), 0, pdl,
+              tab);
+}
+
+// meta: 8 ints a segment (K, N, SK, p0, xh_off, c_off, col, K2 check); ys[i]: the segment's output [M, >= col + N]
+void dsv41_x3dn_linear_cuda(const at::Tensor& xh, const std::vector<at::Tensor>& T,
+                            const std::vector<at::Tensor>& svh, const std::vector<at::Tensor>& ys, at::Tensor& Z,
+                            at::Tensor& counters, const std::vector<int64_t>& meta, int64_t programs, int64_t K2,
+                            int64_t PD, bool pdl) {
+    Table tab{};
+    tab.n = (int)T.size();
+    tab.P = (int)programs;
+    const int M = (int)ys[0].size(0);
+    for (int i = 0; i < tab.n; ++i) {
+        const int64_t* m = meta.data() + 8 * i;
+        const size_t esz = ys[i].element_size();
+        tab.s[i] = Seg{reinterpret_cast<const half*>(xh.data_ptr()) + m[4],
+                       reinterpret_cast<const uint32_t*>(T[i].data_ptr()),
+                       reinterpret_cast<const half*>(svh[i].data_ptr()),
+                       static_cast<char*>(ys[i].data_ptr()) + (size_t)m[6] * esz, counters.data_ptr<int>() + m[5],
+                       (long long)((m[0] / 16) * 8 * 4 * K2), (int)m[0], (int)m[1], (int)m[2], (int)m[3],
+                       (int)ys[i].stride(0)};
+    }
+#define TF_DN_LAUNCH(K2_, PD_)                                                                                     \
+    if (K2 == K2_ && PD == PD_) {                                                                                 \
+        auto kernel = dense_kernel<K2_, PD_>;                                                                     \
+        const int smem = smem_words<K2_>(PD_) * 4;                                                                \
+        prepare(kernel, smem);                                                                                    \
+        launch_ex(kernel, dim3((unsigned)programs), dim3(W * 32), smem, pdl, tab, Z.data_ptr<float>(),            \
+                  dtype_of(ys[0]), M);                                                                            \
+        return;                                                                                                   \
+    }
+#define TF_DN_WIDTH(K2_) TF_DN_LAUNCH(K2_, 2) TF_DN_LAUNCH(K2_, 3) TF_DN_LAUNCH(K2_, 4)
+    TF_DN_WIDTH(6) TF_DN_WIDTH(8) TF_DN_WIDTH(10) TF_DN_WIDTH(12) TF_DN_WIDTH(16)
+#undef TF_DN_WIDTH
+#undef TF_DN_LAUNCH
+    TORCH_CHECK(false, "x3dn: unsupported EXL3 width / ring depth: K2=", K2, " PD=", PD);
+}
+#endif  // DSV41_X3DN_NO_TORCH
diff --git a/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp
new file mode 100644
index 0000000..bc9311f
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of x3gm.cu (TF_DSV41_FAST_EXPERTS=gm: fast prefill routed experts; x3gm.py).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void dsv41_x3gm_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, bool, int64_t, bool, double);
+void dsv41_x3gm_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, bool);
+void dsv41_x3gm_rot_cuda(const at::Tensor&, int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t);
+void dsv41_x3gm_dequant_cuda(const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t);
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+static void check_plan(const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff, const at::Tensor& pcnt,
+                       const at::Tensor& npass, const at::Tensor& ticket) {
+    check(order, at::kInt, "order");
+    check(pe, at::kInt, "pe");
+    check(poff, at::kInt, "poff");
+    check(pcnt, at::kInt, "pcnt");
+    check(npass, at::kInt, "npass");
+    check(ticket, at::kInt, "ticket");
+}
+
+static void check_words(const at::Tensor& t, int64_t K, int64_t N, int64_t k2, const char* name) {
+    check(t, at::kInt, name);
+    TORCH_CHECK(t.dim() == 4 && t.size(1) * 16 == K && t.size(2) * 16 == N && t.size(3) == 4 * k2, name,
+                ": trellis words [E, K/16, N/16, 4 K2]");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(t.data_ptr()) % 16 == 0, name, ": 16-byte aligned");
+}
+
+// Xd [P, N] = fp16 rotated SwiGLU of gate / up (K = D, N = this rank's width); shx: xg feeds both matrices
+void gateup(const at::Tensor& xg, const at::Tensor& xu, const at::Tensor& tg, const at::Tensor& tu,
+            const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff, const at::Tensor& pcnt,
+            const at::Tensor& npass, const at::Tensor& ticket, const at::Tensor& svh_g, const at::Tensor& svh_u,
+            const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t k2, bool shx, int64_t cfg,
+            bool use_ticket, double limit) {
+    check(xg, at::kHalf, "xg");
+    check(xu, at::kHalf, "xu");
+    check_words(tg, K, N, k2, "tg");
+    check_words(tu, K, N, k2, "tu");
+    TORCH_CHECK(tg.sizes() == tu.sizes(), "gate and up trellis shapes");
+    check_plan(order, pe, poff, pcnt, npass, ticket);
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(xg.size(-1) == K && xd.size(-1) == N && xd.size(0) >= order.size(0) && xg.size(0) >= order.size(0),
+                "gateup: X [P, K], Xd [P, N]");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup: scales [E, N]");
+    TORCH_CHECK(cfg == 0 || cfg == 1, "gateup: cfg 0 or 1");
+    c10::cuda::CUDAGuard guard(xg.device());
+    dsv41_x3gm_gateup_cuda(xg, xu, tg, tu, order, pe, poff, pcnt, npass, ticket, svh_g, svh_u, suh_d, xd, K, N, k2,
+                           shx, cfg, use_ticket, limit);
+}
+
+// Y [P, N] fp32 = the down projection of Xd (K = this rank's width, N = D), * svh_d
+void down(const at::Tensor& xd, const at::Tensor& td, const at::Tensor& order, const at::Tensor& pe,
+          const at::Tensor& poff, const at::Tensor& pcnt, const at::Tensor& npass, const at::Tensor& ticket,
+          const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t k2, int64_t cfg, bool use_ticket) {
+    check(xd, at::kHalf, "xd");
+    check_words(td, K, N, k2, "td");
+    check_plan(order, pe, poff, pcnt, npass, ticket);
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(xd.size(-1) == K && y.size(-1) == N && y.size(0) >= order.size(0) && xd.size(0) >= order.size(0),
+                "down: Xd [P, K], Y [P, N]");
+    TORCH_CHECK(svh_d.size(-1) == N, "down: svh_d [E, N]");
+    TORCH_CHECK(cfg == 0 || cfg == 1, "down: cfg 0 or 1");
+    c10::cuda::CUDAGuard guard(xd.device());
+    dsv41_x3gm_down_cuda(xd, td, order, pe, poff, pcnt, npass, ticket, svh_d, y, K, N, k2, cfg, use_ticket);
+}
+
+// out_m [pairs, K] fp16 = rotated x rows of the routed pairs (mats 1: out0 only)
+void rot(const at::Tensor& x, int64_t x_stride, const at::Tensor& pick, const at::Tensor& suh0, const at::Tensor& suh1,
+         at::Tensor out0, at::Tensor out1, int64_t K, int64_t slots, int64_t pairs, int64_t mats) {
+    TORCH_CHECK(x.is_cuda() && (x.scalar_type() == at::kBFloat16 || x.scalar_type() == at::kHalf), "x: bf16/fp16");
+    check(pick, at::kInt, "pick");
+    check(suh0, at::kHalf, "suh0");
+    check(suh1, at::kHalf, "suh1");
+    check(out0, at::kHalf, "out0");
+    check(out1, at::kHalf, "out1");
+    TORCH_CHECK(K % 128 == 0 && pick.numel() >= pairs && out0.numel() >= pairs * K && (mats == 1 || mats == 2) &&
+                (mats == 1 || out1.numel() >= pairs * K), "rot: shapes");
+    c10::cuda::CUDAGuard guard(x.device());
+    dsv41_x3gm_rot_cuda(x, x_stride, pick, suh0, suh1, out0, out1, K, slots, pairs, mats);
+}
+
+void dequant(const at::Tensor& t, at::Tensor out, int64_t k2) {
+    check(out, at::kHalf, "out");
+    const int64_t K = out.size(0), N = out.size(1);
+    check(t, at::kInt, "t");
+    TORCH_CHECK(K % 16 == 0 && N % 16 == 0 && t.numel() == K * N / 256 * 4 * k2, "dequant: words [K/16, N/16, 4 K2]");
+    c10::cuda::CUDAGuard guard(t.device());
+    dsv41_x3gm_dequant_cuda(t, out, K, N, k2);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("gateup", &gateup);
+    m.def("down", &down);
+    m.def("rot", &rot);
+    m.def("dequant", &dequant);
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/x3gm.cu b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cu
new file mode 100644
index 0000000..bb31e9a
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cu
@@ -0,0 +1,460 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// x3gm: routed EXL3 (mul1) experts for fast prefill segments (TF_DSV41_FAST_EXPERTS=gm; x3gm.py has the design and
+// the cost model). Two persistent kernels over items (expert pass of <= 64 members, one 128-column Hadamard block):
+//
+//   gateup  Xd[p] = fp16(H(act * suh_d) / sqrt 128),  act = fp32 SwiGLU(H(Xg[p] Wg) * svh_g, H(Xu[p] Wu) * svh_u)
+//   down    Y[p]  = H(Xd[p] Wd) / sqrt 128 * svh_d                                                      (fp32)
+//
+// Data movement (the GLM spark engine's "fat" kernel, patches/0170, at this family's widths): a CTA claims items by
+// ticket; an NSA-stage cp.async ring holds, per stage, the item's member rows (gathered by pair index, XOR-swizzled
+// for ldmatrix) and the item's trellis words (16 K2 bytes a 16x16 tile, copied as they are stored). Each warp decodes
+// its MTL column tiles from shared memory straight into the m16n8k16 A fragment (the weights are A: W^T, so upstream's
+// decode lane layout IS the A fragment) and multiplies it by up to 8 n8 groups of member rows (ldmatrix B): a weight
+// tile is fetched from DRAM once a segment and decoded once a pass of 64 members, never written back.
+//
+// Numerics (the fast tag's rule, prefill_mm): every output element is one chain of mma over ascending k tiles from
+// +0.0 (no split-K, no atomics), then upstream's fwht128 butterflies and its ACT_F32 formulas; a pair's output depends
+// on its own row only (an mma column is one member; members past the count only fill zero / unused B columns), and
+// which CTA runs an item changes nothing. The decode is upstream's (cb_pair / LaneMap / Fmt from
+// experts_grouped.cuh, fwht128 from decode.cuh: included, never copied).
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+
+#include "decode.cuh"
+#include "experts_grouped.cuh"
+
+namespace dsv41_x3gm {
+
+using tf_exl3x::cb_pair;
+using tf_exl3x::Fmt;
+using tf_exl3x::LaneMap;
+using tf_exl3x::mma16816;
+
+constexpr float HAD = 0.08838834764831845f;          // 1 / sqrt(128)
+constexpr int NB = 8;                                 // column tiles an item: 128 columns, one Hadamard block
+constexpr int MUL1 = 2;
+
+__device__ __forceinline__ void cp_async16(void* smem, const void* gmem, bool ok) {
+    const unsigned s = (unsigned)__cvta_generic_to_shared(smem);
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" ::"r"(s), "l"(gmem), "r"(ok ? 16 : 0));
+}
+__device__ __forceinline__ void cp_commit() { asm volatile("cp.async.commit_group;\n" ::); }
+template <int N>
+__device__ __forceinline__ void cp_wait() { asm volatile("cp.async.wait_group %0;\n" ::"n"(N)); }
+__device__ __forceinline__ void ldsm4(uint32_t (&a)[4], const void* p) {
+    const unsigned s = (unsigned)__cvta_generic_to_shared(p);
+    asm volatile("ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%0,%1,%2,%3}, [%4];\n"
+                 : "=r"(a[0]), "=r"(a[1]), "=r"(a[2]), "=r"(a[3])
+                 : "r"(s));
+}
+
+// the 16-byte chunk c of member row r in a stage (CPR chunks a row): 8 rows of an ldmatrix phase in 8 bank groups
+template <int CPR>
+__device__ __forceinline__ int swz(int r, int c) {
+    static_assert(CPR == 8 || CPR == 4, "rows of 64 or 32 halves");
+    return CPR == 8 ? (c ^ (r & 7)) : (c ^ ((r >> 1) & 3));
+}
+
+// One 16x16 tile (k rows, n columns) of W_q from its words in shared memory, as the A fragment of W^T: upstream's
+// decode_tile (the same LaneMap windows and cb_pair values; b0 = column g, b1 = column g + 8), registers reordered.
+template <int K2>
+__device__ __forceinline__ void decode_a(const uint32_t* tile, const LaneMap<K2>& m, uint32_t (&a)[4]) {
+    constexpr int GV = Fmt<K2>::GV, NG = Fmt<K2>::NG;
+    uint32_t st[8];
+#pragma unroll
+    for (int g = 0; g < NG; ++g) {
+        const uint32_t whi = tile[m.hi[g]], wlo = tile[m.lo[g]];
+        const uint64_t mm = ((((uint64_t)wlo) << 32) | whi) >> m.sh[g];
+#pragma unroll
+        for (int j = 0; j < GV; ++j) st[g * GV + j] = (uint32_t)(mm >> Fmt<K2>::off(j)) & 0xffffu;
+    }
+    a[0] = cb_pair<MUL1>(st[0], st[1]);      // b0[0]: k 2t, 2t+1 of column g      -> A row g,     k 2t..
+    a[1] = cb_pair<MUL1>(st[4], st[5]);      // b1[0]: k 2t, 2t+1 of column g + 8  -> A row g + 8, k 2t..
+    a[2] = cb_pair<MUL1>(st[2], st[3]);      // b0[1]: k 2t+8, 2t+9 of column g    -> A row g,     k 2t+8..
+    a[3] = cb_pair<MUL1>(st[6], st[7]);      // b1[1]                              -> A row g + 8, k 2t+8..
+}
+
+template <int MATS, int XM, int K2, int MTL, int NG, int KS, int NSA, int NGR>
+struct Cfg {
+    static constexpr int BM = NG * 8, WPM = NB / MTL, W = MATS * WPM, THREADS = W * 32;
+    static constexpr int CPR = KS * 2, LDA = KS * 16, TW = 4 * K2;
+    static constexpr int LDE = 132, ER = NGR * 8, ROUNDS = NG / NGR;
+    static constexpr size_t A_BYTES = (size_t)XM * BM * LDA * sizeof(half);
+    static constexpr size_t W_BYTES = (size_t)MATS * KS * NB * TW * sizeof(uint32_t);
+    static constexpr size_t STAGE = A_BYTES + W_BYTES;
+    static constexpr size_t RING = (size_t)NSA * STAGE;
+    static constexpr size_t EPI = (size_t)MATS * ER * LDE * sizeof(float);
+    static constexpr size_t SMEM = RING > EPI ? RING : EPI;
+    static constexpr int MINB = 2 * (SMEM + 1536) <= 102400 ? 2 : 1;      // CTAs an SM the registers are capped for
+    static_assert(NG % 2 == 0 && NG % NGR == 0 && NGR % 2 == 0 && NB % MTL == 0, "tiling");
+    static_assert(A_BYTES % 16 == 0 && (TW * 4) % 16 == 0, "16-byte stages");
+    static_assert(XM == 1 || XM == MATS, "one shared input or one a matrix");
+};
+
+struct Args {
+    const half* x0;           // [P, K] rows of matrix 0 (gate / down input)
+    const half* x1;           // [P, K] rows of matrix 1 (up) when XM == 2
+    const uint32_t* t0;       // [E, K/16, N/16, 4 K2] trellis words, stacked
+    const uint32_t* t1;
+    const int* order;         // pair indices by expert (stable: rows ascending)
+    const int* pe;            // pass -> expert
+    const int* poff;          // pass -> first index into order
+    const int* pcnt;          // pass -> members (<= BM)
+    const int* npass;         // [1] passes in all
+    int* ticket;              // [1] zeroed, or null (static stride)
+    const half* sv0;          // gate/up: svh_g [E, N]; down: svh_d [E, N]
+    const half* sv1;          // svh_u [E, N]
+    const half* sd;           // suh_d [E, N]
+    half* xd;                 // gate/up out [P, N]
+    float* y;                 // down out [P, N]
+    int K, N;
+    float limit;
+};
+
+template <int MATS, int XM, int K2, int MTL, int NG, int KS, int NSA, int NGR>
+__global__ void __launch_bounds__(Cfg<MATS, XM, K2, MTL, NG, KS, NSA, NGR>::THREADS,
+                                  Cfg<MATS, XM, K2, MTL, NG, KS, NSA, NGR>::MINB) gm_kernel(const Args a) {
+    using C = Cfg<MATS, XM, K2, MTL, NG, KS, NSA, NGR>;
+    constexpr int THREADS = C::THREADS, BM = C::BM, LDA = C::LDA, LDE = C::LDE, ER = C::ER, CPR = C::CPR,
+                  TW = C::TW, W = C::W;
+    extern __shared__ __align__(16) unsigned char smem[];
+    float* ep = reinterpret_cast<float*>(smem);               // [MATS][ER][LDE] after the K loop (aliases the ring)
+    __shared__ int rows_sh[BM];
+    __shared__ int item_sh;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int mat = warp / C::WPM, slice = warp % C::WPM;     // columns slice 16 MTL .. + 16 MTL of the item
+    const int xmat = XM == 1 ? 0 : mat;
+    const int g = lane >> 2, t = lane & 3;
+    const int K = a.K, N = a.N, KT = K >> 4, NTILES = N >> 4, S = KT / KS, NBLK = N >> 7;
+    const size_t se = (size_t)KT * NTILES * TW;               // words of one expert's matrix
+    const int total = a.npass[0] * NBLK;
+    const int lr = (lane & 7) + ((lane >> 4) << 3), lc = (lane >> 3) & 1;
+    const LaneMap<K2> map(lane);
+
+    int next = blockIdx.x;
+    for (;;) {
+        __syncthreads();                                      // the last item is done with rows_sh and shared memory
+        if (threadIdx.x == 0) item_sh = a.ticket ? atomicAdd(a.ticket, 1) : next;
+        next += gridDim.x;
+        __syncthreads();
+        const int item = item_sh;
+        if (item >= total) break;
+        const int tt = item / NBLK, nb = item % NBLK;
+        const int e = a.pe[tt], off = a.poff[tt], cnt = a.pcnt[tt];
+        for (int i = threadIdx.x; i < BM; i += THREADS) rows_sh[i] = i < cnt ? a.order[off + i] : -1;
+        __syncthreads();
+        const int cnt16 = (cnt + 15) & ~15;                   // rows past it are never read (warp-uniform skip)
+
+        // stage s: member rows' k [16 KS s, 16 KS (s + 1)) (zero past the count), then the item's words of k tiles
+        // KS s .. KS s + KS - 1, every matrix, the 8 column tiles of block nb
+        auto load_stage = [&](int s) {
+            unsigned char* st = smem + (size_t)(s % NSA) * C::STAGE;
+            half* ra = reinterpret_cast<half*>(st);
+            const int k0 = s * KS * 16;
+            for (int i = threadIdx.x; i < XM * BM * CPR; i += THREADS) {
+                const int m = i / (BM * CPR), r = (i / CPR) % BM, c = i % CPR;
+                if (r < cnt16) {
+                    const int row = rows_sh[r];
+                    const half* src = (m ? a.x1 : a.x0) + (size_t)(row < 0 ? 0 : row) * K + k0 + c * 8;
+                    cp_async16(ra + ((size_t)m * BM + r) * LDA + swz<CPR>(r, c) * 8, src, row >= 0);
+                }
+            }
+            uint32_t* rw = reinterpret_cast<uint32_t*>(st + C::A_BYTES);
+            constexpr int WCH = MATS * KS * NB * K2;          // 16-byte chunks: K2 a tile
+            for (int i = threadIdx.x; i < WCH; i += THREADS) {
+                const int q = i % K2, n = (i / K2) % NB, kk = (i / (K2 * NB)) % KS, m = i / (K2 * NB * KS);
+                const uint32_t* src = (m ? a.t1 : a.t0) + (size_t)e * se +
+                                      ((size_t)(s * KS + kk) * NTILES + nb * NB + n) * TW + q * 4;
+                cp_async16(rw + ((m * KS + kk) * NB + n) * TW + q * 4, src, true);
+            }
+        };
+
+        float acc[MTL][NG][4];
+#pragma unroll
+        for (int l = 0; l < MTL; ++l)
+#pragma unroll
+            for (int n = 0; n < NG; ++n)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[l][n][c] = 0.f;
+
+#pragma unroll
+        for (int s = 0; s < NSA - 1; ++s) {
+            if (s < S) load_stage(s);
+            cp_commit();
+        }
+        cp_wait<NSA - 2>();
+        __syncthreads();
+        for (int s = 0; s < S; ++s) {
+            if (s + NSA - 1 < S) load_stage(s + NSA - 1);
+            cp_commit();
+            const unsigned char* st = smem + (size_t)(s % NSA) * C::STAGE;
+            const half* A = reinterpret_cast<const half*>(st) + (size_t)xmat * BM * LDA;
+            const uint32_t* Wd = reinterpret_cast<const uint32_t*>(st + C::A_BYTES) + (size_t)mat * KS * NB * TW +
+                                 slice * MTL * TW;
+#pragma unroll
+            for (int kk = 0; kk < KS; ++kk) {
+                uint32_t af[MTL][4];
+#pragma unroll
+                for (int l = 0; l < MTL; ++l) decode_a<K2>(Wd + (kk * NB + l) * TW, map, af[l]);
+                const int chunk = swz<CPR>(lr, kk * 2 + lc);
+#pragma unroll
+                for (int np = 0; np < NG / 2; ++np) {
+                    if (16 * np < cnt) {                      // warp-uniform
+                        uint32_t b[4];
+                        ldsm4(b, A + (16 * np + lr) * LDA + chunk * 8);
+                        const uint32_t b01[2] = {b[0], b[1]}, b23[2] = {b[2], b[3]};
+#pragma unroll
+                        for (int l = 0; l < MTL; ++l) {
+                            mma16816(acc[l][2 * np], af[l], b01);
+                            mma16816(acc[l][2 * np + 1], af[l], b23);
+                        }
+                    }
+                }
+            }
+            cp_wait<NSA - 2>();
+            __syncthreads();
+        }
+
+        // epilogue: ER members a round, accumulators -> ep[mat][member][column], then one warp a member row
+#pragma unroll
+        for (int rd = 0; rd < C::ROUNDS; ++rd) {
+            if (rd) __syncthreads();
+            if (ER * rd < cnt) {
+#pragma unroll
+                for (int n = 0; n < NGR; ++n) {
+                    const int ng = rd * NGR + n;
+                    float* E = ep + ((size_t)mat * ER + 8 * n + 2 * t) * LDE + slice * 16 * MTL + g;
+#pragma unroll
+                    for (int l = 0; l < MTL; ++l) {
+                        E[l * 16] = acc[l][ng][0];
+                        E[LDE + l * 16] = acc[l][ng][1];
+                        E[l * 16 + 8] = acc[l][ng][2];
+                        E[LDE + l * 16 + 8] = acc[l][ng][3];
+                    }
+                }
+            }
+            __syncthreads();
+            for (int r = warp; r < ER && ER * rd + r < cnt; r += W) {
+                const int row = rows_sh[ER * rd + r];
+                const int c0 = 4 * lane;
+                const size_t col = (size_t)e * N + nb * 128 + c0;
+                float v[4];
+                *reinterpret_cast<float4*>(v) = *reinterpret_cast<const float4*>(ep + (size_t)r * LDE + c0);
+                tf_exl3::fwht128(v, lane);
+                if constexpr (MATS == 2) {
+                    float u[4];
+                    *reinterpret_cast<float4*>(u) = *reinterpret_cast<const float4*>(ep + ((size_t)ER + r) * LDE + c0);
+                    tf_exl3::fwht128(u, lane);
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) {                 // upstream gateup_epilogue, ACT_F32
+                        const float gg = fminf(v[j] * HAD * __half2float(a.sv0[col + j]), a.limit);
+                        const float uu = fminf(fmaxf(u[j] * HAD * __half2float(a.sv1[col + j]), -a.limit), a.limit);
+                        const float act = gg / (1.f + expf(-gg)) * uu;
+                        v[j] = act * __half2float(a.sd[col + j]);
+                    }
+                    tf_exl3::fwht128(v, lane);
+                    half2* o = reinterpret_cast<half2*>(a.xd + (size_t)row * N + nb * 128 + c0);
+                    o[0] = __halves2half2(__float2half_rn(v[0] * HAD), __float2half_rn(v[1] * HAD));
+                    o[1] = __halves2half2(__float2half_rn(v[2] * HAD), __float2half_rn(v[3] * HAD));
+                } else {
+                    float4 o;                                     // upstream down_epilogue
+                    o.x = v[0] * HAD * __half2float(a.sv0[col + 0]);
+                    o.y = v[1] * HAD * __half2float(a.sv0[col + 1]);
+                    o.z = v[2] * HAD * __half2float(a.sv0[col + 2]);
+                    o.w = v[3] * HAD * __half2float(a.sv0[col + 3]);
+                    *reinterpret_cast<float4*>(a.y + (size_t)row * N + nb * 128 + c0) = o;
+                }
+            }
+        }
+    }
+}
+
+// Rotated inputs of the routed pairs: out_m[p] = fp16((x[p / slots] * suh_m[e]) H / sqrt 128), upstream rot_in's
+// arithmetic (one warp a (pair, 128-block), 8 a block; the x values read once for both matrices).
+template <typename TIN> __device__ __forceinline__ float to_f(TIN v);
+template <> __device__ __forceinline__ float to_f<__nv_bfloat16>(__nv_bfloat16 v) { return __bfloat162float(v); }
+template <> __device__ __forceinline__ float to_f<half>(half v) { return __half2float(v); }
+
+template <typename TIN, int MATS>
+__global__ void __launch_bounds__(256) rot_kernel(const TIN* __restrict__ x, int x_stride, const int* __restrict__ pick,
+                                                  const half* __restrict__ suh0, const half* __restrict__ suh1,
+                                                  half* __restrict__ out0, half* __restrict__ out1, int K, int slots,
+                                                  int items) {
+    const int item = blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (item >= items) return;                                // warp-uniform
+    const int KB = K >> 7, p = item / KB, blk = item % KB, lane = threadIdx.x & 31;
+    const int e = pick[p];
+    const TIN* xr = x + (size_t)(p / slots) * x_stride + blk * 128 + 4 * lane;
+    float xv[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) xv[j] = to_f<TIN>(xr[j]);
+#pragma unroll
+    for (int m = 0; m < MATS; ++m) {
+        const half* suh = (m ? suh1 : suh0) + (size_t)e * K + blk * 128 + 4 * lane;
+        float v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) v[j] = xv[j] * __half2float(suh[j]);
+        tf_exl3::fwht128(v, lane);
+        half* o = (m ? out1 : out0) + (size_t)p * K + blk * 128 + 4 * lane;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) o[j] = __float2half_rn(v[j] * HAD);
+    }
+}
+
+// Tests: W_q [K, N] fp16 of one trellis through decode_a (words staged in shared memory as the gm kernels stage them).
+template <int K2>
+__global__ void __launch_bounds__(32) dequant_kernel(const uint32_t* __restrict__ T, half* __restrict__ out, int N) {
+    constexpr int TW = 4 * K2;
+    __shared__ __align__(16) uint32_t tile[TW];
+    const int kt = blockIdx.x, nt = blockIdx.y, lane = threadIdx.x, NTILES = N >> 4;
+    for (int i = lane; i < TW; i += 32) tile[i] = T[((size_t)kt * NTILES + nt) * TW + i];
+    __syncwarp();
+    const LaneMap<K2> map(lane);
+    uint32_t af[4];
+    decode_a<K2>(tile, map, af);
+    const int g = lane >> 2, t = lane & 3;
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {                             // A row (q & 1 ? g + 8 : g) = W column; k 2t (+8)
+        const half2 h = *reinterpret_cast<const half2*>(&af[q]);
+        const int col = nt * 16 + g + 8 * (q & 1), row = kt * 16 + 2 * t + 8 * (q >> 1);
+        out[(size_t)row * N + col] = __low2half(h);
+        out[(size_t)(row + 1) * N + col] = __high2half(h);
+    }
+}
+
+template <int MATS, int XM, int K2, int MTL, int NG, int KS, int NSA, int NGR>
+void launch(const Args& a, bool ticket_on) {
+    using C = Cfg<MATS, XM, K2, MTL, NG, KS, NSA, NGR>;
+    auto kern = gm_kernel<MATS, XM, K2, MTL, NG, KS, NSA, NGR>;
+    static int per_sm = 0;
+    if (per_sm == 0) {
+        C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)C::SMEM));
+        C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, kern, C::THREADS, C::SMEM));
+        TORCH_CHECK(per_sm > 0, "x3gm: the configuration does not fit an SM");
+    }
+    TORCH_CHECK((a.K / 16) % KS == 0 && a.N % 128 == 0, "x3gm: K % (16 KS), N % 128");
+    Args b = a;
+    if (!ticket_on) b.ticket = nullptr;
+    const int sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+    kern<<<sms * per_sm, C::THREADS, C::SMEM, at::cuda::getCurrentCUDAStream()>>>(b);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// (MTL, NG, KS, NSA, NGR): cfg 0 = fat's (4 k tiles a stage), cfg 1 = half stages, one more in flight
+#define GM_GU0 2, 8, 4, 3, 4
+#define GM_GU1 2, 8, 2, 4, 4
+#define GM_DN0 2, 8, 4, 4, 8
+#define GM_DN1 1, 8, 4, 4, 8
+
+template <int K2>
+void gateup_k2(const Args& a, bool shx, int cfg, bool ticket) {
+    if (shx) {
+        if (cfg == 0) launch<2, 1, K2, GM_GU0>(a, ticket); else launch<2, 1, K2, GM_GU1>(a, ticket);
+    } else {
+        if (cfg == 0) launch<2, 2, K2, GM_GU0>(a, ticket); else launch<2, 2, K2, GM_GU1>(a, ticket);
+    }
+}
+
+template <int K2>
+void down_k2(const Args& a, int cfg, bool ticket) {
+    if (cfg == 0) launch<1, 1, K2, GM_DN0>(a, ticket); else launch<1, 1, K2, GM_DN1>(a, ticket);
+}
+
+}  // namespace dsv41_x3gm
+
+using dsv41_x3gm::Args;
+
+static Args args_of(const at::Tensor& x0, const at::Tensor& x1, const at::Tensor& t0, const at::Tensor& t1,
+                    const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff, const at::Tensor& pcnt,
+                    const at::Tensor& npass, const at::Tensor& ticket, int64_t K, int64_t N) {
+    Args a{};
+    a.x0 = reinterpret_cast<const half*>(x0.data_ptr());
+    a.x1 = reinterpret_cast<const half*>(x1.data_ptr());
+    a.t0 = reinterpret_cast<const uint32_t*>(t0.data_ptr());
+    a.t1 = reinterpret_cast<const uint32_t*>(t1.data_ptr());
+    a.order = order.data_ptr<int>();
+    a.pe = pe.data_ptr<int>();
+    a.poff = poff.data_ptr<int>();
+    a.pcnt = pcnt.data_ptr<int>();
+    a.npass = npass.data_ptr<int>();
+    a.ticket = ticket.data_ptr<int>();
+    a.K = (int)K;
+    a.N = (int)N;
+    return a;
+}
+
+void dsv41_x3gm_gateup_cuda(const at::Tensor& xg, const at::Tensor& xu, const at::Tensor& tg, const at::Tensor& tu,
+                            const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff,
+                            const at::Tensor& pcnt, const at::Tensor& npass, const at::Tensor& ticket,
+                            const at::Tensor& svh_g, const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor& xd,
+                            int64_t K, int64_t N, int64_t k2, bool shx, int64_t cfg, bool use_ticket, double limit) {
+    Args a = args_of(xg, xu, tg, tu, order, pe, poff, pcnt, npass, ticket, K, N);
+    a.sv0 = reinterpret_cast<const half*>(svh_g.data_ptr());
+    a.sv1 = reinterpret_cast<const half*>(svh_u.data_ptr());
+    a.sd = reinterpret_cast<const half*>(suh_d.data_ptr());
+    a.xd = reinterpret_cast<half*>(xd.data_ptr());
+    a.limit = (float)limit;
+    switch (k2) {
+        case 4: dsv41_x3gm::gateup_k2<4>(a, shx, (int)cfg, use_ticket); break;
+        case 6: dsv41_x3gm::gateup_k2<6>(a, shx, (int)cfg, use_ticket); break;
+        case 8: dsv41_x3gm::gateup_k2<8>(a, shx, (int)cfg, use_ticket); break;
+        default: TORCH_CHECK(false, "x3gm: gate/up width K2=", k2, " (4, 6 or 8)");
+    }
+}
+
+void dsv41_x3gm_down_cuda(const at::Tensor& xd, const at::Tensor& td, const at::Tensor& order, const at::Tensor& pe,
+                          const at::Tensor& poff, const at::Tensor& pcnt, const at::Tensor& npass,
+                          const at::Tensor& ticket, const at::Tensor& svh_d, at::Tensor& y, int64_t K, int64_t N,
+                          int64_t k2, int64_t cfg, bool use_ticket) {
+    Args a = args_of(xd, xd, td, td, order, pe, poff, pcnt, npass, ticket, K, N);
+    a.sv0 = reinterpret_cast<const half*>(svh_d.data_ptr());
+    a.y = y.data_ptr<float>();
+    switch (k2) {
+        case 4: dsv41_x3gm::down_k2<4>(a, (int)cfg, use_ticket); break;
+        case 6: dsv41_x3gm::down_k2<6>(a, (int)cfg, use_ticket); break;
+        case 8: dsv41_x3gm::down_k2<8>(a, (int)cfg, use_ticket); break;
+        default: TORCH_CHECK(false, "x3gm: down width K2=", k2, " (4, 6 or 8)");
+    }
+}
+
+void dsv41_x3gm_rot_cuda(const at::Tensor& x, int64_t x_stride, const at::Tensor& pick, const at::Tensor& suh0,
+                         const at::Tensor& suh1, at::Tensor& out0, at::Tensor& out1, int64_t K, int64_t slots,
+                         int64_t pairs, int64_t mats) {
+    const int items = (int)(pairs * (K / 128));
+    const dim3 grid((unsigned)((items + 7) / 8));
+    auto stream = at::cuda::getCurrentCUDAStream();
+    auto s0 = reinterpret_cast<const half*>(suh0.data_ptr());
+    auto s1 = reinterpret_cast<const half*>(suh1.data_ptr());
+    auto o0 = reinterpret_cast<half*>(out0.data_ptr());
+    auto o1 = reinterpret_cast<half*>(out1.data_ptr());
+#define GM_ROT(T, M)                                                                                              \
+    dsv41_x3gm::rot_kernel<T, M><<<grid, 256, 0, stream>>>(reinterpret_cast<const T*>(x.data_ptr()), (int)x_stride, \
+                                                           pick.data_ptr<int>(), s0, s1, o0, o1, (int)K, (int)slots, \
+                                                           items)
+    if (x.scalar_type() == at::kBFloat16) {
+        if (mats == 1) GM_ROT(__nv_bfloat16, 1); else GM_ROT(__nv_bfloat16, 2);
+    } else {
+        if (mats == 1) GM_ROT(half, 1); else GM_ROT(half, 2);
+    }
+#undef GM_ROT
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void dsv41_x3gm_dequant_cuda(const at::Tensor& t, at::Tensor& out, int64_t K, int64_t N, int64_t k2) {
+    const dim3 grid((unsigned)(K / 16), (unsigned)(N / 16));
+    auto stream = at::cuda::getCurrentCUDAStream();
+    auto tp = reinterpret_cast<const uint32_t*>(t.data_ptr());
+    auto op = reinterpret_cast<half*>(out.data_ptr());
+    switch (k2) {
+        case 4: dsv41_x3gm::dequant_kernel<4><<<grid, 32, 0, stream>>>(tp, op, (int)N); break;
+        case 6: dsv41_x3gm::dequant_kernel<6><<<grid, 32, 0, stream>>>(tp, op, (int)N); break;
+        case 8: dsv41_x3gm::dequant_kernel<8><<<grid, 32, 0, stream>>>(tp, op, (int)N); break;
+        default: TORCH_CHECK(false, "x3gm: K2=", k2, " (4, 6 or 8)");
+    }
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
