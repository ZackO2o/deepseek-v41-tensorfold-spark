@@ -0,0 +1,260 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Self-distillation of DSpark's heads on our own target (phase 1: the blocks frozen), from drafting logs
+(``draftlog`` with TF_DSV41_DRAFT_LOG_HID=1): no model is loaded, the logged pass rows are the features.
+
+Why: DSpark was trained against DeepSeek's BF16 / FP8 target; ours is the dealigned pack at 2.9 bpw with a 4-bit
+drafter (sfxnz: 4-bit drafter 1.33 vs source precision 2.77 tokens a round; native-weight prose 0.63 at position 1,
+ours 0.54). The heads after the blocks see exactly our target's taps; refitting them on our target's own tokens is
+the cheapest part of an on-policy re-fit.
+
+Data: every logged pass row i whose serial token is known: the candidates' ids and base logits [C] (the noise row's,
+before the Markov bias), the head hidden h_i [D], the serial token before it (teacher forcing: the parent a kept
+prefix gives) and the serial token (the label: T = 0 runs give the target's greedy choice = self-distillation).
+
+Model (``Adapter``): z_i(c) = base_i[c] + alpha x w2'[c] . (w1'[prev] + u_i), with w1' = w1 + w1 M, w2' = w2 + w2 Q
+(M, Q: rank x rank, zero at start) and u_i = A B rms(h_i) (``ctx`` rank > 0; zero at start). Without ``ctx``
+everything folds into new ``markov_head.embed`` / ``.head`` tables (alpha into w1'): the engine runs them unchanged
+(``TF_DSV41_DSPARK_HEADS``, ``drafter.load``). ``ctx`` needs u_i in the chain kernel (not built): train it to price
+that kernel work first. The confidence head is refit last (logistic, from its weights) on [h_i ; w1'[prev]] against
+"the new chain's draft is serial", teacher forced.
+
+Loss: cross-entropy over the row's candidates (rows whose serial token is not a candidate are skipped and counted),
+plus ``wd`` x (|M|^2 + |Q|^2 + |A B|^2) toward the shipped heads. Held out: whole sessions (``--holdout``). Reported:
+the teacher-forced top-1 by position and the chain's tokens (``draftsim.chain`` rule at alpha) before / after.
+
+CLI (a Spark, the venv with torch): python -m tensorfold.families.deepseek_v41.cuda.drafttrain LOGDIR --heads MODEL
+  --out heads.safetensors [--epochs 4 --lr 3e-3 --ctx 0 --device cuda]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+
+F32 = torch.float32
+
+
+@dataclass
+class Rows:
+    ids: torch.Tensor           # int64 [R, C] (-1 = none)
+    base: torch.Tensor          # fp32 [R, C]
+    hid: torch.Tensor           # bf16 [R, D] (zeros without logged hidden)
+    prev: torch.Tensor          # int64 [R]
+    label: torch.Tensor         # int64 [R] the serial token's column, -1 if not a candidate
+    pos: torch.Tensor           # int64 [R] draft position (0-based)
+    session: torch.Tensor       # int64 [R]
+
+    def take(self, m: torch.Tensor) -> Rows:
+        return Rows(*(t[m] for t in (self.ids, self.base, self.hid, self.prev, self.label, self.pos, self.session)))
+
+    def __len__(self) -> int:
+        return int(self.ids.shape[0])
+
+
+def rows_of(passes, D: int | None = None) -> Rows:
+    ids, base, hid, prev, label, pos, sess = [], [], [], [], [], [], []
+    for p in passes:
+        if p.cand is None or not p.serial:
+            continue
+        h = None
+        if p.hid is not None:
+            h = torch.from_numpy(np.asarray(p.hid)).view(torch.bfloat16)
+        for i in range(min(len(p.serial), p.cand.shape[0])):
+            c = p.cand[i].astype(np.int64)
+            ids.append(c)
+            base.append(p.base[i].astype(np.float32))
+            hid.append(h[i] if h is not None else torch.zeros(D or 1, dtype=torch.bfloat16))
+            prev.append(int(p.pending) if i == 0 else int(p.serial[i - 1]))
+            hit = np.flatnonzero(c == int(p.serial[i]))
+            label.append(int(hit[0]) if hit.size else -1)
+            pos.append(i)
+            sess.append(int(p.session))
+    return Rows(torch.from_numpy(np.stack(ids)), torch.from_numpy(np.stack(base)), torch.stack(hid),
+                torch.tensor(prev), torch.tensor(label), torch.tensor(pos), torch.tensor(sess))
+
+
+class Adapter(torch.nn.Module):
+    def __init__(self, w1: torch.Tensor, w2: torch.Tensor, D: int, ctx: int = 0) -> None:
+        super().__init__()
+        r = w1.shape[1]
+        self.w1, self.w2 = w1, w2                       # bf16 [V, r], frozen (not parameters)
+        self.M = torch.nn.Parameter(torch.zeros(r, r))
+        self.Q = torch.nn.Parameter(torch.zeros(r, r))
+        self.log_alpha = torch.nn.Parameter(torch.zeros(()))
+        self.ctx = int(ctx)
+        if ctx:
+            self.A = torch.nn.Parameter(torch.zeros(r, ctx))
+            self.B = torch.nn.Parameter(torch.randn(ctx, D) / math.sqrt(D))
+
+    def me(self, prev: torch.Tensor) -> torch.Tensor:
+        e = self.w1[prev].to(F32)
+        return e + e @ self.M
+
+    def z(self, x: Rows) -> torch.Tensor:
+        live = x.ids >= 0
+        w2 = self.w2[x.ids.clamp(min=0)].to(F32)        # [R, C, r]
+        w2 = w2 + w2 @ self.Q
+        me = self.me(x.prev)
+        if self.ctx:
+            h = x.hid.to(F32)
+            h = h * torch.rsqrt(h.pow(2).mean(-1, keepdim=True) + 1e-6)
+            me = me + (h @ self.B.t()) @ self.A.t()
+        bias = torch.einsum("rcd,rd->rc", w2, me) * self.log_alpha.exp()
+        return torch.where(live, x.base + bias, torch.full_like(x.base, float("-inf")))
+
+    def penalty(self) -> torch.Tensor:
+        p = self.M.pow(2).sum() + self.Q.pow(2).sum()
+        if self.ctx:
+            p = p + (self.A @ self.B).pow(2).sum()
+        return p
+
+    @torch.no_grad()
+    def folded(self) -> tuple[torch.Tensor, torch.Tensor]:
+        """(w1', w2') with alpha folded into w1' (bf16): the drop-in Markov head (``ctx`` is not foldable)."""
+
+        w1 = self.w1.to(F32)
+        w2 = self.w2.to(F32)
+        return ((w1 + w1 @ self.M) * self.log_alpha.exp()).to(torch.bfloat16), (w2 + w2 @ self.Q).to(torch.bfloat16)
+
+
+def evaluate(model: Adapter | None, x: Rows, w1, w2, n: int = 5, batch: int = 4096) -> dict:
+    """Teacher-forced top-1 by position (the serial token first among the candidates) and the share of rows whose
+    serial token is a candidate."""
+
+    hits = torch.zeros(n)
+    tot = torch.zeros(n)
+    with torch.no_grad():
+        for a in range(0, len(x), batch):
+            xb = x.take(torch.arange(a, min(a + batch, len(x))))
+            if model is None:
+                live = xb.ids >= 0
+                e = w1[xb.prev].to(F32)
+                bias = torch.einsum("rcd,rd->rc", w2[xb.ids.clamp(min=0)].to(F32), e)
+                z = torch.where(live, xb.base + bias, torch.full_like(xb.base, float("-inf")))
+            else:
+                z = model.z(xb)
+            top = z.argmax(1)
+            ok = (xb.label >= 0) & (top == xb.label)
+            for i in range(n):
+                m = xb.pos == i
+                hits[i] += ok[m].sum()
+                tot[i] += m.sum()
+    return {"top1_by_position": [round(float(h / t), 4) if t else None for h, t in zip(hits, tot)],
+            "rows": int(tot.sum()), "label_in_candidates": round(float((x.label >= 0).float().mean()), 4)}
+
+
+def train(x: Rows, w1, w2, *, D: int, ctx: int = 0, epochs: int = 4, lr: float = 3e-3, wd: float = 1e-2,
+          batch: int = 1024, device: str = "cpu", seed: int = 0, log=print) -> Adapter:
+    torch.manual_seed(seed)
+    model = Adapter(w1.to(device), w2.to(device), D, ctx).to(device)
+    keep = x.label >= 0
+    x = x.take(keep)
+    opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=lr)
+    n = len(x)
+    for ep in range(epochs):
+        perm = torch.randperm(n)
+        tot = 0.0
+        for a in range(0, n, batch):
+            ix = perm[a:a + batch]
+            xb = x.take(ix)
+            xb = Rows(*(t.to(device) for t in (xb.ids, xb.base, xb.hid, xb.prev, xb.label, xb.pos, xb.session)))
+            loss = torch.nn.functional.cross_entropy(model.z(xb), xb.label) + wd * model.penalty()
+            opt.zero_grad()
+            loss.backward()
+            opt.step()
+            tot += float(loss.detach()) * len(ix)
+        log(f"[drafttrain] epoch {ep + 1}: loss {tot / max(n, 1):.4f}")
+    return model.cpu()
+
+
+def refit_conf(model: Adapter | None, x: Rows, w1, cw: torch.Tensor, *, steps: int = 200, lr: float = 0.05,
+               wd: float = 1e-3) -> torch.Tensor:
+    """The confidence head [D + r] refit (from ``cw``) on [h ; w1'[prev]] -> (the row's top-1 is serial)."""
+
+    with torch.no_grad():
+        if model is None:
+            e = w1[x.prev].to(F32)
+            z = None
+        else:
+            e = model.folded()[0][x.prev].to(F32)
+            z = model.z(x)
+        if z is None:
+            raise ValueError("refit_conf needs a model (the chain rule it calibrates)")
+        y = ((x.label >= 0) & (z.argmax(1) == x.label)).to(F32)
+        f = torch.cat([x.hid.to(F32), e], 1)
+    w = torch.nn.Parameter(cw.clone().to(F32).reshape(-1))
+    opt = torch.optim.Adam([w], lr=lr)
+    w0 = w.detach().clone()
+    for _ in range(steps):
+        loss = torch.nn.functional.binary_cross_entropy_with_logits(f @ w, y) + wd * (w - w0).pow(2).sum()
+        opt.zero_grad()
+        loss.backward()
+        opt.step()
+    return w.detach()
+
+
+def export(path: str, model: Adapter, cw: torch.Tensor | None, layer: int = 2) -> None:
+    """The heads as the checkpoint names them (``mtp.{layer}.markov_head.*``, ``confidence_head.proj``)."""
+
+    from safetensors.torch import save_file
+
+    w1, w2 = model.folded()
+    t = {f"mtp.{layer}.markov_head.embed.weight": w1.contiguous(),
+         f"mtp.{layer}.markov_head.head.weight": w2.to(torch.float16).contiguous()}
+    if cw is not None:
+        t[f"mtp.{layer}.confidence_head.proj.weight"] = cw.reshape(1, -1).to(torch.float16).contiguous()
+    save_file(t, path, metadata={"source": "drafttrain", "ctx": str(model.ctx)})
+
+
+def split(x: Rows, holdout: float, seed: int = 0) -> tuple[Rows, Rows]:
+    s = torch.unique(x.session)
+    g = torch.Generator().manual_seed(seed)
+    s = s[torch.randperm(len(s), generator=g)]
+    k = max(1, int(round(len(s) * holdout))) if len(s) > 1 else 0
+    test = torch.isin(x.session, s[:k])
+    return x.take(~test), x.take(test)
+
+
+def main(argv=None) -> None:
+    from . import draftsim as DS
+
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("log")
+    ap.add_argument("--heads", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--epochs", type=int, default=4)
+    ap.add_argument("--lr", type=float, default=3e-3)
+    ap.add_argument("--wd", type=float, default=1e-2)
+    ap.add_argument("--ctx", type=int, default=0)
+    ap.add_argument("--holdout", type=float, default=0.2)
+    ap.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    a = ap.parse_args(argv)
+    passes = DS.load(a.log)
+    w1, w2, cw = DS.heads(a.heads)
+    D = None
+    for p in passes:
+        if p.hid is not None:
+            D = int(np.asarray(p.hid).shape[-1])
+            break
+    x = rows_of(passes, D or 1)
+    tr, te = split(x, a.holdout)
+    rep = {"rows_train": len(tr), "rows_test": len(te), "before": evaluate(None, te, w1, w2)}
+    model = train(tr, w1, w2, D=D or 1, ctx=a.ctx, epochs=a.epochs, lr=a.lr, wd=a.wd, device=a.device)
+    rep["after"] = evaluate(model, te, w1, w2)
+    w1n, w2n = model.folded()
+    held = [p for p in passes if p.session in set(te.session.tolist())]
+    rep["chain_before"] = DS.accept_stats(held, lambda p: DS.chain(p, w1, w2))
+    rep["chain_after_folded"] = DS.accept_stats(held, lambda p: DS.chain(p, w1n, w2n))
+    cwn = refit_conf(model, tr, w1, cw) if (cw is not None and D) else cw
+    export(a.out, model, cwn)
+    print(json.dumps(rep, indent=1))
+
+
+if __name__ == "__main__":
+    main()
