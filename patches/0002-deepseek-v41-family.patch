index 0000000..e254dba
--- /dev/null
+++ b/tests/test_dsv41_tree.py
@@ -0,0 +1,253 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Tree verification (``tree.py`` / ``shadow.py``, TF_DSV41_TREE) on the real forward and batcher, on the CPU twin of
+the kernels and the synthetic DSpark checkpoint (``dsv41_dspark_fakes``):
+
+- the cost model: without siblings it is ``depth.best_k``; a probable sibling displaces a deep chain row; the keyed
+  order's first token is ``exact_sampling.choose``'s;
+- state isolation, round by round against a forward without the tree: the presented branch's candidates are the
+  same bits as that chain run alone, and after every commit (main chain kept, sibling kept with 1-3 drafts, across a
+  page boundary) the slot's committed state is the same bytes (SWA rings, compressed rows and index keys below the
+  position, ratio-2 carries, the Engram lookback, the DSpark context: the next drafts);
+- drafted == serial through the batcher with oracle siblings (the serial token as a sibling while the chain's first
+  draft is wrong, so siblings win and commit), at T = 0 and T > 0, past 2,048 tokens of context, 1 and 4 slots.
+
+Run: python -m pytest -q tests/test_dsv41_tree.py (the CPU twin: several minutes).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling, choose  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import tree as TR  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.depth import Costs  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece, Rows, accepted  # noqa: E402
+from tensorfold.families.glm5_next.spark.depth import best_k  # noqa: E402
+
+VERIFY = [29.5, 36.3, 40.25, 44.2, 48.15, 52.1, 56.1, 60.1] + [60.1 + 3.76 * i for i in range(1, 9)]
+LONG = 2400
+N_LONG = 10
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+LONG_PROMPTS = [[int(t) for t in np.random.default_rng(30 + i).integers(3, 250, size=2052 + 7 * i)]
+                for i in range(4)]
+
+
+# -- the cost model ---------------------------------------------------------------------------------------------------
+def test_plan_without_siblings_is_best_k():
+    rng = np.random.default_rng(0)
+    for _ in range(3000):
+        qs = list(rng.random(rng.integers(1, 6)))
+        lam = float(rng.random() * 0.1)
+        for least in (0, 1):
+            k, _ = best_k(qs, VERIFY, lam, least=least)
+            k2, lens, _, _ = TR.plan(qs, [], qs[1:], VERIFY, lam, least=least)
+            assert k == k2 and lens == []
+
+
+def test_plan_takes_a_probable_sibling():
+    lam = 1.7 / 44.0
+    k, lens, ms, e = TR.plan([0.5, 0.45, 0.45], [0.35, 0.05], [0.45, 0.45], VERIFY, lam, dup_ms=0.4)
+    assert lens[0] >= 1 and lens[1] == 0 and k >= 1
+    assert abs(ms - (VERIFY[k + sum(lens)] + 0.4)) < 1e-9
+    k0, lens0, _, e0 = TR.plan([0.5, 0.45, 0.45], [0.05, 0.02], [0.45, 0.45], VERIFY, lam)
+    assert lens0 == [0, 0] and e > e0
+    # prefix-closed: a sibling's second row only with its first, the main chain's first draft before any sibling
+    for _ in range(500):
+        rng = np.random.default_rng(_)
+        qm, sib = list(rng.random(4)), list(rng.random(3))
+        k, lens, _, _ = TR.plan(qm, sib, qm[1:], [10.0] * 16, float(rng.random() * 0.2))
+        assert all(L == 0 for L in lens) or k >= 1
+
+
+def test_ranked_first_is_the_keyed_choice():
+    rng = np.random.default_rng(3)
+    for t in range(200):
+        ids = rng.choice(500, size=64, replace=False).astype(np.int64)
+        z = rng.normal(size=64).astype(np.float32) * 3
+        s = None if t % 3 == 0 else Sampling(seed=t, temperature=0.5 + t % 4 * 0.3, top_k=t % 30,
+                                              top_p=[1.0, 0.9, 0.5][t % 3], min_p=[0.0, 0.05][t % 2])
+        got = TR.ranked(z, ids, 1000 + t, s, 3)
+        want = int(ids[np.lexsort((ids, -z))[0]]) if s is None else choose(z, ids, 1000 + t, s)
+        assert got[0][0] == want and len({g[0] for g in got}) == len(got)
+        assert TR.ranked(z, ids, 1000 + t, s, 2, exclude=(want,))[0][0] == got[1][0] if len(got) > 1 else True
+
+
+# -- the forward: state isolation ---------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41tree"))
+
+
+def _bound(ck, tree: bool, monkeypatch, cap: int = 512):
+    from tensorfold.families.deepseek_v41.cuda.pool import Pool
+
+    monkeypatch.setenv("TF_DSV41_TREE", "3" if tree else "0")
+    fw = DF.forward(ck, slots=1, limit=cap)
+    pool = Pool(ck[3], 8 * 256, device=fw.device)
+    ps = [pool.new_slot(cap)]
+    fw.bind(ps)
+    ps[0].ensure(cap)
+    return fw
+
+
+def _greedy(cand, a, n):
+    return [int(cand.ids[r][np.lexsort((cand.ids[r], -cand.values[r]))[0]]) for r in range(a, a + n)]
+
+
+def _truth(fw, P, pending, n):
+    """The serial tokens after ``pending`` at P (probes: runs without a commit)."""
+
+    out, toks = [], [pending]
+    for _ in range(n):
+        c = fw.window([Rows(0, P, tuple(toks))], count=4)
+        out.append(_greedy(c, len(toks) - 1, 1)[0])
+        toks.append(out[-1])
+    fw.slots[0].pending = None
+    return out
+
+
+def _committed(fw):
+    s = fw.slots[0]
+    lo = max(0, s.pos - fw.cfg.sliding_window)
+    rows = torch.arange(lo, s.pos, dtype=torch.long) % fw.ring
+    out = [s.pos, list(s.tail)]
+    out += [v for L in sorted(s.swa) for v in s.swa[L].raw(rows).values()]
+    for L in sorted(s.comp):
+        r = next(b.ratio for b in fw.blocks if b.index == L)
+        cr = torch.arange(0, s.pos // r, dtype=torch.long)
+        for st in (s.comp[L], s.ikeys[L]):
+            ph = st.phys(cr)
+            ts = [st.values, st.scales] if hasattr(st, "values") else [st.data]
+            out += [t.index_select(0, ph.to(t.device)).contiguous().view(torch.uint8).cpu().numpy() for t in ts]
+    out += [s.carry[L].cpu().numpy() for L in sorted(s.carry)]
+    return out
+
+
+def _same(a, b):
+    assert len(a) == len(b)
+    for x, y in zip(a, b):
+        if isinstance(x, np.ndarray):
+            assert x.shape == y.shape and np.array_equal(x.view(np.uint8), y.view(np.uint8))
+        else:
+            assert x == y
+
+
+def test_branches_isolated_and_committed(ck, monkeypatch):
+    """Rounds where the main chain wins, sibling 1 wins and sibling 2 wins (1-3 drafts kept), windows crossing the
+    256-token page: the tree forward's candidates and committed state equal a plain forward's."""
+
+    from tensorfold.families.deepseek_v41.cuda.tree import Branches
+
+    prompt = [int(t) for t in np.random.default_rng(5).integers(3, 250, size=244)]
+    a, b = _bound(ck, True, monkeypatch), _bound(ck, False, monkeypatch)
+    assert a.tree is not None and b.tree is None and len(a.slots) == 3
+    for fw in (a, b):
+        fw.reset(0)
+        fw.prefill([Piece(0, 0, tuple(prompt[:-1]))], mode="full")
+    pending, wins = prompt[-1], []
+    for r in range(7):
+        P = a.slots[0].pos
+        t = _truth(b, P, pending, 3)
+        bad = [x for x in range(3 + r, 250) if x not in t][:3]          # tokens the target does not choose next
+        case = r % 3
+        if case == 0:       # the chain wins (2 drafts kept), the siblings lose
+            main, sibs = [pending, t[0], t[1], bad[0]], [[pending, bad[1], t[1]], [pending, bad[2]]]
+        elif case == 1:     # sibling 1 wins, 2 drafts kept
+            main, sibs = [pending, bad[0]], [[pending, t[0], t[1], bad[1]], [pending, bad[2]]]
+        else:               # sibling 2 wins, all 3 kept
+            main, sibs = [pending, bad[0], t[1]], [[pending, bad[1]], [pending, *t]]
+        sibs = [s for s in sibs if s[1] != main[1]]
+        br = Branches(P, tuple(main))
+        for j, toks in enumerate(sibs, 1):
+            sid = a.tree.shadows.fork(0, j, P, len(toks))
+            br.sib.append((j, sid, tuple(toks), 0.5))
+        a.tree.plans = {0: br}
+        a.depth.choose(0, [0.5] * (len(main) - 1), len(main) - 1)
+        ca = a.window([Rows(0, P, tuple(main))], count=4)
+        shown = a.took([Rows(0, P, tuple(main))])[0]
+        cb = b.window([shown], count=4)
+        assert np.array_equal(ca.ids, cb.ids) and np.array_equal(ca.values, cb.values), r
+        chosen = _greedy(ca, 0, len(shown.tokens))
+        acc = accepted(shown.tokens, chosen)
+        assert chosen[:min(acc + 1, 3)] == t[:acc + 1]
+        wins.append((a.tree.won[0][0], acc))
+        a.commit(0, acc)
+        b.commit(0, acc)
+        _same(_committed(a), _committed(b))
+        da, qa = a.drafter.propose([0], [chosen[acc]], [a.slots[0].pos])
+        db, qb = b.drafter.propose([0], [chosen[acc]], [b.slots[0].pos])
+        assert da == db and qa == qb
+        pending = chosen[acc]
+    assert {w for w, _ in wins} == {0, 1, 2} and max(acc for w, acc in wins if w) >= 2
+    assert a.slots[0].pos > 256 > len(prompt)
+
+
+# -- the batcher: drafted == serial ----------------------------------------------------------------------------------------
+def _oracle(fw, seqs):
+    """Siblings that know the serial reply: the true next token whenever the chain's first draft is wrong (else a
+    wrong one), its chain the serial tokens with the last one wrong every third round."""
+
+    tree = fw.tree
+    found: dict = {}
+
+    def alternatives(slot, start, pending, first, data, sampling):
+        tail = list(fw.slots[slot].tail)[-3:]
+        s = next((q for q in seqs if len(q) > start + 1 and q[start] == pending
+                  and q[max(0, start - len(tail)):start] == tail), None)
+        found[slot] = s
+        if s is None or s[start + 1] == first:
+            return [((first + 7) % 240 + 3, 0.2)]
+        return [(int(s[start + 1]), 0.9), ((first + 11) % 240 + 3, 0.05)]
+
+    def chain(slot, start, first, rows, data, sampling):
+        s = found.get(slot)
+        if s is None or s[start + 1] != first:
+            return [3] * (rows - 1)
+        out = [int(x) for x in s[start + 2:start + 1 + rows]]
+        if out and start % 3 == 0:
+            out[-1] = (out[-1] + 1) % 240 + 3
+        return out + [3] * (rows - 1 - len(out))
+
+    tree.alternatives, tree.chain = alternatives, chain
+
+
+@pytest.fixture(scope="module")
+def serial_long(ck):
+    b = DF.batcher(ck, DF.forward(ck, limit=LONG, dspark=False), capacity=LONG, pool_tokens=3 * LONG, depth=0)
+    return DF.run(b, [Job(p, N_LONG, s) for p, s in zip(LONG_PROMPTS, SAMPLINGS)])
+
+
+def _tree_run(ck, monkeypatch, slots, jobs_ix, serial):
+    monkeypatch.setenv("TF_DSV41_TREE", "3")
+    monkeypatch.setenv("TF_DSV41_TREE_ROWS", "2")
+    monkeypatch.setenv("TF_DSV41_DRAFT_DEPTH", "2")
+    fw = DF.forward(ck, slots=slots, limit=LONG)
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(2 + slots) * LONG)
+    c = Costs([10.0] * 16, 1.0)                 # every node pays: trees every round
+    fw.set_costs(c)
+    b.planner.costs = c
+    _oracle(fw, [LONG_PROMPTS[i] + serial[i] for i in jobs_ix])
+    jobs = [Job(LONG_PROMPTS[i], N_LONG, SAMPLINGS[i]) for i in jobs_ix]
+    got = DF.run(b, jobs)
+    assert got == [serial[i] for i in jobs_ix]
+    st = fw.tree.stats
+    assert st["trees"] > 0 and st["sib_wins"] > 0 and st["sib_tokens"] > st["sib_wins"] // 2
+    return fw
+
+
+def test_tree_drafted_equals_serial_four_slots(ck, serial_long, monkeypatch):
+    _tree_run(ck, monkeypatch, 4, [0, 1, 2, 3], serial_long)
+
+
+def test_tree_drafted_equals_serial_one_slot(ck, serial_long, monkeypatch):
+    _tree_run(ck, monkeypatch, 1, [0, 1], serial_long)
diff --git a/tests/test_dsv41_weights.py b/tests/test_dsv41_weights.py
