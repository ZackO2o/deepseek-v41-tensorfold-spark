index 0000000..0a3410a
--- /dev/null
+++ b/tests/cuda/test_dsv41_dense_gpu.py
@@ -0,0 +1,300 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9 ``dense``: x3dn v2 (``dense`` / ``x3dn.cu``, TF_DSV41_DENSE) on the GPU.
+
+- random trellises at the real shapes and widths (x4: wq_a + wkv + compressor, 5 bits; x2 at 6 bits (layer 0); q:
+  wq_b + indexer wq_b; o: wo_a's 4 groups from column slices of o; wo_b; the drafter's 4-bit wo_b; the indexer's
+  8-bit wk): fp32 outputs within fp32 rounding of float64 (W_q from the GPU unpack, the rotated input from upstream's
+  rot_in) and of upstream's kernel, R = 1..17, 32, 33, 64 (row blocks); bf16 outputs too;
+- the structure, bit for bit: a row alone == in a window (1..33 rows); every matrix of a group == the matrix alone
+  (x2 vs x4); ring depths 2-4 and PDL on / off give the same bits; another split (TF_DSV41_DENSE_SPLIT) other bits
+  at rounding level, still row-invariant; a CUDA graph replayed on new inputs == eager; counters left at zero;
+- the wiring: ``linear.Exl3`` and ``fused_proj.Fused`` route to x3dn when ``dense.wanted`` (== the group's bits);
+- [G9] GB/s a shape with a COLD L2 (densebench.cold_us: a 256 MB write between calls, in a graph), R = 1, 2, 4, 8,
+  16: x3dn vs upstream / x3seg (the warm replay printed apart);
+- the real weights (``TF_DSV41_TEST_MODEL``, rank ``TF_DSV41_TEST_RANK``, layers ``TF_DSV41_FP_LAYERS``): every dense
+  output of ``blocks.attention`` under TF_DSV41_DENSE=attn fused == unfused, rows of a 16-row window == alone, drift
+  from upstream's bits printed (< 2e-2).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA")
+
+BF, F32, F64 = torch.bfloat16, torch.float32, torch.float64
+GROUPS = {
+    "x4": ([(5120, 1280, 5), (5120, 512, 5), (5120, 512, 5), (5120, 512, 5)], [0, 1, 2, 2]),
+    "x2_l0": ([(5120, 1280, 6), (5120, 512, 6)], [0, 1]),
+    "q": ([(1280, 16384, 5), (1280, 4096, 5)], [0, 1]),
+    "o": ([(4096, 1024, 5)] * 4, [0, 0, 0, 0]),
+    "wo_b": ([(4096, 5120, 5)], [0]),
+    "draft_wo_b": ([(4096, 5120, 4)], [0]),
+    "ix_wk": ([(512, 128, 8)], [0]),
+}
+
+
+def _lin(k: int, n: int, bits: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cuda")
+
+
+@pytest.fixture(scope="module")
+def groups():
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+
+    out = {}
+    for i, (name, (shapes, outs)) in enumerate(GROUPS.items()):
+        lins = [_lin(k, n, b, 100 * i + j) for j, (k, n, b) in enumerate(shapes)]
+        out[name] = (lins, outs, D.Group(lins, outs))
+    return out
+
+
+def _inputs(name, lins, R, gen):
+    if name == "o":
+        o = (torch.randn((R, 4 * 4096), generator=gen, device="cuda") * 0.3).to(BF)
+        return [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]
+    x = torch.randn((R, lins[0].k), generator=gen, device="cuda").to(BF)
+    return [x] * len(lins)
+
+
+def _cat(lins, ys, outs):
+    bufs: dict[int, list] = {}
+    for y, o in zip(ys, outs):
+        bufs.setdefault(o, []).append(y)
+    return [torch.cat(bufs[o], 1) for o in sorted(bufs)]
+
+
+def _upstream(lins, xs, outs, dtype):
+    ys = []
+    for lin, x in zip(lins, xs):
+        y = torch.empty((x.shape[0], lin.n), dtype=dtype, device="cuda")
+        for a in range(0, x.shape[0], 128):
+            lin(x[a:a + 128].contiguous(), out=y[a:a + 128])
+        ys.append(y)
+    return _cat(lins, ys, outs)
+
+
+_H = {}
+
+
+def _float64(lins, xs, outs):
+    from tensorfold.cuda.exl3.linear import _ext
+
+    if "h" not in _H:
+        i = torch.arange(128)
+        par = torch.tensor([bin(v).count("1") & 1 for v in range(128)])[i[:, None] & i[None, :]]
+        _H["h"] = (1.0 - 2.0 * par.double()).cuda() / 128 ** 0.5
+    ys = []
+    for lin, x in zip(lins, xs):
+        xh = torch.empty((x.shape[0], lin.k), dtype=torch.float16, device="cuda")
+        _ext().rot_in(x.contiguous(), lin.suh, xh)
+        y = xh.double() @ lin.unpack().double()
+        y = (y.view(-1, lin.n // 128, 128) @ _H["h"]).view(-1, lin.n) * lin.svh.double()
+        ys.append(y)
+    return _cat(lins, ys, outs)
+
+
+def _zero(group):
+    return not (group.counters != 0).any().item()
+
+
+@pytest.mark.parametrize("name", list(GROUPS))
+def test_within_rounding_of_float64_and_upstream(groups, name):
+    lins, outs, grp = groups[name]
+    gen = torch.Generator(device="cuda").manual_seed(3)
+    worst = 0.0
+    for R in [*range(1, 18), 32, 33, 64]:
+        xs = _inputs(name, lins, R, gen)
+        got = grp(xs, F32)
+        want = _float64(lins, xs, outs)
+        up = _upstream(lins, xs, outs, F32)
+        for a, w, u in zip(got, want, up):
+            scale = w.abs().max().item()
+            err = (a.double() - w).abs().max().item() / scale
+            worst = max(worst, err)
+            assert err <= 2e-5 and (a - u).abs().max().item() <= 4e-5 * scale, (name, R, err)
+        if R in (1, 5, 33):
+            gb = grp(xs, BF)
+            assert all(torch.equal(b, a.to(BF)) for a, b in zip(got, gb)), (name, R)
+        assert _zero(grp), (name, R)
+    print(f"[G9] dense {name}: R 1..64 within {worst:.1e} of float64 (max |diff| / max |y|)")
+
+
+@pytest.mark.parametrize("name", ["x4", "q", "o"])
+def test_rows_of_a_window_equal_alone(groups, name):
+    lins, outs, grp = groups[name]
+    gen = torch.Generator(device="cuda").manual_seed(4)
+    xs = _inputs(name, lins, 33, gen)
+    whole = grp(xs, F32)
+    for R in (1, 2, 5, 16, 17):
+        for a in (0, 33 - R, 9):
+            part = grp([x[a:a + R] for x in xs], F32)
+            assert all(torch.equal(p, w[a:a + R]) for p, w in zip(part, whole)), (name, R, a)
+
+
+def test_a_matrix_has_its_bits_in_any_group(groups):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+
+    lins, outs, x4 = groups["x4"]
+    x2 = D.Group(lins[:2], [0, 1])
+    gen = torch.Generator(device="cuda").manual_seed(5)
+    x = torch.randn((7, 5120), generator=gen, device="cuda").to(BF)
+    a, b = x4([x] * 4, F32), x2([x] * 2, F32)
+    assert torch.equal(a[0], b[0]) and torch.equal(a[1], b[1])
+    for i in range(2):
+        assert torch.equal(D.Group([lins[i]])(x, F32)[0], a[i])
+
+
+def test_schedule_knobs_never_change_bits(groups, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+
+    lins, outs, grp = groups["q"]
+    gen = torch.Generator(device="cuda").manual_seed(6)
+    xs = _inputs("q", lins, 19, gen)
+    ref = grp(xs, F32)
+    for pd, pdl in ((2, "0"), (4, "1"), (4, "0"), (3, "0")):
+        monkeypatch.setenv(D.ENV + "_PD", str(pd))
+        monkeypatch.setenv(D.ENV + "_PDL", pdl)
+        got = grp(xs, F32)
+        assert all(torch.equal(a, b) for a, b in zip(got, ref)), (pd, pdl)
+        assert _zero(grp)
+
+
+def test_other_splits_rounding_only_and_row_invariant(groups, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+
+    lins, outs, _ = groups["wo_b"]
+    gen = torch.Generator(device="cuda").manual_seed(10)
+    xs = _inputs("wo_b", lins, 9, gen)
+    base = D.Group(lins, outs)(xs, F32)[0]
+    for sk in (1, 3, 8):
+        monkeypatch.setenv(D.ENV + "_SPLIT", f"4096x5120:{sk}")
+        g = D.Group(lins, outs)
+        got = g(xs, F32)[0]
+        assert (got - base).abs().max().item() <= 4e-5 * base.abs().max().item(), sk
+        for r in (0, 8):
+            assert torch.equal(g([x[r:r + 1] for x in xs], F32)[0], got[r:r + 1]), (sk, r)
+        assert _zero(g)
+
+
+def test_graph_replay(groups):
+    lins, outs, grp = groups["x4"]
+    gen = torch.Generator(device="cuda").manual_seed(7)
+    x = torch.randn((3, 5120), generator=gen, device="cuda").to(BF)
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        grp([x] * 4, BF)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        ys = grp([x] * 4, BF)
+    for _ in range(3):
+        x.copy_(torch.randn((3, 5120), generator=gen, device="cuda").to(BF))
+        g.replay()
+        torch.cuda.synchronize()
+        want = grp([x] * 4, BF)
+        assert all(torch.equal(a, b) for a, b in zip(ys, want))
+        assert _zero(grp)
+
+
+def test_wiring(groups, monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+    from tensorfold.families.deepseek_v41.cuda import linear as LN
+
+    lins, outs, grp = groups["x4"]
+    gen = torch.Generator(device="cuda").manual_seed(8)
+    x = torch.randn((4, 5120), generator=gen, device="cuda").to(BF)
+    want = grp([x] * 4, BF)
+    monkeypatch.setenv(D.ENV, "attn")
+    for lin in lins:
+        lin.x3dn = True
+    try:
+        f = FP.Fused(lins, outs)
+        assert f.dense() is not None and all(torch.equal(a, b) for a, b in zip(f(x, BF), want))
+        assert torch.equal(LN.Exl3(lins[1])(x, BF), want[1])
+        monkeypatch.setenv(D.ENV, "0")
+        assert f.dense() is None
+        up = _upstream(lins, [x] * 4, outs, BF)
+        assert all(torch.equal(a, b) for a, b in zip(f(x, BF), up))
+    finally:
+        for lin in lins:
+            lin.x3dn = False
+
+
+def test_gbps_a_shape_cold_l2(groups):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+    from tensorfold.families.deepseek_v41.cuda import densebench as DB
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+    gen = torch.Generator(device="cuda").manual_seed(9)
+    for name, (lins, outs, grp) in groups.items():
+        mb = D.nbytes(lins) / 1e6
+        fz = FP.Fused(lins, outs)
+        for R in (1, 2, 4, 8, 16):
+            xs = _inputs(name, lins, R, gen)
+            t_d = DB.cold_us(lambda xs=xs, grp=grp: grp(xs, BF), 20)
+            t_u = DB.cold_us(lambda xs=xs, fz=fz: fz(xs, BF), 20)
+            w_d = DB.warm_us(lambda xs=xs, grp=grp: grp(xs, BF), 20)
+            w_u = DB.warm_us(lambda xs=xs, fz=fz: fz(xs, BF), 20)
+            print(f"[G9] dense {name} ({mb:.2f} MB) R={R} cold L2: x3seg/upstream {t_u:.1f} us = "
+                  f"{mb / t_u * 1e3:.0f} GB/s -> x3dn {t_d:.1f} us = {mb / t_d * 1e3:.0f} GB/s (warm {w_u:.1f} -> "
+                  f"{w_d:.1f} us)", flush=True)
+
+
+# -- the real weights -----------------------------------------------------------------------------------------------
+def _model() -> Path | None:
+    p = Path(os.environ.get("TF_DSV41_TEST_MODEL", "/model"))
+    return p if (p / "config.json").is_file() else None
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: the checkpoint folder")
+def test_real_layers(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import dense as D
+    from tensorfold.families.deepseek_v41.cuda import projbench as PB
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    root = _model()
+    cfg = Config.from_file(root / "config.json")
+    rank = int(os.environ.get("TF_DSV41_TEST_RANK", "0"))
+    raw = os.environ.get("TF_DSV41_FP_LAYERS", "all")
+    layers = range(cfg.num_hidden_layers) if raw == "all" else [int(v) for v in raw.split(",")]
+    ld = W.Loader(cfg, W.Shards(root), rank, 2, "cuda")
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    drift = 0.0
+    for L in layers:
+        A = PB.attn_of(cfg, ld, L, "cuda")
+        monkeypatch.setenv(D.ENV, "0")
+        (_, _, G), = PB.set_plan([(L, A)], "upstream")
+        x16 = torch.randn((16, cfg.hidden_size), generator=gen, device="cuda").to(BF)
+        qr16 = torch.randn((16, cfg.q_lora_rank), generator=gen, device="cuda").to(BF)
+        o16 = (torch.randn((16, 16384), generator=gen, device="cuda") * 0.3).to(BF)
+        base = PB.dense(A, G, x16, qr16, o16, True)
+        monkeypatch.setenv(D.ENV, "attn")
+        (_, _, G), = PB.set_plan([(L, A)], "upstream")      # build() marks the attention's matrices
+        whole = PB.dense(A, G, x16, qr16, o16, True)
+        for R in (1, 2, 3, 5, 8, 16):
+            x, qr, o = x16[:R], qr16[:R], o16[:R]
+            got = PB.dense(A, G, x, qr, o, True)
+            want = PB.dense(A, G, x, qr, o, False)
+            assert all(torch.equal(a, b) for a, b in zip(got, want)), (L, R)      # fused == unfused
+            assert all(torch.equal(a, b[:R]) for a, b in zip(got, whole)), (L, R)  # rows of a window
+        for a, b in zip(whole, base):
+            drift = max(drift, ((a.float() - b.float()).abs().max() / b.float().abs().max()).item())
+        del A, G
+    assert drift < 2e-2
+    print(f"[G9] dense real layers {list(layers)[:3]}..{list(layers)[-1]} rank {rank}: fused == unfused, rows of a "
+          f"window == alone, bit for bit; drift vs upstream {drift:.2e}")
