diff --git a/tests/test_dsv41_budget.py b/tests/test_dsv41_budget.py
new file mode 100644
index 0000000..09318ed
--- /dev/null
+++ b/tests/test_dsv41_budget.py
@@ -0,0 +1,288 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Expert-budgeted verification (families/deepseek_v41/cuda/budget.py) on the CPU: the knobs, the allowed set
+against a hand-worked window, the kernel in Triton's interpreter == the torch reference, row 1 of every segment bit
+for bit the router's, per-slot independence (a segment alone == in any window, row-mode meta with padding == the
+per-segment meta), at most B new experts a segment and an emulator of upstream's ``group``: an out-of-budget
+expert is never listed (never read), the window context (prompts, 1-row windows, the knob off: exact)."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import budget as BU  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1"
+E, K, S = 384, 6, 7
+DROP = E + 1
+
+
+def _window(lens, seed, E=E, spread=1.0):
+    """Router-consistent rows: each segment's rows share a base logit vector (drafts overlap the pending row's
+    experts), picks = top-6 of s + bias, weights 1.5 s / sum s (the router's), the shared slot (E, 1.0)."""
+
+    g = torch.Generator().manual_seed(seed)
+    bias = (torch.rand(E, generator=g) * 0.2).to(torch.float32)
+    rows = []
+    for n in lens:
+        base = torch.randn(E, generator=g) * 2.0
+        for _ in range(n):
+            rows.append(base + spread * torch.randn(E, generator=g))
+    lg = torch.stack(rows).to(torch.float32)
+    s = BU._score(lg)
+    order = torch.sort(-(s + bias[None, :]), dim=-1, stable=True).indices[:, :K]
+    sv = s.gather(1, order)
+    tot = torch.zeros(lg.shape[0])
+    for i in range(K):
+        tot = tot + sv[:, i]
+    w = 1.5 * (sv / tot[:, None])
+    R = lg.shape[0]
+    pick = torch.cat([order.to(torch.int32), torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous()
+    wts = torch.cat([w, torch.ones((R, 1))], 1).to(torch.float32).contiguous()
+    return pick, wts, lg, bias
+
+
+def _spans(lens):
+    out, a = [], 0
+    for n in lens:
+        out.append((a, a + n))
+        a += n
+    return out
+
+
+def _cfg(b, mode="sub", accept=0.6, beta=0.5):
+    return BU.Cfg(b, mode, accept, beta)
+
+
+# -- knobs ---------------------------------------------------------------------------------------------------------
+def test_parse():
+    assert not BU.parse({}).on
+    assert not BU.parse({BU.ENV: "off"}).on
+    c = BU.parse({BU.ENV: "4", BU.ENV_MODE: "drop", BU.ENV_ACCEPT: "0.8", BU.ENV_BETA: "1"})
+    assert (c.budget, c.mode, c.accept, c.beta) == (4, "drop", 0.8, 1.0)
+    assert BU.parse({BU.ENV: "0"}).on and BU.parse({BU.ENV: "0"}).budget == 0
+    for bad in ({BU.ENV: "-1"}, {BU.ENV: "x"}, {BU.ENV: "2", BU.ENV_MODE: "keep"}, {BU.ENV: "2", BU.ENV_ACCEPT: "0"}):
+        with pytest.raises(ValueError):
+            BU.parse(bad)
+    assert set(BU.KNOBS) <= set(__import__("tensorfold.families.deepseek_v41.cuda.calib",
+                                           fromlist=["KNOBS"]).KNOBS)       # budgeted windows calibrate apart
+
+
+# -- the rule by hand ----------------------------------------------------------------------------------------------
+def test_allowed_set_by_hand():
+    """Row 0 (pending) {0..5}; drafts: row 1 holds 10 (w .3) and 11 (.2), row 2 holds 11 (.3) and 12 (.6).
+    alpha = 1 (ACCEPT 1): u_10 = .3, u_11 = .5, u_12 = .6 -> B = 2 allows {12, 11}; with ACCEPT .25, beta 1
+    (alpha_1 = .25, alpha_2 = .0625): u_10 = .075, u_11 = .06875, u_12 = .0375 -> {10, 11}."""
+
+    pick = torch.tensor([[0, 1, 2, 3, 4, 5, E], [0, 1, 2, 3, 10, 11, E], [0, 1, 2, 3, 11, 12, E]], dtype=torch.int32)
+    wts = torch.tensor([[.25] * 6 + [1.0], [.25, .25, .25, .25, .3, .2, 1.0], [.1, .1, .1, .1, .3, .6, 1.0]],
+                       dtype=torch.float32)
+    meta = BU.meta_spans([(0, 3)], 3, "cpu")
+    sets = BU.allowed_sets(pick, wts, meta, K, 2, _cfg(2, accept=1.0).ratio)
+    assert sets[0] == ({0, 1, 2, 3, 4, 5}, [12, 11])
+    sets = BU.allowed_sets(pick, wts, meta, K, 2, _cfg(2, accept=0.25, beta=1.0).ratio)
+    assert sets[0][1] == [10, 11]
+    p, w = BU.reference(pick, wts, None, None, meta, K, _cfg(1, "drop", accept=1.0), DROP)
+    assert torch.equal(p[0], pick[0]) and torch.equal(w[0], wts[0])                  # row 1 untouched
+    assert p[1].tolist() == [0, 1, 2, 3, DROP, DROP, E] and w[1, 4] == 0 and w[1, 5] == 0
+    assert p[2].tolist() == [0, 1, 2, 3, DROP, 12, E] and w[2, 5] == wts[2, 5]       # kept weight: the router's
+
+
+def test_substitute_takes_best_allowed_and_keeps_original_mass():
+    pick, wts, lg, bias = _window([5], 3, spread=2.5)
+    meta = BU.meta_spans([(0, 5)], 5, "cpu")
+    cfg = _cfg(0)
+    p, w = BU.reference(pick, wts, lg, bias, meta, K, cfg, DROP)
+    anchors = set(pick[0, :K].tolist())
+    s = BU._score(lg)
+    for r in range(1, 5):
+        mine = pick[r, :K].tolist()
+        assert set(p[r, :K].tolist()) <= anchors | {DROP}
+        free = sorted((e for e in anchors if e not in mine), key=lambda e: (-float(s[r, e] + bias[e]), e))
+        outs = [k for k in range(K) if mine[k] not in anchors]
+        for m, k in enumerate(outs):
+            if m < len(free):
+                assert int(p[r, k]) == free[m]
+                want = 1.5 * float(s[r, free[m]]) / float(s[r, pick[r, :K].long()].sum())
+                assert abs(float(w[r, k]) - want) < 1e-5            # normalized by the ORIGINAL top-6 mass
+            else:
+                assert int(p[r, k]) == DROP and float(w[r, k]) == 0.0
+        assert float(w[r, :K].sum()) <= 1.5 + 1e-5                  # never renormalized up past the router's 1.5
+
+
+# -- kernel == reference -----------------------------------------------------------------------------------------
+def _close(p1, w1, p2, w2):
+    assert torch.equal(p1, p2)
+    same = w1 == w2
+    assert torch.allclose(w1, w2, rtol=2e-6, atol=0)
+    return same
+
+
+LENS = [[4], [1, 3, 5], [2, 16, 1], [6, 6, 6, 6], [3, 1, 1, 7]]
+
+
+@pytest.mark.skipif(not INTERP, reason="the interpreter (a GPU runs tests/cuda)")
+@pytest.mark.parametrize("lens", LENS)
+@pytest.mark.parametrize("b,mode", [(0, "sub"), (2, "sub"), (4, "drop"), (8, "sub")])
+def test_kernel_equals_reference(lens, b, mode):
+    pick, wts, lg, bias = _window(lens, 11 + len(lens) + b)
+    R = pick.shape[0]
+    meta = BU.meta_spans(_spans(lens), R, "cpu")
+    cfg = _cfg(b, mode)
+    want = BU.reference(pick, wts, lg, bias, meta, K, cfg, DROP)
+    got = BU.apply(pick.clone(), wts.clone(), lg, bias, meta, K, cfg, DROP)
+    _close(got[0], got[1], *want)
+    for r in range(R):                                              # kept slots: the router's bits
+        keep = got[0][r] == pick[r]
+        assert torch.equal(got[1][r][keep], wts[r][keep])
+
+
+# -- invariants (reference: the kernel == it above) -----------------------------------------------------------------
+@pytest.mark.parametrize("b", [0, 2, 4, 8])
+def test_row1_exact_and_budget_bound(b):
+    lens = [5, 1, 4, 7]
+    pick, wts, lg, bias = _window(lens, 21 + b)
+    meta = BU.meta_spans(_spans(lens), pick.shape[0], "cpu")
+    p, w = BU.reference(pick, wts, lg, bias, meta, K, _cfg(b), DROP)
+    for a, z in _spans(lens):
+        assert torch.equal(p[a], pick[a]) and torch.equal(w[a].view(torch.int32), wts[a].view(torch.int32))
+        anchors = set(pick[a, :K].tolist())
+        used = {int(e) for e in p[a:z, :K].reshape(-1)} - {DROP}
+        assert anchors <= used and len(used - anchors) <= b
+        natural = {int(e) for e in pick[a:z, :K].reshape(-1)}
+        assert used <= natural                                      # only experts the drafts asked for
+        assert torch.equal(p[a:z, K], pick[a:z, K]) and torch.all(w[a:z, K] == 1.0)    # shared slot untouched
+
+
+def test_large_budget_is_exact():
+    lens = [6, 3]
+    pick, wts, lg, bias = _window(lens, 30)
+    meta = BU.meta_spans(_spans(lens), 9, "cpu")
+    p, w = BU.reference(pick, wts, lg, bias, meta, K, _cfg(64), DROP)
+    assert torch.equal(p, pick) and torch.equal(w, wts)
+
+
+def test_per_slot_independence():
+    """A segment's rows are the same bits alone and in any window (other segments, any position)."""
+
+    lens = [3, 5, 2, 6]
+    pick, wts, lg, bias = _window(lens, 40)
+    spans = _spans(lens)
+    cfg = _cfg(2)
+    whole = BU.reference(pick, wts, lg, bias, BU.meta_spans(spans, pick.shape[0], "cpu"), K, cfg, DROP)
+    for a, z in spans:
+        sl = slice(a, z)
+        alone = BU.reference(pick[sl], wts[sl], lg[sl], bias, BU.meta_spans([(0, z - a)], z - a, "cpu"), K, cfg, DROP) \
+            if z - a > 1 else (pick[sl], wts[sl])
+        assert torch.equal(alone[0], whole[0][sl]) and torch.equal(alone[1], whole[1][sl])
+    # reversed window order: each segment's rows unchanged
+    order = [3, 1, 0, 2]
+    idx = torch.cat([torch.arange(*spans[i]) for i in order])
+    rspans = _spans([lens[i] for i in order])
+    rev = BU.reference(pick[idx], wts[idx], lg[idx], bias, BU.meta_spans(rspans, len(idx), "cpu"), K, cfg, DROP)
+    assert torch.equal(rev[0], whole[0][idx]) and torch.equal(rev[1], whole[1][idx])
+
+
+def test_row_mode_meta_with_padding():
+    """``meta_rows`` from a real row table (rowtab.plan_rows, padded) == ``meta_spans`` on the real rows; padding
+    rows join the last segment at its last row's depth, so they budget like their mirror (no extra experts)."""
+
+    from tensorfold.families.deepseek_v41.cuda import rowtab as RT
+
+    lens = [3, 1, 4]
+    mix = [(2, 40, 3), (0, 7, 1), (1, 100, 4)]
+    t = torch.from_numpy(RT.plan_rows(mix, list(range(8)), 12, 3))
+    meta = BU.meta_rows(t[RT.RSLOT], t[RT.WSLOT], t[RT.PREV])
+    want = BU.meta_spans(_spans(lens), 8, "cpu")
+    assert torch.equal(meta[:, :8], want)
+    assert meta[0, 8:].tolist() == [4] * 4 and meta[1, 8:].tolist() == [4] * 4
+    pick, wts, lg, bias = _window(lens, 50)
+    pad = lambda x: torch.cat([x, x[-1:].expand(4, *x.shape[1:])]).contiguous()      # noqa: E731
+    p, w = BU.reference(pad(pick), pad(wts), pad(lg), bias, meta, K, _cfg(2), DROP)
+    q, v = BU.reference(pick, wts, lg, bias, want, K, _cfg(2), DROP)
+    assert torch.equal(p[:8], q) and torch.equal(w[:8], v)
+    for r in range(8, 12):
+        assert torch.equal(p[r], q[7]) and torch.equal(w[r], v[7])
+
+
+def test_long_segments_and_one_row_windows_stay_exact():
+    assert BU.meta_spans([(0, 1), (1, 2)], 2, "cpu") is None
+    assert BU.meta_spans([(0, 40)], 40, "cpu") is None
+    meta = BU.meta_spans([(0, 20), (20, 23)], 23, "cpu")
+    assert meta[1, :20].tolist() == [1] * 20 and meta[1, 20:].tolist() == [3] * 3
+
+
+# -- grouping: an out-of-budget expert is never read -------------------------------------------------------------
+def group_emu(pick, E):
+    flat = pick.reshape(-1).tolist()
+    return sorted({e for e in flat if 0 <= e < E})
+
+
+@pytest.mark.parametrize("mode", ["sub", "drop"])
+def test_grouping_reads_only_allowed(mode):
+    lens = [4, 6]
+    pick, wts, lg, bias = _window(lens, 60, spread=2.0)
+    meta = BU.meta_spans(_spans(lens), 10, "cpu")
+    cfg = _cfg(2, mode)
+    p, w = BU.reference(pick, wts, lg, bias, meta, K, cfg, DROP)
+    sets = BU.allowed_sets(pick, wts, meta, K, 2, cfg.ratio)
+    allowed = set().union(*(a | set(x) for a, x in sets.values())) | {E}
+    listed = group_emu(p, E + 1)
+    assert set(listed) <= allowed and DROP not in listed
+    assert len(listed) < len(group_emu(pick, E + 1))                # the window reads fewer experts
+    for r in range(10):
+        for k in range(K):
+            if int(p[r, k]) == DROP:
+                assert float(w[r, k]) == 0.0
+
+
+# -- the window context ------------------------------------------------------------------------------------------
+def test_window_context():
+    on = _cfg(2)
+    with BU.window([(0, 3)], n=3, device="cpu", cfg=on) as plan:
+        assert plan is not None and BU.current() is plan
+        assert BU.plan_for(type("M", (), {"topk": 6})(), 3) is plan
+        assert BU.plan_for(type("M", (), {"topk": 6})(), 4) is None          # a call of other rows: exact
+    assert BU.current() is None
+    with BU.window([(0, 3)], n=3, device="cpu", prefill=True, cfg=on) as plan:
+        assert plan is None                                                  # prompt rows: exact
+    with BU.window([(0, 3)], n=3, device="cpu", cfg=_cfg(None)) as plan:
+        assert plan is None                                                  # knob off
+    with BU.window([(0, 1), (1, 2)], n=2, device="cpu", cfg=on) as plan:
+        assert plan is None                                                  # 1-row windows
+
+
+def test_twin_moe_budgets_draft_rows(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import moe as M
+
+    D, En = 8, 16
+    g = torch.Generator().manual_seed(70)
+    gate = torch.randn((En, D), generator=g)
+    bias = torch.zeros(En)
+
+    class Lin:
+        def __init__(self, a, b):
+            self.m = torch.randn((a, b), generator=g, dtype=torch.float64)
+
+        def __call__(self, h, dt):
+            return h.to(torch.float64) @ self.m
+
+    experts = [M.TwinExpert(Lin(D, 4), Lin(4, D), Lin(D, 4)) for _ in range(En + 1)]
+    twin = M.TwinMoE(gate, bias, experts, 4, 1.5, 10.0)
+    x = torch.randn((5, D), generator=g, dtype=torch.float64)
+    full = twin(x)
+    pick0 = twin.last_pick.clone()
+    with BU.window([(0, 5)], n=5, device="cpu", cfg=_cfg(0, "drop")):
+        out = twin(x)
+    pick = twin.last_pick
+    assert torch.equal(out[0], full[0]) and torch.equal(pick[0], pick0[0])  # row 1 exact
+    assert {int(e) for e in pick[:, :4].reshape(-1)} <= set(pick0[0, :4].tolist()) | {len(experts)}
