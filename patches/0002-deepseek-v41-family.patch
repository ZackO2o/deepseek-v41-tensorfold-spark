new file mode 100644
index 0000000..70a895f
--- /dev/null
+++ b/tests/test_dsv41_fp8_keys_interp.py
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""FP8 index keys (TF_DSV41_INDEX_KV=fp8: the kit's per-token key, 132 bytes a row instead of 256; -0.35 GiB a rank
+at 4 x 300K): the Triton write (``compress.index_k``) stores ``fmt.key_quant``'s bytes, the scoring kernels read them
+back as exactly the values TF_DSV41_INDEX_KEY_SIM=fp8 measured (G2: top-1 99.646% vs 99.634% with bf16 keys), so the
+scores and selections equal the bf16 kernels run on the round-tripped keys, bit for bit (Triton interpreter)."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+
+os.environ.setdefault("TRITON_INTERPRET", "1")
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import backend, fmt, index, stores  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+
+pytestmark = pytest.mark.skipif(os.environ.get("TRITON_INTERPRET") != "1" and not torch.cuda.is_available(),
+                                reason="Triton interpreter or CUDA")
+DEV = "cuda" if os.environ.get("TRITON_INTERPRET") != "1" and torch.cuda.is_available() else "cpu"
+
+
+def _keys(n, seed):
+    g = torch.Generator().manual_seed(seed)
+    k = torch.randn(n, 128, generator=g) * torch.logspace(-3, 1, n)[:, None]
+    k[0] = 0.0                                     # an all-zero key: amax floored at 1e-4
+    k[1, 5] = 3e-6                                 # a lone tiny value: e4m3 subnormals
+    return k.to(torch.bfloat16)
+
+
+def test_reference_format_roundtrip():
+    k = _keys(64, 1)
+    raw = fmt.key_quant(k)
+    assert raw.shape == (64, 132) and raw.dtype == torch.uint8
+    v = fmt.key_dequant(raw)
+    assert torch.equal(v, v.to(torch.bfloat16).float())                  # exactly bf16 values
+    assert torch.equal(fmt.key_dequant(fmt.key_quant(v.to(torch.bfloat16))), v)       # idempotent in value
+    rel = ((v - k.float()).abs().amax(-1) / k.float().abs().amax(-1).clamp(min=1e-4))
+    assert float(rel.max()) <= 2 ** -4 + 1e-6                             # e4m3: half an ulp of 3 mantissa bits
+    sim = k.clone()
+    backend.fp8_roundtrip_(sim)
+    assert torch.equal(sim.float(), v)
+
+
+def test_kernel_write_matches_reference_and_scores_match_bf16_on_roundtrip():
+    n = 40
+    g = torch.Generator().manual_seed(2)
+    k_pre = (torch.randn(n, 128, generator=g) * 3).to(torch.bfloat16)
+    w = (1 + 0.1 * torch.randn(128, generator=g)).to(torch.bfloat16)
+    from tensorfold.families.deepseek_v41.cuda.rope import Table, inv_freq
+
+    cs = Table.build(inv_freq(64, 160000.0, 16.0), 256).cs
+    pos = torch.tensor([0], dtype=torch.int32)
+    ik16 = torch.zeros(n, 128, dtype=torch.bfloat16)
+    ik8 = torch.zeros(n, 132, dtype=torch.uint8)
+    for ik in (ik16, ik8):
+        compress.index_k(k_pre.to(DEV), w.to(DEV), cs.to(DEV), ik, pos.to(DEV), n, 1)
+    assert torch.equal(ik8, fmt.key_quant(ik16))                         # the kernel's bytes == the reference's
+    rt = fmt.key_dequant(ik8).to(torch.bfloat16)
+    R = 6
+    qi = (torch.randn(R, 32, 128, generator=g)).to(torch.bfloat16).contiguous()
+    wt = torch.randn(R, 32, generator=g).abs().contiguous()
+    qpos = torch.tensor([n - R], dtype=torch.int32)
+    s8 = index.scores(qi, wt, ik8, qpos, R, n, 1)
+    s16 = index.scores(qi, wt, rt.contiguous(), qpos, R, n, 1)
+    assert torch.equal(s8, s16)
+    assert torch.equal(index.select(qi, wt, ik8, qpos, R, n, 1, topk=8), index.select(qi, wt, rt, qpos, R, n, 1, topk=8))
+
+
+def test_store_class_and_contiguous_allocation(monkeypatch):
+    k = _keys(16, 3)
+    st = stores.Keys(torch.zeros(16, 132, dtype=torch.uint8))
+    rows = torch.arange(16)
+    st.write(rows, k)
+    assert torch.equal(st.data, fmt.key_quant(k)) and torch.equal(st.read(rows), fmt.key_dequant(st.data))
+    raw = st.raw(rows[:4])
+    st2 = stores.Keys(torch.zeros(16, 132, dtype=torch.uint8))
+    st2.put_raw(rows[:4], raw)
+    assert torch.equal(st2.data[:4], st.data[:4])                          # snapshots move the bytes as they are
+    monkeypatch.setenv("TF_DSV41_INDEX_KV", "fp8")
+    assert backend.Triton.keys(None, 8, 128, "cpu").kernel().shape == (8, 132)
+    monkeypatch.setenv("TF_DSV41_INDEX_KV", "bf16")
+    assert backend.Triton.keys(None, 8, 128, "cpu").kernel().dtype == torch.bfloat16
