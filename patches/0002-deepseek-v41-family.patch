+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9 decode mHC site: ``mhc._site``'s SPLIT launch (a program a column block and a stream) restructured for 1-16 rows,
+with the same arithmetic (bit for bit: tests/test_dsv41_mhc_dec_interp.py, tests/cuda/test_dsv41_glue_gpu.py).
+
+G9 nsys (1-row verify window): ``_site`` is 80 launches of ~27 us, 2.17 ms a window, against a DRAM floor of ~8 us
+(each site reads the 2 MB fp32 ``fn``). The SPLIT program walks its 128 columns in 8 steps of 16; every step loads
+the four streams, both ranks' partials and its ``fn`` tile, then runs the post and the step's FMA chains, so a
+program waits a DRAM latency 8 times in a row, and at 80 registers x 8 warps only 144 of the 160 programs fit the 48
+SMs at once (a second wave). This kernel:
+
+- phase A, the whole block at once (elementwise, no chain): the four streams and the partials load together (one
+  latency), the post X'_j, the collapsed row and the taps are computed and stored, on a [RB, 128] tile (RB = the
+  rows rounded up to a power of two: a 1-row window loads 1 row, not 16);
+- a CTA barrier, then phase B: the 8 chain steps of 16 columns (``tl.dot`` ieee needs 16 rows) read X'_j and the
+  collapsed row back from the stores phase A just made (L1 / L2, not DRAM) and the ``fn`` tiles (pipelined loads);
+- 4 warps (``TF_DSV41_MHC_DEC_WARPS``): 4 programs an SM, all 160 in one wave.
+
+The chains are those of ``mhc._site``: the mixes of stream j over the block's columns in ascending order, the square
+sums against ones, the collapsed row's square sum; the same values (X'_j and c are the bf16 values phase A stored)
+in the same order, so every partial is the same bits. ``fn`` may be bf16 (``TF_DSV41_MHC_FN=bf16``, ``prepare``):
+half the bytes, widened exactly as it loads; that changes the mixes' values (the quality gate's business), not the
+determinism: row invariance, batched == alone, drafted == serial hold either way.
+
+Used by ``mhc._launch`` (``TF_DSV41_MHC_DEC``, default 1) for MIX launches of at most ``MAX_ROWS`` rows that SPLIT
+already takes (out of place, or a ``site`` with no post).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+MAX_ROWS = 16
+
+
+def _knob(name: str, default: str) -> str:
+    return os.environ.get(name, "").strip() or default
+
+
+def enabled() -> bool:
+    """``TF_DSV41_MHC_DEC`` (1, the default; 0 = ``mhc._site``'s SPLIT launch): bit for bit the same either way."""
+
+    return _knob("TF_DSV41_MHC_DEC", "1") != "0"
+
+
+def warps() -> int:
+    w = int(_knob("TF_DSV41_MHC_DEC_WARPS", "4"))
+    if w not in (2, 4, 8):
+        raise ValueError(f"TF_DSV41_MHC_DEC_WARPS={w} (2 / 4 / 8)")
+    return w
+
+
+def unroll() -> bool:
+    """``TF_DSV41_MHC_DEC_UNROLL`` (1, the default): phase B's 8 steps unrolled (their loads issue together)."""
+
+    return _knob("TF_DSV41_MHC_DEC_UNROLL", "1") != "0"
+
+
+def fn_bf16() -> bool:
+    """``TF_DSV41_MHC_FN`` (fp32, the default; bf16): the mixing weights kept as bf16 (half the bytes a site; a
+    numerics change: the G9 quality gate decides). Every mHC path reads the same tensor (prefill, decode, DSpark)."""
+
+    v = _knob("TF_DSV41_MHC_FN", "fp32")
+    if v not in ("fp32", "bf16"):
+        raise ValueError(f"TF_DSV41_MHC_FN={v} (fp32 / bf16)")
+    return v == "bf16"
+
+
+def prepare(hc):
+    """A block's ``Hc`` (weights.Hc: fn / base / scale) as the kernels should hold it: ``fn`` rounded to bf16 when
+    ``TF_DSV41_MHC_FN=bf16`` and on CUDA (the torch fallback keeps fp32), else unchanged."""
+
+    if hc is None or not fn_bf16() or hc.fn.device.type != "cuda" or hc.fn.dtype == torch.bfloat16:
+        return hc
+    import dataclasses
+
+    return dataclasses.replace(hc, fn=hc.fn.to(torch.bfloat16).contiguous())
+
+
+def applies(rows: int, mix: bool, split: bool) -> bool:
+    return enabled() and mix and split and 0 < rows <= MAX_ROWS
+
+
+@triton.jit
+def _post1(POST, cb, rra, ok, i, br, x0, x1, x2, x3):
+    """X'_i = bf16(post[i] * branch + (((comb[0, i] X_0 + comb[1, i] X_1) + comb[2, i] X_2) + comb[3, i] X_3)): the
+    expression of ``mhc._site`` (two roundings an ``a * b + c``: the launch has fp fusion off)."""
+
+    p = tl.load(POST + rra * 4 + i, mask=ok, other=0.0)
+    c0 = tl.load(cb + 0 + i, mask=ok, other=0.0)
+    c1 = tl.load(cb + 4 + i, mask=ok, other=0.0)
+    c2 = tl.load(cb + 8 + i, mask=ok, other=0.0)
+    c3 = tl.load(cb + 12 + i, mask=ok, other=0.0)
+    return (p[:, None] * br + (((c0[:, None] * x0 + c1[:, None] * x1) + c2[:, None] * x2)
+                               + c3[:, None] * x3)).to(tl.bfloat16)
+
+
+@triton.jit
+def _phase_a(X, x_stride, XOUT, G, g_rank, POST, COMB, PRE, C, TAP, tap_stride, R, b, j, lead, c0,
+             D: tl.constexpr, NB: tl.constexpr, RB: tl.constexpr, CA: tl.constexpr, WORLD: tl.constexpr,
+             POST_ON: tl.constexpr, COLLAPSE: tl.constexpr, TAP_ON: tl.constexpr):
+    """Columns [c0, c0 + CA) of block b, every row at once (elementwise): X'_j stored to XOUT; the lead (j == 0)
+    stores the collapsed row to C and the taps (the other programs compute them too, masked: no branch)."""
+
+    WIDE: tl.constexpr = 4 * D
+    CB: tl.constexpr = D // NB
+    ra = tl.arange(0, RB)
+    oka = ra < R
+    rra = tl.where(oka, ra, 0).to(tl.int64)
+    da = b * CB + c0 + tl.arange(0, CA)
+    ma = oka[:, None]
+    xa = rra[:, None] * x_stride + da[None, :]
+    x0 = tl.load(X + xa, mask=ma, other=0.0).to(tl.float32)
+    x1 = tl.load(X + xa + D, mask=ma, other=0.0).to(tl.float32)
+    x2 = tl.load(X + xa + 2 * D, mask=ma, other=0.0).to(tl.float32)
+    x3 = tl.load(X + xa + 3 * D, mask=ma, other=0.0).to(tl.float32)
+    y0 = x0
+    y1 = x1
+    y2 = x2
+    y3 = x3
+    if POST_ON:
+        g = tl.load(G + rra[:, None] * D + da[None, :], mask=ma, other=0.0).to(tl.float32)
+        for rk in tl.static_range(1, WORLD):
+            g = g + tl.load(G + rk * g_rank + rra[:, None] * D + da[None, :], mask=ma, other=0.0).to(tl.float32)
+        br = g.to(tl.bfloat16).to(tl.float32)
+        cb = COMB + rra * 16
+        vj = _post1(POST, cb, rra, oka, j, br, x0, x1, x2, x3)
+        tl.store(XOUT + rra[:, None] * WIDE + j * D + da[None, :], vj, mask=ma)
+        if COLLAPSE + TAP_ON > 0:
+            # the lead's outputs need every stream's X': the same expressions as ``mhc._site`` (the same bits)
+            ml = oka & lead
+            y0 = _post1(POST, cb, rra, ml, 0, br, x0, x1, x2, x3).to(tl.float32)
+            y1 = _post1(POST, cb, rra, ml, 1, br, x0, x1, x2, x3).to(tl.float32)
+            y2 = _post1(POST, cb, rra, ml, 2, br, x0, x1, x2, x3).to(tl.float32)
+            y3 = _post1(POST, cb, rra, ml, 3, br, x0, x1, x2, x3).to(tl.float32)
+    if COLLAPSE == 2:
+        q0 = tl.load(PRE + rra * 4 + 0, mask=oka, other=0.0)
+        q1 = tl.load(PRE + rra * 4 + 1, mask=oka, other=0.0)
+        q2 = tl.load(PRE + rra * 4 + 2, mask=oka, other=0.0)
+        q3 = tl.load(PRE + rra * 4 + 3, mask=oka, other=0.0)
+        cv = (((q0[:, None] * y0 + q1[:, None] * y1) + q2[:, None] * y2) + q3[:, None] * y3).to(tl.bfloat16)
+        tl.store(C + rra[:, None] * D + da[None, :], cv, mask=ma & lead)
+    elif COLLAPSE == 1:
+        tl.store(C + rra[:, None] * D + da[None, :], y0.to(tl.bfloat16), mask=ma & lead)
+    if TAP_ON:
+        tp = ((((y0 + y1) + y2) + y3) * 0.25).to(tl.bfloat16)
+        tl.store(TAP + rra[:, None] * tap_stride + da[None, :], tp, mask=ma & lead)
+
+
+@triton.jit
+def _step(X, x_stride, XOUT, FN, C, d, j, lead, rr, m2, mm, ones, acc, sq, sc, D: tl.constexpr,
+          POST_ON: tl.constexpr, COLLAPSE: tl.constexpr):
+    """One chain step over columns d [BK] of stream j: the mixes, the stream's square sum, the collapsed row's."""
+
+    WIDE: tl.constexpr = 4 * D
+    if POST_ON:
+        v = tl.load(XOUT + rr[:, None] * WIDE + j * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+    else:
+        v = tl.load(X + rr[:, None] * x_stride + j * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+    w = tl.load(FN + mm[None, :] * WIDE + (j * D + d)[:, None], mask=mm[None, :] < 24, other=0.0)
+    acc = tl.dot(v, w.to(tl.float32), acc, input_precision="ieee")
+    sq = tl.dot(v * v, ones, sq, input_precision="ieee")
+    if COLLAPSE > 0:
+        cf = tl.load(C + rr[:, None] * D + d[None, :], mask=m2 & lead, other=0.0).to(tl.float32)
+        sc = tl.dot(cf * cf, ones, sc, input_precision="ieee")
+    return acc, sq, sc
+
+
+@triton.jit
+def _site_dec(X, x_stride, XOUT, G, g_rank, POST, COMB, PRE, FN, PART, C, TAP, tap_stride, R,
+              D: tl.constexpr, NB: tl.constexpr, RB: tl.constexpr, CA: tl.constexpr, BK: tl.constexpr,
+              WORLD: tl.constexpr, POST_ON: tl.constexpr, COLLAPSE: tl.constexpr, TAP_ON: tl.constexpr,
+              UNROLL: tl.constexpr):
+    """Program (column block b, stream j); rows 0..R-1 (R <= 16). Inputs and outputs as ``mhc._site`` SPLIT.
+    Phase A in CA-column pieces (RB x CA <= 512 elements: no spills at 16 rows); UNROLL: phase B's 8 steps unrolled,
+    so their loads issue together (the chains still run in column order)."""
+
+    b = tl.program_id(0)
+    j = tl.program_id(1)
+    lead = j == 0
+    WIDE: tl.constexpr = 4 * D
+    CB: tl.constexpr = D // NB
+    for p in tl.static_range(CB // CA):
+        _phase_a(X, x_stride, XOUT, G, g_rank, POST, COMB, PRE, C, TAP, tap_stride, R, b, j, lead, p * CA,
+                 D, NB, RB, CA, WORLD, POST_ON, COLLAPSE, TAP_ON)
+    tl.debug_barrier()          # phase A's stores are visible to the whole CTA: phase B reads them back
+    # ---- phase B: the FMA chains, 16 columns a step in ascending order (tl.dot's minimum M is 16 rows) ----
+    rows = tl.arange(0, 16)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m2 = ok[:, None]
+    kk = tl.arange(0, BK)
+    mm = tl.arange(0, 32)
+    ones = tl.full((BK, 16), 1.0, tl.float32)
+    acc = tl.zeros((16, 32), tl.float32)
+    sq = tl.zeros((16, 16), tl.float32)
+    sc = tl.zeros((16, 16), tl.float32)
+    if UNROLL:
+        for t in tl.static_range(CB // BK):
+            acc, sq, sc = _step(X, x_stride, XOUT, FN, C, b * CB + t * BK + kk, j, lead, rr, m2, mm, ones, acc, sq,
+                                sc, D, POST_ON, COLLAPSE)
+    else:
+        for t in range(CB // BK):
+            acc, sq, sc = _step(X, x_stride, XOUT, FN, C, b * CB + t * BK + kk, j, lead, rr, m2, mm, ones, acc, sq,
+                                sc, D, POST_ON, COLLAPSE)
+    col0 = tl.arange(0, 16)[None, :] == 0
+    base = PART + (rr[:, None] * 4 * NB + b) * 32 + mm[None, :]
+    mine = tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, sq, 0.0), 1)[:, None], acc)
+    mine = tl.where(mm[None, :] == 25, tl.sum(tl.where(col0, sc, 0.0), 1)[:, None], mine)
+    keep = (mm[None, :] < 25) | ((mm[None, :] == 25) & lead)
+    tl.store(base + j * (NB * 32), mine, mask=m2 & keep)
+
+
+def _pow2(n: int) -> int:
+    return 1 << max(0, (n - 1).bit_length())
+
+
+def launch(x, xout, gathered, post, comb, pre, fn, part, c, tap, rows: int, d: int, nb: int, bk: int,
+           post_on: bool, collapse: int, launch_opts: dict) -> None:
+    """``mhc._site``'s SPLIT launch for ``rows`` <= 16 (``mhc._launch`` picks it): same arguments, same outputs."""
+
+    world = gathered.shape[0] if post_on else 1
+    dummy = x
+    rb = _pow2(rows)
+    nw = warps()
+    opts = dict(launch_opts)
+    cap = int(_knob("TF_DSV41_MHC_DEC_MAXNREG", "128"))
+    if cap and rb <= 4 and nw == 4:     # <= 128 registers: 4 programs an SM, the 160 in one wave (no spills: ptxas)
+        opts["maxnreg"] = cap
+    _site_dec[(nb, 4)](
+        x, x.stride(0), xout if post_on else dummy, gathered if post_on else dummy,
+        gathered.stride(0) if post_on else 0, post if post_on else dummy, comb if post_on else dummy,
+        pre if collapse == 2 else dummy, fn, part, c if collapse > 0 else dummy,
+        tap if tap is not None else dummy, tap.stride(0) if tap is not None else 0, rows,
+        D=d, NB=nb, RB=rb, CA=min(d // nb, max(16, 512 // rb)), BK=bk, WORLD=world, POST_ON=post_on,
+        COLLAPSE=collapse, TAP_ON=tap is not None, UNROLL=unroll(), num_warps=nw, **opts)
+
+
+__all__ = ["MAX_ROWS", "applies", "enabled", "fn_bf16", "launch", "prepare", "warps"]
