+@pytest.mark.parametrize("rt", RG.TILES)
+@pytest.mark.parametrize("nw", RG.NARROW_NW)
+def test_narrow_pipeline(rt, nw):
+    """The cp.async pipeline: one group a vector in vector order; wait_group n before step j leaves group j complete
+    (committed - n >= j + 1); the slot read holds vector j; a refill goes to the slot just read, after its read; smem
+    <= 48 KiB and >= the tail's ints."""
+
+    src = CU.read_text()
+    assert "constexpr int PD = NW <= 4 && RT <= 4 ? NV : NV / 2;" in src
+    assert "cp_wait_n(min(NV - j - 1, PD - 1));" in src
+    body = src[src.index("void cp_wait_n(int n)"):src.index("#undef DSV41_RG_W")]
+    cases = {int(k) for k in re.findall(r"DSV41_RG_W\((\d+)\)", body)}
+    pd = RG.narrow_depth(rt, nw)
+    for st in RG.narrow_schedule(rt, nw):
+        j = st["j"]
+        assert st["committed"] - st["wait"] >= j + 1
+        assert st["wait"] in cases                                  # a case of cp_wait_n, not its wait-all default
+        assert st["slot_holds"] == j
+        if st["refill"] is not None:
+            assert st["refill"] % pd == st["slot"] and st["refill"] == j + pd
+    group_ints = 16 * (RG.KMAX + 1) * 2 + 2 * RG.GE_MAX + 8
+    slots = max(pd, -(-group_ints * 4 // (nw * 512)))
+    assert group_ints * 4 <= nw * slots * 512 <= 48 * 1024 - 64
+
+
+def _upstream_group(pick, GE, maxm):
+    """tensorfold/cuda/exl3/experts.cu's group_kernel, transliterated (1,024 threads x 4 experts, scan over threads)."""
+
+    flat = pick.reshape(-1)
+    n, slots = flat.size, pick.shape[1]
+    ids, mem = [], {}
+    for t in range(1024):
+        for q in range(4):
+            e = t * 4 + q
+            if e < GE and (flat == e).any():
+                ids.append(e)
+                js = [(i // slots) * 32 + i % slots for i in range(n) if flat[i] == e][:maxm]
+                mem[e] = js + [-1] * (maxm - len(js))
+    return ids, mem
+
+
+def _group_rows(pick, GE, maxm, T):
+    """router_gemv.cu's group_rows with T threads, transliterated: counts, each thread a contiguous chunk of ids,
+    an exclusive scan of the used flags, ranks in pick order, -1 padding of every used place."""
+
+    psh = pick.reshape(-1)
+    n, slots = psh.size, pick.shape[1]
+    gc = np.zeros(GE, np.int64)
+    for e in psh:
+        if 0 <= e < GE:
+            gc[e] += 1
+    per = -(-GE // T)
+    used = [sum(gc[e] > 0 for e in range(min(GE, t * per), min(GE, min(GE, t * per) + per))) for t in range(T)]
+    gid, gpl, cpl = {}, {}, {}
+    for t in range(T):
+        place = sum(used[:t])
+        lo = min(GE, t * per)
+        for e in range(lo, min(GE, lo + per)):
+            if gc[e] > 0:
+                gid[place], gpl[e], cpl[place] = e, place, gc[e]
+                place += 1
+    total = sum(used)
+    gmem = np.full((total, maxm), 7777, np.int64)
+    for i in range(n):
+        e = psh[i]
+        if 0 <= e < GE:
+            rank = int((psh[:i] == e).sum())
+            if rank < maxm:
+                gmem[gpl[e], rank] = (i // slots) * 32 + i % slots
+    for q in range(total * maxm):
+        if q % maxm >= cpl[q // maxm]:
+            gmem[q // maxm, q % maxm] = -1
+    return [gid[p] for p in range(total)], gmem
+
+
+@pytest.mark.parametrize("T", [32, 64, 128, 256])
+def test_folded_grouping_is_upstreams(T):
+    rng = np.random.default_rng(T)
+    for E, topk, R in ((384, 6, 1), (384, 6, 3), (384, 6, 16), (128, 3, 9), (128, 3, 16)):
+        GE = E + 1
+        pick = np.stack([np.concatenate([rng.choice(E, topk, replace=False), [E]]) for _ in range(R)])
+        if R > 2:
+            pick[1, :topk] = pick[0, :topk]                         # shared ids across rows
+        uid, umem = _upstream_group(pick, GE, R)
+        gid, gmem = _group_rows(pick, GE, R, T)
+        mid, mcount, mmem = RG.model_group(pick, GE, R)
+        assert gid == uid == mid.tolist() and len(gid) == mcount
+        assert all(gmem[p].tolist() == umem[e] == mmem[p].tolist() for p, e in enumerate(gid))
+        assert gid[-1] == E and gmem[-1].tolist() == [r * 32 + topk for r in range(R)]   # the shared entry
+
