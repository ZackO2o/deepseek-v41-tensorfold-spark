index 0000000..6a9e029
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/router_check.py
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused router checked against ``split`` on the real activations of a run (window G6; diagnostic, off by default).
+
+``TF_DSV41_ROUTER_CHECK=/path/report.json``: every eager ``router.route`` call in ``fused`` mode (graph captures are
+skipped) also runs ``split`` on the same rows into its own buffers and counts, per expert count E (384: the target's
+layers, 128: DSpark's blocks):
+
+- rows whose picks are identical in order / as a set, and the largest weight difference on identical-set rows;
+- the largest |fused logit - split logit|;
+- for every row whose picks differ: float64 logits of that row (``x.double() @ W.double().T``), which path's picks
+  equal float64's, and float64's margin between the K-th and (K+1)-th choice score (a near-tie or not).
+
+64 rows (spread) of the first call per weight tensor (with a fingerprint of the weight) are kept as real
+router inputs for ``routerbench --samples`` (``<report>.samples.pt``). Reports are written at exit and every 400
+calls. Host syncs on every call: never on in timed runs.
+"""
+
+from __future__ import annotations
+
+import atexit
+import json
+import os
+from pathlib import Path
+
+ENV = "TF_DSV41_ROUTER_CHECK"
+PATH = os.environ.get(ENV, "").strip()
+SAMPLE_ROWS = 64
+_STATE: dict = {"calls": 0, "by_e": {}, "samples": [], "seen": set(), "atexit": False}
+
+
+def active() -> bool:
+    return bool(PATH)
+
+
+def _bucket(E: int) -> dict:
+    return _STATE["by_e"].setdefault(str(E), {
+        "calls": 0, "rows": 0, "rows_same_order": 0, "rows_same_set": 0, "max_w_diff_same_set": 0.0,
+        "max_logit_diff": 0.0, "max_rows_a_call": 0, "diff_rows": 0, "diff_fused_eq_f64": 0, "diff_split_eq_f64": 0,
+        "diff_neither_eq_f64": 0, "diff_f64_margins": []})
+
+
+def record(x, weight, bias, topk: int, shared: bool, scale: float, pick, wts, mode: str = "fused") -> None:
+    """Compare a ``mode`` call's (pick, wts) with ``split`` on the same rows (eager calls only; the report's "fused"
+    keys are that mode's)."""
+
+    import torch
+
+    from . import router
+
+    if x.is_cuda and torch.cuda.is_current_stream_capturing():
+        return
+    if not _STATE["atexit"]:
+        atexit.register(dump)
+        _STATE["atexit"] = True
+    R, E = x.shape[0], weight.shape[0]
+    b = _bucket(E)
+    ps, ws = router.route(x, weight, bias, topk=topk, shared=shared, scale=scale, mode="split")
+    pf, wf = pick[:, :topk], wts[:, :topk]
+    ps, ws = ps[:, :topk], ws[:, :topk]
+    same_order = (pf == ps).all(1)
+    same_set = (pf.sort(1).values == ps.sort(1).values).all(1)
+    b["calls"] += 1
+    b["rows"] += R
+    b["max_rows_a_call"] = max(b["max_rows_a_call"], R)
+    b["rows_same_order"] += int(same_order.sum())
+    b["rows_same_set"] += int(same_set.sum())
+    if bool(same_order.any()):
+        d = (wf[same_order] - ws[same_order]).abs().max()
+        b["max_w_diff_same_set"] = max(b["max_w_diff_same_set"], float(d))
+    lf = router.logits(x, weight, mode)
+    ls = router.logits(x, weight, "split")
+    b["max_logit_diff"] = max(b["max_logit_diff"], float((lf - ls).abs().max()))
+    bad = (~same_order).nonzero().flatten().tolist()
+    for r in bad:
+        b["diff_rows"] += 1
+        lg = x[r:r + 1].double() @ weight.double().T
+        s = torch.nn.functional.softplus(lg).sqrt()[0]
+        choice = s + bias.double()
+        order = sorted(range(E), key=lambda e: (-float(choice[e]), e))
+        ref = order[:topk]
+        fa, sa = pf[r].tolist(), ps[r].tolist()
+        b["diff_fused_eq_f64"] += int(fa == ref)
+        b["diff_split_eq_f64"] += int(sa == ref)
+        b["diff_neither_eq_f64"] += int(fa != ref and sa != ref)
+        if len(b["diff_f64_margins"]) < 200:
+            # the closest pair of adjacent choices among the top K + 1 (where an order or set change can come from)
+            c = [float(choice[e]) for e in order[:topk + 1]]
+            b["diff_f64_margins"].append(min(c[i] - c[i + 1] for i in range(topk)))
+    key = (weight.data_ptr(), E)
+    if key not in _STATE["seen"] and len(_STATE["samples"]) < 64 and R >= SAMPLE_ROWS:   # a prompt's call
+        _STATE["seen"].add(key)
+        step = max(1, R // SAMPLE_ROWS)             # rows spread over the call (the first is often a sink-like BOS)
+        _STATE["samples"].append({"E": E, "topk": topk, "fp": weight[:2, :16].float().cpu().clone(),
+                                  "x": x[::step][:SAMPLE_ROWS].detach().cpu().clone()})
+    _STATE["calls"] += 1
+    if _STATE["calls"] % 400 == 0:
+        dump()
+
+
+def dump() -> None:
+    if not PATH:
+        return
+    rep = {"calls": _STATE["calls"], "by_e": _STATE["by_e"]}
+    for b in rep["by_e"].values():
+        b["agree_order"] = b["rows_same_order"] / max(1, b["rows"])
+        b["agree_set"] = b["rows_same_set"] / max(1, b["rows"])
+    p = Path(PATH)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(json.dumps(rep, indent=1))
+    if _STATE["samples"]:
+        import torch
+
+        torch.save(_STATE["samples"], str(p) + ".samples.pt")
