+def test_ignore_eos_decodes_to_max_tokens(eos_stack, chat_route, stream):
+    app = eos_stack
+    body = {"max_tokens": 64, "stream": stream, "return_token_ids": True}
+    if chat_route:
+        body["messages"] = [{"role": "user", "content": "hi"}]
+    else:
+        body["prompt"] = [0, 5, 6, 7, 8, 9]
+    deltas = []
+    stopped = app.run(dict(body), chat_route, lambda d: deltas.append(d) or True)
+    assert stopped["finish"] == "stop" and stopped["completion_tokens"] < 64
+    assert stopped["stats"]["token_ids"][-1] == 1                     # it ended at its EOS
+    deltas.clear()
+    res = app.run(dict(body, ignore_eos=True), chat_route, lambda d: deltas.append(d) or True)
+    ids = res["stats"]["token_ids"]
+    assert res["completion_tokens"] == 64 == len(ids) == res["stats"]["completion"]
+    assert res["finish"] == "length"
+    assert ids.count(1) >= 2                                          # EOS tokens are emitted and decoding goes on
+    assert ids[:stopped["completion_tokens"]] == stopped["stats"]["token_ids"]     # the same reply up to the EOS
+    text = app.tok.decode([t for t in ids if t != 1], skip_special_tokens=False)
+    if stream:
+        shown = "".join(d.get("content", "") + d.get("reasoning_content", "") for d in deltas)
+        assert len(shown) > 0
+    if not chat_route:
+        assert res["content"] == text                                 # EOS shows no text (skip_special_tokens)
+        if stream:
+            assert "".join(d.get("content", "") for d in deltas) == text
