@@ -0,0 +1,140 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Sequential temperature scaling of DSpark's confidence head (DSpark, arXiv 2607.05147: per draft position, the
+head's logit divided by a temperature fitted on the drafts verified at that position given the ones before were
+kept; calibration error 3-8% -> ~1%). A drop-in for ``depth.Calibration`` (``q``, ``record``, ``factor``).
+
+``depth.Calibration`` multiplies the head's probability by a decayed kept / summed-p factor a position: it fixes the
+mean, not the spread. On the G8 prose runs the factored q_1 is too flat (bins 0.2-0.3 keep 18%, 0.7-0.8 keep 87%;
+a temperature fit gives slope 1.15, ECE 4.9% -> 4.0%), and the depth's thresholds sit exactly there (a lone
+window's first draft is worth its row from ~0.26).
+
+q_j = min(sigmoid(a_j x + b_j), Q_MAX), x = logit(p) of the head's raw probability; a_j = 1 / T_j.
+
+- ``temp``: b_j = 0, a_j fitted (sequential temperature scaling);
+- ``platt``: a_j and b_j fitted;
+- ``TF_DSV41_CONF_TEMP=T_1,T_2,..``: fixed temperatures (an offline fit, ``draftsim.fit_temps``); the last one
+  repeats for later positions; no online fit.
+
+Fit: a few Newton steps on the logistic loss of the position's last ``WINDOW`` (x, kept) pairs with a ridge pulling
+(a, b) to (1, 0), every ``REFIT`` records, once ``MIN_N`` pairs exist (before that the identity). Python floats in a
+fixed order on both ranks' identical inputs (the confidences and commits), no clock: rank consistent. Drafts only
+propose: replies are serial whatever q is.
+
+Knobs: TF_DSV41_CONF_CAL (factor | temp | platt, default factor: ``depth.Calibration``), TF_DSV41_CONF_TEMP.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from collections import deque
+from collections.abc import Sequence
+
+Q_MAX = 0.995
+WINDOW = 512
+REFIT = 8
+MIN_N = 32
+RIDGE = 4.0
+STEPS = 4
+A_RANGE = (0.25, 4.0)
+
+
+def _logit(p: float) -> float:
+    p = min(max(float(p), 1e-6), 1.0 - 1e-6)
+    return math.log(p / (1.0 - p))
+
+
+def _sig(x: float) -> float:
+    return 1.0 / (1.0 + math.exp(-x)) if x >= 0 else math.exp(x) / (1.0 + math.exp(x))
+
+
+def env_mode(env=None) -> tuple[str, list[float] | None]:
+    env = os.environ if env is None else env
+    mode = (env.get("TF_DSV41_CONF_CAL", "") or "factor").strip().lower()
+    if mode not in ("factor", "temp", "platt"):
+        raise ValueError(f"TF_DSV41_CONF_CAL={mode!r}: expected factor, temp or platt")
+    raw = (env.get("TF_DSV41_CONF_TEMP", "") or "").strip()
+    temps = [float(t) for t in raw.split(",") if t.strip()] if raw else None
+    if temps is not None and (not temps or any(t <= 0 for t in temps)):
+        raise ValueError("TF_DSV41_CONF_TEMP: positive temperatures, comma separated")
+    return mode, temps
+
+
+def fit(xs: Sequence[float], ys: Sequence[float], *, bias: bool, a: float = 1.0, b: float = 0.0,
+        ridge: float = RIDGE, steps: int = STEPS) -> tuple[float, float]:
+    """Newton steps on sum(logistic loss) + ridge / 2 ((a - 1)^2 + b^2) -> (a, b)."""
+
+    for _ in range(steps):
+        ga, gb = ridge * (a - 1.0), ridge * b
+        haa, hab, hbb = ridge, 0.0, ridge
+        for x, y in zip(xs, ys):
+            p = _sig(a * x + b)
+            r, w = p - y, p * (1.0 - p)
+            ga += r * x
+            gb += r
+            haa += w * x * x
+            hab += w * x
+            hbb += w
+        if bias:
+            det = haa * hbb - hab * hab
+            if det <= 1e-12:
+                break
+            da, db = (hbb * ga - hab * gb) / det, (haa * gb - hab * ga) / det
+        else:
+            da, db = ga / haa, 0.0
+        a, b = min(max(a - da, A_RANGE[0]), A_RANGE[1]), (b - db if bias else 0.0)
+    return a, b
+
+
+class TempCal:
+    """Per draft position: (a, b) of the scaled logit, fitted online (``temp`` / ``platt``) or fixed."""
+
+    def __init__(self, positions: int, mode: str = "temp", temps: Sequence[float] | None = None) -> None:
+        self.mode = mode
+        self.fixed = temps is not None
+        if self.fixed:
+            ts = list(temps) + [temps[-1]] * max(0, positions - len(temps))
+            self.ab = [(1.0 / t, 0.0) for t in ts[:positions]]
+        else:
+            self.ab = [(1.0, 0.0)] * positions
+        self.pairs = [deque(maxlen=WINDOW) for _ in range(positions)]
+        self.n = [0] * positions
+
+    def factor(self, j: int) -> float:
+        """The inverse temperature of position j (reports)."""
+
+        return self.ab[min(j, len(self.ab) - 1)][0]
+
+    def q(self, j: int, p: float) -> float:
+        a, b = self.ab[min(j, len(self.ab) - 1)]
+        return min(_sig(a * _logit(p) + b), Q_MAX)
+
+    def record(self, probs: Sequence[float], keep: int) -> None:
+        """``depth.Calibration.record``'s contract: the verified drafts' raw confidences, ``keep`` rows committed."""
+
+        for j, p in enumerate(probs[:len(self.ab)]):
+            if j >= keep:
+                break
+            self.pairs[j].append((_logit(p), 1.0 if j < keep - 1 else 0.0))
+            self.n[j] += 1
+            if not self.fixed and len(self.pairs[j]) >= MIN_N and self.n[j] % REFIT == 0:
+                xs = [x for x, _ in self.pairs[j]]
+                ys = [y for _, y in self.pairs[j]]
+                self.ab[j] = fit(xs, ys, bias=self.mode == "platt", a=self.ab[j][0], b=self.ab[j][1])
+
+
+def make(positions: int, env=None):
+    """``depth.Calibration`` (``factor``) or a ``TempCal`` from TF_DSV41_CONF_CAL / TF_DSV41_CONF_TEMP."""
+
+    mode, temps = env_mode(env)
+    if temps is not None:
+        return TempCal(positions, "temp", temps)
+    if mode == "factor":
+        from .depth import Calibration
+
+        return Calibration(positions)
+    return TempCal(positions, mode)
+
+
+__all__ = ["TempCal", "env_mode", "fit", "make"]
