# DeepSeek-V4.1-Flash on two DGX Sparks (TP=2): the production config scripts/serve.sh reads.
#
#   cp config/prod.env.example config/prod.env      then fill in every <placeholder> (serve.sh refuses to start
#                                                    while one is left) and check the NIC / HCA names.
#
# A non-empty variable exported by the caller wins over the same key here, e.g.  CONTEXT=196608 scripts/serve.sh start
# Every knob below is the measured configuration of README.md ("best exact config", engine = patches/ on v0.6.0).
# docs/OPERATIONS.md explains the knobs, the memory gates and how to turn each lever off.

# -- nodes and link ----------------------------------------------------------------------------------------------------
# The head (rank 0, this machine) reaches the worker over the CX7 link, not the LAN: the ranks need the link anyway.
WORKER_SSH="<user>@<worker-link-ip>"     # passwordless ssh from the head to the worker, over the CX7 link
HEAD_IP="<head-link-ip>"                 # the head's address on NCCL_SOCKET_IFNAME (the rendezvous address)
# A DGX Spark's default names for the linked CX7 port's netdev and its two RoCE functions; check with `ibdev2netdev`
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
MASTER_PORT=29571                        # NCCL rendezvous; the round-plan link uses MASTER_PORT + 7

# -- image -------------------------------------------------------------------------------------------------------------
IMAGE=dsv41-tensorfold:060               # scripts/serve.sh build: docker/Dockerfile here, shipped to the worker
CACHE_VOL=dsv41-tf-cache                 # docker volume on each node: compiled extensions, Triton, calibration

# -- model and node-local data (host paths on each node; local NVMe, never NFS) -------------------------------------
HEAD_MODEL="<path-on-head>/DeepSeek-V4.1-Flash-EXL3-2.9bpw"       # the EXL3 2.9 bpw pack (README: Weights)
WORKER_MODEL="<path-on-worker>/DeepSeek-V4.1-Flash-EXL3-2.9bpw"   # byte-identical copy on the worker
HEAD_ENGRAM="<path-on-head>/dsv41-engram"         # packed Engram shards engram-l{1,14}-r0of2.bin (scripts/pack_engram.py)
WORKER_ENGRAM="<path-on-worker>/dsv41-engram"     # engram-l{1,14}-r1of2.bin
HEAD_PREPARED="<path-on-head>/dsv41-prepared"     # prepared rank folders (~95 GB a node; the first start writes them)
WORKER_PREPARED="<path-on-worker>/dsv41-prepared"
HEAD_STATE="<path-on-head>/dsv41-state"           # request log, session NVMe tier (sessions/)
WORKER_STATE="<path-on-worker>/dsv41-state"

# -- serving -------------------------------------------------------------------------------------------------------------
NAME=dsv41-tf                            # containers dsv41-tf-r0 (head) / dsv41-tf-r1 (worker)
HOST=127.0.0.1                           # put your own reverse proxy / auth in front; 0.0.0.0 exposes it unauthenticated
PORT=8000
SERVED_NAME=DeepSeek-V4.1-Flash-TF
ALIASES="deepseek-v4.1-flash"            # more model ids answered (space separated)
CONTEXT=300000                           # tokens a request slot; 196608 if the worker's MemAvailable must stay over 5 GiB
PARALLEL=4                               # request slots; rank 0's `serving: N slot(s)` line must show this many
KV_DTYPE=fp8
MAX_TOKENS=32768

# -- comm: the RoCE all-gather (+11% single stream, +17% at 4 streams over NCCL) -------------------------------------------
GLM53_TF_COMM_BACKEND=roce               # nccl to fall back (a /cache/roce-failed marker also makes both ranks use NCCL)
GLM53_TF_ROCE_MAX_KB=1024

# -- prefill ---------------------------------------------------------------------------------------------------------------
TF_DSV41_PREFILL=replay                  # CED decoder bounded replay (approximate by design, ~2x) | full (exact, ~kit speed)
TF_DSV41_PREFILL_CHUNK=2048
TF_DSV41_PREFILL_ROWS=2048
TF_DSV41_PREFILL_KERNELS=fast            # fast | exact
TF_DSV41_FAST_EXPERTS=gm                 # gm (x3gm) | grouped | tc (3-5x slower: keep off)
TF_DSV41_ENGRAM_NATIVE=1                 # the native C Engram reader for prefill
TF_DSV41_NATIVE_DIR=/cache/dsv41-native
TF_DSV41_INDEX_STREAM_MIN=16384
TF_DSV41_PLAIN_TRITON=1
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_PREFILL_GATHER=bf16
TF_DSV41_ROPE_INPLACE=1
TF_DSV41_MHC_BM=64
TF_DSV41_MHC_WARPS=8
TF_DSV41_PREFILL_ATTN=fused
TF_DSV41_PREFILL_ATTN_BMQ=32
TF_DSV41_PREFILL_ATTN_WARPS=8
TF_DSV41_PREFILL_ROUTER=gemv

# -- decode ------------------------------------------------------------------------------------------------------------------
TF_DSV41_ROUTER=gemv                     # the router as a CUDA GEMV (1-row window 33.1 -> 29.5 ms)
TF_DSV41_ENGRAM_GATE=1                   # the GPU, not the host, waits for decode's Engram rows (exact)
TF_DSV41_GRAPH_MODE=rows                 # slot-agnostic row graphs for multi-stream windows (C2 +34%, C4 +12%)
TF_DSV41_PLAN_LINK=tcp                   # the round plan over host TCP (MASTER_PORT + 7)
TF_DSV41_SPEC_DRAFT=1                    # speculative DSpark pass during sample / commit
TF_DSV41_DENSE=0                         # x3dn dense linears: slower than x3seg on GB10 (off)
TF_DSV41_DEPTH_JOINT=0                   # joint multi-slot depth: failed its C2 gate (off)
TF_DSV41_MHC_DEC=1                       # decode glue (bit for bit)
TF_DSV41_MHC_FIN2=1
TF_DSV41_RMS_PAIR=1
TF_DSV41_PARTIAL_BF16=1
TF_DSV41_RG_NARROW=2
TF_DSV41_RG_TAIL=1
TF_DSV41_INDEX_DTOPK=1
TF_DSV41_ENGRAM_FUSE_DEC=1
TF_DSV41_MHC_FN=bf16                     # mHC mixing weights in bf16 (changes bits: top-1 vs the kit 0.9963)
# Routed-expert pruning in decode (LOSSY, changes replies): experts kept to top-p 0.85 (at least 3), weights
# renormalized over the kept ones. +5% decode; MMLU-200 88.5%. Delete these three lines for the unpruned model.
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_EXPERT_MIN_K=3
TF_DSV41_EXPERT_RENORM=kept
TF_DSV41_L2PF=1                          # cross-op L2 prefetch of the next dense group, 12 MiB a site (bit for bit)
TF_DSV41_L2PF_MB=12
TF_DSV41_PDL=0                           # programmatic dependent launch: no gain measured (off)
# G13 (engine 767ad9f): three rewrites, bit for bit (gate top-1 0.9961 == off; drafted == serial). 1-row window
# 26.8 -> ~23.4 ms, 2-row 32.3 -> 29.3; code +1.3%, prose +7.2%, C2 +3.9%, C4 +2.8%. Each defaults to 0 in the engine;
# scripts/serve.sh prebuild compiles their extensions. MOE_FUSED and BRANCHES stay 0 (no window gain).
TF_DSV41_MHC_CUDA=1                      # e1: the mHC boundary as one CUDA launch (1-row -1.3 ms)
TF_DSV41_ATTN_CUDA=1                     # e2 + e3: decode attention core + indexer top-k in CUDA (1-row -0.7 ms)
TF_DSV41_DENSE_V3=1                      # f2: dense EXL3 over a 16-byte-coalesced repack (2-16 rows -1.2 ms)
TF_DSV41_INDEX_KV=fp8                    # FP8 index keys
TF_DSV41_EXPERT_LOADS=1                  # decode's routed experts through the x3ld load path
TF_DSV41_EXPERT_PREFILL=0                # x3pf: slower at every prompt size (off)
TF_DSV41_CALIB=real                      # measure the verify-window costs at boot (the draft-depth policy reads them)
TF_DSV41_CALIB_DIR=/cache/dsv41-calib

# -- memory, state, API ----------------------------------------------------------------------------------------------------
TF_DSV41_PREPARED=/prepared
TF_DSV41_PREPARED_WRITE=1                # write a prepared folder when missing (~95 GB a node, once)
TF_DSV41_FLOOR_GIB=5                     # MemAvailable target a node (the load-time budget plans for it)
TF_DSV41_FLOOR_HARD_GIB=4                # below it nothing new is admitted
TF_DSV41_ENGRAM_DIR=/engram
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_SESSION_DISK=/sessions          # NVMe tier, mounted from <node>_STATE/sessions
TF_DSV41_SESSION_DISK_GIB=128
TF_DSV41_SESSION_DISK_MIN=1024
TF_DSV41_GRAMMAR=1                       # structured output (response_format, strict / required / named tools)
TF_DSV41_TOOL_GRAMMAR=0                  # 1: every tools request held to the DSML grammar
TF_DSV41_THINKING=1                      # default thinking mode (requests override)
TF_DSV41_DEFAULT_EFFORT=high             # low=50 | high=75 | max=100 | an int 1-100
TF_DSV41_SCHEMA_PROMPT=1
TF_DSV41_REQUEST_LOG=/state/requests.jsonl
TF_DSV41_DISCONNECT=1
# torch's CPU allocator in the NVIDIA PyTorch image is an embedded mimalloc, which asks for transparent huge pages by
# default. With ~103 GiB held by the weights and the KV pool, each huge-page fault compacted memory synchronously and a
# 299K prefill slowed to a crawl (the "stall" of G10 / G12). mimalloc reads this at process start only, so it is set
# here, not in the engine (scripts/serve.sh passes MIMALLOC_* to both ranks). The engine turns NumPy's own huge-page
# request off itself (TF_DSV41_NUMPY_HUGEPAGE=1 restores it).
MIMALLOC_ALLOW_THP=0
# Left at their defaults: TF_DSV41_STALL_S=300 (a round longer than that prints a stall report on both ranks),
# TF_DSV41_STALL_EXIT_S=0 (never exit on a stall), TF_DSV41_ENGRAM_WAIT_S=300 (deadline on an Engram read).

# -- ops (scripts/serve.sh) -------------------------------------------------------------------------------------------------
DROP_CACHES=1                            # drop the page cache on both nodes before the start and after the canary
MEM_GATE_GIB=104                         # MemFree >= this on both nodes before a load
MEM_GATE_TIMEOUT=600
CANARY=strict                            # off | warn | strict (strict: a failed canary stops both ranks)
READY_TIMEOUT=900
PREFLIGHT=strict
WATCH_HEAL=1                             # the watchdog restarts both ranks after WATCH_FAILS bad ticks
WATCH_FAILS=3
