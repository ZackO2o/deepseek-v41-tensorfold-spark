# One watchdog tick for the two DeepSeek-V4.1 TensorFold ranks (scripts/serve.sh watch --once), run by
# dsv41-tf-watchdog.timer. Healing: WATCH_HEAL / WATCH_FAILS in config/prod.env. Stop the timer
# (systemctl --user stop dsv41-tf-watchdog.timer) while you benchmark or maintain the pair, or set WATCH_LEASE.
[Unit]
Description=DeepSeek-V4.1 TensorFold watchdog tick
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/deepseek-v41-tensorfold-spark
Environment=CONFIG=config/prod.env
# Environment=WATCH_ALERT=%h/bin/notify
ExecStart=/usr/bin/env bash scripts/serve.sh watch --once
# an unhealthy tick is logged, not a unit failure that trips start limits
SuccessExitStatus=1
# the heal runs `serve.sh restart` detached (setsid ... &): keep it alive when the oneshot exits
KillMode=process
TimeoutStartSec=300
