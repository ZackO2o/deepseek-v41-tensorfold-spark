# Start the DeepSeek-V4.1 service once at boot on the head (scripts/boot-start.sh: waits for docker, the worker and
# RoCE, respects serve.sh's stop marker and an optional BOOT_LEASE file). The watchdog timer stays the fallback.
# Install as a user unit (README, "Run it unattended"); WorkingDirectory must be this checkout.
[Unit]
Description=DeepSeek-V4.1 TensorFold start at boot (fast path; the watchdog is the fallback)

[Service]
Type=oneshot
WorkingDirectory=%h/deepseek-v41-tensorfold-spark
Environment=CONFIG=config/prod.env
ExecStart=/usr/bin/env bash scripts/boot-start.sh
TimeoutStartSec=1800
KillMode=process

[Install]
WantedBy=default.target
